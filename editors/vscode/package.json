    "menus": {
      "editor/title/run": [
        {
          "command": "tondo.run",
          "when": "resourceLangId == tondo",
          "group": "navigation@0"
        },
        {
          "command": "tondo.debug",
          "when": "resourceLangId == tondo",
          "group": "navigation@1"
        }
      ],
      "debug/variables/context": [
        {
          "command": "tondo.showTable",
          "when": "debugType == tondo"
        },
        {
          "command": "tondo.why",
          "when": "debugType == tondo"
        },
        {
          "command": "tondo.timeline",
          "when": "debugType == tondo"
        },
        {
          "command": "tondo.origins",
          "when": "debugType == tondo"
        }
      ],
      "debug/callstack/context": [
        {
          "command": "tondo.taskGraph",
          "when": "debugType == tondo"
        },
        {
          "command": "tondo.when",
          "when": "debugType == tondo"
        },
        {
          "command": "tondo.diff",
          "when": "debugType == tondo"
        }
      ],
      "editor/context": [
        {
          "command": "tondo.why",
          "when": "inDebugMode && debugType == tondo && resourceLangId == tondo",
          "group": "debug"
        },
        {
          "command": "tondo.timeline",
          "when": "inDebugMode && debugType == tondo && resourceLangId == tondo",
          "group": "debug"
        },
        {
          "command": "tondo.origins",
          "when": "inDebugMode && debugType == tondo && resourceLangId == tondo",
          "group": "debug"
        }
      ],
      "commandPalette": [
        {
          "command": "tondo.showTable",
          "when": "false"
        },
        {
          "command": "tondo.why",
          "when": "inDebugMode && debugType == tondo"
        },
        {
          "command": "tondo.taskGraph",
          "when": "inDebugMode && debugType == tondo"
        },
        {
          "command": "tondo.timeline",
          "when": "inDebugMode && debugType == tondo"
        },
        {
          "command": "tondo.origins",
          "when": "inDebugMode && debugType == tondo"
        },
        {
          "command": "tondo.when",
          "when": "inDebugMode && debugType == tondo"
        },
        {
          "command": "tondo.diff",
          "when": "inDebugMode && debugType == tondo"
        },
        {
          "command": "tondo.reload",
          "when": "tondo.live"
        },
        {
          "command": "tondo.restartLive",
          "when": "tondo.live"
        },
        {
          "command": "tondo.stopCounters",
          "when": "tondo.counting"
        },
        {
          "command": "tondo.pickProcess",
          "when": "false"
        },
        {
          "command": "tondo.updateSnapshot",
          "when": "false"
        },
        {
          "command": "tondo.profileTest",
          "when": "false"
        },
        {
          "command": "tondo.benchmarkTest",
          "when": "false"
        },
        {
          "command": "tondo.fuzzTest",
          "when": "false"
        },
        {
          "command": "tondo.compareTest",
          "when": "false"
        },
        {
          "command": "tondo.changeSignature",
          "when": "false"
        },
        {
          "command": "tondo.moveToModule",
          "when": "false"
        },
        {
          "command": "tondo.groupParameters",
          "when": "false"
        },
        {
          "command": "tondo.extractTrait",
          "when": "false"
        },
        {
          "command": "tondo.profile",
          "when": "resourceLangId == tondo"
        },
        {
          "command": "tondo.clearProfile",
          "when": "tondo.profiled"
        },
        {
          "command": "tondo.bisectTest",
          "when": "false"
        },
        {
          "command": "tondo.refactor",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "tondo.refreshModules",
          "when": "view == tondoModules",
          "group": "navigation@0"
        },
        {
          "command": "tondo.moduleGraph",
          "when": "view == tondoModules",
          "group": "navigation@1"
        },
        {
          "command": "tondo.watchCounters",
          "when": "view == tondoCounters",
          "group": "navigation@0"
        },
        {
          "command": "tondo.stopCounters",
          "when": "view == tondoCounters && tondo.counting",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "tondo.moduleGraph",
          "when": "view == tondoModules && viewItem == project",
          "group": "inline"
        }
      ],
      "testing/item/context": [
        {
          "command": "tondo.fuzzTest",
          "when": "controllerId == tondo && testId in tondo.fuzzTests",
          "group": "inline"
        },
        {
          "command": "tondo.benchmarkTest",
          "when": "controllerId == tondo && testId in tondo.benchTests",
          "group": "inline"
        },
        {
          "command": "tondo.profileTest",
          "when": "controllerId == tondo && testId =~ /^(?!doc:)/",
          "group": "inline"
        },
        {
          "command": "tondo.fuzzTest",
          "when": "controllerId == tondo && testId in tondo.fuzzTests",
          "group": "1_run"
        },
        {
          "command": "tondo.compareTest",
          "when": "controllerId == tondo && testId =~ /^(?!doc:|project:)/",
          "group": "1_run"
        },
        {
          "command": "tondo.benchmarkTest",
          "when": "controllerId == tondo && testId in tondo.benchTests",
          "group": "1_run"
        },
        {
          "command": "tondo.profileTest",
          "when": "controllerId == tondo && testId =~ /^(?!doc:)/",
          "group": "1_run"
        },
        {
          "command": "tondo.bisectTest",
          "when": "controllerId == tondo",
          "group": "tondo@9"
        }
      ],
      "testing/item/gutter": [
        {
          "command": "tondo.fuzzTest",
          "when": "controllerId == tondo && testId in tondo.fuzzTests"
        },
        {
          "command": "tondo.benchmarkTest",
          "when": "controllerId == tondo && testId in tondo.benchTests"
        },
        {
          "command": "tondo.profileTest",
          "when": "controllerId == tondo && testId =~ /^(?!doc:)/"
        }
      ],
      "testing/message/context": [
        {
          "command": "tondo.updateSnapshot",
          "when": "testMessage == tondo.snapshot"
        }
      ],
      "testing/message/content": [
        {
          "command": "tondo.updateSnapshot",
          "when": "testMessage == tondo.snapshot"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "tondo",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "check",
              "build",
              "run",
              "test",
              "fmt",
              "watch"
            ],
            "description": "What tondo does."
          },
          "target": {
            "type": "string",
            "description": "A .to file or a project's directory; the workspace folder by default."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "tondo",
        "owner": "tondo",
        "source": "tondo",
        "fileLocation": [
          "autoDetect",
          "${cwd}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning)\\[(\\w+)\\]: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*--> (.*):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "tondo",
        "label": "Tondo"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "tondoModules",
          "name": "Tondo Modules",
          "when": "tondo.active"
        },
        {
          "id": "tondoCounters",
          "name": "Tondo Counters",
          "when": "tondo.counting"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tondoCounters",
        "contents": "No program watched.\n[Watch a Running Program](command:tondo.watchCounters)"
      }
    ],
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get Started with Tondo",
        "description": "Install tondo, make a project, run it, debug it and test it, and let agents write Tondo.",
        "steps": [
          {
            "id": "install",
            "title": "Install tondo",
            "description": "The extension runs the `tondo` executable, which is the whole toolchain.\n[Install tondo](command:tondo.install)",
            "media": {
              "markdown": "walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:tondo.installed"
            ]
          },
          {
            "id": "project",
            "title": "Make a project",
            "description": "A project has a program and a test to start from.\n[New Project](command:tondo.newProject)",
            "media": {
              "markdown": "walkthrough/project.md"
            },
            "completionEvents": [
              "onCommand:tondo.newProject"
            ]
          },
          {
            "id": "run",
            "title": "Run and debug",
            "description": "*Run* and *Debug* sit over `fn main`; F5 debugs the file open. Debug Live changes the program's code as files are saved.\n[Debug the File Open](command:tondo.debug)",
            "media": {
              "markdown": "walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:tondo.debug",
              "onCommand:tondo.run"
            ]
          },
          {
            "id": "test",
            "title": "Test",
            "description": "Every test of the workspace is in the Testing view, as you write it.\n[Open the Testing View](command:workbench.view.testing.focus)",
            "media": {
              "markdown": "walkthrough/test.md"
            },
            "completionEvents": [
              "onView:workbench.view.testing"
            ]
          },
          {
            "id": "agents",
            "title": "Let agents write Tondo",
            "description": "VS Code's agents get the tools of `tondo mcp` by themselves; `tondo setup` gives them to Claude Code and Codex too.",
            "media": {
              "markdown": "walkthrough/agents.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --outfile=out/extension.js",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npm run compile && vsce package --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
