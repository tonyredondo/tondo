{
  "name": "tondo",
  "displayName": "Tondo",
  "description": "The Tondo language: editing, debugging, tests, live builds, and its tools for agents.",
  "version": "0.1.0",
  "publisher": "tondo",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyredondo/tondo"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing",
    "Formatters",
    "Linters",
    "AI"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:tondo",
    "workspaceContains:**/tondo.toml",
    "workspaceContains:**/*.to",
    "onDebugResolve:tondo",
    "onDebugDynamicConfigurations:tondo"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tondo",
        "aliases": [
          "Tondo"
        ],
        "extensions": [
          ".to"
        ],
        "firstLine": "^#!.*\\btondo\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tondo",
        "scopeName": "source.tondo",
        "path": "./syntaxes/tondo.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tondo",
        "path": "./snippets/tondo.json"
      }
    ],
    "configuration": {
      "title": "Tondo",
      "properties": {
        "tondo.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `tondo` executable. Empty: the one on `PATH`, or in `~/.cargo/bin` or `~/.local/bin`."
        },
        "tondo.reloadOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "While a live build is debugged, put in the code of a Tondo file when it is saved (Edit and Continue)."
        },
        "tondo.run.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "The arguments of the programs run or debugged from the editor: *Run* and *Debug* over `main`, F5 without a `launch.json`, and the tasks."
        },
        "tondo.run.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "resource",
          "markdownDescription": "Variables of the environment for the programs run or debugged from the editor, added to the editor's own."
        },
        "tondo.test.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Arguments added to `tondo test` in the Testing view, as `[\"--jobs\", \"4\"]`."
        },
        "tondo.test.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "resource",
          "markdownDescription": "Variables of the environment for the tests, run or debugged, added to the editor's own."
        },
        "tondo.bench.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Arguments added to `tondo test --bench` by the *Benchmark* profile of the Testing view, as `[\"--against\", \"main\", \"--max-regression\", \"5\"]` or `[\"--bench-time\", \"5\"]`."
        }
      }
    },
    "configurationDefaults": {
      "[tondo]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "tondo.tondo"
      }
    },
    "breakpoints": [
      {
        "language": "tondo"
      }
    ],
    "debuggers": [
      {
        "type": "tondo",
        "label": "Tondo",
        "languages": [
          "tondo"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "A .to file, a project's directory or an executable.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The program's arguments.",
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Variables of the program's environment, added to the editor's own.",
                "default": {}
              },
              "cwd": {
                "type": "string",
                "description": "Where the program runs.",
                "default": "${workspaceFolder}"
              },
              "live": {
                "type": "boolean",
                "description": "A live build, whose code changes as its files are saved.",
                "default": false
              },
              "test": {
                "type": "string",
                "description": "The id of one of the project's tests, to run alone (`tondo test --list` lists them)."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the program starts.",
                "default": false
              },
              "dump": {
                "type": "string",
                "description": "A dump of a program (`tondo dump`, or `TONDO_DUMP=<dir>` at a crash), opened at its tasks and stacks instead of running a program."
              }
            }
          },
          "attach": {
            "properties": {
              "processId": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "The process of a running debug build, or its name (`tondo ps` lists them)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tondo",
            "request": "launch",
            "name": "Debug the program",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Tondo: Debug the program",
            "body": {
              "type": "tondo",
              "request": "launch",
              "name": "Debug the program",
              "program": "^\"\\${workspaceFolder}\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Tondo: Debug the program live",
            "body": {
              "type": "tondo",
              "request": "launch",
              "name": "Debug the program live",
              "program": "^\"\\${workspaceFolder}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "live": true
            }
          },
          {
            "label": "Tondo: Attach to a program",
            "body": {
              "type": "tondo",
              "request": "attach",
              "name": "Attach",
              "processId": "^\"\\${command:pickProcess}\""
            }
          },
          {
            "label": "Tondo: Debug a dump",
            "body": {
              "type": "tondo",
              "request": "launch",
              "name": "Debug a dump",
              "dump": "^\"\\${workspaceFolder}/app.dump.json\""
            }
          }
        ],
        "variables": {
          "pickProcess": "tondo.pickProcess"
        }
      }
    ],
    "commands": [
      {
        "command": "tondo.run",
        "title": "Run",
        "category": "Tondo",
        "icon": "$(play)"
      },
      {
        "command": "tondo.debug",
        "title": "Debug",
        "category": "Tondo",
        "icon": "$(debug-alt)"
      },
      {
        "command": "tondo.runLive",
        "title": "Run Live (Reloads as Files Are Saved)",
        "category": "Tondo"
      },
      {
        "command": "tondo.debugLive",
        "title": "Debug Live (Edit and Continue)",
        "category": "Tondo"
      },
      {
        "command": "tondo.reload",
        "title": "Reload the Debugged Program",
        "category": "Tondo"
      },
      {
        "command": "tondo.restartLanguageServer",
        "title": "Restart the Language Server",
        "category": "Tondo"
      },
      {
        "command": "tondo.pickProcess",
        "title": "Pick a Running Program",
        "category": "Tondo"
      },
      {
        "command": "tondo.watchCounters",
        "title": "Watch a Running Program's Counters",
        "category": "Tondo",
        "icon": "$(pulse)"
      },
      {
        "command": "tondo.stopCounters",
        "title": "Stop Watching Counters",
        "category": "Tondo",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tondo.trace",
        "title": "Trace a Running Program (Perfetto)",
        "category": "Tondo"
      },
      {
        "command": "tondo.dump",
        "title": "Dump a Running Program",
        "category": "Tondo"
      },
      {
        "command": "tondo.refreshModules",
        "title": "Refresh Modules",
        "category": "Tondo",
        "icon": "$(refresh)"
      },
      {
        "command": "tondo.moduleGraph",
        "title": "Show the Module Graph (Mermaid)",
        "category": "Tondo",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "tondo.debugDump",
        "title": "Debug a Dump",
        "category": "Tondo"
      },
      {
        "command": "tondo.menu",
        "title": "Show the Tondo Menu",
        "category": "Tondo"
      },
      {
        "command": "tondo.newProject",
        "title": "New Project",
        "category": "Tondo"
      },
      {
        "command": "tondo.install",
        "title": "Install tondo",
        "category": "Tondo"
      },
      {
        "command": "tondo.showOutput",
        "title": "Show the Output",
        "category": "Tondo"
      },
      {
        "command": "tondo.walkthrough",
        "title": "Get Started",
        "category": "Tondo"
      },
      {
        "command": "tondo.updateSnapshot",
        "title": "Update Snapshot",
        "category": "Tondo"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "tondo.run",
          "when": "resourceLangId == tondo",
          "group": "navigation@0"
        },
        {
          "command": "tondo.debug",
          "when": "resourceLangId == tondo",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tondo.reload",
          "when": "debugType == tondo"
        },
        {
          "command": "tondo.stopCounters",
          "when": "tondo.counting"
        },
        {
          "command": "tondo.pickProcess",
          "when": "false"
        },
        {
          "command": "tondo.updateSnapshot",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "tondo.refreshModules",
          "when": "view == tondoModules",
          "group": "navigation@0"
        },
        {
          "command": "tondo.moduleGraph",
          "when": "view == tondoModules",
          "group": "navigation@1"
        },
        {
          "command": "tondo.watchCounters",
          "when": "view == tondoCounters",
          "group": "navigation@0"
        },
        {
          "command": "tondo.stopCounters",
          "when": "view == tondoCounters && tondo.counting",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "tondo.moduleGraph",
          "when": "view == tondoModules && viewItem == project",
          "group": "inline"
        }
      ],
      "testing/message/context": [
        {
          "command": "tondo.updateSnapshot",
          "when": "testMessage == tondo.snapshot"
        }
      ],
      "testing/message/content": [
        {
          "command": "tondo.updateSnapshot",
          "when": "testMessage == tondo.snapshot"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "tondo",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "check",
              "build",
              "run",
              "test",
              "fmt",
              "watch"
            ],
            "description": "What tondo does."
          },
          "target": {
            "type": "string",
            "description": "A .to file or a project's directory; the workspace folder by default."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "tondo",
        "owner": "tondo",
        "source": "tondo",
        "fileLocation": [
          "autoDetect",
          "${cwd}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning)\\[(\\w+)\\]: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*--> (.*):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "tondo",
        "label": "Tondo"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "tondoModules",
          "name": "Tondo Modules",
          "when": "tondo.active"
        },
        {
          "id": "tondoCounters",
          "name": "Tondo Counters",
          "when": "tondo.counting"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tondoCounters",
        "contents": "No program watched.\n[Watch a Running Program](command:tondo.watchCounters)"
      }
    ],
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get Started with Tondo",
        "description": "Install tondo, make a project, run it, debug it and test it, and let agents write Tondo.",
        "steps": [
          {
            "id": "install",
            "title": "Install tondo",
            "description": "The extension runs the `tondo` executable, which is the whole toolchain.\n[Install tondo](command:tondo.install)",
            "media": {
              "markdown": "walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:tondo.installed"
            ]
          },
          {
            "id": "project",
            "title": "Make a project",
            "description": "A project has a program and a test to start from.\n[New Project](command:tondo.newProject)",
            "media": {
              "markdown": "walkthrough/project.md"
            },
            "completionEvents": [
              "onCommand:tondo.newProject"
            ]
          },
          {
            "id": "run",
            "title": "Run and debug",
            "description": "*Run* and *Debug* sit over `fn main`; F5 debugs the file open. Debug Live changes the program's code as files are saved.\n[Debug the File Open](command:tondo.debug)",
            "media": {
              "markdown": "walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:tondo.debug",
              "onCommand:tondo.run"
            ]
          },
          {
            "id": "test",
            "title": "Test",
            "description": "Every test of the workspace is in the Testing view, as you write it.\n[Open the Testing View](command:workbench.view.testing.focus)",
            "media": {
              "markdown": "walkthrough/test.md"
            },
            "completionEvents": [
              "onView:workbench.view.testing"
            ]
          },
          {
            "id": "agents",
            "title": "Let agents write Tondo",
            "description": "VS Code's agents get the tools of `tondo mcp` by themselves; `tondo setup` gives them to Claude Code and Codex too.",
            "media": {
              "markdown": "walkthrough/agents.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --outfile=out/extension.js",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npm run compile && vsce package --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
