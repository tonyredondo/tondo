{
  "name": "tondo",
  "displayName": "Tondo",
  "description": "The Tondo language: editing, debugging, tests, live builds, and its tools for agents.",
  "version": "0.1.0",
  "publisher": "tondo",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyredondo/tondo"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing",
    "Formatters",
    "Linters",
    "AI"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:tondo",
    "workspaceContains:**/tondo.toml",
    "workspaceContains:**/*.to",
    "onDebugResolve:tondo",
    "onDebugDynamicConfigurations:tondo"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tondo",
        "aliases": [
          "Tondo"
        ],
        "extensions": [
          ".to"
        ],
        "firstLine": "^#!.*\\btondo\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tondo",
        "scopeName": "source.tondo",
        "path": "./syntaxes/tondo.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tondo",
        "path": "./snippets/tondo.json"
      }
    ],
    "configuration": {
      "title": "Tondo",
      "properties": {
        "tondo.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `tondo` executable, or the directory it is in, as a download's `bin` or the download itself; `~` is your home. Empty: the one on `PATH`, or in `~/.cargo/bin` or `~/.local/bin`."
        },
        "tondo.fuzz.time": {
          "type": "number",
          "default": 0,
          "scope": "resource",
          "markdownDescription": "How many seconds *Fuzz Test* searches for inputs that fail; `0`: until it is stopped from its notification."
        },
        "tondo.reloadOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "While a live build runs, from *Debug Live* or *Run Live*, put in the code of its Tondo files when they are saved or change (Edit and Continue). Off: *Tondo: Reload* puts it in."
        },
        "tondo.run.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "The arguments of the programs run or debugged from the editor: *Run* and *Debug* over `main`, F5 without a `launch.json`, and the tasks."
        },
        "tondo.run.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "resource",
          "markdownDescription": "Variables of the environment for the programs run or debugged from the editor, added to the editor's own."
        },
        "tondo.test.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Arguments added to `tondo test` in the Testing view, as `[\"--jobs\", \"4\"]`."
        },
        "tondo.test.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "resource",
          "markdownDescription": "Variables of the environment for the tests, run or debugged, added to the editor's own."
        },
        "tondo.bench.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Arguments added to `tondo test --bench` by the *Benchmark* profile of the Testing view, as `[\"--against\", \"main\", \"--max-regression\", \"5\"]` or `[\"--bench-time\", \"5\"]`."
        }
      }
    },
    "semanticTokenModifiers": [
      {
        "id": "mutable",
        "description": "A binding that can change: a `var`, or a `mut` or `var` parameter."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "tondo",
        "scopes": {
          "*.mutable": [
            "markup.underline"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[tondo]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.defaultFormatter": "tondo.tondo",
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        }
      }
    },
    "breakpoints": [
      {
        "language": "tondo"
      }
    ],
    "debuggers": [
      {
        "type": "tondo",
        "label": "Tondo",
        "languages": [
          "tondo"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "A .to file, a project's directory or an executable.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The program's arguments.",
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Variables of the program's environment, added to the editor's own.",
                "default": {}
              },
              "cwd": {
                "type": "string",
                "description": "Where the program runs.",
                "default": "${workspaceFolder}"
              },
              "live": {
                "type": "boolean",
                "description": "A live build, whose code changes as its files are saved.",
                "default": false
              },
              "test": {
                "type": "string",
                "description": "The id of one of the project's tests, to run alone (`tondo test --list` lists them)."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the program starts.",
                "default": false
              },
              "dump": {
                "type": "string",
                "description": "A dump of a program (`tondo dump`, or `TONDO_DUMP=<dir>` at a crash), opened at its tasks and stacks instead of running a program."
              },
              "replay": {
                "type": "string",
                "description": "A recording of `tondo run --record <dir>`, run again the same, which steps back to the whole program as it was."
              },
              "last": {
                "type": "string",
                "description": "Run it recorded in a terminal, keeping this much of the end of the run, as `5m`, and replay that when a failed run ends (`tondo run --record <dir> --last 5m`)."
              },
              "hold": {
                "type": "string",
                "description": "With `last`: how long the copies of a failed run wait to be replayed, as `2h`."
              },
              "recording": {
                "type": "string",
                "description": "With `last`: the directory of the recording.",
                "default": ".tondo/recording"
              },
              "record": {
                "type": [
                  "boolean",
                  "number"
                ],
                "description": "Keep a history of the lines run, `true` or how many, which Step Back goes through and what each line changed shows beside it.",
                "default": true
              },
              "followChildren": {
                "type": "boolean",
                "description": "Debug the programs it starts too, each in a session of its own: a debug build of Tondo waits for it.",
                "default": true
              }
            }
          },
          "attach": {
            "properties": {
              "processId": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "The process of a running debug build, or its name (`tondo ps` lists them)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tondo",
            "request": "launch",
            "name": "Debug the program",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Tondo: Debug the program",
            "body": {
              "type": "tondo",
              "request": "launch",
              "name": "Debug the program",
              "program": "^\"\\${workspaceFolder}\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Tondo: Debug the program live",
            "body": {
              "type": "tondo",
              "request": "launch",
              "name": "Debug the program live",
              "program": "^\"\\${workspaceFolder}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "live": true
            }
          },
          {
            "label": "Tondo: Attach to a program",
            "body": {
              "type": "tondo",
              "request": "attach",
              "name": "Attach",
              "processId": "^\"\\${command:pickProcess}\""
            }
          },
          {
            "label": "Tondo: Debug a dump",
            "body": {
              "type": "tondo",
              "request": "launch",
              "name": "Debug a dump",
              "dump": "^\"\\${workspaceFolder}/app.dump.json\""
            }
          }
        ],
        "variables": {
          "pickProcess": "tondo.pickProcess"
        }
      }
    ],
    "commands": [
      {
        "command": "tondo.run",
        "title": "Run",
        "category": "Tondo",
        "icon": "$(play)"
      },
      {
        "command": "tondo.debug",
        "title": "Debug",
        "category": "Tondo",
        "icon": "$(debug-alt)"
      },
      {
        "command": "tondo.runLive",
        "title": "Run Live (Reloads as Files Change)",
        "category": "Tondo"
      },
      {
        "command": "tondo.debugLive",
        "title": "Debug Live (Edit and Continue)",
        "category": "Tondo"
      },
      {
        "command": "tondo.showTable",
        "title": "Show as Table",
        "category": "Tondo"
      },
      {
        "command": "tondo.why",
        "title": "Why Does It Have This Value?",
        "category": "Tondo"
      },
      {
        "command": "tondo.taskGraph",
        "title": "Show What the Tasks Wait For",
        "category": "Tondo"
      },
      {
        "command": "tondo.timeline",
        "title": "Show Its Values over the Run",
        "category": "Tondo"
      },
      {
        "command": "tondo.origins",
        "title": "Where Does It Come From?",
        "category": "Tondo"
      },
      {
        "command": "tondo.when",
        "title": "Go to When a Condition Holds",
        "category": "Tondo"
      },
      {
        "command": "tondo.diff",
        "title": "Compare with Another Moment",
        "category": "Tondo"
      },
      {
        "command": "tondo.compareRecordings",
        "title": "Compare Two Recordings",
        "category": "Tondo"
      },
      {
        "command": "tondo.changeSignature",
        "title": "Change Signature",
        "category": "Tondo"
      },
      {
        "command": "tondo.groupParameters",
        "title": "Group Parameters Into a Type",
        "category": "Tondo"
      },
      {
        "command": "tondo.extractTrait",
        "title": "Extract a Trait From Methods",
        "category": "Tondo"
