import std.console
import std.process

async fn pipelineText(pipeline: Pipeline): String ! (process.ProcessError | process.Utf8Error) {
    let output = await pipeline.output()?
    output.stdout.text()?
}

async fn main(): !(process.ProcessError | process.Utf8Error) {
    assert(process.args() == [])

    let source = process.cmd("/usr/bin/printf", "pipe")
    let first = process.cmd("/usr/bin/cat")
    let second = process.cmd("/usr/bin/cat")
    let third = process.cmd("/usr/bin/cat")

    assert(await pipelineText(source | first)? == "pipe")
    assert(await pipelineText(source | (first | second))? == "pipe")
    assert(await pipelineText((source | first) | second)? == "pipe")
    assert(await pipelineText((source | first) | (second | third))? == "pipe")

    let exact = await process
        .cmd("/usr/bin/printf", "[%s][%s][%s]", "two words", "*", "$HOME")
        .output()?
    assert(exact.stdout.text()? == "[two words][*][$HOME]")

    let streams = await process
        .shell("printf stdout; printf stderr >&2")
        .output()?
    assert(streams.stdout.text()? == "stdout")
    assert(streams.stderr.text()? == "stderr")

    let status = await process.shell("exit 7").status()?
    assert(status[0].code == some(7))
    assert(not status[0].success)

    match await process.shell("exit 7").check() {
        ok(_) => assert(false)
        err(process.ProcessError(_)) => assert(false)
        err(process.ProcessExitError(_)) => ()
    }

    let ran = await process.cmd("/usr/bin/true").run()?
    assert(ran[0].success)

    let handle = (
        process.cmd("/usr/bin/printf", "handle") |
        process.cmd("/usr/bin/cat")
    ).start()?
    let handled = await handle.output()?
    assert(handled.stdout.text()? == "handle")

    let sleeping = process.shell("exec sleep 30").start()?
    let cancelled = await sleeping.cancel()?
    assert(not cancelled[0].success)

    console.print("process-ok\n")
}
