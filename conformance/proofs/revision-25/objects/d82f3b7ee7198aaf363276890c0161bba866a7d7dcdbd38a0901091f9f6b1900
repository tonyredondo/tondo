import std.console

fn inspect(value: ref Int): Int {
    value
}

fn main() {
    var values = [10, 20, 30, 40]
    assert(values[0] == 10)
    assert(values[3] == 40)
    assert(values[-1] == 40)
    assert(values[-4] == 10)

    values[1] = 21
    values[-2] = 31
    assert(values == [10, 21, 31, 40])
    assert(inspect(ref values[-1]) == 40)

    console.print("array-index\n")
}
