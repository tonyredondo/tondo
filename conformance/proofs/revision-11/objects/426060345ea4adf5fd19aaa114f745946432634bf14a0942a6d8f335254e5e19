fn consume[T: Discard](value: T) {}

fn guarded[T: Discard](owner: T, snapshot: Int) {
    defer consume(owner)
    defer {
        _ = snapshot
    }

    let moved = owner
    _ = moved
}

fn hidden(value: Int): impl Discard {
    value
}

fn main() {
    guarded(1, 1)
    guarded(hidden(2), 2)
}
