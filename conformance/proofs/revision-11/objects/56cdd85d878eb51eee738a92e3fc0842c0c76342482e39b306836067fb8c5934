import std.console

fn snapshot(values: ref Array[Int]): Array[Int] {
    values
}

fn addTen(values: mut Array[Int]) {
    values += 10
}

fn main() {
    var numbers = [1, 2, 3, 4]
    var direct = numbers[1:3]
    let throughLoan = snapshot(ref numbers[1:3])

    direct[0] = 20
    numbers[2] = 30
    assert(numbers == [1, 2, 30, 4])
    assert(direct == [20, 3])
    assert(throughLoan == [2, 3])

    addTen(mut numbers[1:3])
    assert(numbers == [1, 12, 40, 4])
    assert(direct == [20, 3])
    assert(throughLoan == [2, 3])

    var later = numbers[1:3]
    later[-1] = 400
    assert(numbers == [1, 12, 40, 4])
    assert(later == [12, 400])

    var overlap = [1, 2, 3, 4]
    overlap[1:4] = overlap[0:3]
    assert(overlap == [1, 1, 2, 3])

    var nested = [[1, 10], [2, 20], [3, 30]]
    var reversed = nested[::-1]
    reversed[0][0] = 300
    nested[1][1] = 200
    assert(nested == [[1, 10], [2, 200], [3, 30]])
    assert(reversed == [[300, 30], [2, 20], [1, 10]])

    let first = Ref([1])
    let second = Ref([2])
    let identities = [first, second]
    let reversedIdentities = identities[::-1]
    assert(reversedIdentities[0] == second)
    assert(reversedIdentities[1] == first)
    assert(reversedIdentities[0].value == [2])

    console.print("slice-snapshot\n")
}
