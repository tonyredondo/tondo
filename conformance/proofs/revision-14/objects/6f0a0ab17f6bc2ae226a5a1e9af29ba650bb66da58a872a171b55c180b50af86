import std.console

async fn tick() {}

async fn main() {
    let factor = 2
    let operation = async (value: Int): Int {
        await tick()
        value * factor
    }

    assert(await operation(21) == 42)

    scope {
        let pending = spawn operation(20)
        assert(await pending == 40)
    }

    console.print("async-closure-ok\n")
}
