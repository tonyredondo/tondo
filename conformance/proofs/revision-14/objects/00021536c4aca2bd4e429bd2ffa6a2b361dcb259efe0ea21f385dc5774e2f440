import std.console

fn removeValue[V: Discard](values: var Map[Int, V], key: Int): V? {
    values.remove(key)
}

fn insertionCode(values: Map[Int, String]): Int {
    var code = 0
    for entry in values {
        code = code * 10 + entry.0
    }
    code
}

fn main() {
    var values = [2: "two", 1: "one"]
    assert(insertionCode(values) == 21)

    values[2] = "TWO"
    values[3] = "three"
    assert(insertionCode(values) == 213)
    assert(values[2] == some("TWO"))
    assert(values[9] == none)

    assert(values.remove(1) == some("one"))
    assert(values.remove(9) == none)
    assert(insertionCode(values) == 23)

    values[1] = "again"
    assert(insertionCode(values) == 231)

    let same = [1: "again", 3: "three", 2: "TWO"]
    assert(values == same)
    assert(values != [1: "again", 3: "different", 2: "TWO"])

    assert(Map.remove(var values, 2) == some("TWO"))
    assert(insertionCode(values) == 31)
    var generic = [1: "generic"]
    assert(removeValue(var generic, 1) == some("generic"))

    console.print("map-ordered-remove\n")
}
