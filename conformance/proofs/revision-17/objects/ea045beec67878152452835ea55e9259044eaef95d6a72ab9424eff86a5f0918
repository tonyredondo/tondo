import std.console

type Holder = {
    values: Array[Int]
}

type Values = Array[Int]

fn main() {
    var originalArray = [1, 2]
    var copiedArray = originalArray
    copiedArray[0] = 9
    originalArray[1] = 8
    assert(originalArray == [1, 8])
    assert(copiedArray == [9, 2])

    var originalTuple = ([1], [2])
    var copiedTuple = originalTuple
    copiedTuple.0[0] = 8
    originalTuple.1[0] = 9
    assert(originalTuple.0[0] == 1)
    assert(originalTuple.1[0] == 9)
    assert(copiedTuple.0[0] == 8)
    assert(copiedTuple.1[0] == 2)

    var originalRecord = Holder { values: [3] }
    var copiedRecord = originalRecord
    copiedRecord.values[0] = 7
    originalRecord.values[0] = 30
    assert(originalRecord.values[0] == 30)
    assert(copiedRecord.values[0] == 7)

    var originalNewtype = Values([4])
    var copiedNewtype = originalNewtype
    copiedNewtype.value[0] = 6
    originalNewtype.value[0] = 40
    assert(originalNewtype.value[0] == 40)
    assert(copiedNewtype.value[0] == 6)

    var originalMap = [1: 5]
    var copiedMap = originalMap
    copiedMap[1] = 10
    originalMap[1] = 11
    assert(originalMap[1] == some(11))
    assert(copiedMap[1] == some(10))

    var count = 0
    var originalCounter = (): Int {
        count += 1
        count
    }
    var copiedCounter = originalCounter
    assert(originalCounter() == 1)
    assert(originalCounter() == 2)
    assert(copiedCounter() == 1)
    assert(copiedCounter() == 2)
    assert(count == 0)

    console.print("write-independence\n")
}
