import std.console

fn main() {
    let originalArray = [1, 2, 3]
    let copiedArray = originalArray
    var originalArrayTotal = 0
    for value in originalArray {
        originalArrayTotal += value
    }
    var copiedArrayTotal = 0
    for value in copiedArray {
        copiedArrayTotal += value
    }
    assert(originalArrayTotal == 6)
    assert(copiedArrayTotal == 6)
    assert(originalArray == [1, 2, 3])
    assert(copiedArray == [1, 2, 3])

    let originalMap = ["one": 1, "two": 2, "three": 3]
    let copiedMap = originalMap
    var originalMapTotal = 0
    for entry in originalMap {
        originalMapTotal += entry.1
    }
    var copiedMapTotal = 0
    for entry in copiedMap {
        copiedMapTotal += entry.1
    }
    assert(originalMapTotal == 6)
    assert(copiedMapTotal == 6)
    assert(originalMap == ["one": 1, "two": 2, "three": 3])
    assert(copiedMap == ["one": 1, "two": 2, "three": 3])

    let originalSet = Set[1, 2, 3]
    let copiedSet = originalSet
    var originalSetTotal = 0
    for value in originalSet {
        originalSetTotal += value
    }
    var copiedSetTotal = 0
    for value in copiedSet {
        copiedSetTotal += value
    }
    assert(originalSetTotal == 6)
    assert(copiedSetTotal == 6)
    assert(originalSet == Set[1, 2, 3])
    assert(copiedSet == Set[1, 2, 3])

    let originalRange = 1 ..= 4
    let copiedRange = originalRange
    var originalRangeTotal = 0
    for value in originalRange {
        originalRangeTotal += value
    }
    var copiedRangeTotal = 0
    for value in copiedRange {
        copiedRangeTotal += value
    }
    assert(originalRangeTotal == 10)
    assert(copiedRangeTotal == 10)
    assert(2 in originalRange)
    assert(2 in copiedRange)

    let originalString = "copy"
    let copiedString = originalString
    var originalCharacters = 0
    for character in originalString {
        _ = character
        originalCharacters += 1
    }
    var copiedCharacters = 0
    for character in copiedString {
        _ = character
        copiedCharacters += 1
    }
    assert(originalCharacters == 4)
    assert(copiedCharacters == 4)
    assert(originalString == "copy")
    assert(copiedString == "copy")

    console.print("iteration\n")
}
