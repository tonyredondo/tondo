pub enum LoadError {
    Missing
    Denied(Int)
}

pub type Profile = {
    name: String
    priv secret: Int
}

fn load(value: Int): Int ! (LoadError | String) {
    if value < 0 {
        fail LoadError.Denied(value)
    }
    if value == 0 {
        fail "empty"
    }
    value
}

fn transform(value: Int): Int ! (LoadError | String) {
    let parsed = load(value)?
    let operation: fn(Int): Int = (item) {
        item + parsed
    }
    operation(value)
}

fn Profile.visible(self): String {
    self.name
}

fn visible(profile: Profile): String {
    profile.visible()
}

fn total(values: ref Array[Int]): Int {
    var result = 0
    for ref value in values {
        result += value
    }
    result
}

fn classify(error: LoadError): Int {
    match error {
        LoadError.Missing => 0
        LoadError.Denied(ref code) => code
    }
}

fn opaque(): impl Discard {
    1
}
