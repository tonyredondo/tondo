import std.console

type Accumulator = {
    base: Int
}

fn collect(values: ...Int): Array[Int] {
    values
}

fn sumFrom(base: Int, values: ...Int): Int {
    var total = base
    for value in values {
        total += value
    }
    total
}

fn pack[T](values: ...T): Array[T] {
    values
}

fn Accumulator.add(self, values: ...Int): Int {
    sumFrom(self.base, ...values)
}

fn make(value: Int): impl CallOnce[fn(): Int] + Discard {
    () {
        value
    }
}

fn runAll[F: CallOnce[fn(): Int] + Discard](operations: ...F): Int {
    var total = 0
    for operation in operations {
        total += operation()
    }
    total
}

fn mark(order: var Array[Int], position: Int, value: Int): Int {
    order[position] = position + 1
    value
}

fn makeValues(order: var Array[Int]): Array[Int] {
    order[1] = 2
    [20, 22]
}

fn main() {
    var values = [20, 22]
    var copied = collect(...values)
    copied[0] = 0
    values[1] = 2
    assert(values == [20, 2])
    assert(copied == [0, 22])

    assert(collect(...[]) == [])
    assert(sumFrom(0, ...[20, 22]) == 42)
    assert(sumFrom(base: 0, values: ...[20, 22]) == 42)
    assert(pack(...["left", "right"]) == ["left", "right"])
    assert(pack(...[[1], [2]]) == [[1], [2]])

    let accumulator = Accumulator { base: 10 }
    assert(accumulator.add(...[20, 12]) == 42)

    let indirect: fn(...Int): Array[Int] = collect
    assert(indirect(...[20, 22]) == [20, 22])

    let closure: fn(...Int): Int = (items) {
        sumFrom(0, ...items)
    }
    assert(closure(...[10, 20, 12]) == 42)

    var order = [0, 0]
    assert(sumFrom(mark(var order, 0, 0), ...makeValues(var order)) == 42)
    assert(order == [1, 2])

    let operations = [make(20), make(22)]
    assert(runAll(...operations) == 42)

    console.print("variadic-002\n")
}
