import std.console

type Wrapped = Int

type Record = {
    value: Int
}

enum Choice {
    Empty
    Item(Int)
    Named {
        value: Int
    }
}

fn main() {
    let originalTuple = (1, [2, 3])
    let copiedTuple = originalTuple
    assert(copiedTuple == originalTuple)

    let originalArray = [[1, 2], [3, 4]]
    let copiedArray = originalArray
    assert(copiedArray == originalArray)

    let originalMap = [1: [2, 3]]
    let copiedMap = originalMap
    assert(copiedMap == originalMap)

    let originalSet = Set[1, 2, 3]
    let copiedSet = originalSet
    assert(copiedSet == originalSet)

    let offset = 40
    let originalClosure = (): Int {
        offset + 2
    }
    let copiedClosure = originalClosure
    assert(originalClosure() == 42)
    assert(copiedClosure() == 42)

    let originalNewtype = Wrapped(42)
    let copiedNewtype = originalNewtype
    assert(copiedNewtype == originalNewtype)

    let originalRecord = Record { value: 42 }
    let copiedRecord = originalRecord
    assert(copiedRecord == originalRecord)

    let originalUnitVariant = Choice.Empty
    let copiedUnitVariant = originalUnitVariant
    assert(copiedUnitVariant == originalUnitVariant)

    let originalTupleVariant = Choice.Item(42)
    let copiedTupleVariant = originalTupleVariant
    assert(copiedTupleVariant == originalTupleVariant)

    let originalRecordVariant = Choice.Named { value: 42 }
    let copiedRecordVariant = originalRecordVariant
    assert(copiedRecordVariant == originalRecordVariant)

    let originalNone: Int? = none
    let copiedNone = originalNone
    assert(copiedNone == originalNone)

    let originalSome = some([42])
    let copiedSome = originalSome
    assert(copiedSome == originalSome)

    let originalOk: Array[Int] ! Bool = ok([42])
    let copiedOk = originalOk
    assert(copiedOk == originalOk)

    let originalErr: Array[Int] ! Bool = err(false)
    let copiedErr = originalErr
    assert(copiedErr == originalErr)

    let originalUnion: Int | Bool = 42
    let copiedUnion = originalUnion
    assert(copiedUnion == originalUnion)

    let originalRange = 1 ..= 3
    let copiedRange = originalRange
    assert(2 in copiedRange)
    assert(2 in originalRange)

    let originalString = "value"
    let copiedString = originalString
    assert(copiedString == originalString)

    let originalRef = Ref([42])
    let copiedRef = originalRef
    assert(copiedRef == originalRef)
    assert(copiedRef.value == [42])

    console.print("value\n")
}
