import std.console

const WrappedSigned: Int8 = 127i8 << 1
const WrappedUnsigned: UInt8 = 255u8 << 1
const WrappedInt16: Int16 = 32767i16 << 1
const WrappedInt32: Int32 = 2147483647i32 << 1
const WrappedInt64: Int = 9223372036854775807 << 1
const WrappedUInt16: UInt16 = 65535u16 << 1
const WrappedUInt32: UInt32 = 4294967295u32 << 1
const WrappedUInt64: UInt64 = 18446744073709551615u64 << 1
const WrappedByte: Byte = Byte(255u8) << 1
const SignedRight: Int8 = -2i8 >> 1
const MinimumRemainder: Int8 = -128i8 % -1i8
const ConstantBits: UInt8 = (12u8 & 10u8) | 2u8

fn main() {
    assert(WrappedSigned == -2i8)
    assert(WrappedUnsigned == 254u8)
    assert(WrappedInt16 == -2i16)
    assert(WrappedInt32 == -2i32)
    assert(WrappedInt64 == -2)
    assert(WrappedUInt16 == 65534u16)
    assert(WrappedUInt32 == 4294967294u32)
    assert(WrappedUInt64 == 18446744073709551614u64)
    assert(WrappedByte == Byte(254u8))
    assert(SignedRight == -1i8)
    assert(MinimumRemainder == 0i8)
    assert(ConstantBits == 10u8)

    assert(120i8 + 7i8 == 127i8)
    assert(-120i8 - 8i8 == -128i8)
    assert(300i16 * 100i16 == 30000i16)
    assert(4294967295u32 / 65535u32 == 65537u32)
    assert(18446744073709551615u64 % 2u64 == 1u64)

    assert(7 / 3 == 2)
    assert(-7 / 3 == -2)
    assert(7 % 3 == 1)
    assert(-7 % 3 == -1)
    assert(-9223372036854775808 % -1 == 0)

    assert(127i8 << 1 == -2i8)
    assert(-128i8 << 1 == 0i8)
    assert(255u8 << 1 == 254u8)
    assert(1u64 << 63u8 == 9223372036854775808u64)
    assert(-2i8 >> 1 == -1i8)
    assert(255u8 >> 7 == 1u8)
    assert(Byte(255u8) << 1 == Byte(254u8))
    assert(Byte(255u8) >> 7 == Byte(1u8))

    assert(~0i8 == -1i8)
    assert(~0u8 == 255u8)
    assert(~Byte(0u8) == Byte(255u8))
    assert((12u8 & 10u8) == 8u8)
    assert((12u8 ^ 10u8) == 6u8)
    assert((12u8 | 10u8) == 14u8)
    assert((-1i8 & 6i8) == 6i8)

    var bits = 1u8
    bits <<= 7
    assert(bits == 128u8)
    bits >>= 6
    assert(bits == 2u8)
    bits |= 8u8
    bits ^= 2u8
    bits &= 10u8
    assert(bits == 8u8)

    var arithmetic = 9i16
    arithmetic += 3i16
    arithmetic *= 2i16
    arithmetic /= 4i16
    arithmetic %= 5i16
    arithmetic -= 1i16
    assert(arithmetic == 0i16)

    console.print("integer-operators\n")
}
