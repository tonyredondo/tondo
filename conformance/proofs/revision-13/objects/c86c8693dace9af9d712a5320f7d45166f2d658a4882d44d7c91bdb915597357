import std.console

type Accumulator = {
    base: Int
}

fn collect(values: ...Int): Array[Int] {
    values
}

fn sumFrom(base: Int, values: ...Int): Int {
    var total = base
    for value in values {
        total += value
    }
    total
}

fn pack[T](values: ...T): Array[T] {
    values
}

fn Accumulator.add(self, values: ...Int): Int {
    var total = self.base
    for value in values {
        total += value
    }
    total
}

fn mark(order: var Array[Int], position: Int, value: Int): Int {
    order[position] = position + 1
    value
}

fn make(value: Int): impl CallOnce[fn(): Int] + Discard {
    () {
        value
    }
}

fn runAll[F: CallOnce[fn(): Int] + Discard](operations: ...F): Int {
    var total = 0
    for operation in operations {
        total += operation()
    }
    total
}

fn main() {
    assert(collect() == [])
    assert(collect(20, 22) == [20, 22])
    assert(sumFrom(42) == 42)
    assert(sumFrom(10, 20, 12) == 42)

    assert(pack("left", "right") == ["left", "right"])
    assert(pack([1], [2]) == [[1], [2]])
    let emptyText: Array[String] = pack()
    assert(emptyText == [])

    let accumulator = Accumulator { base: 10 }
    assert(accumulator.add() == 10)
    assert(accumulator.add(20, 12) == 42)

    let named: fn(...Int): Int = collectAndSum
    assert(named(20, 22) == 42)

    let explicit = (values: ...Int): Int {
        var total = 0
        for value in values {
            total += value
        }
        total
    }
    assert(explicit(10, 20, 12) == 42)

    let contextual: fn(...Int): Int = (values) {
        var total = 0
        for value in values {
            total += value
        }
        total
    }
    assert(contextual() == 0)
    assert(contextual(40, 2) == 42)

    var order = [0, 0, 0]
    assert(sumFrom(0, mark(var order, 0, 10), mark(var order, 1, 20), mark(var order, 2, 12)) == 42)
    assert(order == [1, 2, 3])

    assert(runAll(make(20), make(22)) == 42)

    console.print("variadic-001\n")
}

fn collectAndSum(values: ...Int): Int {
    var total = 0
    for value in values {
        total += value
    }
    total
}
