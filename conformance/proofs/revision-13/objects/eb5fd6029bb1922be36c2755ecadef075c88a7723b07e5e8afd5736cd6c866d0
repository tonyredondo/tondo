fn byteArithmetic(left: Byte, right: Byte): Byte {
    left + right
}

fn floatRemainder(left: Float, right: Float): Float {
    left % right
}

fn mixedBitwise(left: Int8, right: Int16): Int8 {
    left & right
}

fn boolBits(left: Bool, right: Bool): Bool {
    left | right
}

fn byteShiftCount(value: UInt8, count: Byte): UInt8 {
    value << count
}

fn unsignedNegate(value: UInt8): UInt8 {
    -value
}
