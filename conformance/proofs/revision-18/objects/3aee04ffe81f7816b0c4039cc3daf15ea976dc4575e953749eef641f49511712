import std.console

fn main() {
    var code = 0
    for value in 2 .. 5 {
        code = code * 10 + value
    }
    assert(code == 234)

    var inclusiveCode = 0
    for value in 2 ..= 5 {
        inclusiveCode = inclusiveCode * 10 + value
    }
    assert(inclusiveCode == 2345)

    let interval = 2 ..= 5
    assert(2 in interval)
    assert(5 in interval)
    assert(not (1 in interval))
    assert(not (6 in interval))

    var descendingCount = 0
    for _ in 5 .. 2 {
        descendingCount += 1
    }
    for _ in 5 ..= 2 {
        descendingCount += 1
    }
    assert(descendingCount == 0)

    var maximumCount = 0
    var maximumValue = 0
    for value in 9223372036854775806 ..= 9223372036854775807 {
        maximumCount += 1
        maximumValue = value
    }
    assert(maximumCount == 2)
    assert(maximumValue == 9223372036854775807)

    var minimumCount = 0
    var minimumValue = 0
    for value in -9223372036854775808 ..= -9223372036854775807 {
        minimumCount += 1
        minimumValue = value
    }
    assert(minimumCount == 2)
    assert(minimumValue == -9223372036854775807)

    var unsignedCount = 0
    var unsignedValue: UInt64 = 0u64
    for value in 18446744073709551614u64 ..= 18446744073709551615u64 {
        unsignedCount += 1
        unsignedValue = value
    }
    assert(unsignedCount == 2)
    assert(unsignedValue == 18446744073709551615u64)

    var scalarGapCount = 0
    var scalarGapLast = '\u{0}'
    for value in '\u{d7ff}' ..= '\u{e000}' {
        scalarGapCount += 1
        scalarGapLast = value
    }
    assert(scalarGapCount == 2)
    assert(scalarGapLast == '\u{e000}')

    var scalarMaximumCount = 0
    var scalarMaximumLast = '\u{0}'
    for value in '\u{10fffe}' ..= '\u{10ffff}' {
        scalarMaximumCount += 1
        scalarMaximumLast = value
    }
    assert(scalarMaximumCount == 2)
    assert(scalarMaximumLast == '\u{10ffff}')

    console.print("range-safe-boundaries\n")
}
