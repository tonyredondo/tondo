import std.console

fn hidden(value: Int): impl Discard {
    value
}

fn cleanup[T: Discard](values: Array[T]) {
    for value in values {
        _ = value
        console.print("x")
    }
    console.print("\n")
}

fn arrayCase() {
    let values = [hidden(1), hidden(2), hidden(3)]
    defer cleanup(values)

    for value in values {
        _ = value
        break
    }
}

fn cleanupMap[T: Discard](values: Map[String, T]) {
    for entry in values {
        _ = entry
        console.print("m")
    }
    console.print("\n")
}

fn mapCase() {
    let values = ["a": hidden(1), "b": hidden(2), "c": hidden(3)]
    defer cleanupMap(values)

    for entry in values {
        _ = entry
        break
    }
}

fn setCase() {
    let values = Set[1, 2, 3]
    var total = 0

    for value in values {
        total += value
    }

    assert(total == 6)
}

fn main() {
    arrayCase()
    mapCase()
    setCase()
}
