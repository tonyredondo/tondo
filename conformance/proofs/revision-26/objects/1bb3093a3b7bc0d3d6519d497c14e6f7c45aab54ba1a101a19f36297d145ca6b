import std.console

fn main() {
    let text = "añ🙂e\u{301}"
    let copied = text
    let expected = ['a', 'ñ', '🙂', 'e', '\u{301}']
    var position = 0
    for character in copied {
        assert(character == expected[position])
        position += 1
    }

    assert(position == 5)
    assert(copied == text)
    assert('ñ' in text)
    assert(not ('x' in text))
    assert("z" < "ñ")
    assert("é" != "e\u{301}")
    assert('\u{1f642}' == '🙂')
    assert(r"\n{value}" == "\\n{{value}}")

    let bytes: Array[Byte] = [Byte(0u8), Byte(255u8)]
    assert(bytes == [Byte(0u8), Byte(255u8)])
    assert(Byte(65u8) != Byte(97u8))

    console.print("text-core\n")
}
