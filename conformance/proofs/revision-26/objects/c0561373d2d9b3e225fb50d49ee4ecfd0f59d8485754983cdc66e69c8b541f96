import std.process

fn key(): String {
    "same"
}

async fn startPair(): (
    process.ProcessHandle,
    process.ProcessHandle,
) ! process.ProcessError {
    let first = process.cmd("/usr/bin/true").start()?
    match process.cmd("/usr/bin/true").start() {
        ok(second) => (first, second)
        err(error) => match await first.cancel() {
            ok(_) => fail error
            err(cleanupError) => fail cleanupError
        }
    }
}

fn consume(handle: process.ProcessHandle): Never {
    panic("duplicate-key guard failed")
}

async fn main(): !process.ProcessError {
    let (first, second) = await startPair()?
    let jobs: Map[String, process.ProcessHandle] = [
        key(): first,
        key(): second,
    ]
    for (entryKey, job) in jobs {
        _ = entryKey
        consume(job)
    }
}
