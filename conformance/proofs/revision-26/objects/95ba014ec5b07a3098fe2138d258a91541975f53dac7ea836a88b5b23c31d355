import std.console

const NamedRounded: Float32 = 16777216.0f32 + 1.0f32
const NamedTieDown: Float32 = 1.0f32 + 0.000000059604644775390625f32
const NamedTieUp: Float32 =
    1.00000011920928955078125f32 + 0.000000059604644775390625f32
const NamedSubnormal: Float32 = 1.17549435e-38f32 / 2.0f32
const NamedInfinity: Float32 = 1.0f32 / 0.0f32
const NamedNaN: Float32 = 0.0f32 / 0.0f32
const NamedNegativeZero: Float32 = -0.0f32

fn add32(left: Float32, right: Float32): Float32 {
    left + right
}

fn multiply32(left: Float32, right: Float32): Float32 {
    left * right
}

fn divide32(left: Float32, right: Float32): Float32 {
    left / right
}

fn isNaN32(value: Float32): Bool {
    value != value
}

fn isUnordered32(value: Float32): Bool {
    not (value < 0.0f32)
}

fn multiplyThenAdd32(
    left: Float32,
    right: Float32,
    addend: Float32,
): Float32 {
    left * right + addend
}

fn multiplyThenAdd64(left: Float, right: Float, addend: Float): Float {
    left * right + addend
}

fn main() {
    assert(NamedRounded == 16777216.0f32)
    assert(NamedTieDown == 1.0f32)
    assert(NamedTieUp == 1.0000002384185791015625f32)
    assert(NamedSubnormal > 0.0f32)
    assert(NamedSubnormal < 1.17549435e-38f32)
    assert(NamedInfinity > 3.4028235e38f32)
    assert(isNaN32(NamedNaN))
    assert(isUnordered32(NamedNaN))
    assert(divide32(1.0f32, NamedNegativeZero) < 0.0f32)

    assert(add32(16777216.0f32, 1.0f32) == 16777216.0f32)
    assert(16777216.0 + 1.0 == 16777217.0)

    var accumulated = 16777216.0f32
    accumulated += 1.0f32
    assert(accumulated == 16777216.0f32)

    let vector = [16777216.0f32] + [1.0f32]
    assert(vector == [16777216.0f32])

    let factor = 1.00000011920928955078125f32
    let addend = -1.0000002384185791015625f32
    assert(multiply32(factor, factor) == 1.0000002384185791015625f32)
    assert(multiplyThenAdd32(factor, factor, addend) == 0.0f32)

    let factor64 = 1.0000000000000002
    let addend64 = -1.0000000000000004
    assert(factor64 * factor64 == 1.0000000000000004)
    assert(multiplyThenAdd64(factor64, factor64, addend64) == 0.0)

    let subnormal = divide32(1.17549435e-38f32, 2.0f32)
    assert(subnormal > 0.0f32)
    assert(subnormal < 1.17549435e-38f32)

    let overflow = multiply32(3.4028235e38f32, 2.0f32)
    assert(overflow > 3.4028235e38f32)

    let negativeZero = divide32(-1.40129846e-45f32, 2.0f32)
    assert(divide32(1.0f32, negativeZero) < 0.0f32)

    let nan = divide32(0.0f32, 0.0f32)
    assert(nan != nan)
    assert(not (nan < 0.0f32))
    assert(not (nan <= 0.0f32))
    assert(not (nan > 0.0f32))
    assert(not (nan >= 0.0f32))

    console.print("ieee-floats\n")
}
