import std.console

fn preserve(values: mut Array[Int], offset: Int) {
    values += offset
}

fn replace(values: var Array[Int], replacement: Array[Int]) {
    values = replacement
}

fn replaceFirst(groups: mut Array[Array[Int]]) {
    replace(var groups[0], [7, 8, 9])
}

fn main() {
    var fixed = [1, 2, 3]
    preserve(mut fixed, 10)
    assert(fixed == [11, 12, 13])

    var region = [1, 2, 3, 4]
    preserve(mut region[1:3], 20)
    assert(region == [1, 22, 23, 4])

    var structural = [1, 2, 3]
    replace(var structural, [9])
    assert(structural == [9])

    var nested = [[1], [2, 3]]
    replaceFirst(mut nested)
    assert(nested == [[7, 8, 9], [2, 3]])

    console.print("array-mutation\n")
}
