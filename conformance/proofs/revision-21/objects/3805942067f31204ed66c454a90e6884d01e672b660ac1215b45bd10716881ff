import std.console

fn main() {
    let left = [8, 12, 18]
    let right = [2, 3, 6]

    assert(left + right == [10, 15, 24])
    assert(left - right == [6, 9, 12])
    assert(left * right == [16, 36, 108])
    assert(left / right == [4, 4, 3])
    assert(left % right == [0, 0, 0])

    assert(left + 10 == [18, 22, 28])
    assert(100 - left == [92, 88, 82])
    assert(left * 2 == [16, 24, 36])
    assert(72 / left == [9, 6, 4])
    assert(20 % left == [4, 8, 2])

    let nested = [[1, 2], [3, 4]]
    assert(nested + [[10, 20], [30, 40]] == [[11, 22], [33, 44]])
    assert(nested + [10, 20] == [[11, 12], [23, 24]])
    assert(10 - nested == [[9, 8], [7, 6]])

    let floats = [1.5, 2.0]
    assert(floats + 0.5 == [2.0, 2.5])
    assert(10.0 - floats == [8.5, 8.0])
    assert(floats * [2.0, 4.0] == [3.0, 8.0])
    assert([3.0, 8.0] / floats == [2.0, 4.0])

    let narrow: Array[Float32] = [1.0f32, 2.0f32]
    assert(narrow + 0.5f32 == [1.5f32, 2.5f32])
    assert(4.0f32 / narrow == [4.0f32, 2.0f32])

    var updated = left
    updated += right
    updated -= 1
    updated *= 2
    updated /= 2
    updated %= 4
    assert(updated == [1, 2, 3])

    var scaled = [1.0, 2.0]
    scaled *= [2.0, 4.0]
    assert(scaled == [2.0, 8.0])

    console.print("array-arithmetic\n")
}
