fn make(value: Int): impl CallOnce[fn(): Int] + Discard {
    () {
        value
    }
}

fn consume[F: CallOnce[fn(): Int] + Discard](operations: ...F) {
    for operation in operations {
        _ = operation()
    }
}

fn main() {
    let operations = [make(42)]
    consume(...operations)
    _ = operations
}
