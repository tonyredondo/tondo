}

fn pattern_forces_mode(
    model: &tondo_compiler::semantic::SemanticModel,
    root: HirPatternId,
    mode: HirMatchMode,
) -> Result<Option<()>, String> {
    let hir = model
        .hir()
        .ok_or_else(|| "match ownership requires typed HIR".to_owned())?;
    let mut pending = vec![root];
    while let Some(id) = pending.pop() {
        let pattern = hir
            .pattern(id)
            .ok_or_else(|| "match pattern is missing".to_owned())?;
        match pattern.kind() {
            HirPatternKind::Binding(_) if mode == HirMatchMode::Consume => {
                if hir.capability_status(pattern.ty(), HirCapability::Copy)
                    != Some(HirCapabilityStatus::Satisfied)
                {
                    return Ok(Some(()));
                }
            }
            HirPatternKind::BorrowBinding { .. } if mode == HirMatchMode::Observe => {
                return Ok(Some(()));
            }
            HirPatternKind::Tuple(items) | HirPatternKind::Variant { fields: items, .. } => {
                pending.extend(items.iter().copied());
            }
            HirPatternKind::OptionSome(item)
            | HirPatternKind::ResultOk(item)
            | HirPatternKind::ResultErr(item)
            | HirPatternKind::Newtype { value: item, .. }
            | HirPatternKind::UnionMember { pattern: item, .. } => pending.push(*item),
            HirPatternKind::Record { fields, .. } => {
                pending.extend(fields.iter().map(|field| field.pattern()));
            }
            HirPatternKind::Array { prefix, rest } => {
                pending.extend(prefix.iter().copied());
                pending.extend(*rest);
            }
            HirPatternKind::Recovery
            | HirPatternKind::Wildcard
            | HirPatternKind::Binding(_)
            | HirPatternKind::BorrowBinding { .. }
            | HirPatternKind::Literal(_)
            | HirPatternKind::NumericConversionError(_)
            | HirPatternKind::OptionNone => {}
        }
    }
    Ok(None)
}

fn bounds_json(
    model: &tondo_compiler::semantic::SemanticModel,
    bounds: &[HirTraitReference],
) -> Result<Vec<Value>, String> {
    bounds
        .iter()
        .map(|bound| {
            let identity = match bound.constructor() {
                HirTraitConstructor::Symbol(symbol) => symbol_id_json(model, *symbol)?,
                HirTraitConstructor::Prelude(name) => {
                    stable_id("prelude-trait", [name.as_str().to_owned()])
                }
                HirTraitConstructor::External(identity) => {
                    stable_id("external-trait", [identity.canonical_name()])
                }
            };
            Ok(json!({
                "identity": identity,
                "arguments": bound
                    .arguments()
                    .iter()
                    .copied()
                    .map(|ty| canonical_type(model, ty))
                    .collect::<Result<Vec<_>, _>>()?
            }))
        })
        .collect()
}

fn locate(
    model: &tondo_compiler::semantic::SemanticModel,
    by_path: &SourceMap<'_>,
    path: &str,
    start: u32,
    end: u32,
) -> Result<(FileId, TextRange), String> {
    let source = by_path
        .get(path)
        .ok_or_else(|| format!("query uses unknown file `{path}`"))?;
    let file = model
        .sources()
        .iter()
        .find(|(_, file)| {
            file.path().as_str() == source.logical_path
                && file.source_id().as_str() == source.source_id
        })
        .map(|(id, _)| id)
        .ok_or_else(|| format!("semantic snapshot lacks `{path}`"))?;
    let range = TextRange::new(start, end).map_err(|error| error.to_string())?;
    Ok((file, range))
}

fn canonical_type(
    model: &tondo_compiler::semantic::SemanticModel,
    ty: TypeId,
) -> Result<String, String> {
    model
        .canonical_type(ty)
        .map_err(|error| error.to_string())?
        .ok_or_else(|| "typed semantic model lacks a type interner".to_owned())
}

fn span_json(
    sources: &tondo_compiler::source::SourceDatabase,
    span: Span,
) -> Result<Value, String> {
    let file = sources
        .get(span.file())
        .map_err(|error| error.to_string())?;
    Ok(json!({
        "source_id": file.source_id().as_str(),
        "module": file.module().as_str(),
        "file": file.path().as_str(),
        "start": span.range().start(),
        "end": span.range().end()
    }))
}

fn span_key(
    sources: &tondo_compiler::source::SourceDatabase,
    span: Span,
) -> Result<String, String> {
    let file = sources
        .get(span.file())
        .map_err(|error| error.to_string())?;
    Ok(format!(
        "{}:{}:{}:{}:{}",
        file.source_id(),
        file.module(),
        file.path(),
        span.range().start(),
        span.range().end()
    ))
}

fn stable_id(kind: &str, parts: impl IntoIterator<Item = String>) -> String {
    let mut input = String::new();
    for part in parts {
        input.push_str(&part.len().to_string());
        input.push(':');
        input.push_str(&part);
        input.push(';');
    }
    format!(
        "sem:{kind}:{}",
        &tondo_conformance::sha256(input.as_bytes())[..24]
    )
}

fn sort_values(values: &mut [Value], keys: &[&str]) {
    values.sort_by(|left, right| {
        for key in keys {
            let ordering = compare_json(&left[*key], &right[*key]);
            if !ordering.is_eq() {
                return ordering;
            }
        }
        std::cmp::Ordering::Equal
    });
}

fn compare_json(left: &Value, right: &Value) -> std::cmp::Ordering {
    use std::cmp::Ordering;

    let rank = |value: &Value| match value {
        Value::Null => 0,
        Value::Bool(_) => 1,
        Value::Number(_) => 2,
        Value::String(_) => 3,
        Value::Array(_) => 4,
        Value::Object(_) => 5,
    };
    match rank(left).cmp(&rank(right)) {
        Ordering::Equal => {}
        ordering => return ordering,
    }
    match (left, right) {
        (Value::Null, Value::Null) => Ordering::Equal,
        (Value::Bool(left), Value::Bool(right)) => left.cmp(right),
        (Value::Number(left), Value::Number(right)) => match (left.as_i64(), right.as_i64()) {
            (Some(left), Some(right)) => left.cmp(&right),
            _ => match (left.as_u64(), right.as_u64()) {
                (Some(left), Some(right)) => left.cmp(&right),
                _ => left.to_string().cmp(&right.to_string()),
            },
        },
        (Value::String(left), Value::String(right)) => left.cmp(right),
        (Value::Array(left), Value::Array(right)) => left
            .iter()
            .zip(right)
            .find_map(|(left, right)| {
                let ordering = compare_json(left, right);
                (!ordering.is_eq()).then_some(ordering)
            })
            .unwrap_or_else(|| left.len().cmp(&right.len())),
        (Value::Object(left), Value::Object(right)) => {
            // The adapter canonicalizes wire objects by UTF-8 key order. Use
            // that same order while sorting semantic arrays; insertion order
            // would make spans compare differently before and after encoding.
            let mut left = left.iter().collect::<Vec<_>>();
            let mut right = right.iter().collect::<Vec<_>>();
            left.sort_unstable_by(|(key, _), (other, _)| key.cmp(other));
            right.sort_unstable_by(|(key, _), (other, _)| key.cmp(other));
            left.iter()
                .zip(&right)
                .find_map(|((left_key, left), (right_key, right))| {
                    let ordering = left_key.cmp(right_key);
                    if ordering.is_eq() {
                        let ordering = compare_json(left, right);
                        (!ordering.is_eq()).then_some(ordering)
                    } else {
                        Some(ordering)
                    }
                })
                .unwrap_or_else(|| left.len().cmp(&right.len()))
        }
        _ => unreachable!("equal JSON ranks have matching variants"),
    }
}

fn span_contains(container: &Value, inner: &Value) -> bool {
    container["source_id"] == inner["source_id"]
        && container["module"] == inner["module"]
        && container["file"] == inner["file"]
        && container["start"].as_u64().unwrap_or(u64::MAX) <= inner["start"].as_u64().unwrap_or(0)
        && inner["end"].as_u64().unwrap_or(u64::MAX) <= container["end"].as_u64().unwrap_or(0)
}

fn span_length(span: &Value) -> u64 {
    span["end"]
        .as_u64()
        .unwrap_or(u64::MAX)
        .saturating_sub(span["start"].as_u64().unwrap_or(0))
}

