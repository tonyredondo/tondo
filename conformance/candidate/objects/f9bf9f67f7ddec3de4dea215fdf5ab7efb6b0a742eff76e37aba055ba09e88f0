            [
                HirTerminalOperation::JoinAwait,
                HirTerminalOperation::ProcessFinish,
                HirTerminalOperation::TimerFinish,
            ]
            .map(terminal_operation_name),
            ["join-await", "process-finish", "timer-finish"]
