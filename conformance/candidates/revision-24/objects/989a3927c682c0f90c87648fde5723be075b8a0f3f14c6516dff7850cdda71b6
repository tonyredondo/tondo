import std.console

type Label = {
    text: String
}

impl Display for Label {
    fn display(self): String {
        self.text
    }
}

fn render[T: Discard + Display](value: T): String {
    "[{value}]"
}

fn preserve[T: Display](value: T): T {
    let observed = "{value}"
    assert(observed != "")
    value
}

fn marked(order: var Array[Int], position: Int, text: String): Label {
    order[position] = position + 1
    Label { text }
}

fn main() {
    let label = Label { text: "Tondo" }
    let text = "text"
    let summary = "{{{label}}}:{true}:{42}:{1.5f32}:{Byte(65u8)}:{'🙂'}:{text}:{()}"
    assert(summary == "{{Tondo}}:true:42:1.5:65:🙂:text:()")

    let numerics = "{ -8i8}:{ -16i16}:{ -32i32}:{8u8}:{16u16}:{32u32}:{18446744073709551615u64}:{2.25}"
    assert(numerics == "-8:-16:-32:8:16:32:18446744073709551615:2.25")

    assert(Display.display(42) == "42")
    assert(render(7) == "[7]")
    assert(render(label) == "[Tondo]")

    let preserved = preserve(Label { text: "kept" })
    assert(preserved.text == "kept")

    let escaped = "line\n{label}\t{{done}}\0\u{1F642}"
    assert(escaped == "line\nTondo\t{{done}}\0🙂")

    var order = [0, 0]
    let ordered = "{marked(var order, 0, "left")}|{marked(var order, 1, "right")}"
    assert(ordered == "left|right")
    assert(order == [1, 2])

    let multiline = """
        first: {label}
        braces: {{ok}}
        """
    assert(multiline == "first: Tondo\nbraces: {{ok}}")

    let multilineExpression = """
        answer: {40 + 2}
        """
    assert(multilineExpression == "answer: 42")

    console.print("text-display\n")
}
