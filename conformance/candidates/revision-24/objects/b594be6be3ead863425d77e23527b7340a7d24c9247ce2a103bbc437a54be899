import std.console

fn increment(value: mut Int) {
    value += 1
}

fn updateFirst(values: mut Array[Int]): Int {
    for mut value in values {
        increment(mut value)
        return value
    }
    0
}

fn replaceGroups(groups: mut Array[Array[Int]]) {
    for var group in groups {
        group = [5, 6]
    }
}

fn main() {
    var values = [1, 2, 3, 4]
    for mut value in values {
        match value {
            ref current =>
                {
                    assert(current > 0)
                }
        }
        if value == 2 {
            continue
        }
        value += 10
        if value == 13 {
            break
        }
    }
    assert(values == [11, 2, 13, 4])

    var nested = [[1, 2], [3, 4]]
    for mut group in nested {
        group += 10
    }
    assert(nested == [[11, 12], [13, 14]])

    for var group in nested {
        group = [9]
    }
    assert(nested == [[9], [9]])

    var pairs = [(1, 2), (3, 4)]
    for (mut left, ref right) in pairs {
        left += right
    }
    assert(pairs == [(3, 2), (7, 4)])

    var scores = [2: 20, 1: 10]
    for (ref key, mut value) in scores {
        value += key
    }
    assert(scores == [1: 11, 2: 22])

    var groups = [2: [2], 1: [1]]
    for (_, var group) in groups {
        group = [7, 8]
    }
    assert(groups == [1: [7, 8], 2: [7, 8]])

    var first = [40, 2]
    assert(updateFirst(mut first) == 41)
    assert(first == [41, 2])

    var borrowedGroups = [[1], [2]]
    replaceGroups(mut borrowedGroups)
    assert(borrowedGroups == [[5, 6], [5, 6]])

    console.print("exclusive-iteration\n")
}
