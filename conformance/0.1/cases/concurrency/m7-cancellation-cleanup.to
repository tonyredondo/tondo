import std.console

fn emitCleanup(text: String) {
    _ = console.print(text)
}

enum WorkError {
    Failed
}

fn tick() suspends {}

fn child(): !WorkError {
    defer emitCleanup("child-cleanup\n")

    for {
        tick()
    }
}

fn leaveScope(): !WorkError {
    scope {
        let pending = spawn child()
        return
    }
}

fn main(): !WorkError {
    leaveScope()?
    _ = console.print("parent-complete\n")
}
