import std.console

enum WorkError {
    Failed
}

fn tick() suspends {}

fn child(): !WorkError {
    defer console.print("child-cleanup\n")

    for {
        tick()
    }
}

fn leaveScope(): !WorkError {
    scope {
        let pending = spawn child()
        return
    }
}

fn main(): !WorkError {
    leaveScope()?
    console.print("parent-complete\n")
}
