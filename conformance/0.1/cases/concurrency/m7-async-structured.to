import std.console

fn immediate(value: Int): Int suspends {
    value
}

fn combine(left: Int, right: Int): Int suspends {
    let first = immediate(left)
    let second = immediate(right)
    first + second
}

fn main() {
    let sequential = combine(20, 22)
    assert(sequential == 42)

    scope {
        let first = spawn combine(10, 11)
        let second = spawn combine(20, 22)

        let right = await second
        let left = await first
        assert(left == 21)
        assert(right == 42)
    }

    console.print("async-structured-ok\n")
}
