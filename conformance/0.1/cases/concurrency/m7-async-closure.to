import std.console

fn tick() suspends {}

fn main() suspends {
    let factor = 2
    let operation = (value: Int): Int {
        tick()
        value * factor
    }

    assert(operation(21) == 42)

    scope {
        let pending = spawn operation(20)
        assert(await pending == 40)
    }

    console.print("async-closure-ok\n")
}
