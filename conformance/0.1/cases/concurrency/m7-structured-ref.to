import std.console

fn observe(value: ref String): String suspends {
    identity(ref value)
}

fn identity(value: ref String): String {
    value
}

fn main() {
    scope {
        var value = "before"
        let pending = spawn observe(ref value)
        let observed = await pending
        value = "after"

        assert(observed == "before")
        assert(value == "after")
    }

    console.print("structured-ref-ok\n")
}
