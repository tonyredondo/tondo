import std.console
import std.process
import std.bytes
import std.env

fn pipelineText(pipeline: Pipeline): String ! (process.ProcessError | bytes.Utf8Error) suspends {
    let output = pipeline.output()?
    String(output.stdout)?
}

fn main(): !(process.ProcessError | bytes.Utf8Error | env.EnvError) suspends {
    match env.snapshot()?.arguments() {
        [] => ()
        [_, ..] => assert(false)
    }

    let source = process.command("/usr/bin/printf", "pipe")
    let first = process.command("/usr/bin/cat")
    let second = process.command("/usr/bin/cat")
    let third = process.command("/usr/bin/cat")

    assert(pipelineText(source | first)? == "pipe")
    assert(pipelineText(source | (first | second))? == "pipe")
    assert(pipelineText((source | first) | second)? == "pipe")
    assert(pipelineText((source | first) | (second | third))? == "pipe")

    let exact = process.command("/usr/bin/printf", "[%s][%s][%s]", "two words", "*", "$HOME")
        .output()?
    assert(String(exact.stdout)? == "[two words][*][$HOME]")

    let streams = process.shell("printf stdout; printf stderr >&2")
        .output()?
    assert(String(streams.stdout)? == "stdout")
    assert(String(streams.stderr)? == "stderr")

    let status = process.shell("exit 7").status()?
    assert(status[0].code == some(7))
    assert(not status[0].success)

    match process.shell("exit 7").check() {
        ok(_) => assert(false)
        err(process.ProcessError(_)) => assert(false)
        err(process.ProcessExitError(_)) => ()
    }

    let ran = process.command("/usr/bin/true").run()?
    assert(ran[0].success)

    let handle = (
        process.command("/usr/bin/printf", "handle") |
        process.command("/usr/bin/cat")
    ).start()?
    let handled = handle.output()?
    assert(String(handled.stdout)? == "handle")

    let sleeping = process.shell("exec sleep 30").start()?
    let cancelled = sleeping.cancel()?
    assert(not cancelled[0].success)

    console.print("process-ok\n")
}
