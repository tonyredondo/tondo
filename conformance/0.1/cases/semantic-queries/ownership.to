fn key(value: Int): Int {
    value
}

fn observe(value: ref Int): Int suspends {
    value
}

unsafe fn raw(value: Int): Int {
    value + 1
}

fn facts() suspends {
    let values: Map[Int, Int] = [
        key(1): 10,
        key(2): 20,
    ]
    _ = values

    var number = 1
    scope {
        let pending = spawn observe(ref number)
        let observed = await pending
        number = 2
        assert(observed == 1)
    }

    let direct = unsafe {
        raw(40)
    }
    assert(direct == 41)
}
