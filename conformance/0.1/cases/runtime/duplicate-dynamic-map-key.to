import std.process

fn key(): String {
    "same"
}

fn startPair(): (
    process.ProcessHandle,
    process.ProcessHandle,
) ! process.ProcessError suspends {
    let first = process.command("/usr/bin/true").start()?
    match process.command("/usr/bin/true").start() {
        ok(second) => (first, second)
        err(error) => match first.cancel() {
            ok(_) => fail error
            err(cleanupError) => fail cleanupError
        }
    }
}

fn consume(handle: process.ProcessHandle): Never {
    panic("duplicate-key guard failed")
}

fn main(): !process.ProcessError suspends {
    let (first, second) = startPair()?
    let jobs: Map[String, process.ProcessHandle] = [
        key(): first,
        key(): second,
    ]
    for (entryKey, job) in jobs {
        _ = entryKey
        consume(job)
    }
}
