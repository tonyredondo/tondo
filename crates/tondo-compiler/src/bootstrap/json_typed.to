        encoder.string(value)
    }
}

impl serialization.Decode[Json] for String {
    fn decode[E, D: serialization.Decoder[Json, E]](
        decoder: var D,
    ): String ! E {
        match decoder.next()? {
            serialization.SerializationEvent.String(value) => value
            _ => fail decoder.reject(serialization.SerializationError.TypeMismatch)
        }
    }
}

impl serialization.Encode[Json] for Byte {
    fn encode[E, S: serialization.Encoder[Json, E]](value: Self, encoder: var S): Unit ! E {
        encoder.uint(UInt64(value))
    }
}

impl serialization.Decode[Json] for Byte {
    fn decode[E, D: serialization.Decoder[Json, E]](decoder: var D): Byte ! E {
        match decoder.next()? {
            serialization.SerializationEvent.Int(value) => match Byte(value) {
                ok(converted) => converted
                err(_) => fail decoder.reject(serialization.SerializationError.TypeMismatch)
            }
            serialization.SerializationEvent.UInt(value) => match Byte(value) {
                ok(converted) => converted
                err(_) => fail decoder.reject(serialization.SerializationError.TypeMismatch)
            }
            _ => fail decoder.reject(serialization.SerializationError.TypeMismatch)
        }
    }
}

impl serialization.Encode[Json] for Int8 {
    fn encode[E, S: serialization.Encoder[Json, E]](value: Self, encoder: var S): Unit ! E {
