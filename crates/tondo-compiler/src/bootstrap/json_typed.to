import std.bytes
import std.collections
import std.json
import std.serialization

type JsonEncoder = { writer: json.JsonWriter }
type JsonDecoder = { reader: json.JsonReader }

impl serialization.Encoder[Json, json.JsonError] for JsonEncoder {
    fn null(var self): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.Null)
    }

    fn bool(var self, value: Bool): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.Bool(value))
    }

    fn int(var self, value: Int64): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.Int(value))
    }

    fn uint(var self, value: UInt64): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.UInt(value))
    }

    fn float32(var self, value: Float32): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.Float32(value))
    }

    fn float64(var self, value: Float64): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.Float64(value))
    }

    fn string(var self, value: String): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.String(value))
    }

    fn bytes(var self, value: bytes.Bytes): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.Bytes(value))
    }

    fn base64(var self, value: bytes.Bytes): Unit ! json.JsonError {
        self.writer.__writeBase64(value)
    }

    fn startArray(var self, length: Int?): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.StartArray(length))
    }

    fn endArray(var self): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.EndArray)
    }

    fn startMap(var self, length: Int?): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.StartMap(length))
    }

    fn mapKey(var self): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.MapKey)
    }

    fn endMap(var self): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.EndMap)
    }

    fn startRecord(var self, name: String, fields: Int?): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.StartRecord(name, fields))
    }

    fn field(var self, name: String): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.Field(name))
    }

    fn endRecord(var self): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.EndRecord)
    }

    fn startEnum(var self, name: String, variant: String): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.StartEnum(name, variant))
    }

    fn endEnum(var self): Unit ! json.JsonError {
        self.writer.__write(serialization.SerializationEvent.EndEnum)
    }
}

impl serialization.Decoder[Json, json.JsonError] for JsonDecoder {
    fn peek(var self): serialization.SerializationEvent? ! json.JsonError {
        self.reader.__peekSerialization()
    }

    fn next(var self): serialization.SerializationEvent ! json.JsonError {
        self.reader.__nextSerialization()
    }

    fn base64(var self): bytes.Bytes ! json.JsonError {
        self.reader.__nextSerializationBase64()
    }

    fn own(
        var self,
        event: serialization.SerializationEvent,
    ): serialization.SerializationEvent ! json.JsonError {
        event
    }

    fn reject(
        var self,
        error: serialization.SerializationError,
    ): json.JsonError {
        self.reader.__rejectSerialization(error)
    }
}

impl serialization.Encode[Json] for Unit {
    fn encode[E, S: serialization.Encoder[Json, E]](
        value: Self,
        encoder: var S,
    ): Unit ! E {
        encoder.null()
    }
}

impl serialization.Decode[Json] for Unit {
    fn decode[E, D: serialization.Decoder[Json, E]](
        decoder: var D,
    ): Unit ! E {
        match decoder.next()? {
            serialization.SerializationEvent.Null => ()
            _ => fail decoder.reject(serialization.SerializationError.TypeMismatch)
        }
    }
}

impl serialization.Encode[Json] for Bool {
    fn encode[E, S: serialization.Encoder[Json, E]](
        value: Self,
        encoder: var S,
    ): Unit ! E {
        encoder.bool(value)
    }
}

impl serialization.Decode[Json] for Bool {
    fn decode[E, D: serialization.Decoder[Json, E]](
        decoder: var D,
    ): Bool ! E {
        match decoder.next()? {
            serialization.SerializationEvent.Bool(value) => value
            _ => fail decoder.reject(serialization.SerializationError.TypeMismatch)
        }
    }
}

impl serialization.Encode[Json] for Int {
    fn encode[E, S: serialization.Encoder[Json, E]](
        value: Self,
        encoder: var S,
    ): Unit ! E {
        encoder.int(value)
    }
}

impl serialization.Decode[Json] for Int {
    fn decode[E, D: serialization.Decoder[Json, E]](
        decoder: var D,
    ): Int ! E {
        match decoder.next()? {
            serialization.SerializationEvent.Int(value) => value
            _ => fail decoder.reject(serialization.SerializationError.TypeMismatch)
        }
    }
}

impl serialization.Encode[Json] for String {
    fn encode[E, S: serialization.Encoder[Json, E]](
        value: Self,
