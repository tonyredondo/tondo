impl serialization.Decode[Json] for UInt64 {
    fn decode[E, D: serialization.Decoder[Json, E]](decoder: var D): UInt64 ! E {
        match decoder.next()? {
            serialization.SerializationEvent.Int(value) => match UInt64(value) {
                ok(converted) => converted
                err(_) => fail decoder.reject(serialization.SerializationError.TypeMismatch)
