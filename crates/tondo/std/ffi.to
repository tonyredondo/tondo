// std.ffi: what calling C needs (standard library 19.3). C functions are
// declared with `extern fn` and C structs with `extern type`; this module
// names C's types and gives memory and strings that C can use.
//
// ```tondo
// import std.console
// import std.ffi
//
// extern fn abs(value: ffi.CInt): ffi.CInt
//
// console.println("{unsafe { abs(-42) }}")
// ```

import std.env
import std.internal.library as libraryNative
import std.internal.memory
import std.reflect as __reflect

// C's types, as the Tondo types of the same size and sign on the targets
// Tondo supports. They are aliases, so their values are ordinary numbers.

/// C's `char`, a byte.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn snprintf(buffer: Pointer[ffi.CChar], size: ffi.CSize, format: ffi.CString, ...): ffi.CInt
///
/// // A buffer of C characters that C writes into.
/// let buffer = ffi.allocate[ffi.CChar](32)
/// unsafe {
///     _ = snprintf(buffer, 32u64, "%s has %d items", "cart", 3i32)
///     console.println(ffi.fromCString(buffer))
///     ffi.free(buffer)
/// }
/// ```
pub alias CChar = Byte

/// C's `short`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern type PollFd = {
///     fd: ffi.CInt
///     events: ffi.CShort
///     revents: ffi.CShort
/// }
///
/// extern fn poll(fds: Pointer[PollFd], count: ffi.CULong, timeout: ffi.CInt): ffi.CInt
///
/// // Whether standard input has something to read, without waiting.
/// let readable: ffi.CShort = 1
/// let watched = ffi.allocate[PollFd]()
/// unsafe {
///     watched.write(PollFd { fd: 0, events: readable, revents: 0 })
///     let ready = poll(watched, 1u64, 0)
///     console.println("ready: {ready}, events: {watched.read().revents}")
///     ffi.free(watched)
/// }
/// ```
pub alias CShort = Int16

/// C's `unsigned short`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn htons(value: ffi.CUShort): ffi.CUShort
///
/// // A port in the byte order of the network, as a C socket address holds it.
/// let port: ffi.CUShort = 8080
/// console.println("{port} is {unsafe { htons(port) }} in network order on this machine")
/// ```
// tondo: allow W1004: the name C gives this type
pub alias CUShort = UInt16

/// C's `int`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// @symbol("atoi")
/// extern fn parseInt(text: ffi.CString): ffi.CInt
///
/// extern fn getpid(): ffi.CInt
///
/// let count: ffi.CInt = unsafe { parseInt("42") }
/// // A narrower result widens where an `Int` is expected.
/// let total: Int = count + 1
/// console.println("{total} in process {unsafe { getpid() } > 0}")
/// ```
pub alias CInt = Int32

/// C's `unsigned int`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn htonl(value: ffi.CUInt): ffi.CUInt
///
/// let address: ffi.CUInt = 0x7f000001u32
/// console.println("127.0.0.1 is {address} here and {unsafe { htonl(address) }} on the wire")
/// ```
// tondo: allow W1004: the name C gives this type
pub alias CUInt = UInt32

/// C's `long`, of 64 bits on the supported targets.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn strtol(text: ffi.CString, end: Pointer[ffi.CString]?, base: ffi.CInt): ffi.CLong
///
/// console.println("{unsafe { strtol("ff", none, 16) }} {unsafe { strtol("-777", none, 8) }}")
/// ```
pub alias CLong = Int

/// C's `unsigned long`, of 64 bits on the supported targets.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn strtoul(text: ffi.CString, end: Pointer[ffi.CString]?, base: ffi.CInt): ffi.CULong
///
/// let mask: ffi.CULong = unsafe { strtoul("11110000", none, 2) }
/// console.println("{mask}")
/// ```
// tondo: allow W1004: the name C gives this type
pub alias CULong = UInt64

/// C's `long long`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn atoll(text: ffi.CString): ffi.CLongLong
///
/// extern fn llabs(value: ffi.CLongLong): ffi.CLongLong
///
/// let bytes = unsafe { atoll("-9000000000") }
/// console.println("{unsafe { llabs(bytes) }}")
/// ```
pub alias CLongLong = Int

/// C's `unsigned long long`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn strtoull(text: ffi.CString, end: Pointer[ffi.CString]?, base: ffi.CInt): ffi.CULongLong
///
/// let largest: ffi.CULongLong = unsafe { strtoull("18446744073709551615", none, 10) }
/// console.println("{largest}")
/// ```
// tondo: allow W1004: the name C gives this type
pub alias CULongLong = UInt64

/// C's `size_t`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn strlen(text: ffi.CString): ffi.CSize
///
/// // The bytes of UTF-8, which is what C counts.
/// let size: ffi.CSize = unsafe { strlen("año") }
/// console.println("{size} bytes")
/// ```
pub alias CSize = UInt64

/// C's `ssize_t`.
///
/// ```tondo
/// import std.ffi
///
/// extern fn write(fd: ffi.CInt, data: ffi.CString, count: ffi.CSize): ffi.CSSize
///
/// // The bytes written, or -1 when it fails.
/// let text = "written by C\n"
/// let written: ffi.CSSize = unsafe { write(1, text, UInt64(text.length()) ?? 0u64) }
/// if written < 0 {
///     panic("write failed")
/// }
/// ```
// tondo: allow W1004: the name C gives this type
pub alias CSSize = Int

/// C's `float`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn strtof(text: ffi.CString, end: Pointer[ffi.CString]?): ffi.CFloat
///
/// let ratio: ffi.CFloat = unsafe { strtof("0.75", none) }
/// console.println("{ratio * 2.0f32}")
/// ```
pub alias CFloat = Float32

/// C's `double`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn atof(text: ffi.CString): ffi.CDouble
///
/// extern fn frexp(value: ffi.CDouble, exponent: Pointer[ffi.CInt]): ffi.CDouble
///
/// let exponent = ffi.allocate[ffi.CInt]()
/// unsafe {
///     let fraction = frexp(atof("48.0"), exponent)
///     console.println("48 = {fraction} * 2^{exponent.read()}")
///     ffi.free(exponent)
/// }
/// ```
pub alias CDouble = Float

/// C's `bool`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// /// The options a C library takes, with C's `bool`.
/// extern type Options = {
///     verbose: ffi.CBool
///     level: ffi.CInt
/// }
///
/// /// A function C can call back, as a library's filter.
/// extern fn accept(options: Options, value: ffi.CInt): ffi.CBool {
///     options.verbose or value <= options.level
/// }
///
/// let options = Options { verbose: false, level: 3 }
/// console.println("{unsafe { accept(options, 2) }} {ffi.sizeOf[Options]()}")
/// ```
pub alias CBool = Bool

/// A C string: the address of bytes that end with a zero byte. A `String`
/// passed to a C function that takes one becomes such a copy for the call.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn getenv(name: ffi.CString): ffi.CString?
///
/// extern fn strdup(text: ffi.CString): ffi.CString
///
/// unsafe {
///     // A C string C may return as null is an option.
///     match getenv("HOME") {
///         some(home) => console.println("home is {ffi.fromCString(home)}")
///         none => console.println("no home")
///     }
///     // A copy C made with its allocator, given back with `free`.
///     let copy = strdup("hello")
///     console.println(ffi.fromCString(copy))
///     ffi.free(copy)
/// }
/// let kept = ffi.toCString("for C to keep")
/// unsafe { ffi.free(kept) }
/// ```
pub alias CString = memory.CString

/// What C's `void*` points to: any `Pointer[T]` converts to
/// `Pointer[ffi.Void]`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn memset(target: Pointer[ffi.Void], value: ffi.CInt, count: ffi.CSize): Pointer[ffi.Void]
///
/// let numbers = ffi.allocate[Int32](4)
/// unsafe {
///     // Any pointer goes where C takes a `void*`.
///     _ = memset(numbers, 0xff, 16u64)
///     console.println("{numbers.read()}")
///     ffi.free(numbers)
/// }
/// ```
pub alias Void = memory.Void

/// A `va_list` of C, which only C makes: a function C calls may receive a
/// `Pointer[VaList]` and pass it along, as to `vsnprintf`.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// extern fn vsnprintf(buffer: Pointer[ffi.CChar], size: ffi.CSize, format: ffi.CString, args: Pointer[ffi.VaList]): ffi.CInt
///
/// /// A library's log callback, which receives the arguments of its `printf`
/// /// format as a `va_list` and lets C format them.
/// extern fn logged(level: ffi.CInt, format: ffi.CString, args: Pointer[ffi.VaList]) {
///     let buffer = ffi.allocate[ffi.CChar](512)
///     unsafe {
///         _ = vsnprintf(buffer, 512u64, format, args)
///         console.println("[{level}] {ffi.fromCString(buffer)}")
///         ffi.free(buffer)
///     }
/// }
///
/// extern fn library_set_log(callback: extern fn(ffi.CInt, ffi.CString, Pointer[ffi.VaList]))
///
/// unsafe { library_set_log(logged) }
/// ```
pub extern type VaList

@symbol("free")
extern fn cFree(pointer: Pointer[Void]?)

@symbol("memmove")
extern fn cMove(to: Pointer[Void], from: Pointer[Void], size: Int): Pointer[Void]

/// The size in bytes of a value of `T` in memory.
pub fn sizeOf[T](): Int {
    memory.sizeOf[T]()
}

/// The alignment in bytes of a value of `T` in memory.
pub fn alignOf[T](): Int {
    memory.alignOf[T]()
}

/// Zeroed memory for `count` values of `T`, from C's allocator: C may free
/// it, and `free` gives it back.
pub fn allocate[T: ~Copy](count: Int = 1): Pointer[T] {
    if count < 0 {
        panic("ffi.allocate takes a count that is not negative, not {count}")
    }
    let block = memory.allocate(count * memory.sizeOf[T]())
    unsafe { block.cast[T]() }
}

/// Gives back memory from `allocate`, `toCString` or C's allocator; `none`
/// does nothing, as in C.
pub unsafe fn free(pointer: Pointer[Void]?) {
    cFree(pointer)
}

/// Copies `count` values of `T` from one address to another; the regions
/// may overlap.
pub unsafe fn copy[T](from: Pointer[T], to: Pointer[T], count: Int = 1) {
    if count < 0 {
        panic("ffi.copy takes a count that is not negative, not {count}")
    }
    cMove(to, from, count * memory.sizeOf[T]())
}

/// A copy of the text that ends with a zero byte, for C to keep; `free`
/// gives it back. Text with a zero byte inside panics (`P0016`).
pub fn toCString(text: String): CString {
    memory.cString(text)
}

/// The text of a C string, up to its zero byte; bytes that are not UTF-8
/// become U+FFFD.
pub unsafe fn fromCString(text: CString): String {
    memory.fromCString(text)
}

/// The text of a C array of characters, such as a struct's
/// `@count(16) name: CChar`, up to its first zero byte; bytes that are not
/// UTF-8 become U+FFFD.
pub fn fromCChars(chars: Array[CChar]): String {
    memory.fromCChars(chars)
}

/// The text as a C array of `count` characters: its bytes, then zero bytes.
/// Text that does not fit with a zero byte after it panics.
pub fn toCChars(text: String, count: Int): Array[CChar] {
    let encoded = text.bytes()
    if encoded.length() >= count {
        panic("ffi.toCChars: {encoded.length()} bytes and a zero byte do not fit in {count}")
    }
    encoded.concat([Byte(0u8)].repeat(count - encoded.length()))
}

/// A value for C to hand back to a callback, as C passes data through a
/// `void*`: a copy of it in memory from `allocate`. `fromContext` reads it
/// and `freeContext` gives it back.
pub fn context[T: ~Copy](value: T): Pointer[Void] {
    let block = allocate[T]()
    unsafe { block.write(value) }
    block
}

/// The value of a context made by `context`, which must hold a `T`.
pub unsafe fn fromContext[T](data: Pointer[Void]): T {
    let block = data.cast[T]()
    block.read()
}

/// Gives back a context made by `context`, with the value it holds.
pub unsafe fn freeContext[T: ~Copy](data: Pointer[Void]) {
    let block = data.cast[T]()
    _ = memory.take[T](block)
    cFree(data)
}

/// A copy of `count` bytes at an address.
pub unsafe fn bytes(from: Pointer[Byte], count: Int): Array[Byte] {
    memory.bytes(from, count)
}

/// Why a shared library could not be loaded, read or unloaded.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// match ffi.Library.open("plugins/missing.so") {
///     ok(_) => console.println("loaded")
///     err(ffi.LibraryError.NotLoaded(why)) => console.println("not loaded: {why.length() > 0}")
///     err(other) => console.println("{other}")
/// }
/// ```
pub enum LibraryError {
    /// The file is not there, or is not a library this system loads, with
    /// what the system said.
    NotLoaded(String)
    /// The library publishes no such name, which it holds.
    NoSymbol(String)
    /// The system refused to unload it, with what it said.
    NotUnloaded(String)
    /// The library was closed.
    Closed
}

impl Display for LibraryError {
    fn display(self): String {
        match self {
            NotLoaded(why) => "the library did not load: {why}"
            NoSymbol(name) => "the library publishes no `{name}`"
            NotUnloaded(why) => "the library was not unloaded: {why}"
            LibraryError.Closed => "the library was closed"
        }
    }
}

impl __reflect.Reflect for LibraryError {
    fn reflectShow(self, _nested: Bool): String {
        "{self}"
    }
}

/// A shared library loaded while the program runs: its functions and the
/// values it publishes. A copy names the same library. One that `open` or
/// `named` loaded stays loaded until the program ends; one of
/// `openUnloadable` is unloaded when its last copy goes, and the last
/// `Function` taken from it; `close` unloads any now.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// let program = ffi.Library.program()
/// console.println("{program.has("malloc")} {program.has("no_such_function")}")
/// ```
pub type Library = {
    priv native: libraryNative.Native
}

/// A function of a library, as the `extern fn` type `F`: called as one,
/// inside `unsafe`, and keeping its library loaded while it is there.
///
/// ```tondo
/// import std.console
/// import std.ffi
///
/// let program = ffi.Library.program()
/// match unsafe { program.function[extern fn(ffi.CString): ffi.CSize]("strlen") } {
///     ok(length) => console.println("{unsafe { length("tondo") }}")
///     err(error) => console.println("{error}")
/// }
/// ```
pub type Function[F] = {
    priv address: UInt64
    priv library: Library
}

/// The library in the file at `path`, taken from the current directory when
/// it is not absolute, without searching. Its symbols are bound as it loads,
/// and offered to the libraries loaded after it with `global`. It stays
/// loaded until the program ends.
pub fn Library.open(path: String, global: Bool = false): Library ! LibraryError {
    loaded(absolute(path), global, false)
}

/// As `open`, a library that is unloaded when its last holder goes: the
/// program promises that by then it has no thread running, no callback
/// left with the system or another library, and nothing to run when the
/// program ends.
pub unsafe fn Library.openUnloadable(path: String, global: Bool = false): Library ! LibraryError {
    loaded(absolute(path), global, true)
}

/// The library `name`, as `libraryFileName` names its file, where the
/// system's loader looks for libraries.
pub fn Library.named(
    name: String,
    version: String? = none,
    global: Bool = false,
): Library ! LibraryError {
    loaded(libraryFileName(name, version), global, false)
}

/// The program itself and the libraries it started with, which are never
/// unloaded.
pub fn Library.program(): Library {
    Library { native: libraryNative.program() }
}

/// The function the library publishes as `name`, as the `extern fn` type
/// `F`, which nothing checks it has.
pub unsafe fn Library.function[F](self, name: String): Function[F] ! LibraryError {
    Function { address: self.address(name)?, library: self }
}

/// The address of the value the library publishes as `name`, which holds
/// nothing loaded.
pub unsafe fn Library.pointer[T](self, name: String): Pointer[T] ! LibraryError {
    let address = self.address(name)?
    address.toPointer[T]()
}

/// Whether the library publishes `name`; `false` once it is closed.
pub fn Library.has(self, name: String): Bool {
    libraryNative.symbol(self.native, name) != 0
}

/// The file the library was loaded from; the executable for `program`.
pub fn Library.path(self): String {
    libraryNative.path(self.native)
}

/// Unloads the library now, whatever holds it: the program promises that
/// nothing taken from it is used afterwards, and that none of its code is
/// running. Whether its memory goes is the system's.
pub unsafe fn Library.close(self): !LibraryError {
    if libraryNative.closed(self.native) {
        fail LibraryError.Closed
    }
    let refused = libraryNative.close(self.native)
    if not refused.isEmpty() {
        fail LibraryError.NotUnloaded(refused)
    }
}

/// The plain `extern fn`, to hand to C or keep where a `Function` cannot
/// go. It holds nothing: keeping the library loaded while it is used is the
/// program's.
pub fn Function[F].raw(self): F {
    // The compiler gives each call the function at the address, as `F`.
    self.raw()
}

/// The file name of the library `name`, as this system names it:
/// `lib<name>.so` or `lib<name>.so.<version>` on Linux, `lib<name>.dylib`
/// or `lib<name>.<version>.dylib` on macOS.
pub fn libraryFileName(name: String, version: String? = none): String {
    libraryNative.fileName(name, version ?? "")
}

/// The address of `name` in an open library.
fn Library.address(self, name: String): UInt64 ! LibraryError {
    if libraryNative.closed(self.native) {
        fail LibraryError.Closed
    }
    let found = libraryNative.symbol(self.native, name)
    if found == 0 {
        fail LibraryError.NoSymbol(name)
    }
    UInt64.wrapping(found)
}

fn loaded(path: String, global: Bool, unloadable: Bool): Library ! LibraryError {
    let native = libraryNative.open(path, global, unloadable)
    let why = libraryNative.failure(native)
    if not why.isEmpty() {
        fail LibraryError.NotLoaded(why)
    }
    Library { native: native }
}

/// A path from the current directory, when it is not absolute.
fn absolute(path: String): String {
    if path.startsWith("/") { path } else { "{env.currentDirectory()}/{path}" }
}
