// std.cli (standard library 14.32): the command line read into the
// program's types, as a record of options and arguments or an enum of
// subcommands, with the help their documentation gives; and what a program
// writes to a terminal: styles, tables, progress and questions.
//
// ```tondo
// import std.cli
// import std.console
//
// /// Greets someone.
// type Greet = {
//     /// Who to greet.
//     name: String = "world"
//     /// How many times.
//     times: Int = 1
// }
//
// let options = cli.parse[Greet]()
// for _ in 0..options.times {
//     console.println("hello {options.name}")
// }
// ```

import std.console as __console
import std.env as __env
import std.internal.fs as fsNative
import std.internal.text as textNative
import std.json as __json
import std.math as __math
import std.path as __path
import std.process as __process
import std.reflect as __reflect
import std.serialization as __serialization
import std.shapes as __shapes
import std.sync as __sync
import std.time as __time
import std.validate as __validate

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------

/// Makes a field a positional argument, in the order of the fields.
pub annotation Argument = {
    /// The value when it is missing, written as on the command line.
    default: String? = none
}

/// How a field is written as an option: its letter, its value when it is
/// missing, written as on the command line, the variables of the
/// environment read before it, the first that is set, and whether the help
/// leaves it out.
pub annotation Option = {
    short: String? = none
    default: String? = none
    env: Array[String] = []
    hidden: Bool = false
}

/// Makes a field, an `Array[String]`, take what the command does not read:
/// the arguments after `--`, the options it does not declare and the
/// arguments past its own, as written, to pass them on to another program.
pub annotation Rest = {
    /// What the help calls them.
    name: String = "args"
}

impl __reflect.Reflect for Argument {
    fn reflectShow(self, _nested: Bool): String {
        "cli.Argument"
    }
}

impl __reflect.Reflect for Option {
    fn reflectShow(self, _nested: Bool): String {
        "cli.Option"
    }
}

impl __reflect.Reflect for Rest {
    fn reflectShow(self, _nested: Bool): String {
        "cli.Rest"
    }
}

/// Why a command line was not read, with the usage of its command, or the
/// help that it asked for.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// type Options = { count: Int = 1 }
///
/// match cli.parseArgs[Options](["--count", "many"]) {
///     ok(options) => console.println("{options.count}")
///     err(error) => console.println("{error.message}")
/// }
/// ```
pub type CliError = {
    message: String
    help: Bool
}

impl Display for CliError {
    fn display(self): String {
        self.message
    }
}

/// A shell whose completion `completions` writes.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// type Options = { verbose: Bool = false }
///
/// // What `myapp completions zsh` prints, for the shell to load.
/// console.print(cli.completions[Options](cli.Shell.Zsh))
/// ```
pub enum Shell {
    Bash
    Zsh
    Fish
}

/// The command line of the program read as a `T`: writes the help asked
/// for and ends with 0, or writes the error and the usage to standard error
/// and ends with 2.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// /// Manages the notes.
/// enum Notes {
///     /// Adds a note.
///     Add(Note)
///     /// Lists the notes.
///     List
/// }
///
/// type Note = {
///     /// What it says.
///     text: String
/// }
///
/// match cli.parse[Notes]() {
///     Notes.Add(note) => console.println("added {note.text}")
///     Notes.List => console.println("no notes yet")
/// }
/// ```
pub fn parse[T: __reflect.Reflect](): T {
    match parseArgs[T](__env.args()) {
        ok(value) => value
        err(error) => {
            if error.help {
                __console.print(error.message)
                _ = __console.flush()
                __process.exit(0)
            }
            __console.eprintln(error.message)
            __process.exit(2)
        }
    }
}

/// The arguments, without the program's name, read as a `T`: what `parse`
/// does, with the failure to handle, as a test or a program that goes on
/// wants it. `--help` is a failure too, whose `help` is `true`.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// type Options = {
///     /// Who to greet.
///     name: String = "world"
/// }
///
/// match cli.parseArgs[Options](["--name", "Ada"]) {
///     ok(options) => console.println("hello {options.name}")
///     err(error) => console.eprintln(error.message)
/// }
/// ```
pub fn parseArgs[T: __reflect.Reflect](args: Array[String]): T ! CliError {
    let info = __reflect.typeInfo[T]()
    let read = valueOf(info, args, program())?
    let value = match read.to[T]() {
        ok(value) => value
        err(error) => panic("std.cli cannot make a `{info}` from the command line: {error}")
    }
    // The rules of `std.validate` on the options and arguments.
    match __validate.check(value) {
        ok(_) => value
        err(invalid) => {
            let broken = invalid.violations.map(
                (violation) {
                    let field = violation.path.split(".").get(-1) ?? violation.path
                    "`--{kebab(field)}` {violation.message}"
                },
            )
            fail CliError {
                message: "error: {broken.join("; ")}\n\nFor more, try `{program()} --help`."
                help: false
            }
        }
    }
}

/// The help of the command `T`.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// /// Greets someone.
/// type Options = {
///     /// Who to greet.
///     name: String = "world"
/// }
///
/// console.print(cli.help[Options]())
/// ```
pub fn help[T: __reflect.Reflect](): String {
    helpOf(__reflect.typeInfo[T](), program())
}

/// The name the program is run as.
fn program(): String {
    let file = __path.fileName(__env.executable()) ?? "program"
    file.removeSuffix(".exe")
}

/// A name of the program's code as the command line writes it: `dryRun` is
/// `dry-run`.
fn kebab(name: String): String {
    var written = ""
    for c in name.chars() {
        written = if c.isUpper() and not written.isEmpty() {
            "{written}-{c.toLower()}"
        } else {
            "{written}{c.toLower()}"
        }
    }
    written
}

/// An option or an argument of a command, from a field of its record.
type Spec = {
    field: String
    name: String
    docs: String
    short: String?
    default: String?
    /// The field's own default (language 9.2), which a missing value gives
    /// as it is, after the text of `default`.
    fallback: __reflect.Value?
    env: Array[String]
    hidden: Bool
    positional: Bool
    /// `@cli.Rest`: what the command does not read.
    rest: Bool
    info: __reflect.TypeInfo
}

fn specsOf(fields: Array[__reflect.FieldInfo]): Array[Spec] {
    fields.map(
        (field) {
            let argument = field.annotation[Argument]()
            let option = field.annotation[Option]() ?? Option {}
            let rest = field.annotation[Rest]()
            if rest.isSome() and "{field.typeInfo()}" != "Array[String]" {
                panic(
                    "`@cli.Rest` takes what a command passes on as written: declare `{field.name()}: Array[String]`",
                )
            }
            Spec {
                field: field.name()
                name: match rest {
                    some(found) => found.name
                    none => kebab(field.name())
                }
                docs: field.docs() ?? ""
                short: option.short
                default: match argument {
                    some(found) => found.default
                    none => option.default
                }
                fallback: field.default()
                env: option.env
                hidden: option.hidden
                positional: argument.isSome()
                rest: rest.isSome()
                info: field.typeInfo()
            }
        },
    )
}

/// What a value of a field is: a flag, one value, an optional one, many,
/// or the subcommands of an enum.
enum Arity {
    Flag
    One
    Optional
    Many
    Commands
}

fn arityOf(spec: Spec): Arity {
    match spec.info.kind() {
        __reflect.TypeKind.Primitive(__reflect.PrimitiveKind.Bool) if not spec.positional =>
            Arity.Flag
        __reflect.TypeKind.Applied(__reflect.AppliedKind.Option) => Arity.Optional
        __reflect.TypeKind.Applied(__reflect.AppliedKind.Array) => Arity.Many
        __reflect.TypeKind.Enum if spec.positional and not choices(spec.info) => Arity.Commands
        _ => Arity.One
    }
}

/// The type of the values of a field: its own, or what its optional or
/// array holds.
fn element(spec: Spec): __reflect.TypeInfo {
    match arityOf(spec) {
        Arity.Optional => spec.info.genericArguments().first() ?? spec.info
        Arity.Many => spec.info.genericArguments().first() ?? spec.info
        _ => spec.info
    }
}

/// Whether an enum is a choice of values: none of its variants has data.
fn choices(info: __reflect.TypeInfo): Bool {
    info.variants().all((variant) { variant.payloadKind() == __reflect.VariantPayloadKind.Unit })
}

fn usageError(path: String, problem: String, usage: String): CliError {
    CliError { message: "error: {problem}\n\n{usage}\nFor more, try `{path} --help`.", help: false }
}

/// The value a command line writes of a record or an enum.
fn valueOf(info: __reflect.TypeInfo, args: Array[String], path: String): __reflect.Value ! CliError {
    match info.kind() {
        __reflect.TypeKind.Enum => {
            var lifted: Map[String, Array[String]] = [:]
            subcommand(info, args, path, [], var lifted)?
        }
        __reflect.TypeKind.Record => {
            var lifted: Map[String, Array[String]] = [:]
            __shapes.record(members(info.fields(), info.docs(), args, path, [], var lifted)?)
        }
        _ => panic("std.cli reads a command line into a record or an enum, and `{info}` is neither")
    }
}

/// The subcommand the arguments start with, and what it reads of the rest;
/// the options of the commands around it that come after it go to `lifted`.
fn subcommand(
    info: __reflect.TypeInfo,
    args: Array[String],
    path: String,
    outer: Array[Spec],
    lifted: var Map[String, Array[String]],
): __reflect.Value ! CliError {
    let usage = commandsUsage(info, path)
    let first = match args.first() {
        some(first) => first
        none => fail usageError(path, "a command is missing", usage)
    }
    if first == "-h" or first == "--help" {
        fail CliError { message: helpOf(info, path), help: true }
    }
    let variants = info.variants()
    let names = variants.map((variant) { kebab(variant.name()) })
    let chosen = match variants.find((variant) { kebab(variant.name()) == first }) {
        some(chosen) => chosen
        none => fail usageError(path, "unknown command `{first}`{suggested(first, names)}", usage)
    }
    let rest = args.drop(1)
    let inner = "{path} {first}"
    match chosen.payloadKind() {
        __reflect.VariantPayloadKind.Unit => {
            if rest == ["-h"] or rest == ["--help"] {
                fail CliError { message: describe(chosen.docs(), "Usage: {inner}\n"), help: true }
            }
            if not rest.isEmpty() {
                fail usageError(
                    inner,
                    "`{first}` takes nothing more, and found `{rest[0]}`",
                    "Usage: {inner}\n",
                )
            }
            __shapes.variant(chosen.name(), [:], [])
        }
        __reflect.VariantPayloadKind.Record => {
            __shapes.variant(
                chosen.name(),
                members(chosen.fields(), chosen.docs(), rest, inner, outer, var lifted)?,
                [],
            )
        }
        __reflect.VariantPayloadKind.Tuple => {
            let parts = chosen.tupleElements()
            if parts.length() != 1 {
                panic(
                    "std.cli reads the payload of `{chosen.name()}` when it is one record or one enum",
                )
            }
            let payload = match parts[0].kind() {
                __reflect.TypeKind.Record => {
                    let docs = parts[0].docs() ?? chosen.docs()
                    __shapes.record(
                        members(parts[0].fields(), docs, rest, inner, outer, var lifted)?,
                    )
                }
                __reflect.TypeKind.Enum => subcommand(parts[0], rest, inner, outer, var lifted)?
                _ => panic(
                    "std.cli reads the payload of `{chosen.name()}` when it is one record or one enum",
                )
            }
            __shapes.variant(chosen.name(), [:], [payload])
        }
    }
}

/// The members of a record that the arguments write. An option of the
/// commands around it, `outer`, may come after its subcommand: it goes to
/// `lifted`, for the command that has it.
fn members(
    fields: Array[__reflect.FieldInfo],
    docs: String?,
    args: Array[String],
    path: String,
    outer: Array[Spec],
    lifted: var Map[String, Array[String]],
): Map[String, __reflect.Value] ! CliError {
    let specs = specsOf(fields)
    let usage = recordUsage(specs, path)
    let options = specs.filter((spec) { not spec.positional and not spec.rest })
    let arguments = specs.filter((spec) { spec.positional })
    let rest = specs.find((spec) { spec.rest })
    // Those of the commands around it that it does not shadow.
    let shared = outer.filter((spec) { not options.any((own) { own.name == spec.name }) })
    var written: Map[String, Array[String]] = [:]
    var found: Map[String, __reflect.Value] = [:]
    var position = 0
    var index = 0
    var plain = false
    for index < args.length() {
        let arg = args[index]
        index += 1
        if not plain and (arg == "-h" or arg == "--help") {
            fail CliError { message: recordHelp(specs.concat(shared), docs, path), help: true }
        }
        if not plain and arg == "--" {
            match rest {
                some(spec) => {
                    written[spec.field] = (written.get(spec.field) ?? []).concat(args.drop(index))
                    index = args.length()
                }
                none => plain = true
            }
            continue
        }
        if not plain and arg.startsWith("--") {
            let (name, inline) = match arg.find("=") {
                some(at) => (arg.slice(2, at) ?? "", arg.slice(at + 1, arg.length()).ok())
                none => (arg.removePrefix("--"), none)
            }
            // Its own, one of the commands around it, or what it passes on.
            let (spec, owner) = match options.find((spec) { spec.name == name }) {
                some(spec) => (spec, true)
                none => match (shared.find((spec) { spec.name == name }), rest) {
                    (some(spec), _) => (spec, false)
                    (none, some(passed)) => {
                        written[passed.field] = (written.get(passed.field) ?? []).concat([arg])
                        continue
                    }
                    (none, none) => {
                        let known = options.map((spec) { "--{spec.name}" })
                        fail usageError(
                            path,
                            "unknown option `--{name}`{suggested("--{name}", known)}",
                            usage,
                        )
                    }
                }
            }
            let value = match (arityOf(spec), inline) {
                (_, some(value)) => value
                (Arity.Flag, none) => "true"
                (_, none) => match args.get(index) {
                    some(next) => {
                        index += 1
                        next
                    }
                    none => fail usageError(path, "`--{name}` needs a value", usage)
                }
            }
            if owner {
                written[spec.field] = (written.get(spec.field) ?? []).concat([value])
            } else {
                lifted[spec.field] = (lifted.get(spec.field) ?? []).concat([value])
            }
            continue
        }
        if not plain and arg.startsWith("-") and arg.length() > 1 and not (arg[1].isDigit()) {
            // Letters this command does not know go on whole, with a `Rest`.
            let letters = arg.slice(1, arg.length()) ?? ""
            let knows = (letter: Char) {
                options.concat(shared).any((spec) { spec.short == some("{letter}") })
            }
            match rest {
                some(passed) if not letters.chars().all(knows) => {
                    written[passed.field] = (written.get(passed.field) ?? []).concat([arg])
                    continue
                }
                _ => {}
            }
            // Letters together, the last of which may take the rest as its value.
            var at = 1
            for at < arg.length() {
                let letter = "{arg[at]}"
                at += 1
                let (spec, owner) = match options.find((spec) { spec.short == some(letter) }) {
                    some(spec) => (spec, true)
                    none => match shared.find((spec) { spec.short == some(letter) }) {
                        some(spec) => (spec, false)
                        none => fail usageError(path, "unknown option `-{letter}`", usage)
                    }
                }
                if arityOf(spec) == Arity.Flag {
                    if owner {
                        written[spec.field] = (written.get(spec.field) ?? []).concat(["true"])
                    } else {
                        lifted[spec.field] = (lifted.get(spec.field) ?? []).concat(["true"])
                    }
                    continue
                }
                let value = if at < arg.length() {
                    arg.slice(at, arg.length()) ?? ""
                } else {
                    match args.get(index) {
                        some(next) => {
                            index += 1
                            next
                        }
                        none => fail usageError(path, "`-{letter}` needs a value", usage)
                    }
                }
                if owner {
                    written[spec.field] = (written.get(spec.field) ?? []).concat([value])
                } else {
                    lifted[spec.field] = (lifted.get(spec.field) ?? []).concat([value])
                }
                at = arg.length()
            }
            continue
        }
        // A positional argument; an enum's takes the rest as its command.
        let spec = match (arguments.get(position), rest) {
            (some(spec), _) => spec
            (none, some(passed)) => {
                written[passed.field] = (written.get(passed.field) ?? []).concat([arg])
                continue
            }
            (none, none) => fail usageError(path, "unexpected argument `{arg}`", usage)
        }
        if arityOf(spec) == Arity.Commands {
            // Its options may come after it too.
            found[spec.field] =
                subcommand(
                    spec.info,
                    args.drop(index - 1),
                    path,
                    options.concat(shared),
                    var written,
                )?
            index = args.length()
            continue
        }
        written[spec.field] = (written.get(spec.field) ?? []).concat([arg])
        if arityOf(spec) != Arity.Many {
            position += 1
        }
    }
    for spec in specs {
        if spec.field in found {
            continue
        }
        var texts = written.get(spec.field) ?? []
        if texts.isEmpty() {
            match spec.env.map((name) { __env.get(name) }).find((value) { value.isSome() }) {
                some(some(value)) => texts = [value]
                _ => {}
            }
        }
        if texts.isEmpty() {
            match spec.default {
                some(value) => texts = [value]
                none => {}
            }
        }
        // The field's default, as it is.
        if texts.isEmpty() and spec.fallback.isSome() {
            continue
        }
        let shown = if spec.positional { "<{spec.name}>" } else { "--{spec.name}" }
        match arityOf(spec) {
            Arity.Flag => {
                let value = texts.last() ?? "false"
                found[spec.field] = typed(spec.info, value, shown, path, usage)?
            }
            Arity.Optional => match texts.last() {
                some(value) => found[spec.field] = typed(element(spec), value, shown, path, usage)?
                none => {}
            }
            Arity.Many => {
                var items: Array[__reflect.Value] = []
                for value in texts {
                    items.push(typed(element(spec), value, shown, path, usage)?)
                }
                found[spec.field] = __shapes.sequence(items)
            }
            Arity.Commands => fail usageError(path, "a command is missing", usage)
            Arity.One => match texts.last() {
                some(value) => found[spec.field] = typed(spec.info, value, shown, path, usage)?
                none => fail usageError(path, "`{shown}` is missing", usage)
            }
        }
    }
    // What a command around it has, for that command.
    for (field, texts) in written {
        if not specs.any((spec) { spec.field == field }) {
            lifted[field] = (lifted.get(field) ?? []).concat(texts)
        }
    }
    found
}

/// The value of a type that a text of the command line writes.
fn typed(
    info: __reflect.TypeInfo,
    written: String,
    shown: String,
    path: String,
    usage: String,
): __reflect.Value ! CliError {
    match info.kind() {
        __reflect.TypeKind.Primitive(kind) => match __shapes.scalar(kind, written) {
            ok(value) => value
            err(problem) => fail usageError(path, "{shown}: {problem}", usage)
        }
        __reflect.TypeKind.Enum if choices(info) => {
            let names = info.variants().map((variant) { kebab(variant.name()) })
            match info.variants().find((variant) { kebab(variant.name()) == written }) {
                some(variant) => __shapes.variant(variant.name(), [:], [])
                none => fail usageError(
                    path,
                    "{shown}: `{written}` is not one of {names.join(", ")}",
                    usage,
                )
            }
        }
        __reflect.TypeKind.Newtype => match info.underlying() {
            some(inner) => typed(inner, written, shown, path, usage)?
            none => panic("std.cli cannot read a `{info}`")
        }
        _ if "{info}" == "time.Duration" => match __time.parseDuration(written) {
            ok(duration) => __reflect.valueOf(duration)
            err(_) => fail usageError(
                path,
                "{shown}: `{written}` is not a duration, as `30s`, `1m30s` or `250ms`",
                usage,
            )
        }
        _ => panic(
            "std.cli reads texts, characters, numbers, `Bool`s, durations and enums without data, optional or in arrays, and not a `{info}`",
        )
    }
}

/// "; did you mean `x`?", for the name nearest to what was written.
fn suggested(written: String, names: Array[String]): String {
    var best = ""
    var distance = written.length() / 2 + 2
    for name in names {
        let apart = edits(written, name)
        if apart < distance {
            best = name
            distance = apart
        }
    }
    if best.isEmpty() { "" } else { "; did you mean `{best}`?" }
}

/// How many characters to add, remove or change to make one text the other.
fn edits(a: String, b: String): Int {
    let left: Array[Char] = a.chars().collect()
    let right: Array[Char] = b.chars().collect()
    var previous: Array[Int] = []
    for j in 0..=right.length() {
        previous.push(j)
    }
    for i in 1..=left.length() {
        var current = [i]
        for j in 1..=right.length() {
            let change = previous[j - 1] + if left[i - 1] == right[j - 1] { 0 } else { 1 }
            current.push(change.min(previous[j] + 1).min(current[j - 1] + 1))
        }
        previous = current
    }
    previous[right.length()]
}

// ---------------------------------------------------------------------------
// Help
// ---------------------------------------------------------------------------

fn helpOf(info: __reflect.TypeInfo, path: String): String {
    match info.kind() {
        __reflect.TypeKind.Enum => describe(info.docs(), commandsUsage(info, path))
        _ => recordHelp(specsOf(info.fields()), info.docs(), path)
    }
}

fn describe(docs: String?, usage: String): String {
    match docs {
        some(text) => "{text}\n\n{usage}"
        none => usage
    }
}

/// Rows of two columns, the first padded to the widest.
fn lined(rows: Array[(String, String)]): String {
    var wide = 0
    for (left, _) in rows {
        wide = wide.max(left.length())
    }
    var written = ""
    for (left, right) in rows {
        let line = if right.isEmpty() { "  {left}" } else { "  {left.padEnd(wide)}  {right}" }
        written = "{written}{line}\n"
    }
    written
}

/// The first paragraph of a documentation, its lines joined: the whole of
/// what an option or a command is, and not its first line alone, which
/// may end in the middle of a sentence.
fn summary(docs: String?): String {
    var words: Array[String] = []
    for line in (docs ?? "").lines() {
        let trimmed = line.trim()
        if trimmed.isEmpty() {
            if not words.isEmpty() {
                break
            }
            continue
        }
        words.push(trimmed)
    }
    words.join(" ")
}

fn commandsUsage(info: __reflect.TypeInfo, path: String): String {
    let rows = info.variants().map((variant) { (kebab(variant.name()), summary(variant.docs())) })
    "Usage: {path} <command>\n\nCommands:\n{lined(rows)}"
}

fn recordUsage(specs: Array[Spec], path: String): String {
    var line = "Usage: {path}"
    if specs.any((spec) { not spec.positional }) {
        line = "{line} [options]"
    }
    for spec in specs.filter((spec) { spec.positional or spec.rest }) {
        if spec.rest {
            line = "{line} [-- <{spec.name}>...]"
            continue
        }
        line = match arityOf(spec) {
            Arity.Optional => "{line} [{spec.name}]"
            Arity.Many => "{line} [{spec.name}...]"
            Arity.Commands => "{line} <command>"
            _ => "{line} <{spec.name}>"
        }
    }
    "{line}\n"
}

fn recordHelp(specs: Array[Spec], docs: String?, path: String): String {
    var written = describe(docs, recordUsage(specs, path))
    let arguments = specs.filter((spec) { spec.positional })
    if not arguments.isEmpty() {
        written =
            "{written}\nArguments:\n{lined(arguments.map((spec) { ("<{spec.name}>", details(spec)) }))}"
        for spec in arguments {
            if arityOf(spec) == Arity.Commands {
                let rows = spec.info
                    .variants()
                    .map((variant) { (kebab(variant.name()), summary(variant.docs())) })
                written = "{written}\nCommands:\n{lined(rows)}"
            }
        }
    }
    var rows: Array[(String, String)] = []
    for spec in specs.filter((spec) { not spec.positional and not spec.hidden and not spec.rest }) {
        let letter = match spec.short {
            some(short) => "-{short}, "
            none => "    "
        }
        let value = match arityOf(spec) {
            Arity.Flag => ""
            Arity.Many => " <{spec.name}>..."
            _ => " <{spec.name}>"
        }
        rows.push(("{letter}--{spec.name}{value}", details(spec)))
    }
    rows.push(("-h, --help", "Shows this help."))
    "{written}\nOptions:\n{lined(rows)}"
}

/// A field's default as the command line writes it: a variant in
/// kebab-case, and the elements of a list one after another.
fn asTyped(value: __reflect.Value): String {
    match value.typeInfo().kind() {
        __reflect.TypeKind.Enum => kebab(value.variant() ?? "{value}")
        __reflect.TypeKind.Applied(__reflect.AppliedKind.Array) => value
            .elements()
            .map((item) { asTyped(item) })
            .join(", ")
        _ => "{value}"
    }
}

/// A field's help: its documentation, its choices, default and variable.
fn details(spec: Spec): String {
    var written = summary(spec.docs)
    let values = element(spec)
    if values.kind() == __reflect.TypeKind.Enum and choices(values) {
        written =
            "{written} [{values.variants().map((variant) { kebab(variant.name()) }).join(", ")}]"
    }
    match (spec.default, spec.fallback) {
        (some(value), _) => written = "{written} [default: {value}]"
        (none, some(value)) => written = "{written} [default: {asTyped(value)}]"
        (none, none) => {}
    }
    if not spec.env.isEmpty() {
        written = "{written} [env: {spec.env.join(", ")}]"
    }
    written.trim()
}

// ---------------------------------------------------------------------------
// Completion
// ---------------------------------------------------------------------------

/// A command the completion knows: its words after the program, and what
/// may follow them.
type Completed = {
    path: Array[String]
    words: Array[String]
}

/// What completes each command; `shared` are the options of the commands
/// around it, which it reads too.
fn completedOf(
    info: __reflect.TypeInfo,
    path: Array[String],
    shared: Array[String],
): Array[Completed] {
    var found: Array[Completed] = []
    match info.kind() {
        __reflect.TypeKind.Enum => {
            found.push(
                Completed { path, words: info.variants().map((variant) { kebab(variant.name()) }) },
            )
            for variant in info.variants() {
                let inner = path.concat([kebab(variant.name())])
                match variant.payloadKind() {
                    __reflect.VariantPayloadKind.Record => found.extend(
                        fieldsCompleted(variant.fields(), inner, shared),
                    )
                    __reflect.VariantPayloadKind.Tuple => {
                        for part in variant.tupleElements() {
                            found.extend(completedOf(part, inner, shared))
                        }
                    }
                    __reflect.VariantPayloadKind.Unit => found.push(
                        Completed { path: inner, words: shared },
                    )
                }
            }
        }
        __reflect.TypeKind.Record => found.extend(fieldsCompleted(info.fields(), path, shared))
        _ => {}
    }
    found
}

fn fieldsCompleted(
    fields: Array[__reflect.FieldInfo],
    path: Array[String],
    shared: Array[String],
): Array[Completed] {
    let specs = specsOf(fields)
    var words: Array[String] = ["--help"]
    for spec in specs {
        if not spec.positional and not spec.hidden and not spec.rest {
            words.push("--{spec.name}")
        }
    }
    let own = words
    words.extend(shared.filter((word) { not own.any((known) { known == word }) }))
    var found: Array[Completed] = []
    for spec in specs {
        if arityOf(spec) == Arity.Commands {
            found.extend(completedOf(spec.info, path, words.filter((word) { word != "--help" })))
        }
    }
    found.insert(0, Completed { path, words })
    found
}

/// The script that completes the program's command line in `shell`, to
/// print for the shell to load.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// type Options = {
///     /// Who to greet.
///     name: String = "world"
/// }
///
/// console.print(cli.completions[Options](cli.Shell.Bash))
/// ```
pub fn completions[T: __reflect.Reflect](shell: Shell): String {
    let name = program()
    let commands = completedOf(__reflect.typeInfo[T](), [], [])
    let function = "_{name.replace("-", "_")}"
    match shell {
        Shell.Fish => {
            var script = ""
            for command in commands {
                let seen = match command.path.last() {
                    some(last) => "__fish_seen_subcommand_from {last}"
                    none => "__fish_use_subcommand"
                }
                for word in command.words {
                    let item = if word.startsWith("--") {
                        "-l {word.removePrefix("--")}"
                    } else {
                        "-a {word}"
                    }
                    script = "{script}complete -c {name} -f -n '{seen}' {item}\n"
                }
            }
            script
        }
        _ => {
            var cases = ""
            for command in commands {
                cases =
                    "{cases}        \"{command.path.join(" ")}\") words=\"{command.words.join(" ")}\" ;;\n"
            }
            let bash =
                "{function}() {{\n    local path=\"\" word\n    for word in \"${{COMP_WORDS[@]:1:COMP_CWORD-1}}\"; do\n        case \"$word\" in -*) ;; *) local next=\"${{path:+$path }}$word\"; {function}_known \"$next\" && path=\"$next\" ;; esac\n    done\n    local words\n    case \"$path\" in\n{cases}        *) words=\"\" ;;\n    esac\n    COMPREPLY=($(compgen -W \"$words\" -- \"${{COMP_WORDS[COMP_CWORD]}}\"))\n}}\n{function}_known() {{\n    case \"$1\" in\n{commands.map((c) { "        \"{c.path.join(" ")}\") return 0 ;;\n" }).join("")}    esac\n    return 1\n}}\ncomplete -F {function} {name}\n"
            match shell {
                Shell.Zsh => "#compdef {name}\nautoload -U +X bashcompinit && bashcompinit\n{bash}"
                _ => bash
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The terminal
// ---------------------------------------------------------------------------

/// Whether the console's output is a terminal: `false` when it goes to a
/// pipe or a file, where a question or a bar has nobody to see it.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// if cli.isTerminal() {
///     console.println(cli.markup("[green]ready[/]"))
/// } else {
///     console.println("ready")
/// }
/// ```
pub fn isTerminal(): Bool {
    textNative.terminal(0)
}

/// The columns of the terminal of the console's output, or 80 without one.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// console.println("─".repeat(cli.terminalWidth()))
/// ```
pub fn terminalWidth(): Int {
    terminalSize().map((found) { found.columns }) ?? 80
}

/// The size of a terminal, in characters.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// let size = cli.terminalSize() ?? cli.Size { columns: 80, rows: 24 }
/// console.println("{size.columns} columns, {size.rows} rows")
/// ```
pub type Size = {
    columns: Int
    rows: Int
}

/// The size of the terminal of the console's output, or `none` without one,
/// or while it reports no size, 0 by 0, as some do before one is set.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// match cli.terminalSize() {
///     some(size) => console.println("{size.columns}×{size.rows}")
///     none => console.println("no terminal")
/// }
/// ```
pub fn terminalSize(): Size? {
    let found = fsNative.terminalSize()
    if found.isEmpty() {
        return none
    }
    Size { columns: found[0], rows: found[1] }
}

/// The sizes to draw the screen at: one when the terminal changes its
/// size, and one when the program comes back after Ctrl-Z and `fg`, as both
/// mean drawing again. Two the channel has not given yet are one, the last.
/// A terminal that reports no size gives none until it has one. When the
/// output is not a terminal the channel is closed, so a `for` over it ends
/// at once, and in a `select` its `receive()` gives `none` at once.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// fn draw(size: cli.Size) {
///     console.print("\u{1b}[2J\u{1b}[H{"─".repeat(size.columns)}")
/// }
///
/// fn redrawing() {
///     for size in cli.redraws() {
///         draw(size)
///     }
/// }
///
/// spawn detached redrawing()
/// ```
pub fn redraws(): Receiver[Size] {
    fsNative.terminalRedraws()
}

/// Why `cli.Terminal()` could not take the terminal.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// match cli.Terminal() {
///     ok(terminal) => terminal.release()
///     err(cli.TerminalError.NotATerminal) => console.println("no terminal to take")
///     err(cli.TerminalError.Taken) => console.println("taken already")
/// }
/// ```
pub enum TerminalError {
    /// The program's input is not a terminal, but a pipe or a file.
    NotATerminal
    /// Another `cli.Terminal` holds it.
    Taken
}

impl Display for TerminalError {
    fn display(self): String {
        match self {
            TerminalError.NotATerminal => "the program's input is not a terminal"
            TerminalError.Taken => "another cli.Terminal holds the terminal"
        }
    }
}

/// An error, which reflection shows as its message, so a method that fails
/// with one is a tool of `std.mcp` or a field of `std.graphql`.
impl __reflect.Reflect for TerminalError {
    fn reflectShow(self, _nested: Bool): String {
        "{self}"
    }
}

/// The terminal, taken over by the program. Keys arrive as they are pressed
/// rather than in lines, unless `lines`, and are not shown, unless `echo`;
/// `screen` draws on the alternate screen, as editors do, and the terminal
/// shows what it had when it is given back; with `signals: false` Ctrl-C
/// and Ctrl-Z are keys rather than cancelling and suspending the program.
///
/// It is given back as it was when its value ends, also through a panic or
/// a cancellation, and while the program is suspended by Ctrl-Z, until `fg`
/// takes it again and `redraws()` gives the size to draw at. `release`
/// gives it back before. The questions of this module ask in the mode each
/// needs while it is held, and then leave it as it was.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// fn main(): !cli.TerminalError {
///     let terminal = cli.Terminal()?
///     console.println("press q to end")
///     for key in terminal.keys() {
///         if key == cli.Key.Char('q') {
///             break
///         }
///     }
/// }
/// ```
pub type Terminal = {
    priv native: fsNative.Owned
}

/// The terminal, taken in the mode asked: fails without one, or while
/// another `cli.Terminal` holds it.
pub fn Terminal(
    echo: Bool = false,
    lines: Bool = false,
    screen: Bool = false,
    signals: Bool = true,
): Terminal ! TerminalError {
    let native = fsNative.terminalTake(echo, lines, screen, if signals { 1 } else { 0 }, true)
    match fsNative.terminalStatus(ref native) {
        0 => Terminal { native }
        1 => fail TerminalError.NotATerminal
        _ => fail TerminalError.Taken
    }
}

/// Gives the terminal back now, as it was; its keys end.
pub fn Terminal.release(self) {
    fsNative.terminalRelease(ref self.native)
}

/// The keys pressed from now on: arrows, Enter and the rest as their own
/// variants, a key with Ctrl or Alt as one with that letter, and a lone
/// Escape told from the start of a sequence by the pause after it. While a
/// question of this module asks, the keys are its own. The channel closes
/// when the terminal is given back.
pub fn Terminal.keys(self): Receiver[Key] {
    keysOf(fsNative.terminalKeys(ref self.native))
}

/// A key pressed on a taken terminal.
///
/// ```tondo
/// import std.cli
///
/// fn moved(key: cli.Key, at: Int): Int {
///     match key {
///         cli.Key.Up | cli.Key.Char('k') => at - 1
///         cli.Key.Down | cli.Key.Char('j') => at + 1
///         _ => at
///     }
/// }
///
/// assert(moved(cli.Key.Down, 3) == 4)
/// ```
pub enum Key {
    /// A character, as it was typed.
    Char(Char)
    /// Ctrl with a letter, in lowercase, or with a space or a sign.
    Ctrl(Char)
    /// Alt with a character.
    Alt(Char)
    Enter
    Tab
    /// Shift and Tab.
    BackTab
    Backspace
    Delete
    Insert
    Escape
    Up
    Down
    Left
    Right
    Home
    End
    PageUp
    PageDown
    /// A function key, from F1.
    F(Int)
}

/// The keys of the runtime's reader, as a channel.
fn keysOf(reader: fsNative.Native): Receiver[Key] {
    let (sender, receiver) = channel[Key](discardWhenAbandoned: true)
    spawn detached forwardKeys(reader, sender)
    receiver
}

fn forwardKeys(reader: fsNative.Native, sender: Sender[Key]) {
    for {
        let code = fsNative.terminalKey(reader)
        if code < 0 or sender.isAbandoned() {
            break
        }
        sender.send(keyOf(code))
    }
}

/// A key as the runtime gives it: its variant above 32 bits, and below its
/// character or number.
fn keyOf(code: Int): Key {
    let value = code & 0xffffffff
    let character = textNative.charFrom(value)
    match code >> 32 {
        0 => Key.Char(character)
        1 => Key.Ctrl(character)
        2 => Key.Alt(character)
        3 => Key.Enter
        4 => Key.Tab
        5 => Key.BackTab
        6 => Key.Backspace
        7 => Key.Delete
        8 => Key.Insert
        9 => Key.Escape
        10 => Key.Up
        11 => Key.Down
        12 => Key.Left
        13 => Key.Right
        14 => Key.Home
        15 => Key.End
        16 => Key.PageUp
        17 => Key.PageDown
        _ => Key.F(value)
    }
}

/// The terminal in lines, `echo` or not, while a question asks: it is
/// given back however the question ends.
fn asking(echo: Bool): fsNative.Owned {
    fsNative.terminalTake(echo, true, false, -1, false)
}

/// Whether styles write their codes: on a terminal without `NO_COLOR`, or
/// with `FORCE_COLOR`.
fn painting(): Bool {
    match __env.get("FORCE_COLOR") {
        some(value) if value != "" and value != "0" => return true
        _ => {}
    }
    isTerminal() and __env.get("NO_COLOR").isNone() and __env.get("TERM") != "dumb"
}

/// A text with styles, to print: `[bold red]error[/]` gives `error` in bold
/// red, and what follows as it was; blocks nest, and `[[` and `]]` give
/// brackets. With an interpolated string, its values stay as they are. No
/// codes off a terminal or with `NO_COLOR`.
///
/// It writes nothing itself: print what it gives.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// let name = "Ada [admin]"
/// console.println(cli.markup("[bold red]error:[/] no user [yellow]{name}[/]"))
/// console.println(cli.markup("[black on #ffcc00] note [/] use [[brackets]] so"))
/// ```
pub fn markup(text: String): String {
    let paint = painting()
    let chars: Array[Char] = text.chars().collect()
    var written = ""
    var styles: Array[String] = []
    var at = 0
    for at < chars.length() {
        let c = chars[at]
        let next = chars.get(at + 1)
        if c == '[' and next == '[' {
            written = "{written}["
            at += 2
            continue
        }
        if c == ']' and next == ']' {
            written = "{written}]"
            at += 2
            continue
        }
        if c == '[' {
            var close = at + 1
            for close < chars.length() and chars[close] != ']' {
                close += 1
            }
            let tag = if close < chars.length() { text.slice(at + 1, close) ?? "" } else { "" }
            if tag == "/" and not styles.isEmpty() {
                _ = styles.pop()
                if paint {
                    written = "{written}\u{1b}[0m{styles.join("")}"
                }
                at = close + 1
                continue
            }
            match codes(tag) {
                some(code) if close < chars.length() => {
                    styles.push(code)
                    if paint {
                        written = "{written}{code}"
                    }
                    at = close + 1
                    continue
                }
                _ => {}
            }
        }
        written = "{written}{c}"
        at += 1
    }
    if paint and not styles.isEmpty() {
        written = "{written}\u{1b}[0m"
    }
    written
}

/// A value inside a markup that a program interpolates: its brackets as
/// they are.
fn markupText(value: String): String {
    value.replace("[", "[[").replace("]", "]]")
}

/// The codes of a style: colors, `on` a color, and decorations.
fn codes(style: String): String? {
    if style.trim().isEmpty() {
        return none
    }
    var numbers: Array[String] = []
    var background = false
    for word in style.words() {
        if word == "on" {
            background = true
            continue
        }
        let code = match word {
            "bold" => "1"
            "dim" => "2"
            "italic" => "3"
            "underline" => "4"
            "strikethrough" => "9"
            _ => match colorCode(word, background) {
                some(color) => color
                none => return none
            }
        }
        background = false
        numbers.push(code)
    }
    if background {
        return none
    }
    "\u{1b}[{numbers.join(";")}m"
}

/// The code of a color, of the text or of its `background`.
fn colorCode(word: String, background: Bool): String? {
    let base = if background { 40 } else { 30 }
    let names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    for index in 0..names.length() {
        if names[index] == word {
            return "{base + index}"
        }
    }
    if word == "gray" {
        return "{base + 60}"
    }
    if word.startsWith("#") and word.length() == 7 {
        let digits = word.removePrefix("#")
        let part = (from: Int) { Int.parse(digits.slice(from, from + 2) ?? "", radix: 16).ok() }
        match (part(0), part(2), part(4)) {
            (some(r), some(g), some(b)) => return "{base + 8};2;{r};{g};{b}"
            _ => {}
        }
    }
    none
}

/// How many columns of a terminal a text takes, without the codes of its
/// styles: two for a character East Asian text writes wide, as `漢` or most
/// emoji, none for a mark that goes on the character before it or a format
/// character, as a joiner, and one for any other.
fn visible(text: String): Int {
    var count = 0
    var escaping = false
    for c in text.chars() {
        if escaping {
            escaping = c != 'm'
        } else if c == '\u{1b}' {
            escaping = true
        } else {
            count += columnsOf(c)
        }
    }
    count
}

/// The columns a character takes.
fn columnsOf(c: Char): Int {
    let code = c.code()
    if code < 0x300 {
        return 1
    }
    // The ranges of East Asian Width W and F, from Unicode 16, in order.
    let wide = wideRanges()
    var low = 0
    var high = wide.length() / 2
    for low < high {
        let middle = (low + high) / 2
        if code > wide[middle * 2 + 1] {
            low = middle + 1
        } else if code < wide[middle * 2] {
            high = middle
        } else {
            return 2
        }
    }
    // Nonspacing and enclosing marks, and format characters.
    match textNative.category(c) {
        5 | 7 | 26 => 0
        _ => 1
    }
}

fn wideRanges(): Array[Int] {
    [
        0x1100,
        0x115F,
        0x231A,
        0x231B,
