// std.protobuf (standard library 14.12): Protocol Buffers, the binary
// format of gRPC. A record whose fields carry numbers is a message and an
// enum whose variants carry numbers is a protobuf enum: the compiler writes
// their `Message` and `Enum` implementations from those annotations, field
// by field, on the runtime's writer and reader of the wire format.
//
// ```tondo
// import std.console
// import std.protobuf
//
// // A `.proto` file under `src` is a module of such records; one can be
// // written by hand too.
// pub type Point = {
//     @protobuf.Field(1)
//     x: Int32 = 0
//     @protobuf.Field(2)
//     y: Int32 = 0
// }
//
// let bytes = protobuf.encode(Point { x: 3, y: 4 })
// let point = protobuf.decode[Point](bytes)?
// console.println("{bytes.length()} bytes: {point.x}, {point.y} {protobuf.toJson(point)?}")
// ```

import std.encoding as __encoding
import std.internal.protobuf as pbNative
import std.io as __io
import std.json as __json
import std.reflect as __reflect
import std.serialization
import std.time as __time

// ---------------------------------------------------------------------------
// Annotations
// ---------------------------------------------------------------------------

/// The number of a field of a message, or of a variant of a `oneof`:
/// `@protobuf.Field(1)`. `encoding` chooses among the ways protobuf writes
/// the field's type, and `packed: false` writes a repeated number with a
/// tag each, as proto2 does.
pub annotation Field = {
    number: Int
    encoding: Encoding = Encoding.Default
    packed: Bool = true
    /// Its name in the `.proto`, when it is not the field's, as `user_id`,
    /// which JSON reads and, with `protoNames`, writes.
    name: String = ""
}

/// How a field is written, where protobuf has several ways for its type.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// pub type Reading = {
///     // A sensor's id, written in 4 bytes: fixed32.
///     @protobuf.Field(1, encoding: protobuf.Encoding.Fixed)
///     sensor: UInt32 = 0
///     // Often negative: a zigzag varint, sint32.
///     @protobuf.Field(2, encoding: protobuf.Encoding.ZigZag)
///     delta: Int32 = 0
///     // An optional number that keeps zero apart from absent: Int32Value.
///     @protobuf.Field(3, encoding: protobuf.Encoding.Wrapper)
///     limit: Int32? = none
/// }
///
/// let bytes = protobuf.encode(Reading { sensor: 7u32, delta: -2, limit: some(0) })
/// console.println("{bytes.length()} bytes: {protobuf.decode[Reading](bytes)?.limit}")
/// ```
pub enum Encoding {
    /// As its type says: an integer as a varint, int32 to uint64.
    Default
    /// A signed integer as a zigzag varint: sint32 and sint64.
    ZigZag
    /// An integer in 4 or 8 bytes, by its width: fixed32, fixed64, sfixed32
    /// and sfixed64.
    Fixed
    /// A message as a group of proto2.
    Group
    /// An optional value as a wrapper of `google.protobuf`, as `Int32Value`.
    Wrapper
    /// A `json.Value` as a `google.protobuf.Struct`, an object, or a
    /// `ListValue`, an array, rather than as a `Value`.
    Struct
    List
}

/// The number of a variant of a protobuf enum: `@protobuf.Value(1)`.
pub annotation Value = {
    number: Int
}

/// The full name of a message, which `Any` and gRPC use:
/// `@protobuf.Name("users.v1.User")`; without it, the type's own name.
pub annotation Name = {
    name: String
}

/// Keeps the fields a message does not know in a field of type
/// `UnknownFields`, which writing puts back.
pub annotation Unknown = {}

/// A `.proto` file as reflection gives it to tools: its path, the full
/// names it declares, its `FileDescriptorProto` and the files it imports.
/// The module of a `.proto` file gives its own as `fileDescriptor()`.
///
/// ```tondo
/// import std.console
/// import std.grpc
///
/// // The `.proto` files a service comes from, which reflection gives tools.
/// for file in grpc.Health.new().service().files {
///     console.println("{file.name}: {file.symbols.length()} names, {file.imports.length()} imports")
/// }
/// ```
pub type FileDescriptor = {
    name: String
    symbols: Array[String] = []
    bytes: Array[Byte] = []
    imports: Array[FileDescriptor] = []
}

/// The fields of a message that its type does not know, as they were read.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// pub type UserV2 = {
///     @protobuf.Field(1)
///     name: String = ""
///     @protobuf.Field(2)
///     email: String = ""
/// }
///
/// /// An older reader that keeps what it does not know, and writes it back.
/// pub type UserV1 = {
///     @protobuf.Field(1)
///     name: String = ""
///     @ignore
///     @protobuf.Unknown
///     unknown: protobuf.UnknownFields = protobuf.UnknownFields {}
/// }
///
/// let old = protobuf.decode[UserV1](protobuf.encode(UserV2 { name: "Ada", email: "ada@example.com" }))?
/// let again = protobuf.decode[UserV2](protobuf.encode(old with { name: "Ada L." }))?
/// console.println("{old.unknown.isEmpty()} {again.name} {again.email}")
/// ```
pub type UnknownFields = {
    priv bytes: Array[Byte] = []
}

/// Whether there are none.
pub fn UnknownFields.isEmpty(self): Bool {
    self.bytes.isEmpty()
}

// ---------------------------------------------------------------------------
// Messages and enums
// ---------------------------------------------------------------------------

/// A message: the compiler implements it for a record whose fields carry
/// `@protobuf.Field`.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// // The compiler implements `Message` for records with `@protobuf.Field`; a
/// // type can also write it by hand.
/// pub type Point = { x: Int, y: Int }
///
/// impl protobuf.Message for Point {
///     fn writeTo(self, out: protobuf.Writer) {
///         if self.x != 0 {
///             out.sint64(1, self.x)
///         }
///         if self.y != 0 {
///             out.sint64(2, self.y)
///         }
///     }
///
///     fn readFrom(input: protobuf.Reader): Point ! protobuf.ProtobufError {
///         var point = Point { x: 0, y: 0 }
///         for {
///             match input.next()? {
///                 0 => break
///                 1 => point.x = input.sint64("x")?
///                 2 => point.y = input.sint64("y")?
///                 _ => input.skip()?
///             }
///         }
///         point
///     }
///
///     fn protobufName(): String {
///         "geo.Point"
///     }
/// }
///
/// let bytes = protobuf.encode(Point { x: -3, y: 4 })
/// let point = protobuf.decode[Point](bytes)?
/// console.println("{bytes} {point.x},{point.y} {protobuf.pack(point).typeUrl}")
/// ```
pub trait Message {
    fn writeTo(self, out: Writer)

    fn readFrom(input: Reader): Self ! ProtobufError

    /// Its full name, as `users.v1.User`.
    fn protobufName(): String

    /// Writes the message as proto3's mapping to JSON gives it, which the
    /// compiler writes for each message it implements.
    fn writeJson(self, out: JsonWriter): !ProtobufError {
        fail jsonError(serialization.ErrorKind.Unsupported, "$", "this message has no form in JSON")
    }

    /// The message a JSON value gives, as proto3's mapping reads it.
    fn readJson(input: JsonReader, value: __json.Value): Self ! ProtobufError {
        fail jsonError(serialization.ErrorKind.Unsupported, "$", "this message has no form in JSON")
    }
}

/// A protobuf enum: the compiler implements it for an enum whose variants
/// carry `@protobuf.Value`. One with an `Unrecognized(Int32)` variant is
/// open, and keeps a number it does not know there.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// pub enum Status {
///     @protobuf.Value(0)
///     Unspecified
///     @protobuf.Value(1)
///     Active
///     @protobuf.Value(2)
///     Suspended
///     // Open: a number this program does not know is kept here.
///     Unrecognized(Int32)
/// }
///
/// pub type Account = {
///     @protobuf.Field(1)
///     status: Status = Status.Unspecified
/// }
///
/// let account = protobuf.decode[Account](protobuf.encode(Account { status: Status.Suspended }))?
/// console.println("{protobuf.Enum.number(account.status)} {protobuf.toJson(account)?}")
/// match protobuf.Enum.fromNumber[Status](7) {
///     some(Status.Unrecognized(number)) => console.println("unknown {number}")
///     _ => console.println("known")
/// }
/// ```
pub trait Enum {
    fn number(self): Int32

    fn fromNumber(number: Int32): Self?

    /// The value's name in the `.proto`, as JSON writes it; its number
    /// without one.
    fn protobufValueName(self): String {
        "{self.number()}"
    }

    /// The value of a name in the `.proto`.
    fn fromProtobufValueName(name: String): Self? {
        none
    }
}

/// A failure to read protobuf, with the path of the field and the byte it
/// starts at, as `column`: the error of every format.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// pub type User = {
///     @protobuf.Field(1)
///     name: String = ""
///     @protobuf.Field(2)
///     id: Int = 0
/// }
///
/// // Field 1 says 10 bytes of text follow, but only 2 do.
/// match protobuf.decode[User]([0x0a, 0x0a, 0x41, 0x64]) {
///     ok(user) => console.println(user.name)
///     err(error) => console.println("{error.kind} at {error.path}: {error.message}")
/// }
/// ```
pub alias ProtobufError = serialization.Error

/// The bytes of a message: its fields in the order of their numbers, map
/// entries in their order, or with `deterministic` sorted by key, so that
/// equal messages give equal bytes.
pub fn encode[T: Message](value: T, deterministic: Bool = false): Array[Byte] {
    let out = Writer { native: pbNative.writer(deterministic) }
    value.writeTo(out)
    pbNative.finish(out.native)
}

/// The message the bytes hold.
pub fn decode[T: Message](bytes: Array[Byte]): T ! ProtobufError {
    Message.readFrom[T](Reader { native: pbNative.reader(bytes) })
}

/// Writes the bytes of a message to a stream.
pub fn encodeTo[T: Message](value: T, out: __io.Writer, deterministic: Bool = false): !__io.IoError {
    out.writeBytes(encode(value, deterministic))?
}

/// The message a stream holds, read to its end.
pub fn decodeFrom[T: Message](input: __io.Reader): T ! ProtobufError {
    match input.readBytes() {
        ok(bytes) => decode[T](bytes)?
        err(error) => fail serialization.Error {
            kind: serialization.ErrorKind.Io
            message: "{error}"
            path: "$"
            line: 0
            column: 0
            violations: []
        }
    }
}

// ---------------------------------------------------------------------------
// Writing
// ---------------------------------------------------------------------------

/// Writes the fields of messages, each after the tag of its number; the
/// number 0 writes a value with no tag, as an element of a packed field.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// pub type Tag = { name: String }
///
/// /// A message written by hand: a string, a repeated string and a nested
/// /// message, each with its field number.
/// pub type Post = { title: String, labels: Array[String], tag: Tag }
///
/// impl protobuf.Message for Tag {
///     fn writeTo(self, out: protobuf.Writer) {
///         out.string(1, self.name)
///     }
///
///     fn readFrom(input: protobuf.Reader): Tag ! protobuf.ProtobufError {
///         var tag = Tag { name: "" }
///         for {
///             match input.next()? {
///                 0 => break
///                 1 => tag.name = input.string("name")?
///                 _ => input.skip()?
///             }
///         }
///         tag
///     }
///
///     fn protobufName(): String {
///         "blog.Tag"
///     }
/// }
///
/// impl protobuf.Message for Post {
///     fn writeTo(self, out: protobuf.Writer) {
///         out.string(1, self.title)
///         for label in self.labels {
///             out.string(2, label)
///         }
///         out.message(3, self.tag)
///     }
///
///     fn readFrom(input: protobuf.Reader): Post ! protobuf.ProtobufError {
///         var post = Post { title: "", labels: [], tag: Tag { name: "" } }
///         for {
///             match input.next()? {
///                 0 => break
///                 1 => post.title = input.string("title")?
///                 2 => post.labels.push(input.string("labels")?)
///                 3 => post.tag = input.message[Tag]("tag")?
///                 _ => input.skip()?
///             }
///         }
///         post
///     }
///
///     fn protobufName(): String {
///         "blog.Post"
///     }
/// }
///
/// let post = protobuf.decode[Post](protobuf.encode(Post { title: "Tea", labels: ["a", "b"], tag: Tag { name: "food" } }))?
/// console.println("{post.title} {post.labels} {post.tag.name}")
/// ```
pub type Writer = {
    priv native: pbNative.Native
}

/// Whether map entries go sorted by key.
pub fn Writer.deterministic(self): Bool {
    pbNative.deterministic(self.native)
}

/// An int32, as a varint; a negative one in ten bytes, as protobuf writes it.
pub fn Writer.int32(self, number: Int, value: Int32) {
    pbNative.writeVarint(self.native, number, Int(value))
}

/// An int64, as a varint.
pub fn Writer.int64(self, number: Int, value: Int) {
    pbNative.writeVarint(self.native, number, value)
}

/// A uint32, as a varint.
pub fn Writer.uint32(self, number: Int, value: UInt32) {
    pbNative.writeVarint(self.native, number, Int(value))
}

/// A uint64, as a varint.
pub fn Writer.uint64(self, number: Int, value: UInt) {
    pbNative.writeVarint(self.native, number, Int.wrapping(value))
}

/// A sint32, as a zigzag varint.
pub fn Writer.sint32(self, number: Int, value: Int32) {
    pbNative.writeZigzag(self.native, number, Int(value))
}

/// A sint64, as a zigzag varint.
pub fn Writer.sint64(self, number: Int, value: Int) {
    pbNative.writeZigzag(self.native, number, value)
}

/// A fixed32, in 4 bytes.
pub fn Writer.fixed32(self, number: Int, value: UInt32) {
    pbNative.writeFixed32(self.native, number, Int(value))
}

/// An sfixed32, in 4 bytes.
pub fn Writer.sfixed32(self, number: Int, value: Int32) {
    pbNative.writeFixed32(self.native, number, Int(value))
}

/// A fixed64, in 8 bytes.
pub fn Writer.fixed64(self, number: Int, value: UInt) {
    pbNative.writeFixed64(self.native, number, Int.wrapping(value))
}

/// An sfixed64, in 8 bytes.
pub fn Writer.sfixed64(self, number: Int, value: Int) {
    pbNative.writeFixed64(self.native, number, value)
}

/// A bool, as a varint.
pub fn Writer.bool(self, number: Int, value: Bool) {
    pbNative.writeVarint(self.native, number, if value { 1 } else { 0 })
}

/// A float, in 4 bytes.
pub fn Writer.float(self, number: Int, value: Float32) {
    pbNative.writeFixed32(self.native, number, Int(value.bits()))
}

/// A double, in 8 bytes.
pub fn Writer.double(self, number: Int, value: Float) {
    pbNative.writeFixed64(self.native, number, Int.wrapping(value.bits()))
}

/// A string, as its UTF-8 bytes after their length.
pub fn Writer.string(self, number: Int, value: String) {
    pbNative.writeText(self.native, number, value)
}

/// Bytes, after their length.
pub fn Writer.bytes(self, number: Int, value: Array[Byte]) {
    pbNative.writeBytes(self.native, number, value)
}

/// A nested message, after its length.
pub fn Writer.message[T: Message](self, number: Int, value: T) {
    pbNative.begin(self.native, number)
    value.writeTo(self)
    pbNative.end(self.native)
}

/// A message as a group of proto2.
pub fn Writer.group[T: Message](self, number: Int, value: T) {
    pbNative.writeGroup(self.native, number, true)
    value.writeTo(self)
    pbNative.writeGroup(self.native, number, false)
}

/// The number of a protobuf enum's variant, as a varint.
pub fn Writer.enumValue[T: Enum](self, number: Int, value: T) {
    pbNative.writeVarint(self.native, number, Int(value.number()))
}

/// Opens a nested value of field `number`: a map entry, a packed field or a
/// wrapper, which `end` closes.
pub fn Writer.begin(self, number: Int) {
    pbNative.begin(self.native, number)
}

/// Closes what `begin` opened, writing its length before it.
pub fn Writer.end(self) {
    pbNative.end(self.native)
}

/// A `google.protobuf.Timestamp`: seconds since 1970 and nanoseconds.
pub fn Writer.timestamp(self, number: Int, value: __time.DateTime) {
    // Seconds rounded down, so that the nanoseconds are never negative.
    let nanoseconds = value.sinceEpoch().nanoseconds()
    let truncated = nanoseconds / 1_000_000_000
    let seconds = if nanoseconds < 0 and nanoseconds % 1_000_000_000 != 0 {
        truncated - 1
    } else {
        truncated
    }
    let rest = nanoseconds - seconds * 1_000_000_000
    self.begin(number)
    if seconds != 0 {
        self.int64(1, seconds)
    }
    if rest != 0 {
        self.int32(2, Int32.wrapping(rest))
    }
    self.end()
}

/// A `google.protobuf.Duration`: seconds and nanoseconds of the same sign.
pub fn Writer.duration(self, number: Int, value: __time.Duration) {
    let nanoseconds = value.nanoseconds()
    let (seconds, rest) = (nanoseconds / 1_000_000_000, nanoseconds % 1_000_000_000)
    self.begin(number)
    if seconds != 0 {
        self.int64(1, seconds)
    }
    if rest != 0 {
        self.int32(2, Int32.wrapping(rest))
    }
    self.end()
}

/// A `google.protobuf.Value`.
pub fn Writer.jsonValue(self, number: Int, value: __json.Value) {
    self.begin(number)
    match value {
        __json.Value.Null => self.int32(1, 0)
        __json.Value.Number(digits) => self.double(2, digits.toFloat())
        __json.Value.Text(text) => self.string(3, text)
        __json.Value.Bool(flag) => self.bool(4, flag)
        __json.Value.Object(_) => self.jsonStruct(5, value)
        __json.Value.Array(_) => self.jsonList(6, value)
    }
    self.end()
}

/// A `google.protobuf.Struct`, from a JSON object; another value writes an
/// empty one.
pub fn Writer.jsonStruct(self, number: Int, value: __json.Value) {
    self.begin(number)
    for (key, member) in value.asObject().unwrapOr([:]) {
        self.begin(1)
        self.string(1, key)
        self.jsonValue(2, member)
        self.end()
    }
    self.end()
}

/// A `google.protobuf.ListValue`, from a JSON array.
pub fn Writer.jsonList(self, number: Int, value: __json.Value) {
    self.begin(number)
    for item in value.asArray().unwrapOr([]) {
        self.jsonValue(1, item)
    }
    self.end()
}

/// The fields a message kept without knowing them.
pub fn Writer.unknown(self, fields: UnknownFields) {
    pbNative.writeRaw(self.native, fields.bytes)
}

// ---------------------------------------------------------------------------
// Reading
// ---------------------------------------------------------------------------

/// Reads the fields of messages: `next` gives the number of each, and a
/// method of its type its value; `name` says the field in an error.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// /// Numbers that come packed, as proto3 writes repeated numbers, or one
/// /// field each, as proto2 did: a reader takes both.
/// pub type Samples = { values: Array[Int] }
///
/// impl protobuf.Message for Samples {
///     fn writeTo(self, out: protobuf.Writer) {
///         for value in self.values {
///             out.int64(1, value)
///         }
///     }
///
///     fn readFrom(input: protobuf.Reader): Samples ! protobuf.ProtobufError {
///         var values: Array[Int] = []
///         for {
///             match input.next()? {
///                 0 => break
///                 1 if input.isPacked() => {
///                     input.enterPacked("values")?
///                     for input.more() {
///                         values.push(input.int64("values")?)
///                     }
///                 }
///                 1 => values.push(input.int64("values")?)
///                 _ => input.skip()?
///             }
///         }
///         Samples { values }
///     }
///
///     fn protobufName(): String {
///         "stats.Samples"
///     }
/// }
///
/// console.println("{protobuf.decode[Samples](protobuf.encode(Samples { values: [3, 270] }))?.values}")
/// // The same numbers packed: field 1, length 3, then the varints.
/// console.println("{protobuf.decode[Samples]([0x0a, 0x03, 0x03, 0x8e, 0x02])?.values}")
/// ```
pub type Reader = {
    priv native: pbNative.Native
}

/// The number of the next field, or 0 at the end of the message.
pub fn Reader.next(self): Int ! ProtobufError {
    let number = pbNative.next(self.native)
    if number < 0 {
        fail self.error("")
    }
    number
}

fn Reader.varint(self, name: String): Int ! ProtobufError {
    let value = pbNative.readVarint(self.native)
    if pbNative.failed(self.native) {
        fail self.error(name)
    }
    value
}

/// The int32 of the field read.
pub fn Reader.int32(self, name: String): Int32 ! ProtobufError {
    Int32.wrapping(self.varint(name)?)
}

/// The int64 of the field read.
pub fn Reader.int64(self, name: String): Int ! ProtobufError {
    self.varint(name)?
}

/// The uint32 of the field read.
pub fn Reader.uint32(self, name: String): UInt32 ! ProtobufError {
    UInt32.wrapping(self.varint(name)?)
}

/// The uint64 of the field read.
pub fn Reader.uint64(self, name: String): UInt ! ProtobufError {
    UInt.wrapping(self.varint(name)?)
}

/// The sint32 of the field read.
pub fn Reader.sint32(self, name: String): Int32 ! ProtobufError {
    Int32.wrapping(self.zigzag(name)?)
}

/// The sint64 of the field read.
pub fn Reader.sint64(self, name: String): Int ! ProtobufError {
    self.zigzag(name)?
}

fn Reader.zigzag(self, name: String): Int ! ProtobufError {
    let value = pbNative.readZigzag(self.native)
    if pbNative.failed(self.native) {
        fail self.error(name)
    }
    value
}

fn Reader.bits32(self, name: String): Int ! ProtobufError {
    let value = pbNative.readFixed32(self.native)
    if pbNative.failed(self.native) {
        fail self.error(name)
    }
    value
}

fn Reader.bits64(self, name: String): Int ! ProtobufError {
    let value = pbNative.readFixed64(self.native)
    if pbNative.failed(self.native) {
        fail self.error(name)
    }
    value
}

/// The fixed32 of the field read.
pub fn Reader.fixed32(self, name: String): UInt32 ! ProtobufError {
    UInt32.wrapping(self.bits32(name)?)
}

/// The sfixed32 of the field read.
pub fn Reader.sfixed32(self, name: String): Int32 ! ProtobufError {
    Int32.wrapping(self.bits32(name)?)
}

/// The fixed64 of the field read.
pub fn Reader.fixed64(self, name: String): UInt ! ProtobufError {
    UInt.wrapping(self.bits64(name)?)
}

/// The sfixed64 of the field read.
pub fn Reader.sfixed64(self, name: String): Int ! ProtobufError {
    self.bits64(name)?
}

/// The bool of the field read.
pub fn Reader.bool(self, name: String): Bool ! ProtobufError {
    self.varint(name)? != 0
}

/// The float of the field read.
pub fn Reader.float(self, name: String): Float32 ! ProtobufError {
    Float32.fromBits(UInt32.wrapping(self.bits32(name)?))
}

/// The double of the field read.
pub fn Reader.double(self, name: String): Float ! ProtobufError {
    Float.fromBits(UInt.wrapping(self.bits64(name)?))
}

/// The string of the field read, which must be UTF-8.
pub fn Reader.string(self, name: String): String ! ProtobufError {
    let value = pbNative.readText(self.native)
    if pbNative.failed(self.native) {
        fail self.error(name)
    }
    value
}

/// The bytes of the field read.
pub fn Reader.bytes(self, name: String): Array[Byte] ! ProtobufError {
    let value = pbNative.readBytes(self.native)
    if pbNative.failed(self.native) {
        fail self.error(name)
    }
    value
}

/// The nested message of the field read.
pub fn Reader.message[T: Message](self, name: String): T ! ProtobufError {
    self.enter(name)?
    match Message.readFrom[T](self) {
        ok(value) => value
        err(error) => fail within(error, name)
    }
}

/// A message written as a group of proto2.
pub fn Reader.group[T: Message](self, name: String): T ! ProtobufError {
    self.message[T](name)?
}

/// The variant of an enum, or `none` for a number a closed enum does not
/// have, which a message keeps among its unknown fields.
pub fn Reader.enumValue[T: Enum](self, name: String): T? ! ProtobufError {
    Enum.fromNumber[T](Int32.wrapping(self.varint(name)?))
}

/// Enters the field read: a nested message, a map entry or a wrapper,
/// whose fields `next` reads until it gives 0.
pub fn Reader.enter(self, name: String): !ProtobufError {
    pbNative.enter(self.native, false)
    if pbNative.failed(self.native) {
        fail self.error(name)
    }
}

/// Whether the field read is packed: then `enterPacked` and `more` read its
/// elements; otherwise it holds one.
pub fn Reader.isPacked(self): Bool {
    pbNative.isPacked(self.native)
}

/// Enters a packed field, whose elements `more` and the readers of its type read.
pub fn Reader.enterPacked(self, name: String): !ProtobufError {
    pbNative.enter(self.native, true)
    if pbNative.failed(self.native) {
        fail self.error(name)
    }
}

/// Whether a packed field has more elements.
pub fn Reader.more(self): Bool {
    pbNative.more(self.native)
}

/// Skips the value of the field read.
pub fn Reader.skip(self): !ProtobufError {
    pbNative.skip(self.native)
    if pbNative.failed(self.native) {
        fail self.error("")
    }
}

/// Keeps the field read, which the message does not know, among `fields`.
pub fn Reader.keep(self, fields: UnknownFields): UnknownFields ! ProtobufError {
    let raw = pbNative.raw(self.native)
    if pbNative.failed(self.native) {
        fail self.error("")
    }
    UnknownFields { bytes: fields.bytes.concat(raw) }
}

/// A missing field that the message requires.
pub fn Reader.missing(self, name: String): ProtobufError {
    serialization.Error {
        kind: serialization.ErrorKind.Missing
        message: "the required field `{name}` is missing"
        path: if name.isEmpty() { "$" } else { "$.{name}" }
        line: 0
        column: 0
        violations: []
    }
}

/// The `google.protobuf.Timestamp` of the field read.
pub fn Reader.timestamp(self, name: String): __time.DateTime ! ProtobufError {
    let (seconds, nanoseconds) = self.secondsAndNanos(name)?
    __time.utc(__time.nanoseconds(seconds * 1_000_000_000 + nanoseconds))
}

/// The `google.protobuf.Duration` of the field read.
pub fn Reader.duration(self, name: String): __time.Duration ! ProtobufError {
    let (seconds, nanoseconds) = self.secondsAndNanos(name)?
    __time.nanoseconds(seconds * 1_000_000_000 + nanoseconds)
}

fn Reader.secondsAndNanos(self, name: String): (Int, Int) ! ProtobufError {
    self.enter(name)?
    var (seconds, nanoseconds) = (0, 0)
    for {
        match self.next()? {
            0 => break
            1 => seconds = self.int64(name)?
            2 => nanoseconds = Int(self.int32(name)?)
            _ => self.skip()?
        }
    }
    (seconds, nanoseconds)
}

/// The `google.protobuf.Value` of the field read.
pub fn Reader.jsonValue(self, name: String): __json.Value ! ProtobufError {
    self.enter(name)?
    var value = __json.Value.Null
    for {
        match self.next()? {
            0 => break
            1 => {
                self.skip()?
                value = __json.Value.Null
            }
            2 => value = __json.toValue(self.double(name)?)
            3 => value = __json.Value.Text(self.string(name)?)
            4 => value = __json.Value.Bool(self.bool(name)?)
            5 => value = self.jsonStruct(name)?
            6 => value = self.jsonList(name)?
            _ => self.skip()?
        }
    }
    value
}

/// The `google.protobuf.Struct` of the field read, as a JSON object.
pub fn Reader.jsonStruct(self, name: String): __json.Value ! ProtobufError {
    self.enter(name)?
    var members: Map[String, __json.Value] = [:]
    for {
        match self.next()? {
            0 => break
            1 => {
                self.enter(name)?
                var (key, member) = ("", __json.Value.Null)
                for {
                    match self.next()? {
                        0 => break
                        1 => key = self.string(name)?
                        2 => member = self.jsonValue(name)?
                        _ => self.skip()?
                    }
                }
                members[key] = member
            }
            _ => self.skip()?
        }
    }
    __json.Value.Object(members)
}

/// The `google.protobuf.ListValue` of the field read, as a JSON array.
pub fn Reader.jsonList(self, name: String): __json.Value ! ProtobufError {
    self.enter(name)?
    var items: Array[__json.Value] = []
    for {
        match self.next()? {
            0 => break
            1 => items.push(self.jsonValue(name)?)
            _ => self.skip()?
        }
    }
    __json.Value.Array(items)
}

fn Reader.error(self, name: String): ProtobufError {
    serialization.Error {
        kind: serialization.ErrorKind.Syntax
        message: pbNative.error(self.native)
        path: if name.isEmpty() { "$" } else { "$.{name}" }
        line: 0
        column: pbNative.offset(self.native)
        violations: []
    }
}

/// An error of a nested message, at the path of its field.
fn within(error: ProtobufError, name: String): ProtobufError {
    serialization.Error {
        kind: error.kind
        message: error.message
        path: "$.{name}{error.path.removePrefix("$")}"
        line: error.line
        column: error.column
        violations: error.violations
    }
}

// ---------------------------------------------------------------------------
// What the code the compiler writes calls
// ---------------------------------------------------------------------------

/// The entries of a map field, sorted by key when the writer is
/// deterministic.
pub fn entries[K: Key + Ordered, V](map: Map[K, V], sorted: Bool): Array[(K, V)] {
    var pairs: Array[(K, V)] = []
    for (key, value) in map {
        pairs.push((key, value))
    }
    if sorted { pairs.sortedBy((pair) { pair.0 }) } else { pairs }
}

/// A reader of no fields, for a message every field of which has its zero.
pub fn emptyReader(): Reader {
    Reader { native: pbNative.reader([]) }
}

/// The zero of a `Timestamp`, for a map entry without its value.
pub fn epoch(): __time.DateTime {
    __time.utc(__time.nanoseconds(0))
}

/// The zero of a `Duration`, for a map entry without its value.
pub fn zeroDuration(): __time.Duration {
    __time.nanoseconds(0)
}

/// The zero of a `Value`, for a map entry without its value.
pub fn nullValue(): __json.Value {
    __json.Value.Null
}

// ---------------------------------------------------------------------------
// Messages of google.protobuf
// ---------------------------------------------------------------------------

/// `google.protobuf.Empty`, the message with no fields.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// // The message of a call that takes or gives nothing.
/// let bytes = protobuf.encode(protobuf.Empty {})
/// console.println("{bytes.length()} bytes, JSON {protobuf.toJson(protobuf.Empty {})?}")
/// ```
pub type Empty = {}

impl Message for Empty {
    fn writeTo(self, _out: Writer) {}

    fn readFrom(input: Reader): Empty ! ProtobufError {
        for input.next()? != 0 {
            input.skip()?
        }
        Empty {}
    }

    fn protobufName(): String {
        "google.protobuf.Empty"
    }

    fn writeJson(self, out: JsonWriter): !ProtobufError {
        out.begin()
        out.end()
    }

    fn readJson(input: JsonReader, value: __json.Value): Empty ! ProtobufError {
        for (key, _) in input.fields(value, "$")? {
            input.unknown(key, "$")?
        }
        Empty {}
    }
}

/// `google.protobuf.Any`: a message of any type, as its bytes and the URL
/// of its type's name.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// @protobuf.Name("errors.v1.RetryInfo")
/// pub type RetryInfo = {
///     @protobuf.Field(1)
///     seconds: Int = 0
/// }
///
/// // A message of any type, with the name that says which.
/// let detail = protobuf.pack(RetryInfo { seconds: 30 })
/// console.println(detail.typeUrl)
/// let retry = detail.unpack[RetryInfo]()?
/// console.println("retry in {retry.seconds}s")
/// ```
pub type Any = {
    typeUrl: String = ""
    value: Array[Byte] = []
}

impl Message for Any {
    fn writeTo(self, out: Writer) {
        if not self.typeUrl.isEmpty() {
            out.string(1, self.typeUrl)
        }
        if not self.value.isEmpty() {
            out.bytes(2, self.value)
        }
    }

    fn readFrom(input: Reader): Any ! ProtobufError {
        var typeUrl = ""
        var value: Array[Byte] = []
        for {
            match input.next()? {
                0 => break
                1 => typeUrl = input.string("typeUrl")?
                2 => value = input.bytes("value")?
                _ => input.skip()?
            }
        }
        Any { typeUrl, value }
    }

    fn protobufName(): String {
        "google.protobuf.Any"
    }

    /// `{"@type": url, ...}` with the fields of the message it holds, or its
    /// form under `value` for a type of `google.protobuf` that has one.
    fn writeJson(self, out: JsonWriter): !ProtobufError {
        if self.typeUrl.isEmpty() {
            out.begin()
            out.end()
            return
        }
        let name = self.typeUrl.split("/").last().unwrapOr(self.typeUrl)
        let inner = JsonWriter { json: __json.writer(), protoNames: out.protoNames }
        if not wellKnownToJson(name, self.value, inner)? {
            let known = match knownMessage(name) {
                some(known) => known
                none => fail jsonError(
                    serialization.ErrorKind.Unsupported,
                    "$",
                    "the `Any` holds `{name}`, which is no message of this program",
                )
            }
            let write = known.toJson
            write(self.value, inner)?
        }
        let held = match __json.parse(inner.json.finish()) {
            ok(held) => held
            err(error) => fail jsonError(serialization.ErrorKind.Syntax, "$", "{error}")
        }
        out.begin()
        out.key("@type")
        out.string(self.typeUrl)
        match (held, specialJson(name)) {
            (__json.Value.Object(fields), false) => {
                for (key, field) in fields {
                    out.key(key)
                    out.jsonValue(field)
                }
            }
            (other, _) => {
                out.key("value")
                out.jsonValue(other)
            }
        }
        out.end()
    }

    fn readJson(input: JsonReader, value: __json.Value): Any ! ProtobufError {
        let fields = input.fields(value, "$")?
        let typeUrl = match fields.find((field) { field.0 == "@type" }) {
            some((_, __json.Value.Text(url))) => url
            _ => fail jsonError(
                serialization.ErrorKind.Missing,
                "$.@type",
                "an `Any` in JSON says its type in `@type`",
            )
        }
        let name = typeUrl.split("/").last().unwrapOr(typeUrl)
        let held = if specialJson(name) {
            match fields.find((field) { field.0 == "value" }) {
                some((_, inner)) => inner
                none => __json.Value.Null
            }
        } else {
            var rest: Map[String, __json.Value] = [:]
            for (key, field) in fields {
                if key != "@type" {
                    rest[key] = field
                }
            }
            __json.Value.Object(rest)
        }
        match wellKnownFromJson(name, held, input)? {
            some(bytes) => return Any { typeUrl, value: bytes }
            none => {}
        }
        let known = match knownMessage(name) {
            some(known) => known
            none => fail jsonError(
                serialization.ErrorKind.Unsupported,
                "$.@type",
                "`{name}` is no message of this program",
            )
        }
        let read = known.fromJson
        Any { typeUrl, value: read(held, input)? }
    }
}

/// `google.protobuf.FieldMask`: the paths of the fields an update sets,
/// as `user.display_name`.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// /// An update that says which fields it changes, as APIs of Google do.
/// pub type UpdateUser = {
///     @protobuf.Field(1)
///     name: String = ""
///     @protobuf.Field(2)
///     email: String = ""
///     @protobuf.Field(3)
///     mask: protobuf.FieldMask = protobuf.FieldMask {}
/// }
///
/// let update = UpdateUser { email: "ada@example.com", mask: protobuf.FieldMask { paths: ["email"] } }
/// console.println(protobuf.toJson(update)?)
/// let read = protobuf.fromJson[UpdateUser](r"""{"email": "x@example.com", "mask": "email,name"}""")?
/// console.println("{read.mask.paths}")
/// ```
pub type FieldMask = {
    paths: Array[String] = []
}

impl Message for FieldMask {
    fn writeTo(self, out: Writer) {
        for path in self.paths {
            out.string(1, path)
        }
    }

    fn readFrom(input: Reader): FieldMask ! ProtobufError {
        var paths: Array[String] = []
        for {
            match input.next()? {
                0 => break
                1 => paths.push(input.string("paths")?)
                _ => input.skip()?
            }
        }
        FieldMask { paths }
    }

    fn protobufName(): String {
        "google.protobuf.FieldMask"
    }

    /// Its paths joined by `,`, each in lowerCamel: `user.displayName`.
    fn writeJson(self, out: JsonWriter): !ProtobufError {
        out.string(
            self.paths
                .map((path) { path.split(".").map((part) { lowerCamel(part) }).join(".") })
                .join(","),
        )
    }

    fn readJson(input: JsonReader, value: __json.Value): FieldMask ! ProtobufError {
        let text = input.string(value, "$")?
        if text.isEmpty() {
            return FieldMask {}
        }
        FieldMask {
            paths: text
                .split(",")
                .map((path) { path.split(".").map((part) { snakeCase(part) }).join(".") })
        }
    }
}

/// A message in an `Any`, named `type.googleapis.com/` and its full name.
pub fn pack[T: Message](message: T): Any {
    Any { typeUrl: "type.googleapis.com/{Message.protobufName[T]()}", value: encode(message) }
}

/// The message an `Any` holds, which must be a `T`.
pub fn Any.unpack[T: Message](self): T ! ProtobufError {
    let name = Message.protobufName[T]()
    if not self.typeUrl.endsWith("/{name}") and self.typeUrl != name {
        fail serialization.Error {
            kind: serialization.ErrorKind.Type
            message: "the `Any` holds `{self.typeUrl}`, not `{name}`"
            path: "$"
            line: 0
            column: 0
            violations: []
        }
    }
    decode[T](self.value)?
}

// ---------------------------------------------------------------------------
// Other formats
// ---------------------------------------------------------------------------

/// In other formats, the message's fields: none.
impl serialization.Encode for Empty {
    fn encode[S: serialization.Sink](self, out: S) {
        out.beginMap(0)
        out.endMap()
    }
}

impl serialization.Decode for Empty {
    fn decode[S: serialization.Source](
        input: S,
        first: serialization.Event,
    ): Empty ! serialization.Error {
        input.beginMap(first, "Empty")?
        for {
            match input.nextKey()? {
                some(_) => input.skip(input.value()?)?
                none => break
            }
        }
        Empty {}
    }
}

/// In other formats, its `typeUrl` and its `value` as bytes.
impl serialization.Encode for Any {
    fn encode[S: serialization.Sink](self, out: S) {
        out.beginMap(2)
        out.key("typeUrl")
        out.text(self.typeUrl)
        out.key("value")
        serialization.Bytes(self.value).encode(out)
        out.endMap()
    }
}

impl serialization.Decode for Any {
    fn decode[S: serialization.Source](
        input: S,
        first: serialization.Event,
    ): Any ! serialization.Error {
        input.beginMap(first, "Any")?
        var any = Any {}
        for {
            match input.nextKey()? {
                some("typeUrl") => any.typeUrl =
                    serialization.Decode.decode[String](input, input.value()?)?
                some("value") => {
                    any.value =
                        serialization.Decode.decode[serialization.Bytes](input, input.value()?)?.value
                }
                some(_) => input.skip(input.value()?)?
                none => break
            }
        }
        any
    }
}

/// In other formats, its paths.
impl serialization.Encode for FieldMask {
    fn encode[S: serialization.Sink](self, out: S) {
        out.beginMap(1)
        out.key("paths")
        self.paths.encode(out)
        out.endMap()
    }
}

impl serialization.Decode for FieldMask {
    fn decode[S: serialization.Source](
        input: S,
        first: serialization.Event,
    ): FieldMask ! serialization.Error {
        input.beginMap(first, "FieldMask")?
        var mask = FieldMask {}
        for {
            match input.nextKey()? {
                some("paths") => mask.paths =
                    serialization.Decode.decode[Array[String]](input, input.value()?)?
                some(_) => input.skip(input.value()?)?
                none => break
            }
        }
        mask
    }
}

/// In other formats, the bytes of the fields, which `@ignore` usually
/// leaves out.
impl serialization.Encode for UnknownFields {
    fn encode[S: serialization.Sink](self, out: S) {
        serialization.Bytes(self.bytes).encode(out)
    }
}

impl serialization.Decode for UnknownFields {
    fn decode[S: serialization.Source](
        input: S,
        first: serialization.Event,
    ): UnknownFields ! serialization.Error {
        UnknownFields {
            bytes: serialization.Decode.decode[serialization.Bytes](input, first)?.value
        }
    }
}

// ---------------------------------------------------------------------------
// Reflection, which shows messages to the interceptors of std.grpc
// ---------------------------------------------------------------------------

impl __reflect.Reflect for Field {
    fn reflectShow(self, _nested: Bool): String {
        "protobuf.Field"
    }
}

impl __reflect.Reflect for Value {
    fn reflectShow(self, _nested: Bool): String {
        "protobuf.Value"
    }
}

impl __reflect.Reflect for Name {
    fn reflectShow(self, _nested: Bool): String {
        "protobuf.Name"
    }
}

impl __reflect.Reflect for Unknown {
    fn reflectShow(self, _nested: Bool): String {
        "protobuf.Unknown"
    }
}

/// Unknown fields show their size and travel as they are.
impl __reflect.Reflect for UnknownFields {
    fn reflectShow(self, _nested: Bool): String {
        "protobuf.UnknownFields({self.bytes.length()} bytes)"
    }
}

impl __reflect.Reflect for Empty {
    fn reflectShow(self, _nested: Bool): String {
        "protobuf.Empty {{}}"
    }

    fn reflectFields(self): Array[__reflect.Field]? {
        some([])
    }
}

impl __reflect.Reflect for Any {
    fn reflectShow(self, _nested: Bool): String {
        "protobuf.Any {{ typeUrl: \"{self.typeUrl}\", value: {self.value.length()} bytes }}"
    }

    fn reflectGet(self, name: String): __reflect.Value ! __reflect.ReflectError {
        match name {
            "typeUrl" => __reflect.valueOf(self.typeUrl)
            "value" => __reflect.valueOf(self.value)
            _ => fail __reflect.ReflectError.noField("protobuf.Any", name, ["typeUrl", "value"])
        }
    }

    fn reflectFields(self): Array[__reflect.Field]? {
        some([
            __reflect.Field { name: "typeUrl", value: __reflect.valueOf(self.typeUrl) },
            __reflect.Field { name: "value", value: __reflect.valueOf(self.value) },
        ])
    }
}

impl __reflect.Reflect for FieldMask {
    fn reflectShow(self, _nested: Bool): String {
        "protobuf.FieldMask {{ paths: {__reflect.valueOf(self.paths)} }}"
    }

    fn reflectGet(self, name: String): __reflect.Value ! __reflect.ReflectError {
        match name {
            "paths" => __reflect.valueOf(self.paths)
            _ => fail __reflect.ReflectError.noField("protobuf.FieldMask", name, ["paths"])
        }
    }

    fn reflectFields(self): Array[__reflect.Field]? {
        some([__reflect.Field { name: "paths", value: __reflect.valueOf(self.paths) }])
    }
}

// ---------------------------------------------------------------------------
// JSON, as proto3 maps messages to it
// ---------------------------------------------------------------------------

/// The message as proto3's mapping to JSON writes it: fields by their
/// names in lowerCamel, or with `protoNames` as the `.proto` writes them;
/// fields with their default values left out; 64-bit integers as text,
/// bytes in Base64 and enum values by name.
pub fn toJson[T: Message](message: T, protoNames: Bool = false): String ! ProtobufError {
    let out = JsonWriter { json: __json.writer(), protoNames }
    message.writeJson(out)?
    out.json.finish()
}

/// The message a JSON text gives, as proto3's mapping reads it: fields by
/// either name, numbers as numbers or as text, enum values by name or by
/// number. A field the message does not have fails, unless
/// `ignoreUnknown`.
pub fn fromJson[T: Message](text: String, ignoreUnknown: Bool = false): T ! ProtobufError {
    let value = match __json.parse(text) {
        ok(value) => value
        err(error) => fail jsonError(serialization.ErrorKind.Syntax, "$", "{error}")
    }
    Message.readJson[T](JsonReader { ignoreUnknown }, value)?
}

fn jsonError(kind: serialization.ErrorKind, path: String, message: String): ProtobufError {
    serialization.Error { kind, message, path, line: 0, column: 0, violations: [] }
}

/// Where a message writes itself as JSON.
///
/// ```tondo
/// import std.console
/// import std.protobuf
///
/// /// A message written by hand, whose JSON is a `"x,y"` text rather than an
/// /// object.
/// pub type Point = { x: Int, y: Int }
///
/// impl protobuf.Message for Point {
///     fn writeTo(self, out: protobuf.Writer) {
///         out.sint64(1, self.x)
///         out.sint64(2, self.y)
///     }
///
///     fn readFrom(input: protobuf.Reader): Point ! protobuf.ProtobufError {
///         var point = Point { x: 0, y: 0 }
///         for {
///             match input.next()? {
///                 0 => break
///                 1 => point.x = input.sint64("x")?
///                 2 => point.y = input.sint64("y")?
///                 _ => input.skip()?
///             }
///         }
///         point
///     }
///
///     fn protobufName(): String {
///         "geo.Point"
///     }
///
///     fn writeJson(self, out: protobuf.JsonWriter): !protobuf.ProtobufError {
///         out.string("{self.x},{self.y}")
///     }
/// }
///
/// console.println(protobuf.toJson(Point { x: 3, y: -4 })?)
/// ```
pub type JsonWriter = {
    priv json: __json.Writer
    priv protoNames: Bool
}

/// Starts an object, a message's or a map's.
pub fn JsonWriter.begin(self) {
    self.json.beginObject()
}

/// Ends the object.
pub fn JsonWriter.end(self) {
    self.json.endObject()
}

/// A field's name: its name in JSON, or its name in the `.proto` when the
/// writer keeps those.
pub fn JsonWriter.field(self, jsonName: String, protoName: String) {
    self.json.key(if self.protoNames { protoName } else { jsonName })
}

/// A key of a map, or of an object as it is.
pub fn JsonWriter.key(self, key: String) {
    self.json.key(key)
}

/// Starts an array, a repeated field's.
pub fn JsonWriter.beginArray(self) {
    self.json.beginArray()
}

/// Ends the array.
pub fn JsonWriter.endArray(self) {
    self.json.endArray()
}

/// An `int32`, `sint32` or `sfixed32`, as a number.
pub fn JsonWriter.int32(self, value: Int32) {
    self.json.int(Int(value))
}

/// A `uint32` or `fixed32`, as a number.
pub fn JsonWriter.uint32(self, value: UInt32) {
    self.json.int(Int(value))
}

/// An `int64`, `sint64` or `sfixed64`, as text, which JavaScript reads
/// without losing digits.
pub fn JsonWriter.int64(self, value: Int) {
    self.json.string("{value}")
}

/// A `uint64` or `fixed64`, as text.
pub fn JsonWriter.uint64(self, value: UInt) {
    self.json.string("{value}")
}

/// A `float`: a number, or `"NaN"`, `"Infinity"` or `"-Infinity"`.
pub fn JsonWriter.float(self, value: Float32) {
    if value.isNaN() or value.isInfinite() {
        self.double(Float(value))
        return
    }
    match __json.number("{value}") {
        ok(number) => self.json.number(number)
        err(_) => self.double(Float(value))
    }
}

/// A `double`: a number, or `"NaN"`, `"Infinity"` or `"-Infinity"`.
pub fn JsonWriter.double(self, value: Float) {
    if value.isNaN() {
        self.json.string("NaN")
    } else if value.isInfinite() {
        self.json.string(if value > 0.0 { "Infinity" } else { "-Infinity" })
    } else {
        self.json.float(value)
    }
}

/// A `bool`.
pub fn JsonWriter.bool(self, value: Bool) {
    self.json.bool(value)
}

/// A `string`.
pub fn JsonWriter.string(self, value: String) {
    self.json.string(value)
}

/// `bytes`, in Base64 with its padding.
pub fn JsonWriter.bytes(self, value: Array[Byte]) {
    self.json.string(__encoding.base64Encode(value))
}

/// An enum's value, by its name in the `.proto`.
pub fn JsonWriter.enumValue[T: Enum](self, value: T) {
    let name = value.protobufValueName()
    match Int.parse(name) {
        ok(number) => self.json.int(number)
        err(_) => self.json.string(name)
    }
}

/// A message, as its own `writeJson` writes it.
pub fn JsonWriter.message[T: Message](self, value: T): !ProtobufError {
    value.writeJson(self)?
}

/// A `google.protobuf.Timestamp`, in RFC 3339 in UTC, with 0, 3, 6 or 9
/// digits of a second: `2026-11-01T10:30:00.500Z`.
pub fn JsonWriter.timestamp(self, value: __time.DateTime) {
    let nanoseconds = value.sinceEpoch().nanoseconds()
    let fraction = ((nanoseconds % 1_000_000_000) + 1_000_000_000) % 1_000_000_000
    self.json.string("{value.format("%Y-%m-%dT%H:%M:%S")}{fractionText(fraction)}Z")
}

/// A `google.protobuf.Duration`, in seconds with 0, 3, 6 or 9 digits:
/// `1.500s`, `-3s`.
pub fn JsonWriter.duration(self, value: __time.Duration) {
    let nanoseconds = value.nanoseconds()
    let sign = if nanoseconds < 0 { "-" } else { "" }
    let magnitude = nanoseconds.abs()
    self.json.string("{sign}{magnitude / 1_000_000_000}{fractionText(magnitude % 1_000_000_000)}s")
}

/// A `google.protobuf.Value`, `Struct` or `ListValue`: the JSON it holds.
pub fn JsonWriter.jsonValue(self, value: __json.Value) {
    match value {
        __json.Value.Null => self.json.null()
        __json.Value.Bool(flag) => self.json.bool(flag)
        __json.Value.Number(number) => self.json.number(number)
        __json.Value.Text(text) => self.json.string(text)
        __json.Value.Array(items) => {
            self.json.beginArray()
            for item in items {
                self.jsonValue(item)
            }
            self.json.endArray()
        }
        __json.Value.Object(fields) => {
            self.json.beginObject()
            for (key, field) in fields {
                self.json.key(key)
                self.jsonValue(field)
            }
            self.json.endObject()
        }
    }
}

/// `.5`, `.500`, `.500001` or `.500000001`: the fewest groups of three
/// digits that hold the nanoseconds; nothing for none.
fn fractionText(nanoseconds: Int): String {
    if nanoseconds == 0 {
        return ""
    }
    let digits = "{nanoseconds}".padStart(9, "0")
    if nanoseconds % 1_000_000 == 0 {
        ".{digits.slice(0, 3).unwrapOr(digits)}"
    } else if nanoseconds % 1_000 == 0 {
        ".{digits.slice(0, 6).unwrapOr(digits)}"
    } else {
        ".{digits}"
    }
}

/// A field's name in JSON, as protoc gives it: `user_id` is `userId`.
fn lowerCamel(name: String): String {
    var out = ""
    var upper = false
    for c in name.chars() {
        if c == '_' {
            upper = true
        } else if upper {
            out = "{out}{c.toUpper()}"
            upper = false
        } else {
            out = "{out}{c}"
        }
    }
    out
}

/// The `.proto` name of a field's name in JSON: `userId` is `user_id`.
fn snakeCase(name: String): String {
    var out = ""
    for c in name.chars() {
        out = if c.isUpper() { "{out}_{c.toLower()}" } else { "{out}{c}" }
    }
    out
}

/// Whether a type of `google.protobuf` has its own form in JSON, which an
/// `Any` holds under `value`.
fn specialJson(name: String): Bool {
    name in
        [
            "google.protobuf.Timestamp",
            "google.protobuf.Duration",
            "google.protobuf.FieldMask",
            "google.protobuf.Struct",
            "google.protobuf.Value",
            "google.protobuf.ListValue",
            "google.protobuf.DoubleValue",
            "google.protobuf.FloatValue",
            "google.protobuf.Int64Value",
            "google.protobuf.UInt64Value",
            "google.protobuf.Int32Value",
            "google.protobuf.UInt32Value",
            "google.protobuf.BoolValue",
            "google.protobuf.StringValue",
            "google.protobuf.BytesValue",
        ]
}

/// The bytes of a message as field 1 of another, which the readers of
/// `Reader` for the types of `google.protobuf` read.
fn asField(bytes: Array[Byte]): Reader {
    let out = Writer { native: pbNative.writer(false) }
    out.bytes(1, bytes)
    let reader = Reader { native: pbNative.reader(pbNative.finish(out.native)) }
    _ = reader.next()
    reader
}

/// The bytes of field 1 of a message, which `Writer` wrote.
fn fieldBytes(out: Writer): Array[Byte] ! ProtobufError {
    let reader = Reader { native: pbNative.reader(pbNative.finish(out.native)) }
    match reader.next()? {
        1 => reader.bytes("value")?
        _ => []
    }
}

/// Writes the JSON of a type of `google.protobuf` from its bytes, as an
/// `Any` holds it, when it is one that Tondo holds as a type of its own: a
/// time, a duration, a JSON value or a wrapper. Whether it was.
fn wellKnownToJson(name: String, bytes: Array[Byte], out: JsonWriter): Bool ! ProtobufError {
    match name {
        "google.protobuf.Timestamp" => out.timestamp(asField(bytes).timestamp("value")?)
        "google.protobuf.Duration" => out.duration(asField(bytes).duration("value")?)
        "google.protobuf.Value" => out.jsonValue(asField(bytes).jsonValue("value")?)
        "google.protobuf.Struct" => out.jsonValue(asField(bytes).jsonStruct("value")?)
        "google.protobuf.ListValue" => out.jsonValue(asField(bytes).jsonList("value")?)
        _ => return wrappedToJson(name, bytes, out)?
    }
    true
}

/// Writes the JSON of a wrapper of `google.protobuf` from its bytes: the
/// value it holds. Whether it was one.
fn wrappedToJson(name: String, bytes: Array[Byte], out: JsonWriter): Bool ! ProtobufError {
    let input = Reader { native: pbNative.reader(bytes) }
    // The value's field, absent when it is its zero.
    let present = input.next()? == 1
    match name {
        "google.protobuf.DoubleValue" => out.double(
            if present { input.double("value")? } else { 0.0 },
        )
        "google.protobuf.FloatValue" => out.float(if present { input.float("value")? } else { 0.0 })
        "google.protobuf.Int64Value" => out.int64(if present { input.int64("value")? } else { 0 })
        "google.protobuf.UInt64Value" => out.uint64(
            if present { input.uint64("value")? } else { 0 },
        )
        "google.protobuf.Int32Value" => out.int32(if present { input.int32("value")? } else { 0 })
        "google.protobuf.UInt32Value" => out.uint32(
            if present { input.uint32("value")? } else { 0 },
        )
        "google.protobuf.BoolValue" => out.bool(present and input.bool("value")?)
        "google.protobuf.StringValue" => out.string(
            if present { input.string("value")? } else { "" },
        )
        "google.protobuf.BytesValue" => out.bytes(if present { input.bytes("value")? } else { [] })
        _ => return false
    }
    true
}

/// The bytes of a type of `google.protobuf` that Tondo holds as a type of
/// its own, from its JSON, as an `Any` holds it; `none` for another type.
fn wellKnownFromJson(
    name: String,
    value: __json.Value,
    input: JsonReader,
): Array[Byte]? ! ProtobufError {
    let out = Writer { native: pbNative.writer(false) }
    match name {
        "google.protobuf.Timestamp" => out.timestamp(1, input.timestamp(value, "$.value")?)
        "google.protobuf.Duration" => out.duration(1, input.duration(value, "$.value")?)
        "google.protobuf.Value" => out.jsonValue(1, value)
        "google.protobuf.Struct" => out.jsonStruct(1, value)
        "google.protobuf.ListValue" => out.jsonList(1, value)
        "google.protobuf.DoubleValue" => out.double(1, input.double(value, "$.value")?)
        "google.protobuf.FloatValue" => out.float(1, input.float(value, "$.value")?)
        "google.protobuf.Int64Value" => out.int64(1, input.int64(value, "$.value")?)
        "google.protobuf.UInt64Value" => out.uint64(1, input.uint64(value, "$.value")?)
        "google.protobuf.Int32Value" => out.int32(1, input.int32(value, "$.value")?)
        "google.protobuf.UInt32Value" => out.uint32(1, input.uint32(value, "$.value")?)
        "google.protobuf.BoolValue" => out.bool(1, input.bool(value, "$.value")?)
        "google.protobuf.StringValue" => out.string(1, input.string(value, "$.value")?)
        "google.protobuf.BytesValue" => out.bytes(1, input.bytes(value, "$.value")?)
        _ => return none
    }
    // A time, a duration or a JSON value is a message of field 1; a
    // wrapper's field 1 is its value.
    if name.endsWith("Value") and
        name != "google.protobuf.Value" and
        name != "google.protobuf.ListValue" {
        return some(pbNative.finish(out.native))
    }
    some(fieldBytes(out)?)
}

/// What reads a message's JSON.
///
/// ```tondo
/// import std.console
/// import std.json
/// import std.protobuf
///
/// /// A message written by hand that reads its JSON with either name of a
/// /// field, as proto3's mapping does.
/// pub type Point = { x: Int, y: Int }
///
/// impl protobuf.Message for Point {
///     fn writeTo(self, out: protobuf.Writer) {
///         out.sint64(1, self.x)
///         out.sint64(2, self.y)
///     }
///
///     fn readFrom(input: protobuf.Reader): Point ! protobuf.ProtobufError {
///         var point = Point { x: 0, y: 0 }
///         for {
///             match input.next()? {
///                 0 => break
///                 1 => point.x = input.sint64("x")?
///                 2 => point.y = input.sint64("y")?
///                 _ => input.skip()?
///             }
///         }
///         point
///     }
///
///     fn protobufName(): String {
///         "geo.Point"
///     }
///
///     fn readJson(input: protobuf.JsonReader, value: json.Value): Point ! protobuf.ProtobufError {
///         var point = Point { x: 0, y: 0 }
///         for (key, field) in input.fields(value, "$")? {
///             match key {
///                 "x" => point.x = input.int64(field, "$.x")?
///                 "y" => point.y = input.int64(field, "$.y")?
///                 _ => input.unknown(key, "$")?
///             }
///         }
///         point
///     }
/// }
///
/// let point = protobuf.fromJson[Point](r"""{"x": "12", "y": -5}""")?
/// console.println("{point.x},{point.y}")
/// ```
pub type JsonReader = {
    priv ignoreUnknown: Bool
}

/// A JSON value, which a message's `readJson` reads.
///
/// ```tondo
/// import std.console
/// import std.json
/// import std.protobuf
///
/// /// A field of any JSON, `google.protobuf.Value` in a `.proto`.
/// pub type Event = {
///     @protobuf.Field(1)
///     name: String = ""
///     @protobuf.Field(2)
///     payload: protobuf.JsonValue = json.Value.Null
/// }
///
/// let event = Event { name: "signup", payload: json.parse(r"""{"plan": "pro", "seats": 3}""")? }
/// let read = protobuf.decode[Event](protobuf.encode(event))?
/// console.println("{read.payload}")
/// ```
pub alias JsonValue = __json.Value

/// A key of a map's object as a value, to read as the map's key.
pub fn JsonReader.text(self, key: String): __json.Value {
    __json.Value.Text(key)
}

/// A missing field that the message requires.
pub fn JsonReader.missing(self, name: String): ProtobufError {
    jsonError(serialization.ErrorKind.Missing, "$.{name}", "the required field `{name}` is missing")
}

/// A `bool` key of a map: `"true"` or `"false"`.
pub fn JsonReader.boolKey(self, key: String, path: String): Bool ! ProtobufError {
    match key {
        "true" => true
        "false" => false
        _ => fail jsonError(serialization.ErrorKind.Type, path, "expected `true` or `false`")
    }
}

/// The fields of a message's object, without those that are `null`, which
/// leave their fields as they were.
pub fn JsonReader.fields(
    self,
    value: __json.Value,
    path: String,
): Array[(String, __json.Value)] ! ProtobufError {
    match value {
        __json.Value.Object(fields) => {
            var present: Array[(String, __json.Value)] = []
            for (key, field) in fields {
                if not field.isNull() {
                    present.push((key, field))
                }
            }
            present
        }
        _ => fail jsonError(serialization.ErrorKind.Type, path, "expected an object")
    }
}

/// A field the message does not have: a failure, or nothing when the
/// reader ignores them.
pub fn JsonReader.unknown(self, key: String, path: String): !ProtobufError {
    if not self.ignoreUnknown {
        fail jsonError(
            serialization.ErrorKind.Unknown,
            "{path}.{key}",
            "the message has no field `{key}`",
        )
    }
}

/// The items of a repeated field's array.
pub fn JsonReader.array(
    self,
    value: __json.Value,
    path: String,
): Array[__json.Value] ! ProtobufError {
    match value {
        __json.Value.Array(items) => items
        _ => fail jsonError(serialization.ErrorKind.Type, path, "expected an array")
    }
}

/// The entries of a map's object.
pub fn JsonReader.entries(
    self,
    value: __json.Value,
    path: String,
): Array[(String, __json.Value)] ! ProtobufError {
    match value {
        __json.Value.Object(fields) => fields.entries().collect()
        _ => fail jsonError(serialization.ErrorKind.Type, path, "expected an object")
    }
}

/// An integer, from a number or its text, which must fit between `least`
/// and `most`.
fn JsonReader.integer(
    self,
    value: __json.Value,
    path: String,
    least: Int,
    most: Int,
): Int ! ProtobufError {
    let parsed = match value {
        __json.Value.Number(number) => number.toInt()
        __json.Value.Text(text) => Int.parse(text).ok()
        _ => none
    }
    match parsed {
        some(number) if number >= least and number <= most => number
        some(_) => fail jsonError(
            serialization.ErrorKind.Range,
            path,
            "the number does not fit its field",
        )
        none => fail jsonError(serialization.ErrorKind.Type, path, "expected an integer")
    }
}

/// An `int32`, `sint32` or `sfixed32`.
pub fn JsonReader.int32(self, value: __json.Value, path: String): Int32 ! ProtobufError {
    Int32.wrapping(self.integer(value, path, -2_147_483_648, 2_147_483_647)?)
}

/// A `uint32` or `fixed32`.
pub fn JsonReader.uint32(self, value: __json.Value, path: String): UInt32 ! ProtobufError {
    UInt32.wrapping(self.integer(value, path, 0, 4_294_967_295)?)
}

/// An `int64`, `sint64` or `sfixed64`.
pub fn JsonReader.int64(self, value: __json.Value, path: String): Int ! ProtobufError {
    self.integer(value, path, Int.min, Int.max)?
}

/// A `uint64` or `fixed64`.
pub fn JsonReader.uint64(self, value: __json.Value, path: String): UInt ! ProtobufError {
    let text = match value {
        __json.Value.Number(number) => number.text()
        __json.Value.Text(text) => text
        _ => fail jsonError(serialization.ErrorKind.Type, path, "expected an integer")
    }
    match UInt.parse(text) {
        ok(number) => number
        err(_) => fail jsonError(
            serialization.ErrorKind.Range,
            path,
            "expected an integer from 0 that fits 64 bits",
        )
    }
}

/// A `double`: a number, its text, or `"NaN"`, `"Infinity"` or
/// `"-Infinity"`.
pub fn JsonReader.double(self, value: __json.Value, path: String): Float ! ProtobufError {
    match value {
        __json.Value.Number(number) => number.toFloat()
        __json.Value.Text("NaN") => Float.nan
        __json.Value.Text("Infinity") => Float.infinity
        __json.Value.Text("-Infinity") => -Float.infinity
        __json.Value.Text(text) => match Float.parse(text) {
            ok(number) => number
            err(_) => fail jsonError(serialization.ErrorKind.Type, path, "expected a number")
        }
        _ => fail jsonError(serialization.ErrorKind.Type, path, "expected a number")
    }
}

/// A `float`, as a `double` is read.
pub fn JsonReader.float(self, value: __json.Value, path: String): Float32 ! ProtobufError {
    match Float32(self.double(value, path)?) {
        ok(number) => number
        err(_) => fail jsonError(
            serialization.ErrorKind.Range,
            path,
            "the number does not fit a `float`",
        )
    }
}

/// A `bool`.
pub fn JsonReader.bool(self, value: __json.Value, path: String): Bool ! ProtobufError {
    match value {
        __json.Value.Bool(flag) => flag
        _ => fail jsonError(serialization.ErrorKind.Type, path, "expected `true` or `false`")
    }
}

/// A `string`.
pub fn JsonReader.string(self, value: __json.Value, path: String): String ! ProtobufError {
    match value {
        __json.Value.Text(text) => text
        _ => fail jsonError(serialization.ErrorKind.Type, path, "expected a text")
    }
}

/// `bytes`, in Base64 of either alphabet, with or without padding.
pub fn JsonReader.bytes(self, value: __json.Value, path: String): Array[Byte] ! ProtobufError {
    let text = self.string(value, path)?
    let alphabet = if text.contains("-") or text.contains("_") {
        __encoding.Base64Alphabet.Url
    } else {
        __encoding.Base64Alphabet.Standard
    }
    match __encoding.base64Decode(text.trimEnd("="), alphabet) {
        ok(bytes) => bytes
        err(error) => fail jsonError(serialization.ErrorKind.Type, path, "expected Base64: {error}")
    }
}

/// An enum's value, by name or by number; `none` for a name the enum does
/// not have when the reader ignores unknown fields.
pub fn JsonReader.enumValue[T: Enum](self, value: __json.Value, path: String): T? ! ProtobufError {
    match value {
        __json.Value.Text(name) => match Enum.fromProtobufValueName[T](name) {
            some(found) => some(found)
            none if self.ignoreUnknown => none
            none => fail jsonError(
                serialization.ErrorKind.Unknown,
                path,
                "the enum has no value `{name}`",
            )
        }
        _ => Enum.fromNumber[T](self.int32(value, path)?)
    }
}

/// A message, as its own `readJson` reads it.
pub fn JsonReader.message[T: Message](self, value: __json.Value, path: String): T ! ProtobufError {
    match Message.readJson[T](self, value) {
        ok(message) => message
        err(error) => fail serialization.Error {
            kind: error.kind
            message: error.message
            path: "{path}{error.path.removePrefix("$")}"
            line: error.line
            column: error.column
            violations: error.violations
        }
    }
}

/// A `google.protobuf.Timestamp`, in RFC 3339.
pub fn JsonReader.timestamp(
    self,
    value: __json.Value,
    path: String,
): __time.DateTime ! ProtobufError {
    match __time.parseDateTime(self.string(value, path)?) {
        ok(time) => time
        err(error) => fail jsonError(
            serialization.ErrorKind.Type,
            path,
            "expected a time of RFC 3339: {error}",
        )
    }
}

/// A `google.protobuf.Duration`, in seconds: `1.5s`, `-3s`.
pub fn JsonReader.duration(self, value: __json.Value, path: String): __time.Duration ! ProtobufError {
    let text = self.string(value, path)?
    let wrong = jsonError(serialization.ErrorKind.Type, path, "expected seconds, as `1.5s`")
    if not text.endsWith("s") {
        fail wrong
    }
    let number = text.removeSuffix("s")
    let negative = number.startsWith("-")
    let digits = number.removePrefix("-")
    let (whole, fraction) = match digits.split(".") {
        [whole] => (whole, "")
        [whole, fraction] => (whole, fraction)
        _ => fail wrong
    }
    if fraction.length() > 9 {
        fail wrong
    }
    let seconds = match Int.parse(whole) {
        ok(seconds) => seconds
        err(_) => fail wrong
    }
    let nanoseconds = if fraction.isEmpty() {
        0
    } else {
        match Int.parse(fraction.padEnd(9, "0")) {
            ok(nanoseconds) => nanoseconds
            err(_) => fail wrong
        }
    }
    let total = seconds * 1_000_000_000 + nanoseconds
    __time.nanoseconds(if negative { -total } else { total })
}

// ---------------------------------------------------------------------------
// The messages of the program, which an `Any` in JSON may hold
// ---------------------------------------------------------------------------

/// A message type of the program: its full name, and what writes it from
/// its bytes as JSON and reads its bytes from JSON.
type Known = {
    name: String
    toJson: fn(Array[Byte], JsonWriter): !ProtobufError
    fromJson: fn(__json.Value, JsonReader): Array[Byte] ! ProtobufError
}

/// A type's entry in the table of the program's messages.
fn entryOf[T: Message](): Known {
    Known { name: Message.protobufName[T](), toJson: bytesToJson[T], fromJson: jsonToBytes[T] }
}

fn bytesToJson[T: Message](bytes: Array[Byte], out: JsonWriter): !ProtobufError {
    decode[T](bytes)?.writeJson(out)?
}

fn jsonToBytes[T: Message](value: __json.Value, input: JsonReader): Array[Byte] ! ProtobufError {
    encode(Message.readJson[T](input, value)?)
}

/// The message type of a full name among the program's.
fn knownMessage(name: String): Known? {
    knownMessages().find((known) { known.name == name })
}

/// Every message type of the program, which the compiler lists here.
fn knownMessages(): Array[Known] {
    []
}
