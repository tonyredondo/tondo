// Values by reflection (standard library 14.8) that the program's types are
// built from and written as, which `std.cli`, `std.mcp` and `std.template`
// share.

import std.json as __json
import std.reflect as __reflect

/// A value of no type of its own, which a type of the program converts
/// from by reflection: a record from its members, an enum from its variant
/// and its payload, a sequence from its items.
pub type Shape = {
    variant: String?
    members: Map[String, __reflect.Value]
    items: Array[__reflect.Value]
}

impl __reflect.Reflect for Shape {
    fn reflectGet(self, name: String): __reflect.Value ! __reflect.ReflectError {
        match self.members.get(name) {
            some(value) => value
            none => fail __reflect.ReflectError.noField(
                "shape",
                name,
                self.members.keys().collect(),
            )
        }
    }

    fn reflectFields(self): Array[__reflect.Field]? {
        var fields: Array[__reflect.Field] = []
        for (name, value) in self.members {
            fields.push(__reflect.Field { name, value })
        }
        some(fields)
    }

    fn reflectElements(self): Array[__reflect.Value]? {
        some(self.items)
    }

    fn reflectEntries(self): Array[(__reflect.Value, __reflect.Value)]? {
        var entries: Array[(__reflect.Value, __reflect.Value)] = []
        for (name, value) in self.members {
            entries.push((__reflect.valueOf(name), value))
        }
        some(entries)
    }

    fn reflectVariant(self): String? {
        self.variant
    }

    fn reflectShow(self, nested: Bool): String {
        "shape"
    }
}

/// A record, or a map, of these members.
pub fn record(members: Map[String, __reflect.Value]): __reflect.Value {
    __reflect.valueOf(Shape { variant: none, members, items: [] })
}

/// A variant: its name, the members of a record payload, the items of a
/// tuple's.
pub fn variant(
    name: String,
    members: Map[String, __reflect.Value],
    items: Array[__reflect.Value],
): __reflect.Value {
    __reflect.valueOf(Shape { variant: some(name), members, items })
}

/// A sequence of these items.
pub fn sequence(items: Array[__reflect.Value]): __reflect.Value {
    __reflect.valueOf(Shape { variant: none, members: [:], items })
}

/// The value of a primitive type that a text writes, or why it does not.
pub fn scalar(kind: __reflect.PrimitiveKind, written: String): __reflect.Value ! String {
    let found: __reflect.Value? = match kind {
        __reflect.PrimitiveKind.String => some(__reflect.valueOf(written))
        __reflect.PrimitiveKind.Bool => match written {
            "true" => some(__reflect.valueOf(true))
            "false" => some(__reflect.valueOf(false))
            _ => none
        }
        __reflect.PrimitiveKind.Char => match written.get(0) {
            some(c) if written.length() == 1 => some(__reflect.valueOf(c))
            _ => none
        }
        __reflect.PrimitiveKind.Int => Int.parse(written).ok().map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.Int8 => Int8.parse(written).ok().map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.Int16 => Int16.parse(written).ok().map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.Int32 => Int32.parse(written).ok().map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.Int128 => Int128
            .parse(written)
            .ok()
            .map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.UInt => UInt.parse(written).ok().map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.UInt8 => UInt8.parse(written).ok().map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.UInt16 => UInt16
            .parse(written)
            .ok()
            .map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.UInt32 => UInt32
            .parse(written)
            .ok()
            .map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.UInt128 => UInt128
            .parse(written)
            .ok()
            .map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.Float => Float.parse(written).ok().map((v) { __reflect.valueOf(v) })
        __reflect.PrimitiveKind.Float32 => Float32
            .parse(written)
            .ok()
            .map((v) { __reflect.valueOf(v) })
        _ => none
    }
    match found {
        some(value) => value
        none => fail "`{written}` is not {primitive(kind)}"
    }
}

/// What a primitive type is, for messages: "an integer".
pub fn primitive(kind: __reflect.PrimitiveKind): String {
    match kind {
        __reflect.PrimitiveKind.String => "a text"
        __reflect.PrimitiveKind.Bool => "`true` or `false`"
        __reflect.PrimitiveKind.Char => "a character"
        __reflect.PrimitiveKind.Float => "a number"
        __reflect.PrimitiveKind.Float32 => "a number"
        __reflect.PrimitiveKind.Byte => "a byte"
        __reflect.PrimitiveKind.Unit => "nothing"
        __reflect.PrimitiveKind.Never => "nothing"
        _ => "an integer"
    }
}

/// Whether a value's type is a number.
pub fn numeric(value: __reflect.Value): Bool {
    match value.typeInfo().kind() {
        __reflect.TypeKind.Primitive(kind) =>
            not (kind in
                [
                    __reflect.PrimitiveKind.String,
                    __reflect.PrimitiveKind.Bool,
                    __reflect.PrimitiveKind.Char,
                    __reflect.PrimitiveKind.Unit,
                    __reflect.PrimitiveKind.Never,
                ])
        _ => false
    }
}

/// A value as JSON: records and maps as objects, sequences as arrays, a
/// variant without payload as its name, an optional as its value or null.
pub fn jsonOf(value: __reflect.Value): String {
    let kind = value.typeName()
    if kind == "String" {
        return __json.encode(value.to[String]().unwrapOr(""))
    }
    if kind == "Bool" or numeric(value) {
        return "{value}"
    }
    if kind.endsWith("?") {
        return match value.elements().first() {
            some(inner) => jsonOf(inner)
            none => "null"
        }
    }
    if kind.startsWith("Map[") {
        let members = value
            .entries()
            .map((entry) { "{__json.encode("{entry.0}")}:{jsonOf(entry.1)}" })
        return "{{{members.join(",")}}}"
    }
    if kind.startsWith("Array[") or kind.startsWith("Set[") or kind.startsWith("Deque[") {
        return "[{value.elements().map(jsonOf).join(",")}]"
    }
    let fields = value.fields()
    match value.variant().map((name) { externalVariant(value.typeInfo(), name) }) {
        some(name) if fields.isEmpty() and value.elements().isEmpty() => return __json.encode(name)
        some(name) if fields.isEmpty() => {
            let items = value.elements()
            let payload = if items.length() == 1 {
                jsonOf(items[0])
            } else {
                "[{items.map(jsonOf).join(",")}]"
            }
            return "{{{__json.encode(name)}:{payload}}}"
        }
        _ => {}
    }
    if not fields.isEmpty() {
        let declared = match value.variant() {
            some(name) => value
                .typeInfo()
                .variants()
                .find((v) { v.name() == name })
                .map((v) { v.fields() })
                .unwrapOr([])
            none => value.typeInfo().fields()
        }
        let members = fields.map(
            (field) {
                let external = declared
                    .find((f) { f.name() == field.name })
                    .map((f) { f.externalName() })
                    .unwrapOr(field.name)
                "{__json.encode(external)}:{jsonOf(field.value)}"
            },
        )
        let object = "{{{members.join(",")}}}"
        // A variant with fields is an object of one key, its name, as
        // `std.json` writes it.
        return match value.variant() {
            some(name) => "{{{__json.encode(externalVariant(value.typeInfo(), name))}:{object}}}"
            none => object
        }
    }
    __json.encode("{value}")
}

/// The name outside the program of the variant `name` of an enum: its
/// `@name`, or its own (language 9.4).
fn externalVariant(info: __reflect.TypeInfo, name: String): String {
    info.variants().find((v) { v.name() == name }).map((v) { v.externalName() }).unwrapOr(name)
}

/// The value of a type that JSON writes, at `place` for messages.
pub fn fromJson(
    info: __reflect.TypeInfo,
    json: __json.Value,
    place: String,
): __reflect.Value ! String {
    let wrong = (expected: String) {
        "`{place}` is {__json.encode(json)}, and should be {expected}"
    }
    match info.kind() {
        __reflect.TypeKind.Primitive(kind) => {
            let text = match kind {
                __reflect.PrimitiveKind.String => json.asText()
                __reflect.PrimitiveKind.Char => json.asText()
                __reflect.PrimitiveKind.Bool => json.asBool().map((b) { "{b}" })
                __reflect.PrimitiveKind.Float => json.asFloat().map((f) { "{f}" })
                __reflect.PrimitiveKind.Float32 => json.asFloat().map((f) { "{f}" })
                _ => json.asInt().map((n) { "{n}" })
            }
            match text {
                some(written) => match scalar(kind, written) {
                    ok(value) => value
                    err(problem) => fail "`{place}`: {problem}"
                }
                none if json.isNull() => fail "`{place}` is missing"
                none => fail wrong(primitive(kind))
            }
        }
        __reflect.TypeKind.Applied(__reflect.AppliedKind.Option) => {
            if json.isNull() {
                return variant("none", [:], [])
            }
            let inner = info.genericArguments().first().unwrapOr(info)
            fromJson(inner, json, place)?
        }
        __reflect.TypeKind.Applied(kind) if kind == __reflect.AppliedKind.Array or
            kind == __reflect.AppliedKind.Set => {
            let items = match json.asArray() {
                some(items) => items
                none => fail wrong("an array")
            }
            let inner = info.genericArguments().first().unwrapOr(info)
            var values: Array[__reflect.Value] = []
            for index in 0..items.length() {
                values.push(fromJson(inner, items[index], "{place}[{index}]")?)
            }
            sequence(values)
        }
        __reflect.TypeKind.Applied(__reflect.AppliedKind.Map) => {
            let members = match json.asObject() {
                some(members) => members
                none => fail wrong("an object")
            }
            let inner = info.genericArguments().get(1).unwrapOr(info)
            var values: Map[String, __reflect.Value] = [:]
            for (key, member) in members {
                values[key] = fromJson(inner, member, "{place}.{key}")?
            }
            record(values)
        }
        __reflect.TypeKind.Record => {
            if json.asObject().isNone() {
                fail wrong("an object")
            }
            record(fieldsOf(info.fields(), json, place)?)
        }
        __reflect.TypeKind.Enum => {
            // By the name outside the program, `@name`'s.
            match json.asText() {
                some(name) => match info.variants().find((v) { v.externalName() == name }) {
                    some(found) => return variant(found.name(), [:], [])
                    none => {}
                }
                none => {}
            }
            for (external, payload) in json.asObject().unwrapOr([:]) {
                let name = info
                    .variants()
                    .find((v) { v.externalName() == external })
                    .map((v) { v.name() })
                    .unwrapOr(external)
                match info.variants().find((v) { v.name() == name }) {
                    some(found) if found.payloadKind() == __reflect.VariantPayloadKind.Record => {
                        return variant(
                            name,
                            fieldsOf(found.fields(), payload, "{place}.{name}")?,
                            [],
                        )
                    }
                    some(found) if found.payloadKind() == __reflect.VariantPayloadKind.Tuple => {
                        let parts = found.tupleElements()
                        let given = if parts.length() == 1 {
                            [payload]
                        } else {
                            payload.asArray().unwrapOr([])
                        }
                        var items: Array[__reflect.Value] = []
                        for index in 0..parts.length() {
                            items.push(
                                fromJson(
                                    parts[index],
                                    given.get(index).unwrapOr(__json.Value.Null),
                                    "{place}.{name}",
                                )?,
                            )
                        }
                        return variant(name, [:], items)
                    }
                    _ => {}
                }
            }
            fail wrong("one of {info.variants().map((v) { v.externalName() }).join(", ")}")
        }
        __reflect.TypeKind.Newtype => match info.underlying() {
            some(underlying) => fromJson(underlying, json, place)?
            none => fail "`{place}`: a `{info}` is not read from JSON"
        }
        _ => fail "`{place}`: a `{info}` is not read from JSON"
    }
}

fn fieldsOf(
    fields: Array[__reflect.FieldInfo],
    json: __json.Value,
    place: String,
): Map[String, __reflect.Value] ! String {
    var members: Map[String, __reflect.Value] = [:]
    for field in fields {
        let path = "{place}.{field.externalName()}"
        match json.get(field.externalName()) {
            some(value) => members[field.name()] = fromJson(field.typeInfo(), value, path)?
            // An optional field is `none`, and one with a default has it.
            none if field.typeInfo().kind() ==
                __reflect.TypeKind.Applied(__reflect.AppliedKind.Option) or
                field.default().isSome() => {}
            none => fail "`{path}` is missing"
        }
    }
    members
}
