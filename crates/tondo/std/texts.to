/// The general category of a character: `text.category('a')` is
/// `Category.LowercaseLetter`.
pub fn category(c: Char): Category {
    match textNative.category(c) {
        0 => Category.UppercaseLetter
        1 => Category.LowercaseLetter
        2 => Category.TitlecaseLetter
        3 => Category.ModifierLetter
        4 => Category.OtherLetter
        5 => Category.NonspacingMark
        6 => Category.SpacingMark
        7 => Category.EnclosingMark
        8 => Category.DecimalNumber
        9 => Category.LetterNumber
        10 => Category.OtherNumber
        11 => Category.ConnectorPunctuation
        12 => Category.DashPunctuation
        13 => Category.OpenPunctuation
        14 => Category.ClosePunctuation
        15 => Category.InitialPunctuation
        16 => Category.FinalPunctuation
        17 => Category.OtherPunctuation
        18 => Category.MathSymbol
        19 => Category.CurrencySymbol
        20 => Category.ModifierSymbol
        21 => Category.OtherSymbol
        22 => Category.SpaceSeparator
        23 => Category.LineSeparator
        24 => Category.ParagraphSeparator
        25 => Category.Control
        26 => Category.Format
        27 => Category.Surrogate
        28 => Category.PrivateUse
        _ => Category.Unassigned
    }
}

