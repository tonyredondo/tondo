// std.text (standard library 10.1): the normalization of Unicode text,
// the categories and scripts of its characters, and the order of each
// language. `TextError` is the compiler's, and the methods of `String` and
// `Char` are in the prelude: `tondo api prelude`.

import std.internal.text as textNative

/// A normalization form of Unicode (UAX #15): NFC and NFD compose and
/// decompose characters; NFKC and NFKD also replace those of compatibility
/// with what they stand for, as `ﬁ` with `fi`.
pub enum Normalization {
    Nfc
    Nfd
    Nfkc
    Nfkd
}

/// The text in the normalization form `form`, which gives texts that look
/// the same the same scalars: `"cafe\u{301}"` is `"café"` in NFC.
pub fn normalize(text: String, form: Normalization = Normalization.Nfc): String {
    textNative.normalize(text, code(form))
}

/// Whether the text is already in the normalization form `form`.
pub fn isNormalized(text: String, form: Normalization = Normalization.Nfc): Bool {
    textNative.isNormalized(text, code(form))
}

fn code(form: Normalization): Int {
    match form {
        Normalization.Nfc => 0
        Normalization.Nfd => 1
        Normalization.Nfkc => 2
        Normalization.Nfkd => 3
    }
}

// ---------------------------------------------------------------------------
// Categories and scripts
// ---------------------------------------------------------------------------

/// The general category of a character in Unicode.
pub enum Category {
    UppercaseLetter
    LowercaseLetter
    TitlecaseLetter
    ModifierLetter
    OtherLetter
    NonspacingMark
    SpacingMark
    EnclosingMark
    DecimalNumber
    LetterNumber
    OtherNumber
    ConnectorPunctuation
    DashPunctuation
    OpenPunctuation
    ClosePunctuation
    InitialPunctuation
    FinalPunctuation
    OtherPunctuation
    MathSymbol
    CurrencySymbol
    ModifierSymbol
    OtherSymbol
    SpaceSeparator
    LineSeparator
    ParagraphSeparator
    Control
    Format
    Surrogate
    PrivateUse
    Unassigned
}

/// A script of Unicode: `Latin`, `Han`, `Arabic`; `Common` for characters
