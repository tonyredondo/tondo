// The parts of std.fs (standard library 10.5) written in Tondo, which a
// program that imports std.fs links with: metadata, walks, globs,
// temporary entries, permissions, links and watching, on the runtime's
// filesystem.

import std.fs as __fs
import std.internal.fs as fsNative
import std.path as __path
import std.sync as __sync
import std.time as __time

/// An entry itself, without following links: its kind, size in bytes,
/// read-only flag, last change of its content and Unix permissions, as
/// `0o644`.
pub type Metadata = {
    kind: __fs.FileKind
    size: Int
    readOnly: Bool
    modified: __time.DateTime
    permissions: Int
}

/// An entry under the root of `walk`: its path, from the root, and kind.
pub type Entry = {
    path: String
    kind: __fs.FileKind
}

/// What happened to a path while it was watched.
pub enum ChangeKind {
    Created
    Modified
    Removed
}

/// A path that changed while it was watched, and what happened to it.
pub type Change = {
    path: String
    kind: ChangeKind
}

/// What the entry at the path is, without following a link.
pub fn metadata(path: String): Metadata ! __fs.FsError {
    let found = done(fsNative.stat(path))?
    let numbers = fsNative.numbers(found)
    let since = __time.seconds(numbers[3]) + __time.nanoseconds(numbers[4])
    Metadata {
        kind: kind(numbers[0])
        size: numbers[1]
        readOnly: numbers[2] != 0
        modified: __time.utc(since)
        permissions: numbers[5]
    }
}

/// The tree under `root`, without `root`: each directory before what it
/// holds and siblings sorted by bytes, without following links.
pub fn walk(root: String): Array[Entry] ! __fs.FsError {
    let found = done(fsNative.walk(root, -1))?
    let kinds = fsNative.numbers(found)
    var entries: Array[Entry] = []
    for (index, path) in fsNative.texts(found).enumerate() {
        entries.push(Entry { path: path, kind: kind(kinds[index]) })
    }
    entries
}

/// The paths that match a pattern of `path.matches`, sorted by bytes:
/// `content/**/*.md`.
pub fn glob(pattern: String): Array[String] ! __fs.FsError {
    // The directory to walk: the components before the first with a
    // wildcard, which the pattern's are matched below.
    let parts = pattern.split("/")
    var literal = 0
    for literal < parts.length() and not wild(parts[literal]) {
        literal += 1
    }
    let base = parts.slice(0, literal).unwrapOr([]).join("/")
    if literal == parts.length() {
        return match fsNative.failure(fsNative.stat(base)) {
            0 if not base.isEmpty() => [base]
            _ => []
        }
    }
    let rest = parts.slice(literal, parts.length()).unwrapOr([]).join("/")
    let directory = if base.isEmpty() and pattern.startsWith("/") { "/" } else { base }
    let walked = fsNative.walk(if directory.isEmpty() { "." } else { directory }, depth(rest))
    // No directory there: nothing matches.
    match fsNative.failure(walked) {
        code if code == 1 or code == 4 => return []
        _ => {}
    }
    var found: Array[String] = []
    for path in fsNative.texts(done(walked)?) {
        // The path as the pattern writes its directory.
        let candidate = if directory.isEmpty() {
            path
        } else {
            "{base}/{__path.relative(directory, path).unwrapOr(path)}"
        }
        if __path.matches(pattern, candidate) {
            found.push(__path.clean(candidate))
        }
    }
    found.sort()
    found
}

/// Whether a component of a pattern has a wildcard.
fn wild(part: String): Bool {
    part.chars().any((c) { c == '*' or c == '?' or c == '[' or c == '{' or c == '\\' })
}

/// How deep a walk the rest of a pattern needs: its components, or every
/// level for `**` or a brace that holds a `/`.
fn depth(rest: String): Int {
    var (levels, braces) = (1, 0)
    for c in rest.chars() {
        if c == '{' {
            braces += 1
        } else if c == '}' {
            braces -= 1
        } else if c == '/' and braces > 0 {
            return -1
        } else if c == '/' {
            levels += 1
        }
    }
    if rest.contains("**") { -1 } else { levels }
}

/// A new empty directory in the system's temporary one, which only its user
/// can read; the program removes it.
pub fn createTemporaryDirectory(): String ! __fs.FsError {
    fsNative.texts(done(fsNative.temporary(true))?)[0]
}

/// A new empty file in the system's temporary directory, which only its
/// user can read; the program removes it.
pub fn createTemporaryFile(): String ! __fs.FsError {
    fsNative.texts(done(fsNative.temporary(false))?)[0]
}

/// Sets the Unix permissions of the entry: `0o755` to run a script.
pub fn setPermissions(path: String, permissions: Int): !__fs.FsError {
    _ = done(fsNative.setPermissions(path, permissions))?
}

/// Makes `link` a symbolic link to `target`, which is kept as written and
/// may not exist; a relative one is read from the link's directory.
pub fn createSymlink(target: String, link: String): !__fs.FsError {
    _ = done(fsNative.symlink(target, link))?
}

/// The target of a symbolic link, as it was written.
pub fn readSymlink(path: String): String ! __fs.FsError {
    fsNative.texts(done(fsNative.readSymlink(path))?)[0]
}

/// The absolute, clean path of the same entry, with every link resolved.
pub fn realPath(path: String): String ! __fs.FsError {
    fsNative.texts(done(fsNative.realPath(path))?)[0]
}

/// Watches the paths, with all that their directories hold, and sends their
/// changes in batches: once `settle` (100 ms without it) passes with no
/// other change, each path that changed once, sorted. Watching ends when no
/// copy of the receiver is left.
pub fn watch(paths: Array[String], settle: __time.Duration? = none): Receiver[Array[Change]] !
    __fs.FsError {
    let quiet = settle.unwrapOr(__time.milliseconds(100))
    let watching = done(fsNative.watch(paths, quiet.nanoseconds()))?
    let (sender, receiver) = channel[Array[Change]](discardWhenAbandoned: true)
    spawn detached forward(watching, sender)
    receiver
}

/// Sends each batch of a watch until no receiver is left.
fn forward(watching: fsNative.Native, sender: Sender[Array[Change]]) {
    for {
        let found = fsNative.watchNext(watching)
        if found.isEmpty() or sender.isAbandoned() {
            break
        }
        if found.length() == 1 {
            continue
        }
        var changes: Array[Change] = []
        for index in 0..found.length() / 2 {
            let what = match found[2 * index] {
                "C" => ChangeKind.Created
                "R" => ChangeKind.Removed
                _ => ChangeKind.Modified
            }
            changes.push(Change { path: found[2 * index + 1], kind: what })
        }
        sender.send(changes)
    }
    fsNative.watchStop(watching)
}

/// The runtime's outcome, or its `FsError`.
fn done(outcome: fsNative.Native): fsNative.Native ! __fs.FsError {
    match fsNative.failure(outcome) {
        0 => outcome
        1 => fail __fs.FsError.NotFound
        2 => fail __fs.FsError.PermissionDenied
        3 => fail __fs.FsError.AlreadyExists
        4 => fail __fs.FsError.NotADirectory
        5 => fail __fs.FsError.IsADirectory
        6 => fail __fs.FsError.InvalidData
        7 => fail __fs.FsError.InvalidName
        _ => fail __fs.FsError.Host
    }
}

fn kind(index: Int): __fs.FileKind {
    match index {
        0 => __fs.FileKind.File
        1 => __fs.FileKind.Directory
        2 => __fs.FileKind.Symlink
        _ => __fs.FileKind.Other
    }
}

// ---------------------------------------------------------------------------
// Trees of files
// ---------------------------------------------------------------------------

/// A tree of files, with the operations of `std.fs` by the same names on
/// paths relative to its top, written with `/`: a directory of the disk
/// (`fs.disk`), files in memory (`fs.memory`), the files kept in the
/// executable (`embed.files`), an archive's (`archive.Archive.files`), the
/// part under a directory of another (`sub`), or several in layers
/// (`fs.overlay`). Its copies share it: what one writes the others read.
pub type FileSystem = {
    priv tree: Tree
}

enum Tree {
    Disk(String)
    Memory(__sync.Mutex[Stored])
    Kept(Array[String], Array[Array[Byte]], Array[String])
    Layers(Array[FileSystem])
    Under(Array[FileSystem], String)
}

/// A tree in memory: its files, when each was written, and its
/// directories.
type Stored = {
    files: Map[String, Array[Byte]]
    written: Map[String, __time.DateTime]
    directories: Map[String, Bool]
}

/// The directory `root` of the disk as a tree.
pub fn disk(root: String = "."): FileSystem {
    FileSystem { tree: Tree.Disk(root) }
}

/// An empty tree in memory, whose files' directories exist with them.
pub fn memory(): FileSystem {
    FileSystem {
        tree: Tree.Memory(__sync.Mutex(Stored { files: [:], written: [:], directories: [:] }))
    }
}

/// Several trees as one, as a site's own files over its theme's: a path is
/// read from the first layer that has it, written to the first, and a
/// directory lists what all of them hold.
pub fn overlay(layers: ...FileSystem): FileSystem {
    FileSystem { tree: Tree.Layers(layers) }
}

/// The files kept in the executable, which `embed.files` gives: read only.
fn embeddedTree(names: Array[String], contents: Array[Array[Byte]], tags: Array[String]): FileSystem {
    FileSystem { tree: Tree.Kept(names, contents, tags) }
}

/// The tree under `directory` of this one.
pub fn FileSystem.sub(self, directory: String): FileSystem {
    match placed(directory) {
        ok(at) if at.isEmpty() => self
        ok(at) => FileSystem { tree: Tree.Under([self], at) }
        err(_) => self
    }
}

/// The directory of the disk this tree is, when it is one, for what hands
/// paths to the system, as another program.
pub fn FileSystem.directory(self): String? {
    match self.tree {
        Tree.Disk(root) => some(root)
        Tree.Under(inner, prefix) => inner[0].directory().map((root) { __path.join(root, prefix) })
        _ => none
    }
}

/// The digest of a file kept in the executable, which `std.http` sends as
/// its `ETag`; `none` for another tree's.
pub fn FileSystem.tag(self, path: String): String? {
    let at = placed(path).unwrapOr(path)
    match self.tree {
        Tree.Kept(names, _, tags) => indexOf(names, at).map((index) { tags[index] })
        Tree.Layers(layers) => layers
            .iter()
            .find((layer) { layer.exists(at) })
            .andThen((layer) { layer.tag(at) })
        Tree.Under(inner, prefix) => inner[0].tag(__path.join(prefix, at))
        _ => none
    }
}

/// The contents of the file at `path`.
pub fn FileSystem.readBytes(self, path: String): Array[Byte] ! __fs.FsError {
    let at = placed(path)?
    match self.tree {
        Tree.Disk(root) => __fs.readBytes(below(root, at))?
        Tree.Memory(stored) => match stored.update((s) { s.files.get(at) }) {
            some(contents) => contents
            none => fail missing(stored, at)
        }
        Tree.Kept(names, contents, _) => match indexOf(names, at) {
            some(index) => contents[index]
            none => fail if keptDirectory(names, at) {
                __fs.FsError.IsADirectory
            } else {
                __fs.FsError.NotFound
            }
        }
        Tree.Layers(layers) => {
            for layer in layers {
                match layer.readBytes(at) {
                    ok(contents) => return contents
                    err(__fs.FsError.NotFound) => {}
                    err(error) => fail error
                }
            }
            fail __fs.FsError.NotFound
        }
        Tree.Under(inner, prefix) => inner[0].readBytes(__path.join(prefix, at))?
    }
}

/// The text of the UTF-8 file at `path`.
pub fn FileSystem.readText(self, path: String): String ! __fs.FsError {
    match String.fromBytes(self.readBytes(path)?) {
        ok(text) => text
        err(_) => fail __fs.FsError.InvalidData
    }
}

/// Writes the file at `path`, replacing what it held.
pub fn FileSystem.writeBytes(self, path: String, data: Array[Byte]): !__fs.FsError {
    let at = placed(path)?
    match self.tree {
        Tree.Disk(root) => __fs.writeBytes(below(root, at), data)?
        Tree.Memory(stored) => {
            let now = __time.utcNow()
            stored.update(
                (s) {
                    s.files[at] = data
                    s.written[at] = now
                    for directory in parents(at) {
                        s.directories[directory] = true
                    }
                },
            )
        }
        Tree.Kept(_, _, _) => fail __fs.FsError.PermissionDenied
        Tree.Layers(layers) => match layers.get(0) {
            some(first) => first.writeBytes(at, data)?
            none => fail __fs.FsError.PermissionDenied
        }
        Tree.Under(inner, prefix) => inner[0].writeBytes(__path.join(prefix, at), data)?
    }
}

/// Writes the text to the file at `path`.
pub fn FileSystem.writeText(self, path: String, text: String): !__fs.FsError {
    self.writeBytes(path, text.bytes())?
}

/// Whether there is a file or a directory at `path`.
pub fn FileSystem.exists(self, path: String): Bool {
    let at = match placed(path) {
        ok(at) => at
        err(_) => return false
    }
    match self.tree {
        Tree.Disk(root) => __fs.exists(below(root, at))
        Tree.Memory(stored) =>
            at.isEmpty() or stored.update((s) { at in s.files or at in s.directories })
        Tree.Kept(names, _, _) =>
            at.isEmpty() or indexOf(names, at).isSome() or keptDirectory(names, at)
        Tree.Layers(layers) => layers.iter().any((layer) { layer.exists(at) })
        Tree.Under(inner, prefix) => inner[0].exists(__path.join(prefix, at))
    }
}

/// The names of what is directly in the directory at `path`, sorted.
pub fn FileSystem.list(self, path: String = ""): Array[String] ! __fs.FsError {
    let at = placed(path)?
    var names: Array[String] = match self.tree {
        Tree.Disk(root) => __fs.list(below(root, at))?
        Tree.Memory(stored) => {
            let (files, directories) = stored.update(
                (s) { (s.files.keys().collect(), s.directories.keys().collect()) },
            )
            if not at.isEmpty() and not (at in directories) {
                fail missing(stored, at)
            }
            children(files.concat(directories), at)
        }
        Tree.Kept(kept, _, _) => {
            if not at.isEmpty() and not keptDirectory(kept, at) {
                fail if indexOf(kept, at).isSome() {
                    __fs.FsError.NotADirectory
                } else {
                    __fs.FsError.NotFound
                }
            }
            children(kept, at)
        }
        Tree.Layers(layers) => {
            var joined: Array[String] = []
            var found = false
            for layer in layers {
                match layer.list(at) {
                    ok(more) => {
                        joined.extend(more)
                        found = true
                    }
                    err(__fs.FsError.NotFound) => {}
                    err(error) => fail error
                }
            }
            if not found {
                fail __fs.FsError.NotFound
            }
            joined
        }
        Tree.Under(inner, prefix) => inner[0].list(__path.join(prefix, at))?
    }
    names.sort()
    names.unique()
}

/// What the entry at `path` is.
pub fn FileSystem.metadata(self, path: String): Metadata ! __fs.FsError {
    let at = placed(path)?
    let directory = (modified: __time.DateTime, readOnly: Bool): Metadata {
        Metadata {
            kind: __fs.FileKind.Directory
            size: 0
            readOnly
            modified
            permissions: if readOnly { 0o555 } else { 0o755 }
        }
    }
    match self.tree {
        Tree.Disk(root) => metadata(below(root, at))?
        Tree.Memory(stored) => {
            let (file, written, folder) = stored.update(
                (s) { (s.files.get(at), s.written.get(at), at.isEmpty() or at in s.directories) },
            )
            match (file, written) {
                (some(contents), some(when)) => Metadata {
                    kind: __fs.FileKind.File
                    size: contents.length()
                    readOnly: false
                    modified: when
                    permissions: 0o644
                }
                _ if folder => directory(__time.utcNow(), false)
                _ => fail __fs.FsError.NotFound
            }
        }
        Tree.Kept(names, contents, _) => match indexOf(names, at) {
            some(index) => Metadata {
                kind: __fs.FileKind.File
                size: contents[index].length()
                readOnly: true
                modified: __time.utc(__time.seconds(0))
                permissions: 0o444
            }
            none if at.isEmpty() or keptDirectory(names, at) => directory(
                __time.utc(__time.seconds(0)),
                true,
            )
            none => fail __fs.FsError.NotFound
        }
        Tree.Layers(layers) => {
            for layer in layers {
                match layer.metadata(at) {
                    ok(found) => return found
                    err(__fs.FsError.NotFound) => {}
                    err(error) => fail error
                }
            }
            fail __fs.FsError.NotFound
        }
        Tree.Under(inner, prefix) => inner[0].metadata(__path.join(prefix, at))?
    }
}

/// The tree under `root`, without `root`, its paths from the top: each
/// directory before what it holds, and siblings sorted.
pub fn FileSystem.walk(self, root: String = ""): Array[Entry] ! __fs.FsError {
    let at = placed(root)?
    var entries: Array[Entry] = []
    for name in self.list(at)? {
        let path = if at.isEmpty() { name } else { "{at}/{name}" }
        let found = self.metadata(path)?.kind
        entries.push(Entry { path, kind: found })
        if found == __fs.FileKind.Directory {
            entries.extend(self.walk(path)?)
        }
    }
    entries
}

/// The paths that match a pattern of `path.matches`, as `**/*.md`, sorted.
pub fn FileSystem.glob(self, pattern: String): Array[String] ! __fs.FsError {
    var found: Array[String] = []
    for entry in self.walk()? {
        if __path.matches(pattern, entry.path) {
            found.push(entry.path)
        }
    }
    found
}

/// Makes the directory at `path` and those it is in.
pub fn FileSystem.createDirectory(self, path: String): !__fs.FsError {
    let at = placed(path)?
    match self.tree {
        Tree.Disk(root) => __fs.createDirectory(below(root, at))?
        Tree.Memory(stored) => stored.update(
            (s) {
                for directory in parents("{at}/x") {
                    s.directories[directory] = true
                }
            },
        )
        Tree.Kept(_, _, _) => fail __fs.FsError.PermissionDenied
        Tree.Layers(layers) => match layers.get(0) {
            some(first) => first.createDirectory(at)?
            none => fail __fs.FsError.PermissionDenied
        }
        Tree.Under(inner, prefix) => inner[0].createDirectory(__path.join(prefix, at))?
    }
}

/// Removes the file at `path`, or the directory, with what it holds when
/// `recursive`.
pub fn FileSystem.remove(self, path: String, recursive: Bool = false): !__fs.FsError {
    let at = placed(path)?
    match self.tree {
        Tree.Disk(root) => __fs.remove(below(root, at), recursive: recursive)?
        Tree.Memory(stored) => {
            let prefix = "{at}/"
            let outcome = stored.update(
                (s) {
                    if at in s.files {
                        _ = s.files.remove(at)
                        _ = s.written.remove(at)
                        return 0
                    }
                    if not (at in s.directories) {
                        return 1
                    }
                    let held =
                        s.files.keys().any((name) { name.startsWith(prefix) }) or
                            s.directories.keys().any((name) { name.startsWith(prefix) })
                    if held and not recursive {
                        return 2
                    }
                    for name in s.files.keys().filter((name) { name.startsWith(prefix) }).collect() {
                        _ = s.files.remove(name)
                        _ = s.written.remove(name)
                    }
                    for name in s.directories
                        .keys()
                        .filter((name) { name.startsWith(prefix) })
                        .collect() {
                        _ = s.directories.remove(name)
                    }
                    _ = s.directories.remove(at)
                    0
                },
            )
            match outcome {
                1 => fail __fs.FsError.NotFound
                2 => fail __fs.FsError.IsADirectory
                _ => {}
            }
        }
        Tree.Kept(_, _, _) => fail __fs.FsError.PermissionDenied
        Tree.Layers(layers) => match layers.get(0) {
            some(first) => first.remove(at, recursive: recursive)?
            none => fail __fs.FsError.PermissionDenied
        }
        Tree.Under(inner, prefix) => inner[0].remove(__path.join(prefix, at), recursive: recursive)?
    }
}

/// A path of a tree, from its top, without `.`, `..` or a leading `/`; one
/// that would leave the tree is `InvalidName`.
fn placed(path: String): String ! __fs.FsError {
    let cleaned = __path.clean(path.removePrefix("/"))
    if cleaned == "." {
        return ""
    }
    if cleaned == ".." or cleaned.startsWith("../") or cleaned.startsWith("/") {
        fail __fs.FsError.InvalidName
    }
    cleaned
}

fn below(root: String, at: String): String {
    if at.isEmpty() { root } else { __path.join(root, at) }
}

fn missing(stored: __sync.Mutex[Stored], at: String): __fs.FsError {
    if stored.update((s) { at in s.directories }) {
        __fs.FsError.IsADirectory
    } else {
        __fs.FsError.NotFound
    }
}

fn indexOf(names: Array[String], at: String): Int? {
    names.iter().enumerate().find((pair) { pair.1 == at }).map((pair) { pair.0 })
}

fn keptDirectory(names: Array[String], at: String): Bool {
    let prefix = "{at}/"
    names.iter().any((name) { name.startsWith(prefix) })
}

/// The directories a file's path is in: `a` and `a/b` for `a/b/c`.
fn parents(path: String): Array[String] {
    var found: Array[String] = []
    let parts = path.split("/")
    for count in 1..parts.length() {
        found.push(parts.slice(0, count).unwrapOr([]).join("/"))
    }
    found
}

/// The first component, after `at/`, of each path under `at`.
fn children(paths: Array[String], at: String): Array[String] {
    let prefix = if at.isEmpty() { "" } else { "{at}/" }
    var found: Array[String] = []
    for path in paths {
        if path.startsWith(prefix) and path != at {
            let rest = path.removePrefix(prefix)
            found.push(rest.splitOnce("/").map((parts) { parts.0 }).unwrapOr(rest))
        }
    }
    found
}
