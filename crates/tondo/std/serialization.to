// std.serialization (standard library 14.7): the events every format reads
// and writes, and the traits through which a type is written to and read
// from any of them. The compiler implements `Encode` and `Decode` for every
// record, enum and newtype whose parts implement them; each format gives a
// `Source` and a `Sink`.

import std.internal.codec as serialcodec
import std.internal.text as serialtext

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

/// A value as every format reads it: scalars, and the bounds of lists and
/// maps with the keys of their members.
pub enum Event {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    /// A number as a text format writes it, which keeps its precision
    /// until a type takes it.
    Number(String)
    Text(String)
    /// A scalar written as text with no type, as XML writes them: each
    /// scalar type reads it from its text, a number or a `Bool` without
    /// the whitespace around it.
    Untyped(String)
    /// A date, a time or both, as RFC 3339 writes them, in a format that
    /// has them: `1979-05-27T07:32:00Z`, `1979-05-27`, `07:32:00`.
    DateTime(String)
    Bytes(Array[Byte])
    BeginList
    EndList
    BeginMap
    /// The key of the next member of a map.
    Key(String)
    EndMap
}

// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------

/// What kind of error reading or writing a value met.
pub enum ErrorKind {
    /// The input is not in the format.
    Syntax
    /// A value of another kind than the type needs.
    Type
    /// A field the type needs is absent.
    Missing
    /// A field the type does not have, when unknown fields are rejected.
    Unknown
    /// A number that does not fit the type.
    Range
    /// The stream it was read from or written to failed.
    Io
    /// A value the format cannot hold, as a `none` in a TOML array.
    Unsupported
}

/// The kind's name, as `Syntax`.
impl Display for ErrorKind {
    fn display(self): String {
        match self {
            ErrorKind.Syntax => "Syntax"
            ErrorKind.Type => "Type"
            ErrorKind.Missing => "Missing"
            ErrorKind.Unknown => "Unknown"
            ErrorKind.Range => "Range"
            ErrorKind.Io => "Io"
            ErrorKind.Unsupported => "Unsupported"
        }
    }
}

/// What an annotation of a format says of a type or a field, which the
/// code the compiler writes for `Encode` and `Decode` gives the format:
/// `@xml.Name("item")` is `Note { format: "xml", name: "Name", value:
/// "item" }`. A format reads its own notes and no other.
pub type Note = {
    format: String
    name: String
    /// The annotation's argument as text; empty without one.
    value: String
}

/// What reading does with a member of a map that the type has no field
/// for.
pub enum UnknownFields {
    Ignore
    Reject
}

/// A failure to read or write a format, and where.
pub type Error = {
    kind: ErrorKind
    message: String
    /// Where in the document, as `$.users[2].age`.
    path: String
    line: Int
    column: Int
}

/// `message at path (line l, column c)`, without the position when there
/// is none, as for what could not be written.
impl Display for Error {
    fn display(self): String {
        if self.line == 0 {
            return "{self.message} at {self.path}"
        }
        "{self.message} at {self.path} (line {self.line}, column {self.column})"
    }
}

// ---------------------------------------------------------------------------
// Reading
// ---------------------------------------------------------------------------

/// A document read event by event: the reader of a format.
pub trait Source {
    /// The next event, or `none` after the whole document.
    fn next(self): Event? ! Error

    /// Skips the rest of a value whose first event was `first`.
    fn skip(self, first: Event): !Error

    /// An error at the current position, with its path, line and column.
    fn failure(self, kind: ErrorKind, message: String): Error

    /// Whether a field the type does not have is an error.
    fn rejectsUnknown(self): Bool {
        false
    }

    /// The value whose first event was `first` as the JSON text it was
    /// read from, for `json.Raw`; `none` from another format.
    fn rawJson(self, first: Event): String? {
        none
    }

    /// What the format calls a map and a list, for messages.
    fn mapName(self): String {
        "a map"
    }

    fn listName(self): String {
        "a list"
    }

    /// Before the fields of a record are read, when some have notes: the
    /// notes of each, in the order of the names `nextField` takes.
    fn fields(self, notes: Array[Array[Note]]) {}

    /// The next event, which must exist.
    fn value(self): Event ! Error {
        match self.next()? {
            some(event) => event
            none => fail self.failure(ErrorKind.Syntax, "unexpected end of input")
        }
    }

    /// The next key of a map, or `none` at its end.
    fn nextKey(self): String? ! Error {
        match self.value()? {
            Event.Key(key) => key
            Event.EndMap => none
            _ => fail self.failure(ErrorKind.Syntax, "expected a key")
        }
    }

    /// The next member of a map, read up to its value: the index of its
    /// key in `names`, or `none` at the map's end. A member whose key is
    /// none of them is skipped whole, or fails when unknown fields are
    /// rejected, and gives `names.length()`. A format that reads keys in
    /// place compares them there, with no string made for each.
    fn nextField(self, names: Array[String]): Int? ! Error {
        let key = match self.nextKey()? {
            some(key) => key
            none => return none
        }
        for index in 0..names.length() {
            if names[index] == key {
                return some(index)
            }
        }
        self.unknownField(key, self.value()?)?
        some(names.length())
    }

    /// A member the type does not have: skipped, or an error when unknown
    /// fields are rejected.
    fn unknownField(self, key: String, first: Event): !Error {
        if self.rejectsUnknown() {
            fail self.failure(ErrorKind.Unknown, "unknown field `{key}`")
        }
        self.skip(first)?
    }

    /// Checks that a map starts, for the type `name`.
    fn beginMap(self, first: Event, name: String): !Error {
        match first {
            Event.BeginMap => {}
            _ => fail self.mismatch(first, "{self.mapName()} for `{name}`")
        }
    }

    /// Checks that a list starts, for `name`.
    fn beginList(self, first: Event, name: String): !Error {
        match first {
            Event.BeginList => {}
            _ => fail self.mismatch(first, "{self.listName()} for `{name}`")
        }
    }

    /// Checks that a list ends.
    fn endList(self): !Error {
        match self.value()? {
            Event.EndList => {}
            _ => fail self.failure(ErrorKind.Type, "expected the end of {self.listName()}")
        }
    }

    /// A field that must have been present.
    fn required[T: ~Copy](self, value: T?, field: String): T ! Error {
        match value {
            some(found) => found
            none => fail self.failure(ErrorKind.Missing, "missing field `{field}`")
        }
    }

    /// An error for a value of the wrong kind.
    fn mismatch(self, first: Event, expected: String): Error {
        let found = match first {
            Event.Null => "null"
            Event.Bool(_) => "a boolean"
            Event.Int(_) => "a number"
            Event.Float(_) => "a number"
            Event.Number(_) => "a number"
            Event.Text(_) => "a string"
            Event.Untyped(text) => "`{text}`"
            Event.DateTime(_) => "a date-time"
            Event.Bytes(_) => "bytes"
            Event.BeginList => self.listName()
            Event.BeginMap => self.mapName()
            Event.EndList => "the end of {self.listName()}"
            Event.EndMap => "the end of {self.mapName()}"
            Event.Key(_) => "a key"
        }
        self.failure(ErrorKind.Type, "expected {expected}, found {found}")
    }
}

// ---------------------------------------------------------------------------
// Writing
// ---------------------------------------------------------------------------

/// A document written value by value: the writer of a format. A value it
/// cannot hold is an error that the format reports when it finishes.
pub trait Sink {
    fn null(self)

    fn bool(self, value: Bool)

    fn int(self, value: Int)

    fn float(self, value: Float)

    /// A number as a text format writes it.
    fn number(self, digits: String)

    fn text(self, value: String)

    fn bytes(self, value: Array[Byte])

    /// A date, a time or both, as RFC 3339 writes them; as text in a
    /// format without them.
    fn dateTime(self, text: String) {
        self.text(text)
    }

    /// Before the map of a record: the name of its type, or of its
    /// variant, and the notes of the type, for a format that names its
    /// values, as XML its elements.
    fn record(self, name: String, notes: Array[Note]) {}

    /// Before the key of a field with notes: the notes.
    fn field(self, notes: Array[Note]) {}

    /// A list of `count` values follows, then its end.
    fn beginList(self, count: Int)

    fn endList(self)

    /// A map of `count` members follows, each a key and a value, then its
    /// end.
    fn beginMap(self, count: Int)

    fn key(self, name: String)

    fn endMap(self)

    /// Whether a map leaves out its members that are `none`, as in a
    /// format without null.
    fn omitsNone(self): Bool {
        false
    }

    /// Writes JSON text as it is, for `json.Raw`; false when the format
    /// does not take it, and the value is written event by event instead.
    fn rawJson(self, text: String): Bool {
        false
    }
}

// ---------------------------------------------------------------------------
// Encoding and decoding
// ---------------------------------------------------------------------------

/// A type that writes itself to any format. The compiler implements it for
/// every record, enum and newtype whose parts implement it.
pub trait Encode {
    fn encode[S: Sink](self, out: S)
}

/// A type that reads itself from any format, given the first event of its
/// value. The compiler implements it as `Encode`.
pub trait Decode {
    fn decode[S: Source](input: S, first: Event): Self ! Error
}

/// An integer of any width: an `Int` when it is one, or its digits, so
/// that no integer goes through a float (14.7).
fn encodeInteger[T: Integer, S: Sink](value: T, out: S) {
    let small = Int.wrapping(value)
    if T.wrapping(small) == value and (small < 0) == (value < 0) {
        out.int(small)
    } else {
        out.number(value.toString())
    }
}

/// An integer of `T`, named `name`, from an `Int` or a number's digits.
fn decodeInteger[T: Integer, S: Source](input: S, first: Event, name: String): T ! Error {
    match first {
        Event.Int(value) => {
            let narrow = T.wrapping(value)
            if Int.wrapping(narrow) == value and (narrow < 0) == (value < 0) {
                return narrow
            }
            fail input.failure(ErrorKind.Range, "{value} is not an integer that fits `{name}`")
        }
        Event.Number(digits) => match T.parse(digits) {
            ok(value) => value
            err(_) => fail input.failure(
                ErrorKind.Range,
                "{digits} is not an integer that fits `{name}`",
            )
        }
        Event.Float(value) => fail input.failure(
            ErrorKind.Range,
            "{value} is not an integer that fits `{name}`",
        )
        Event.Untyped(text) => match T.parse(text.trim()) {
            ok(value) => value
            err(_) => fail input.mismatch(first, "an integer that fits `{name}`")
        }
        _ => fail input.mismatch(first, "an integer")
    }
}

impl Encode for Int {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for Int {
    fn decode[S: Source](input: S, first: Event): Int ! Error {
        decodeInteger[Int, S](input, first, "Int")
    }
}

impl Encode for Int8 {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for Int8 {
    fn decode[S: Source](input: S, first: Event): Int8 ! Error {
        decodeInteger[Int8, S](input, first, "Int8")
    }
}

impl Encode for Int16 {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for Int16 {
    fn decode[S: Source](input: S, first: Event): Int16 ! Error {
        decodeInteger[Int16, S](input, first, "Int16")
    }
}

impl Encode for Int32 {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for Int32 {
    fn decode[S: Source](input: S, first: Event): Int32 ! Error {
        decodeInteger[Int32, S](input, first, "Int32")
    }
}

impl Encode for Int128 {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for Int128 {
    fn decode[S: Source](input: S, first: Event): Int128 ! Error {
        decodeInteger[Int128, S](input, first, "Int128")
    }
}

impl Encode for UInt {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for UInt {
    fn decode[S: Source](input: S, first: Event): UInt ! Error {
        decodeInteger[UInt, S](input, first, "UInt")
    }
}

impl Encode for UInt8 {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for UInt8 {
    fn decode[S: Source](input: S, first: Event): UInt8 ! Error {
        decodeInteger[UInt8, S](input, first, "UInt8")
    }
}

impl Encode for UInt16 {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for UInt16 {
    fn decode[S: Source](input: S, first: Event): UInt16 ! Error {
        decodeInteger[UInt16, S](input, first, "UInt16")
    }
}

impl Encode for UInt32 {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for UInt32 {
    fn decode[S: Source](input: S, first: Event): UInt32 ! Error {
        decodeInteger[UInt32, S](input, first, "UInt32")
    }
}

impl Encode for UInt128 {
    fn encode[S: Sink](self, out: S) {
        encodeInteger(self, out)
    }
}

impl Decode for UInt128 {
    fn decode[S: Source](input: S, first: Event): UInt128 ! Error {
        decodeInteger[UInt128, S](input, first, "UInt128")
    }
}

/// A byte is an integer from 0 to 255.
impl Encode for Byte {
    fn encode[S: Sink](self, out: S) {
        out.int(Int(self))
    }
}

impl Decode for Byte {
    fn decode[S: Source](input: S, first: Event): Byte ! Error {
        let value = Decode.decode[Int](input, first)?
        match Byte(value) {
            ok(byte) => byte
            err(_) => fail input.failure(ErrorKind.Range, "{value} is not a byte, from 0 to 255")
        }
    }
}

impl Encode for Float {
    fn encode[S: Sink](self, out: S) {
        out.float(self)
    }
}

impl Decode for Float {
    fn decode[S: Source](input: S, first: Event): Float ! Error {
        match first {
            Event.Float(value) => value
            Event.Int(value) => Float(value)
            // A number a format read is valid; its text needs no checking.
            Event.Number(digits) => serialtext.parseFloat(digits)
            Event.Untyped(text) => match Float.parse(text.trim()) {
                ok(value) => value
                err(_) => fail input.mismatch(first, "a number")
            }
            _ => fail input.mismatch(first, "a number")
        }
    }
}

/// A finite `Float32` is its shortest digits, as `0.1`, which a text
/// writes as they are and a binary format as the float they round to.
impl Encode for Float32 {
    fn encode[S: Sink](self, out: S) {
        if self.isFinite() { out.number("{self}") } else { out.float(Float(self)) }
    }
}

impl Decode for Float32 {
    fn decode[S: Source](input: S, first: Event): Float32 ! Error {
        // A number's digits round once, to 32 bits.
        match first {
            Event.Number(digits) => match Float32.parse(digits) {
                ok(value) => return value
                err(_) => {}
            }
            Event.Untyped(text) => match Float32.parse(text.trim()) {
                ok(value) => return value
                err(_) => {}
            }
            _ => {}
        }
        let value = Decode.decode[Float](input, first)?
        match Float32(value) {
            ok(single) => single
            err(_) => fail input.failure(ErrorKind.Range, "{value} does not fit in `Float32`")
        }
    }
}

impl Encode for Bool {
    fn encode[S: Sink](self, out: S) {
        out.bool(self)
    }
}

impl Decode for Bool {
    fn decode[S: Source](input: S, first: Event): Bool ! Error {
        match first {
            Event.Bool(value) => value
            Event.Untyped(text) => match text.trim() {
                "true" => true
                "1" => true
                "false" => false
                "0" => false
                _ => fail input.mismatch(first, "a boolean")
            }
            _ => fail input.mismatch(first, "a boolean")
        }
    }
}

impl Encode for String {
    fn encode[S: Sink](self, out: S) {
        out.text(self)
    }
}

impl Decode for String {
    fn decode[S: Source](input: S, first: Event): String ! Error {
        match first {
            Event.Text(text) => text
            Event.Untyped(text) => text
            Event.DateTime(text) => text
            _ => fail input.mismatch(first, "a string")
        }
    }
}

impl[T: Encode] Encode for Array[T] {
    fn encode[S: Sink](self, out: S) {
        out.beginList(self.length())
        for item in self {
            item.encode(out)
        }
        out.endList()
    }
}

impl[T: Decode] Decode for Array[T] {
    fn decode[S: Source](input: S, first: Event): Array[T] ! Error {
        input.beginList(first, "Array")?
        var items: Array[T] = []
        for {
            let event = input.value()?
            match event {
                Event.EndList => break
                _ => items.push(Decode.decode[T](input, event)?)
            }
        }
        items
    }
}

impl[T: Encode] Encode for T? {
    fn encode[S: Sink](self, out: S) {
        match self {
            some(value) => value.encode(out)
            none => out.null()
        }
    }
}

impl[T: Decode] Decode for T? {
    fn decode[S: Source](input: S, first: Event): T? ! Error {
        match first {
            Event.Null => none
            _ => some(Decode.decode[T](input, first)?)
        }
    }
}

impl[V: Encode] Encode for Map[String, V] {
    fn encode[S: Sink](self, out: S) {
        out.beginMap(self.length())
        for (key, value) in self {
            out.key(key)
            value.encode(out)
        }
        out.endMap()
    }
}

impl[V: Decode] Decode for Map[String, V] {
    fn decode[S: Source](input: S, first: Event): Map[String, V] ! Error {
        input.beginMap(first, "Map")?
        var members: Map[String, V] = [:]
        for {
            match input.nextKey()? {
                some(key) => {
                    let event = input.value()?
                    members[key] = Decode.decode[V](input, event)?
                }
                none => break
            }
        }
        members
    }
}

/// Bytes as every format holds them: natively in a binary format, as a
/// base64 string in a text one.
pub type Bytes = Array[Byte]

impl Encode for Bytes {
    fn encode[S: Sink](self, out: S) {
        out.bytes(self.value)
    }
}

impl Decode for Bytes {
    fn decode[S: Source](input: S, first: Event): Bytes ! Error {
        match first {
            Event.Bytes(bytes) => Bytes(bytes)
            Event.Untyped(text) => Decode.decode[Bytes](input, Event.Text(text))?
            Event.Text(text) => {
                if serialcodec.base64Check(text, false) != -1 {
                    fail input.failure(
                        ErrorKind.Type,
                        "expected bytes as base64, found text that is not",
                    )
                }
                Bytes(serialcodec.base64Decode(text, false))
            }
            _ => fail input.mismatch(first, "bytes")
        }
    }
}
