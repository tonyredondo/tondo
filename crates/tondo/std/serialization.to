// A union is written as the member it holds, and read as the first of its
// members, in the order the union writes them, that reads the value: the
// compiler's code for each union tries them on the value's events.

/// A value's events, read once to try each member of a union on them, and
/// the failure of the member that came nearest: one that read the value's
/// shape and not its content, as a missing field.
type Attempt = {
    events: Array[Event]
    failure: Error?
}

/// The events of the value whose first event is `first`, to its end.
fn unionAttempt[S: Source](input: S, first: Event): Attempt ! Error {
    var events = [first]
    var depth = if first == Event.BeginList or first == Event.BeginMap { 1 } else { 0 }
    for depth > 0 {
        let event = input.value()?
        if event == Event.BeginList or event == Event.BeginMap {
            depth += 1
        } else if event == Event.EndList or event == Event.EndMap {
            depth -= 1
        }
        events.push(event)
    }
    Attempt { events, failure: none }
}

/// The value as the member `T`, or the attempt with this member's failure
/// when it is the nearest yet.
fn unionMember[T: Decode, S: Source](input: S, attempt: Attempt): (T?, Attempt) {
    let replay = Replay { input, events: attempt.events, at: serialcodec.counter() }
    match Decode.decode[T](replay, replay.events[replay.position()]) {
        ok(value) => (some(value), attempt)
        err(error) if error.kind != ErrorKind.Type => (none, attempt with { failure: some(error) })
        err(_) => (none, attempt)
    }
}

/// Why no member of a union reads a value, from the input, where the
/// value is: the nearest member's failure, or that the value is of none of
/// their kinds.
fn unionFailure[S: Source](input: S, attempt: Attempt, members: String): Error {
    match attempt.failure {
        some(failure) if failure.kind == ErrorKind.Invalid => input.invalid(failure.violations)
        some(failure) => input.failure(failure.kind, failure.message)
        none => input.mismatch(attempt.events.first().unwrapOr(Event.Null), members)
    }
}

/// The events of a value given again, for another member, with where it
/// is in them.
type Replay[S] = {
    input: S
    events: Array[Event]
    at: serialcodec.Native
}

/// The position of the next event, which it then passes.
fn Replay[S].position(self): Int {
    serialcodec.counterNext(self.at)
}

impl[S: Source] Source for Replay[S] {
    fn next(self): Event? ! Error {
        self.events.get(self.position())
    }

    fn skip(self, first: Event): !Error {
        var depth = if first == Event.BeginList or first == Event.BeginMap { 1 } else { 0 }
        for depth > 0 {
            let event = self.value()?
            if event == Event.BeginList or event == Event.BeginMap {
                depth += 1
            } else if event == Event.EndList or event == Event.EndMap {
                depth -= 1
            }
        }
    }

    /// A failure kept apart from the input, which a failure ends: another
    /// member may still read the value.
    fn failure(self, kind: ErrorKind, message: String): Error {
        Error { kind, message, path: "$", line: 0, column: 0, violations: [] }
    }

    fn rejectsUnknown(self): Bool {
        self.input.rejectsUnknown()
    }

    fn mapName(self): String {
        self.input.mapName()
    }

    fn listName(self): String {
        self.input.listName()
    }
}

/// Bytes as every format holds them: natively in a binary format, as a
/// base64 string in a text one.
///
/// ```tondo
/// import std.console
/// import std.json
/// import std.messagepack
/// import std.serialization
///
/// pub type Blob = { name: String, data: serialization.Bytes }
///
/// let blob = Blob { name: "key", data: serialization.Bytes([1, 2, 255]) }
/// console.println(json.encode(blob))
/// console.println("{messagepack.encode(blob).length()} bytes in MessagePack")
/// ```
pub type Bytes = Array[Byte]

impl Encode for Bytes {
    fn encode[S: Sink](self, out: S) {
        out.bytes(self.value)
    }
}

impl Decode for Bytes {
    fn decode[S: Source](input: S, first: Event): Bytes ! Error {
        match first {
            Event.Bytes(bytes) => Bytes(bytes)
            Event.Untyped(text) => Decode.decode[Bytes](input, Event.Text(text))?
            Event.Text(text) => {
                if serialcodec.base64Check(text, false) != -1 {
                    fail input.failure(
                        ErrorKind.Type,
                        "expected bytes as base64, found text that is not",
                    )
                }
                Bytes(serialcodec.base64Decode(text, false))
            }
            _ => fail input.mismatch(first, "bytes")
        }
    }
}
