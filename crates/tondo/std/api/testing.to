// std.testing: what a test tells the runner (testing 11.2); only in test
// files.
//
// ```tondo
// import std.testing
//
// test addsNumbers {
//     testing.log("adding")
//     assert(1 + 1 == 2)
//     testing.snapshot("sum", [1, 2, 3])
// }
// ```

/// A line in the test's report.
pub fn log(message: String)

/// Adds the pairs to the test's tags in its report; a key it has already
/// with another value panics, and none is added.
pub fn tags(values: Map[String, String])

/// Fails the test now.
pub fn failNow(message: String): Never

/// Ends the test now as skipped, with the reason in its report.
pub fn skip(reason: String): Never

/// Adds a file to the test's report: its name, media type and content.
pub fn attach(name: String, mediaType: String, data: Array[Byte])

/// Compares the value's JSON with the file of the snapshot `name`;
/// `ignore` drops paths, `matches` checks them against patterns and
/// `replace` substitutes them.
pub fn snapshot[T: serialization.Encode](
    name: String,
    value: T,
    ignore: Array[String] = [],
    matches: Map[String, String] = [:],
    replace: Map[String, String] = [:],
)

/// Runs the body with a virtual clock that only moves when told.
pub fn withVirtualTime[E, F: Send + CallOnce[fn(VirtualTime): !E]](body: F): !E

/// Lets every task that is ready run until all wait.
pub fn VirtualTime.settle(self)

/// Moves the virtual clock forward by `duration`, running every task due
/// on the way until all wait; a negative duration panics.
pub fn VirtualTime.advance(self, duration: time.Duration)

/// Makes the test a benchmark, called in its body (testing 10.4): runs the
/// closure once and gives what it gave; with `tondo test --bench` it first
/// measures how long a run takes and what it allocates, keeping what each
/// run gives, and makes that run after the measured ones, unmeasured. In a
/// plain run it is the only one: a benchmark checks its answer with it, so
/// that a body that stops doing its work fails rather than looks faster.
/// The call fails as the closure does, a measured run's error ending the
/// benchmark with it.
///
/// ```tondo
/// import std.testing
///
/// test sums {
///     let numbers = (0..1_000).collect()
///     assert(testing.bench("sum 1000", () => numbers.sum()) == 499_500)
/// }
/// ```
pub fn bench[T, E, F: CallMut[fn(): T ! E]](name: String, body: F): T ! E

/// Uses the value, so that the optimizer keeps the work that made it.
pub fn keep[T](value: T)

/// How many times a run of `body` allocates, on the heap and in regions,
/// in the task that calls it, in the build the tests have, which is
/// optimized: a test that keeps a function from allocating more than it
/// does now, whichever of the two the optimizer gives its values. It is the
/// two figures of a benchmark's row added, `allocs/op` and what it says in
/// regions, not `allocs/op` alone, which is the heap's:
/// `testing.heapAllocations` counts that. What the closure gives is kept,
/// so that the optimizer keeps its work; tasks it starts count their own.
///
/// ```tondo
/// import std.testing
///
/// fn receipt(lines: Array[Int]): String {
///     var text = ""
///     for line in lines {
///         text = "{text}{line}\n"
///     }
///     text
/// }
///
/// test theReceiptDoesNotAllocateForEachLine {
///     let lines = [10, 20, 30, 40]
///     assert(testing.allocations(() => receipt(lines)) <= 3)
/// }
/// ```
pub fn allocations[T, F: CallMut[fn(): T]](body: F): Int

/// How many times a run of `body` allocates on the heap alone, as
/// `testing.allocations` counts, without what goes in regions: what a
/// benchmark's row says in `allocs/op`.
///
/// ```tondo
/// import std.testing
///
/// fn squares(count: Int): Int {
///     var values: Array[Int] = []
///     for i in 0..count {
///         values.push(i * i)
///     }
///     values.length()
/// }
///
/// test squaresStayOffTheHeap {
///     assert(testing.heapAllocations(() => squares(100)) == 0)
/// }
/// ```
pub fn heapAllocations[T, F: CallMut[fn(): T]](body: F): Int
