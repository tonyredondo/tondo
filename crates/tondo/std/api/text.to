// std.text: the error of text operations (standard library 14.1) and the
// normalization of Unicode (10.1). The methods of `String` and `Char` are
// in the prelude: `tondo api prelude`.

/// Why a text operation failed: an index outside the text, one inside a
/// character, a limit reached, or data that is not UTF-8 or not a number.
pub enum TextError {
    InvalidIndex
    InvalidBoundary
    ResourceLimit
    /// Bytes that are not UTF-8, or text that is not a number.
    InvalidData
}
