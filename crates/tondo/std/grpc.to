        if number != 0 {
            out.int32(1, number)
        }
    }

    fn readFrom(input: __protobuf.Reader): HealthReply ! __protobuf.ProtobufError {
        var reply = HealthReply {}
        for {
            match input.next()? {
                0 => break
                1 => reply.status = match input.int32("status")? {
                    1 => ServingStatus.Serving
                    2 => ServingStatus.NotServing
                    3 => ServingStatus.ServiceUnknown
                    _ => ServingStatus.Unknown
                }
                _ => input.skip()?
            }
        }
        reply
    }

    fn protobufName(): String {
        "grpc.health.v1.HealthCheckResponse"
    }
}

impl __reflect.Reflect for HealthReply {
    fn reflectShow(self, nested: Bool): String {
        "HealthCheckResponse {{ status: {self.status} }}"
    }
}

/// `grpc.health.v1.HealthListRequest`, which asks for nothing.
type HealthListRequest = {}

impl __protobuf.Message for HealthListRequest {
    fn writeTo(self, out: __protobuf.Writer) {}

    fn readFrom(input: __protobuf.Reader): HealthListRequest ! __protobuf.ProtobufError {
        for input.next()? != 0 {
            input.skip()?
        }
        HealthListRequest {}
    }

    fn protobufName(): String {
        "grpc.health.v1.HealthListRequest"
    }
}

impl __reflect.Reflect for HealthListRequest {
    fn reflectShow(self, nested: Bool): String {
        "HealthListRequest {{}}"
    }
}

/// `grpc.health.v1.HealthListResponse`: each service's status.
type HealthList = {
    statuses: Map[String, ServingStatus] = [:]
}

impl __protobuf.Message for HealthList {
    fn writeTo(self, out: __protobuf.Writer) {
        for (service, status) in self.statuses {
            out.message(1, HealthEntry { service, status })
        }
    }

    fn readFrom(input: __protobuf.Reader): HealthList ! __protobuf.ProtobufError {
        var list = HealthList {}
        for {
            match input.next()? {
                0 => break
                1 => {
                    let entry = input.message[HealthEntry]("statuses")?
                    list.statuses[entry.service] = entry.status
                }
                _ => input.skip()?
            }
        }
        list
    }

    fn protobufName(): String {
        "grpc.health.v1.HealthListResponse"
    }
}

impl __reflect.Reflect for HealthList {
    fn reflectShow(self, nested: Bool): String {
        "HealthListResponse {{ {self.statuses.length()} statuses }}"
    }
}

/// An entry of `HealthListResponse.statuses`: a service and its status.
type HealthEntry = {
    service: String = ""
    status: ServingStatus = ServingStatus.Unknown
}

impl __protobuf.Message for HealthEntry {
    fn writeTo(self, out: __protobuf.Writer) {
        out.string(1, self.service)
        out.message(2, HealthReply { status: self.status })
    }

    fn readFrom(input: __protobuf.Reader): HealthEntry ! __protobuf.ProtobufError {
        var entry = HealthEntry {}
        for {
            match input.next()? {
                0 => break
                1 => entry.service = input.string("key")?
                2 => entry.status = input.message[HealthReply]("value")?.status
                _ => input.skip()?
            }
