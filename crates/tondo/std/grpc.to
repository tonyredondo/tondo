        "grpc.health.v1.HealthListResponse.StatusesEntry"
    }
}

/// `grpc/health/v1/health.proto`, as protoc describes it.
fn healthFile(): __protobuf.FileDescriptor {
    __protobuf.FileDescriptor {
        name: "grpc/health/v1/health.proto"
        symbols: [
            "grpc.health.v1.HealthCheckRequest",
            "grpc.health.v1.HealthCheckResponse",
            "grpc.health.v1.HealthCheckResponse.ServingStatus",
            "grpc.health.v1.HealthListRequest",
            "grpc.health.v1.HealthListResponse",
            "grpc.health.v1.Health",
            "grpc.health.v1.Health.Check",
            "grpc.health.v1.Health.List",
            "grpc.health.v1.Health.Watch",
        ]
        bytes: __encoding
            .base64Decode(
                "",
            )
            .unwrapOr([])
    }
}

// ---------------------------------------------------------------------------
// Reflection
// ---------------------------------------------------------------------------

/// Server reflection, as `grpc.reflection.v1` and `v1alpha` give it, which
/// tools as grpcurl read to call a server without its `.proto` files:
/// `app.grpc(grpc.reflection([users, health.service()]))`. It lists these
/// services and gives the files that declare them.
pub fn reflection(services: Array[Service]): Service {
    let names = services.map((service) { service.name })
    var files: Array[__protobuf.FileDescriptor] = []
    for service in services {
        files.extend(service.files)
    }
    let known = flattened(files)
    Service {
        name: "grpc.reflection.v1.ServerReflection"
        methods: [
            Method {
                name: "ServerReflectionInfo"
                handler: (exchange) {
                    bidiStream[ReflectionRequest, ReflectionResponse](
                        exchange,
                        (input, out) {
                            for each in input {
                                out.send(answered(names, known, each?))
                            }
                        },
                    )?
                }
            },
        ]
        also: ["grpc.reflection.v1alpha.ServerReflection"]
    }
}

/// The files and those they import, each once.
fn flattened(files: Array[__protobuf.FileDescriptor]): Array[__protobuf.FileDescriptor] {
    var all: Array[__protobuf.FileDescriptor] = []
    var queue = files
    var at = 0
    for at < queue.length() {
        let file = queue[at]
        at += 1
        if not all.any((known) { known.name == file.name }) {
            all.push(file)
            queue.extend(file.imports)
        }
    }
    all
}

/// What reflection answers a request.
fn answered(
    names: Array[String],
    files: Array[__protobuf.FileDescriptor],
    request: ReflectionRequest,
): ReflectionResponse {
    let missing = (what: String) { Answer.Failure(Int32.wrapping(Code.NotFound.number()), what) }
    let answer = match request.asked {
        Asked.Services(_) => Answer.Services(names)
        Asked.FileByName(name) => match files.find((file) { file.name == name }) {
            some(file) => Answer.Files(flattened([file]).map((each) { each.bytes }))
            none => missing("no file `{name}`")
        }
        Asked.Symbol(symbol) => match files.find((file) { file.symbols.contains(symbol) }) {
            some(file) => Answer.Files(flattened([file]).map((each) { each.bytes }))
            none => missing("no symbol `{symbol}`")
        }
        Asked.ExtensionsOf(name) => if files.any((file) { file.symbols.contains(name) }) {
            Answer.Extensions(name)
        } else {
            missing("no message `{name}`")
        }
        Asked.Extension(name, number) => missing("no extension {number} of `{name}`")
        Asked.Nothing => Answer.Failure(
            Int32.wrapping(Code.InvalidArgument.number()),
            "the request asks nothing",
        )
    }
    ReflectionResponse { host: request.host, original: request, answer }
}

/// What a reflection request asks.
enum Asked {
    Nothing
    FileByName(String)
    Symbol(String)
    Extension(String, Int32)
    ExtensionsOf(String)
    Services(String)
}

/// `grpc.reflection.v1.ServerReflectionRequest`.
type ReflectionRequest = {
    host: String = ""
    asked: Asked = Asked.Nothing
}

impl __protobuf.Message for ReflectionRequest {
    fn writeTo(self, out: __protobuf.Writer) {
        if not self.host.isEmpty() {
            out.string(1, self.host)
        }
        match self.asked {
            Asked.Nothing => {}
            Asked.FileByName(name) => out.string(3, name)
            Asked.Symbol(symbol) => out.string(4, symbol)
            Asked.Extension(name, number) => out.message(5, ExtensionAsked { name, number })
            Asked.ExtensionsOf(name) => out.string(6, name)
            Asked.Services(pattern) => out.string(7, pattern)
        }
    }

    fn readFrom(input: __protobuf.Reader): ReflectionRequest ! __protobuf.ProtobufError {
        var request = ReflectionRequest {}
        for {
            match input.next()? {
                0 => break
                1 => request.host = input.string("host")?
                3 => request.asked = Asked.FileByName(input.string("file_by_filename")?)
                4 => request.asked = Asked.Symbol(input.string("file_containing_symbol")?)
                5 => {
                    let asked = input.message[ExtensionAsked]("file_containing_extension")?
                    request.asked = Asked.Extension(asked.name, asked.number)
                }
                6 => request.asked = Asked.ExtensionsOf(
                    input.string("all_extension_numbers_of_type")?,
                )
                7 => request.asked = Asked.Services(input.string("list_services")?)
                _ => input.skip()?
            }
        }
        request
    }

    fn protobufName(): String {
        "grpc.reflection.v1.ServerReflectionRequest"
    }
}

impl __reflect.Reflect for ReflectionRequest {
    fn reflectShow(self, nested: Bool): String {
        "ServerReflectionRequest"
    }
}

/// `grpc.reflection.v1.ExtensionRequest`.
type ExtensionAsked = {
    name: String = ""
    number: Int32 = 0
}

impl __protobuf.Message for ExtensionAsked {
    fn writeTo(self, out: __protobuf.Writer) {
        out.string(1, self.name)
        out.int32(2, self.number)
    }

    fn readFrom(input: __protobuf.Reader): ExtensionAsked ! __protobuf.ProtobufError {
        var asked = ExtensionAsked {}
        for {
            match input.next()? {
                0 => break
                1 => asked.name = input.string("containing_type")?
                2 => asked.number = input.int32("extension_number")?
                _ => input.skip()?
            }
        }
        asked
    }

    fn protobufName(): String {
        "grpc.reflection.v1.ExtensionRequest"
    }
}

/// What reflection answers.
enum Answer {
    Files(Array[Array[Byte]])
    Extensions(String)
    Services(Array[String])
    Failure(Int32, String)
}

/// `grpc.reflection.v1.ServerReflectionResponse`, which only a server
/// writes.
type ReflectionResponse = {
    host: String = ""
    original: ReflectionRequest = ReflectionRequest {}
    answer: Answer = Answer.Services([])
}

impl __protobuf.Message for ReflectionResponse {
    fn writeTo(self, out: __protobuf.Writer) {
        if not self.host.isEmpty() {
            out.string(1, self.host)
        }
        out.message(2, self.original)
        match self.answer {
            Answer.Files(files) => {
