// std.grpc (standard library 14.41): gRPC over HTTP/2. A service of a
// `.proto` file gives a trait whose methods are its calls, a function that
// makes a server's `Service` of a value that implements it, which
// `App.grpc` serves, and a client. Messages are `std.protobuf`'s, a call's
// failure is a `Status`, and what a call carries besides, its metadata, its
// peer and its deadline, `call()` gives in the method.

import std.encoding as __encoding
import std.gzip as __gzip
import std.http as __http
import std.internal.grpc as grpcNative
import std.io as __io
import std.protobuf as __protobuf
import std.reflect as __reflect
import std.sync as __sync
import std.time as __time

// ---------------------------------------------------------------------------
// Status
// ---------------------------------------------------------------------------

/// The code of a call's status, as gRPC numbers them from 0.
pub enum Code {
    Ok
    Cancelled
    Unknown
    InvalidArgument
    DeadlineExceeded
    NotFound
    AlreadyExists
    PermissionDenied
    ResourceExhausted
    FailedPrecondition
    Aborted
    OutOfRange
    Unimplemented
    Internal
    Unavailable
    DataLoss
    Unauthenticated
}

/// The code's number.
pub fn Code.number(self): Int {
    match self {
        Code.Ok => 0
        Code.Cancelled => 1
        Code.Unknown => 2
        Code.InvalidArgument => 3
        Code.DeadlineExceeded => 4
        Code.NotFound => 5
        Code.AlreadyExists => 6
        Code.PermissionDenied => 7
        Code.ResourceExhausted => 8
        Code.FailedPrecondition => 9
        Code.Aborted => 10
        Code.OutOfRange => 11
        Code.Unimplemented => 12
        Code.Internal => 13
        Code.Unavailable => 14
        Code.DataLoss => 15
        Code.Unauthenticated => 16
    }
}

/// The code of a number, `Unknown` for one gRPC does not have.
pub fn Code.of(number: Int): Code {
    match number {
        0 => Code.Ok
        1 => Code.Cancelled
        3 => Code.InvalidArgument
        4 => Code.DeadlineExceeded
        5 => Code.NotFound
        6 => Code.AlreadyExists
        7 => Code.PermissionDenied
        8 => Code.ResourceExhausted
        9 => Code.FailedPrecondition
        10 => Code.Aborted
        11 => Code.OutOfRange
        12 => Code.Unimplemented
        13 => Code.Internal
        14 => Code.Unavailable
        15 => Code.DataLoss
        16 => Code.Unauthenticated
        _ => Code.Unknown
    }
}

/// The code's name, as `NotFound`.
impl Display for Code {
    fn display(self): String {
        match self {
            Code.Ok => "Ok"
            Code.Cancelled => "Cancelled"
            Code.Unknown => "Unknown"
            Code.InvalidArgument => "InvalidArgument"
            Code.DeadlineExceeded => "DeadlineExceeded"
            Code.NotFound => "NotFound"
            Code.AlreadyExists => "AlreadyExists"
            Code.PermissionDenied => "PermissionDenied"
            Code.ResourceExhausted => "ResourceExhausted"
            Code.FailedPrecondition => "FailedPrecondition"
            Code.Aborted => "Aborted"
            Code.OutOfRange => "OutOfRange"
            Code.Unimplemented => "Unimplemented"
            Code.Internal => "Internal"
            Code.Unavailable => "Unavailable"
            Code.DataLoss => "DataLoss"
            Code.Unauthenticated => "Unauthenticated"
        }
    }
}

/// How a call failed: its code, a message for people and details for
/// programs, as `google.rpc.Status` carries them.
pub type Status = {
    code: Code
    message: String = ""
    details: Array[__protobuf.Any] = []
}

/// `NotFound: no user 7`.
impl Display for Status {
    fn display(self): String {
        if self.message.isEmpty() { "{self.code}" } else { "{self.code}: {self.message}" }
    }
}

/// A failure of the server's own, for `result.mapErr(grpc.Status.from)?`:
/// `Internal`, with the error's text.
pub fn Status.from[E: Display](error: E): Status {
    Status { code: Code.Internal, message: "{error}" }
}

/// `google.rpc.Status`, which `grpc-status-details-bin` carries.
type RpcStatus = {
    code: Int32 = 0
    message: String = ""
    details: Array[__protobuf.Any] = []
}

impl __protobuf.Message for RpcStatus {
    fn writeTo(self, out: __protobuf.Writer) {
        if self.code != 0 {
            out.int32(1, self.code)
        }
        if not self.message.isEmpty() {
            out.string(2, self.message)
        }
        for detail in self.details {
            out.message(3, detail)
        }
    }

    fn readFrom(input: __protobuf.Reader): RpcStatus ! __protobuf.ProtobufError {
        var status = RpcStatus {}
        for {
            match input.next()? {
                0 => break
                1 => status.code = input.int32("code")?
                2 => status.message = input.string("message")?
                3 => status.details.push(input.message[__protobuf.Any]("details")?)
                _ => input.skip()?
            }
        }
        status
    }

    fn protobufName(): String {
        "google.rpc.Status"
    }
}

/// The status a call ended with, from its code, message and trailers.
fn statusOf(code: Int, message: String, trailers: Array[String]): Status {
    var details: Array[__protobuf.Any] = []
    var at = 0
    for at + 1 < trailers.length() {
        if trailers[at] == "grpc-status-details-bin" {
            let decoded = __encoding
                .base64Decode(trailers[at + 1])
                .ok()
                .andThen((bytes) { __protobuf.decode[RpcStatus](bytes).ok() })
            match decoded {
                some(rpc) => details = rpc.details
                none => {}
            }
        }
        at += 2
    }
    Status { code: Code.of(code), message, details }
}

// ---------------------------------------------------------------------------
// Calls as a method sees them
// ---------------------------------------------------------------------------

/// What a call carries besides its messages: the method, as
/// `/users.v1.UserService/Get`, its metadata, the peer's address and the
/// time left before its deadline.
pub type Call = {
    method: String = ""
    metadata: Map[String, String] = [:]
    peer: String = ""
    timeout: __time.Duration? = none
}

context Incoming = {
    call: Call = Call {}
    headers: __http.Trailers? = none
    trailers: __http.Trailers? = none
}

/// The call the running method serves; an empty one outside a method.
pub fn call(): Call {
    Incoming.call
}

/// Sets metadata the server answers with, before its first message.
pub fn setHeader(name: String, value: String) {
    match Incoming.headers {
        some(headers) => headers.set(name, value)
        none => {}
    }
}

/// Sets metadata that follows the server's last message, with the status.
pub fn setTrailer(name: String, value: String) {
    match Incoming.trailers {
        some(trailers) => trailers.set(name, value)
        none => {}
    }
}

// ---------------------------------------------------------------------------
// Servers
// ---------------------------------------------------------------------------

/// A service a server serves: its full name and its methods, which a
/// `.proto` file's service gives as `users.userService(value)`.
pub type Service = {
    name: String
    methods: Array[Method]
    /// The `.proto` file that declares it, which reflection gives.
    files: Array[__protobuf.FileDescriptor] = []
    /// Other names it answers to.
    priv also: Array[String] = []
    priv compressing: Bool = false
    priv layers: Array[fn(Call, fn(): !Status): !Status] = []
    priv watchers: Array[fn(Call, Direction, __reflect.Value)] = []
}

/// A method of a service: its name and what serves it.
pub type Method = {
    name: String
    handler: fn(ServerCall): !Status
}

/// Whether a message was received or sent by the side that sees it.
pub enum Direction {
    Received
    Sent
}

/// `Received` or `Sent`.
impl Display for Direction {
    fn display(self): String {
        match self {
            Direction.Received => "Received"
            Direction.Sent => "Sent"
        }
    }
}

/// Wraps each call of the service: `interceptor` gets the call and `next`,
/// which runs the method in the call's task, so it can refuse the call
/// with `fail`, give the method contexts with `with`, time it or change
/// its status; a panic of the method reaches it as `Internal`. The first
/// added is the outermost.
pub fn Service.onCall(self, interceptor: fn(Call, fn(): !Status): !Status): Service {
    self with { layers: self.layers.concat([interceptor]) }
}

/// Shows `observer` each message of each call, as it is received or sent.
pub fn Service.onMessage(self, observer: fn(Call, Direction, __reflect.Value)): Service {
    self with { watchers: self.watchers.concat([observer]) }
}

/// Compresses the messages the service sends with gzip, to each client
/// that says it reads gzip. Every server reads compressed messages.
pub fn Service.compress(self): Service {
    self with { compressing: true }
}

impl __http.GrpcService for Service {
    fn serveOn(self, app: mut __http.App) {
        for name in [self.name].concat(self.also) {
            for method in self.methods {
                let path = "/{name}/{method.name}"
                let handler = method.handler
                let layers = self.layers
                let watchers = self.watchers
                let compressing = self.compressing
                app.post(
                    path,
                    (request) { serve(request, path, handler, layers, watchers, compressing)? },
                )
            }
        }
    }
}

/// A call being served: the messages it receives and sends.
pub type ServerCall = {
    priv frames: grpcNative.Native
    priv output: __io.Writer
    /// Set once the server's headers are to be sent.
    priv ready: grpcNative.Native
    priv watchers: Array[fn(Call, Direction, __reflect.Value)]
    /// Whether it sends its messages compressed with gzip.
    priv compressed: Bool
    priv wire: Wire
}

/// How a call travels: as gRPC, whose status goes in HTTP trailers, or as
/// gRPC-Web, which browsers send and whose status ends the body, in bytes
/// or in Base64 text.
enum Wire {
    Grpc
    Web
    WebText
}

/// The wire of a request's content type.
fn Wire.of(contentType: String): Wire {
    if contentType.startsWith("application/grpc-web-text") {
        Wire.WebText
    } else if contentType.startsWith("application/grpc-web") {
        Wire.Web
    } else {
        Wire.Grpc
    }
}

/// The content type of a reply.
fn Wire.contentType(self): String {
    match self {
        Wire.Grpc => "application/grpc"
        Wire.Web => "application/grpc-web+proto"
        Wire.WebText => "application/grpc-web-text+proto"
    }
}

/// Bytes of the reply as the wire sends them: Base64 text for `WebText`,
/// each piece padded, as gRPC-Web's clients read it.
fn Wire.written(self, bytes: Array[Byte]): Array[Byte] {
    match self {
        Wire.WebText => __encoding.base64Encode(bytes).bytes()
        _ => bytes
    }
}

/// Serves a call: runs its method in a task of its own, whose messages go
/// out as it sends them and whose status follows as trailers.
fn serve(
    request: __http.Request,
    path: String,
    handler: fn(ServerCall): !Status,
    layers: Array[fn(Call, fn(): !Status): !Status],
    watchers: Array[fn(Call, Direction, __reflect.Value)],
    compressing: Bool,
): __http.Reply ! __http.Problem {
    let (output, reader) = __io.pipe()
    let headers = __http.Trailers.new()
    let trailers = __http.Trailers.new()
    let ready = grpcNative.signal()
    var metadata = request.headers()
    let wire = Wire.of(metadata.get("content-type").unwrapOr(""))
    let timeout = timeoutOf(metadata.get("grpc-timeout").unwrapOr(""))
    let encoding = metadata.get("grpc-encoding").unwrapOr("identity")
    let accepted = metadata
        .get("grpc-accept-encoding")
        .unwrapOr("")
        .split(",")
        .map((name) { name.trim() })
    let compressed = compressing and accepted.contains("gzip")
    headers.set("grpc-accept-encoding", "gzip")
    if compressed {
        headers.set("grpc-encoding", "gzip")
    }
    for name in [
        "content-type",
        "te",
        "grpc-timeout",
        "grpc-encoding",
        "grpc-accept-encoding",
        "user-agent",
        "x-grpc-web",
        "x-user-agent",
    ] {
        _ = metadata.remove(name)
    }
    let incoming = Call { method: path, metadata, peer: request.remoteAddress(), timeout }
    let frames = grpcNative.frames(request.body(), encoding, wire == Wire.WebText)
    let server = ServerCall { frames, output, ready, watchers, compressed, wire }
    with Incoming { call: incoming, headers: some(headers), trailers: some(trailers) }
    spawn detached run(server, handler, layers, timeout, trailers)
    // The headers go once the method sends its first message, or ends.
    _ = grpcNative.signalWait(ready)
    var reply = __http.Reply.stream(
        reader,
        contentType: wire.contentType(),
        trailers: if wire == Wire.Grpc { some(trailers) } else { none },
    )
    for (name, value) in headers.all() {
        reply = reply.header(name, value)
    }
    reply
}

fn run(
    server: ServerCall,
    handler: fn(ServerCall): !Status,
    layers: Array[fn(Call, fn(): !Status): !Status],
    timeout: __time.Duration?,
    trailers: __http.Trailers,
) {
    // A client that goes cancels the method, as it would a handler.
    grpcNative.follow(server.output)
    // With interceptors, a panic of the method is a status inside them,
    // so one that reaches here is theirs.
    let who = if layers.isEmpty() { "the method" } else { "an interceptor" }
    let outcome = match recover { served(server, handler, layers, timeout) } {
        ok(status) => status
        err(failure) => panicked(who, failure.message)
    }
    trailers.set("grpc-status", "{outcome.code.number()}")
    if not outcome.message.isEmpty() {
        trailers.set("grpc-message", percentEncoded(outcome.message))
    }
    if not outcome.details.isEmpty() {
        let rpc = RpcStatus {
            code: Int32.wrapping(outcome.code.number())
            message: outcome.message
            details: outcome.details
        }
        trailers.set(
            "grpc-status-details-bin",
            __encoding.base64Encode(__protobuf.encode(rpc)).trimEnd("="),
        )
    }
    server.start()
    if server.wire != Wire.Grpc {
        // gRPC-Web's trailers are a frame of their own at the end of the
        // body, flagged with 0x80, as HTTP/1 writes headers.
        var block = ""
        for (name, value) in trailers.all() {
            block = "{block}{name.toLower()}: {value}\r\n"
        }
        let flag: Array[Byte] = [0x80]
        let bytes = block.bytes()
        let frame = flag.concat(UInt32.wrapping(bytes.length()).toBytes()).concat(bytes)
        _ = server.output.writeBytes(server.wire.written(frame))
    }
    _ = server.output.close()
}

/// The status of a call whose code panicked.
fn panicked(who: String, message: String): Status {
    Status { code: Code.Internal, message: "{who} panicked: {message}" }
}

/// What a method gave through the interceptors, within the call's deadline.
fn served(
    server: ServerCall,
    handler: fn(ServerCall): !Status,
    layers: Array[fn(Call, fn(): !Status): !Status],
    timeout: __time.Duration?,
): Status {
    let outcome: !Status = match timeout {
        some(limit) => match within limit { intercepted(layers, 0, server, handler) } {
            ok(_) => ok(())
            err(failure) => match failure {
                Status(status) => err(status)
                _ =>
                    err(Status {
                        code: Code.DeadlineExceeded
                        message: "the call's deadline passed"
                    })
            }
        }
        none => intercepted(layers, 0, server, handler)
    }
    match outcome {
        ok(_) => Status { code: Code.Ok }
        err(status) => status
    }
}

/// The method through the interceptors from the one at `at` on.
fn intercepted(
    layers: Array[fn(Call, fn(): !Status): !Status],
    at: Int,
    server: ServerCall,
    handler: fn(ServerCall): !Status,
): !Status {
    if at == layers.length() {
        if at == 0 {
            handler(server)?
            return
        }
        // The interceptors see a panic of the method as its status.
        match recover { handler(server) } {
            ok(outcome) => outcome?
            err(failure) => fail panicked("the method", failure.message)
        }
        return
    }
    let layer = layers[at]
    layer(Incoming.call, () { intercepted(layers, at + 1, server, handler)? })?
}

/// Lets the server's headers go.
fn ServerCall.start(self) {
    grpcNative.signalSet(self.ready)
}

/// Shows a message to those who watch the call's messages.
fn watched[T: __reflect.Reflect](
    watchers: Array[fn(Call, Direction, __reflect.Value)],
    rpc: Call,
    direction: Direction,
    message: T,
) {
    if not watchers.isEmpty() {
        let value = __reflect.valueOf(message)
        for watcher in watchers {
            watcher(rpc, direction, value)
        }
    }
}

/// The next message of the call, or `none` after the client's last.
pub fn ServerCall.receive[T: __protobuf.Message + __reflect.Reflect](self): T? ! Status {
    match grpcNative.readFrame(self.frames) {
        1 => match __protobuf.decode[T](grpcNative.frame(self.frames)) {
            ok(message) => {
                watched(self.watchers, Incoming.call, Direction.Received, message)
                some(message)
            }
            err(error) => fail Status {
                code: Code.InvalidArgument
                message: "the request is not a `{__protobuf.Message.protobufName[T]()}`: {error}"
            }
        }
        0 => none
        -2 => fail Status { code: Code.Unimplemented, message: grpcNative.frameError(self.frames) }
        -3 => fail Status {
            code: Code.ResourceExhausted
            message: grpcNative.frameError(self.frames)
        }
        _ => fail Status { code: Code.InvalidArgument, message: grpcNative.frameError(self.frames) }
    }
}

/// Sends a message to the client.
pub fn ServerCall.send[T: __protobuf.Message + __reflect.Reflect](self, message: T): !Status {
    self.start()
    watched(self.watchers, Incoming.call, Direction.Sent, message)
    let bytes = __protobuf.encode(message)
    match self.output.writeBytes(self.wire.written(framed(bytes, self.compressed))) {
        ok(_) => {}
        err(error) => fail Status { code: Code.Cancelled, message: "the client is gone: {error}" }
    }
}

/// A message as gRPC frames it: whether it is compressed, its length and
/// its bytes.
fn framed(bytes: Array[Byte], compressed: Bool): Array[Byte] {
    let message = if compressed { __gzip.compress(bytes) } else { bytes }
    let flag: Array[Byte] = [if compressed { 1 } else { 0 }]
    flag.concat(UInt32.wrapping(message.length()).toBytes()).concat(message)
}

/// A unary method: one request, one reply.
pub fn unary[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](exchange: ServerCall, method: fn(In): Out ! Status): !Status {
    let request = match exchange.receive[In]()? {
        some(request) => request
        none => fail Status { code: Code.InvalidArgument, message: "the call has no request" }
    }
    exchange.send(method(request)?)?
}

/// A method that sends a stream: one request, and replies as it sends them.
pub fn serverStream[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](exchange: ServerCall, method: fn(In, Sender[Out]): !Status): !Status {
    let request = match exchange.receive[In]()? {
        some(request) => request
        none => fail Status { code: Code.InvalidArgument, message: "the call has no request" }
    }
    let (sender, replies) = channel[Out](capacity: 16, discardWhenAbandoned: true)
    forward(exchange, replies, spawn method(request, sender))?
}

/// A method that receives a stream: the requests, and one reply.
pub fn clientStream[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](exchange: ServerCall, method: fn(Stream[In]): Out ! Status): !Status {
    exchange.send(method(Stream[In] { source: Source.Server(exchange) })?)?
}

/// A method that receives a stream and sends one.
pub fn bidiStream[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](exchange: ServerCall, method: fn(Stream[In], Sender[Out]): !Status): !Status {
    let (sender, replies) = channel[Out](capacity: 16, discardWhenAbandoned: true)
    forward(exchange, replies, spawn method(Stream[In] { source: Source.Server(exchange) }, sender))?
}

/// Sends the replies a method gives as it gives them; when the client is
/// gone, the method is cancelled.
fn forward[Out: __protobuf.Message + __reflect.Reflect](
    exchange: ServerCall,
    replies: Receiver[Out],
    sending: Join[!Status],
): !Status {
    for reply in replies {
        match exchange.send(reply) {
            ok(_) => {}
            err(status) => {
                sending.cancel()
                fail status
            }
        }
    }
    sending.wait()?
}

/// The duration of `grpc-timeout`: digits and a unit, `100m`.
fn timeoutOf(text: String): __time.Duration? {
    if text.length() < 2 {
        return none
    }
    let amount = Int.parse(text.slice(0, text.length() - 1).unwrapOr("")).ok()?
    match text.slice(text.length() - 1, text.length()).unwrapOr("") {
        "H" => some(__time.seconds(amount * 3600))
        "M" => some(__time.seconds(amount * 60))
        "S" => some(__time.seconds(amount))
        "m" => some(__time.milliseconds(amount))
        "u" => some(__time.microseconds(amount))
        "n" => some(__time.nanoseconds(amount))
        _ => none
    }
}

/// `grpc-timeout` for the time left: at most eight digits of the finest
/// unit that holds it, rounded up, so that the server's deadline is not
/// before the client's.
fn timeoutText(left: __time.Duration): String {
    var amount = left.nanoseconds().max(1)
    for (unit, next) in [("n", 1000), ("u", 1000), ("m", 1000), ("S", 60), ("M", 60)] {
        if amount < 100_000_000 {
            return "{amount}{unit}"
        }
        amount = (amount + next - 1) / next
    }
    "{amount.min(99_999_999)}H"
}

/// `grpc-message`, percent-encoded as gRPC writes it.
fn percentEncoded(text: String): String {
    var out = ""
    for byte in text.bytes() {
        let value = Int(byte)
        out = if value >= 0x20 and value <= 0x7e and value != 0x25 {
            "{out}{Char.from(value).unwrapOr('?')}"
        } else {
            "{out}%{value.toString(16).padStart(2, "0").toUpper()}"
        }
    }
    out
}

// ---------------------------------------------------------------------------
// Streams of messages
// ---------------------------------------------------------------------------

enum Source {
    Server(ServerCall)
    Client(Outgoing)
}

/// The messages of a stream, each as it arrives: `for each in stream { let
/// message = each? }`. A failure ends it.
pub type Stream[T] = {
    priv source: Source
    priv ended: Bool = false
}

impl[T: __protobuf.Message + __reflect.Reflect] Iterator[T ! Status] for Stream[T] {
    fn next(mut self): (T ! Status)? {
        if self.ended {
            return none
        }
        let outcome = match self.source {
            Source.Server(exchange) => exchange.receive[T]()
            Source.Client(outgoing) => outgoing.received[T]()
        }
        match outcome {
            ok(some(message)) => some(ok(message))
            ok(none) => {
                self.ended = true
                none
            }
            err(status) => {
                self.ended = true
                some(err(status))
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

/// How a client compresses the messages it sends; every client reads
/// compressed ones.
pub enum Compression {
    None
    Gzip
}

/// A connection to a server, which its calls share: `http://host:port`, or
/// `https://host:port` for TLS, which trusts the system's authorities and,
/// as the HTTP client does, those of `trust`; `certificate` and `key`
/// show the server who the client is, and `compression` compresses what it
/// sends.
pub type Channel = {
    priv native: grpcNative.Native
    priv target: String
    priv compression: Compression = Compression.None
    priv layers: Array[fn(Call, fn(Call): !Status): !Status] = []
    priv watchers: Array[fn(Call, Direction, __reflect.Value)] = []
}

/// A channel to a server, which connects with its first call.
pub fn connect(
    target: String,
    trust: String = "",
    certificate: String = "",
    key: String = "",
    compression: Compression = Compression.None,
): Channel ! Status {
    let native = grpcNative.channel(target, trust, certificate, key)
    let problem = grpcNative.channelError(native)
    if not problem.isEmpty() {
        fail Status { code: Code.InvalidArgument, message: problem }
    }
    Channel { native, target: target.removePrefix("https://").removePrefix("http://"), compression }
}

/// Wraps each call the channel makes: `interceptor` gets the call and
/// `next`, which makes it with the metadata and deadline of the `Call` it
/// is given and gives its status when it ends. A unary call runs the
/// interceptors in the caller's task and fails as they do; a stream runs
/// them in a task of their own, with the caller's contexts, while the
/// caller reads the call `next` made. The first added is the outermost.
pub fn Channel.onCall(self, interceptor: fn(Call, fn(Call): !Status): !Status): Channel {
    self with { layers: self.layers.concat([interceptor]) }
}

/// Shows `observer` each message of each call, as it is sent or received.
pub fn Channel.onMessage(self, observer: fn(Call, Direction, __reflect.Value)): Channel {
    self with { watchers: self.watchers.concat([observer]) }
}

/// A call the client makes: the runtime's, what it is, and who watches its
/// messages.
type Outgoing = {
    native: grpcNative.Native
    call: Call
    watchers: Array[fn(Call, Direction, __reflect.Value)]
}

/// The call of `path` with its metadata, and the time left before the
/// running `within`'s deadline.
fn Channel.callOf(self, path: String, metadata: Map[String, String]): Call {
    Call { method: path, metadata, peer: self.target, timeout: __time.remaining() }
}

/// The headers of a call: its metadata, and its deadline as `grpc-timeout`.
fn headersOf(rpc: Call): Array[String] {
    var headers: Array[String] = []
    for (name, value) in rpc.metadata {
        headers.extend([name.toLower(), value])
    }
    match rpc.timeout {
        some(left) => headers.extend(["grpc-timeout", timeoutText(left)])
        none => {}
    }
    headers
}

/// What a call starts with: its one request, as bytes and as those who
/// watch messages see it; none for a call whose requests follow.
type Opening = {
    message: Array[Byte] = []
    single: Bool = false
    shown: __reflect.Value? = none
}

/// A call's one request.
fn Channel.opening[T: __protobuf.Message + __reflect.Reflect](self, request: T): Opening {
    let shown: __reflect.Value? = if self.watchers.isEmpty() {
        none
    } else {
        some(__reflect.valueOf(request))
    }
    Opening { message: __protobuf.encode(request), single: true, shown }
}

/// Makes a call, showing its request as sent.
fn Channel.open(self, rpc: Call, opening: Opening, slot: grpcNative.Native?): grpcNative.Native {
    match opening.shown {
        some(value) => {
            for watcher in self.watchers {
                watcher(rpc, Direction.Sent, value)
            }
        }
        none => {}
    }
    var headers = headersOf(rpc)
    // The runtime compresses a call's messages when it says so.
    match self.compression {
        Compression.Gzip => headers.extend(["grpc-encoding", "gzip"])
        Compression.None => {}
    }
    match slot {
        some(into) => grpcNative.open(
            into,
            self.native,
            rpc.method,
            headers,
            opening.message,
            opening.single,
        )
        none => grpcNative.start(self.native, rpc.method, headers, opening.message, opening.single)
    }
}

/// Starts a call. Through interceptors, they run in a task of their own
/// and the call is the one their `next` made.
fn Channel.started(self, rpc: Call, opening: Opening): Outgoing {
    let native = if self.layers.isEmpty() {
        self.open(rpc, opening, none)
    } else {
        let slot = grpcNative.slot()
        spawn detached self.intercepted(slot, rpc, opening)
        grpcNative.take(slot)
    }
    Outgoing { native, call: rpc, watchers: self.watchers }
}

/// Runs the interceptors around `next`, which makes the call into the
/// slot; when they make none, the caller's call ends as they did.
fn Channel.intercepted(self, slot: grpcNative.Native, rpc: Call, opening: Opening): !Status {
    let outcome = match recover { self.layered(0, slot, rpc, opening) } {
        ok(outcome) => outcome
        err(failure) => err(panicked("an interceptor", failure.message))
    }
    match outcome {
        ok(_) => grpcNative.close(slot, Code.Internal.number(), "the interceptors made no call")
        err(status) => grpcNative.close(slot, status.code.number(), status.message)
    }
    outcome?
}

/// The call through the interceptors from the one at `at` on.
fn Channel.layered(self, at: Int, slot: grpcNative.Native, rpc: Call, opening: Opening): !Status {
    if at == self.layers.length() {
        let ended = grpcNative.ended(self.open(rpc, opening, some(slot)))
        let code = Int.parse(ended[0]).unwrapOr(2)
        if code != 0 {
            fail statusOf(code, ended[1], ended.drop(2))
        }
        return
    }
    let layer = self.layers[at]
    let connection = self
    layer(rpc, (next) { connection.layered(at + 1, slot, next, opening)? })?
}

/// The next message a call receives, `none` after the last, or its status
/// when it failed.
fn Outgoing.received[T: __protobuf.Message + __reflect.Reflect](self): T? ! Status {
    match grpcNative.next(self.native) {
        1 => match __protobuf.decode[T](grpcNative.message(self.native)) {
            ok(message) => {
                watched(self.watchers, self.call, Direction.Received, message)
                some(message)
            }
            err(error) => fail Status {
                code: Code.Internal
                message: "the reply is not a `{__protobuf.Message.protobufName[T]()}`: {error}"
            }
        }
        0 => {
            self.ended()?
            none
        }
        _ => fail Status { code: Code.Cancelled, message: "the call was cancelled" }
    }
}

/// Fails with the status of a call that ended, once it ended.
fn Outgoing.ended(self): !Status {
    let code = grpcNative.code(self.native)
    if code != 0 {
        fail statusOf(code, grpcNative.detail(self.native), grpcNative.trailers(self.native))
    }
}

/// Sends a message; a call that ended fails with its status.
fn Outgoing.send[T: __protobuf.Message + __reflect.Reflect](self, message: T): !Status {
    watched(self.watchers, self.call, Direction.Sent, message)
    if not grpcNative.send(self.native, __protobuf.encode(message)) {
        // What arrived before the status does not matter any more.
        for grpcNative.next(self.native) == 1 {}
        self.ended()?
        fail Status { code: Code.Cancelled, message: "the call ended" }
    }
}

/// The one reply of a call, and then its status.
fn Outgoing.reply[T: __protobuf.Message + __reflect.Reflect](self): T ! Status {
    let reply = match self.received[T]()? {
        some(reply) => reply
        none => fail Status { code: Code.Internal, message: "the server sent no reply" }
    }
    _ = self.received[T]()?
    reply
}

/// A unary call: one request, one reply.
pub fn Channel.unary[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](self, path: String, request: In, metadata: Map[String, String] = [:]): Out ! Status {
    let rpc = self.callOf(path, metadata)
    let opening = self.opening(request)
    if self.layers.isEmpty() {
        return self.started(rpc, opening).reply[Out]()?
    }
    // The interceptors run here, and their failure is the call's.
    let slot = grpcNative.slot()
    self.intercepted(slot, rpc, opening)?
    Outgoing { native: grpcNative.take(slot), call: rpc, watchers: self.watchers }.reply[Out]()?
}

/// A call that receives a stream: one request, and the replies.
pub fn Channel.serverStream[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](self, path: String, request: In, metadata: Map[String, String] = [:]): Stream[Out] {
    let rpc = self.callOf(path, metadata)
    Stream[Out] { source: Source.Client(self.started(rpc, self.opening(request))) }
}

/// A call that sends a stream: `send` each request, then `finish` for the
/// reply.
pub type Upload[In, Out] = {
    priv outgoing: Outgoing
}

/// A call that sends a stream of requests and receives one reply.
pub fn Channel.clientStream[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](self, path: String, metadata: Map[String, String] = [:]): Upload[In, Out] {
    Upload[In, Out] { outgoing: self.started(self.callOf(path, metadata), Opening {}) }
}

/// Sends a request; a call that ended fails with its status.
pub fn Upload[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
].send(self, message: In): !Status {
    self.outgoing.send(message)?
}

/// Says the requests are all sent, and gives the reply.
pub fn Upload[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
].finish(self): Out ! Status {
    grpcNative.closeSend(self.outgoing.native)
    self.outgoing.reply[Out]()?
}

/// A call that sends and receives streams: `send` requests, `closeSend`
/// after the last, and read the replies as a `Stream`.
pub type Duplex[In, Out] = {
    priv outgoing: Outgoing
}

/// A call that sends a stream of requests and receives a stream of replies.
pub fn Channel.bidiStream[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](self, path: String, metadata: Map[String, String] = [:]): Duplex[In, Out] {
    Duplex[In, Out] { outgoing: self.started(self.callOf(path, metadata), Opening {}) }
}

/// Sends a request; a call that ended fails with its status.
pub fn Duplex[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
].send(self, message: In): !Status {
    self.outgoing.send(message)?
}

/// Says the requests are all sent.
pub fn Duplex[In, Out].closeSend(self) {
    grpcNative.closeSend(self.outgoing.native)
}

/// The replies, as they arrive.
pub fn Duplex[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
].replies(self): Stream[Out] {
    Stream[Out] { source: Source.Client(self.outgoing) }
}

/// The metadata the server answered with, once its first message or its
/// status came.
pub fn Duplex[In, Out].headers(self): Map[String, String] {
    pairs(grpcNative.headers(self.outgoing.native))
}

/// The metadata that followed the server's last message, once the replies
/// ended; the status is not among it.
pub fn Duplex[In, Out].trailers(self): Map[String, String] {
    var all = pairs(grpcNative.trailers(self.outgoing.native))
    for name in ["grpc-status", "grpc-message", "grpc-status-details-bin"] {
        _ = all.remove(name)
    }
    all
}

fn pairs(list: Array[String]): Map[String, String] {
    var all: Map[String, String] = [:]
    var at = 0
    for at + 1 < list.length() {
        all[list[at]] = list[at + 1]
        at += 2
    }
    all
}

// ---------------------------------------------------------------------------
// Health
// ---------------------------------------------------------------------------

/// Whether a server serves a service, as `grpc.health.v1` tells it.
pub enum ServingStatus {
    Unknown
    Serving
    NotServing
    /// A service the server does not know, which only a watch gives.
    ServiceUnknown
}

/// The status's name, as `NotServing`.
impl Display for ServingStatus {
    fn display(self): String {
        match self {
            ServingStatus.Unknown => "Unknown"
            ServingStatus.Serving => "Serving"
            ServingStatus.NotServing => "NotServing"
            ServingStatus.ServiceUnknown => "ServiceUnknown"
        }
    }
}

/// The health a server tells of itself and its services, as
/// `grpc.health.v1` asks it, which load balancers and orchestrators read:
/// `app.grpc(health.service())`, then `health.set("users.v1.UserService",
/// grpc.ServingStatus.NotServing)` as it changes. The server, `""`,
/// starts `Serving`.
pub type Health = {
    priv statuses: __sync.Mutex[Map[String, ServingStatus]]
}

/// Health whose server serves, and no service yet.
pub fn Health.new(): Health {
    var statuses: Map[String, ServingStatus] = [:]
    statuses[""] = ServingStatus.Serving
    Health { statuses: __sync.Mutex(statuses) }
}

/// Sets a service's status, by its full name, or the server's, `""`;
/// those who watch it get the new one.
pub fn Health.set(self, service: String, status: ServingStatus) {
    self.statuses.update(
        (all) {
            all[service] = status
        },
    )
}

/// The service `grpc.health.v1.Health`: `Check` gives a status, or
/// `NotFound` for a service it does not know, `List` gives them all, and
/// `Watch` gives one, then each change.
pub fn Health.service(self): Service {
    let statuses = self.statuses
    Service {
        name: "grpc.health.v1.Health"
        methods: [
            Method {
                name: "Check"
                handler: (exchange) {
                    unary[HealthRequest, HealthReply](
                        exchange,
                        (request) { checked(statuses, request.service)? },
                    )?
                }
            },
            Method {
                name: "List"
                handler: (exchange) {
                    unary[HealthListRequest, HealthList](
                        exchange,
                        (_) { HealthList { statuses: statuses.get() } },
                    )?
                }
            },
            Method {
                name: "Watch"
                handler: (exchange) {
                    serverStream[HealthRequest, HealthReply](
                        exchange,
                        (request, out) { followed(statuses, request.service, out) },
                    )?
                }
            },
        ]
        files: [healthFile()]
    }
}

fn checked(
    statuses: __sync.Mutex[Map[String, ServingStatus]],
    service: String,
): HealthReply ! Status {
    match statuses.get().get(service) {
        some(status) => HealthReply { status }
        none => fail Status {
            code: Code.NotFound
            message: "the server has no service `{service}`"
        }
    }
}

/// Sends a service's status, then each change, until the client goes.
fn followed(
    statuses: __sync.Mutex[Map[String, ServingStatus]],
    service: String,
    out: Sender[HealthReply],
) {
    var last: ServingStatus? = none
    for {
        let before = last
        let now = statuses.updateWhen(
            (all) { some(all.get(service).unwrapOr(ServingStatus.ServiceUnknown)) != before },
            (all) { all.get(service).unwrapOr(ServingStatus.ServiceUnknown) },
        )
        out.send(HealthReply { status: now })
        last = some(now)
    }
}

/// `grpc.health.v1.HealthCheckRequest`.
type HealthRequest = {
    service: String = ""
}

impl __protobuf.Message for HealthRequest {
    fn writeTo(self, out: __protobuf.Writer) {
        if not self.service.isEmpty() {
            out.string(1, self.service)
        }
    }

    fn readFrom(input: __protobuf.Reader): HealthRequest ! __protobuf.ProtobufError {
        var request = HealthRequest {}
        for {
            match input.next()? {
                0 => break
                1 => request.service = input.string("service")?
