// The prelude (standard library 14.1): the methods of the intrinsic types,
// which every program has without importing anything, and the traits that
// order and add values.

import std.internal.math as mathNative
import std.internal.reflect as reflectNative
import std.internal.text as textNative
import std.math as __math
import std.panics as __panics
import std.text as __text

/// A panic that a `recover` stopped (language 15.9): its code, message,
/// data, location and stack.
pub alias Panic = __panics.Panic

// ---------------------------------------------------------------------------
// Order and sums
// ---------------------------------------------------------------------------

/// A type whose values are in order: `compare` is negative, zero or
/// positive as `self` goes before, with or after `other`.
pub trait Ordered {
    fn compare(self, other: Self): Int
}

/// A type whose values add and subtract, from a zero: `a + b`, `a - b`
/// and `values.sum()` (language 18.10). Every number is one, and so is a
/// duration; a program's type, as an amount of money, may be one too.
pub trait Additive {
    fn zero(): Self

    fn plus(self, other: Self): Self

    fn minus(self, other: Self): Self
}

/// A type whose values also multiply and divide, and that integer literals
/// write: `a * b`, `a / b` and `x * 2`. Every number is one; a program's
/// type, as a decimal or a fraction, may be one too.
pub trait Number: Additive {
    fn one(): Self

    fn fromInt(value: Int): Self

    fn times(self, other: Self): Self

    fn dividedBy(self, other: Self): Self
}

/// The language's integers, of every width: on a `T: Integer`, generic code
/// has everything a concrete integer has. A program does not implement it.
pub trait Integer: Number + Ordered + Display {}

fn order[T: Ordered](a: T, b: T): Int {
    a.compare(b)
}

/// Negative, zero or positive as `self` goes before, with or after `other`,
/// by Unicode scalar values.
pub fn String.compare(self, other: String): Int {
    Ordered.compare(self, other)
}

/// Negative, zero or positive as `self` goes before, with or after `other`.
pub fn Char.compare(self, other: Char): Int {
    Ordered.compare(self, other)
}

impl Ordered for Int {
    fn compare(self, other: Int): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for Int8 {
    fn compare(self, other: Int8): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for Int16 {
    fn compare(self, other: Int16): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for Int32 {
    fn compare(self, other: Int32): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for UInt8 {
    fn compare(self, other: UInt8): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for UInt16 {
    fn compare(self, other: UInt16): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for UInt32 {
    fn compare(self, other: UInt32): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for UInt {
    fn compare(self, other: UInt): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for Int128 {
    fn compare(self, other: Int128): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for UInt128 {
    fn compare(self, other: UInt128): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for Byte {
    fn compare(self, other: Byte): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for Char {
    fn compare(self, other: Char): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for String {
    fn compare(self, other: String): Int {
        if self < other { -1 } else if self > other { 1 } else { 0 }
    }
}

impl Ordered for Bool {
    fn compare(self, other: Bool): Int {
        if self == other { 0 } else if self { 1 } else { -1 }
    }
}

/// Floats in total order: `NaN` after every other value, and equal to itself.
impl Ordered for Float {
    fn compare(self, other: Float): Int {
        if self < other {
            -1
        } else if self > other {
            1
        } else if self == other {
            0
        } else if self.isNaN() and other.isNaN() {
            0
        } else if self.isNaN() {
            1
        } else {
            -1
        }
    }
}

// ---------------------------------------------------------------------------
// String
// ---------------------------------------------------------------------------

/// The pieces between each `separator`; the characters when it is empty.
pub fn String.split(self, separator: String): Array[String] {
    textNative.split(self, separator)
}

/// The lines, without their `\n` or `\r\n`.
pub fn String.lines(self): Array[String] {
    textNative.lines(self)
}

/// The pieces between runs of whitespace.
pub fn String.words(self): Array[String] {
    textNative.words(self)
}

/// The text written `count` times in a row; empty when `count` is not
/// positive.
pub fn String.repeat(self, count: Int): String {
    textNative.repeat(self, count)
}

/// The text with `fill` before it, repeated and cut, up to `width` scalars.
pub fn String.padStart(self, width: Int, fill: String = " "): String {
    "{padding(self.length(), width, fill)}{self}"
}

/// The text with `fill` after it, repeated and cut, up to `width` scalars.
pub fn String.padEnd(self, width: Int, fill: String = " "): String {
    "{self}{padding(self.length(), width, fill)}"
}

fn padding(length: Int, width: Int, fill: String): String {
    let missing = width - length
    if missing <= 0 or fill.length() == 0 {
        return ""
    }
    let repeated = fill.repeat(missing / fill.length() + 1)
    match repeated.slice(0, missing) {
        ok(cut) => cut
        err(_) => repeated
    }
}

// The formats of interpolations, `"{price:>10.2}"` (19.6 of the language),
// which the compiler calls with each option of the format.

/// An integer in `radix` 10, 16, 8 or 2, its digits in uppercase when
/// `upper`, with `0x`, `0o` or `0b` before them when `prefixed`.
fn formatInteger[T: Integer](
    value: T,
    radix: Int,
    upper: Bool,
    prefixed: Bool,
    plus: Bool,
    zero: Bool,
    width: Int,
    fill: Char,
    align: Char,
): String {
    let written = value.toString(radix: radix)
    var digits = written.removePrefix("-")
    if upper {
        digits = digits.toUpper()
    }
    let prefix = match radix {
        16 if prefixed => "0x"
        8 if prefixed => "0o"
        2 if prefixed => "0b"
        _ => ""
    }
    formatNumber(written.startsWith("-"), prefix, digits, plus, zero, width, fill, align)
}

/// A float with `precision` digits after the point, or as few as read back
/// as the same value when it is negative, in scientific notation when
/// `exponent`, with `E` when `upper`.
fn formatFloat(
    value: Float,
    single: Bool,
    precision: Int,
    exponent: Bool,
    upper: Bool,
    plus: Bool,
    zero: Bool,
    width: Int,
    fill: Char,
    align: Char,
): String {
    var written = textNative.float(value, precision, exponent, single)
    if upper {
        written = written.replace("e", "E")
    }
    let digits = written.removePrefix("-")
    formatNumber(
        written.startsWith("-"),
        "",
        digits,
        plus,
        zero and value.isFinite(),
        width,
        fill,
        align,
    )
}

/// A number's sign, prefix and digits, with zeros between them up to
/// `width` when `zero`, or else filled as `formatText` does.
fn formatNumber(
    negative: Bool,
    prefix: String,
    digits: String,
    plus: Bool,
    zero: Bool,
    width: Int,
    fill: Char,
    align: Char,
): String {
    let sign = if negative { "-" } else if plus { "+" } else { "" }
    if zero {
        let zeros = "0".repeat(width - sign.length() - prefix.length() - digits.length())
        return "{sign}{prefix}{zeros}{digits}"
    }
    formatText("{sign}{prefix}{digits}", -1, width, fill, align)
}

/// A value's text, cut to `precision` characters when it is not negative,
/// and filled with `fill` up to `width` characters, the text to the left
/// when `align` is `<`, to the right when `>`, and centered when `^`.
fn formatText(text: String, precision: Int, width: Int, fill: Char, align: Char): String {
    var cut = text
    if precision >= 0 and text.length() > precision {
        cut = text.slice(0, precision).unwrapOr(text)
    }
    let missing = width - cut.length()
    if missing <= 0 {
        return cut
    }
    let filling = "{fill}"
    match align {
        '>' => "{filling.repeat(missing)}{cut}"
        '^' => "{filling.repeat(missing / 2)}{cut}{filling.repeat(missing - missing / 2)}"
        _ => "{cut}{filling.repeat(missing)}"
    }
}

/// The text without the whitespace at its start.
pub fn String.trimStart(self): String {
    textNative.trimStart(self)
}

/// The text without the whitespace at its end.
pub fn String.trimEnd(self): String {
    textNative.trimEnd(self)
}

/// The text without `prefix` at its start, if it has it.
pub fn String.removePrefix(self, prefix: String): String {
    if not self.startsWith(prefix) {
        return self
    }
    match self.slice(prefix.length(), self.length()) {
        ok(rest) => rest
        err(_) => self
    }
}

/// The text without `suffix` at its end, if it has it.
pub fn String.removeSuffix(self, suffix: String): String {
    if not self.endsWith(suffix) {
        return self
    }
    match self.slice(0, self.length() - suffix.length()) {
        ok(rest) => rest
        err(_) => self
    }
}

/// The scalar index of the last `needle`.
pub fn String.findLast(self, needle: String): Int? {
    let at = textNative.findLast(self, needle)
    if at < 0 { none } else { some(at) }
}

/// How many times `needle` appears, without overlapping.
pub fn String.count(self, needle: String): Int {
    textNative.count(self, needle)
}

/// The text in lowercase, by Unicode's rules.
pub fn String.toLower(self): String {
    textNative.lower(self)
}

/// The text in uppercase, by Unicode's rules.
pub fn String.toUpper(self): String {
    textNative.upper(self)
}

// ---------------------------------------------------------------------------
// Char
// ---------------------------------------------------------------------------

/// Whether it is one of `0` to `9`.
pub fn Char.isDigit(self): Bool {
    textNative.charIs(self, 0)
}

/// Whether the scalar is a letter of any script, as Unicode's `Alphabetic`.
pub fn Char.isLetter(self): Bool {
    textNative.charIs(self, 1)
}

/// Whether the scalar is whitespace, as Unicode's `White_Space`.
pub fn Char.isWhitespace(self): Bool {
    textNative.charIs(self, 2)
}

/// Whether the scalar is uppercase, as Unicode's `Uppercase`.
pub fn Char.isUpper(self): Bool {
    textNative.charIs(self, 3)
}

/// Whether the scalar is lowercase, as Unicode's `Lowercase`.
pub fn Char.isLower(self): Bool {
    textNative.charIs(self, 4)
}

/// Whether the scalar is a letter or a number of any script.
pub fn Char.isAlphanumeric(self): Bool {
    textNative.charIs(self, 5)
}

/// The uppercase scalar, when it is a single one.
pub fn Char.toUpper(self): Char {
    textNative.charCase(self, true)
}

/// The lowercase scalar, when it is a single one.
pub fn Char.toLower(self): Char {
    textNative.charCase(self, false)
}

/// The Unicode scalar value.
pub fn Char.code(self): Int {
    textNative.charCode(self)
}

/// The scalar with this Unicode value, if it is one.
pub fn Char.from(code: Int): Char? {
    if textNative.charValid(code) { some(textNative.charFrom(code)) } else { none }
}

// ---------------------------------------------------------------------------
// Numbers: their operations are intrinsics (language 18.9)
// ---------------------------------------------------------------------------

/// Which byte of a number comes first: the highest, as networks send it,
/// or the lowest, as most processors keep it.
pub enum ByteOrder {
    Big
    Little
}

// ---------------------------------------------------------------------------
// Option and Result
// ---------------------------------------------------------------------------

/// Whether there is a value.
pub fn Option[T].isSome(self): Bool {
    match self {
        some(_) => true
        none => false
    }
}

/// Whether there is no value.
pub fn Option[T].isNone(self): Bool {
    not self.isSome()
}

/// The function's result for the value, or `none` when there is none.
pub fn Option[T].map[U](self, transform: fn(T): U): U? {
    match self {
        some(value) => some(transform(value))
        none => none
    }
}

/// The option the function gives for the value, or `none`.
pub fn Option[T].andThen[U](self, next: fn(T): U?): U? {
    match self {
        some(value) => next(value)
        none => none
    }
}

/// The value, or `fallback` when there is none.
pub fn Option[T].unwrapOr(self, fallback: T): T {
    match self {
        some(value) => value
        none => fallback
    }
}

/// This option if it has a value, or `other`.
pub fn Option[T].orElse(self, other: T?): T? {
    match self {
        some(value) => some(value)
        none => other
    }
}

/// The value when it passes the test, or `none`.
pub fn Option[T].filter(self, keep: fn(T): Bool): T? {
    match self {
        some(value) if keep(value) => some(value)
        _ => none
    }
}

/// The value, or the error when there is none.
pub fn Option[T].okOr[E](self, error: E): T ! E {
    match self {
        some(value) => value
        none => fail error
    }
}

/// The value; a `none` panics with the message.
pub fn Option[T].expect(self, message: String): T {
    match self {
        some(value) => value
        none => panic(message)
    }
}

/// Whether it holds a value.
pub fn Result[T, E].isOk(self): Bool {
    match self {
        ok(_) => true
        err(_) => false
    }
}

/// Whether it holds an error.
pub fn Result[T, E].isErr(self): Bool {
    not self.isOk()
}

/// The function's result for the value, or the same error.
pub fn Result[T, E].map[U](self, transform: fn(T): U): U ! E {
    match self {
        ok(value) => transform(value)
        err(error) => fail error
    }
}

/// The same value, or the function's result for the error.
pub fn Result[T, E].mapErr[F](self, transform: fn(E): F): T ! F {
    match self {
        ok(value) => value
        err(error) => fail transform(error)
    }
}

/// The result the function gives for the value, or the error.
pub fn Result[T, E].andThen[U](self, next: fn(T): U ! E): U ! E {
    match self {
        ok(value) => next(value)?
        err(error) => fail error
    }
}

/// The value, or `fallback` when it holds an error.
pub fn Result[T, E].unwrapOr(self, fallback: T): T {
    match self {
        ok(value) => value
        err(_) => fallback
    }
}

/// The value, or `none` when it holds an error.
pub fn Result[T, E].ok(self): T? {
    match self {
        ok(value) => some(value)
        err(_) => none
    }
}

/// The error, or `none` when it holds a value.
pub fn Result[T, E].err(self): E? {
    match self {
        ok(_) => none
        err(error) => some(error)
    }
}

/// The value; an error panics with the message and the error.
pub fn Result[T, E].expect(self, message: String): T {
    match self {
        ok(value) => value
        err(error) => panic("{message}: {reflectNative.describe(error)}")
    }
}

// ---------------------------------------------------------------------------
// Array
// ---------------------------------------------------------------------------

/// The first element, or `none` when the array is empty.
pub fn Array[T].first(self): T? {
    self.get(0)
}

/// The last element, or `none` when the array is empty.
pub fn Array[T].last(self): T? {
    self.get(self.length() - 1)
}

/// The function's result for each element, in order.
pub fn Array[T].map[U](self, transform: fn(T): U): Array[U] {
    var out: Array[U] = []
    for item in self {
        out.push(transform(item))
    }
    out
}

/// The elements that pass the test, in order.
pub fn Array[T].filter(self, keep: fn(T): Bool): Array[T] {
    var out: Array[T] = []
    for item in self {
        if keep(item) {
            out.push(item)
        }
    }
    out
}

/// The elements of the arrays the function gives for each element, in
/// order.
pub fn Array[T].flatMap[U](self, transform: fn(T): Array[U]): Array[U] {
    var out: Array[U] = []
    for item in self {
        for part in transform(item) {
            out.push(part)
        }
    }
    out
}

/// The elements combined from `initial`, in order.
pub fn Array[T].reduce[A](self, initial: A, combine: fn(A, T): A): A {
    var total = initial
    for item in self {
        total = combine(total, item)
    }
    total
}

/// Whether some element passes the test; `false` for an empty array.
pub fn Array[T].any(self, predicate: fn(T): Bool): Bool {
    for item in self {
        if predicate(item) {
            return true
        }
    }
    false
}

/// Whether every element passes the test; `true` for an empty array.
pub fn Array[T].all(self, predicate: fn(T): Bool): Bool {
    for item in self {
        if not predicate(item) {
            return false
        }
    }
    true
}

/// The first element that passes the test.
pub fn Array[T].find(self, predicate: fn(T): Bool): T? {
    for item in self {
        if predicate(item) {
            return some(item)
        }
    }
    none
}

/// The index of the first element that passes the test.
pub fn Array[T].findIndex(self, predicate: fn(T): Bool): Int? {
    for index in 0..self.length() {
        if predicate(self[index]) {
            return some(index)
        }
    }
    none
}

/// How many elements pass the test.
pub fn Array[T].count(self, predicate: fn(T): Bool): Int {
    var total = 0
    for item in self {
        if predicate(item) {
            total += 1
        }
    }
    total
}

/// The sum of the elements; zero for an empty array.
pub fn Array[T: Additive].sum(self): T {
    var total = Additive.zero[T]()
    for item in self {
        total = total + item
    }
    total
}

/// The smallest element, the first of equal ones, or `none` when the array
/// is empty.
pub fn Array[T: Ordered].min(self): T? {
    var found: T? = none
    for item in self {
        found = match found {
            some(best) if best.compare(item) <= 0 => some(best)
            _ => some(item)
        }
    }
    found
}

/// The largest element, the first of equal ones, or `none` when the array
/// is empty.
pub fn Array[T: Ordered].max(self): T? {
    var found: T? = none
    for item in self {
        found = match found {
            some(best) if best.compare(item) >= 0 => some(best)
            _ => some(item)
        }
    }
    found
}

/// The elements in order, equal ones as they were.
pub fn Array[T: Ordered].sorted(self): Array[T] {
    // Integers and strings, which the runtime sorts faster.
    if textNative.nativeOrder(self) {
        textNative.sortedNatively(self)
    } else {
        self.sortedWith(order[T])
    }
}

/// The elements in the order of their keys, equal ones as they were.
pub fn Array[T].sortedBy[K: Ordered](self, key: fn(T): K): Array[T] {
    var keyed: Array[(K, T)] = []
    for item in self {
        keyed.push((key(item), item))
    }
    var out: Array[T] = []
    for (_, item) in mergeSort(keyed, (a: (K, T), b: (K, T)) { a.0.compare(b.0) }) {
        out.push(item)
    }
    out
}

/// The elements in the order `compare` gives, equal ones as they were.
pub fn Array[T].sortedWith(self, compare: fn(T, T): Int): Array[T] {
    mergeSort(self, compare)
}

/// A stable merge sort: runs of a few elements put in order by insertion,
/// then merged in pairs of doubling width from one array to the other.
fn mergeSort[T](items: Array[T], compare: fn(T, T): Int): Array[T] {
    let length = items.length()
    let run = 16
    var from = items
    var start = 0
    for start < length {
        let end = if start + run < length { start + run } else { length }
        for i in start + 1..end {
            let item = from[i]
            var j = i
            for j > start and compare(item, from[j - 1]) < 0 {
                from[j] = from[j - 1]
                j -= 1
            }
            from[j] = item
        }
        start = end
    }
    var to = from
    var width = run
    for width < length {
        var left = 0
        for left < length {
            let middle = if left + width < length { left + width } else { length }
            let right = if middle + width < length { middle + width } else { length }
            var (i, j, k) = (left, middle, left)
            for i < middle and j < right {
                if compare(from[j], from[i]) < 0 {
                    to[k] = from[j]
                    j += 1
                } else {
                    to[k] = from[i]
                    i += 1
                }
                k += 1
            }
            for i < middle {
                to[k] = from[i]
                i += 1
                k += 1
            }
            for j < right {
                to[k] = from[j]
                j += 1
                k += 1
            }
            left = right
        }
        let merged = to
        to = from
        from = merged
        width *= 2
    }
    from
}

/// The elements in the opposite order.
pub fn Array[T].reversed(self): Array[T] {
    self[::-1]
}

/// The elements without repeats, each where it first appears.
pub fn Array[T: Key].unique(self): Array[T] {
    var seen: Set[T] = Set[]
    var out: Array[T] = []
    for item in self {
        if seen.insert(item) {
            out.push(item)
        }
    }
    out
}

/// The first `count` elements.
pub fn Array[T].take(self, count: Int): Array[T] {
    self[:count.max(0)]
}

/// The elements after the first `count`.
pub fn Array[T].drop(self, count: Int): Array[T] {
    self[count.max(0):]
}

/// Pairs of elements at the same index, as many as the shorter has.
pub fn Array[T].zip[U](self, other: Array[U]): Array[(T, U)] {
    var out: Array[(T, U)] = []
    for index in 0..self.length().min(other.length()) {
        out.push((self[index], other[index]))
    }
    out
}

/// Each element with its index.
pub fn Array[T].enumerate(self): Array[(Int, T)] {
    var out: Array[(Int, T)] = []
    for index in 0..self.length() {
        out.push((index, self[index]))
    }
    out
}

/// The elements in groups of `size`; the last may be smaller.
pub fn Array[T].chunks(self, size: Int): Array[Array[T]] {
    var out: Array[Array[T]] = []
    if size <= 0 {
        return out
    }
    var start = 0
    for start < self.length() {
        out.push(self[start:start + size])
        start += size
    }
    out
}

/// Every run of `size` consecutive elements.
pub fn Array[T].windows(self, size: Int): Array[Array[T]] {
    var out: Array[Array[T]] = []
    if size <= 0 {
        return out
    }
    for start in 0..self.length() - size + 1 {
        out.push(self[start:start + size])
    }
    out
}

/// The elements by key, in the order the keys first appear.
pub fn Array[T].groupBy[K: Key](self, key: fn(T): K): Map[K, Array[T]] {
    var groups: Map[K, Array[T]] = [:]
    for item in self {
        let k = key(item)
        var group = groups.getOr(k, [])
        group.push(item)
        groups[k] = group
    }
    groups
}

/// The elements that pass the test, and those that do not.
pub fn Array[T].partition(self, predicate: fn(T): Bool): (Array[T], Array[T]) {
    var (passed, failed): (Array[T], Array[T]) = ([], [])
    for item in self {
        if predicate(item) { passed.push(item) } else { failed.push(item) }
    }
    (passed, failed)
}

/// The elements as text, with `separator` between them.
pub fn Array[T: Display].join(self, separator: String): String {
    textNative.joined(self, separator)
}

/// Puts the elements in order, equal ones as they were.
pub fn Array[T: Ordered].sort(mut self) {
    let sorted = self.sorted()
    self[:] = sorted
}

/// Puts the elements in the order of their keys.
pub fn Array[T].sortBy[K: Ordered](mut self, key: fn(T): K) {
    let sorted = self.sortedBy(key)
    self[:] = sorted
}

/// Puts the elements in the opposite order.
pub fn Array[T].reverse(mut self) {
    let reversed = self.reversed()
    self[:] = reversed
}

/// Exchanges the elements at `i` and `j`; an index out of the array
/// panics.
pub fn Array[T].swap(mut self, i: Int, j: Int) {
    let first = self[i]
    self[i] = self[j]
    self[j] = first
}

/// Keeps only the elements that pass the test.
pub fn Array[T].retain(var self, keep: fn(T): Bool) {
    self = self.filter(keep)
}

/// Adds the elements of `other` at the end.
pub fn Array[T].extend(var self, other: Array[T]) {
    for item in other {
        self.push(item)
    }
}

// ---------------------------------------------------------------------------
// Map and Set
// ---------------------------------------------------------------------------

/// The value of the key, or `fallback`.
pub fn Map[K: Key, V].getOr(self, key: K, fallback: V): V {
    match self[key] {
        some(value) => value
        none => fallback
    }
}

/// The same keys, each with the function's result for its value.
pub fn Map[K: Key, V].mapValues[W](self, transform: fn(V): W): Map[K, W] {
    var out: Map[K, W] = [:]
    for (key, value) in self {
        out[key] = transform(value)
    }
    out
}

/// The entries that pass the test, in the same order.
pub fn Map[K: Key, V].filter(self, keep: fn(K, V): Bool): Map[K, V] {
    var out: Map[K, V] = [:]
    for (key, value) in self {
        if keep(key, value) {
            out[key] = value
        }
    }
    out
}

/// The entries of both, with those of `other` where both have a key.
pub fn Map[K: Key, V].merge(self, other: Map[K, V]): Map[K, V] {
    var out = self
    for (key, value) in other {
        out[key] = value
    }
    out
}

/// The values in either set.
pub fn Set[T: Key].union(self, other: Set[T]): Set[T] {
    var out = self
    for item in other {
        out.insert(item)
    }
    out
}

/// The values in both sets.
pub fn Set[T: Key].intersection(self, other: Set[T]): Set[T] {
    var out: Set[T] = Set[]
    for item in self {
        if other.contains(item) {
            out.insert(item)
        }
    }
    out
}

/// The values of this set that are not in `other`.
pub fn Set[T: Key].difference(self, other: Set[T]): Set[T] {
    var out: Set[T] = Set[]
    for item in self {
        if not other.contains(item) {
            out.insert(item)
        }
    }
    out
}

/// Whether every element is also in `other`.
pub fn Set[T: Key].isSubset(self, other: Set[T]): Bool {
    for item in self {
        if not other.contains(item) {
            return false
        }
    }
    true
}

// ---------------------------------------------------------------------------
// Iterator
// ---------------------------------------------------------------------------

/// What every iterator can do besides `next`. The adapters are lazy: they
/// take elements from their source only as they are asked for theirs. Each
/// method works on a copy of the iterator, so its type is `Copy`.
pub trait Iterator[T] {
    fn map[U](self, transform: fn(T): U): MapIterator[Self, T, U] {
        MapIterator { source: self, transform }
    }

    fn filter(self, keep: fn(T): Bool): FilterIterator[Self, T] {
        FilterIterator { source: self, keep }
    }

    /// The first `count` elements.
    fn take(self, count: Int): TakeIterator[Self, T] {
        TakeIterator { source: self, remaining: count, unused: none }
    }

    /// The elements after the first `count`.
    fn skip(self, count: Int): SkipIterator[Self, T] {
        SkipIterator { source: self, count, unused: none }
    }

    /// The elements until the first that fails the test.
    fn takeWhile(self, predicate: fn(T): Bool): TakeWhileIterator[Self, T] {
        TakeWhileIterator { source: self, predicate, done: false }
    }

    /// The elements from the first that fails the test.
    fn skipWhile(self, predicate: fn(T): Bool): SkipWhileIterator[Self, T] {
        SkipWhileIterator { source: self, predicate, started: false }
    }

    /// Each element with its position.
    fn enumerate(self): EnumerateIterator[Self, T] {
        EnumerateIterator { source: self, index: 0, unused: none }
    }

    /// Pairs of elements from both, as long as both have one.
    fn zip[U, J: Iterator[U]](self, other: J): ZipIterator[Self, J, T, U] {
        ZipIterator { first: self, second: other, unused: none }
    }

    /// The elements, then those of `other`.
    fn chain[J: Iterator[T]](self, other: J): ChainIterator[Self, J, T] {
        ChainIterator { first: self, second: other, inSecond: false, unused: none }
    }

    /// The elements of the array each element gives, in order.
    fn flatMap[U](self, transform: fn(T): Array[U]): FlatMapIterator[Self, T, U] {
        FlatMapIterator { source: self, transform, current: [], position: 0 }
    }

    fn collect(self): Array[T] {
        let cursor = self
        var out: Array[T] = []
        for item in cursor {
            out.push(item)
        }
        out
    }

    fn count(self): Int {
        let cursor = self
        var total = 0
        for _ in cursor {
            total += 1
        }
        total
    }

    fn any(self, predicate: fn(T): Bool): Bool {
        let cursor = self
        for item in cursor {
            if predicate(item) {
                return true
            }
        }
        false
    }

    fn all(self, predicate: fn(T): Bool): Bool {
        let cursor = self
        for item in cursor {
            if not predicate(item) {
                return false
            }
        }
        true
    }

    fn find(self, predicate: fn(T): Bool): T? {
        let cursor = self
        for item in cursor {
            if predicate(item) {
                return some(item)
            }
        }
        none
    }

    fn reduce[A](self, initial: A, combine: fn(A, T): A): A {
        let cursor = self
        var total = initial
        for item in cursor {
            total = combine(total, item)
        }
        total
    }

    fn forEach(self, action: fn(T)) {
        let cursor = self
        for item in cursor {
            action(item)
        }
    }
}

/// The iterator `map` gives: each value of the source through the function.
pub type MapIterator[I, T, U] = {
    priv source: I
    priv transform: fn(T): U
}

impl[I: Iterator[T], T, U] Iterator[U] for MapIterator[I, T, U] {
    fn next(mut self): U? {
        match self.source.next() {
            some(item) => some(self.transform(item))
            none => none
        }
    }
}

/// The iterator `filter` gives: the values of the source that pass the test.
pub type FilterIterator[I, T] = {
    priv source: I
    priv keep: fn(T): Bool
}

impl[I: Iterator[T], T] Iterator[T] for FilterIterator[I, T] {
    fn next(mut self): T? {
        for {
            match self.source.next() {
                some(item) => {
                    if self.keep(item) {
                        return some(item)
                    }
                }
                none => return none
            }
        }
    }
}

/// The iterator `take` gives: the first values of the source, up to a count.
pub type TakeIterator[I, T] = {
    priv source: I
    priv remaining: Int
    priv unused: T?
}

impl[I: Iterator[T], T] Iterator[T] for TakeIterator[I, T] {
    fn next(mut self): T? {
        if self.remaining <= 0 {
            return none
        }
        self.remaining -= 1
        self.source.next()
    }
}

/// The iterator `skip` gives: the values of the source after a count.
pub type SkipIterator[I, T] = {
    priv source: I
    priv count: Int
    priv unused: T?
}

impl[I: Iterator[T], T] Iterator[T] for SkipIterator[I, T] {
    fn next(mut self): T? {
        for self.count > 0 {
            self.count -= 1
            if self.source.next().isNone() {
                return none
            }
        }
        self.source.next()
    }
}

/// The iterator `takeWhile` gives: the values of the source until one fails
/// the test.
pub type TakeWhileIterator[I, T] = {
    priv source: I
    priv predicate: fn(T): Bool
    priv done: Bool
}

impl[I: Iterator[T], T] Iterator[T] for TakeWhileIterator[I, T] {
    fn next(mut self): T? {
        if self.done {
            return none
        }
        match self.source.next() {
            some(item) if self.predicate(item) => some(item)
            _ => {
                self.done = true
                none
            }
        }
    }
}

/// The iterator `skipWhile` gives: the values of the source from the first
/// that fails the test.
pub type SkipWhileIterator[I, T] = {
    priv source: I
    priv predicate: fn(T): Bool
    priv started: Bool
}

impl[I: Iterator[T], T] Iterator[T] for SkipWhileIterator[I, T] {
    fn next(mut self): T? {
        if self.started {
            return self.source.next()
        }
        for {
            match self.source.next() {
                some(item) => {
                    if not self.predicate(item) {
                        self.started = true
                        return some(item)
                    }
                }
                none => return none
            }
        }
    }
}

/// The iterator `enumerate` gives: each value of the source with its index.
pub type EnumerateIterator[I, T] = {
    priv source: I
    priv index: Int
    priv unused: T?
}

impl[I: Iterator[T], T] Iterator[(Int, T)] for EnumerateIterator[I, T] {
    fn next(mut self): (Int, T)? {
        match self.source.next() {
            some(item) => {
                let position = self.index
                self.index += 1
                some((position, item))
            }
            none => none
        }
    }
}

/// The iterator `zip` gives: the values of two iterators in pairs, until
/// either ends.
pub type ZipIterator[I, J, T, U] = {
    priv first: I
    priv second: J
    priv unused: (T, U)?
}

impl[I: Iterator[T], J: Iterator[U], T, U] Iterator[(T, U)] for ZipIterator[I, J, T, U] {
    fn next(mut self): (T, U)? {
        match self.first.next() {
            some(a) => match self.second.next() {
                some(b) => some((a, b))
                none => none
            }
            none => none
        }
    }
}

/// The iterator `chain` gives: the values of one iterator, then another's.
pub type ChainIterator[I, J, T] = {
    priv first: I
    priv second: J
    priv inSecond: Bool
    priv unused: T?
}

impl[I: Iterator[T], J: Iterator[T], T] Iterator[T] for ChainIterator[I, J, T] {
    fn next(mut self): T? {
        if not self.inSecond {
            match self.first.next() {
                some(item) => return some(item)
                none => self.inSecond = true
            }
        }
        self.second.next()
    }
}

/// The iterator `flatMap` gives: the elements of each array the function
/// makes of a value of the source.
pub type FlatMapIterator[I, T, U] = {
    priv source: I
    priv transform: fn(T): Array[U]
    priv current: Array[U]
    priv position: Int
}

impl[I: Iterator[T], T, U] Iterator[U] for FlatMapIterator[I, T, U] {
    fn next(mut self): U? {
        for self.position >= self.current.length() {
            match self.source.next() {
                some(item) => {
                    self.current = self.transform(item)
                    self.position = 0
                }
                none => return none
            }
        }
        let item = self.current[self.position]
        self.position += 1
        some(item)
    }
}

// ---------------------------------------------------------------------------
// Ranges and lazy views
// ---------------------------------------------------------------------------

/// The types a range counts through (10.16 of the language): the integers
/// and `Char`, whose successor skips the surrogates.
trait Discrete {
    fn successor(self): Self
}

impl Discrete for Int {
    fn successor(self): Int {
        self + 1
    }
}

impl Discrete for Int8 {
    fn successor(self): Int8 {
        self + 1
    }
}

impl Discrete for Int16 {
    fn successor(self): Int16 {
        self + 1
    }
}

impl Discrete for Int32 {
    fn successor(self): Int32 {
        self + 1
    }
}

impl Discrete for UInt8 {
    fn successor(self): UInt8 {
        self + 1
    }
}

impl Discrete for UInt16 {
    fn successor(self): UInt16 {
        self + 1
    }
}

impl Discrete for UInt32 {
    fn successor(self): UInt32 {
        self + 1
    }
}

impl Discrete for UInt {
    fn successor(self): UInt {
        self + 1
    }
}

impl Discrete for Int128 {
    fn successor(self): Int128 {
        self + 1
    }
}

impl Discrete for UInt128 {
    fn successor(self): UInt128 {
        self + 1
    }
}

impl Discrete for Char {
    fn successor(self): Char {
        textNative.charFrom(if self.code() == 0xD7FF { 0xE000 } else { self.code() + 1 })
    }
}

/// `start..end`, without `end`, or `start..=end`, with it: the values from
/// `start` on, one after another; none when `start` is past the end.
pub type Range[T] = {
    priv lower: T
    priv upper: T
    priv inclusive: Bool
    priv done: Bool
}

impl[T: Discrete + Ordered] Iterator[T] for Range[T] {
    fn next(mut self): T? {
        let toEnd = self.lower.compare(self.upper)
        if self.done or toEnd > 0 or (toEnd == 0 and not self.inclusive) {
            return none
        }
        let value = self.lower
        if toEnd == 0 {
            self.done = true
        } else {
            self.lower = value.successor()
        }
        some(value)
    }
}

/// `0..10` or `'a'..='z'`.
impl[T: Display] Display for Range[T] {
    fn display(self): String {
        if self.inclusive { "{self.lower}..={self.upper}" } else { "{self.lower}..{self.upper}" }
    }
}

/// The first value it yields, unless it is empty.
pub fn Range[T].start(self): T {
    self.lower
}

/// The value where it stops: the last it yields with `..=`, the one after
/// it with `..`.
pub fn Range[T].end(self): T {
    self.upper
}

/// Whether it was written `..=`, and yields its `end`.
pub fn Range[T].isInclusive(self): Bool {
    self.inclusive
}

/// Whether it yields no value.
pub fn Range[T: Ordered].isEmpty(self): Bool {
    let toEnd = self.lower.compare(self.upper)
    self.done or toEnd > 0 or (toEnd == 0 and not self.inclusive)
}

/// Whether `value` is one the range still yields.
pub fn Range[T: Ordered].contains(self, value: T): Bool {
    let end = value.compare(self.upper)
    not self.done and value.compare(self.lower) >= 0 and (end < 0 or (end == 0 and self.inclusive))
}

/// `value in range`, which reads the value first (5.12 of the language).
fn rangeHas[T: Ordered](value: T, range: Range[T]): Bool {
    range.contains(value)
}

/// `c in text`, which reads the character first.
fn textHas(value: Char, text: String): Bool {
    text.contains("{value}")
}

/// The characters of a string, as `String.chars()` gives them.
pub type CharIterator = {
    priv text: String
    priv offset: Int
}

impl Iterator[Char] for CharIterator {
    fn next(mut self): Char? {
        if self.offset >= self.text.byteLength() {
            return none
        }
        let c = textNative.scalarAt(self.text, self.offset)
        let code = c.code()
        self.offset += if code < 0x80 {
            1
        } else if code < 0x800 {
            2
        } else if code < 0x10000 {
            3
        } else {
            4
        }
        some(c)
    }
}

/// The characters, one after another, without copying the text.
pub fn String.chars(self): CharIterator {
    CharIterator { text: self, offset: 0 }
}

/// The elements of an array, as `Array.iter()` gives them.
pub type ArrayIterator[T] = {
    priv items: Array[T]
    priv position: Int
}

impl[T] Iterator[T] for ArrayIterator[T] {
    fn next(mut self): T? {
        let item = self.items.get(self.position)?
        self.position += 1
        some(item)
    }
}

/// The elements, one after another: the lazy adapters of `Iterator` make
/// no array until `collect()`.
pub fn Array[T].iter(self): ArrayIterator[T] {
    ArrayIterator { items: self, position: 0 }
}
