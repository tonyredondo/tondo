// std.image (standard library 14.38): images read, changed and written,
// PNG, JPEG, GIF and WebP, with the sizes and crops a site makes of them;
// the runtime decodes, encodes and changes the pixels, on the host's
// threads. An image never changes: each operation gives a new one.
//
// ```tondo
// import std.image
//
// let photo = image.open("photo.jpg")?
// photo.fit(800, 600).save("photo-800.webp")?
// photo.fill(200, 200).save("avatar.jpg", quality: 80)?
// ```

import std.fs as __fs
import std.internal.image as imageNative
import std.reflect as __reflect
import std.time as __time

/// A format of image.
///
/// ```tondo
/// import std.console
/// import std.image
///
/// let photo = image.blank(2, 2, image.Color.rgb(200, 100, 50))
/// for path in ["a.png", "b.webp", "c.txt"] {
///     match image.Format.of(path) {
///         some(format) => console.println("{path}: {photo.encode(format)?.length()} bytes")
///         none => console.println("{path}: not an image format")
///     }
/// }
/// ```
pub enum Format {
    Png
    Jpeg
    Gif
    WebP
}

/// `png`, `jpeg`, `gif` or `webp`.
impl Display for Format {
    fn display(self): String {
        match self {
            Format.Png => "png"
            Format.Jpeg => "jpeg"
            Format.Gif => "gif"
            Format.WebP => "webp"
        }
    }
}

/// The format a path's extension names: `.png`, `.jpg` or `.jpeg`, `.gif`,
/// `.webp`.
pub fn Format.of(path: String): Format? {
    let lower = path.toLowerAscii()
    if lower.endsWith(".png") {
        some(Format.Png)
    } else if lower.endsWith(".jpg") or lower.endsWith(".jpeg") {
        some(Format.Jpeg)
    } else if lower.endsWith(".gif") {
        some(Format.Gif)
    } else if lower.endsWith(".webp") {
        some(Format.WebP)
    } else {
        none
    }
}

/// Why an image could not be read or written.
///
/// ```tondo
/// import std.console
/// import std.image
///
/// match image.read([1, 2, 3]) {
///     ok(picture) => console.println("{picture.width()}x{picture.height()}")
///     err(error) => console.println("not an image: {error.message}")
/// }
/// ```
pub type ImageError = {
    message: String
}

impl Display for ImageError {
    fn display(self): String {
        self.message
    }
}

/// What the header of an image says, read without its pixels.
///
/// ```tondo
/// import std.console
/// import std.image
///
/// let bytes = image.blank(640, 480, image.Color.rgb(0, 0, 0)).encode(image.Format.Png)?
/// let info = image.info(bytes)?
/// console.println("{info.width}x{info.height}, png: {info.format == image.Format.Png}")
/// ```
pub type Info = {
    format: Format
    width: Int
    height: Int
}

/// A color: red, green, blue and alpha, each from 0 to 255.
///
/// ```tondo
/// import std.console
/// import std.image
///
/// let orange = image.Color.hex("#ff8800")?
/// let canvas = image.blank(8, 8, orange).overlay(image.blank(4, 4, image.Color.rgb(0, 0, 255)), 0, 0)
/// for color in canvas.colors(count: 2) {
///     console.println("{color.red} {color.green} {color.blue} {color.alpha}")
/// }
/// ```
pub type Color = {
    red: Int
    green: Int
    blue: Int
    alpha: Int
}

/// An opaque color.
pub fn Color.rgb(red: Int, green: Int, blue: Int): Color {
    Color { red, green, blue, alpha: 255 }
}

/// The color of `#rrggbb` or `#rrggbbaa`, the `#` optional.
pub fn Color.hex(text: String): Color ! ImageError {
    let digits = text.removePrefix("#")
    let value = match Int.parse(digits, radix: 16) {
        ok(found) if digits.length() == 6 or digits.length() == 8 => found
        _ => fail ImageError { message: "`{text}` is not a color: write `#rrggbb` or `#rrggbbaa`" }
    }
    let rgba = if digits.length() == 6 { (value << 8) | 255 } else { value }
    colorOf(rgba)
}

/// `#rrggbb`, or `#rrggbbaa` when it is not opaque.
impl Display for Color {
    fn display(self): String {
        let shown = "#{self.red:02x}{self.green:02x}{self.blue:02x}"
        if self.alpha == 255 { shown } else { "{shown}{self.alpha:02x}" }
    }
}

fn colorOf(rgba: Int): Color {
    Color {
        red: (rgba >> 24) & 255
        green: (rgba >> 16) & 255
        blue: (rgba >> 8) & 255
        alpha: rgba & 255
    }
}

fn packed(color: Color): Int {
    let part = (value: Int): Int { value.clamp(0, 255) }
    (part(color.red) << 24) |
        (part(color.green) << 16) |
        (part(color.blue) << 8) |
        part(color.alpha)
}

/// How a resize samples the pixels: `Lanczos`, the sharpest, is the
/// default; `Nearest` keeps hard edges, as pixel art wants.
///
/// ```tondo
/// import std.image
///
/// // Pixel art keeps its hard edges with `Nearest`; photos look best with `Lanczos`.
/// let sprite = image.open("sprite.png")?
/// sprite.resize(width: some(sprite.width() * 4), filter: image.Filter.Nearest).save("sprite-4x.png")?
/// ```
pub enum Filter {
    Nearest
    Linear
    CatmullRom
    Lanczos
}

/// The part of an image a crop to another shape keeps.
///
/// ```tondo
/// import std.image
///
/// // A square avatar that keeps the top of a portrait, where the face is.
/// let portrait = image.open("portrait.jpg")?
/// portrait.fill(256, 256, anchor: image.Anchor.Top).save("avatar.webp", quality: 80)?
/// ```
pub enum Anchor {
    Center
    Top
    Bottom
    Left
    Right
    TopLeft
    TopRight
    BottomLeft
    BottomRight
}

/// An image, whose pixels never change.
///
/// ```tondo
/// import std.image
///
/// let photo = image.open("photo.jpg")?
/// photo.fit(1200, 1200).sharpen().save("large.jpg", quality: 85)?
/// photo.fill(300, 200).grayscale().save("thumbnail.webp")?
/// photo.crop(0, 0, photo.width() / 2, photo.height()).flipHorizontal().save("half.png")?
/// ```
pub type Image = {
    priv native: imageNative.Native
    priv columns: Int
    priv rows: Int
    priv source: Format?
}

fn made(native: imageNative.Native): Image {
    let size = imageNative.size(native)
    let source = match size[2] {
        0 => some(Format.Png)
        1 => some(Format.Jpeg)
        2 => some(Format.Gif)
        3 => some(Format.WebP)
        _ => none
    }
    Image { native, columns: size[0], rows: size[1], source }
}

/// The image of the bytes of a PNG, JPEG, GIF or WebP, turned as its EXIF
/// orientation says; the first frame of an animation.
pub fn read(bytes: Array[Byte]): Image ! ImageError {
    let native = imageNative.read(bytes)
    let why = imageNative.failure(native)
    if not why.isEmpty() {
        fail ImageError { message: "the image does not read: {why}" }
    }
    made(native)
}

/// The image in the file at `path`.
pub fn open(path: String): Image ! ImageError {
    match __fs.readBytes(path) {
        ok(bytes) => match read(bytes) {
            ok(image) => image
            err(error) => fail ImageError { message: "{path}: {error}" }
        }
        err(error) => fail ImageError { message: "{path}: {error}" }
    }
}

/// The format and size of an image, from its header alone.
pub fn info(bytes: Array[Byte]): Info ! ImageError {
    let found = imageNative.info(bytes)
    if found.length() != 3 {
        fail ImageError {
            message: "the bytes are not an image of a format tondo reads: PNG, JPEG, GIF or WebP"
        }
    }
    let format = match found[0] {
        0 => Format.Png
        1 => Format.Jpeg
        2 => Format.Gif
        _ => Format.WebP
    }
    Info { format, width: found[1], height: found[2] }
}

/// What a photo's EXIF says: when it was taken, in UTC, from its clock at
/// the offset the photo gives, or as UTC without one; where, in degrees,
/// south and west below zero; its camera; how it is turned, 1 upright to
/// 8 as EXIF numbers it, which `read` applies; and every tag by its name,
/// as text: `tags["FNumber"]` is `f/2.8`.
///
/// ```tondo
/// import std.console
/// import std.fs
/// import std.image
///
/// let bytes = fs.readBytes("photo.jpg")?
/// match image.exif(bytes) {
///     some(exif) => {
///         console.println("taken {exif.date} with {exif.camera.unwrapOr("an unknown camera")}")
///         match (exif.latitude, exif.longitude) {
///             (some(latitude), some(longitude)) => console.println("at {latitude}, {longitude}")
///             _ => console.println("no place")
///         }
///     }
///     none => console.println("no EXIF data")
/// }
/// ```
pub type Exif = {
    date: __time.DateTime?
    latitude: Float?
    longitude: Float?
    camera: String?
    orientation: Int
    tags: Map[String, String]
}

/// The EXIF of a JPEG, PNG, WebP, TIFF or HEIF image, as Hugo's `.Exif`;
/// `none` when it has none.
pub fn exif(bytes: Array[Byte]): Exif? {
    let texts = imageNative.exif(bytes)
    if texts.length() < 5 {
        return none
    }
    let given = (index: Int): String? {
        if texts[index].isEmpty() { none } else { some(texts[index]) }
    }
    var tags: Map[String, String] = [:]
    var at = 5
    for at + 1 < texts.length() {
        tags[texts[at]] = texts[at + 1]
        at += 2
    }
    some(Exif {
        date: given(0).andThen((written) { __time.parseDateTime(written).ok() })
        latitude: given(1).andThen((written) { Float.parse(written).ok() })
        longitude: given(2).andThen((written) { Float.parse(written).ok() })
        camera: given(3)
        orientation: Int.parse(texts[4]).unwrapOr(1)
        tags
    })
}

/// An image of one color.
pub fn blank(width: Int, height: Int, color: Color): Image {
    made(imageNative.blank(width.max(0), height.max(0), packed(color)))
}

/// The image of `pixels`: four bytes each, red, green, blue and alpha, row
/// by row from the top left, as `Image.pixels` gives them.
pub fn fromPixels(width: Int, height: Int, pixels: Array[Byte]): Image ! ImageError {
    let native = imageNative.fromPixels(width, height, pixels)
    let why = imageNative.failure(native)
    if not why.isEmpty() {
        fail ImageError { message: why }
    }
    made(native)
}

/// Its width in pixels.
pub fn Image.width(self): Int {
    self.columns
}

/// Its height in pixels.
pub fn Image.height(self): Int {
    self.rows
}

/// The format it was read from; `none` for one this program made.
pub fn Image.format(self): Format? {
    self.source
}

/// The image at another size: given one side, the other keeps the
/// proportions; given both, it is stretched to them.
pub fn Image.resize(
    self,
    width: Int? = none,
    height: Int? = none,
    filter: Filter = Filter.Lanczos,
): Image {
    let (wide, high) = match (width, height) {
        (some(w), some(h)) => (w, h)
        (some(w), none) => (w, (self.rows * w + self.columns / 2) / self.columns.max(1))
        (none, some(h)) => ((self.columns * h + self.rows / 2) / self.rows.max(1), h)
        (none, none) => return self
    }
    scaled(self, wide.max(1), high.max(1), filter)
}

fn scaled(image: Image, width: Int, height: Int, filter: Filter): Image {
    if width == image.columns and height == image.rows {
        return image
    }
    let code = match filter {
        Filter.Nearest => 0
        Filter.Linear => 1
        Filter.CatmullRom => 2
        Filter.Lanczos => 3
    }
    made(imageNative.change(image.native, 0, width, height, code, 0))
}

/// The image made smaller, if it must be, to fit inside `width` by
/// `height` with its proportions: a thumbnail. It never grows.
pub fn Image.fit(self, width: Int, height: Int, filter: Filter = Filter.Lanczos): Image {
    if self.columns <= width and self.rows <= height {
        return self
    }
    // The side that limits it decides the scale.
    if self.columns * height >= self.rows * width {
        self.resize(width: width, filter: filter)
    } else {
        self.resize(height: height, filter: filter)
    }
}

/// The image resized to cover `width` by `height` and cropped to it,
/// keeping the part `anchor` says: a cover or an avatar.
pub fn Image.fill(
    self,
    width: Int,
    height: Int,
    anchor: Anchor = Anchor.Center,
    filter: Filter = Filter.Lanczos,
): Image {
    let (wide, high) = (width.max(1), height.max(1))
    // The side that limits it covers the box; the other overflows.
    let covered = if self.columns * high >= self.rows * wide {
        self.resize(height: high, filter: filter)
    } else {
        self.resize(width: wide, filter: filter)
    }
    let (spareX, spareY) = (covered.columns - wide, covered.rows - high)
    let (x, y) = match anchor {
        Anchor.Center => (spareX / 2, spareY / 2)
        Anchor.Top => (spareX / 2, 0)
        Anchor.Bottom => (spareX / 2, spareY)
        Anchor.Left => (0, spareY / 2)
        Anchor.Right => (spareX, spareY / 2)
        Anchor.TopLeft => (0, 0)
        Anchor.TopRight => (spareX, 0)
        Anchor.BottomLeft => (0, spareY)
        Anchor.BottomRight => (spareX, spareY)
    }
    covered.crop(x, y, wide, high)
}

/// The part `width` by `height` at (`x`, `y`), from the top left, cut to
/// what the image has.
pub fn Image.crop(self, x: Int, y: Int, width: Int, height: Int): Image {
    let left = x.clamp(0, self.columns)
    let top = y.clamp(0, self.rows)
    let wide = width.clamp(0, self.columns - left)
    let high = height.clamp(0, self.rows - top)
    if left == 0 and top == 0 and wide == self.columns and high == self.rows {
        return self
    }
    made(imageNative.change(self.native, 1, left, top, wide, high))
}

/// The image turned clockwise by a multiple of 90 degrees, as `-90` or
/// `270`.
pub fn Image.rotate(self, degrees: Int): Image {
    if degrees % 90 != 0 {
        panic("an image turns by a multiple of 90 degrees, not {degrees}")
    }
    match ((degrees % 360) + 360) % 360 {
        90 => made(imageNative.change(self.native, 2, 0, 0, 0, 0))
        180 => made(imageNative.change(self.native, 3, 0, 0, 0, 0))
        270 => made(imageNative.change(self.native, 4, 0, 0, 0, 0))
        _ => self
    }
}

/// The image mirrored left to right.
pub fn Image.flipHorizontal(self): Image {
    made(imageNative.change(self.native, 5, 0, 0, 0, 0))
}

/// The image mirrored top to bottom.
pub fn Image.flipVertical(self): Image {
    made(imageNative.change(self.native, 6, 0, 0, 0, 0))
}

/// The image in shades of gray.
pub fn Image.grayscale(self): Image {
    made(imageNative.change(self.native, 7, 0, 0, 0, 0))
}

/// The image blurred, by `sigma` pixels.
pub fn Image.blur(self, sigma: Float): Image {
    made(imageNative.blur(self.native, sigma))
}

/// `top` drawn over the image at (`x`, `y`), blended by its alpha: a
/// watermark or a badge.
pub fn Image.overlay(self, top: Image, x: Int, y: Int): Image {
    made(imageNative.overlay(self.native, top.native, x, y))
}

/// Its pixels: four bytes each, red, green, blue and alpha, row by row
/// from the top left, to change in place and make an image again with
/// `image.fromPixels`.
pub fn Image.pixels(self): Array[Byte] {
    imageNative.pixels(self.native)
}

/// The image with its colors adjusted in the scales of Hugo's filters:
/// `brightness` and `contrast` from -100 to 100, `saturation` from -100 to
/// 500, `gamma` over 0, where 1 changes nothing and more lightens, and `hue`
/// turned by degrees from -180 to 180; they apply in that order, and what
/// is not given does not change.
pub fn Image.adjust(
    self,
    brightness: Float = 0.0,
    contrast: Float = 0.0,
    saturation: Float = 0.0,
    gamma: Float = 1.0,
    hue: Float = 0.0,
): Image {
    made(imageNative.adjust(self.native, brightness, contrast, saturation, gamma, hue))
}

/// The image in its opposite colors, as a negative.
pub fn Image.invert(self): Image {
    made(imageNative.tone(self.native, 0, 0.0, 0.0))
}

/// The image toned in sepia, by `amount` percent.
pub fn Image.sepia(self, amount: Float = 100.0): Image {
    made(imageNative.tone(self.native, 1, amount, 0.0))
}

/// The image sharpened: its difference from a blur of `sigma` pixels, as
/// `blur` takes, added `amount` times.
pub fn Image.sharpen(self, sigma: Float = 1.0, amount: Float = 1.0): Image {
    made(imageNative.tone(self.native, 2, amount, sigma))
}

/// The image in squares of `size` pixels, each of their average color.
pub fn Image.pixelate(self, size: Int): Image {
    made(imageNative.tone(self.native, 3, Float(size), 0.0))
}

/// The image with its alpha multiplied by `alpha`, from 0, transparent, to
/// 1, as it is.
pub fn Image.opacity(self, alpha: Float): Image {
    made(imageNative.tone(self.native, 4, alpha, 0.0))
}

/// Up to `count` colors that cover most of the image, the most first, each
/// far enough from the others to tell apart: for a background or a
/// placeholder while it loads.
pub fn Image.colors(self, count: Int = 3): Array[Color] {
    imageNative.colors(self.native, count).map(colorOf)
}

/// The color of the pixel at (`x`, `y`), from the top left; `none`
/// outside the image.
pub fn Image.pixel(self, x: Int, y: Int): Color? {
    let rgba = imageNative.pixel(self.native, x, y)
    if rgba < 0 { none } else { some(colorOf(rgba)) }
}

/// The bytes of the image in a format; JPEG and WebP at a `quality` from 1
/// to 100, WebP with loss below 100 and without at 100.
pub fn Image.encode(self, format: Format, quality: Int = 85): Array[Byte] ! ImageError {
    let code = match format {
        Format.Png => 0
        Format.Jpeg => 1
        Format.Gif => 2
        Format.WebP => 3
    }
    let bytes = imageNative.encode(self.native, code, quality)
    if bytes.isEmpty() {
        fail ImageError { message: "the image could not be written as {format}" }
    }
    bytes
}

/// Writes the image to `path`, in the format its extension names.
pub fn Image.save(self, path: String, quality: Int = 85): !ImageError {
    let format = match Format.of(path) {
        some(found) => found
        none => fail ImageError {
            message: "`{path}` names no format of image: end it in `.png`, `.jpg`, `.gif` or `.webp`"
        }
    }
    let bytes = self.encode(format, quality)?
    match __fs.writeBytes(path, bytes) {
        ok(_) => {}
        err(error) => fail ImageError { message: "{path}: {error}" }
    }
}

/// An error, which reflection shows as its message, so a method that fails
/// with one is a tool of `std.mcp` or a field of `std.graphql`.
impl __reflect.Reflect for ImageError {
    fn reflectShow(self, _nested: Bool): String {
        "{self}"
    }
}
