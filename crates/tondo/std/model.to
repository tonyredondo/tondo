// A model of a design, checked in every order of its steps: a state, the steps
// that can follow each one, and what must hold, now, always, or in the end. It
// finds the shortest way to a state that breaks it, or the loop that never gets
// where it must, and says each state on the way. It runs in a test as anything
// else does.
//
// ```tondo
// import std.console
// import std.model
//
// type Door = { open: Bool, locked: Bool }
//
// fn steps(door: Door): Array[model.Step[Door]] {
//     var next = [model.step("lock", door with { locked: true })]
//     if not door.locked {
//         next.push(model.step("open", door with { open: true }))
//     }
//     next
// }
//
// let start = Door { open: false, locked: false }
// let safe = model.always((door: Door) { not (door.open and door.locked) })
// match model.check(start, steps, holds: [safe]) {
//     ok(checked) => console.println("{checked.states} states")
//     err(broken) => console.println("{broken}")
// }
// ```

import std.fs
import std.hash
import std.internal.model as modelNative
import std.json
import std.reflect
import std.serialization
import std.sync

/// What can happen from a state: its name, for the path to a fault and for
/// fairness, and the state it leads to.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// let step = model.step("add", 2)
/// console.println("{step.name} leads to {step.state}")
/// ```
pub type Step[S] = {
    name: String
    state: S
}

/// The step `name`, which leads to `state`.
///
/// ```tondo
/// import std.model
///
/// fn steps(count: Int): Array[model.Step[Int]] {
///     if count < 2 { [model.step("add", count + 1)] } else { [] }
/// }
///
/// _ = steps(0)
/// ```
pub fn step[S](name: String, next: S): Step[S] {
    Step { name, state: next }
}

/// How much of a model was checked: the states it reaches, the steps between
/// them, the most steps from the start to any of them, and, of a `machine`,
/// the events no state takes, which are often a mistake.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// let checked = model.Checked { states: 3, steps: 2, depth: 2, never: ["Cancel"] }
/// console.println("{checked.states} states, {checked.depth} steps deep, never {checked.never}")
/// ```
pub type Checked = {
    states: Int
    steps: Int
    depth: Int
    never: Array[String]
    /// The properties that held because what they are about never came, as
    /// a `leadsTo` whose `when` held in no state: they said nothing.
    vacuous: Array[String] = []
}

/// A state on the way to what broke: the step that led there, empty for the
/// start, and the state as written.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// let visit = model.Visit { step: "open", state: "Door {{ open: true }}" }
/// console.println("{visit.step}: {visit.state}")
/// ```
pub type Visit = {
    step: String
    state: String
}

/// What broke, and how: the shortest way there, each step with the state it
/// led to, and, when it is a loop that never gets where it must, the loop.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// let start = model.Visit { step: "", state: "0" }
/// let broken = model.Violation { what: "it broke", path: [start], loop: [] }
/// console.println("{broken}")
/// ```
pub type Violation = {
    what: String
    path: Array[Visit]
    loop: Array[Visit]
    /// The name of the property of `holds` that broke; none for a state
    /// nothing can follow, a step that failed or code that strayed.
    property: String? = none
}

impl Display for Violation {
    fn display(self): String {
        let line = (visit: Visit) {
            if visit.step.isEmpty() {
                "  start: {visit.state}"
            } else {
                "  {visit.step}: {visit.state}"
            }
        }
        var lines = [self.what]
        lines.extend(self.path.map(line))
        if not self.loop.isEmpty() {
            lines.push("  and then round for ever:")
            lines.extend(self.loop.map(line))
        }
        lines.join("\n")
    }
}

/// A queue a state can hold: what came first goes first, as a model says
/// of a queue of the code it checks.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// let waiting = model.Queue([1, 2]).push(3)
/// console.println("{waiting.first()} then {waiting.rest().length()} more")
/// ```
pub enum Queue[T] {
    Empty
    Item(T, Queue[T])
}

// Written as it is built, as `Queue([1, 2])`.
impl[T: reflect.Reflect] reflect.Reflect for Queue[T] {
    fn reflectShow(self, nested: Bool): String {
        _ = nested
        "Queue([{self.items().map((item) { item.reflectShow(true) }).join(", ")}])"
    }

    fn reflectElements(self): Array[reflect.Value]? {
        some(self.items().map((item) { reflect.valueOf(item) }))
    }
}

// Written as its items, the first first.
impl[T: serialization.Encode] serialization.Encode for Queue[T] {
    fn encode[O: serialization.Sink](self, out: O) {
        self.items().encode(out)
    }
}

impl[T: serialization.Decode] serialization.Decode for Queue[T] {
    fn decode[I: serialization.Source](
        input: I,
        first: serialization.Event,
    ): Queue[T] ! serialization.Error {
        let items: Array[T] = serialization.Decode.decode[Array[T]](input, first)?
        Queue(items)
    }
}

/// A queue of the items, the first first.
pub fn Queue[T](items: Array[T]): Queue[T] {
    var queue: Queue[T] = Queue.Empty
    for item in items.reversed() {
        queue = Queue.Item(item, queue)
    }
    queue
}

/// The queue with `item` last.
pub fn Queue[T].push(self, item: T): Queue[T] {
    var items = self.items()
    items.push(item)
    Queue(items)
}

/// What comes first, if anything does.
pub fn Queue[T].first(self): T? {
    match self {
        Queue.Item(item, _) => item
        Queue.Empty => none
    }
}

/// The queue without its first item.
pub fn Queue[T].rest(self): Queue[T] {
    match self {
        Queue.Item(_, rest) => rest
        Queue.Empty => Queue.Empty
    }
}

/// Its items, the first first.
pub fn Queue[T].items(self): Array[T] {
    var items: Array[T] = []
    var at = self
    for {
        match at {
            Queue.Item(item, rest) => {
                items.push(item)
                at = rest
            }
            Queue.Empty => return items
        }
    }
}

/// How many items it holds.
pub fn Queue[T].length(self): Int {
    self.items().length()
}

/// Whether it holds nothing.
pub fn Queue[T].isEmpty(self): Bool {
    self.first().isNone()
}

/// Whether `item` is in it.
pub fn Queue[T: Equatable].contains(self, item: T): Bool {
    self.items().contains(item)
}

/// The queue without the first `item` in it.
pub fn Queue[T: Equatable].without(self, item: T): Queue[T] {
    var items = self.items()
    match items.findIndex((other) { other == item }) {
        some(at) => {
            _ = items.removeAt(at)
            Queue(items)
        }
        none => self
    }
}

/// A collection whose order says nothing, which a state can hold: the same
/// items make the same bag however they came.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// let held = model.Bag([2, 1]).add(2)
/// console.println("{held.count(2)} of 2, {held == model.Bag([1, 2, 2])}")
/// ```
pub type Bag[T] = {
    priv held: Queue[T]
}

impl[T: reflect.Reflect] reflect.Reflect for Bag[T] {
    fn reflectShow(self, nested: Bool): String {
        _ = nested
        "Bag([{self.items().map((item) { item.reflectShow(true) }).join(", ")}])"
    }

    fn reflectElements(self): Array[reflect.Value]? {
        some(self.items().map((item) { reflect.valueOf(item) }))
    }
}

impl[T: serialization.Encode] serialization.Encode for Bag[T] {
    fn encode[O: serialization.Sink](self, out: O) {
        self.items().encode(out)
    }
}

impl[T: serialization.Decode] serialization.Decode for Bag[T] {
    fn decode[I: serialization.Source](
        input: I,
        first: serialization.Event,
    ): Bag[T] ! serialization.Error {
        let items: Array[T] = serialization.Decode.decode[Array[T]](input, first)?
        Bag { held: Queue(items) }
    }
}

/// A bag of the items.
pub fn Bag[T: reflect.Reflect](items: Array[T]): Bag[T] {
    Bag { held: Queue(items.sortedBy((item) { "{reflect.valueOf(item)}" })) }
}

/// The bag with `item` once more.
pub fn Bag[T: reflect.Reflect].add(self, item: T): Bag[T] {
    var items = self.items()
    items.push(item)
    Bag(items)
}

/// The bag with one `item` fewer, if it held one.
pub fn Bag[T: Equatable].remove(self, item: T): Bag[T] {
    Bag { held: self.held.without(item) }
}

/// Its items, in an order of their own: the same for the same items.
pub fn Bag[T].items(self): Array[T] {
    self.held.items()
}

/// How many times `item` is in it.
pub fn Bag[T: Equatable].count(self, item: T): Int {
    self.items().count((other) { other == item })
}

/// Whether `item` is in it.
pub fn Bag[T: Equatable].contains(self, item: T): Bool {
    self.count(item) > 0
}

/// How many items it holds, each as many times as it is in it.
pub fn Bag[T].length(self): Int {
    self.items().length()
}

/// Whether it holds nothing.
pub fn Bag[T].isEmpty(self): Bool {
    self.items().isEmpty()
}

/// A formula of linear temporal logic over the states of a run, for what a
/// predicate of one state cannot say: `model.state(p).until(q)`, with `next`,
/// `always`, `eventually`, `implies`, `negated`, `model.allOf` and
/// `model.anyOf` nested as deep as it takes. `model.temporal` makes it a
/// property.
///
/// ```tondo
/// import std.model
///
/// let positive = model.state((n: Int) { n > 0 })
/// let grows = positive.until(model.state((n: Int) { n > 9 })).always()
/// _ = model.temporal(grows, name: "it keeps positive until it passes 9")
/// ```
pub type Formula[S] = {
    priv term: Term[S]
}

enum Term[S] {
    Atom(fn(S): Bool)
    True
    False
    Not(Term[S])
    And(Term[S], Term[S])
    Or(Term[S], Term[S])
    Next(Term[S])
    Until(Term[S], Term[S])
    Release(Term[S], Term[S])
}

/// The formula that holds of a run whose first state `predicate` holds of.
pub fn state[S](predicate: fn(S): Bool): Formula[S] {
    Formula { term: Term.Atom(predicate) }
}

/// It does not hold.
pub fn Formula[S].negated(self): Formula[S] {
    Formula { term: Term.Not(self.term) }
}

/// Each of them holds.
pub fn allOf[S](first: Formula[S], rest: ...Formula[S]): Formula[S] {
    var term = first.term
    for other in rest {
        term = Term.And(term, other.term)
    }
    Formula { term }
}

/// One of them holds, at least.
pub fn anyOf[S](first: Formula[S], rest: ...Formula[S]): Formula[S] {
    var term = first.term
    for other in rest {
        term = Term.Or(term, other.term)
    }
    Formula { term }
}

/// Where this holds, `other` does too.
pub fn Formula[S].implies(self, other: Formula[S]): Formula[S] {
    Formula { term: Term.Or(Term.Not(self.term), other.term) }
}

/// It holds from the next state on.
pub fn Formula[S].next(self): Formula[S] {
    Formula { term: Term.Next(self.term) }
}

/// It holds of every state from here on.
pub fn Formula[S].always(self): Formula[S] {
    Formula { term: Term.Release(Term.False, self.term) }
}

/// It holds of some state from here on.
pub fn Formula[S].eventually(self): Formula[S] {
    Formula { term: Term.Until(Term.True, self.term) }
}

/// It holds until `other` does, which comes.
pub fn Formula[S].until(self, other: Formula[S]): Formula[S] {
    Formula { term: Term.Until(self.term, other.term) }
}

/// What must hold of a model, which `check` takes in `holds`.
///
/// ```tondo
/// import std.model
///
/// let positive = model.always((n: Int) { n >= 0 }, name: "never negative")
/// let ends = model.eventually((n: Int) { n == 3 })
/// _ = [positive, ends]
/// ```
pub type Property[S] = {
    priv name: String
    priv kind: Kind[S]
    /// What starts the property, as `leadsTo`'s `when`: if it holds in no
    /// state, the property holds with nothing to say.
    priv applies: (fn(S): Bool)? = none
}

enum Kind[S] {
    Invariant(fn(S): Bool)
    Reachable(fn(S): Bool)
    Temporal(Term[S])
}

/// Every state reached is one `predicate` holds of.
pub fn always[S](predicate: fn(S): Bool, name: String = "what must always hold"): Property[S] {
    Property { name, kind: Kind.Invariant(predicate) }
}

/// Every run gets to a state `predicate` holds of.
pub fn eventually[S](
    predicate: fn(S): Bool,
    name: String = "what must come in the end",
): Property[S] {
    Property { name, kind: Kind.Temporal(state(predicate).eventually().term) }
}

/// Whenever `when` holds, `then` does later, or at once.
pub fn leadsTo[S](
    when: fn(S): Bool,
    then: fn(S): Bool,
    name: String = "what must follow",
): Property[S] {
    Property {
        name
        kind: Kind.Temporal(state(when).implies(state(then).eventually()).always().term)
        applies: some(when)
    }
}

/// `predicate` holds again and again, for ever.
pub fn infinitelyOften[S](
    predicate: fn(S): Bool,
    name: String = "what must keep coming",
): Property[S] {
    Property { name, kind: Kind.Temporal(state(predicate).eventually().always().term) }
}

/// From some state on, `predicate` always holds.
pub fn eventuallyAlways[S](predicate: fn(S): Bool, name: String = "what must settle"): Property[S] {
    Property { name, kind: Kind.Temporal(state(predicate).always().eventually().term) }
}

/// From every state, one `predicate` holds of can still be reached, whatever
/// came before.
pub fn reachable[S](
    predicate: fn(S): Bool,
    name: String = "what must stay within reach",
): Property[S] {
    Property { name, kind: Kind.Reachable(predicate) }
}

/// Every run is one `formula` holds of.
pub fn temporal[S](formula: Formula[S], name: String = "the formula"): Property[S] {
    Property { name, kind: Kind.Temporal(formula.term) }
}

/// A step that cannot be put off for ever, by its name: `weak` if it stays
/// possible, `strong` if it is possible again and again.
///
/// ```tondo
/// import std.model
///
/// _ = [model.weak("tick"), model.strong("grant")]
/// ```
pub type Fair = {
    priv step: String
    priv strong: Bool
    priv each: Bool = false
}

/// A step that comes if it stays possible. With `each`, each step named
/// `name` and then a space and more, as each task's `"resume {t}"`: each one
/// comes, rather than one of them.
pub fn weak(name: String, each: Bool = false): Fair {
    Fair { step: name, strong: false, each }
}

/// A step that comes if it keeps becoming possible, even if not all the time;
/// with `each`, each step of that name, as `weak` says.
pub fn strong(name: String, each: Bool = false): Fair {
    Fair { step: name, strong: true, each }
}

/// The fairness asked, with one for each step that one `each` stands for.
fn perStep[S](graph: Graph[S], fair: Array[Fair]): Array[Fair] {
    if not fair.any((one) { one.each }) {
        return fair
    }
    var named = Set[String]()
    for out in graph.edges {
        for edge in out {
            _ = named.insert(edge.name)
        }
    }
    var names: Array[String] = named.values().collect()
    names.sort()
    var all: Array[Fair] = []
    for one in fair {
        match one.each {
            false => all.push(one)
            true => {
                for name in names {
                    if name == one.step or name.startsWith("{one.step} ") {
                        all.push(Fair { step: name, strong: one.strong })
                    }
                }
            }
        }
    }
    all
}

type Edge = {
    name: String
    to: Int
}

/// What came before each state: the state and the step, or -1 for the start.
type Reached = {
    from: Int
    name: String
}

/// The states of a model and its steps.
type Graph[S] = {
    /// In memory: the states, by number. On disk, none: `disk` says where.
    states: Array[S]
    count: Int
    disk: Disk?
    edges: Array[Array[Edge]]
    reached: Array[Reached]
    depth: Int
}

fn shown[S: reflect.Reflect](value: S): String {
    "{reflect.valueOf(value)}"
}

fn visits[S: reflect.Reflect + serialization.Decode](graph: Graph[S], end: Int): Array[Visit] {
    var path: Array[Visit] = []
    var at = end
    for {
        let came = graph.reached[at]
        path.push(Visit { step: came.name, state: shown(stateOf(graph, at)) })
        if came.from < 0 {
            return path.reversed()
        }
        at = came.from
    }
}

/// Where the states of a model too big to hold go: a file for each level of
/// the search, as JSON a line each, and of each state in memory only its
/// fingerprint and what came before it, as TLC keeps them.
type Disk = {
    directory: String
    /// The number of the first state of each level.
    starts: Array[Int]
}

fn levelFile(directory: String, level: Int): String {
    "{directory}/states-{level}.jsonl"
}

/// The state numbered `at`, from memory or from its level's file.
fn stateOf[S: serialization.Decode](graph: Graph[S], at: Int): S {
    match graph.disk {
        none => graph.states[at]
        some(disk) => {
            var level = 0
            for level + 1 < disk.starts.length() and disk.starts[level + 1] <= at {
                level += 1
            }
            levelStates[S](disk.directory, level)[at - disk.starts[level]]
        }
    }
}

/// The states of a level, as `exploreOnDisk` wrote them.
fn levelStates[S: serialization.Decode](directory: String, level: Int): Array[S] {
    let text = fs.readText(levelFile(directory, level)) ?? ""
    var states: Array[S] = []
    for line in text.lines() {
        match json.decode[S](line) {
            ok(read) => states.push(read)
            err(error) => panic(
                "a state written to {levelFile(directory, level)} cannot be read: {error}",
            )
        }
    }
    states
}

/// What `of` says of each state, in order of their numbers.
fn eachState[S: serialization.Decode, T](graph: Graph[S], of: fn(S): T): Array[T] {
    match graph.disk {
        none => graph.states.map(of)
        some(disk) => {
            var all: Array[T] = []
            for level in 0..disk.starts.length() {
                all.extend(levelStates[S](disk.directory, level).map(of))
            }
            all
        }
    }
}

/// Goes through every state `steps` reaches from `start`, nearest first, and
/// fails at the first one that breaks what `holds` says, or that `ends` says
/// should not end with no step left, with the shortest way there and each
/// state on it; then at the first property of what comes later that a run
/// breaks, with the loop that breaks it. A step in `fair` comes as it says
/// rather than be put off for ever. `symmetry` gives the one state that
/// stands for all those it equals, as the same with the tasks numbered
/// otherwise, so that only it is gone through. `workers` tasks work out what
/// follows each state at once, with the same result as one. With `disk`, a
/// directory, the states go there, a level of the search at a time, and in
/// memory stay only a fingerprint of each, as TLC keeps them, and the steps.
///
/// A run takes a step whenever one is possible; one that ends stays at its
/// last state.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// fn steps(count: Int): Array[model.Step[Int]] {
///     if count < 3 { [model.step("add", count + 1)] } else { [] }
/// }
///
/// let holds = [model.always((count: Int) { count <= 3 }), model.eventually((count: Int) { count == 3 })]
/// match model.check(0, steps, holds: holds) {
///     ok(checked) => console.println("{checked.states} states")
///     err(broken) => console.println("{broken}")
/// }
/// ```
pub fn check[S: reflect.Reflect + serialization.Encode + serialization.Decode](
    start: S,
    steps: fn(S): Array[Step[S]],
    holds: Array[Property[S]] = [],
    fair: Array[Fair] = [],
    ends: (fn(S): Bool)? = none,
    symmetry: (fn(S): S)? = none,
    workers: Int = 1,
    disk: String? = none,
): Checked ! Violation {
    reported("check", checking(start, steps, holds, fair, ends, symmetry, workers, disk))
}

fn checking[S: reflect.Reflect + serialization.Encode + serialization.Decode](
    start: S,
    steps: fn(S): Array[Step[S]],
    holds: Array[Property[S]],
    fair: Array[Fair],
    ends: (fn(S): Bool)?,
    symmetry: (fn(S): S)?,
    workers: Int,
    disk: String?,
): Checked ! Violation {
    let graph =
        explore(
            start,
            (current: S): Array[Step[S]] ! String { steps(current) },
            holds,
            ends,
            symmetry,
            workers,
            disk,
        )?
    properties(graph, holds, fair)?
    Checked {
        states: graph.count
        steps: graph.edges.map((out) { out.length() }).sum()
        depth: graph.depth
        never: []
        vacuous: vacuous(holds, (applies) { eachState(graph, applies).any((held) { held }) })
    }
}

/// Tells `tondo test` what a model came to, in a build of tests, and gives it
/// back.
fn reported(kind: String, result: Checked ! Violation): Checked ! Violation {
    if modelNative.recording() {
        let listed = (list: Array[Visit]) {
            let entries = list.map(
                (visit) {
                    "{{\"step\":{json.encode(visit.step)},\"state\":{json.encode(visit.state)}}}"
                },
            )
            "[{entries.join(",")}]"
        }
        let quoted = (list: Array[String]) {
            "[{list.map((name) { json.encode(name) }).join(",")}]"
        }
        let text = match result {
            ok(checked) =>
                "{{\"kind\":{json.encode(kind)},\"states\":{checked.states},\"steps\":{checked.steps},\"depth\":{checked.depth},\"never\":{quoted(checked.never)},\"vacuous\":{quoted(checked.vacuous)},\"broken\":null}}"
            err(broken) =>
                "{{\"kind\":{json.encode(kind)},\"broken\":{{\"what\":{json.encode(broken.what)},\"property\":{json.encode(broken.property)},\"path\":{listed(broken.path)},\"loop\":{listed(broken.loop)}}}}}"
        }
        modelNative.report(text)
    }
    result
}

/// The names of the properties of `holds` that what starts them never came
/// to, as `came` says of each.
fn vacuous[S](holds: Array[Property[S]], came: fn(fn(S): Bool): Bool): Array[String] {
    var idle: Array[String] = []
    for property in holds {
        match property.applies {
            some(applies) if not came(applies) => idle.push(property.name)
            _ => {}
        }
    }
    idle
}

/// What comes of the properties that are checked once every state is known.
fn properties[S: reflect.Reflect + serialization.Decode](
    graph: Graph[S],
    holds: Array[Property[S]],
    asked: Array[Fair],
): !Violation {
    let fair = perStep(graph, asked)
    for property in holds {
        match property.kind {
            Kind.Invariant(_) => {}
            Kind.Reachable(goal) => {
                match stranded(graph.edges, eachState(graph, goal)) {
                    some(at) => fail Violation {
                        what: "`{property.name}` is out of reach from here"
                        path: visits(graph, at)
                        loop: []
                        property: property.name
                    }
                    none => {}
                }
            }
            Kind.Temporal(term) => later(graph, term, property.name, fair)?
        }
    }
}

/// Goes through every state a state machine of the program reaches, as
/// `check` does, with the function that gives the next state for an event,
/// the same one the program calls: there is no model to keep in step with
/// the code. An event it fails for is one that cannot happen there; one it
/// panics for breaks the machine, and says how it got there.
///
/// Each event is tried in each state, every value of `E` that there is, as
/// `model.every` gives them, unless `events` says which can happen in a
/// state. `Checked.never` names those no state took.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// enum Event {
///     Open
///     Close
/// }
///
/// fn apply(open: Bool, event: Event): Bool ! String {
///     match event {
///         Event.Open if open => fail "already open"
///         Event.Open => true
///         Event.Close => false
///     }
/// }
///
/// match model.machine(false, apply, holds: [model.infinitelyOften((open: Bool) { not open })]) {
///     ok(checked) => console.println("{checked.states} states")
///     err(broken) => console.println("{broken}")
/// }
/// ```
pub fn machine[
    S: reflect.Reflect + serialization.Encode + serialization.Decode,
    E: reflect.Reflect + serialization.Decode,
    X,
](
    start: S,
    apply: fn(S, E): S ! X,
    events: (fn(S): Array[E])? = none,
    holds: Array[Property[S]] = [],
    fair: Array[Fair] = [],
    ends: (fn(S): Bool)? = none,
    symmetry: (fn(S): S)? = none,
    workers: Int = 1,
    disk: String? = none,
): Checked ! Violation {
    reported("machine", machining(start, apply, events, holds, fair, ends, symmetry, workers, disk))
}

fn machining[
    S: reflect.Reflect + serialization.Encode + serialization.Decode,
    E: reflect.Reflect + serialization.Decode,
    X,
](
    start: S,
    apply: fn(S, E): S ! X,
    events: (fn(S): Array[E])?,
    holds: Array[Property[S]],
    fair: Array[Fair],
    ends: (fn(S): Bool)?,
    symmetry: (fn(S): S)?,
    workers: Int,
    disk: String?,
): Checked ! Violation {
    let all: Array[E] = match events {
        some(_) => []
        none => match every[E]() {
            ok(all) => all
            err(why) => fail Violation {
                what: "{why}: give the events, as `events: (state) {{ [...] }}`"
                path: [Visit { step: "", state: shown(start) }]
                loop: []
            }
        }
    }
    var named = Set[String]()
    let steps = (current: S): Array[Step[S]] ! String {
        let tried = match events {
            some(given) => given(current)
            none => all
        }
        var next: Array[Step[S]] = []
        for event in tried {
            let name = shown(event)
            match recover { apply(current, event) } {
                ok(ok(after)) => next.push(Step { name, state: after })
                ok(err(_)) => {}
                err(broke) => fail "`{name}` panics: {broke.message}"
            }
        }
        next
    }
    let graph = explore(start, steps, holds, ends, symmetry, workers, disk)?
    properties(graph, holds, fair)?
    for out in graph.edges {
        for edge in out {
            _ = named.insert(edge.name)
        }
    }
    let never = all.map((event) { shown(event) }).filter((name) { not named.contains(name) })
    Checked {
        states: graph.count
        steps: graph.edges.map((out) { out.length() }).sum()
        depth: graph.depth
        never
        vacuous: vacuous(holds, (applies) { eachState(graph, applies).any((held) { held }) })
    }
}

/// Every value of `T` there is: each variant of an enum with each value of
/// what it holds, of a record each value of each field, of an option `none`
/// and each value, and of a `Bool` both. A number or a string has no end, and
/// a type that holds one fails with a message that says where.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// enum Light {
///     Off
///     On(Bool)
/// }
///
/// match model.every[Light]() {
///     ok(all) => console.println("{all.length()} lights")
///     err(why) => console.println(why)
/// }
/// ```
pub fn every[T: reflect.Reflect + serialization.Decode](): Array[T] ! String {
    var all: Array[T] = []
    for text in written(reflect.typeInfo[T](), 0)? {
        match json.decode[T](text) {
            ok(value) => all.push(value)
            err(error) => fail "`{reflect.typeInfo[T]().qualifiedName()}` cannot be built from {text}: {error}"
        }
    }
    all
}

/// Each value of a type as JSON writes it, which `json.decode` builds.
fn written(info: reflect.TypeInfo, depth: Int): Array[String] ! String {
    let name = info.qualifiedName()
    if depth > 8 {
        fail "`{name}` holds itself, so its values have no end"
    }
    match info.kind() {
        reflect.TypeKind.Primitive(reflect.PrimitiveKind.Bool) => ["true", "false"]
        reflect.TypeKind.Enum => {
            var all: Array[String] = []
            for variant in info.variants() {
                let label = json.encode(variant.externalName())
                match variant.payloadKind() {
                    reflect.VariantPayloadKind.Unit => all.push(label)
                    reflect.VariantPayloadKind.Tuple => {
                        let parts = variant.tupleElements()
                        for values in combinations(valuesOfEach(parts, depth)?) {
                            let held = if values.length() == 1 {
                                values[0]
                            } else {
                                "[{values.join(",")}]"
                            }
                            all.push("{{{label}:{held}}}")
                        }
                    }
                    reflect.VariantPayloadKind.Record => {
                        for held in record(variant.fields(), depth)? {
                            all.push("{{{label}:{held}}}")
                        }
                    }
                }
            }
            all
        }
        reflect.TypeKind.Record => record(info.fields(), depth)?
        reflect.TypeKind.Newtype => match info.underlying() {
            some(underlying) => written(underlying, depth + 1)?
            none => fail "`{name}` has no values to go through"
        }
        reflect.TypeKind.Tuple => {
            combinations(valuesOfEach(info.tupleElements(), depth)?).map(
                (values) { "[{values.join(",")}]" },
            )
        }
        reflect.TypeKind.Applied(reflect.AppliedKind.Option) => {
            var all = ["null"]
            all.extend(written(info.genericArguments()[0], depth + 1)?)
            all
        }
        _ => fail "`{name}` has no end, so its values cannot all be gone through"
    }
}

fn record(fields: Array[reflect.FieldInfo], depth: Int): Array[String] ! String {
    let parts = valuesOfEach(fields.map((field) { field.typeInfo() }), depth)?
    let names = fields.map((field) { json.encode(field.externalName()) })
    combinations(parts).map(
        (values) {
            let pairs = names.zip(values).map((pair) { "{pair.0}:{pair.1}" })
            "{{{pairs.join(",")}}}"
        },
    )
}

/// The values of each type.
fn valuesOfEach(types: Array[reflect.TypeInfo], depth: Int): Array[Array[String]] ! String {
    var all: Array[Array[String]] = []
    for info in types {
        all.push(written(info, depth + 1)?)
    }
    all
}

/// Each way to take one of each list.
fn combinations(lists: Array[Array[String]]): Array[Array[String]] {
    var all: Array[Array[String]] = [[]]
    for list in lists {
        var grown: Array[Array[String]] = []
        for before in all {
            for value in list {
                var more = before
                more.push(value)
                grown.push(more)
            }
        }
        all = grown
    }
    all
}

/// What was checked, or a failure of the test that calls it with what
/// broke, step by step.
///
/// ```tondo
/// import std.model
///
/// fn steps(count: Int): Array[model.Step[Int]] {
///     if count < 2 { [model.step("add", count + 1)] } else { [] }
/// }
///
/// let checked = model.expect(model.check(0, steps, holds: [model.always((count: Int) { count <= 2 })]))
/// assert(checked.states == 3)
/// ```
pub fn expect(checked: Checked ! Violation): Checked {
    match checked {
        ok(done) => done
        err(broken) => panic("{broken}")
    }
}

fn explore[S: reflect.Reflect + serialization.Encode + serialization.Decode](
    start: S,
    steps: fn(S): Array[Step[S]] ! String,
    holds: Array[Property[S]],
    ends: (fn(S): Bool)?,
    symmetry: (fn(S): S)?,
    workers: Int,
    disk: String?,
): Graph[S] ! Violation {
    let canonical = (raw: S) {
        match symmetry {
            some(stands) => stands(raw)
            none => raw
        }
    }
    let canonicalSteps = (current: S): Array[Step[S]] ! String {
        steps(current)?.map((taken) { taken with { state: canonical(taken.state) } })
    }
    match disk {
        some(directory) => return exploreOnDisk(
            canonical(start),
            canonicalSteps,
            holds,
            ends,
            workers,
            directory,
        )
        none => {}
    }
    let first = canonical(start)
    let known = identity[S]()
    var numbers: Map[String, Int] = [:]
    _ = numbers.insert(known(first), 0)
    var graph = Graph[S] {
        states: [first]
        count: 1
        disk: none
        edges: []
        reached: [Reached { from: -1, name: "" }]
        depth: 0
    }
    var depths = [0]
    var next = 0
    // The states found and not gone through yet, as a batch: what follows
    // each is worked out by `workers` tasks, and taken in order, so that
    // the result is the same with one.
    for next < graph.states.length() {
        let (from, end) = (next, graph.states.length())
        next = end
        let found = ahead(graph.states, from, end, canonicalSteps, workers)
        for at in from..end {
            explored(var graph, var numbers, var depths, at, found[at - from], holds, ends, known)?
        }
    }
    graph
}

/// `explore` with the states on disk, a level of the search at a time, and in
/// memory only their fingerprints, what came before each, and the steps.
fn exploreOnDisk[S: reflect.Reflect + serialization.Encode + serialization.Decode](
    first: S,
    steps: fn(S): Array[Step[S]] ! String,
    holds: Array[Property[S]],
    ends: (fn(S): Bool)?,
    workers: Int,
    directory: String,
): Graph[S] ! Violation {
    let failed = (why: String) {
        Violation {
            what: "the states cannot go to {directory}: {why}"
            path: [Visit { step: "", state: shown(first) }]
            loop: []
        }
    }
    if not fs.exists(directory) {
        match fs.createDirectory(directory) {
            ok(_) => {}
            err(error) => fail failed("{error}")
        }
    }
    // What an earlier search left there.
    for name in (fs.list(directory) ?? []) {
        if name.startsWith("states-") {
            _ = fs.remove("{directory}/{name}")
        }
    }
    let known = identity[S]()
    let print = (value: S) { hash.xxhash64(known(value).bytes()) }
    var prints: Map[UInt, Int] = [:]
    _ = prints.insert(print(first), 0)
    match fs.writeText(levelFile(directory, 0), "{json.encode(first)}\n") {
        ok(_) => {}
        err(error) => fail failed("{error}")
    }
    var starts = [0]
    var graph = Graph[S] {
        states: []
        count: 1
        disk: Disk { directory, starts }
        edges: []
        reached: [Reached { from: -1, name: "" }]
        depth: 0
    }
    var level = 0
    for {
        let current = levelStates[S](directory, level)
        let base = starts[level]
        let found = ahead(current, 0, current.length(), steps, workers)
        var lines: Array[String] = []
        for index in 0..current.length() {
            let at = base + index
            let here = current[index]
            for property in holds {
                match property.kind {
                    Kind.Invariant(predicate) if not predicate(here) => {
                        fail Violation {
                            what: "`{property.name}` does not hold"
                            path: visits(graph, at)
                            loop: []
                            property: property.name
                        }
                    }
                    _ => {}
                }
            }
            let next = match found[index] {
                ok(next) => next
                err(why) => fail Violation { what: why, path: visits(graph, at), loop: [] }
            }
            match ends {
                some(allowed) if next.isEmpty() and not allowed(here) => {
                    fail Violation {
                        what: "nothing can follow here"
                        path: visits(graph, at)
                        loop: []
                    }
                }
                _ => {}
            }
            var out: Array[Edge] = []
            for successor in next {
                let fingerprint = print(successor.state)
                let to = match prints.get(fingerprint) {
                    some(to) => to
                    none => {
                        let to = graph.count
                        _ = prints.insert(fingerprint, to)
                        graph.count += 1
                        graph.reached.push(Reached { from: at, name: successor.name })
                        lines.push(json.encode(successor.state))
                        to
                    }
                }
                out.push(Edge { name: successor.name, to })
            }
            graph.edges.push(out)
        }
        if lines.isEmpty() {
            return graph
        }
        match fs.writeText(levelFile(directory, level + 1), "{lines.join("\n")}\n") {
            ok(_) => {}
            err(error) => fail failed("{error}")
        }
        starts.push(base + current.length())
        graph.disk = Disk { directory, starts }
        graph.depth = level + 1
        level += 1
    }
}

/// What a state is known by: its encoding, the same for equal states, so
/// that a state can hold arrays and maps. The entries of a map encode in the
/// order they came, which says nothing of the map: of a state that can hold
/// one, the keys of every object are put in order.
fn identity[S: reflect.Reflect + serialization.Encode](): fn(S): String {
    var seen = Set[String]()
    match holdsMaps(reflect.typeInfo[S](), var seen) {
        true => (value: S) {
            let text = json.encode(value)
            match json.parse(text) {
                ok(parsed) => sortedJson(parsed)
                err(_) => text
            }
        }
        false => (value: S) { json.encode(value) }
    }
}

/// Whether a value of the type can hold a `Map`, anywhere in it. A union
/// may, as what it is is only known of each value.
fn holdsMaps(info: reflect.TypeInfo, seen: var Set[String]): Bool {
    if not seen.insert(info.qualifiedName()) {
        return false
    }
    var inside: Array[reflect.TypeInfo] = info.genericArguments()
    match info.kind() {
        reflect.TypeKind.Applied(reflect.AppliedKind.Map) => return true
        reflect.TypeKind.Union => return true
        reflect.TypeKind.Record => inside.extend(info.fields().map((field) { field.typeInfo() }))
        reflect.TypeKind.Tuple => inside.extend(info.tupleElements())
        reflect.TypeKind.Newtype => inside.extend(info.underlying().map((under) { [under] }) ?? [])
        reflect.TypeKind.Enum => {
            for variant in info.variants() {
                inside.extend(variant.tupleElements())
                inside.extend(variant.fields().map((field) { field.typeInfo() }))
            }
        }
        _ => {}
    }
    for part in inside {
        if holdsMaps(part, var seen) {
            return true
        }
    }
    false
}

/// A JSON value written with the keys of each object in order, and its
/// numbers as they were.
fn sortedJson(value: json.Value): String {
    match value {
        json.Value.Null => "null"
        json.Value.Bool(flag) => "{flag}"
        json.Value.Number(exact) => exact.text()
        json.Value.Text(text) => json.encode(text)
        json.Value.Array(items) => "[{items.map(sortedJson).join(",")}]"
        json.Value.Object(entries) => {
            var keys: Array[String] = entries.keys().collect()
            keys.sort()
            let pairs = keys.map(
                (key) { "{json.encode(key)}:{sortedJson(entries.get(key) ?? json.Value.Null)}" },
            )
            "{{{pairs.join(",")}}}"
        }
    }
}

/// What follows each state from `from` to `end`, by `workers` tasks.
fn ahead[S](
    states: Array[S],
    from: Int,
    end: Int,
    steps: fn(S): Array[Step[S]] ! String,
    workers: Int,
): Array[Array[Step[S]] ! String] {
    let ids: Array[Int] = (from..end).collect()
    if workers <= 1 or ids.length() < 2 {
        return successors(states, ids, steps)
    }
    var group = Group[Array[Array[Step[S]] ! String]]()
    for chunk in ids.chunks((ids.length() + workers - 1) / workers) {
        group.add(spawn successors(states, chunk, steps))
    }
    group.wait().flatMap((part) { part })
}

fn successors[S](
    states: Array[S],
    ids: Array[Int],
    steps: fn(S): Array[Step[S]] ! String,
): Array[Array[Step[S]] ! String] {
    var found: Array[Array[Step[S]] ! String] = []
    for id in ids {
        found.push(steps(states[id]))
    }
    found
}

/// One state gone through: what must hold of it, and the states that follow.
fn explored[S: reflect.Reflect + serialization.Encode + serialization.Decode](
    graph: var Graph[S],
    numbers: var Map[String, Int],
    depths: var Array[Int],
    at: Int,
    found: Array[Step[S]] ! String,
    holds: Array[Property[S]],
    ends: (fn(S): Bool)?,
    known: fn(S): String,
): !Violation {
    {
        let current = graph.states[at]
        for property in holds {
            match property.kind {
                Kind.Invariant(predicate) if not predicate(current) => {
                    fail Violation {
                        what: "`{property.name}` does not hold"
                        path: visits(graph, at)
                        loop: []
                        property: property.name
                    }
                }
                _ => {}
            }
        }
        let next = match found {
            ok(next) => next
            err(why) => fail Violation { what: why, path: visits(graph, at), loop: [] }
        }
        match ends {
            some(allowed) if next.isEmpty() and not allowed(current) => {
                fail Violation {
                    what: "nothing can follow here"
                    path: visits(graph, at)
                    loop: []
                }
            }
            _ => {}
        }
        var out: Array[Edge] = []
        for successor in next {
            let reached = successor.state
            let identified = known(reached)
            let to = match numbers.get(identified) {
                some(to) => to
                none => {
                    let to = graph.states.length()
                    _ = numbers.insert(identified, to)
                    graph.states.push(reached)
                    graph.count += 1
                    graph.reached.push(Reached { from: at, name: successor.name })
                    depths.push(depths[at] + 1)
                    graph.depth = graph.depth.max(depths[at] + 1)
                    to
                }
            }
            out.push(Edge { name: successor.name, to })
        }
        graph.edges.push(out)
    }
}

/// For each state, the states with a step to it.
fn incoming(edges: Array[Array[Edge]]): Array[Array[Int]] {
    let empty: Array[Int] = []
    var into = [empty].repeat(edges.length())
    for from in 0..edges.length() {
        for edge in edges[from] {
            into[edge.to].push(from)
        }
    }
    into
}

/// The first state from which no state in `goals` can be reached.
fn stranded(edges: Array[Array[Edge]], goals: Array[Bool]): Int? {
    let into = incoming(edges)
    var can = goals
    var pending: Array[Int] = []
    for at in 0..goals.length() {
        if goals[at] {
            pending.push(at)
        }
    }
    for {
        let at = match pending.pop() {
            some(at) => at
            none => break
        }
        for from in into[at] {
            if not can[from] {
                can[from] = true
                pending.push(from)
            }
        }
    }
    for at in 0..can.length() {
        if not can[at] {
            return at
        }
    }
    none
}

// What comes later is checked as Gerth, Peled, Vardi and Wolper build it: the
// formula's negation becomes an automaton of the runs that break it, which
// goes along the model's states, and a loop of the two together that the
// automaton accepts, and that gives each fair step its due, is a run that
// breaks the formula.

/// A part of a formula in negation normal form, numbered in `Formulas`.
enum Op {
    Atom(Int, Bool)
    True
    False
    And(Int, Int)
    Or(Int, Int)
    Next(Int)
    Until(Int, Int)
    Release(Int, Int)
}

type Formulas[S] = {
    ops: Array[Op]
    numbers: Map[Op, Int]
    atoms: Array[fn(S): Bool]
}

fn number[S](formulas: var Formulas[S], op: Op): Int {
    match formulas.numbers.get(op) {
        some(known) => known
        none => {
            let id = formulas.ops.length()
            formulas.ops.push(op)
            _ = formulas.numbers.insert(op, id)
            id
        }
    }
}

/// The formula, or its negation, with negation only on atoms.
fn normal[S](formulas: var Formulas[S], term: Term[S], negated: Bool): Int {
    match term {
        Term.Atom(predicate) => {
            formulas.atoms.push(predicate)
            number(var formulas, Op.Atom(formulas.atoms.length() - 1, not negated))
        }
        Term.True => number(var formulas, if negated { Op.False } else { Op.True })
        Term.False => number(var formulas, if negated { Op.True } else { Op.False })
        Term.Not(inner) => normal(var formulas, inner, not negated)
        Term.And(left, right) => {
            let (a, b) = (normal(var formulas, left, negated), normal(var formulas, right, negated))
            number(var formulas, if negated { Op.Or(a, b) } else { Op.And(a, b) })
        }
        Term.Or(left, right) => {
            let (a, b) = (normal(var formulas, left, negated), normal(var formulas, right, negated))
            number(var formulas, if negated { Op.And(a, b) } else { Op.Or(a, b) })
        }
        Term.Next(after) => {
            let a = normal(var formulas, after, negated)
            number(var formulas, Op.Next(a))
        }
        Term.Until(left, right) => {
            let (a, b) = (normal(var formulas, left, negated), normal(var formulas, right, negated))
            number(var formulas, if negated { Op.Release(a, b) } else { Op.Until(a, b) })
        }
        Term.Release(left, right) => {
            let (a, b) = (normal(var formulas, left, negated), normal(var formulas, right, negated))
            number(var formulas, if negated { Op.Until(a, b) } else { Op.Release(a, b) })
        }
    }
}

/// A node of the automaton as it is built: what leads to it, what is left to
/// split, what holds in it and what must hold next.
type Tableau = {
    incoming: Set[Int]
    pending: Set[Int]
    old: Set[Int]
    next: Set[Int]
}

/// A node of the automaton: the nodes with a step to it, and what holds in
/// it, which a state it goes along with must satisfy.
type Node = {
    incoming: Set[Int]
    old: Set[Int]
}

fn sorted(set: Set[Int]): Array[Int] {
    var values: Array[Int] = []
    for value in set.values() {
        values.push(value)
    }
    values.sorted()
}

fn setOf(values: Array[Int]): Set[Int] {
    var set = Set[Int]()
    for value in values {
        _ = set.insert(value)
    }
    set
}

fn just(value: Int): Set[Int] {
    plus(Set[Int](), value)
}

fn plus(set: Set[Int], value: Int): Set[Int] {
    var more = set
    _ = more.insert(value)
    more
}

/// The automaton of the runs `root` holds of. The start leads to the nodes
/// whose `incoming` holds -1.
fn automaton[S](formulas: Formulas[S], root: Int): Array[Node] {
    var done: Array[Tableau] = []
    var known: Map[String, Int] = [:]
    var pending = [
        Tableau { incoming: just(-1), pending: just(root), old: Set[Int](), next: Set[Int]() },
    ]
    for {
        var node = match pending.pop() {
            some(node) => node
            none => break
        }
        if node.pending.length() == 0 {
            let key = "{sorted(node.old).join(",")}|{sorted(node.next).join(",")}"
            match known.get(key) {
                some(at) => {
                    for from in node.incoming.values() {
                        _ = done[at].incoming.insert(from)
                    }
                }
                none => {
                    let at = done.length()
                    _ = known.insert(key, at)
                    done.push(node)
                    pending.push(
                        Tableau {
                            incoming: just(at)
                            pending: node.next
                            old: Set[Int]()
                            next: Set[Int]()
                        },
                    )
                }
            }
            continue
        }
        let formula = sorted(node.pending)[0]
        _ = node.pending.remove(formula)
        if node.old.contains(formula) {
            pending.push(node)
            continue
        }
        let old = plus(node.old, formula)
        let more = (set: Set[Int], ids: Array[Int]) {
            var grown = set
            for id in ids {
                if not old.contains(id) {
                    _ = grown.insert(id)
                }
            }
            grown
        }
        match formulas.ops[formula] {
            Op.True => pending.push(node with { old: old })
            Op.False => {}
            Op.Atom(atom, positive) => {
                let opposite = formulas.numbers.get(Op.Atom(atom, not positive))
                if not (opposite.map((id) { node.old.contains(id) }) ?? false) {
                    pending.push(node with { old: old })
                }
            }
            Op.And(a, b) => pending.push(
                node with { old: old, pending: more(node.pending, [a, b]) },
            )
            Op.Or(a, b) => {
                pending.push(node with { old: old, pending: more(node.pending, [a]) })
                pending.push(node with { old: old, pending: more(node.pending, [b]) })
            }
            Op.Next(a) => pending.push(node with { old: old, next: plus(node.next, a) })
            Op.Until(a, b) => {
                pending.push(
                    node with {
                        old: old
                        pending: more(node.pending, [a])
                        next: plus(node.next, formula)
                    },
                )
                pending.push(node with { old: old, pending: more(node.pending, [b]) })
            }
            Op.Release(a, b) => {
                pending.push(
                    node with {
                        old: old
                        pending: more(node.pending, [b])
                        next: plus(node.next, formula)
                    },
                )
                pending.push(node with { old: old, pending: more(node.pending, [a, b]) })
            }
        }
    }
    done.map((node) { Node { incoming: node.incoming, old: node.old } })
}

/// The model and the automaton, gone along together: each node a state and a
/// node of the automaton, each step a step of the model.
type Product = {
    states: Array[Int]
    nodes: Array[Int]
    edges: Array[Array[Edge]]
    reached: Array[Reached]
}

/// Checks a property of what comes later: fails with a run that breaks it.
fn later[S: reflect.Reflect + serialization.Decode](
    graph: Graph[S],
    term: Term[S],
    name: String,
    fair: Array[Fair],
): !Violation {
    var formulas = Formulas[S] { ops: [], numbers: [:], atoms: [] }
    let root = normal(var formulas, term, true)
    let nodes = automaton(formulas, root)
    // What each atom says of each state, once.
    let values = eachState(
        graph,
        (current: S) { formulas.atoms.map((predicate) { predicate(current) }) },
    )
    let fits = (at: Int, node: Int) {
        sorted(nodes[node].old).all(
            (id) {
                match formulas.ops[id] {
                    Op.Atom(atom, positive) => values[at][atom] == positive
                    _ => true
                }
            },
        )
    }
    let empty: Array[Int] = []
    var after = [empty].repeat(nodes.length())
    var first: Array[Int] = []
    for at in 0..nodes.length() {
        for from in nodes[at].incoming.values() {
            if from < 0 { first.push(at) } else { after[from].push(at) }
        }
    }
    // The model's steps, with a state that ends staying where it is.
    let steps = (at: Int) {
        if graph.edges[at].isEmpty() { [Edge { name: "", to: at }] } else { graph.edges[at] }
    }
    var product = Product { states: [], nodes: [], edges: [], reached: [] }
    var numbers: Map[(Int, Int), Int] = [:]
    for node in first {
        if fits(0, node) {
            _ = numbers.insert((0, node), product.states.length())
            product.states.push(0)
            product.nodes.push(node)
            product.reached.push(Reached { from: -1, name: "" })
        }
    }
    var at = 0
    for at < product.states.length() {
        var out: Array[Edge] = []
        for edge in steps(product.states[at]) {
            for node in after[product.nodes[at]] {
                if not fits(edge.to, node) {
                    continue
                }
                let to = match numbers.get((edge.to, node)) {
                    some(to) => to
                    none => {
                        let to = product.states.length()
                        _ = numbers.insert((edge.to, node), to)
                        product.states.push(edge.to)
                        product.nodes.push(node)
                        product.reached.push(Reached { from: at, name: edge.name })
                        to
                    }
                }
                out.push(Edge { name: edge.name, to })
            }
        }
        product.edges.push(out)
        at += 1
    }
    // A node of the automaton accepts an `until` it does not owe.
    var accepting: Array[Array[Bool]] = []
    for formula in 0..formulas.ops.length() {
        match formulas.ops[formula] {
            Op.Until(_, b) => accepting.push(
                product.nodes.map(
                    (node) { not nodes[node].old.contains(formula) or nodes[node].old.contains(b) },
                ),
            )
            _ => {}
        }
    }
    let enabled = (one: Fair, node: Int) {
        graph.edges[product.states[node]].any((edge) { edge.name == one.step })
    }
    match fairLoop(product, accepting, fair, enabled) {
        some(loop) => {
            let visit = (node: Int, label: String) {
                Visit {
                    step: if label.isEmpty() { "(stays)" } else { label }
                    state: shown(stateOf(graph, product.states[node]))
                }
            }
            var path: Array[Visit] = []
            var back = loop[0].0
            for {
                let came = product.reached[back]
                path.push(
                    if came.from < 0 {
                        Visit { step: "", state: shown(stateOf(graph, product.states[back])) }
                    } else {
                        visit(back, came.name)
                    },
                )
                if came.from < 0 {
                    break
                }
                back = came.from
            }
            fail Violation {
                what: "`{name}` does not hold"
                path: path.reversed()
                loop: loop.drop(1).map((stop) { visit(stop.0, stop.1) })
                property: name
            }
        }
        none => {}
    }
}

/// A loop of the product that the automaton accepts and that is fair: its
/// nodes from the first, back to it, each with the step that led there.
fn fairLoop(
    product: Product,
    accepting: Array[Array[Bool]],
    fair: Array[Fair],
    enabled: fn(Fair, Int): Bool,
): Array[(Int, String)]? {
    let all: Array[Int] = (0..product.states.length()).collect()
    var pending = [all]
    for {
        let region = match pending.pop() {
            some(region) => region
            none => return none
        }
        for part in components(product.edges, region) {
            let inside = setOf(part)
            let looped = part.any(
                (at) { product.edges[at].any((edge) { inside.contains(edge.to) }) },
            )
            if not looped {
                continue
            }
            let taken = (one: Fair) {
                part.any(
                    (at) {
                        product.edges[at].any(
                            (edge) { edge.name == one.step and inside.contains(edge.to) },
                        )
                    },
                )
            }
            // A strong step possible here and never taken: the loops left
            // are those that avoid where it is possible.
            match fair.find(
                (one) { one.strong and not taken(one) and part.any((at) { enabled(one, at) }) },
            ) {
                some(owed) => {
                    pending.push(part.filter((at) { not enabled(owed, at) }))
                    continue
                }
                none => {}
            }
            let unfair = fair.any(
                (one) { not one.strong and not taken(one) and part.all((at) { enabled(one, at) }) },
            )
            let accepted = accepting.all((set) { part.any((at) { set[at] }) })
            if unfair or not accepted {
                continue
            }
            // Round the loop: each accepting set, each fair step taken, and a
            // node where each weak one is not possible, then back.
            let start = part[0]
            var targets: Array[fn(Int, Edge): Bool] = []
            for set in accepting {
                targets.push((_: Int, edge: Edge) { set[edge.to] })
            }
            for one in fair {
                if taken(one) {
                    targets.push((_: Int, edge: Edge) { edge.name == one.step })
                } else {
                    targets.push((_: Int, edge: Edge) { not enabled(one, edge.to) })
                }
            }
            var loop = [(start, "")]
            var here = start
            for target in targets {
                match route(product.edges, inside, here, target) {
                    some(way) => {
                        loop.extend(way)
                        here = way.last().map((last) { last.0 }) ?? here
                    }
                    none => {}
                }
            }
            // Back to where it started, unless it is there already.
            if here != start or loop.length() == 1 {
                match route(product.edges, inside, here, (_: Int, edge: Edge) { edge.to == start }) {
                    some(way) => loop.extend(way)
                    none => {}
                }
            }
            return loop
        }
    }
}

/// The shortest way among `inside` from `start`, of at least one step, to a
/// step that `found` holds of, as the nodes and the steps that reach them.
fn route(
    edges: Array[Array[Edge]],
    inside: Set[Int],
    start: Int,
    found: fn(Int, Edge): Bool,
): Array[(Int, String)]? {
    var from: Map[Int, (Int, String)] = [:]
    var pending = Deque[Int]()
    pending.push(start)
    var seen = just(start)
    for {
        let at = match pending.popFront() {
            some(at) => at
            none => return none
        }
        for edge in edges[at] {
            if not inside.contains(edge.to) {
                continue
            }
            if found(at, edge) {
                var way = [(edge.to, edge.name)]
                var back = at
                for back != start {
                    let came = from.get(back) ?? (start, "")
                    way.push((back, came.1))
                    back = came.0
                }
                return some(way.reversed())
            }
            if seen.insert(edge.to) {
                _ = from.insert(edge.to, (at, edge.name))
                pending.push(edge.to)
            }
        }
    }
}

/// The strongly connected parts of the nodes of `region`, by Kosaraju.
fn components(edges: Array[Array[Edge]], region: Array[Int]): Array[Array[Int]] {
    let inside = setOf(region)
    var seen = Set[Int]()
    var finished: Array[Int] = []
    for root in region {
        if not seen.insert(root) {
            continue
        }
        var stack = [(root, 0)]
        for {
            let (at, next) = match stack.last() {
                some(top) => top
                none => break
            }
            if next == edges[at].length() {
                finished.push(at)
                _ = stack.pop()
                continue
            }
            stack[stack.length() - 1] = (at, next + 1)
            let to = edges[at][next].to
            if inside.contains(to) and seen.insert(to) {
                stack.push((to, 0))
            }
        }
    }
    let empty: Array[Int] = []
    var into: Map[Int, Array[Int]] = [:]
    for from in region {
        for edge in edges[from] {
            if inside.contains(edge.to) {
                var list = into[edge.to] ?? empty
                list.push(from)
                _ = into.insert(edge.to, list)
            }
        }
    }
    var assigned = Set[Int]()
    var parts: Array[Array[Int]] = []
    for root in finished.reversed() {
        if not assigned.insert(root) {
            continue
        }
        var part = [root]
        var pending = [root]
        for {
            let at = match pending.pop() {
                some(at) => at
                none => break
            }
            for from in (into[at] ?? empty) {
                if assigned.insert(from) {
                    part.push(from)
                    pending.push(from)
                }
            }
        }
        parts.push(part)
    }
    parts
}

// The code and its model, kept in step: the code marks the steps of the model
// it takes, and a test holds what it marked, in every order of its tasks, to
// what the model can do.

context Marking = {
    observe: (fn(String))? = none
}

/// Says that the code takes `step` of its model here, for `follows` and
/// `watch` to see in a test. Outside the build of tests it does nothing and
/// costs nothing.
///
/// ```tondo
/// import std.model
///
/// fn grant(holder: Int): Int {
///     model.mark("grant")
///     holder
/// }
///
/// _ = grant(1)
/// ```
pub fn mark(name: String) {
    if modelNative.recording() {
        match Marking.observe {
            some(observe) => observe(name)
            none => {}
        }
    }
}

/// Runs `code` with what it marks seen, by it and the tasks it starts.
fn marked(code: fn(), observe: fn(String)) {
    with Marking { observe: observe }
    code()
}

/// Runs `code` and holds the steps it marks with `model.mark`, in the order
/// they came, to the model: each must be a step the model can take from where
/// the ones before led it, starting at `start`. A test under
/// `tondo test --schedules all` does so in every order of the code's tasks,
/// so that the code cannot do what the model says it cannot, and a change to
/// one that the other does not follow fails. `Checked.never` names the steps
/// of the model this run did not take.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// fn steps(open: Bool): Array[model.Step[Bool]] {
///     if open { [model.step("close", false)] } else { [model.step("open", true)] }
/// }
///
/// fn door() {
///     model.mark("open")
///     model.mark("close")
/// }
///
/// match model.follows(false, steps, door) {
///     ok(checked) => console.println("followed in {checked.steps} steps")
///     err(broken) => console.println("{broken}")
/// }
/// ```
pub fn follows[S: reflect.Reflect + serialization.Encode + serialization.Decode](
    start: S,
    steps: fn(S): Array[Step[S]],
    code: fn(),
): Checked ! Violation {
    reported("follows", following(start, steps, code))
}

fn following[S: reflect.Reflect + serialization.Encode + serialization.Decode](
    start: S,
    steps: fn(S): Array[Step[S]],
    code: fn(),
): Checked ! Violation {
    let taken = sync.Queue[String]()
    marked(code, (name: String) { taken.push(name) })
    // The states the model can be in after the marks so far, by what they
    // encode to, each with the way there.
    let known = identity[S]()
    var now: Map[String, (S, Array[Visit])] = [:]
    _ = now.insert(known(start), (start, [Visit { step: "", state: shown(start) }]))
    var marks: Array[String] = []
    for took in taken.snapshot() {
        marks.push(took)
        var next: Map[String, (S, Array[Visit])] = [:]
        for (here, path) in now.values() {
            for possible in steps(here) {
                let identified = known(possible.state)
                if possible.name == took and not next.contains(identified) {
                    var longer = path
                    longer.push(Visit { step: took, state: shown(possible.state) })
                    _ = next.insert(identified, (possible.state, longer))
                }
            }
        }
        if next.length() == 0 {
            var paths = now.values()
            let path = paths.next().map((found) { found.1 }) ?? []
            fail Violation { what: "the code took `{took}` where the model cannot", path, loop: [] }
        }
        now = next
    }
    // The steps of the model that this run never took.
    let graph =
        explore(
            start,
            (current: S): Array[Step[S]] ! String { steps(current) },
            [],
            none,
            none,
            1,
            none,
        )?
    var named: Array[String] = []
    for out in graph.edges {
        for edge in out {
            if not named.contains(edge.name) and not marks.contains(edge.name) {
                named.push(edge.name)
            }
        }
    }
    Checked { states: graph.count, steps: marks.length(), depth: marks.length(), never: named }
}

/// Runs `code` and holds what `holds` says to the state `observe` gives at the
/// start, at each step the code marks with `model.mark`, and at the end, as a
/// run of those states: the properties of a model, on the code itself. A test
/// under `tondo test --schedules all` does so in every order of the code's
/// tasks. What comes later is of this run, which ends: `eventually` must come
/// before its end.
///
/// ```tondo
/// import std.console
/// import std.model
/// import std.sync
///
/// let count = sync.Atomic(0)
/// let add = () {
///     _ = count.add(1)
///     model.mark("add")
/// }
/// let holds = [model.always((n: Int) { n <= 1 }), model.eventually((n: Int) { n == 1 })]
/// match model.watch(() { count.load() }, holds, add) {
///     ok(checked) => console.println("{checked.states} states")
///     err(broken) => console.println("{broken}")
/// }
/// ```
pub fn watch[S: reflect.Reflect](
    observe: fn(): S,
    holds: Array[Property[S]],
    code: fn(),
): Checked ! Violation {
    reported("watch", watching(observe, holds, code))
}

fn watching[S: reflect.Reflect](
    observe: fn(): S,
    holds: Array[Property[S]],
    code: fn(),
): Checked ! Violation {
    let first: Array[(String, S)] = [("", observe())]
    let seen = sync.Mutex(first)
    marked(
        code,
        (name: String) {
            let now = observe()
            seen.update((all) { all.push((name, now)) })
        },
    )
    let run = seen.update(
        (all) {
            all.push(("(end)", observe()))
            all
        },
    )
    let trace = run.map((one) { one.1 })
    let upTo = (end: Int) {
        run.take(end + 1).map((one) { Visit { step: one.0, state: shown(one.1) } })
    }
    for property in holds {
        match property.kind {
            Kind.Invariant(predicate) => {
                match trace.findIndex((current) { not predicate(current) }) {
                    some(at) => fail Violation {
                        what: "`{property.name}` does not hold"
                        path: upTo(at)
                        loop: []
                        property: property.name
                    }
                    none => {}
                }
            }
            Kind.Reachable(predicate) => {
                if not trace.any(predicate) {
                    fail Violation {
                        what: "`{property.name}` never came"
                        path: upTo(trace.length() - 1)
                        loop: []
                        property: property.name
                    }
                }
            }
            Kind.Temporal(term) => {
                if not finite(term, trace, 0) {
                    fail Violation {
                        what: "`{property.name}` does not hold of this run"
                        path: upTo(trace.length() - 1)
                        loop: []
                        property: property.name
                    }
                }
            }
        }
    }
    Checked {
        states: trace.length()
        steps: trace.length() - 1
        depth: trace.length() - 1
        never: []
        vacuous: vacuous(holds, (applies) { trace.any(applies) })
    }
}

/// Whether a formula holds of a run that ends, from `at` on: nothing comes
/// after its last state.
fn finite[S](term: Term[S], trace: Array[S], at: Int): Bool {
    match term {
        Term.Atom(predicate) => predicate(trace[at])
        Term.True => true
        Term.False => false
        Term.Not(inner) => not finite(inner, trace, at)
        Term.And(a, b) => finite(a, trace, at) and finite(b, trace, at)
        Term.Or(a, b) => finite(a, trace, at) or finite(b, trace, at)
        Term.Next(inner) => at + 1 < trace.length() and finite(inner, trace, at + 1)
        Term.Until(a, b) => {
            for moment in at..trace.length() {
                if finite(b, trace, moment) {
                    return true
                }
                if not finite(a, trace, moment) {
                    return false
                }
            }
            false
        }
        Term.Release(a, b) => not finite(Term.Until(Term.Not(a), Term.Not(b)), trace, at)
    }
}
