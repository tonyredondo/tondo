// A model of a design, checked in every order of its steps: a state, the steps
// that can follow each one, and what must hold. It finds the shortest way to a
// state that breaks it, before there is any code to test, and runs in a test
// as anything else does.
//
// ```tondo
// import std.console
// import std.model
//
// type Door = { open: Bool, locked: Bool }
//
// fn steps(door: Door): Array[model.Step[Door]] {
//     var next = [model.Step { name: "lock", state: door with { locked: true } }]
//     if not door.locked {
//         next.push(model.Step { name: "open", state: door with { open: true } })
//     }
//     next
// }
//
// let start = Door { open: false, locked: false }
// match model.check(start, steps, (door) { not (door.open and door.locked) }) {
//     ok(checked) => console.println("{checked.states} states")
//     err(broken) => console.println("{broken}")
// }
// ```

/// What can happen from a state: its name, for the path to a fault, and the
/// state it leads to.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// let step = model.Step { name: "add", state: 2 }
/// console.println("{step.name} leads to {step.state}")
/// ```
pub type Step[S] = {
    name: String
    state: S
}

/// How much of a model was checked: every state it can reach.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// let checked = model.Checked { states: 3 }
/// console.println("{checked.states} states")
/// ```
pub type Checked = {
    states: Int
}

/// What broke, and the shortest path of steps that gets there; `loop` is what
/// then goes round for ever, when that is what broke.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// let broken = model.Violation { what: "it broke", path: ["start", "stop"], loop: [] }
/// console.println("{broken}")
/// ```
pub type Violation = {
    what: String
    path: Array[String]
    loop: Array[String]
}

impl Display for Violation {
    fn display(self): String {
        let here = if self.path.isEmpty() { self.what } else { "{self.what}, after: {self.path.join(", ")}" }
        if self.loop.isEmpty() { here } else { "{here}, and round for ever: {self.loop.join(", ")}" }
    }
}

type Reached = {
    from: Int
    name: String
}

type Edge = {
    name: String
    to: Int
}

fn pathTo(reached: Array[Reached], end: Int): Array[String] {
    var path: Array[String] = []
    var at = end
    for reached[at].from >= 0 {
        path.push(reached[at].name)
        at = reached[at].from
    }
    path.reversed()
}

fn broken(what: String, reached: Array[Reached], at: Int): Violation {
    Violation { what, path: pathTo(reached, at), loop: [] }
}

/// For each state, the states with a step to it.
fn incoming(edges: Array[Array[Edge]]): Array[Array[Int]] {
    let empty: Array[Int] = []
    var into = [empty].repeat(edges.length())
    for from in 0..edges.length() {
        for edge in edges[from] {
            into[edge.to].push(from)
        }
    }
    into
}

/// The first state from which no state in `goals` can be reached.
fn stranded(edges: Array[Array[Edge]], goals: Array[Bool]): Int? {
    let into = incoming(edges)
    var can = goals
    var pending: Array[Int] = []
    for at in 0..goals.length() {
        if goals[at] {
            pending.push(at)
        }
    }
    for {
        let at = match pending.pop() {
            some(at) => at
            none => break
        }
        for from in into[at] {
            if not can[from] {
                can[from] = true
                pending.push(from)
            }
        }
    }
    for at in 0..can.length() {
        if not can[at] {
            return some(at)
        }
    }
    none
}

/// Which strongly connected component of the states out of `goals` each is
/// in, by Kosaraju: -1 for those in `goals`.
fn components(edges: Array[Array[Edge]], goals: Array[Bool]): Array[Int] {
    let count = edges.length()
    var seen = goals
    var finished: Array[Int] = []
    for root in 0..count {
        if seen[root] {
            continue
        }
        seen[root] = true
        var stack = [root]
        var next = [0].repeat(count)
        for {
            let at = match stack.last() {
                some(at) => at
                none => break
            }
            if next[at] == edges[at].length() {
                finished.push(at)
                _ = stack.pop()
                continue
            }
            let to = edges[at][next[at]].to
            next[at] += 1
            if not seen[to] {
                seen[to] = true
                stack.push(to)
            }
        }
    }
    let into = incoming(edges)
    var component = [-1].repeat(count)
    var number = 0
    for root in finished.reversed() {
        if component[root] >= 0 {
            continue
        }
        component[root] = number
        var pending = [root]
        for {
            let at = match pending.pop() {
                some(at) => at
                none => break
            }
            for from in into[at] {
                if component[from] < 0 and not goals[from] {
                    component[from] = number
                    pending.push(from)
                }
            }
        }
        number += 1
    }
    component
}

fn enabled(edges: Array[Edge], name: String): Bool {
    edges.any((edge) { edge.name == name })
}

/// The shortest way inside `number` from a state to the first for which
/// `found` holds, as the steps and where it ends; none if no way.
fn route(
    edges: Array[Array[Edge]],
    component: Array[Int],
    number: Int,
    start: Int,
    found: fn(Edge): Bool,
): (Array[String], Int)? {
    var from: Map[Int, Reached] = [:]
    var pending = Deque[Int]()
    pending.push(start)
    _ = from.insert(start, Reached { from: -1, name: "" })
    for {
        let at = match pending.popFront() {
            some(at) => at
            none => return none
        }
        for edge in edges[at] {
            if component[edge.to] != number {
                continue
            }
            if found(edge) {
                var names = [edge.name]
                var back = at
                for {
                    let came = from.get(back).unwrapOr(Reached { from: -1, name: "" })
                    if came.from < 0 {
                        return some((names.reversed(), edge.to))
                    }
                    names.push(came.name)
                    back = came.from
                }
            }
            if not from.contains(edge.to) {
                _ = from.insert(edge.to, Reached { from: at, name: edge.name })
                pending.push(edge.to)
            }
        }
    }
}

/// A way round `number` from `start` back to it that gives every step of
/// `fair` its due, or none if no way round does. A step that stays possible
/// all the way round has to come; one that does not, the loop has to pass
/// where it is not possible.
fn fairLoop(
    edges: Array[Array[Edge]],
    component: Array[Int],
    number: Int,
    start: Int,
    fair: Array[String],
): Array[String]? {
    let inside = (0..edges.length()).filter((at) { component[at] == number }).collect()
    var loop: Array[String] = []
    var at = start
    for name in fair {
        let always = inside.all((state) { enabled(edges[state], name) })
        let found = (edge: Edge) {
            if always { edge.name == name } else { not enabled(edges[edge.to], name) }
        }
        match route(edges, component, number, at, found) {
            some((names, end)) => {
                loop = loop.concat(names)
                at = end
            }
            none => return none
        }
    }
    let home = (edge: Edge) { edge.to == start }
    match route(edges, component, number, at, home) {
        some((names, _)) => some(loop.concat(names))
        none => none
    }
}

fn comesTo(
    edges: Array[Array[Edge]],
    reached: Array[Reached],
    goals: Array[Bool],
    fair: Array[String],
): Unit ! Violation {
    for at in 0..edges.length() {
        if edges[at].isEmpty() and not goals[at] {
            fail broken("it ends without what it must come to", reached, at)
        }
    }
    let component = components(edges, goals)
    var tried = Set[Int]()
    for at in 0..edges.length() {
        let number = component[at]
        if number < 0 or tried.contains(number) {
            continue
        }
        _ = tried.insert(number)
        match fairLoop(edges, component, number, at, fair) {
            some(loop) => fail Violation {
                what: "it need not come to what it must"
                path: pathTo(reached, at)
                loop
            }
            none => {}
        }
    }
}

/// Goes through every state `steps` reaches from `start`, nearest first, and
/// fails at the first where `always` does not hold, or with no step left where
/// `ends` says it should not end, when it is given, with the shortest path
/// there. A state is a `Key`, so that one reached twice is looked at once.
///
/// `reaches` says that from every state a state where it holds can still be
/// reached, whatever came before. `eventually` says more: that every way
/// through comes to one, given that a step named in `fair` comes if it stays
/// possible; what breaks it is a loop that never gets there, or an end.
///
/// ```tondo
/// import std.console
/// import std.model
///
/// fn steps(count: Int): Array[model.Step[Int]] {
///     if count < 3 { [model.Step { name: "add", state: count + 1 }] } else { [] }
/// }
///
/// match model.check(0, steps, (count) { count < 3 }) {
///     ok(checked) => console.println("{checked.states} states")
///     err(broken) => console.println("{broken}")
/// }
/// ```
pub fn check[S: Key](
    start: S,
    steps: fn(S): Array[Step[S]],
    always: fn(S): Bool,
    ends: (fn(S): Bool)? = none,
    reaches: (fn(S): Bool)? = none,
    eventually: (fn(S): Bool)? = none,
    fair: Array[String] = [],
): Checked ! Violation {
    var numbers: Map[S, Int] = [:]
    _ = numbers.insert(start, 0)
    var states = [start]
    var reached = [Reached { from: -1, name: "" }]
    var edges: Array[Array[Edge]] = []
    var at = 0
    for at < states.length() {
        let state = states[at]
        if not always(state) {
            fail broken("what must always hold does not", reached, at)
        }
        let next = steps(state)
        match ends {
            some(allowed) if next.isEmpty() and not allowed(state) => {
                fail broken("nothing can follow here", reached, at)
            }
            _ => {}
        }
        var out: Array[Edge] = []
        for step in next {
            let to = match numbers.get(step.state) {
                some(to) => to
                none => {
                    let to = states.length()
                    _ = numbers.insert(step.state, to)
                    states.push(step.state)
                    reached.push(Reached { from: at, name: step.name })
                    to
                }
            }
            out.push(Edge { name: step.name, to })
        }
        edges.push(out)
        at += 1
    }
    match reaches {
        some(goal) => match stranded(edges, states.map(goal)) {
            some(stuck) => fail broken("what it must reach is out of reach from here", reached, stuck)
            none => {}
        }
        none => {}
    }
    match eventually {
        some(goal) => comesTo(edges, reached, states.map(goal), fair)?
        none => {}
    }
    Checked { states: states.length() }
}
