// std.log (standard library 14.18): structured logging, a line per event,
// as text or JSON, through a logger or the one of the context.

import std.console as __console
import std.internal.context as contextNative
import std.io as __io
import std.json as __json
import std.time as __time

/// How much an event matters, from least to most.
pub enum Level {
    Trace
    Debug
    Info
    Warn
    Error
}

impl Display for Level {
    fn display(self): String {
        match self {
            Level.Trace => "trace"
            Level.Debug => "debug"
            Level.Info => "info"
            Level.Warn => "warn"
            Level.Error => "error"
        }
    }
}

/// `Text` writes `time LEVEL message key=value ...`, quoting values with
/// spaces; `Json` writes an object per line.
pub enum Format {
    Text
    Json
}

/// Writes events of its level or above, with its fields: a program makes
/// one and passes it on, or puts it in `Context`.
pub type Logger = {
    priv output: __io.Writer
    priv minimum: Level
    priv format: Format
    priv timestamps: Bool
    priv context: Map[String, String]
}

/// A logger to `output`, or to standard error without one.
/// `timestamps: false` leaves out the time, for output that tests compare.
pub fn Logger.new(
    output: __io.Writer? = none,
    level: Level = Level.Info,
    format: Format = Format.Text,
    timestamps: Bool = true,
): Logger {
    let stream = match output {
        some(stream) => stream
        none => __console.stderr()
    }
    Logger { output: stream, minimum: level, format, timestamps, context: [:] }
}

/// The same logger with more fields in every event it writes.
pub fn Logger.withFields(self, fields: Map[String, String]): Logger {
    var context = self.context
    for (key, value) in fields {
        context[key] = value
    }
    Logger {
        output: self.output
        minimum: self.minimum
        format: self.format
        timestamps: self.timestamps
        context
    }
}

/// Whether events of this level are written: to skip building costly
/// fields.
pub fn Logger.isEnabled(self, level: Level): Bool {
    rank(level) >= rank(self.minimum)
}

/// Writes an event, if its level is enabled. A stream that fails loses the
/// event; `flush` reports it.
pub fn Logger.log(self, level: Level, message: String, fields: Map[String, String] = [:]) {
    if not self.isEnabled(level) {
        return
    }
    var all = self.context
    // The fields of the contexts marked `@log` (11.16 of the language).
    let shown = contextNative.logged().split("\u{0}")
    var at = 0
    for at + 1 < shown.length() {
        all[shown[at]] = shown[at + 1]
        at += 2
    }
    for (key, value) in fields {
        all[key] = value
    }
    let time = if self.timestamps { some("{__time.utcNow()}") } else { none }
    let line = match self.format {
        Format.Text => text(time, level, message, all)
        Format.Json => object(time, level, message, all)
    }
    _ = self.output.writeLine(line)
}

/// Writes the event at level `Trace`, with its fields, if the logger takes
/// that level.
pub fn Logger.trace(self, message: String, fields: Map[String, String] = [:]) {
    self.log(Level.Trace, message, fields)
}

/// Writes the event at level `Debug`, with its fields, if the logger takes
/// that level.
pub fn Logger.debug(self, message: String, fields: Map[String, String] = [:]) {
    self.log(Level.Debug, message, fields)
}

/// Writes the event at level `Info`, with its fields, if the logger takes
/// that level.
pub fn Logger.info(self, message: String, fields: Map[String, String] = [:]) {
    self.log(Level.Info, message, fields)
}

/// Writes the event at level `Warn`, with its fields, if the logger takes
/// that level.
pub fn Logger.warn(self, message: String, fields: Map[String, String] = [:]) {
    self.log(Level.Warn, message, fields)
}

/// Writes the event at level `Error`, with its fields.
pub fn Logger.error(self, message: String, fields: Map[String, String] = [:]) {
    self.log(Level.Error, message, fields)
}

/// The logger of the work that runs, which the functions of the module
/// write with: `main` puts one there, and code below adds its fields.
pub context Context = {
    logger: Logger? = none
}

/// The logger of `Context`, or without one a logger as `Logger.new()`,
/// which writes to standard error from `Info` on.
pub fn current(): Logger {
    match Context.logger {
        some(logger) => logger
        none => Logger.new()
    }
}

/// Writes the event at level `Trace` with the logger of `Context`.
pub fn trace(message: String, fields: Map[String, String] = [:]) {
    current().log(Level.Trace, message, fields)
}

/// Writes the event at level `Debug` with the logger of `Context`.
pub fn debug(message: String, fields: Map[String, String] = [:]) {
    current().log(Level.Debug, message, fields)
}

/// Writes the event at level `Info` with the logger of `Context`.
pub fn info(message: String, fields: Map[String, String] = [:]) {
    current().log(Level.Info, message, fields)
}

/// Writes the event at level `Warn` with the logger of `Context`.
pub fn warn(message: String, fields: Map[String, String] = [:]) {
    current().log(Level.Warn, message, fields)
}

/// Writes the event at level `Error` with the logger of `Context`.
pub fn error(message: String, fields: Map[String, String] = [:]) {
    current().log(Level.Error, message, fields)
}

/// Hands what was written to the stream's host.
pub fn Logger.flush(self): !__io.IoError {
    self.output.flush()?
}

fn rank(level: Level): Int {
    match level {
        Level.Trace => 0
        Level.Debug => 1
        Level.Info => 2
        Level.Warn => 3
        Level.Error => 4
    }
}

fn text(time: String?, level: Level, message: String, fields: Map[String, String]): String {
    var parts: Array[String] = []
    match time {
        some(at) => parts.push(at)
        none => {}
    }
    parts.push("{level}".toUpper())
    parts.push(message)
    for (key, value) in fields {
        let plain =
            not value.isEmpty() and
                not value.contains(" ") and
                not value.contains("=") and
                not value.contains("\"") and
                not value.contains("\n")
        parts.push(if plain { "{key}={value}" } else { "{key}={__json.encode(value)}" })
    }
    parts.join(" ")
}

fn object(time: String?, level: Level, message: String, fields: Map[String, String]): String {
    var parts: Array[String] = []
    match time {
        some(at) => parts.push("\"time\":\"{at}\"")
        none => {}
    }
    parts.push("\"level\":\"{level}\"")
    parts.push("\"message\":{__json.encode(message)}")
    for (key, value) in fields {
        parts.push("{__json.encode(key)}:{__json.encode(value)}")
    }
    "{{{parts.join(",")}}}"
}
