// The part of std.time (standard library 14.3.5) written in Tondo that
// takes a zone named `zone`, apart from datetime.to, whose `time.zone` the
// parameter would shadow.

import std.time as __time
import std.timetext as __text

/// What `parseDateTime` reads, kept in the zone it names: a text without an
/// offset is the time on `zone`'s clocks; one with an offset keeps it, in
/// `zone` if it had that offset then, or else in `fixedZone` of it.
pub fn parseZoned(text: String, zone: __time.Zone, pattern: String? = none, locale: String = "en"): __time.ZonedDateTime !
    __time.TimeError {
    let fields = match __text.read(text, pattern, locale) {
        some(fields) => fields
        none => fail __time.TimeError.InvalidDateTime
    }
    if fields[7] == 0 {
        return zone.at(
            year: fields[0],
            month: fields[1],
            day: fields[2],
            hour: fields[3],
            minute: fields[4],
            second: fields[5],
            nanosecond: fields[6],
        )?
    }
    let offset = __time.seconds(fields[8])
    let moment = __time.parseDateTime(text, pattern: pattern, locale: locale)?
    let kept = moment.inZone(zone)
    if kept.offset == offset {
        return kept
    }
    moment.inZone(__time.fixedZone(offset))
}
