/// The text in big letters, as FIGlet writes them: in its standard font,
/// or in `font`, the text of a `.flf` file, as `std.embed` gives one. Wider
/// than the terminal, or `width` columns, it goes on below, between words.
///
/// ```tondo
/// import std.cli
/// import std.console
///
/// console.println(cli.figlet("Tondo"))
/// //  _____               _
/// // |_   _|__  _ __   __| | ___
/// //   | |/ _ \| '_ \ / _` |/ _ \
/// //   | | (_) | | | | (_| | (_) |
/// //   |_|\___/|_| |_|\__,_|\___/
/// ```
pub fn figlet(text: String, font: String? = none, width: Int? = none): String {
    let face = fontOf(font ?? standardFont())
    let room = width ?? terminalWidth()
    var blocks: Array[String] = []
    var line = ""
    for word in text.words() {
        let longer = if line.isEmpty() { word } else { "{line} {word}" }
        if not line.isEmpty() and widest(lettered(face, longer)) > room {
            blocks.push(lettered(face, line))
            line = word
        } else {
            line = longer
        }
    }
    if not line.isEmpty() or blocks.isEmpty() {
        blocks.push(lettered(face, line))
    }
    blocks
        .map((block) { linesOf(block).map((row) { clipped(row, room).trimEnd() }).join("\n") })
        .join("\n")
}

/// A FIGlet font: its blank that is not a space, its height, how its
/// letters come together, and the rows of each letter by its code.
type Face = {
    blank: Char
    height: Int
    /// Rules of smushing, with 128 when letters smush, 64 when they only
    /// touch, and 0 when each keeps its full width.
    layout: Int
    letters: Map[Int, Array[String]]
}

/// The font of a `.flf` file's text.
fn fontOf(text: String): Face {
    let lines = text.lines()
    let header = (lines.first() ?? "").words()
    if header.length() < 6 or not header[0].startsWith("flf2a") {
        panic("the font is not a FIGlet font: its first line is not `flf2a` and its numbers")
    }
    let signature: Array[Char] = header[0].chars().collect()
    let blank = signature.get(5) ?? '$'
    let number = (index: Int) { Int.parse(header.get(index) ?? "") ?? 0 }
    let height = number(1).max(1)
    let old = number(4)
    let full = if header.length() > 7 { some(number(7)) } else { none }
    let layout = match full {
        some(bits) if bits & 128 != 0 => 128 | (bits & 63)
        some(bits) if bits & 64 != 0 => 64
        some(_) => 0
        none if old < 0 => 0
        none if old == 0 => 64
        none => 128 | (old & 63)
    }
    var letters: Map[Int, Array[String]] = [:]
    var at = 1 + number(5)
    // The letters every font has: ASCII, then seven of German.
    var required: Array[Int] = (32..127).collect()
    required.extend([196, 214, 220, 228, 246, 252, 223])
    for code in required {
        if at + height > lines.length() {
            break
        }
        letters[code] = rowsOf(lines, at, height)
        at += height
    }
    // Then any other, each after a line with its code.
    for at + height < lines.length() {
        let tag = (lines[at].words().first() ?? "").toLower()
        let code = if tag.startsWith("0x") {
            Int.parse(tag.slice(2, tag.length()) ?? "", radix: 16) ?? -1
        } else {
            Int.parse(tag) ?? -1
        }
        if code >= 0 {
            letters[code] = rowsOf(lines, at + 1, height)
        }
        at += height + 1
    }
    Face { blank, height, layout, letters }
}

/// The rows of a letter, without the marks that end each.
fn rowsOf(lines: Array[String], at: Int, height: Int): Array[String] {
    (at..at + height)
        .map(
            (index) {
                let row: Array[Char] = lines[index].trimEnd().chars().collect()
                match row.last() {
                    some(mark) => {
                        var end = row.length()
                        for end > 0 and row[end - 1] == mark {
                            end -= 1
                        }
                        row.take(end).map((c) { "{c}" }).join("")
                    }
                    none => ""
                }
            },
        )
        .collect()
}

/// A line of text in the font's letters, one after another, as close as
/// the font's layout lets them come.
fn lettered(face: Face, text: String): String {
    var rows: Array[Array[Char]] = []
    for _ in 0..face.height {
        let empty: Array[Char] = []
        rows.push(empty)
    }
    var previous = 0
    for c in text.chars() {
        let letter = match face.letters[c.code()] {
            some(found) => found.map((row) { row.chars().collect() })
            none => continue
        }
        let wide = letter.map((row) { row.length() }).max() ?? 0
        let amount = if face.layout == 0 { 0 } else { overlap(face, rows, letter, previous, wide) }
        for index in 0..face.height {
            var row = rows[index]
            let piece = letter.get(index) ?? []
            for k in 0..piece.length() {
                let column = row.length() - amount + k
                if k < amount {
                    if column >= 0 {
                        row[column] =
                            smushed(face, row[column], piece[k], previous, wide) ?? piece[k]
                    }
                } else {
                    row.push(piece[k])
                }
            }
            rows[index] = row
        }
        previous = wide
    }
    rows
        .map((row) { row.map((c) { if c == face.blank { " " } else { "{c}" } }).join("") })
        .join("\n")
}

/// How many columns a letter can go into what is written, as FIGlet
/// measures it: the least, over the rows, of the blanks between the two
/// and one more where their touching characters smush.
fn overlap(
    face: Face,
    rows: Array[Array[Char]],
    letter: Array[Array[Char]],
    previous: Int,
    wide: Int,
): Int {
    var least = wide
    for index in 0..face.height {
        let row = rows[index]
        let piece = letter.get(index) ?? []
        var end = row.length() - 1
        for end > 0 and row[end] == ' ' {
            end -= 1
        }
        var start = 0
        for start < piece.length() and piece[start] == ' ' {
            start += 1
        }
        // Into nothing yet, a letter goes as far as its blanks.
        if row.isEmpty() {
            least = least.min(start)
            continue
        }
        var amount = start + row.length() - 1 - end
        let left = row.get(end) ?? ' '
        if left == ' ' {
            amount += 1
        } else if start < piece.length() {
            if smushed(face, left, piece[start], previous, wide).isSome() {
                amount += 1
            }
        }
        least = least.min(amount)
    }
    least.max(0)
}

/// The character two smush into, by the font's rules; none when they do
/// not.
fn smushed(face: Face, left: Char, right: Char, previous: Int, wide: Int): Char? {
    if left == ' ' {
        return right
    }
    if right == ' ' {
        return left
    }
    if previous < 2 or wide < 2 or face.layout & 128 == 0 {
        return none
    }
    let rules = face.layout & 63
    if left == face.blank or right == face.blank {
        return if rules & 32 != 0 { left } else { none }
    }
    if rules == 0 {
        // Universal smushing: the right one shows.
        return right
    }
    if rules & 1 != 0 and left == right {
        return left
    }
    let lines = "|/\\[]{{}}()<>"
    if rules & 2 != 0 {
        if left == '_' and lines.contains("{right}") {
            return right
        }
        if right == '_' and lines.contains("{left}") {
            return left
        }
    }
    if rules & 4 != 0 {
        let classes = ["|", "/\\", "[]", "{{}}", "()", "<>"]
        let rank = (c: Char) { classes.findIndex((class) { class.contains("{c}") }) }
        match (rank(left), rank(right)) {
            (some(one), some(two)) if one < two => return right
            (some(one), some(two)) if two < one => return left
            _ => {}
        }
    }
    if rules & 8 != 0 {
        let pair = "{left}{right}"
        if ["[]", "][", "{{}}", "}}{{", "()", ")("].contains(pair) {
            return '|'
        }
    }
    if rules & 16 != 0 {
        match (left, right) {
            ('/', '\\') => return '|'
            ('\\', '/') => return 'Y'
            ('>', '<') => return 'X'
            _ => {}
        }
    }
    none
}

/// FIGlet's standard font, by Glenn Chappell and Ian Chai, as FIGlet 2.2
/// gives it.
fn standardFont(): String {
    r"""
flf2a$ 6 5 16 15 15 0 24463 229
Standard by Glenn Chappell & Ian Chai 3/93 -- based on Frank's .sig
Includes ISO Latin-1
figlet release 2.1 -- 12 Aug 1994
Modified for figlet 2.2 by John Cowan <cowan@ccil.org>
  to add Latin-{2,3,4,5} support (Unicode U+0100-017F).
Permission is hereby given to modify this font, as long as the
modifier's name is placed on a comment line.

---

Modified by Paul Burton <solution@earthlink.net> 12/96 to include new parameter
supported by FIGlet and FIGWin.  May also be slightly modified for better use
of new full-width/kern/smush alternatives, but default output is NOT changed.

Modified 2012-05 by Patrick Gillespie (patorjk@gmail.com) to add the 0xCA0 character.
