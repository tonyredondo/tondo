// A gRPC client: channels, calls of each kind, retries and balancing.

import std.internal.grpc as grpcNative
import std.protobuf as __protobuf
import std.reflect as __reflect
import std.time as __time

/// How a client compresses the messages it sends; every client reads
/// compressed ones.
///
/// ```tondo
/// import std.grpc
///
/// // Each message gzipped, worth it for large ones over a slow network.
/// let client = grpc.connect("https://api.example.com", compression: grpc.Compression.Gzip)?
/// _ = client
/// ```
pub enum Compression {
    None
    Gzip
}

/// How a channel spreads its calls over the addresses of its target.
///
/// ```tondo
/// import std.grpc
///
/// // The calls spread over the addresses the name resolves to, again as they change.
/// let client = grpc.connect("dns:///users.internal:50051", balancing: grpc.Balancing.RoundRobin)?
/// _ = client
/// ```
pub enum Balancing {
    /// All on the first address that answers, in order, until it drops.
    PickFirst
    /// Each on the next of the addresses that answer.
    RoundRobin
}

/// A connection to a server, which its calls share: `http://host:port`, or
/// `https://host:port` for TLS, which trusts the system's authorities and,
/// as the HTTP client does, those of `trust`; `certificate` and `key`
/// show the server who the client is, and `compression` compresses what it
/// sends. A target may name several servers, `http://a:50051,b:50051`,
/// and a host's name may resolve to several addresses: `balancing` says
/// which one each call goes to.
///
/// ```tondo
/// import std.console
/// import std.grpc
/// import std.http
/// import std.protobuf
/// import std.time
///
/// pub type HelloRequest = {
///     @protobuf.Field(1)
///     name: String = ""
/// }
///
/// pub type HelloReply = {
///     @protobuf.Field(1)
///     message: String = ""
/// }
///
/// fn hello(request: HelloRequest): HelloReply ! grpc.Status {
///     HelloReply { message: "Hello, {request.name}!" }
/// }
///
/// var app = http.App()
/// app.grpc(grpc.Service { name: "demo.Greeter", methods: [grpc.Method { name: "Hello", handler: (call) { grpc.unary(call, hello)? } }] })
/// let server = app.start()?
/// // A channel keeps its connection for every call; its interceptors see each.
/// let client = grpc.connect(server.url())?.onCall((call, next) {
///     let started = time.now()
///     let outcome = next(call)
///     console.println("{call.method} took {started.elapsed()}")
///     outcome?
/// })
/// console.println(client.unary[HelloRequest, HelloReply]("/demo.Greeter/Hello", HelloRequest { name: "Ada" })?.message)
/// server.stop()
/// ```
pub type Channel = {
    priv native: grpcNative.Native
    priv target: String
    priv compression: Compression = Compression.None
    priv layers: Array[fn(Call, fn(Call): !Status): !Status] = []
    priv watchers: Array[fn(Call, Direction, __reflect.Value)] = []
}

/// A channel to a server, which connects with its first call.
///
/// ```tondo
/// import std.console
/// import std.grpc
/// import std.time
///
/// /// A channel round robin over two servers, with each call timed; a client
/// /// of a `.proto` service takes it: `users.UserServiceClient.on(channel)`.
/// fn servers(): grpc.Channel ! grpc.Status {
///     let balanced = grpc.connect("http://10.0.0.1:50051,10.0.0.2:50051", balancing: grpc.Balancing.RoundRobin)?
///     balanced.onCall((call, next) {
///         let started = time.now()
///         let outcome = next(call)
///         console.println("{call.method} took {started.elapsed()}")
///         outcome?
///     })
/// }
/// ```
pub fn connect(
    target: String,
    trust: String = "",
    certificate: String = "",
    key: String = "",
    compression: Compression = Compression.None,
    balancing: Balancing = Balancing.PickFirst,
): Channel ! Status {
    let spread = match balancing {
        Balancing.PickFirst => 0
        Balancing.RoundRobin => 1
    }
    let native = grpcNative.channel(target, trust, certificate, key, spread)
    let problem = grpcNative.channelError(native)
    if not problem.isEmpty() {
        fail Status { code: Code.InvalidArgument, message: problem }
    }
    Channel { native, target: target.removePrefix("https://").removePrefix("http://"), compression }
}

/// Wraps each call the channel makes: `interceptor` gets the call and
/// `next`, which makes it with the metadata and deadline of the `Call` it
/// is given and gives its status when it ends. A unary call runs the
/// interceptors in the caller's task and fails as they do; a stream runs
/// them in a task of their own, with the caller's contexts, while the
/// caller reads the call `next` made. The first added is the outermost.
pub fn Channel.onCall(self, interceptor: fn(Call, fn(Call): !Status): !Status): Channel {
    self with { layers: self.layers.concat([interceptor]) }
}

/// Shows `observer` each message of each call, as it is sent or received.
pub fn Channel.onMessage(self, observer: fn(Call, Direction, __reflect.Value)): Channel {
    self with { watchers: self.watchers.concat([observer]) }
}

/// A call the client makes: the runtime's, what it is, and who watches its
/// messages.
type Outgoing = {
    native: grpcNative.Native
    call: Call
    watchers: Array[fn(Call, Direction, __reflect.Value)]
}

/// The call of `path` with its metadata, and the time left before the
/// running `within`'s deadline.
fn Channel.callOf(self, path: String, metadata: Map[String, String]): Call {
    Call { method: path, metadata, peer: self.target, timeout: __time.remaining() }
}

/// The headers of a call: its metadata, and its deadline as `grpc-timeout`.
fn headersOf(rpc: Call): Array[String] {
    var headers: Array[String] = []
    for (name, value) in rpc.metadata {
        headers.extend([name.toLower(), value])
    }
    match rpc.timeout {
        some(left) => headers.extend(["grpc-timeout", timeoutText(left)])
        none => {}
    }
    headers
}

/// What a call starts with: its one request, as bytes and as those who
/// watch messages see it; none for a call whose requests follow.
type Opening = {
    message: Array[Byte] = []
    single: Bool = false
    shown: __reflect.Value? = none
}

/// A call's one request.
fn Channel.opening[T: __protobuf.Message + __reflect.Reflect](self, request: T): Opening {
    let shown: __reflect.Value? = if self.watchers.isEmpty() {
        none
    } else {
        some(__reflect.valueOf(request))
    }
    Opening { message: __protobuf.encode(request), single: true, shown }
}

/// Makes a call, showing its request as sent.
fn Channel.open(self, rpc: Call, opening: Opening, slot: grpcNative.Native?): grpcNative.Native {
    match opening.shown {
        some(value) => {
            for watcher in self.watchers {
                watcher(rpc, Direction.Sent, value)
            }
        }
        none => {}
    }
    var headers = headersOf(rpc)
    // The runtime compresses a call's messages when it says so.
    match self.compression {
        Compression.Gzip => headers.extend(["grpc-encoding", "gzip"])
        Compression.None => {}
    }
    match slot {
        some(into) => grpcNative.open(
            into,
            self.native,
            rpc.method,
            headers,
            opening.message,
            opening.single,
        )
        none => grpcNative.start(self.native, rpc.method, headers, opening.message, opening.single)
    }
}

/// Starts a call. Through interceptors, they run in a task of their own
/// and the call is the one their `next` made.
fn Channel.started(self, rpc: Call, opening: Opening): Outgoing {
    let native = if self.layers.isEmpty() {
        self.open(rpc, opening, none)
    } else {
        let slot = grpcNative.slot()
        spawn detached self.intercepted(slot, rpc, opening)
        grpcNative.take(slot)
    }
    Outgoing { native, call: rpc, watchers: self.watchers }
}

/// Runs the interceptors around `next`, which makes the call into the
/// slot; when they make none, the caller's call ends as they did.
fn Channel.intercepted(self, slot: grpcNative.Native, rpc: Call, opening: Opening): !Status {
    let outcome = match recover { self.layered(0, slot, rpc, opening) } {
        ok(outcome) => outcome
        err(failure) => err(panicked("an interceptor", failure.message))
    }
    match outcome {
        ok(_) => grpcNative.close(slot, Code.Internal.number(), "the interceptors made no call")
        err(status) => grpcNative.close(slot, status.code.number(), status.message)
    }
    outcome?
}

/// The call through the interceptors from the one at `at` on.
fn Channel.layered(self, at: Int, slot: grpcNative.Native, rpc: Call, opening: Opening): !Status {
    if at == self.layers.length() {
        let ended = grpcNative.ended(self.open(rpc, opening, slot))
        let code = Int.parse(ended[0]).unwrapOr(2)
        if code != 0 {
            fail statusOf(code, ended[1], ended.drop(2))
        }
        return
    }
    let layer = self.layers[at]
    let connection = self
    layer(rpc, (next) { connection.layered(at + 1, slot, next, opening)? })?
}

/// The next message a call receives, `none` after the last, or its status
/// when it failed.
fn Outgoing.received[T: __protobuf.Message + __reflect.Reflect](self): T? ! Status {
    match grpcNative.next(self.native) {
        1 => match __protobuf.decode[T](grpcNative.message(self.native)) {
            ok(message) => {
                watched(self.watchers, self.call, Direction.Received, message)
                message
            }
            err(error) => fail Status {
                code: Code.Internal
                message: "the reply is not a `{__protobuf.Message.protobufName[T]()}`: {error}"
            }
        }
        0 => {
            self.ended()?
            none
        }
        _ => fail Status { code: Code.Cancelled, message: "the call was cancelled" }
    }
}

/// Fails with the status of a call that ended, once it ended.
fn Outgoing.ended(self): !Status {
    let code = grpcNative.code(self.native)
    if code != 0 {
        fail statusOf(code, grpcNative.detail(self.native), grpcNative.trailers(self.native))
    }
}

/// Sends a message; a call that ended fails with its status.
fn Outgoing.send[T: __protobuf.Message + __reflect.Reflect](self, message: T): !Status {
    watched(self.watchers, self.call, Direction.Sent, message)
    if not grpcNative.send(self.native, __protobuf.encode(message)) {
        // What arrived before the status does not matter any more.
        for grpcNative.next(self.native) == 1 {}
        self.ended()?
        fail Status { code: Code.Cancelled, message: "the call ended" }
    }
}

/// The one reply of a call, and then its status.
fn Outgoing.reply[T: __protobuf.Message + __reflect.Reflect](self): T ! Status {
    let reply = match self.received[T]()? {
        some(reply) => reply
        none => fail Status { code: Code.Internal, message: "the server sent no reply" }
    }
    _ = self.received[T]()?
    reply
}

/// A unary call: one request, one reply.
pub fn Channel.unary[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](self, path: String, request: In, metadata: Map[String, String] = [:]): Out ! Status {
    let rpc = self.callOf(path, metadata)
    let opening = self.opening(request)
    if self.layers.isEmpty() {
        return self.started(rpc, opening).reply[Out]()?
    }
    // The interceptors run here, and their failure is the call's.
    let slot = grpcNative.slot()
    self.intercepted(slot, rpc, opening)?
    Outgoing { native: grpcNative.take(slot), call: rpc, watchers: self.watchers }.reply[Out]()?
}

/// A call that receives a stream: one request, and the replies.
pub fn Channel.serverStream[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](self, path: String, request: In, metadata: Map[String, String] = [:]): Stream[Out] {
    let rpc = self.callOf(path, metadata)
    Stream[Out] { source: Source.Client(self.started(rpc, self.opening(request))) }
}

/// A call that sends a stream: `send` each request, then `finish` for the
/// reply.
///
/// ```tondo
/// import std.console
/// import std.grpc
/// import std.http
/// import std.protobuf
///
/// pub type HelloRequest = {
///     @protobuf.Field(1)
///     name: String = ""
/// }
///
/// pub type HelloReply = {
///     @protobuf.Field(1)
///     message: String = ""
/// }
///
/// fn greetAll(requests: grpc.Stream[HelloRequest]): HelloReply ! grpc.Status {
///     var names: Array[String] = []
///     for request in requests {
///         names.push(request?.name)
///     }
///     HelloReply { message: "Hello, {names.join(" and ")}!" }
/// }
///
/// var app = http.App()
/// app.grpc(grpc.Service { name: "demo.Greeter", methods: [grpc.Method { name: "GreetAll", handler: (call) { grpc.clientStream(call, greetAll)? } }] })
/// let server = app.start()?
/// let upload = grpc.connect(server.url())?.clientStream[HelloRequest, HelloReply]("/demo.Greeter/GreetAll")
/// for name in ["Ada", "Bo", "Cy"] {
///     upload.send(HelloRequest { name })?
/// }
/// console.println(upload.finish()?.message)
/// server.stop()
/// ```
pub type Upload[In, Out] = {
    priv outgoing: Outgoing
}

/// A call that sends a stream of requests and receives one reply.
pub fn Channel.clientStream[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](self, path: String, metadata: Map[String, String] = [:]): Upload[In, Out] {
    Upload[In, Out] { outgoing: self.started(self.callOf(path, metadata), Opening {}) }
}

/// Sends a request; a call that ended fails with its status.
pub fn Upload[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
].send(self, message: In): !Status {
    self.outgoing.send(message)?
}

/// Says the requests are all sent, and gives the reply.
pub fn Upload[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
].finish(self): Out ! Status {
    grpcNative.closeSend(self.outgoing.native)
    self.outgoing.reply[Out]()?
}

/// A call that sends and receives streams: `send` requests, `closeSend`
/// after the last, and read the replies as a `Stream`.
///
/// ```tondo
/// import std.console
/// import std.grpc
/// import std.http
/// import std.protobuf
///
/// pub type HelloRequest = {
///     @protobuf.Field(1)
///     name: String = ""
/// }
///
/// pub type HelloReply = {
///     @protobuf.Field(1)
///     message: String = ""
/// }
///
/// fn echo(requests: grpc.Stream[HelloRequest], replies: Sender[HelloReply]): !grpc.Status {
///     for request in requests {
///         replies.send(HelloReply { message: "echo {request?.name}" })
///     }
/// }
///
/// var app = http.App()
/// app.grpc(grpc.Service { name: "demo.Echo", methods: [grpc.Method { name: "Echo", handler: (call) { grpc.bidiStream(call, echo)? } }] })
/// let server = app.start()?
/// let talk = grpc.connect(server.url())?.bidiStream[HelloRequest, HelloReply]("/demo.Echo/Echo")
/// talk.send(HelloRequest { name: "one" })?
/// talk.send(HelloRequest { name: "two" })?
/// talk.closeSend()
/// for reply in talk.replies() {
///     console.println(reply?.message)
/// }
/// console.println("trailers: {talk.trailers()}")
/// server.stop()
/// ```
pub type Duplex[In, Out] = {
    priv outgoing: Outgoing
}

/// A call that sends a stream of requests and receives a stream of replies.
pub fn Channel.bidiStream[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
](self, path: String, metadata: Map[String, String] = [:]): Duplex[In, Out] {
    Duplex[In, Out] { outgoing: self.started(self.callOf(path, metadata), Opening {}) }
}

/// Sends a request; a call that ended fails with its status.
pub fn Duplex[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
].send(self, message: In): !Status {
    self.outgoing.send(message)?
}

/// Says the requests are all sent.
pub fn Duplex[In, Out].closeSend(self) {
    grpcNative.closeSend(self.outgoing.native)
}

/// The replies, as they arrive.
pub fn Duplex[
    In: __protobuf.Message + __reflect.Reflect,
    Out: __protobuf.Message + __reflect.Reflect,
].replies(self): Stream[Out] {
    Stream[Out] { source: Source.Client(self.outgoing) }
}

/// The metadata the server answered with, once its first message or its
/// status came.
pub fn Duplex[In, Out].headers(self): Map[String, String] {
    pairs(grpcNative.headers(self.outgoing.native))
}

/// The metadata that followed the server's last message, once the replies
/// ended; the status is not among it.
pub fn Duplex[In, Out].trailers(self): Map[String, String] {
    var all = pairs(grpcNative.trailers(self.outgoing.native))
    for name in ["grpc-status", "grpc-message", "grpc-status-details-bin"] {
        _ = all.remove(name)
    }
    all
}

fn pairs(list: Array[String]): Map[String, String] {
    var all: Map[String, String] = [:]
    var at = 0
    for at + 1 < list.length() {
        all[list[at]] = list[at + 1]
        at += 2
    }
    all
}
