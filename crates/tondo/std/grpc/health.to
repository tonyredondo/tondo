    status: ServingStatus = ServingStatus.Unknown
}

impl __protobuf.Message for HealthReply {
    fn writeTo(self, out: __protobuf.Writer) {
        let number: Int32 = match self.status {
            ServingStatus.Unknown => 0
            ServingStatus.Serving => 1
            ServingStatus.NotServing => 2
            ServingStatus.ServiceUnknown => 3
        }
        if number != 0 {
            out.int32(1, number)
        }
    }

    fn readFrom(input: __protobuf.Reader): HealthReply ! __protobuf.ProtobufError {
        var reply = HealthReply {}
        for {
            match input.next()? {
                0 => break
                1 => reply.status = match input.int32("status")? {
                    1 => ServingStatus.Serving
                    2 => ServingStatus.NotServing
                    3 => ServingStatus.ServiceUnknown
                    _ => ServingStatus.Unknown
                }
                _ => input.skip()?
            }
        }
        reply
    }

    fn protobufName(): String {
        "grpc.health.v1.HealthCheckResponse"
    }

    fn writeJson(self, out: __protobuf.JsonWriter): !__protobuf.ProtobufError {
        out.begin()
        let name = match self.status {
            ServingStatus.Unknown => ""
            ServingStatus.Serving => "SERVING"
            ServingStatus.NotServing => "NOT_SERVING"
            ServingStatus.ServiceUnknown => "SERVICE_UNKNOWN"
        }
        if not name.isEmpty() {
            out.field("status", "status")
            out.string(name)
        }
        out.end()
    }

    fn readJson(
        input: __protobuf.JsonReader,
        document: __protobuf.JsonValue,
    ): HealthReply ! __protobuf.ProtobufError {
        var reply = HealthReply {}
        for (key, field) in input.fields(document, "$")? {
            match key {
                "status" => reply.status = match field {
                    __json.Value.Text(name) => match name {
                        "SERVING" => ServingStatus.Serving
                        "NOT_SERVING" => ServingStatus.NotServing
                        "SERVICE_UNKNOWN" => ServingStatus.ServiceUnknown
                        _ => ServingStatus.Unknown
                    }
                    _ => match input.int32(field, "$.status")? {
                        1 => ServingStatus.Serving
                        2 => ServingStatus.NotServing
                        3 => ServingStatus.ServiceUnknown
                        _ => ServingStatus.Unknown
                    }
                }
                _ => input.unknown(key, "$")?
            }
        }
        reply
    }
}

impl __reflect.Reflect for HealthReply {
    fn reflectShow(self, _nested: Bool): String {
        "HealthCheckResponse {{ status: {self.status} }}"
    }
}

