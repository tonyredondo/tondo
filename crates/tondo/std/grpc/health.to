/// `grpc.health.v1.HealthListResponse`: each service's status.
type HealthList = {
    statuses: Map[String, ServingStatus] = [:]
}

impl __protobuf.Message for HealthList {
    fn writeTo(self, out: __protobuf.Writer) {
        for (service, status) in self.statuses {
            out.message(1, HealthEntry { service, status })
        }
    }

    fn readFrom(input: __protobuf.Reader): HealthList ! __protobuf.ProtobufError {
        var list = HealthList {}
        for {
            match input.next()? {
                0 => break
                1 => {
                    let entry = input.message[HealthEntry]("statuses")?
                    list.statuses[entry.service] = entry.status
                }
                _ => input.skip()?
            }
        }
        list
    }

    fn protobufName(): String {
        "grpc.health.v1.HealthListResponse"
    }

    fn writeJson(self, out: __protobuf.JsonWriter): !__protobuf.ProtobufError {
        out.begin()
        if not self.statuses.isEmpty() {
            out.field("statuses", "statuses")
            out.begin()
            for (service, status) in self.statuses {
                out.key(service)
                out.message(HealthReply { status })?
            }
            out.end()
        }
        out.end()
    }

    fn readJson(
        input: __protobuf.JsonReader,
        document: __protobuf.JsonValue,
    ): HealthList ! __protobuf.ProtobufError {
        var list = HealthList {}
        for (key, field) in input.fields(document, "$")? {
            match key {
                "statuses" => {
                    for (service, status) in input.entries(field, "$.statuses")? {
                        list.statuses[service] =
                            input.message[HealthReply](status, "$.statuses.{service}")?.status
                    }
                }
                _ => input.unknown(key, "$")?
            }
        }
        list
    }
}

impl __reflect.Reflect for HealthList {
    fn reflectShow(self, _nested: Bool): String {
        "HealthListResponse {{ {self.statuses.length()} statuses }}"
    }
}

/// An entry of `HealthListResponse.statuses`: a service and its status.
type HealthEntry = {
    service: String = ""
    status: ServingStatus = ServingStatus.Unknown
}

impl __protobuf.Message for HealthEntry {
    fn writeTo(self, out: __protobuf.Writer) {
        out.string(1, self.service)
        out.message(2, HealthReply { status: self.status })
    }

    fn readFrom(input: __protobuf.Reader): HealthEntry ! __protobuf.ProtobufError {
        var entry = HealthEntry {}
        for {
            match input.next()? {
                0 => break
                1 => entry.service = input.string("key")?
                2 => entry.status = input.message[HealthReply]("value")?.status
                _ => input.skip()?
            }
        }
        entry
    }

    fn protobufName(): String {
        "grpc.health.v1.HealthListResponse.StatusesEntry"
    }
}

