// std.http (standard library 14.24): an HTTP client and server for
// HTTP/1.1 and HTTP/2 over TLS, with bodies that stream both ways,
// multipart forms, Server-Sent Events and WebSockets, on the runtime's
// transport.

import std.console as __console
import std.crypto as __crypto
import std.encoding as __encoding
import std.fs as __fs
import std.gzip as __gzip
import std.hash as __hash
import std.internal.http as httpNative
import std.io as __io
import std.json as __json
import std.net as __net
import std.panics as __panics
import std.serialization as __serialization
import std.sync as __sync
import std.time as __time
import std.url as __url
import std.zstd as __zstd

/// Why a request has no response a program can use.
pub enum HttpError {
    /// A URL that does not parse, or whose scheme is not `http` or `https`.
    InvalidUrl(String)
    /// The name did not resolve, the server refused, or TLS failed.
    Connect(String)
    /// The request took longer than its timeout.
    Timeout
    /// The server answered with a status of 400 or more: the response, to
    /// read its body.
    Status(Response)
    /// The request's or the response's body failed, or is not what was
    /// asked for: not UTF-8, not the JSON of the type.
    Body(String)
    /// Anything else of HTTP: too many redirects, a broken connection.
    Protocol(String)
}

impl Display for HttpError {
    fn display(self): String {
        match self {
            HttpError.InvalidUrl(why) => "invalid URL: {why}"
            HttpError.Connect(why) => "cannot connect: {why}"
            HttpError.Timeout => "the request timed out"
            HttpError.Status(response) =>
                "{response.verb} {response.finalUrl} answered {response.code} {response.phrase}"
            HttpError.Body(why) => "the body: {why}"
            HttpError.Protocol(why) => "HTTP: {why}"
        }
    }
}

// ---------------------------------------------------------------------------
// Bodies
// ---------------------------------------------------------------------------

enum Content {
    Data(Array[Byte], String)
    Stream(__io.Reader, Int, String)
    Form(Array[Part])
}

/// What a request sends.
pub type Body = {
    priv content: Content
}

/// A body of text, sent as UTF-8 with its content type.
pub fn Body.text(text: String, contentType: String = "text/plain; charset=utf-8"): Body {
    Body { content: Content.Data(text.bytes(), contentType) }
}

/// A body of bytes, sent with its content type.
pub fn Body.bytes(bytes: Array[Byte], contentType: String = "application/octet-stream"): Body {
    Body { content: Content.Data(bytes, contentType) }
}

/// The value as JSON (`std.json`).
pub fn Body.json[T: __serialization.Encode](value: T): Body {
    Body { content: Content.Data(__json.encode(value).bytes(), "application/json") }
}

/// The fields as a URL-encoded form, as an HTML form posts them.
pub fn Body.form(fields: Map[String, String]): Body {
    var pairs: Array[String] = []
    for (name, value) in fields {
        pairs.push("{__encoding.urlEncode(name)}={__encoding.urlEncode(value)}")
    }
    Body { content: Content.Data(pairs.join("&").bytes(), "application/x-www-form-urlencoded") }
}

/// A `multipart/form-data` form: fields and files, as uploads send them.
pub fn Body.multipart(parts: Array[Part]): Body {
    Body { content: Content.Form(parts) }
}

/// What a stream gives, read as it is sent; `length` is its size in bytes
/// when known. A stream is read once.
pub fn Body.stream(
    input: __io.Reader,
    length: Int? = none,
    contentType: String = "application/octet-stream",
): Body {
    Body { content: Content.Stream(input, length.unwrapOr(-1), contentType) }
}

enum Source {
    Field(String)
    Data(Array[Byte])
    File(String)
    Stream(__io.Reader, Int)
}

/// A part of a multipart form.
pub type Part = {
    priv name: String
    priv source: Source
    priv fileName: String
    priv contentType: String
}

/// A field of a multipart form: its name and its text.
pub fn Part.field(name: String, value: String): Part {
    Part { name, source: Source.Field(value), fileName: "", contentType: "" }
}

/// A file's bytes, sent under `fileName`.
pub fn Part.bytes(name: String, bytes: Array[Byte], fileName: String, contentType: String = ""): Part {
    Part { name, source: Source.Data(bytes), fileName, contentType }
}

/// A file on disk, read as it is sent, under its own name and with the
/// content type of its extension unless one is given.
pub fn Part.file(name: String, path: String, contentType: String = ""): Part {
    Part { name, source: Source.File(path), fileName: "", contentType }
}

/// What a stream gives, read as it is sent, under `fileName`.
pub fn Part.stream(
    name: String,
    input: __io.Reader,
    fileName: String,
    contentType: String = "",
    length: Int? = none,
): Part {
    Part { name, source: Source.Stream(input, length.unwrapOr(-1)), fileName, contentType }
}

// ---------------------------------------------------------------------------
// Responses
// ---------------------------------------------------------------------------

/// A response, whose head has arrived; its body arrives as it is read,
/// once, by `text`, `bytes`, `json`, `body`, `lines`, `events` or `copyTo`.
pub type Response = {
    priv native: httpNative.Native
    priv verb: String
    priv code: Int
    priv phrase: String
    priv finalUrl: String
    priv protocol: String
    priv headerList: Array[String]
}

/// `200 OK`.
impl Display for Response {
    fn display(self): String {
        "{self.code} {self.phrase}"
    }
}

/// The status code: `200`, `404`.
pub fn Response.status(self): Int {
    self.code
}

/// The status's reason phrase: `OK`, `Not Found`.
pub fn Response.reason(self): String {
    self.phrase
}

/// The URL that answered, after redirects.
pub fn Response.url(self): String {
    self.finalUrl
}

/// `HTTP/1.1` or `HTTP/2.0`.
pub fn Response.version(self): String {
    self.protocol
}

/// The first value of a header, by its name in any case.
pub fn Response.header(self, name: String): String? {
    self.headerValues(name).first()
}

/// Every value of a header, by its name in any case.
pub fn Response.headerValues(self, name: String): Array[String] {
    let wanted = name.toLower()
    var values: Array[String] = []
    var index = 0
    for index + 1 < self.headerList.length() {
        if self.headerList[index] == wanted {
            values.push(self.headerList[index + 1])
        }
        index += 2
    }
    values
}

/// The headers, lowercase, with the values of a repeated one joined by
/// `, `.
pub fn Response.headers(self): Map[String, String] {
    var out: Map[String, String] = [:]
    var index = 0
    for index + 1 < self.headerList.length() {
        let (name, value) = (self.headerList[index], self.headerList[index + 1])
        out[name] = match out.get(name) {
            some(before) => "{before}, {value}"
            none => value
        }
        index += 2
    }
    out
}

/// The value of a cookie the response sets, decoded as `Request.cookie`
/// does, or `none`.
pub fn Response.cookie(self, name: String): String? {
    self.cookies().get(name)
}

/// The cookies the response sets, by name, their values decoded.
pub fn Response.cookies(self): Map[String, String] {
    var found: Map[String, String] = [:]
    for header in self.headerValues("set-cookie") {
        match nameAndValue(header.split(";")[0]) {
            some((name, value)) => found[name] = value
            none => {}
        }
    }
    found
}

/// A cookie's `name=value`, its value without quotes and decoded with
/// `encoding.urlDecode`, as `Reply.cookie` writes it.
fn nameAndValue(pair: String): (String, String)? {
    let text = pair.trim()
    let at = text.find("=")?
    let name = text.slice(0, at).unwrapOr("").trim()
    var value = text.slice(at + 1, text.length()).unwrapOr("").trim()
    if value.length() >= 2 and value.startsWith("\"") and value.endsWith("\"") {
        value = value.slice(1, value.length() - 1).unwrapOr(value)
    }
    if name.isEmpty() {
        return none
    }
    some((name, __encoding.urlDecode(value).unwrapOr(value)))
}

/// The whole body, read as it arrives.
pub fn Response.bytes(self): Array[Byte] ! HttpError {
    let bytes = httpNative.readAll(self.native)
    failed(self.native)?
    bytes
}

/// The body as text, in the charset its content type names (`windows1252`).
pub fn Response.text(self): String ! HttpError {
    let windows = match windows1252(self.header("content-type").unwrapOr("")) {
        ok(windows) => windows
        err(why) => fail HttpError.Body("{why}: read its bytes with `bytes()` instead")
    }
    let bytes = self.bytes()?
    if windows {
        return httpNative.windows1252(bytes)
    }
    match String.fromBytes(bytes) {
        ok(decoded) => decoded
        err(_) => fail HttpError.Body("it is not UTF-8 text: read its bytes with `bytes()` instead")
    }
}

/// The body as the JSON of a `T` (`std.json`), decoded as it arrives.
pub fn Response.json[T: __serialization.Decode](self): T ! HttpError {
    match __json.decodeFrom[T](self.body()) {
        ok(value) => value
        err(error) => {
            failed(self.native)?
            fail HttpError.Body("{error}")
        }
    }
}

/// The body as a stream, read as the program asks for it.
pub fn Response.body(self): __io.Reader {
    httpNative.body(self.native, false)
}

/// The body's lines, as they arrive, in the charset `text()` reads:
/// newline-delimited JSON, logs.
pub fn Response.lines(self): Lines {
    match windows1252(self.header("content-type").unwrapOr("")) {
        ok(windows) => Lines {
            input: httpNative.body(self.native, windows)
            response: self.native
            failure: ""
            done: false
        }
        err(why) => Lines {
            input: __io.reader("")
            response: self.native
            failure: "{why}: read its bytes with `bytes()` instead"
            done: false
        }
    }
}

/// The body's Server-Sent Events, as they arrive, in UTF-8 as they are.
pub fn Response.events(self): Events {
    Events { source: Lines { input: self.body(), response: self.native, failure: "", done: false } }
}

/// Whether text of a content type is Windows-1252, which browsers also
/// read for the labels of Latin-1 and ASCII, or UTF-8, which it is when it
/// names no charset; why not, for any other charset.
fn windows1252(contentType: String): Bool ! String {
    var charset = "utf-8"
    for parameter in contentType.split(";") {
        let pair = parameter.trim().toLower()
        if pair.startsWith("charset=") {
            charset = pair.removePrefix("charset=").trim().removePrefix("\"").removeSuffix("\"")
        }
    }
    if charset == "utf-8" or charset == "utf8" {
        return false
    }
    let labels = [
        "windows-1252",
        "cp1252",
        "iso-8859-1",
        "iso8859-1",
        "iso_8859-1",
        "latin1",
        "l1",
        "us-ascii",
        "ascii",
    ]
    if labels.any((label) { label == charset }) {
        return true
    }
    fail "it is in `{charset}`, a charset Tondo does not decode"
}

/// Writes the body to a stream as it arrives; how many bytes it wrote.
pub fn Response.copyTo(self, output: __io.Writer): Int ! HttpError {
    let input = self.body()
    var total = 0
    for {
        let chunk = match input.read(65536) {
            ok(some(chunk)) => chunk
            ok(none) => return total
            err(error) => {
                failed(self.native)?
                fail HttpError.Body("{error}")
            }
        }
        match output.writeBytes(chunk) {
            ok(_) => total += chunk.length()
            err(error) => fail HttpError.Body("writing it: {error}")
        }
    }
}

/// The lines of a body, as `Response.lines()` gives them.
pub type Lines = {
    priv input: __io.Reader
    priv response: httpNative.Native
    /// Why the body is not text Tondo reads, or empty.
    priv failure: String
    priv done: Bool
}

impl Iterator[String ! HttpError] for Lines {
    fn next(mut self): (String ! HttpError)? {
        if self.done {
            return none
        }
        if not self.failure.isEmpty() {
            self.done = true
            return some(err(HttpError.Body(self.failure)))
        }
        match self.input.readLine() {
            ok(some(line)) => some(ok(line))
            ok(none) => {
                self.done = true
                none
            }
            err(error) => {
                self.done = true
                let why = match error {
                    __io.IoError.InvalidData =>
                        "it is not UTF-8 text: read its bytes with `bytes()` instead"
                    _ => "{error}"
                }
                match failed(self.response) {
                    err(recorded) => some(err(recorded))
                    ok(_) => some(err(HttpError.Body(why)))
                }
            }
        }
    }
}

/// A Server-Sent Event: its type, `message` unless the server names one,
/// its data, with a `\n` between data lines, and its id.
pub type Event = {
    event: String
    data: String
    id: String?
}

/// The events of a body, as `Response.events()` gives them.
pub type Events = {
    priv source: Lines
}

impl Iterator[Event ! HttpError] for Events {
    fn next(mut self): (Event ! HttpError)? {
        var kind = "message"
        var data: Array[String] = []
        var id: String? = none
        var started = false
        for {
            let line = match self.source.next() {
                some(ok(line)) => line
                some(err(error)) => return some(err(error))
                none if started => return some(ok(Event { event: kind, data: data.join("\n"), id }))
                none => return none
            }
            if line.isEmpty() {
                if started {
                    return some(ok(Event { event: kind, data: data.join("\n"), id }))
                }
                continue
            }
            if line.startsWith(":") {
                continue
            }
            let colon = line.find(":").unwrapOr(line.length())
            let field = line.slice(0, colon).unwrapOr("")
            let value = line.slice(colon + 1, line.length()).unwrapOr("").removePrefix(" ")
            if field == "event" {
                kind = value
            } else if field == "data" {
                data.push(value)
            } else if field == "id" {
                id = some(value)
            }
            started = true
        }
    }
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

/// Sends requests and keeps their connections for the next ones, over
/// HTTP/2 when the server offers it. Its URLs may be relative to
/// `baseUrl`, and its headers go with every request. `trust` names a PEM
/// file of certificates it trusts besides the system's, such as a company's
/// or a development certificate authority.
pub type Client = {
    priv native: httpNative.Native
    priv base: String
    priv defaults: Map[String, String]
    priv limit: __time.Duration?
    priv hooks: Array[
        fn(ClientRequest, fn(ClientRequest): Response ! HttpError): Response ! HttpError,
    ]
}

/// A request a client sends, as its hooks see it (`Client.use`): its
/// method, its final URL, with the client's base and the query, its
/// headers, the client's and its own, and its body.
pub type ClientRequest = {
    method: String
    url: String
    headers: Map[String, String]
    body: Body?
}

/// A client that keeps its connections for later requests: `baseUrl` goes
/// before each relative URL and `headers` with each request, whose own
/// headers win; `timeout` limits a request, its body included,
/// `connectTimeout` its connection; it follows up to `redirects` redirects,
/// and trusts the authorities of `trust` too, the path of a PEM file or its
/// text; it shows the certificate of `identity` to a server that asks for
/// one, as mutual TLS does. With `socket`,
/// each request goes through that Unix socket instead of the network, and
/// the URL gives only its path and `Host`. With `cookies`, it keeps the
/// cookies responses set and sends them with the next requests, as a
/// browser does.
pub fn Client.new(
    baseUrl: String = "",
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
    connectTimeout: __time.Duration? = none,
    redirects: Int = 10,
    trust: String? = none,
    socket: String? = none,
    cookies: Bool = false,
    identity: Tls? = none,
): Client {
    let connect = match connectTimeout {
        some(limit) => limit.milliseconds()
        none => 0
    }
    let (certificate, key, _, minimum) = tlsParts(identity)
    let connection = httpNative.client(
        connect,
        redirects,
        trust.unwrapOr(""),
        socket.unwrapOr(""),
        cookies,
        certificate,
        key,
        minimum,
    )
    Client { native: connection, base: baseUrl, defaults: headers, limit: timeout, hooks: [] }
}

/// Sends a `GET`; a status of 400 or more is `HttpError.Status`, with the
/// response.
pub fn Client.get(
    self,
    url: String,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    self.request("GET", url, none, query, headers, timeout)?
}

/// Sends a `HEAD`: the headers alone.
pub fn Client.head(
    self,
    url: String,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    self.request("HEAD", url, none, query, headers, timeout)?
}

/// Sends a `DELETE`.
pub fn Client.delete(
    self,
    url: String,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    self.request("DELETE", url, none, query, headers, timeout)?
}

/// Sends a `POST` with the body.
pub fn Client.post(
    self,
    url: String,
    body: Body? = none,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    self.request("POST", url, body, query, headers, timeout)?
}

/// Sends a `PUT` with the body.
pub fn Client.put(
    self,
    url: String,
    body: Body? = none,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    self.request("PUT", url, body, query, headers, timeout)?
}

/// Sends a `PATCH` with the body.
pub fn Client.patch(
    self,
    url: String,
    body: Body? = none,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    self.request("PATCH", url, body, query, headers, timeout)?
}

/// A request with any method. It waits for the response's head; a status
/// of 400 or more is `HttpError.Status`.
pub fn Client.request(
    self,
    method: String,
    url: String,
    body: Body? = none,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    var all = self.defaults
    for (name, value) in headers {
        all[name] = value
    }
    let limit = match timeout.orElse(self.limit) {
        some(limit) => limit.milliseconds()
        none => 0
    }
    let connection = self.native
    var outgoing: fn(ClientRequest): Response ! HttpError = (request) {
        deliver(connection, request, limit)?
    }
    for hook in self.hooks.reversed() {
        outgoing = hooked(hook, outgoing)
    }
    outgoing(
        ClientRequest {
            method: method
            url: withQuery(joined(self.base, url), query)
            headers: all
            body: body
        },
    )?
}

/// Adds a hook around each request of the client, as middleware is around
/// a server's routes: it gets the request and `next`, which sends it, and
/// may change it, time it, see its response or error, or answer without
/// sending it. The first added is the outermost; redirects happen inside
/// `next`.
pub fn Client.use(
    mut self,
    hook: fn(ClientRequest, fn(ClientRequest): Response ! HttpError): Response ! HttpError,
) {
    self.hooks.push(hook)
}

fn hooked(
    hook: fn(ClientRequest, fn(ClientRequest): Response ! HttpError): Response ! HttpError,
    next: fn(ClientRequest): Response ! HttpError,
): fn(ClientRequest): Response ! HttpError {
    (request) { hook(request, next)? }
}

/// Sends a request, with a limit in milliseconds, or 0 for none.
fn deliver(connection: httpNative.Native, request: ClientRequest, limit: Int): Response ! HttpError {
    var pairs: Array[String] = []
    for (name, value) in request.headers {
        pairs.push(name)
        pairs.push(value)
    }
    let sent = httpNative.send(
        connection,
        request.method,
        request.url,
        pairs,
        native(request.body)?,
        limit,
    )
    failed(sent)?
    let parts = httpNative.head(sent).split("\t")
    let response = Response {
        native: sent
        verb: request.method
        code: httpNative.status(sent)
        phrase: parts[0]
        finalUrl: parts[1]
        protocol: parts[2]
        headerList: httpNative.headers(sent)
    }
    if response.code >= 400 {
        fail HttpError.Status(response)
    }
    response
}

// A request without a client: one connection each.

/// Sends a `GET` on a connection of its own; a status of 400 or more is
/// `HttpError.Status`, with the response.
pub fn get(
    url: String,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    Client.new().request("GET", url, none, query, headers, timeout)?
}

/// Sends a `HEAD` on a connection of its own: the headers alone.
pub fn head(
    url: String,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    Client.new().request("HEAD", url, none, query, headers, timeout)?
}

/// Sends a `DELETE` on a connection of its own.
pub fn delete(
    url: String,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    Client.new().request("DELETE", url, none, query, headers, timeout)?
}

/// Sends a `POST` with the body, on a connection of its own.
pub fn post(
    url: String,
    body: Body? = none,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    Client.new().request("POST", url, body, query, headers, timeout)?
}

/// Sends a `PUT` with the body, on a connection of its own.
pub fn put(
    url: String,
    body: Body? = none,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    Client.new().request("PUT", url, body, query, headers, timeout)?
}

/// Sends a `PATCH` with the body, on a connection of its own.
pub fn patch(
    url: String,
    body: Body? = none,
    query: Map[String, String] = [:],
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): Response ! HttpError {
    Client.new().request("PATCH", url, body, query, headers, timeout)?
}

// ---------------------------------------------------------------------------
// WebSockets
// ---------------------------------------------------------------------------

/// A message of a WebSocket.
pub enum Message {
    Text(String)
    Binary(Array[Byte])
}

/// A text message as its text, a binary one as `3 bytes`.
impl Display for Message {
    fn display(self): String {
        match self {
            Message.Text(text) => text
            Message.Binary(bytes) => "{bytes.length()} bytes"
        }
    }
}

/// A WebSocket connection (RFC 6455), over TLS for `wss://`. One task can
/// send while another receives; pings are answered on their own. Iterating
/// it receives messages until the connection closes.
pub type WebSocket = {
    priv native: httpNative.Native
    priv closed: Bool
}

/// Opens a WebSocket (RFC 6455), over TLS for `wss://`; `timeout` limits
/// its handshake.
pub fn WebSocket.connect(
    url: String,
    headers: Map[String, String] = [:],
    timeout: __time.Duration? = none,
): WebSocket ! HttpError {
    var pairs: Array[String] = []
    for (name, value) in headers {
        pairs.push(name)
        pairs.push(value)
    }
    let limit = match timeout {
        some(limit) => limit.milliseconds()
        none => 0
    }
    let socket = httpNative.wsConnect(url, pairs, limit)
    failed(socket)?
    WebSocket { native: socket, closed: false }
}

/// Sends a message, of text or bytes.
pub fn WebSocket.send(self, message: Message): !HttpError {
    let problem = match message {
        Message.Text(text) => httpNative.wsSend(self.native, false, text, [])
        Message.Binary(bytes) => httpNative.wsSend(self.native, true, "", bytes)
    }
    if not problem.isEmpty() {
        fail HttpError.Protocol(problem)
    }
}

/// Sends a text message.
pub fn WebSocket.sendText(self, text: String): !HttpError {
    self.send(Message.Text(text))?
}

/// Sends a binary message.
pub fn WebSocket.sendBytes(self, bytes: Array[Byte]): !HttpError {
    self.send(Message.Binary(bytes))?
}

/// The next message, or `none` once the connection closed.
pub fn WebSocket.receive(self): Message? ! HttpError {
    let received = httpNative.wsReceive(self.native)
    failed(received)?
    let kind = httpNative.wsKind(received)
    if kind == 0 {
        return some(Message.Text(httpNative.wsText(received)))
    }
    if kind == 1 {
        return some(Message.Binary(httpNative.wsData(received)))
    }
    none
}

/// Closes the connection, telling the server.
pub fn WebSocket.close(self): !HttpError {
    let problem = httpNative.wsClose(self.native)
    if not problem.isEmpty() {
        fail HttpError.Protocol(problem)
    }
}

impl Iterator[Message ! HttpError] for WebSocket {
    fn next(mut self): (Message ! HttpError)? {
        if self.closed {
            return none
        }
        match self.receive() {
            ok(some(message)) => some(ok(message))
            ok(none) => {
                self.closed = true
                none
            }
            err(error) => {
                self.closed = true
                some(err(error))
            }
        }
    }
}

fn joined(base: String, url: String): String {
    if base.isEmpty() or url.startsWith("http://") or url.startsWith("https://") {
        return url
    }
    if url.isEmpty() {
        return base
    }
    "{base.removeSuffix("/")}/{url.removePrefix("/")}"
}

fn withQuery(url: String, query: Map[String, String]): String {
    if query.length() == 0 {
        return url
    }
    var pairs: Array[String] = []
    for (name, value) in query {
        pairs.push("{__encoding.urlEncode(name)}={__encoding.urlEncode(value)}")
    }
    let separator = if url.contains("?") { "&" } else { "?" }
    "{url}{separator}{pairs.join("&")}"
}

/// The runtime's body for a request.
fn native(body: Body?): httpNative.Native ! HttpError {
    let content = match body {
        some(given) => given.content
        none => return httpNative.bodyEmpty()
    }
    match content {
        Content.Data(bytes, contentType) => httpNative.bodyBytes(bytes, contentType)
        Content.Stream(input, length, contentType) => httpNative.bodyStream(
            input,
            length,
            contentType,
        )
        Content.Form(parts) => {
            let form = httpNative.form()
            for part in parts {
                match part.source {
                    Source.Field(value) => httpNative.formText(form, part.name, value)
                    Source.Data(bytes) => httpNative.formBytes(
                        form,
                        part.name,
                        bytes,
                        part.fileName,
                        part.contentType,
                    )
                    Source.File(path) => {
                        let problem = httpNative.formFile(form, part.name, path, part.contentType)
                        if not problem.isEmpty() {
                            fail HttpError.Body("cannot read `{path}`: {problem}")
                        }
                    }
                    Source.Stream(input, length) => {
                        httpNative.formStream(
                            form,
                            part.name,
                            input,
                            part.fileName,
                            part.contentType,
                            length,
                        )
                    }
                }
            }
            httpNative.bodyForm(form)
        }
    }
}

/// The failure the runtime recorded for a request or its body.
fn failed(sent: httpNative.Native): !HttpError {
    let failure = httpNative.failure(sent)
    if failure.isEmpty() {
        return
    }
    let tab = failure.find("\t").unwrapOr(0)
    let kind = failure.slice(0, tab).unwrapOr("")
    let why = failure.slice(tab + 1, failure.length()).unwrapOr("")
    if kind == "url" {
        fail HttpError.InvalidUrl(why)
    } else if kind == "timeout" {
        fail HttpError.Timeout
    } else if kind == "connect" {
        fail HttpError.Connect(why)
    } else if kind == "body" {
        fail HttpError.Body(why)
    }
    fail HttpError.Protocol(why)
}

// ---------------------------------------------------------------------------
// Servers: problems, requests and replies
// ---------------------------------------------------------------------------

/// Why a handler cannot answer: a status of 400 or more and a message for
/// the client, which receives it as `application/problem+json` (RFC 9457).
/// For a status of 500 or more the client sees only `internal server
/// error`, and the message goes to standard error.
pub type Problem = {
    status: Int
    message: String
    /// The rules of its type a value breaks, which a `422` lists in
    /// `errors`.
    violations: Array[__serialization.Violation]
}

impl Display for Problem {
    fn display(self): String {
        "{self.status} {self.message}"
    }
}

/// A problem with an HTTP status and a message, which the server sends as
/// `application/problem+json`.
pub fn Problem.new(status: Int, message: String): Problem {
    Problem { status, message, violations: [] }
}

/// A `400 Bad Request` problem.
pub fn Problem.badRequest(message: String): Problem {
    Problem { status: 400, message, violations: [] }
}

/// A `401 Unauthorized` problem.
pub fn Problem.unauthorized(message: String = "authentication is required"): Problem {
    Problem { status: 401, message, violations: [] }
}

/// A `403 Forbidden` problem.
pub fn Problem.forbidden(message: String = "this is not allowed"): Problem {
    Problem { status: 403, message, violations: [] }
}

/// A `404 Not Found` problem.
pub fn Problem.notFound(message: String = "not found"): Problem {
    Problem { status: 404, message, violations: [] }
}

/// A `422 Unprocessable Content` problem: a value that breaks the rules of
/// its type, each violation in the `errors` of the reply.
pub fn Problem.invalid(violations: Array[__serialization.Violation]): Problem {
    let shown = violations.map((violation) { "{violation}" }).join("; ")
    Problem { status: 422, message: "the value breaks the rules of its type: {shown}", violations }
}

/// A `409 Conflict` problem.
pub fn Problem.conflict(message: String): Problem {
    Problem { status: 409, message, violations: [] }
}

/// A failure of the server's own, for `result.mapErr(http.Problem.from)?`.
pub fn Problem.from[E: Display](error: E): Problem {
    Problem { status: 500, message: "{error}", violations: [] }
}

/// A request a server received.
pub type Request = {
    priv native: httpNative.Native
    priv verb: String
    priv target: String
    priv queryText: String
    priv protocol: String
    priv peer: String
    /// The host it was for, from `:authority` or `Host`, and whether it came
    /// over TLS.
    priv authority: String
    priv secure: Bool
    priv headerList: Array[String]
    priv params: Map[String, String]
    /// The route that answers it, chosen before the middleware runs, and
    /// without one the methods of the routes of its path, for `405`.
    priv chosen: Route?
    priv allowed: Array[String]
    /// The networks of the proxies the app trusts (`App.trustProxies`).
    priv trusted: Array[__net.Network]
}

/// The method: `GET`, `POST`.
pub fn Request.method(self): String {
    self.verb
}

/// The template of the route that answers the request, as it was added and
/// with the prefix of `mount`: `/users/:id` for `GET /users/42`; `none` when
/// no route does. The middleware sees it before `next`: it names the request
/// for a tracer or a metric without growing with each value of a parameter,
/// as the path does.
pub fn Request.route(self): String? {
    self.chosen.map((route) { "/{route.pattern.join("/")}" })
}

/// The path, without the query.
pub fn Request.path(self): String {
    self.target
}

/// The query as it arrived, without `?` and not decoded.
pub fn Request.rawQuery(self): String {
    self.queryText
}

/// The host the request was for, with its port if it gave one: `Host`, or
/// `:authority` in HTTP/2. Behind a proxy of a network the app trusts
/// (`App.trustProxies`), the one `X-Forwarded-Host` gives.
pub fn Request.host(self): String {
    match self.forwarded("x-forwarded-host") {
        some(host) => host
        none => self.authority
    }
}

/// `https` when the server listens with TLS, and `http` if not. Behind a
/// proxy of a network the app trusts, the one `X-Forwarded-Proto` gives.
pub fn Request.scheme(self): String {
    match self.forwarded("x-forwarded-proto") {
        some(scheme) => scheme.toLower()
        none => if self.secure { "https" } else { "http" }
    }
}

/// The URL the request was for: its scheme, host, path and query.
pub fn Request.url(self): __url.Url {
    let query = if self.queryText.isEmpty() { "" } else { "?{self.queryText}" }
    match __url.parse("{self.scheme()}://{self.host()}{self.target}{query}") {
        ok(whole) => whole
        // A host no URL can hold: the path and the query alone.
        err(_) => match __url.parse("{self.target}{query}") {
            ok(part) => part
            err(_) => match __url.parse("/") {
                ok(root) => root
                err(_) => panic("`/` is a URL")
            }
        }
    }
}

/// The first value of a header a trusted proxy wrote, or `none`.
fn Request.forwarded(self, name: String): String? {
    if not trusts(self.trusted, hostOf(self.peer)) {
        return none
    }
    self
        .header(name)
        .map((value) { value.split(",")[0].trim() })
        .filter((value) { not value.isEmpty() })
}

/// The protocol: `HTTP/1.1` or `HTTP/2`.
pub fn Request.version(self): String {
    self.protocol
}

/// The certificate the client showed, when the server requires one of
/// its clients (`Tls.files(..., clients: "ca.pem")`): who it is.
pub fn Request.clientCertificate(self): __crypto.Certificate? {
    let der = httpNative.requestCertificate(self.native)
    if der.isEmpty() {
        return none
    }
    __crypto.Certificate.fromDer(der).ok()
}

/// The client's address and port.
pub fn Request.remoteAddress(self): String {
    self.peer
}

/// The client's IP address, without its port. A connection from a proxy of
/// a network the app trusts (`App.trustProxies`) gives the address the
/// proxies wrote: the last of `X-Forwarded-For` that is not of those
/// networks, or `X-Real-Ip`, as Gin's `ClientIP`. Without trusted proxies
/// no header is believed, since any client can write one.
pub fn Request.clientIp(self): String {
    let remote = hostOf(self.peer)
    if not trusts(self.trusted, remote) {
        return remote
    }
    match self.header("x-forwarded-for") {
        some(forwarded) => {
            // Each proxy adds the address it was connected from, so the
            // nearest come last.
            var last = remote
            for hop in forwarded.split(",").reversed() {
                match __net.ip(hop.trim()) {
                    ok(address) => {
                        last = "{address}"
                        if not trusts(self.trusted, last) {
                            return last
                        }
                    }
                    err(_) => return remote
                }
            }
            last
        }
        none => match self.header("x-real-ip") {
            some(real) => __net.ip(real.trim()).map((address) { "{address}" }).unwrapOr(remote)
            none => remote
        }
    }
}

/// The address of `1.2.3.4:5678` or `[::1]:5678`, without its port.
fn hostOf(peer: String): String {
    if peer.startsWith("[") {
        return peer.slice(1, peer.find("]").unwrapOr(1)).unwrapOr(peer)
    }
    match peer.findLast(":") {
        some(at) => peer.slice(0, at).unwrapOr(peer)
        none => peer
    }
}

/// Whether the address is of one of the networks.
fn trusts(networks: Array[__net.Network], address: String): Bool {
    match __net.ip(address) {
        ok(ip) => {
            for network in networks {
                if network.contains(ip) {
                    return true
                }
            }
            false
        }
        err(_) => false
    }
}

/// The value of the cookie the client sent under `name`, decoded with
/// `encoding.urlDecode`, or `none`.
pub fn Request.cookie(self, name: String): String? {
    self.cookies().get(name)
}

/// The cookies the client sent, by name, their values decoded.
pub fn Request.cookies(self): Map[String, String] {
    var found: Map[String, String] = [:]
    var index = 0
    for index + 1 < self.headerList.length() {
        if self.headerList[index] == "cookie" {
            for pair in self.headerList[index + 1].split(";") {
                match nameAndValue(pair) {
                    some((name, value)) => found[name] = value
                    none => {}
                }
            }
        }
        index += 2
    }
    found
}

/// A parameter of the route, decoded: `id` in `/users/:id`.
pub fn Request.param(self, name: String): String {
    self.params.getOr(name, "")
}

/// A parameter of the route that must be an integer.
pub fn Request.intParam(self, name: String): Int ! Problem {
    let text = self.param(name)
    match Int.parse(text) {
        ok(value) => value
        err(_) => fail Problem.badRequest("the parameter `{name}` must be an integer, not `{text}`")
    }
}

/// The first value of a query parameter, decoded.
pub fn Request.query(self, name: String): String? {
    self.queryValues(name).first()
}

/// Every value of a query parameter, decoded.
pub fn Request.queryValues(self, name: String): Array[String] {
    pairsOf(self.queryText).filter((pair) { pair.0 == name }).map((pair) { pair.1 })
}

/// The query string read into a `T`: each field from the parameter of its
/// name, without case, `_` or `-`, so `page_size` fills `pageSize`; a list
/// from a name that repeats or one value; each value as text, which any
/// scalar reads. A parameter that does not read is a `400` problem, and a
/// value that breaks the rules of its type a `422`.
pub fn Request.queryAs[T: __serialization.Decode](self): T ! Problem {
    readInto[T](pairsOf(self.queryText), "the query")?
}

/// The fields of a URL-encoded form body read into a `T`, as `queryAs`
/// reads the query.
pub fn Request.formAs[T: __serialization.Decode](self): T ! Problem {
    readInto[T](pairsOf(self.text()?), "the form")?
}

/// The names and values of a query string or a URL-encoded form, decoded,
/// in order.
fn pairsOf(text: String): Array[(String, String)] {
    var pairs: Array[(String, String)] = []
    for pair in text.split("&") {
        if pair.isEmpty() {
            continue
        }
        let equals = pair.find("=").unwrapOr(pair.length())
        let name = formDecoded(pair.slice(0, equals).unwrapOr(""))
        pairs.push((name, formDecoded(pair.slice(equals + 1, pair.length()).unwrapOr(""))))
    }
    pairs
}

fn readInto[T: __serialization.Decode](pairs: Array[(String, String)], what: String): T ! Problem {
    match __serialization.Decode.decode[T](Fields.of(pairs), __serialization.Event.BeginMap) {
        ok(value) => value
        err(error) if error.kind == __serialization.ErrorKind.Invalid => fail Problem.invalid(
            error.violations,
        )
        err(error) => fail Problem.badRequest("{what}: {error}")
    }
}

/// The events of names and values as a record reads them: each name a key,
/// its values one untyped text or a list of them; served from the end.
type Fields = {
    events: __sync.Mutex[Array[__serialization.Event]]
    /// The parameter being read, which an error names.
    current: __sync.Mutex[String]
}

fn Fields.of(pairs: Array[(String, String)]): Fields {
    var names: Array[String] = []
    var values: Map[String, Array[String]] = [:]
    for (name, value) in pairs {
        match values.get(name) {
            some(found) => values[name] = found.concat([value])
            none => {
                names.push(name)
                values[name] = [value]
            }
        }
    }
    var events: Array[__serialization.Event] = []
    for name in names {
        events.push(__serialization.Event.Key(name))
        let given = values.get(name).unwrapOr([])
        if given.length() == 1 {
            events.push(__serialization.Event.Untyped(given[0]))
        } else {
            events.push(__serialization.Event.BeginList)
            for value in given {
                events.push(__serialization.Event.Untyped(value))
            }
            events.push(__serialization.Event.EndList)
        }
    }
    events.push(__serialization.Event.EndMap)
    events.reverse()
    Fields { events: __sync.Mutex(events), current: __sync.Mutex("") }
}

/// A name as a parameter and a field compare: without case, `_` or `-`.
fn foldedName(name: String): String {
    name.replace("_", "").replace("-", "").toLowerAscii()
}

impl __serialization.Source for Fields {
    fn next(self): __serialization.Event? ! __serialization.Error {
        self.events.update((events) { events.pop() })
    }

    fn skip(self, first: __serialization.Event): !__serialization.Error {
        if first == __serialization.Event.BeginList {
            for {
                match self.next()? {
                    some(__serialization.Event.EndList) => return
                    none => return
                    _ => {}
                }
            }
        }
    }

    fn failure(self, kind: __serialization.ErrorKind, message: String): __serialization.Error {
        let at = self.current.get()
        __serialization.Error {
            kind
            message
            path: if at.isEmpty() { "$" } else { at }
            line: 0
            column: 0
            violations: []
        }
    }

    /// The field a parameter is, by its name without case, `_` or `-`.
    fn nextField(self, names: Array[String]): Int? ! __serialization.Error {
        let wanted = names.map((name) { foldedName(name) })
        for {
            match self.next()? {
                some(__serialization.Event.Key(key)) => {
                    let given = foldedName(key)
                    match wanted.findIndex((name) { name == given }) {
                        some(index) => {
                            self.current.set(key)
                            return some(index)
                        }
                        none => {
                            let first = self.value()?
                            self.skip(first)?
                        }
                    }
                }
                _ => {
                    self.current.set("")
                    return none
                }
            }
        }
    }

    /// A list: the values of a name that repeats, or its one value.
    fn beginList(self, first: __serialization.Event, name: String): !__serialization.Error {
        match first {
            __serialization.Event.BeginList => {}
            __serialization.Event.Untyped(_) => self.events.update(
                (events) {
                    events.push(__serialization.Event.EndList)
                    events.push(first)
                },
            )
            _ => fail self.mismatch(first, name)
        }
    }
}

/// A query parameter that must be there.
pub fn Request.requiredQuery(self, name: String): String ! Problem {
    match self.query(name) {
        some(value) => value
        none => fail Problem.badRequest("the query parameter `{name}` is missing")
    }
}

/// A query parameter that must be there and be an integer.
pub fn Request.requiredIntQuery(self, name: String): Int ! Problem {
    match self.intQuery(name)? {
        some(value) => value
        none => fail Problem.badRequest("the query parameter `{name}` is missing")
    }
}

/// A query parameter that must be an integer when it is there.
pub fn Request.intQuery(self, name: String): Int? ! Problem {
    match self.query(name) {
        none => none
        some(text) => match Int.parse(text) {
            ok(value) => some(value)
            err(_) => fail Problem.badRequest(
                "the query parameter `{name}` must be an integer, not `{text}`",
            )
        }
    }
}

/// The first value of a header, by its name in any case.
pub fn Request.header(self, name: String): String? {
    let wanted = name.toLower()
    var index = 0
    for index + 1 < self.headerList.length() {
        if self.headerList[index] == wanted {
            return some(self.headerList[index + 1])
        }
        index += 2
    }
    none
}

/// Every value of a header, by its name in any case, in order.
pub fn Request.headerValues(self, name: String): Array[String] {
    let wanted = name.toLower()
    var values: Array[String] = []
    var index = 0
    for index + 1 < self.headerList.length() {
        if self.headerList[index] == wanted {
            values.push(self.headerList[index + 1])
        }
        index += 2
    }
    values
}

/// The headers, lowercase, with the values of a repeated one joined by
/// `, `.
pub fn Request.headers(self): Map[String, String] {
    var out: Map[String, String] = [:]
    var index = 0
    for index + 1 < self.headerList.length() {
        let (name, value) = (self.headerList[index], self.headerList[index + 1])
        out[name] = match out.get(name) {
            some(before) => "{before}, {value}"
            none => value
        }
        index += 2
    }
    out
}

/// The request with a body of up to `bytes`, more or fewer than the
/// server's `Limits.body`, as a route of uploads needs: before the body is
/// read, by the handler or a middleware.
pub fn Request.limitBody(self, bytes: Int): Request {
    httpNative.requestLimit(self.native, bytes)
    self
}

/// The problem of a body, or a part of one, that could not be read: `413`
/// past its limit, else `400`.
fn bodyProblem(request: httpNative.Native, what: String, failure: String): Problem {
    if httpNative.requestExceeded(request) {
        return Problem.new(
            413,
            "{what} is larger than this server takes: raise the limit of the route with `request.limitBody(bytes)`, or the server's with `Limits.body`",
        )
    }
    Problem.badRequest("{what}: {failure.removePrefix("body\t")}")
}

/// The whole body; one that cannot be read is a `400` problem, and one
/// larger than its limit `413`.
pub fn Request.bytes(self): Array[Byte] ! Problem {
    let bytes = httpNative.requestRead(self.native)
    let failure = httpNative.failure(self.native)
    if not failure.isEmpty() {
        fail bodyProblem(self.native, "the body", failure)
    }
    bytes
}

/// The body as text, in the charset its content type names, as
/// `Response.text()` reads it.
pub fn Request.text(self): String ! Problem {
    let windows = match windows1252(self.header("content-type").unwrapOr("")) {
        ok(windows) => windows
        err(why) => fail Problem.badRequest("the body: {why}")
    }
    let bytes = self.bytes()?
    if windows {
        return httpNative.windows1252(bytes)
    }
    match String.fromBytes(bytes) {
        ok(text) => text
        err(_) => fail Problem.badRequest("the body is not UTF-8 text")
    }
}

/// The body as the JSON of a `T` (`std.json`), decoded as it arrives; a
/// body that is not one is `400` with the reason.
pub fn Request.json[T: __serialization.Decode](self): T ! Problem {
    match __json.decodeFrom[T](self.body()) {
        ok(value) => value
        err(error) if error.kind == __serialization.ErrorKind.Invalid => {
            fail Problem.invalid(error.violations)
        }
        err(error) if httpNative.requestExceeded(self.native) => fail bodyProblem(
            self.native,
            "the body",
            "{error}",
        )
        err(error) => fail Problem.badRequest("the body is not the JSON expected: {error}")
    }
}

/// The fields of a URL-encoded form body.
pub fn Request.form(self): Map[String, String] ! Problem {
    var fields: Map[String, String] = [:]
    for (name, value) in pairsOf(self.text()?) {
        fields[name] = value
    }
    fields
}

/// The parts of a `multipart/form-data` body, in order, as they arrive.
pub fn Request.uploads(self): Uploads {
    Uploads { form: httpNative.requestForm(self.native), request: self.native, done: false }
}

/// The body as a stream, read as the program asks for it.
pub fn Request.body(self): __io.Reader {
    httpNative.requestBody(self.native)
}

/// Writes the body to a file as it arrives; how many bytes.
pub fn Request.saveTo(self, path: String): Int ! Problem {
    let size = httpNative.saveBody(self.native, path, 0)
    if size < 0 {
        let failure = httpNative.failure(self.native)
        if httpNative.requestExceeded(self.native) {
            fail bodyProblem(self.native, "the body", failure)
        }
        fail Problem.from(failure.removePrefix("body\t"))
    }
    size
}

/// A query or form value as it was meant: `+` is a space.
fn formDecoded(text: String): String {
    __encoding.urlDecode(text.replace("+", " ")).unwrapOr(text)
}

/// A part of a multipart body. Parts arrive in order: reading one skips
/// what the ones before left unread.
pub type Upload = {
    priv native: httpNative.Native
    priv request: httpNative.Native
    priv field: String
    priv file: String
    priv kind: String
}

/// The form field's name.
pub fn Upload.name(self): String {
    self.field
}

/// The file's name the client gave, or an empty string for a field.
pub fn Upload.fileName(self): String {
    self.file
}

/// The content type the client gave the file.
pub fn Upload.contentType(self): String {
    self.kind
}

/// The whole file; one that cannot be read is a `400` problem.
pub fn Upload.bytes(self): Array[Byte] ! Problem {
    let bytes = httpNative.uploadRead(self.native)
    let failure = httpNative.failure(self.native)
    if not failure.isEmpty() {
        fail bodyProblem(self.request, "the part `{self.field}`", failure)
    }
    bytes
}

/// The file as UTF-8 text; one that is not is a `400` problem.
pub fn Upload.text(self): String ! Problem {
    match String.fromBytes(self.bytes()?) {
        ok(text) => text
        err(_) => fail Problem.badRequest("the part `{self.field}` is not UTF-8 text")
    }
}

/// Writes the part to a file as it arrives; how many bytes.
pub fn Upload.saveTo(self, path: String): Int ! Problem {
    let size = httpNative.uploadSave(self.native, path)
    if size < 0 {
        let failure = httpNative.failure(self.native)
        if httpNative.requestExceeded(self.request) {
            fail bodyProblem(self.request, "the part `{self.field}`", failure)
        }
        fail Problem.from(failure.removePrefix("body\t"))
    }
    size
}

/// The parts of a multipart body, as `Request.uploads()` gives them.
pub type Uploads = {
    priv form: httpNative.Native
    priv request: httpNative.Native
    priv done: Bool
}

impl Iterator[Upload ! Problem] for Uploads {
    fn next(mut self): (Upload ! Problem)? {
        if self.done {
            return none
        }
        let failure = httpNative.failure(self.form)
        if not failure.isEmpty() {
            self.done = true
            return some(err(bodyProblem(self.request, "the body", failure)))
        }
        let part = httpNative.formNext(self.form)
        let problem = httpNative.failure(part)
        if not problem.isEmpty() {
            self.done = true
            return some(err(bodyProblem(self.request, "the body", problem)))
        }
        let described = httpNative.uploadHead(part)
        if described.isEmpty() {
            self.done = true
            return none
        }
        let parts = described.split("\t")
        some(ok(Upload {
            native: part
            request: self.request
            field: parts[0]
            file: parts[1]
            kind: parts[2]
        }))
    }
}

enum Payload {
    Data(Array[Byte])
    Stream(__io.Reader)
    File(String, String)
    /// An embedded file: its path, its bytes and the digest of its `ETag`.
    Embedded(String, Array[Byte], String)
    Events(Receiver[Event])
    /// Where the socket goes once it is upgraded, for the task that talks.
    Socket(__sync.Mutex[Handoff])
}

/// What a handler answers.
pub type Reply = {
    priv code: Int
    priv headerList: Array[String]
    priv payload: Payload
}

/// A reply of text, as `text/plain; charset=utf-8`.
pub fn Reply.text(text: String, status: Int = 200): Reply {
    Reply {
        code: status
        headerList: ["content-type", "text/plain; charset=utf-8"]
        payload: Payload.Data(text.bytes())
    }
}

/// A reply of HTML, as `text/html; charset=utf-8`.
pub fn Reply.html(html: String, status: Int = 200): Reply {
    Reply {
        code: status
        headerList: ["content-type", "text/html; charset=utf-8"]
        payload: Payload.Data(html.bytes())
    }
}

/// The value as JSON (`std.json`).
pub fn Reply.json[T: __serialization.Encode](value: T, status: Int = 200): Reply {
    let data = __json.encode(value).bytes()
    Reply {
        code: status
        headerList: ["content-type", "application/json"]
        payload: Payload.Data(data)
    }
}

/// A reply of bytes, with their content type.
pub fn Reply.bytes(
    bytes: Array[Byte],
    contentType: String = "application/octet-stream",
    status: Int = 200,
): Reply {
    Reply { code: status, headerList: ["content-type", contentType], payload: Payload.Data(bytes) }
}

/// What a stream gives, sent as it gives it.
pub fn Reply.stream(
    input: __io.Reader,
    contentType: String = "application/octet-stream",
    status: Int = 200,
): Reply {
    Reply {
        code: status
        headerList: ["content-type", contentType]
        payload: Payload.Stream(input)
    }
}

/// A file, with the content type of its extension. It answers `Range`
/// requests with the part asked for, so downloads resume, and
/// `If-None-Match` and `If-Modified-Since` with `304`. With `download`,
/// the browser saves it under that name. A missing file is `404`.
pub fn Reply.file(path: String, download: String? = none): Reply {
    Reply { code: 200, headerList: [], payload: Payload.File(path, download.unwrapOr("")) }
}

/// Server-Sent Events: each event the channel receives, until it closes.
pub fn Reply.events(events: Receiver[Event]): Reply {
    Reply { code: 200, headerList: ["cache-control", "no-cache"], payload: Payload.Events(events) }
}

/// A reply that sends the client to `url`: `302 Found` unless another
/// status.
pub fn Reply.redirect(url: String, status: Int = 302): Reply {
    Reply { code: status, headerList: ["location", url], payload: Payload.Data([]) }
}

/// A reply without a body: `204 No Content` unless another status.
pub fn Reply.empty(status: Int = 204): Reply {
    Reply { code: status, headerList: [], payload: Payload.Data([]) }
}

/// A `404 Not Found` reply, as a problem.
pub fn Reply.notFound(): Reply {
    problemReply(Problem.notFound())
}

/// The same reply with one more header.
pub fn Reply.header(self, name: String, value: String): Reply {
    var headers = self.headerList
    headers.push(name)
    headers.push(value)
    Reply { code: self.code, headerList: headers, payload: self.payload }
}

/// When a browser sends a cookie from another site's page: `Lax` with the
/// links that lead to this one, `Strict` never, `None` always, which takes
/// `Secure`.
pub enum SameSite {
    Lax
    Strict
    None
}

/// The reply with a cookie, its value written with `encoding.urlEncode` so
/// any text fits. A `maxAge` of zero removes it, and without one it lasts
/// the browser's session; `httpOnly` hides it from the page's JavaScript and
/// `secure` sends it over HTTPS only.
pub fn Reply.cookie(
    self,
    name: String,
    value: String,
    maxAge: __time.Duration? = none,
    path: String = "/",
    domain: String = "",
    secure: Bool = false,
    httpOnly: Bool = true,
    sameSite: SameSite = SameSite.Lax,
): Reply {
    var parts = ["{name}={__encoding.urlEncode(value)}", "Path={path}"]
    if not domain.isEmpty() {
        parts.push("Domain={domain}")
    }
    match maxAge {
        some(age) => parts.push("Max-Age={age.seconds().max(0)}")
        none => {}
    }
    if secure or sameSite == SameSite.None {
        parts.push("Secure")
    }
    if httpOnly {
        parts.push("HttpOnly")
    }
    let site = match sameSite {
        SameSite.Lax => "Lax"
        SameSite.Strict => "Strict"
        SameSite.None => "None"
    }
    parts.push("SameSite={site}")
    self.header("set-cookie", parts.join("; "))
}

/// The reply's status code.
pub fn Reply.status(self): Int {
    self.code
}

/// The headers set so far, lowercase, with the values of a repeated one
/// joined by `, `, as a middleware reads them.
pub fn Reply.headers(self): Map[String, String] {
    var out: Map[String, String] = [:]
    var index = 0
    for index + 1 < self.headerList.length() {
        let (name, value) = (self.headerList[index].toLower(), self.headerList[index + 1])
        out[name] = match out.get(name) {
            some(before) => "{before}, {value}"
            none => value
        }
        index += 2
    }
    out
}

/// A problem as `application/problem+json`.
fn problemReply(problem: Problem): Reply {
    let detail = if problem.status >= 500 {
        _ = __console.stderr().writeLine("http: {problem.status} {problem.message}")
        "internal server error"
    } else {
        problem.message
    }
    var errors = ""
    if not problem.violations.isEmpty() {
        let each = problem.violations.map(
            (violation) {
                "{{\"path\":{__json.encode(violation.path)},\"message\":{__json.encode(violation.message)}}}"
            },
        )
        errors = ",\"errors\":[{each.join(",")}]"
    }
    let body = "{{\"status\":{problem.status},\"detail\":{__json.encode(detail)}{errors}}}"
    Reply {
        code: problem.status
        headerList: ["content-type", "application/problem+json"]
        payload: Payload.Data(body.bytes())
    }
}

// ---------------------------------------------------------------------------
// Servers: applications
// ---------------------------------------------------------------------------

type Route = {
    method: String
    pattern: Array[String]
    handler: fn(Request): Reply ! Problem
}

/// The routes, middleware and documentation of a server. Routes match a
/// method and a path whose `:name` segments are parameters and whose last
/// may be `*name`, the rest of the path; a route with fixed segments wins
/// over one with parameters.
pub type App = {
    priv routes: Array[Route]
    priv layers: Array[fn(Request, fn(Request): Reply ! Problem): Reply ! Problem]
    priv operations: Array[(String, String, String)]
    priv schemas: Map[String, String]
    priv docs: (String, String, String)?
    priv proxies: Array[__net.Network]
}

/// An app without routes.
pub fn App.new(): App {
    App { routes: [], layers: [], operations: [], schemas: [:], docs: none, proxies: [] }
}

/// Routes `GET` and `HEAD` requests of `path`, whose `:name` segments are
/// parameters and whose last may be `*name`, the rest of the path.
pub fn App.get(mut self, path: String, handler: fn(Request): Reply ! Problem) {
    self.route("GET", path, handler)
}

/// Routes `POST` requests of `path`, whose `:name` segments are parameters.
pub fn App.post(mut self, path: String, handler: fn(Request): Reply ! Problem) {
    self.route("POST", path, handler)
}

/// Routes `PUT` requests of `path`, whose `:name` segments are parameters.
pub fn App.put(mut self, path: String, handler: fn(Request): Reply ! Problem) {
    self.route("PUT", path, handler)
}

/// Routes `PATCH` requests of `path`, whose `:name` segments are
/// parameters.
pub fn App.patch(mut self, path: String, handler: fn(Request): Reply ! Problem) {
    self.route("PATCH", path, handler)
}

/// Routes `DELETE` requests of `path`, whose `:name` segments are
/// parameters.
pub fn App.delete(mut self, path: String, handler: fn(Request): Reply ! Problem) {
    self.route("DELETE", path, handler)
}

/// A route of a method, or of any with `"*"`; `operation` is its OpenAPI
/// operation object and
/// `schemas` the JSON Schemas it refers to by name. The compiler writes both
/// for a route with a literal path.
pub fn App.route(
    mut self,
    method: String,
    path: String,
    handler: fn(Request): Reply ! Problem,
    operation: String = "",
    schemas: Map[String, String] = [:],
) {
    self.routes.push(Route { method: method.toUpper(), pattern: segments(path), handler })
    // OpenAPI describes each method: a route of any is not described.
    if not operation.isEmpty() and method != "*" {
        self.operations.push((method.toLower(), path, operation))
    }
    for (name, schema) in schemas {
        self.schemas[name] = schema
    }
}

/// Middleware, around every route of this app and its answers to paths
/// with no route: it can answer by itself or call `next`. The first added
/// is the outermost.
pub fn App.use(mut self, middleware: fn(Request, fn(Request): Reply ! Problem): Reply ! Problem) {
    self.layers.push(middleware)
}

/// The routes of another app under a prefix, with its middleware around
/// them.
pub fn App.mount(mut self, prefix: String, other: App) {
    for route in other.routes {
        var handler = route.handler
        for layer in other.layers.reversed() {
            handler = wrapped(layer, handler)
        }
        var pattern = segments(prefix)
        pattern.extend(route.pattern)
        self.routes.push(Route { method: route.method, pattern, handler })
    }
    for (method, path, operation) in other.operations {
        self.operations.push((method, "{prefix.removeSuffix("/")}{path}", operation))
    }
    for (name, schema) in other.schemas {
        self.schemas[name] = schema
    }
}

/// Serves the files of a tree at `{prefix}/...`: `GET` and `HEAD`, with
/// ranges, so downloads resume, the content type of each file's extension
/// and an `ETag`. A folder's path answers with its `index.html`, or, with
/// `listing`, with a page of its entries, to open them or download the
/// files. Paths cannot leave the tree. `fs.disk("public")` serves a
/// directory, and `embed.files("public")` the files kept in the executable.
pub fn App.files(mut self, prefix: String, files: __fs.FileSystem, listing: Bool = false) {
    let base = prefix.removeSuffix("/")
    self.route(
        "GET",
        "{base}/*path",
        (request) {
            let relative = request.param("path")
            _ = inside("", relative)?
            let at = relative.removePrefix("/").removeSuffix("/")
            let folder = match files.metadata(at) {
                ok(found) => found.kind == __fs.FileKind.Directory
                err(_) => false
            }
            if folder and listing {
                return listingPage(base, relative, files, at)?
            }
            if folder {
                return served(files, if at.isEmpty() { "index.html" } else { "{at}/index.html" })?
            }
            served(files, at)?
        },
    )
}

/// A file of a tree: the disk's from its path, so the runtime sends it with
/// ranges and its time, and another's from memory, with its digest.
fn served(files: __fs.FileSystem, at: String): Reply ! Problem {
    match files.directory() {
        some(root) => Reply.file(inside(root, at)?)
        none => match files.readBytes(at) {
            ok(contents) => {
                let tag = match files.tag(at) {
                    some(tag) => tag
                    none => __hash.sha256(contents).hex().slice(0, 16).unwrapOr("")
                }
                Reply { code: 200, headerList: [], payload: Payload.Embedded(at, contents, tag) }
            }
            err(_) => fail Problem.notFound()
        }
    }
}

/// The page of a directory's entries, folders first: a link to open each,
/// and one to download each file.
fn listingPage(base: String, relative: String, tree: __fs.FileSystem, at: String): Reply ! Problem {
    let names = match tree.list(at) {
        ok(names) => names
        err(_) => fail Problem.notFound()
    }
    let parts = segments(relative)
    let encoded = parts.map((part) { __encoding.urlEncode(part) })
    let here = if encoded.isEmpty() { base } else { "{base}/{encoded.join("/")}" }
    var rows: Array[String] = []
    if not parts.isEmpty() {
        let up = encoded.take(encoded.length() - 1).join("/")
        rows.push("<tr><td><a href=\"{base}/{up}\">../</a></td><td></td><td></td></tr>")
    }
    var files: Array[String] = []
    for name in names {
        let href = "{here}/{__encoding.urlEncode(name)}"
        let shown = escaped(name)
        let child = if at.isEmpty() { name } else { "{at}/{name}" }
        let found = tree.metadata(child)
        if found.map((entry) { entry.kind == __fs.FileKind.Directory }).unwrapOr(false) {
            rows.push("<tr><td><a href=\"{href}\">{shown}/</a></td><td></td><td></td></tr>")
        } else {
            let size = match found {
                ok(entry) => sizeText(entry.size)
                err(_) => ""
            }
            let link = "<a href=\"{href}\">{shown}</a>"
            let download = "<a href=\"{href}\" download>download</a>"
            files.push("<tr><td>{link}</td><td class=\"size\">{size}</td><td>{download}</td></tr>")
        }
    }
    rows.extend(files)
    let title = escaped("{base}/{parts.join("/")}")
    let style = [
        "body {{ font: 15px system-ui, sans-serif; margin: 2em auto; max-width: 50em; padding: 0 1em }}",
        "table {{ border-collapse: collapse; width: 100% }}",
        "td {{ padding: .4em .6em; border-bottom: 1px solid #8884 }}",
        "td.size {{ text-align: right; color: #888 }}",
        "a {{ text-decoration: none }}",
    ]
    var page = [
        "<!doctype html>",
        "<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\">",
        "<title>{title}</title><style>{style.join(" ")}</style></head>",
        "<body><h1>{title}</h1><table>",
    ]
    page.extend(rows)
    page.push("</table></body></html>\n")
    Reply.html(page.join("\n"))
}

fn sizeText(size: Int): String {
    if size < 1024 {
        return "{size} B"
    }
    var tenths = size * 10 / 1024
    for unit in ["KB", "MB", "GB"] {
        if tenths < 10240 or unit == "GB" {
            return "{tenths / 10}.{tenths % 10} {unit}"
        }
        tenths = tenths / 1024
    }
    "{size} B"
}

fn escaped(text: String): String {
    text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

/// Takes uploads into a directory at `{prefix}/...`: `PUT` writes its body
/// to that file, from the byte a `Content-Range: bytes start-end/total`
/// says, so an upload resumes after a `HEAD` of the files' route tells how
/// much arrived; `POST` with a multipart form saves each file part under
/// that folder by its file name. Both answer with the JSON of what they
/// wrote, `201` for a new file.
pub fn App.uploads(mut self, prefix: String, directory: String) {
    let pattern = "{prefix.removeSuffix("/")}/*path"
    self.route(
        "PUT",
        pattern,
        (request) {
            let relative = request.param("path")
            let path = inside(directory, relative)?
            let offset = match request.header("content-range") {
                some(range) => rangeStart(range)?
                none => 0
            }
            let size = httpNative.saveBody(request.native, path, offset)
            if size < 0 {
                fail Problem.conflict(httpNative.failure(request.native).removePrefix("body\t"))
            }
            Reply.bytes(
                savedJson([Saved { path: relative, size }]),
                contentType: "application/json",
                status: if offset == 0 { 201 } else { 200 },
            )
        },
    )
    self.route(
        "POST",
        pattern,
        (request) {
            let folder = request.param("path")
            var saved: Array[Saved] = []
            for part in request.uploads() {
                let upload = part?
                if upload.fileName().isEmpty() {
                    continue
                }
                let relative = if folder.isEmpty() {
                    upload.fileName()
                } else {
                    "{folder.removeSuffix("/")}/{upload.fileName()}"
                }
                let size = upload.saveTo(inside(directory, relative)?)?
                saved.push(Saved { path: relative, size })
            }
            Reply.bytes(savedJson(saved), contentType: "application/json", status: 201)
        },
    )
}

/// A file an upload wrote: its path under the directory and its size.
pub type Saved = {
    path: String
    size: Int
}

fn savedJson(saved: Array[Saved]): Array[Byte] {
    let items = saved.map((file) { "{{\"path\":{__json.encode(file.path)},\"size\":{file.size}}}" })
    "[{items.join(",")}]".bytes()
}

/// Answers WebSockets at a path: the handler talks to each until it
/// returns, with the request that opened it, and inside the contexts the
/// middleware set, as a route's handler is.
pub fn App.websocket(mut self, path: String, handler: fn(Request, WebSocket): !HttpError) {
    self.route(
        "GET",
        path,
        (request) {
            // Started here, inside the middleware, it keeps their contexts,
            // and talks once the connection is upgraded.
            let handoff = __sync.Mutex(Handoff { socket: none, given: false })
            spawn detached talk(request, handoff, handler)
            Reply { code: 101, headerList: [], payload: Payload.Socket(handoff) }
        },
    )
}

/// The socket of an upgrade, once the reply went out.
type Handoff = {
    socket: WebSocket?
    given: Bool
}

fn talk(
    request: Request,
    handoff: __sync.Mutex[Handoff],
    handler: fn(Request, WebSocket): !HttpError,
) {
    // A middleware that answered instead never upgrades: the wait ends.
    let upgraded =
        within __time.seconds(30) {
            handoff.updateWhen((pending) { pending.given }, (pending) { pending.socket })
        }
    match upgraded {
        ok(some(socket)) => {
            _ = handler(request, socket)
            _ = socket.close()
        }
        _ => {}
    }
}

/// Compresses the replies a client takes compressed, with zstd or gzip as
/// its `Accept-Encoding` prefers: text, JSON, JavaScript, XML and SVG of
/// `minimum` bytes or more, and streams of those. A reply already encoded,
/// a file, events and WebSockets go as they are. Add it before the
/// middleware whose replies it compresses.
pub fn App.compress(mut self, minimum: Int = 1024) {
    self.use(
        (request, next) {
            compressed(next(request)?, request.header("accept-encoding").unwrapOr(""), minimum)
        },
    )
}

/// The encoding a client takes best of those this server writes: `zstd`,
/// `gzip`, or none.
fn encodingFor(accepted: String): String? {
    var best: String? = none
    var bestWeight = 0.0
    for offer in accepted.split(",") {
        let parts = offer.split(";")
        let name = parts[0].trim().toLowerAscii()
        let weight = parts
            .slice(1, parts.length())
            .unwrapOr([])
            .map((p) { p.trim() })
            .find((p) { p.startsWith("q=") })
            .andThen((p) { Float.parse(p.removePrefix("q=")).ok() })
            .unwrapOr(1.0)
        // zstd before gzip when the client weighs them the same.
        let known = name == "zstd" or name == "gzip"
        if known and
            weight > 0.0 and
            (weight > bestWeight or (weight == bestWeight and name == "zstd")) {
            best = some(name)
            bestWeight = weight
        }
    }
    best
}

fn compressible(contentType: String): Bool {
    let kind = contentType.toLowerAscii()
    kind.startsWith("text/") or
        kind.contains("json") or
        kind.contains("javascript") or
        kind.contains("xml") or
        kind.contains("svg")
}

fn compressed(reply: Reply, accepted: String, minimum: Int): Reply {
    let headers = reply.headers()
    let encoding = match encodingFor(accepted) {
        some(found) => found
        none => return reply
    }
    if headers.contains("content-encoding") or
        not compressible(headers.get("content-type").unwrapOr("")) or
        reply.code < 200 or
        reply.code == 204 or
        reply.code == 304 {
        return reply
    }
    let payload = match reply.payload {
        Payload.Data(bytes) if bytes.length() >= minimum => Payload.Data(
            if encoding == "zstd" { __zstd.compress(bytes) } else { __gzip.compress(bytes) },
        )
        Payload.Stream(input) => {
            let (writer, reader) = __io.pipe()
            spawn detached pump(
                input,
                if encoding == "zstd" { __zstd.writer(writer) } else { __gzip.writer(writer) },
            )
            Payload.Stream(reader)
        }
        _ => return reply
    }
    let vary = match headers.get("vary") {
        some(before) => "{before}, accept-encoding"
        none => "accept-encoding"
    }
    var kept: Array[String] = []
    var index = 0
    for index + 1 < reply.headerList.length() {
        let name = reply.headerList[index].toLower()
        if name != "content-length" and name != "vary" {
            kept.push(reply.headerList[index])
            kept.push(reply.headerList[index + 1])
        }
        index += 2
    }
    kept.extend(["content-encoding", encoding, "vary", vary])
    Reply { code: reply.code, headerList: kept, payload }
}

/// Copies a stream into a compressing one, and ends it.
fn pump(input: __io.Reader, output: __io.Writer) {
    _ = __io.copy(input, output)
    _ = output.close()
}

/// Serves the OpenAPI document of the routes the compiler described, at
/// `path`.
pub fn App.openApi(
    mut self,
    path: String = "/openapi.json",
    title: String = "API",
    version: String = "1.0",
) {
    self.docs = some((path, title, version))
}

/// Serves until the task is cancelled or the server stops; `port` 0 takes
/// any free port. With `socket`, it serves on that Unix socket instead,
/// which it makes and removes when it stops. `limits` bounds what each
/// client sends, `Limits.standard()` without it. A client that goes away
/// before its reply cancels the task that answers it: the handler stops at
/// its next wait and runs its `defer`s.
pub fn App.listen(
    self,
    port: Int = 8080,
    host: String = "0.0.0.0",
    tls: Tls? = none,
    socket: String? = none,
    limits: Limits? = none,
): !HttpError {
    let listening = bound(host, port, tls, socket, limits)?
    serve(listening, self.pipeline())
}

/// Starts serving in a task of its own, for a program that goes on, such
/// as a test; `Server.stop()` ends it.
pub fn App.start(
    self,
    port: Int = 0,
    host: String = "127.0.0.1",
    tls: Tls? = none,
    socket: String? = none,
    limits: Limits? = none,
): Server ! HttpError {
    let listening = bound(host, port, tls, socket, limits)?
    let (finished, ended) = channel[Unit](1)
    spawn detached serveThenSignal(listening, self.pipeline(), finished)
    Server { native: listening, secure: tls.isSome(), ended }
}

/// A client whose requests this app answers in this process: the app
/// serves on a Unix socket of its own, with no port, and the client sends
/// there. A test makes its requests with it as it would to a server:
/// `app.client().get("/users/1")?.json[User]()?`.
pub fn App.client(self): Client {
    let directory = match __fs.createTemporaryDirectory() {
        ok(made) => made
        err(error) => panic("`App.client` needs a temporary directory for its socket: {error}")
    }
    let socket = "{directory}/app.socket"
    let standard = Limits.standard()
    let listening = httpNative.listenUnix(
        socket,
        standard.body,
        standard.head,
        standard.headTimeout.milliseconds(),
    )
    match failed(listening) {
        ok(_) => {}
        err(error) => panic("`App.client` could not serve the app: {error}")
    }
    spawn detached serve(listening, self.pipeline())
    Client.new(baseUrl: "http://app", socket: socket)
}

/// What a server allows each client, so that a large or slow one cannot
/// exhaust it: the bytes of a request's body, more of which is `413`; the
/// bytes of its head, its line and headers, more of which is `431`; and the
/// time to send a head, or a TLS handshake, which also ends a connection
/// kept open without a request. `Limits.standard() with { body: 100_000_000 }`
/// changes one; `Request.limitBody` changes the body's for a route.
pub type Limits = {
    body: Int
    head: Int
    headTimeout: __time.Duration
}

/// 10 MiB of body, 64 KiB of head, and 30 seconds to send a head.
pub fn Limits.standard(): Limits {
    Limits { body: 10 * 1024 * 1024, head: 64 * 1024, headTimeout: __time.seconds(30) }
}

/// A server that `App.start` started.
pub type Server = {
    priv native: httpNative.Native
    priv secure: Bool
    priv ended: Receiver[Unit]
}

/// The address it listens on, with its port: `127.0.0.1:43017`.
pub fn Server.address(self): String {
    httpNative.serverAddress(self.native)
}

/// Its URL for a client on the same machine: `http://127.0.0.1:43017`; for
/// one on a Unix socket, `http://localhost`, with the socket given to the
/// client.
pub fn Server.url(self): String {
    if self.address().startsWith("/") {
        return "http://localhost"
    }
    let address = self.address().replace("0.0.0.0", "127.0.0.1")
    if self.secure { "https://{address}" } else { "http://{address}" }
}

/// Stops taking connections and waits until the server stopped; requests
/// in flight finish.
pub fn Server.stop(self) {
    httpNative.serverStop(self.native)
    _ = self.ended.receive()
}

/// The media type a file's name says, as `text/css` for `site.css`, which
/// `App.files` sends; `application/octet-stream` when it says none.
pub fn mediaType(path: String): String {
    httpNative.mediaType(path)
}

/// A handler that sends each request on to `target`, as a reverse proxy
/// does, and its response back: the method, the path and query, the headers
/// and the body, each body streamed as it arrives. The path loses `strip`
/// first; `X-Forwarded-For`, `X-Forwarded-Host` and `X-Forwarded-Proto` tell
/// the target who asked; and a target that does not answer is `502`.
/// `client` sends the requests, with its hooks, so what a proxy sends is
/// observed as any other request: `app.route("*", "/api/*", http.proxy(
/// "http://backend:8080", strip: "/api"))`.
pub fn proxy(target: String, strip: String = "", client: Client? = none): fn(Request): Reply !
    Problem {
    let sender = client.unwrapOr(Client.new(redirects: 0))
    let base = target.removeSuffix("/")
    (request): Reply ! Problem {
        var path = request.path().removePrefix(strip)
        if not path.startsWith("/") {
            path = "/{path}"
        }
        let query = if request.rawQuery().isEmpty() { "" } else { "?{request.rawQuery()}" }
        var headers: Map[String, String] = [:]
        for (name, value) in request.headers() {
            if not (name in HopByHop) and name != "content-type" and name != "content-length" {
                headers[name] = value
            }
        }
        let peer = peerIp(request.remoteAddress())
        if not peer.isEmpty() {
            headers["x-forwarded-for"] = match request.header("x-forwarded-for") {
                some(before) => "{before}, {peer}"
                none => peer
            }
        }
        headers["x-forwarded-host"] = request.host()
        headers["x-forwarded-proto"] = request.scheme()
        let length = request.header("content-length").andThen((text) { Int.parse(text).ok() })
        let contentType = request.header("content-type").unwrapOr("application/octet-stream")
        let body: Body? = if request.method() == "GET" or request.method() == "HEAD" {
            none
        } else {
            some(Body.stream(request.body(), length: length, contentType: contentType))
        }
        let answered = sender.request(
            request.method(),
            "{base}{path}{query}",
            body: body,
            headers: headers,
        )
        let response = match answered {
            ok(response) => response
            err(HttpError.Status(response)) => response
            err(error) => fail Problem.new(502, "the proxy's target {base} did not answer: {error}")
        }
        var reply = Reply.stream(
            response.body(),
            contentType: response.header("content-type").unwrapOr("application/octet-stream"),
            status: response.status(),
        )
        for (name, value) in response.headers() {
            if name in HopByHop or name == "content-type" or name == "content-length" {
                continue
            }
            if name == "set-cookie" {
                for cookie in response.headerValues(name) {
                    reply = reply.header(name, cookie)
                }
            } else {
                reply = reply.header(name, value)
            }
        }
        reply
    }
}

/// The headers of one connection, which a proxy does not pass on.
const HopByHop: Array[String] = [
    "connection",
    "keep-alive",
    "proxy-authenticate",
    "proxy-authorization",
    "te",
    "trailer",
    "transfer-encoding",
    "upgrade",
    "host",
]

/// The IP address of `address:port` or `[address]:port`.
fn peerIp(address: String): String {
    if address.startsWith("[") {
        return address.removePrefix("[").splitOnce("]").map((parts) { parts.0 }).unwrapOr("")
    }
    match address.findLast(":") {
        some(at) => address.slice(0, at).unwrapOr("")
        none => address
    }
}

/// What a server shows and asks of TLS: `net.Tls`.
pub alias Tls = __net.Tls

/// A version of TLS: `net.TlsVersion`.
pub alias TlsVersion = __net.TlsVersion

/// What the runtime takes of a `Tls`: certificate, key, the clients'
/// authorities and the lowest version; empty without one.
fn tlsParts(tls: Tls?): (String, String, String, Int) {
    match tls {
        some(given) => {
            let minimum = match given.minimumVersion {
                __net.TlsVersion.Tls12 => 12
                __net.TlsVersion.Tls13 => 13
            }
            (given.certificate, given.privateKey, given.clients.unwrapOr(""), minimum)
        }
        none => ("", "", "", 12)
    }
}

fn bound(host: String, port: Int, tls: Tls?, socket: String?, limits: Limits?): httpNative.Native !
    HttpError {
    let (certificate, key, clients, minimum) = tlsParts(tls)
    let allowed = limits.unwrapOr(Limits.standard())
    let waited = allowed.headTimeout.milliseconds()
    let listening = match socket {
        some(path) => httpNative.listenUnix(path, allowed.body, allowed.head, waited)
        none => httpNative.listen(
            host,
            port,
            certificate,
            key,
            clients,
            minimum,
            allowed.body,
            allowed.head,
            waited,
        )
    }
    failed(listening)?
    listening
}

fn serveThenSignal(
    server: httpNative.Native,
    handler: fn(Request): Reply ! Problem,
    finished: Sender[Unit],
) {
    serve(server, handler)
    finished.send(())
}

fn serve(server: httpNative.Native, handler: fn(Request): Reply ! Problem) {
    for {
        let incoming = httpNative.next(server)
        if not httpNative.requestOpen(incoming) {
            return
        }
        spawn detached answer(incoming, handler)
    }
}

fn answer(incoming: httpNative.Native, handler: fn(Request): Reply ! Problem) {
    // A client that goes away before the reply cancels this task: the
    // handler stops at its next wait and runs its `defer`s.
    httpNative.requestAnswering(incoming)
    let fields = httpNative.requestHead(incoming).split("\t")
    let request = Request {
        native: incoming
        verb: fields[0]
        target: fields[1]
        queryText: fields[2]
        protocol: fields[3]
        peer: fields[4]
        authority: fields[5]
        secure: fields[6] == "1"
        headerList: httpNative.requestHeaders(incoming)
        params: [:]
        chosen: none
        allowed: []
        trusted: []
    }
    // A handler that panics answers `500`, and the server goes on
    // (14.24.1); the report says which request it was.
    let reply = match recover { handler(request) } {
        ok(ok(reply)) => reply
        ok(err(problem)) => problemReply(problem)
        err(stopped) => {
            __panics.report(stopped, ["method": request.verb, "path": request.target])
            let body = "{{\"status\":500,\"detail\":\"internal server error\"}}"
            Reply {
                code: 500
                headerList: ["content-type", "application/problem+json"]
                payload: Payload.Data(body.bytes())
            }
        }
    }
    send(incoming, reply)
}

fn send(incoming: httpNative.Native, reply: Reply) {
    match reply.payload {
        Payload.Data(bytes) => httpNative.respond(incoming, reply.code, reply.headerList, bytes)
        Payload.Stream(input) => httpNative.respondStream(
            incoming,
            reply.code,
            reply.headerList,
            input,
        )
        Payload.File(path, download) => {
            let problem = httpNative.respondFile(incoming, reply.headerList, path, download)
            if not problem.isEmpty() {
                send(incoming, problemReply(Problem.notFound()))
            }
        }
        Payload.Embedded(name, contents, tag) => httpNative.respondBytes(
            incoming,
            reply.headerList,
            name,
            contents,
            tag,
        )
        Payload.Events(events) => {
            let pipe = httpNative.pipe()
            let output = httpNative.pipeWriter(pipe)
            var headers = reply.headerList
            headers.extend(["content-type", "text/event-stream"])
            httpNative.respondStream(incoming, 200, headers, httpNative.pipeReader(pipe))
            for event in events {
                var lines: Array[String] = []
                if event.event != "message" {
                    lines.push("event: {event.event}")
                }
                match event.id {
                    some(id) => lines.push("id: {id}")
                    none => {}
                }
                for line in event.data.split("\n") {
                    lines.push("data: {line}")
                }
                if output.write("{lines.join("\n")}\n\n").isErr() {
                    break
                }
            }
            _ = output.close()
        }
        Payload.Socket(handoff) => {
            let socket = WebSocket { native: httpNative.acceptWebSocket(incoming), closed: false }
            let accepted = httpNative.failure(socket.native).isEmpty()
            handoff.update(
                (pending) {
                    pending.socket = if accepted { some(socket) } else { none }
                    pending.given = true
                },
            )
        }
    }
}

/// The handler a server runs: the routes, inside the middleware.
fn App.pipeline(self): fn(Request): Reply ! Problem {
    var app = self
    match self.docs {
        some((path, title, version)) => {
            let document = openApiDocument(title, version, self.operations, self.schemas)
            app.routes.push(
                Route {
                    method: "GET"
                    pattern: segments(path)
                    handler: (request) {
                        Reply.bytes(document.bytes(), contentType: "application/json")
                    }
                },
            )
        }
        none => {}
    }
    let routes = app.routes
    var handler: fn(Request): Reply ! Problem = (request) { dispatch(request)? }
    for layer in self.layers.reversed() {
        handler = wrapped(layer, handler)
    }
    // The route is chosen first, so that the middleware sees it.
    let (layered, proxies) = (handler, self.proxies)
    (request) {
        var routed = choose(routes, request)
        routed.trusted = proxies
        layered(routed)?
    }
}

/// Trusts the proxies of these networks, such as the app's load balancer,
/// for the client's address they write: see `Request.clientIp`.
pub fn App.trustProxies(mut self, networks: ...__net.Network) {
    self.proxies.extend(networks)
}

fn wrapped(
    layer: fn(Request, fn(Request): Reply ! Problem): Reply ! Problem,
    next: fn(Request): Reply ! Problem,
): fn(Request): Reply ! Problem {
    (request) { layer(request, next)? }
}

/// The request with the route that answers it: of its method, or `GET` for
/// `HEAD`, the one with the most fixed segments, and its parameters; or
/// without one, the methods of the routes its path has.
fn choose(routes: Array[Route], request: Request): Request {
    let path = segments(request.target)
    var best: Route? = none
    var bestScore = -1
    var bestParams: Map[String, String] = [:]
    var allowed: Array[String] = []
    for route in routes {
        match matching(route.pattern, path) {
            some((params, matched)) => {
                let exact =
                    route.method == request.verb or
                        (route.method == "GET" and request.verb == "HEAD")
                if exact or route.method == "*" {
                    // A route of the request's own method goes before one of any.
                    let score = matched * 2 + (if exact { 1 } else { 0 })
                    if score > bestScore {
                        best = some(route)
                        bestScore = score
                        bestParams = params
                    }
                } else if not (route.method in allowed) {
                    allowed.push(route.method)
                }
            }
            none => {}
        }
    }
    var routed = request
    routed.chosen = best
    routed.params = bestParams
    routed.allowed = allowed
    routed
}

/// The answer of the route a request goes to; `405` when only other methods
/// match its path, `404` when none does.
fn dispatch(request: Request): Reply ! Problem {
    let allowed = request.allowed
    match request.chosen {
        some(route) => route.handler(request)?
        none if allowed.length() > 0 => {
            Reply
                .text("the method {request.verb} is not allowed here", status: 405)
                .header("allow", allowed.join(", "))
        }
        none => fail Problem.notFound("there is no route for {request.verb} {request.target}")
    }
}

/// The parameters a pattern takes from a path and how fixed the match is:
/// two for a fixed segment, one for a parameter.
fn matching(pattern: Array[String], path: Array[String]): (Map[String, String], Int)? {
    var params: Map[String, String] = [:]
    var score = 0
    for (index, part) in pattern.enumerate() {
        if part.startsWith("*") {
            let name = part.slice(1, part.length()).unwrapOr("")
            params[name] = path
                .drop(index)
                .map((segment) { __encoding.urlDecode(segment).unwrapOr(segment) })
                .join("/")
            return some((params, score))
        }
        if index >= path.length() {
            return none
        }
        if part.startsWith(":") {
            params[part.slice(1, part.length()).unwrapOr("")] = __encoding
                .urlDecode(path[index])
                .unwrapOr(path[index])
            score += 1
        } else if part == path[index] {
            score += 2
        } else {
            return none
        }
    }
    if pattern.length() != path.length() {
        return none
    }
    some((params, score))
}

fn segments(path: String): Array[String] {
    path.split("/").filter((segment) { not segment.isEmpty() })
}

/// A path inside a directory, or `403` for one that would leave it.
fn inside(directory: String, relative: String): String ! Problem {
    for segment in relative.split("/") {
        if segment == ".." or segment.contains("\\") or segment.contains("\u{0}") {
            fail Problem.forbidden("the path `{relative}` leaves the directory")
        }
    }
    "{directory.removeSuffix("/")}/{relative.removePrefix("/")}"
}

/// The first byte of `Content-Range: bytes start-end/total`.
fn rangeStart(range: String): Int ! Problem {
    let spec = range.removePrefix("bytes ")
    let dash = spec.find("-").unwrapOr(0)
    match Int.parse(spec.slice(0, dash).unwrapOr("")) {
        ok(start) => start
        err(_) => fail Problem.badRequest("`Content-Range: {range}` is not `bytes start-end/total`")
    }
}

/// The OpenAPI 3.1 document of the described operations.
fn openApiDocument(
    title: String,
    version: String,
    operations: Array[(String, String, String)],
    schemas: Map[String, String],
): String {
    var paths: Map[String, Array[String]] = [:]
    for (method, route, operation) in operations {
        let parts = segments(route).map(
            (part) {
                if part.startsWith(":") or part.startsWith("*") {
                    "{{{part.slice(1, part.length()).unwrapOr("")}}}"
                } else {
                    part
                }
            },
        )
        let path = "/{parts.join("/")}"
        var entries = paths.getOr(path, [])
        entries.push("{__json.encode(method)}:{operation}")
        paths[path] = entries
    }
    var items: Array[String] = []
    for (path, entries) in paths {
        items.push("{__json.encode(path)}:{{{entries.join(",")}}}")
    }
    let info = "{{\"title\":{__json.encode(title)},\"version\":{__json.encode(version)}}}"
    var components: Array[String] = []
    for (name, schema) in schemas {
        components.push("{__json.encode(name)}:{schema}")
    }
    let documented =
        "\"paths\":{{{items.join(",")}}},\"components\":{{\"schemas\":{{{components.join(",")}}}}}"
    "{{\"openapi\":\"3.1.0\",\"info\":{info},{documented}}}"
}
