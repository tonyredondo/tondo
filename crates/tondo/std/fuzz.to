// The loop of `testing.fuzz` (testing 10.6), which the compiler calls for
// it: the body runs with each input the runtime gives, read as JSON into
// its type; first the seeds, written as JSON, and the inputs of the fuzz
// store, then, under `tondo test --fuzz`, those it makes.

import std.internal.fuzz as fuzzNative
import std.json
import std.serialization

fn run[T: serialization.Encode + serialization.Decode, E, F: CallMut[fn(T): !E]](
    name: String,
    shape: String,
    seeds: Array[T],
    body: F,
): !E {
    fuzzNative.begin(name, shape)
    for seed in seeds {
        fuzzNative.seed(json.encode(seed))
    }
    var each = body
    for fuzzNative.next() {
        match json.decode[T](fuzzNative.input()) {
            ok(value) => {
                // What the input is, as `json.encode` writes it, when
                // `tondo test` reduces one that failed.
                if fuzzNative.replaying() {
                    fuzzNative.encoded(json.encode(value))
                }
                match each(value) {
                    ok(_) => {}
                    err(error) => {
                        fuzzNative.failed()
                        fail error
                    }
                }
            }
            err(error) => fuzzNative.invalid("{error}")
        }
    }
    fuzzNative.end()
}
