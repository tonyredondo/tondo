pub extern type __last_branch_record = {
    __from_ip: ffi.CULongLong
    __to_ip: ffi.CULongLong
    @count(4)
    bits0: UInt8
}

pub fn __last_branch_record.__mispredict(self): ffi.CUInt {
    let word = UInt32(self.bits0[0])
    word & 1
}

pub fn __last_branch_record.set___mispredict(mut self, value: ffi.CUInt) {
    assert(value <= 1, "`__mispredict` holds 1 bits")
    let word = (UInt64(self.bits0[0]) & 254) | UInt64(value)
    self.bits0[0] = bitFieldByte(word)
}

pub fn __last_branch_record.__tsx_abort(self): ffi.CUInt {
    let word = UInt32(self.bits0[0])
    (word >> 1) & 1
}

pub fn __last_branch_record.set___tsx_abort(mut self, value: ffi.CUInt) {
    assert(value <= 1, "`__tsx_abort` holds 1 bits")
    let word = (UInt64(self.bits0[0]) & 253) | (UInt64(value) << 1)
    self.bits0[0] = bitFieldByte(word)
}

pub fn __last_branch_record.__in_tsx(self): ffi.CUInt {
    let word = UInt32(self.bits0[0])
    (word >> 2) & 1
}

pub fn __last_branch_record.set___in_tsx(mut self, value: ffi.CUInt) {
    assert(value <= 1, "`__in_tsx` holds 1 bits")
    let word = (UInt64(self.bits0[0]) & 251) | (UInt64(value) << 2)
    self.bits0[0] = bitFieldByte(word)
}

pub fn __last_branch_record.__cycle_count(self): ffi.CUInt {
    let word = UInt32(self.bits0[0]) | (UInt32(self.bits0[1]) << 8) | (UInt32(self.bits0[2]) << 16)
    (word >> 3) & 65535
}

pub fn __last_branch_record.set___cycle_count(mut self, value: ffi.CUInt) {
    assert(value <= 65535, "`__cycle_count` holds 16 bits")
    let word =
        ((UInt64(self.bits0[0]) | (UInt64(self.bits0[1]) << 8) | (UInt64(self.bits0[2]) << 16)) &
            16252935) |
            (UInt64(value) << 3)
    self.bits0[0] = bitFieldByte(word)
    self.bits0[1] = bitFieldByte(word >> 8)
    self.bits0[2] = bitFieldByte(word >> 16)
}

pub fn __last_branch_record.__reserved(self): ffi.CUInt {
    let word = UInt32(self.bits0[2]) | (UInt32(self.bits0[3]) << 8)
    (word >> 3) & 8191
}

pub fn __last_branch_record.set___reserved(mut self, value: ffi.CUInt) {
    assert(value <= 8191, "`__reserved` holds 13 bits")
    let word = ((UInt64(self.bits0[2]) | (UInt64(self.bits0[3]) << 8)) & 7) | (UInt64(value) << 3)
    self.bits0[2] = bitFieldByte(word)
    self.bits0[3] = bitFieldByte(word >> 8)
}

pub extern type __last_branch_state = {
    __lbr_count: ffi.CInt
    @count(4)
    bits0: UInt8
    @count(32)
    __lbrs: __last_branch_record
}

pub fn __last_branch_state.__lbr_supported_tsx(self): ffi.CUInt {
    let word = UInt32(self.bits0[0])
    word & 1
}

pub fn __last_branch_state.set___lbr_supported_tsx(mut self, value: ffi.CUInt) {
    assert(value <= 1, "`__lbr_supported_tsx` holds 1 bits")
    let word = (UInt64(self.bits0[0]) & 254) | UInt64(value)
    self.bits0[0] = bitFieldByte(word)
}

pub fn __last_branch_state.__lbr_supported_cycle_count(self): ffi.CUInt {
    let word = UInt32(self.bits0[0])
    (word >> 1) & 1
}

pub fn __last_branch_state.set___lbr_supported_cycle_count(mut self, value: ffi.CUInt) {
    assert(value <= 1, "`__lbr_supported_cycle_count` holds 1 bits")
    let word = (UInt64(self.bits0[0]) & 253) | (UInt64(value) << 1)
    self.bits0[0] = bitFieldByte(word)
}

pub fn __last_branch_state.__reserved(self): ffi.CUInt {
    let word =
        UInt32(self.bits0[0]) |
            (UInt32(self.bits0[1]) << 8) |
            (UInt32(self.bits0[2]) << 16) |
            (UInt32(self.bits0[3]) << 24)
    (word >> 2) & 1073741823
}

pub fn __last_branch_state.set___reserved(mut self, value: ffi.CUInt) {
    assert(value <= 1073741823, "`__reserved` holds 30 bits")
    let word =
        ((UInt64(self.bits0[0]) |
            (UInt64(self.bits0[1]) << 8) |
            (UInt64(self.bits0[2]) << 16) |
            (UInt64(self.bits0[3]) << 24)) &
            3) |
            (UInt64(value) << 2)
    self.bits0[0] = bitFieldByte(word)
    self.bits0[1] = bitFieldByte(word >> 8)
    self.bits0[2] = bitFieldByte(word >> 16)
    self.bits0[3] = bitFieldByte(word >> 24)
}

