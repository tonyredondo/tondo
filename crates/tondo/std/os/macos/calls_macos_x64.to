// The low byte of a word, as C keeps a byte of bit fields.
fn bitFieldByte(word: UInt64): UInt8 {
    match UInt8(word & 255) {
        ok(byte) => byte
        err(_) => 0
    }
}

// Not bound:
// - uuid_t: it uses an array as a value; C passes a pointer to it
// - gethostuuid: it uses an array as a value; C passes a pointer to it
// - getsgroups_np: it uses an array as a value; C passes a pointer to it
// - getwgroups_np: it uses an array as a value; C passes a pointer to it
// - setsgroups_np: it uses an array as a value; C passes a pointer to it
// - setwgroups_np: it uses an array as a value; C passes a pointer to it
// - SIG_DFL: `(void(*)(int))0` is not a number or text a constant can hold
// - SIG_IGN: `(void(*)(int))1` is not a number or text a constant can hold
// - SIG_HOLD: `(void(*)(int))5` is not a number or text a constant can hold
// - SIG_ERR: `((void(*)(int))-1)` is not a number or text a constant can hold
// - TIOCMODG: `_IOR('t',3,int)` is not a number or text a constant can hold
// - TIOCMODS: `_IOW('t',4,int)` is not a number or text a constant can hold
// - TIOCEXCL: `_IO('t',13)` is not a number or text a constant can hold
// - TIOCNXCL: `_IO('t',14)` is not a number or text a constant can hold
// - TIOCFLUSH: `_IOW('t',16,int)` is not a number or text a constant can hold
// - TIOCGETA: `_IOR('t',19,struct termios)` is not a number or text a constant can hold
// - TIOCSETA: `_IOW('t',20,struct termios)` is not a number or text a constant can hold
// - TIOCSETAW: `_IOW('t',21,struct termios)` is not a number or text a constant can hold
// - TIOCSETAF: `_IOW('t',22,struct termios)` is not a number or text a constant can hold
// - TIOCGETD: `_IOR('t',26,int)` is not a number or text a constant can hold
// - TIOCSETD: `_IOW('t',27,int)` is not a number or text a constant can hold
// - TIOCIXON: `_IO('t',129)` is not a number or text a constant can hold
// - TIOCIXOFF: `_IO('t',128)` is not a number or text a constant can hold
// - TIOCSBRK: `_IO('t',123)` is not a number or text a constant can hold
// - TIOCCBRK: `_IO('t',122)` is not a number or text a constant can hold
// - TIOCSDTR: `_IO('t',121)` is not a number or text a constant can hold
// - TIOCCDTR: `_IO('t',120)` is not a number or text a constant can hold
// - TIOCGPGRP: `_IOR('t',119,int)` is not a number or text a constant can hold
// - TIOCSPGRP: `_IOW('t',118,int)` is not a number or text a constant can hold
// - TIOCOUTQ: `_IOR('t',115,int)` is not a number or text a constant can hold
// - TIOCSTI: `_IOW('t',114,char)` is not a number or text a constant can hold
// - TIOCNOTTY: `_IO('t',113)` is not a number or text a constant can hold
// - TIOCPKT: `_IOW('t',112,int)` is not a number or text a constant can hold
// - TIOCSTOP: `_IO('t',111)` is not a number or text a constant can hold
// - TIOCSTART: `_IO('t',110)` is not a number or text a constant can hold
// - TIOCMSET: `_IOW('t',109,int)` is not a number or text a constant can hold
// - TIOCMBIS: `_IOW('t',108,int)` is not a number or text a constant can hold
// - TIOCMBIC: `_IOW('t',107,int)` is not a number or text a constant can hold
// - TIOCMGET: `_IOR('t',106,int)` is not a number or text a constant can hold
// - TIOCGWINSZ: `_IOR('t',104,struct winsize)` is not a number or text a constant can hold
// - TIOCSWINSZ: `_IOW('t',103,struct winsize)` is not a number or text a constant can hold
// - TIOCUCNTL: `_IOW('t',102,int)` is not a number or text a constant can hold
// - TIOCSTAT: `_IO('t',101)` is not a number or text a constant can hold
// - UIOCCMD: a macro that calls `_IO`, which is not bound
// - TIOCSCONS: `_IO('t',99)` is not a number or text a constant can hold
// - TIOCCONS: `_IOW('t',98,int)` is not a number or text a constant can hold
// - TIOCSCTTY: `_IO('t',97)` is not a number or text a constant can hold
// - TIOCEXT: `_IOW('t',96,int)` is not a number or text a constant can hold
// - TIOCSIG: `_IO('t',95)` is not a number or text a constant can hold
// - TIOCDRAIN: `_IO('t',94)` is not a number or text a constant can hold
