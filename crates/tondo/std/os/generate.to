// Writes the declarations of `std.os.linux` and `std.os.macos` for one
// target with `tondo bind`, from the headers of the standard library's
// 14.45; and with `shared`, those of `std.os.unix`, which every target has
// alike, from the four:
//
//   tondo run crates/tondo/std/os/generate.to -- linux_x64
//   tondo run crates/tondo/std/os/generate.to -- shared
//
// It runs from the repository's root, on the target's system, whose headers
// the C preprocessor reads: for another architecture of Linux,
// `TONDO_CC` names a preprocessor of it, as `container-cpp.sh` beside it
// does with a container's. `TONDO` names the `tondo` that binds, `tondo` on
// PATH by default.

import std.console
import std.env
import std.fs
import std.json
import std.process
import std.regex

/// The headers both systems have.
fn common(): Array[String] {
    [
        "errno.h",
        "fcntl.h",
        "poll.h",
        "signal.h",
        "termios.h",
        "unistd.h",
        "sys/file.h",
        "sys/ioctl.h",
        "sys/mman.h",
        "sys/resource.h",
        "sys/socket.h",
        "sys/stat.h",
    ]
}

/// The targets, as a file's name writes them.
fn targets(): Array[String] {
    ["linux_x64", "linux_arm64", "macos_x64", "macos_arm64"]
}

/// The first line of a module this program writes: still one `tondo bind`
/// wrote, which keeps C's names.
fn generated(argument: String): String {
    "// Generated by `tondo bind`, as `tondo run crates/tondo/std/os/generate.to -- {argument}` runs it; run that again to update this module."
}

/// The file of a system's module for a target.
fn calls(target: String): String {
    let system = target.splitOnce("_").map((parts) { parts.0 }) ?? target
    "crates/tondo/std/os/{system}/calls_{target}.to"
}

/// Where the system's headers are: on macOS, in the SDK that `xcrun` names.
fn includes(target: String): String ! String {
    if not target.startsWith("macos") {
        return "/usr/include"
    }
    let sdk =
        process
            .command("xcrun", "--show-sdk-path")
            .output()
            .mapErr((e) { "cannot run xcrun: {e}" })?
    let path = sdk.text().mapErr((e) { "what xcrun gave is not text: {e}" })?
    "{path.trim()}/usr/include"
}

/// The declarations of a target, bound from the system's headers.
fn bound(target: String, headers: Array[String]): !String {
    let tondo = env.get("TONDO") ?? "tondo"
    let written = "/tmp/tondo-os-{target}.to"
    let root = includes(target)?
    let paths = headers.map((header) { "{root}/{header}" })
    let options = ["--included", "--fails", "crates/tondo/std/os/fails.txt", "--output", written]
    _ =
        process
            .command(tondo, "bind", ...paths.concat(options))
            .check()
            .mapErr((e) { "tondo bind: {e}" })?
    var text = fs.readText(written).mapErr((e) { "cannot read {written}: {e}" })?
    // Its first line says how to write it again, as this program does, and
    // still that `tondo bind` wrote it, which keeps C's names.
    let lines = text.lines()
    let rest = (lines.slice(1, lines.length()) ?? []).join("\n")
    text = "{generated(target)}\n{rest}\n"
    // `syscall` is the module's own, which takes the arguments as `Int`.
    if target.startsWith("linux") {
        let kept = text.lines().filter((line) { not line.startsWith("pub extern fn syscall(") })
        text = "{kept.join("\n")}\n"
    }
    let file = calls(target)
    let directory = (file.splitOnce("/calls_") ?? (file, "")).0
    _ = fs.createDirectory(directory)
    fs.writeText(file, text).mapErr((e) { "cannot write {file}: {e}" })?
    _ = process.command(tondo, "fmt", file).check().mapErr((e) { "tondo fmt: {e}" })?
    console.println("wrote {file}")
}

/// A declaration that `tondo bind` wrote: its name, what must be the same on
/// every target for them to share it, and its text.
type Declaration = {
    name: String
    shape: String
    text: String
}

/// The public declarations of a module, in their order. A constant's shape is
/// its type, as its value may differ; a function's, its signature without the
/// names of its parameters; a type's or an alias's, its kind alone, as the
/// layouts of C differ by target under one name.
fn declarations(text: String, parameter: regex.Regex): Array[Declaration] ! String {
    var found: Array[Declaration] = []
    for block in text.split("\n\n") {
        let lines = block.lines()
        let at = lines.findIndex((line) { line.startsWith("pub ") }) ?? -1
        if at < 0 {
            continue
        }
        let rest = lines[at].removePrefix("pub ").removePrefix("extern ").removePrefix("unsafe ")
        let (kind, after) = rest.splitOnce(" ") ?? (rest, "")
        let name = match kind {
            "fn" => (after.splitOnce("(") ?? (after, "")).0
            "const" => (after.splitOnce(":") ?? (after, "")).0
            _ => (after.splitOnce(" ") ?? (after, "")).0
        }
        let shape = match kind {
            "const" => ((after.splitOnce(": ") ?? ("", "")).1.splitOnce(" = ") ?? ("", "")).0
            "fn" => {
                let signature = lines.drop(at).map((line) { line.trim() }).join("")
                let head = (signature.splitOnce(" {{") ?? (signature, "")).0
                let flat = head.split(", ").join(",").split(",)").join(")")
                parameter.replaceAll(flat, r"$1").mapErr((e) { "{e}" })?
            }
            _ => kind
        }
        found.push(Declaration { name, shape, text: block.trim() })
    }
    found
}

/// What `tondo check --json` says, as much as `shared` reads of it.
type Checked = {
    diagnostics: Array[Diagnostic]
}

type Diagnostic = {
    severity: String
    message: String
    range: Range? = none
}

type Range = {
    start: Position
}

type Position = {
    line: Int
}

/// The aliases of `std.ffi`, by what they name, which a shape is compared
/// by.
fn cAliases(): Map[String, String] {
    [
        "ffi.CChar": "Byte",
        "ffi.CShort": "Int16",
        "ffi.CUShort": "UInt16",
        "ffi.CInt": "Int32",
        "ffi.CUInt": "UInt32",
        "ffi.CLong": "Int",
        "ffi.CULong": "UInt64",
        "ffi.CLongLong": "Int",
        "ffi.CULongLong": "UInt64",
        "ffi.CSize": "UInt64",
        "ffi.CSSize": "Int",
        "ffi.CFloat": "Float32",
        "ffi.CDouble": "Float",
        "ffi.CBool": "Bool",
    ]
}

/// A shape with each alias written as what it names, so that `ffi.CLong`,
/// `off_t` and `Int` are one, as one system's headers write a type by its
/// alias and the other's by what it names.
fn resolved(shape: String, aliases: Map[String, String]): String {
    var out = ""
    var word = ""
    for c in shape.chars() {
        if c.isAlphanumeric() or c == '_' or c == '.' {
            word = "{word}{c}"
        } else {
            out = "{out}{named(word, aliases)}{c}"
            word = ""
        }
    }
    "{out}{named(word, aliases)}"
}

/// What an alias names, through the aliases it names in turn.
fn named(word: String, aliases: Map[String, String]): String {
    var at = word
    for _ in 0..8 {
        match aliases.get(at) {
            some(next) => at = next
            none => break
        }
    }
    at
}

/// The declarations of `std.os.unix` for each target: those of C that all
/// four have with one shape, but the names its own calls take, and but those
/// that name what is not shared, which checking each target's file finds.
fn shared(): !String {
    let tondo = env.get("TONDO") ?? "tondo"
    let parameter = regex.Regex.compile(r"([(,])[A-Za-z_][A-Za-z0-9_]*: ").mapErr((e) { "{e}" })?
    var all: Array[Array[Declaration]] = []
    var shapes: Array[Map[String, String]] = []
    for target in targets() {
        let file = calls(target)
        let text = fs.readText(file).mapErr((e) { "cannot read {file}: {e}" })?
        let found = declarations(text, parameter)?
        var aliases = cAliases()
        for declaration in found.filter((d) { d.shape == "alias" }) {
            let definition = (declaration.text.lines().last() ?? "").splitOnce(" = ")
            aliases[declaration.name] = (definition ?? ("", "")).1.trim()
        }
        var shape: Map[String, String] = [:]
        for declaration in found {
            shape[declaration.name] = resolved(declaration.shape, aliases)
        }
        all.push(found)
        shapes.push(shape)
    }
    let own = "crates/tondo/std/os/unix/calls_unix.to"
    let ownText = fs.readText(own).mapErr((e) { "cannot read {own}: {e}" })?
    let taken =
        declarations(ownText, parameter)?.map((d) { (d.name.splitOnce(".") ?? (d.name, "")).0 })
    var kept: Set[String] = Set[]
    for declaration in all[0] {
        let first = shapes[0].get(declaration.name)
        let everywhere = shapes.all((shape) { shape.get(declaration.name) == first })
        if everywhere and not taken.contains(declaration.name) {
            kept.insert(declaration.name)
        }
    }
    // Each target's file also has what its shared declarations name of its
    // own, as the union glibc puts in `termios`; a declaration that names
    // what its target does not have is left out. Checking each file finds
    // both, until all four check.
    var extras: Array[Set[String]] = targets().map((_) { Set[String]() })
    _ = fs.createDirectory("/tmp/tondo-os-shared")
    for _ in 0..30 {
        var changed = 0
        for (index, target) in targets().enumerate() {
            let check = "/tmp/tondo-os-shared/shared_{target}.to"
            let blocks = all[index].filter(
                (d) { kept.contains(d.name) or extras[index].contains(d.name) },
            )
            var text = "import std.ffi\nimport std.os\n"
            var starts: Array[(Int, String)] = []
            for block in blocks {
                starts.push((text.lines().length() + 1, block.name))
                text = "{text}\n{block.text}\n"
            }
            fs.writeText(check, text).mapErr((e) { "cannot write {check}: {e}" })?
            let ran =
                process.command(tondo, "check", check, "--json").output().mapErr((e) { "{e}" })?
            let said = ran.text().mapErr((e) { "{e}" })?
            let checked = json.decode[Checked](said).mapErr((e) { "what `tondo check` gave: {e}" })?
            for diagnostic in checked.diagnostics.filter((d) { d.severity == "error" }) {
                let missing = (diagnostic.message.split("`").drop(1).first() ?? "")
                if all[index].any((d) { d.name == missing }) and not extras[index].contains(missing) {
                    extras[index].insert(missing)
                    changed += 1
                    continue
                }
                let line = (diagnostic.range?.start.line ?? -1) + 1
                let owner = (starts.filter((start) { start.0 <= line }).last() ?? (0, "")).1
                if kept.contains(owner) {
                    kept.remove(owner)
                    changed += 1
                } else if extras[index].contains(owner) {
                    extras[index].remove(owner)
                    changed += 1
                }
            }
        }
        if changed == 0 {
            break
        }
    }
    for (index, target) in targets().enumerate() {
        let file = "crates/tondo/std/os/unix/shared_{target}.to"
        let blocks = all[index]
            .filter((d) { kept.contains(d.name) or extras[index].contains(d.name) })
            .map((d) { d.text })
        let text =
            "{generated("shared")}\n\nimport std.ffi\nimport std.os\n\n{blocks.join("\n\n")}\n"
        fs.writeText(file, text).mapErr((e) { "cannot write {file}: {e}" })?
        _ = process.command(tondo, "fmt", file).check().mapErr((e) { "tondo fmt: {e}" })?
        console.println("wrote {file}: {blocks.length()} declarations")
    }
}

fn main(): !String {
    let arguments = env.args()
    let target = arguments.first() ?? ""
    match target {
        "linux_x64" | "linux_arm64" => {
            bound(
                target,
                common().concat(["sys/epoll.h", "sys/eventfd.h", "sys/inotify.h", "sys/syscall.h"]),
            )?
        }
        "macos_x64" | "macos_arm64" => bound(target, common().concat(["sys/event.h"]))?
        "shared" => shared()?
        _ => fail "name a target, {targets().join(", ")}, or `shared`"
    }
}
