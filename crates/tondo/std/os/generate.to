// Writes the declarations of `std.os.linux` and `std.os.macos` for one
// target with `tondo bind`, from the headers of the standard library's
// 14.45:
//
//   tondo run crates/tondo/std/os/generate.to -- linux_x64
//
// It runs from the repository's root, on the target's system, whose headers
// the C preprocessor reads: for another architecture of Linux,
// `TONDO_CC` names a preprocessor of it, as `container-cpp.sh` beside it
// does with a container's. `TONDO` names the `tondo` that binds, `tondo` on
// PATH by default.

import std.console
import std.env
import std.fs
import std.process

/// The headers both systems have.
fn common(): Array[String] {
    [
        "errno.h",
        "fcntl.h",
        "poll.h",
        "signal.h",
        "termios.h",
        "unistd.h",
        "sys/file.h",
        "sys/ioctl.h",
        "sys/mman.h",
        "sys/resource.h",
        "sys/socket.h",
        "sys/stat.h",
    ]
}

/// The targets, as a file's name writes them.
fn targets(): Array[String] {
    ["linux_x64", "linux_arm64", "macos_x64", "macos_arm64"]
}

/// The file of a system's module for a target.
fn calls(target: String): String {
    let system = target.splitOnce("_").map((parts) { parts.0 }) ?? target
    "crates/tondo/std/os/{system}/calls_{target}.to"
}

/// Where the system's headers are: on macOS, in the SDK that `xcrun` names.
fn includes(target: String): String ! String {
    if not target.startsWith("macos") {
        return "/usr/include"
    }
    let sdk =
        process
            .command("xcrun", "--show-sdk-path")
            .output()
            .mapErr((e) { "cannot run xcrun: {e}" })?
    let path = sdk.text().mapErr((e) { "what xcrun gave is not text: {e}" })?
    "{path.trim()}/usr/include"
}

/// The declarations of a target, bound from the system's headers.
fn bound(target: String, headers: Array[String]): !String {
    let tondo = env.get("TONDO") ?? "tondo"
    let written = "/tmp/tondo-os-{target}.to"
    let root = includes(target)?
    let paths = headers.map((header) { "{root}/{header}" })
    let options = ["--included", "--fails", "crates/tondo/std/os/fails.txt", "--output", written]
    _ =
        process
            .command(tondo, "bind", ...paths.concat(options))
            .check()
            .mapErr((e) { "tondo bind: {e}" })?
    var text = fs.readText(written).mapErr((e) { "cannot read {written}: {e}" })?
    // Its first line says how to write it again, as this program does, and
    // still that `tondo bind` wrote it, which keeps C's names.
    let lines = text.lines()
    let rest = (lines.slice(1, lines.length()) ?? []).join("\n")
    let first =
        "// Generated by `tondo bind`, as `tondo run crates/tondo/std/os/generate.to -- {target}` runs it; run that again to update this module."
    text = "{first}\n{rest}\n"
    // `syscall` is the module's own, which takes the arguments as `Int`.
    if target.startsWith("linux") {
        let kept = text.lines().filter((line) { not line.startsWith("pub extern fn syscall(") })
        text = "{kept.join("\n")}\n"
    }
    let file = calls(target)
    fs.writeText(file, text).mapErr((e) { "cannot write {file}: {e}" })?
    _ = process.command(tondo, "fmt", file).check().mapErr((e) { "tondo fmt: {e}" })?
    console.println("wrote {file}")
}

fn main(): !String {
    let arguments = env.args()
    let target = arguments.first() ?? ""
    match target {
        "linux_x64" | "linux_arm64" => {
            bound(
                target,
                common().concat(["sys/epoll.h", "sys/eventfd.h", "sys/inotify.h", "sys/syscall.h"]),
            )?
        }
        "macos_x64" | "macos_arm64" => bound(target, common().concat(["sys/event.h"]))?
        _ => fail "name a target: {targets().join(", ")}"
    }
}
