{
  "format": "tondo-stdlib-owner-contract/1",
  "owner": "std.time.civil",
  "parent_owner": "std.time",
  "edition": "0.1",
  "phase": "STD-0.1B",
  "task": "STD-CIVIL-TIME-001",
  "status": "contract-locked",
  "contract": "docs/contracts/stdlib-civil-time.md",
  "spec": "TONDO_STANDARD_LIBRARY_SPEC.md",
  "language_spec": "TONDO_LANGUAGE_SPEC.md",
  "layer": "B5",
  "kind": "runtime-facing",
  "target": "tondo-vm-hosted-and-native",
  "capabilities": {
