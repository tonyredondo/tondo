      {"id":"offset-format","signature":"pub fn UtcOffset.format(self): String","kind":"offset-format","effect":"pure"},
      {"id":"zone-id","signature":"pub fn ZoneId.fromText(text: String): ZoneId ! CivilError","kind":"zone-id-parse","effect":"pure"},
      {"id":"zone-id-text","signature":"pub fn ZoneId.text(self): String","kind":"zone-id-format","effect":"pure"},
