{
  "format": "tondo-stdlib-owner-contract/1",
  "owner": "std.toml",
  "parent_owner": "std",
  "edition": "0.1",
  "phase": "STD-0.1B",
  "task": "STD-TOML-001",
  "status": "contract-locked",
  "contract": "docs/contracts/stdlib-toml.md",
  "spec": "TONDO_STANDARD_LIBRARY_SPEC.md",
  "language_spec": "TONDO_LANGUAGE_SPEC.md",
  "layer": "B8",
  "kind": "runtime-facing",
  "target": "tondo-vm-hosted-and-native",
  "dependencies": ["std.serialization", "std.io", "std.bytes", "std.time"],
  "capabilities": {
    "required": [],
    "optional": [],
    "import_effect": "none",
    "ambient_lookup": false,
    "forbidden": [
      "ambient-host",
      "environment",
      "filesystem",
      "network",
      "process",
      "clock",
      "civil-clock",
      "entropy",
      "threads",
      "dynamic-linking",
      "runtime-value-reflection",
      "includes",
      "code-execution",
      "locale",
      "timezone-lookup"
    ]
  },
  "wire": {
    "toml_version": "1.1.0",
    "encoding": "UTF-8",
    "case_sensitive": true,
    "newlines": ["LF", "CRLF"],
    "whitespace": ["space", "tab"],
    "comments": "discarded",
    "documents": "single-root-no-markers",
    "keys": ["bare", "quoted", "dotted"],
    "strings": ["basic", "multiline-basic", "literal", "multiline-literal"],
    "escapes": ["b", "t", "n", "f", "r", "e", "xHH", "uHHHH", "UHHHHHHHH", "quote", "backslash"],
    "integers": ["decimal", "hexadecimal", "octal", "binary"],
    "floats": ["fraction", "exponent", "inf", "nan"],
    "booleans": ["true", "false"],
    "date_time": ["offset-date-time", "local-date-time", "local-date", "local-time"],
    "arrays": "ordered-heterogeneous-trailing-comma",
    "inline_tables": "closed-trailing-comma",
    "tables": ["table", "array-of-tables"],
    "binary": "not-a-native-wire-type"
  },
  "surface": {
    "types": [
      "Toml",
      "TomlOffsetDateTime",
      "TomlValue",
      "TomlValueView",
      "TomlScalar",
      "TomlEvent",
      "TomlLimits",
      "TomlOptions",
      "TomlPathSegment",
      "TomlSpan",
      "TomlErrorKind",
      "TomlError",
      "TomlReader",
      "TomlWriter"
    ],
    "signatures": [
      {"id":"limits-defaults","signature":"pub fn TomlLimits.defaults(): TomlLimits","kind":"limits","effect":"pure"},
      {"id":"limits-create","signature":"pub fn TomlLimits.create(maxInputBytes: Int, maxDepth: Int, maxNodes: Int, maxTables: Int, maxArrayElements: Int, maxKeyBytes: Int, maxPathSegments: Int, maxScalarBytes: Int, maxStringBytes: Int, maxArrayTableRows: Int): TomlLimits ! TomlError","kind":"limits","effect":"pure"},
      {"id":"options-defaults","signature":"pub fn TomlOptions.defaults(): TomlOptions","kind":"policy","effect":"pure"},
      {"id":"options-create","signature":"pub fn TomlOptions.create(limits: TomlLimits): TomlOptions","kind":"policy","effect":"pure"},
      {"id":"parse","signature":"pub fn parse(input: Bytes, options: TomlOptions): TomlValue ! TomlError","kind":"materialized-parse","effect":"pure"},
      {"id":"parse-view","signature":"pub fn parseView(input: Bytes, options: TomlOptions): TomlValueView ! TomlError","kind":"borrowed-parse","effect":"pure"},
      {"id":"validate","signature":"pub fn validate(input: Bytes, options: TomlOptions): Unit ! TomlError","kind":"validation","effect":"pure"},
      {"id":"decode","signature":"pub fn decode[T: Decode[Toml]](input: Bytes, options: TomlOptions): T ! TomlError","kind":"typed-decode","effect":"pure"},
      {"id":"encode-value","signature":"pub fn encode(value: TomlValue, options: TomlOptions): Bytes ! TomlError","kind":"dynamic-encode","effect":"pure"},
      {"id":"encode-typed","signature":"pub fn encode[T: Encode[Toml]](value: T, options: TomlOptions): Bytes ! TomlError","kind":"typed-encode","effect":"pure"},
      {"id":"encode-canonical","signature":"pub fn encodeCanonical(value: TomlValue, limits: TomlLimits): Bytes ! TomlError","kind":"canonical-encode","effect":"pure"},
      {"id":"reader-from-bytes","signature":"pub fn TomlReader.fromBytes(input: Bytes, options: TomlOptions): TomlReader ! TomlError","kind":"stream-reader","effect":"pure"},
      {"id":"reader-from-reader","signature":"pub fn TomlReader.fromReader(var input: std.io.Reader, options: TomlOptions): TomlReader ! TomlError suspends","kind":"stream-reader","effect":"suspends"},
      {"id":"reader-next","signature":"pub fn TomlReader.next(var self): TomlEvent? ! TomlError suspends","kind":"stream-reader","effect":"suspends"},
      {"id":"reader-own","signature":"pub fn TomlReader.own(var self, event: TomlEvent): TomlEvent ! TomlError","kind":"stream-reader","effect":"pure"},
      {"id":"reader-finish","signature":"pub fn TomlReader.finish(var self): Unit ! TomlError suspends","kind":"stream-reader","effect":"suspends"},
      {"id":"writer-to-writer","signature":"pub fn TomlWriter.toWriter(var output: std.io.Writer, options: TomlOptions): TomlWriter ! TomlError suspends","kind":"stream-writer","effect":"suspends"},
      {"id":"writer-write","signature":"pub fn TomlWriter.write(var self, event: TomlEvent): Unit ! TomlError suspends","kind":"stream-writer","effect":"suspends"},
      {"id":"writer-finish","signature":"pub fn TomlWriter.finish(var self): Unit ! TomlError suspends","kind":"stream-writer","effect":"suspends"}
    ],
    "direct_call_waits": false,
    "explicit_await_direct_call": "forbidden",
    "explicit_await_join": "unchanged-by-language",
    "inference_by_name": false,
    "bodyless_requires_effect": true,
    "bodyful_inference": "allowed",
    "selectable_operations": [],
    "no_async_duplicate_api": true
  },
  "dynamic_model": {
    "root": "ordered-table",
    "table": "ordered-map-string-keyed",
    "array": "ordered-heterogeneous-values",
    "integer": "Int64-or-UInt64-lossless",
    "float": "Float64-including-inf-and-nan",
    "offset_datetime": "TomlOffsetDateTime-fixed-offset",
    "local_datetime": "std.time.DateTime",
    "local_date": "std.time.Date",
    "local_time": "std.time.Time",
    "comments": "discarded",
    "lexical_spelling": "discarded",
    "shared_identity": false,
    "binary": "not-a-wire-type",
    "view_lifetime": "until-reader-advance-or-operation-return"
  },
  "date_time": {
    "offset_type": "TomlOffsetDateTime",
    "offset_source": "std.time.UtcOffset",
    "local_datetime_type": "std.time.DateTime",
    "local_date_type": "std.time.Date",
    "local_time_type": "std.time.Time",
    "seconds_omitted": "normalize-to-zero",
    "fraction_digits": "1..9",
    "more_than_nine_digits": "reject",
    "leap_seconds": "reject",
    "timezone_lookup": false,
    "clock_capabilities": []
  },
  "duplicate_semantics": {
    "key": "reject",
    "table": "reject",
    "array_table_row": "append-in-source-order",
    "scalar_to_table": "reject",
    "table_to_scalar": "reject",
    "inline_table_extension": "reject",
    "implicit_parent_then_explicit": "allow-if-no-collision",
    "partial_success": false
  },
  "streaming": {
    "materialized_is_collector": true,
    "chunk_boundary_invariant": true,
    "single_root": true,
    "event_model": "explicit-key-table-array-inline-table-frames",
    "reader_input": "std.io.Reader-until-EOF",
    "writer_output": "std.io.Writer-via-writeAll",
    "empty_chunk": "no-state-change",
    "finish_required": true,
    "error_state": "terminal",
    "post_finish": "TomlError.Closed",
    "resource_limit_write": "atomic-no-state-change",
    "partial_tondo_result": "never-published",
    "stack": "explicit-bounded-frames-and-worklists"
  },
  "ownership": {
    "value_owner": "TomlValue",
    "options_copy": true,
    "reader_writer_affine": true,
    "reader_writer_copy": false,
    "reader_writer_share": false,
    "reader_writer_send": true,
    "view_borrow": "ends-at-reader-advance-or-operation-return",
    "input_alias": "never-retained",
    "comments_storage": "discarded",
    "table_identity": "logical-values-no-shared-mutable-memory"
  },
  "limits": [
    {"id":"max_input_bytes","unit":"bytes","scope":"whole-input","source":"TomlLimits.maxInputBytes"},
    {"id":"max_depth","unit":"frames","scope":"arrays-tables-inline-tables","source":"TomlLimits.maxDepth"},
    {"id":"max_nodes","unit":"nodes","scope":"whole-document","source":"TomlLimits.maxNodes"},
    {"id":"max_tables","unit":"tables","scope":"whole-document","source":"TomlLimits.maxTables"},
    {"id":"max_array_elements","unit":"elements","scope":"per-array-and-total","source":"TomlLimits.maxArrayElements"},
    {"id":"max_key_bytes","unit":"bytes","scope":"single-key","source":"TomlLimits.maxKeyBytes"},
    {"id":"max_path_segments","unit":"segments","scope":"dotted-path","source":"TomlLimits.maxPathSegments"},
    {"id":"max_scalar_bytes","unit":"bytes","scope":"single-token","source":"TomlLimits.maxScalarBytes"},
    {"id":"max_string_bytes","unit":"bytes","scope":"single-string","source":"TomlLimits.maxStringBytes"},
    {"id":"max_array_table_rows","unit":"rows","scope":"array-of-tables","source":"TomlLimits.maxArrayTableRows"},
    {"id":"vm_heap","unit":"bytes","scope":"all-materialized-values","source":"ResourceLimits.max_vm_heap_bytes"}
  ],
  "errors": {
    "type": "TomlError",
    "location": "half-open-UTF-8-byte-span-plus-one-based-line-column",
    "path": "stable-Key-or-Index-array",
    "kinds": [
      "InvalidLimit", "InvalidUtf8", "InvalidCharacter", "InvalidComment", "InvalidKey", "EmptyKey",
      "InvalidEscape", "InvalidString", "InvalidNumber", "IntegerOutOfRange", "InvalidDateTime",
      "DateTimePrecision", "InvalidArray", "InvalidTable", "InvalidTableArray", "DuplicateKey",
      "DuplicateTable", "TableAfterValue", "InlineTableExtension", "MissingValue", "UnexpectedToken",
      "TrailingInput", "DepthLimit", "NodeLimit", "TableLimit", "ArrayLimit", "KeyLimit", "ScalarLimit",
      "StringLimit", "ResourceLimit", "TypeMismatch", "MissingField", "UnknownField", "Io", "Closed",
      "NoProgress"
    ],
    "partial_success": false,
    "terminal_after": ["InvalidUtf8", "InvalidCharacter", "InvalidComment", "InvalidKey", "InvalidEscape", "InvalidString", "InvalidNumber", "IntegerOutOfRange", "InvalidDateTime", "DateTimePrecision", "InvalidArray", "InvalidTable", "InvalidTableArray", "DuplicateKey", "DuplicateTable", "TableAfterValue", "InlineTableExtension", "MissingValue", "UnexpectedToken", "TrailingInput", "DepthLimit", "NodeLimit", "TableLimit", "ArrayLimit", "KeyLimit", "ScalarLimit", "StringLimit", "ResourceLimit", "TypeMismatch", "MissingField", "UnknownField", "Io", "Closed", "NoProgress"]
  },
  "performance": {
    "scalar_oracle": true,
    "simd_allowed_after_equivalence": true,
    "dispatch": "target-declared-and-chunk-size-based",
    "parser_stack": "explicit-worklist",
    "streaming_allocation": "bounded-by-chunk-and-limits",
    "claims_before_perf_gate": "forbidden",
    "required_measurements": ["throughput", "tail-latency", "allocations", "bytes-copied", "memory", "depth", "tables", "adversarial-rejection"]
  },
  "test_matrix": [
    {"id":"syntax-and-schema","required":true,"observables":["toml-1.1.0","keys","strings","numbers","booleans","comments"]},
    {"id":"date-time","required":true,"observables":["offset","local-datetime","date","time","nanoseconds","precision-rejection"]},
    {"id":"dynamic-model","required":true,"observables":["ordered-tables","heterogeneous-arrays","array-of-tables","view-lifetime"]},
    {"id":"typed-codec","required":true,"observables":["field-order","annotations","unknown-fields","option-fields","temporal-types"]},
    {"id":"tables-and-duplicates","required":true,"observables":["dotted-paths","implicit-parents","duplicate-keys","duplicate-tables","inline-immutability"]},
    {"id":"streaming","required":true,"observables":["event-balance","one-byte-fragments","multiline-values","writer-order","eof"]},
    {"id":"limits-and-spans","required":true,"observables":["all-limits","half-open-spans","stable-path","no-partial-value","terminal-state"]},
    {"id":"scalar-and-optimized-equivalence","required":true,"observables":["scalar-reference","optimized-route","values-events-errors-spans-paths","ownership"]}
  ],
  "corpora": [
    {"id":"toml-1.1-valid","source":"owner-generated","required":true,"focus":["keys","strings","numbers","booleans","arrays","tables","inline-tables","array-of-tables"]},
    {"id":"date-time-and-numeric-boundaries","source":"owner-generated","required":true,"focus":["offsets","fractions","seconds-omitted","inf","nan","integer-range","underscores"]},
    {"id":"invalid-duplicates-and-security","source":"owner-generated","required":true,"focus":["invalid-utf8","invalid-escapes","duplicate-definitions","inline-extension","control-comments","ambient-boundary"]},
    {"id":"fragmentation-and-adversarial-limits","source":"owner-generated","required":true,"focus":["one-byte-chunks","nested-tables","large-arrays","long-keys","long-strings","spans"]}
  ],
  "exclusions": [
    "toml-1.0-alternate-dialect",
    "multiple-documents",
    "include",
    "macro",
    "environment-interpolation",
    "locale",
    "timezone-lookup",
    "comment-preservation",
    "round-trip-editing",
    "schema-discovery",
    "implicit-binary",
    "leap-seconds",
    "fractional-seconds-over-nine-digits",
    "selectable-operations",
    "duplicate-async-api"
  ],
  "implementation": {
    "status": "pending-after-native-gate",
    "public_api_promoted": false,
    "host": "required-after-native-gate",
    "required_follow_ups": ["STD-TOML-IMPL-001", "STD-TOML-TEST-001", "STD-TOML-PERF-001", "STD-TOML-CONF-001", "STD-TOML-DOC-001"]
  },
  "promotion": {
    "gates": [
      {"id":"design","required":true},
      {"id":"implementation","required":true},
      {"id":"conformance","required":true},
      {"id":"performance","required":true},
      {"id":"promote","required":true}
    ],
    "next_blocks": ["STD-CBOR-001", "STD-REGEX-001", "STD-ID-001", "STD-LOG-001", "DIAG-RUNTIME-001"]
  }
}
