{
  "format": "tondo-performance/1",
  "edition": "0.1",
  "phase": "PERF-001",
  "status": "design-locked",
  "purpose": "baseline-before-native-lowering",
  "contract": "docs/contracts/performance.md",
  "stdlib_contract": "testing/stdlib-performance.json",
  "measurement": {
    "clock": "monotonic",
    "warmup_iterations": 3,
    "measurement_repetitions": 9,
    "independent_processes": 3,
    "minimum_sample_count": 27,
    "summary": ["median", "p95", "p99"],
    "outliers": "report-not-delete",
    "clean_workspace": true,
    "pinned_toolchain": true,
    "deterministic_seed": "tondo-perf-0.1"
  },
  "environment": {
    "required_recorded": [
      "cpu_model",
      "cpu_features",
      "memory_bytes",
      "os",
      "kernel",
      "target",
      "backend",
      "profile",
      "rustc",
      "llvm",
      "cargo",
      "flags",
      "git_revision"
    ],
    "identity_fields": [
      "suite",
      "workload_id",
      "fixture_sha256",
      "target",
      "backend",
      "profile",
      "toolchain",
      "flags",
      "git_revision"
    ],
    "forbidden_identity": [
      "ambient_environment",
      "cpu_frequency",
      "pid",
      "path",
      "timestamp"
    ]
  },
  "dimensions": [
    {
      "id": "compile_time",
      "unit": "milliseconds",
      "direction": "lower-is-better",
      "max_regression_basis_points": 1000,
      "planes": ["compile"]
    },
    {
      "id": "code_size",
      "unit": "bytes",
      "direction": "lower-is-better",
      "max_regression_basis_points": 500,
      "planes": ["compile", "runtime"]
    },
    {
      "id": "startup",
      "unit": "microseconds",
      "direction": "lower-is-better",
      "max_regression_basis_points": 1000,
      "planes": ["runtime"]
    },
    {
      "id": "throughput",
      "unit": "operations_per_second",
      "direction": "higher-is-better",
      "max_regression_basis_points": 500,
      "planes": ["runtime"]
    },
    {
      "id": "latency",
      "unit": "microseconds",
      "direction": "lower-is-better",
      "max_regression_basis_points": 1000,
      "planes": ["runtime"]
    },
    {
      "id": "allocation_count",
      "unit": "count",
      "direction": "lower-is-better",
      "max_regression_basis_points": 0,
      "planes": ["runtime"]
    },
    {
      "id": "allocated_bytes",
      "unit": "bytes",
      "direction": "lower-is-better",
      "max_regression_basis_points": 1000,
      "planes": ["runtime"]
    },
    {
      "id": "peak_memory",
      "unit": "bytes",
      "direction": "lower-is-better",
      "max_regression_basis_points": 1000,
      "planes": ["compile", "runtime"]
    },
    {
      "id": "retain_operations",
      "unit": "count",
      "direction": "lower-is-better",
      "max_regression_basis_points": 1000,
      "planes": ["runtime"]
    },
    {
      "id": "release_operations",
      "unit": "count",
      "direction": "lower-is-better",
      "max_regression_basis_points": 1000,
      "planes": ["runtime"]
    },
    {
      "id": "pause_time",
      "unit": "microseconds",
      "direction": "lower-is-better",
      "max_regression_basis_points": 1000,
      "planes": ["runtime"]
    }
  ],
  "workload_classes": [
    {
      "id": "adversarial",
      "required": true,
      "description": "Published overflow, malformed-input, cancellation and resource-limit boundaries."
    },
    {
      "id": "empty",
      "required": true,
      "description": "The smallest valid program and no-work path."
    },
    {
      "id": "large",
      "required": true,
      "description": "A bounded program that exposes allocation, cache and scheduler pressure."
    },
    {
      "id": "representative",
      "required": true,
      "description": "A production-shaped STD-0.1A or language workload with documented intent."
    },
    {
      "id": "small",
      "required": true,
      "description": "A normal fast path where setup does not dominate the observation."
    }
  ],
