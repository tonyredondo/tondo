    {
      "id": "vm-hosted",
      "status": "baseline-required",
      "oracle": "language-observables-and-instrumented-counters"
    },
    {
      "id": "native",
      "status": "candidates-by-NATIVE-001-fast-lane-capture-deferred",
      "oracle": "must-match-vm-hosted-before-comparison"
    }
  ],
  "oracle_policy": {
    "compile": "canonical-interface-artifact-and-diagnostic-observations",
    "runtime": "exact-language-observables-before-performance",
    "instrumented_counters": "harness-only-not-language-semantics",
    "native_comparison": "semantic-equivalence-first",
    "mismatch": "fail-the-performance-gate"
  },
  "baseline": {
    "status": "capture-required-before-native-lowering",
    "report": "target/reliability/evidence/performance-baseline.json",
    "numbers": "not-present-in-design-contract",
    "identity_must_match": true,
    "capture_before": ["NATIVE-ABI-001", "optimization-promotion"]
  },
  "regression_policy": {
    "same_identity_only": true,
    "same_workload_hash": true,
    "same_target_backend_profile": true,
    "no_cross_target_aggregation": true,
    "improvement_does_not_cancel_regression": true,
    "allocation_count_change_requires_review": true,
    "budget_override": "stricter-only-unless-new-reviewed-baseline",
    "unexplained_regression": "fail"
  },
  "gate_sequence": [
    {
      "id": "design",
      "requires": ["workload-identities", "bounds", "dimension-budgets", "oracle"]
    },
    {
      "id": "capture",
      "requires": ["clean-workspace", "pinned-toolchain", "recorded-environment", "repeated-samples"]
    },
    {
      "id": "compare",
      "requires": ["exact-oracle-equivalence", "same-identity", "applicable-budgets", "no-overflow-of-bounds"]
    },
    {
      "id": "promote",
      "requires": ["reviewed-baseline", "reproducible-report", "no-unexplained-regression", "ci-evidence"]
    }
  ],
  "next_blocks": ["NATIVE-LOWER-DEBUG-001"]
}
