{
  "format": "tondo-stdlib-owner-contract/1",
  "owner": "std.meta",
  "edition": "0.1",
  "phase": "STD-0.1A",
  "status": "draft-contract",
  "contract": "docs/contracts/std-meta.md",
  "layer": "A0",
  "kind": "build-only",
  "target": "tondo-meta",
  "profile": "meta",
  "api": "tondo-std-meta-0.1/1",
  "package": {
    "format": "tondo-std-meta-package-draft",
    "package_id": "toolchain:std-meta:draft",
    "source": "stdlib/meta/src/meta.to",
    "descriptor": "stdlib/meta/descriptor.json",
    "source_hash": "sha256:1a5a94378e6de25852b5316885d038f3305f764f697e8df522d8cf841580649b",
    "content_hash": "sha256:45628c83b0e8d95afb8d07ead31b4051af944c96f0dc43aefd58af92fb39ed91"
  },
  "capabilities": {
    "required": [],
    "forbidden": [
      "filesystem",
      "environment",
      "process",
      "clock",
      "civil-clock",
      "entropy",
      "network",
      "threads",
      "dynamic-linking",
      "unsafe"
    ]
  },
  "invariants": [
    "snapshot-is-immutable-and-canonical",
    "roots-are-explicit-and-closed",
    "source-builder-publishes-atomically",
    "source-maps-are-bounded-and-byte-based",
    "renderer-is-deterministic",
    "no-ambient-host-lookup",
    "no-runtime-value-reflection",
    "meta-target-rejects-effects-and-unsafe"
  ],
  "limits": [
    {"id": "meta_steps", "unit": "steps", "scope": "one-meta-invocation", "check": "before-execution"},
    {"id": "meta_memory_bytes", "unit": "bytes", "scope": "one-meta-invocation", "check": "before-execution"},
    {"id": "meta_output_bytes", "unit": "bytes", "scope": "one-meta-response", "check": "before-publish"},
    {"id": "renderer_indentation_level", "unit": "levels", "scope": "one-render", "check": "before-repeat"},
    {"id": "fuzz_input_bytes", "unit": "bytes", "scope": "one-protocol-probe", "check": "before-decode"}
  ],
  "test_matrix": [
    {"id": "snapshot-model", "required": true, "observables": ["canonical-order", "hash", "public-structure", "privacy", "no-runtime-values"]},
    {"id": "request-response", "required": true, "observables": ["api-version", "owned-inputs", "canonical-codec", "hash", "atomic-response"]},
    {"id": "source-builder", "required": true, "observables": ["declared-outputs", "utf8", "source-maps", "duplicates", "output-limit", "missing-output"]},
    {"id": "meta-target-boundary", "required": true, "observables": ["capability-rejection", "unsafe-rejection", "no-ambient-host", "closed-target"]},
    {"id": "canonical-rendering", "required": true, "observables": ["identifier", "escaping", "indentation", "render-limit", "reproducibility"]},
    {"id": "compile-time-budget", "required": true, "observables": ["steps", "memory-bytes", "output-bytes", "generated-source-size", "no-unbounded-work"]}
  ],
  "corpora": [
    {"id": "meta-protocols", "source": "owner-generated", "required": true, "focus": ["empty", "canonical", "revision", "unknown-fields", "byte-mutation", "truncation"]},
    {"id": "source-builder-boundaries", "source": "owner-generated", "required": true, "focus": ["utf8", "source-map", "duplicate-output", "missing-output", "output-limit", "atomicity"]},
    {"id": "target-boundary", "source": "owner-generated", "required": true, "focus": ["capabilities", "unsafe", "environment", "filesystem", "process", "network"]}
  ],
  "promotion": {
    "gates": [
      {"id": "design", "requires": ["closed-api", "explicit-roots", "finite-limits", "build-only-target"]},
      {"id": "implementation", "requires": ["canonical-model", "owned-builder", "source-maps", "deterministic-renderer"]},
      {"id": "conformance", "requires": ["owner-corpus", "target-rejection", "format-stability", "cross-platform-source"]},
      {"id": "performance", "requires": ["compile-time-workload", "generated-size-workload", "budget-record"]},
      {"id": "promote", "requires": ["STD-CONF-001", "META-VM-001", "STD-TEST-001", "coverage-baseline"]}
    ],
    "next_coordination": "STD-TEST-001"
  }
}
