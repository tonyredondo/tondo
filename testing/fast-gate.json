{
  "format": "tondo-fast-gate/1",
  "edition": "0.1",
  "coverage": {
    "new_executable_line_min_basis_points": 10000,
    "global_baseline_source": "testing/quality-baseline.json"
  },
  "mutation": {
    "required_for_production_rust_changes": true,
    "jobs": 1,
    "timeout_seconds": 300,
    "build_timeout_seconds": 600
  },
  "documentation_paths": [
    "README.md",
    "TONDO_IMPLEMENTATION_TRACKER.md",
    "TONDO_LANGUAGE_SPEC.md",
    "TONDO_LLM_FORM_SPEC.md",
    "TONDO_STANDARD_LIBRARY_SPEC.md",
    "TONDO_TESTING_SPEC.md",
    "TONDO_TOOLCHAIN_SPEC.md",
    "docs/",
    "docs/contracts/diagnostic-runtime.md",
    "docs/contracts/diagnostic-dump.md",
    "docs/contracts/diagnostic-test.md",
    "conformance/0.1/cases/documentation/",
    "conformance/0.1/manifest.json",
    "conformance/draft/manifest.json",
    "testing/coverage-matrix.json",
    "testing/doc-test-runtime-links.json",
    "testing/inventory.json",
    "testing/normative-evidence.json",
    "testing/normative-gap-audit.json",
    "testing/tracker-graph.json"
  ],
  "gate_policy_paths": [
    ".github/workflows/test.yml",
    "scripts/documentation-gate.sh",
    "scripts/fast-coverage-check.sh",
    "scripts/fast-gate-test.sh",
    "scripts/fast-gate.sh",
    "scripts/native-arc-check.sh",
    "scripts/native-arc-test.sh",
    "scripts/native-memory-check.sh",
    "scripts/native-memory-test.sh",
    "testing/fast-gate.json"
  ],
  "inline_test_tail_paths": [
    "crates/tondo-reliability/src/matrix.rs"
  ],
  "evaluation_paths": [
    "tools/native-evaluation/",
    "scripts/native-evaluation-fast.sh",
    "scripts/native-evaluation-fast-check.sh",
    "scripts/native-evaluation-fast-test.sh",
    "scripts/native-evaluation-runner.sh",
    "scripts/native-evaluation-runner-check.sh",
    "scripts/native-evaluation-runner-test.sh",
    "scripts/native-select-check.sh",
    "scripts/native-select-test.sh",
    "testing/native-evaluation-fast.json",
    "testing/native-evaluation-runner.json",
    "testing/native-select.json"
  ],
  "shared_paths": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    ".cargo/",
    ".github/",
    "TONDO_LANGUAGE_SPEC.md",
    "TONDO_TESTING_SPEC.md",
    "TONDO_TOOLCHAIN_SPEC.md",
    "docs/contracts/performance.md",
    "testing/performance.json",
    "testing/native-arc.json",
    "testing/native-memory.json",
    "testing/inventory.json",
    "testing/coverage-matrix.json",
    "testing/normative-evidence.json",
    "testing/quality-baseline.json",
    "testing/conformance-ratchet.json",
    "testing/tracker-graph.json",
    "TONDO_IMPLEMENTATION_TRACKER.md",
    "conformance/",
    "crates/tondo-compiler/src/syntax/",
    "crates/tondo-native-runtime/",
    "crates/tondo-compiler/src/hir/",
    "crates/tondo-compiler/src/mir/",
    "crates/tondo-compiler/src/resolve/",
    "crates/tondo-compiler/src/types.rs",
    "crates/tondo-compiler/src/bytecode/",
    "crates/tondo-vm/src/bytecode/",
    "crates/tondo-vm/src/runtime/execute.rs",
    "crates/tondo-vm/src/runtime/diagnostics.rs",
    "crates/tondo-vm/src/runtime/heap.rs",
    "crates/tondo-vm/src/runtime/dump.rs",
    "scripts/performance-check.sh",
    "scripts/performance-test.sh",
    "scripts/native-evaluation-check.sh",
    "scripts/native-evaluation-test.sh",
    "scripts/native-arc-check.sh",
    "scripts/native-arc-test.sh",
    "testing/native-evaluation.json",
    "scripts/test-gate.sh",
    "scripts/quality-gate.sh",
    "testing/diagnostic-tooling.json",
    "testing/diagnostic-runtime.json",
    "testing/diagnostic-test.json",
    "testing/diagnostic-leak.json",
    "testing/diagnostic-dump.json",
    "scripts/diagnostic-contract-check.sh",
    "scripts/diagnostic-contract-test.sh",
    "scripts/diagnostic-runtime-check.sh",
    "scripts/diagnostic-runtime-test.sh",
    "scripts/diagnostic-leak-check.sh",
    "scripts/diagnostic-leak-test.sh",
    "scripts/diagnostic-dump-check.sh",
    "scripts/diagnostic-dump-test.sh",
    "scripts/diagnostic-test-check.sh",
    "scripts/diagnostic-test-test.sh"
  ],
  "packages": [
    { "prefix": "crates/tondo-native-runtime/", "package": "tondo-native-runtime" },
    { "prefix": "crates/tondo-cli/", "package": "tondo-cli" },
    { "prefix": "crates/tondo-compiler/", "package": "tondo-compiler" },
    { "prefix": "crates/tondo-conformance/", "package": "tondo-conformance" },
    { "prefix": "crates/tondo-reference-adapter/", "package": "tondo-reference-adapter" },
    { "prefix": "crates/tondo-reliability/", "package": "tondo-reliability" },
    { "prefix": "crates/tondo-stdlib/", "package": "tondo-stdlib" },
    { "prefix": "crates/tondo-vm/", "package": "tondo-vm" }
  ],
  "policy": {
    "documentation_gate": "doc-test + documentation conformance + normative evidence + tracker lint + stdlib contracts; no workspace tests, coverage or mutation",
    "fast_gate": "fmt + impacted package check/test; changed executable lines and diff mutation only for production Rust",
    "shared_frontier": "full test-gate",
    "wave_boundary": "full test-gate + quality-gate + live conformance",
    "draft_evidence": "target/reliability/fast-gate/"
  }
}
