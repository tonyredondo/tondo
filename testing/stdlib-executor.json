  "surface": {
    "types": [
      "Pool",
      "BlockingPool",
      "Actor[S, M, E]",
      "ActorRef[M]",
      "ExecutorError = { InvalidWorkers, InvalidCapacity, ResourceLimit, CapabilityMissing }",
      "SubmitError = { Saturated, Closed, Cancelled, ResourceLimit }",
      "ActorSendError[M] = { Saturated(M), Closed(M), Cancelled(M), Terminated(M), ResourceLimit(M) }"
    ],
    "signatures": [
      {
        "id": "pool",
        "signature": "pub fn pool(workers: Int, capacity: Int): Pool ! ExecutorError",
        "kind": "cooperative-pool-constructor",
        "effect": "sync"
      },
      {
        "id": "blocking-pool",
        "signature": "pub fn blockingPool(workers: Int, capacity: Int): BlockingPool ! ExecutorError",
        "kind": "blocking-pool-constructor",
        "effect": "sync"
      },
      {
        "id": "pool-submit",
        "signature": "pub fn Pool.submit[T, E](ref self, job: fn(): T ! E suspends): Join[T, E] ! SubmitError suspends",
        "kind": "backpressured-submit",
        "effect": "suspends"
      },
      {
        "id": "pool-try-submit",
        "signature": "pub fn Pool.trySubmit[T, E](ref self, job: fn(): T ! E suspends): Join[T, E] ! SubmitError",
        "kind": "nonblocking-submit",
        "effect": "sync"
      },
      {
        "id": "pool-actor",
        "signature": "pub fn Pool.actor[S: Send + Discard, M: Send + Discard, E](ref self, state: S, capacity: Int, step: fn(mut S, M): Unit ! E suspends): Actor[S, M, E] ! ExecutorError",
        "kind": "actor-constructor",
        "effect": "sync"
      },
      {
        "id": "pool-shutdown",
        "signature": "pub fn Pool.shutdown(self): Unit suspends",
        "kind": "graceful-terminal",
        "effect": "suspends"
      },
      {
        "id": "pool-cancel",
        "signature": "pub fn Pool.cancel(self): Unit suspends",
        "kind": "cancel-terminal",
        "effect": "suspends"
      },
      {
        "id": "actor-send",
        "signature": "pub fn ActorRef.send(ref self, message: M): Unit ! ActorSendError[M] selectable",
        "kind": "backpressured-message",
        "effect": "selectable"
      },
      {
        "id": "actor-try-send",
        "signature": "pub fn ActorRef.trySend(ref self, message: M): Unit ! ActorSendError[M]",
        "kind": "nonblocking-message",
        "effect": "sync"
      },
      {
        "id": "actor-stop",
        "signature": "pub fn Actor.stop(self): Unit ! E suspends",
        "kind": "actor-terminal",
        "effect": "suspends"
      },
      {
        "id": "blocking-run",
        "signature": "pub fn BlockingPool.run[T, E](ref self, job: fn(): T ! E): T ! E suspends",
        "kind": "blocking-bridge",
        "effect": "suspends"
      },
      {
        "id": "blocking-shutdown",
        "signature": "pub fn BlockingPool.shutdown(self): Unit suspends",
        "kind": "graceful-terminal",
        "effect": "suspends"
      },
      {
        "id": "blocking-cancel",
        "signature": "pub fn BlockingPool.cancel(self): Unit suspends",
        "kind": "cancel-terminal",
        "effect": "suspends"
      }
