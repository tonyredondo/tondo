        "id": "design",
        "requires": ["proto3-model", "scalar-mapping", "presence-policy", "unknown-policy", "schema-identity"]
      },
      {
        "id": "implementation",
        "requires": ["deterministic-generator", "typed-no-dom", "explicit-parser-stack", "bounded-reader-writer", "direct-schema-dispatch"]
      },
      {
