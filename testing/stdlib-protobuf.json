  ],
  "test_matrix": [
    {"id": "schema-inputs", "required": true, "observables": ["proto3-only", "closed-imports", "canonical-output", "collision-errors"]},
    {"id": "wire-model", "required": true, "observables": ["tag", "wire-type", "varint", "fixed", "length-delimited", "groups"]},
    {"id": "scalar-mapping", "required": true, "observables": ["signedness", "zigzag", "range", "float-bits", "utf8", "bytes"]},
    {"id": "presence", "required": true, "observables": ["implicit-default", "optional", "message-presence", "oneof-case"]},
    {"id": "repeated-and-packed", "required": true, "observables": ["order", "packed", "unpacked", "multiple-packed", "whole-elements"]},
    {"id": "maps", "required": true, "observables": ["key-domain", "last-wins", "ordinary-order", "deterministic-order"]},
    {"id": "open-enums", "required": true, "observables": ["known", "unknown-number", "repeated", "map-value"]},
    {"id": "unknown-fields", "required": true, "observables": ["raw-record", "groups", "capture-order", "discard", "nested"]},
    {"id": "typed-direct", "required": true, "observables": ["static-dispatch", "no-dom", "schema-mismatch", "atomic-failure"]},
    {"id": "streaming", "required": true, "observables": ["frame", "events", "payload-lifetime", "chunk-independence", "terminal-error"]},
    {"id": "limits", "required": true, "observables": ["finite-resource", "preflight", "host-stack-safety", "limit-error"]},
    {"id": "evolution", "required": true, "observables": ["safe", "conditional-waiver", "unsafe", "diagnostic-location"]},
    {"id": "deterministic", "required": true, "observables": ["field-order", "map-order", "unknown-order", "nested", "layout-independence"]},
