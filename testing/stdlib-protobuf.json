      "focus": ["presence", "repeated", "packed", "oneof", "maps", "evolution"]
    },
    {
      "id": "protobuf-official-enums",
      "source": "https://protobuf.dev/programming-guides/enum/",
      "required": true,
      "focus": ["open-enum", "unknown-values", "repeated-enum", "map-enum-value"]
    },
    {
      "id": "scalar-wire-boundaries",
      "source": "owner-generated",
      "required": true,
      "focus": ["signed-minima", "unsigned-maxima", "zigzag", "fixed-width", "float-bits"]
    },
    {
      "id": "presence-and-oneof",
