{
  "format": "tondo-stdlib-owner-contract/1",
  "owner": "std.cbor",
  "parent_owner": "std",
  "edition": "0.1",
  "phase": "STD-0.1B",
  "task": "STD-CBOR-001",
  "status": "contract-locked",
  "contract": "docs/contracts/stdlib-cbor.md",
  "spec": "TONDO_STANDARD_LIBRARY_SPEC.md",
  "language_spec": "TONDO_LANGUAGE_SPEC.md",
  "layer": "B8",
  "kind": "runtime-facing",
  "target": "tondo-vm-hosted-and-native",
  "dependencies": ["std.serialization", "std.io", "std.bytes"],
  "capabilities": {
    "required": [],
    "optional": [],
    "import_effect": "none",
    "ambient_lookup": false,
    "forbidden": ["environment", "includes", "schema-discovery", "reflection-registry", "timezone-lookup"]
  },
  "wire": {
    "spec": "RFC 8949",
    "rfc": "8949",
    "encoding": "binary",
    "root": "single-data-item",
    "trailing_data": "reject",
    "major_types": ["unsigned-integer", "negative-integer", "byte-string", "text-string", "array", "map", "tag", "simple-or-float"],
    "length_forms": ["definite", "indefinite"],
    "indefinite_kinds": ["byte-string", "text-string", "array", "map"],
    "break": "only-closes-indefinite-frame",
    "text_encoding": "utf-8",
    "map_keys": "arbitrary-data-items",
    "simple_values": "preserve-well-formed-unassigned",
    "special_simple_values": ["false", "true", "null", "undefined"],
    "float_widths": ["float16", "float32", "float64"],
    "tags": "unsigned-64-bit-preserved",
    "ordinary_non_minimal": "accept",
    "ordinary_nan": "preserve-bits"
  },
  "values": {
    "dynamic_type": "CborValue",
    "view_type": "CborValueView",
    "raw_type": "CborRaw",
    "entry_type": "CborEntry",
    "tag_type": "CborTag",
    "float16_type": "CborFloat16",
    "map_representation": "ordered-pairs-arbitrary-keys",
    "integer_kinds": ["UInt", "Negative"],
    "float_kinds": ["Float16", "Float32", "Float64"],
    "binary_type": "bytes",
    "undefined_distinct_from_null": true,
    "shared_identity": false,
    "bignum_tags": "preserve-generic-tagged-bytes"
  },
  "api": {
    "module": "std.cbor",
    "types": ["Cbor", "CborEntry", "CborTag", "CborFloat16", "CborValue", "CborValueView", "CborRaw", "CborPath", "CborEvent", "CborDuplicatePolicy", "CborUnknownTagPolicy", "CborNonMinimalPolicy", "CborIndefinitePolicy", "CborLimits", "CborDecodeOptions", "CborEncodeOptions", "CborErrorKind", "CborError", "CborReader", "CborWriter"],
    "functions": ["parse", "parseView", "decode", "encode", "validate", "encodeDeterministic", "raw", "rawUnchecked"],
    "reader_methods": ["fromBytes", "fromReader", "next", "own", "finish"],
    "writer_methods": ["toWriter", "write", "finish"],
    "terminal_state": "error-or-finish-terminal",
    "end_of_document": "next-returns-none-once",
    "typed_dispatch": "Encode-Decode-static-no-dynamic-dom",
    "annotations": ["@name", "@cbor", "@ignore"]
  },
  "surface": {
    "types": ["Cbor", "CborEntry", "CborTag", "CborFloat16", "CborValue", "CborValueView", "CborRaw", "CborPath", "CborEvent", "CborDuplicatePolicy", "CborUnknownTagPolicy", "CborNonMinimalPolicy", "CborIndefinitePolicy", "CborLimits", "CborDecodeOptions", "CborEncodeOptions", "CborErrorKind", "CborError", "CborReader", "CborWriter"],
    "signatures": [
      {"id": "limits-defaults", "signature": "pub fn CborLimits.defaults(): CborLimits", "kind": "constructor", "effect": "pure"},
      {"id": "limits-create", "signature": "pub fn CborLimits.create(...): CborLimits ! CborError", "kind": "constructor", "effect": "pure"},
      {"id": "decode-options-defaults", "signature": "pub fn CborDecodeOptions.defaults(): CborDecodeOptions", "kind": "constructor", "effect": "pure"},
      {"id": "encode-options-defaults", "signature": "pub fn CborEncodeOptions.defaults(): CborEncodeOptions", "kind": "constructor", "effect": "pure"},
      {"id": "parse", "signature": "pub fn parse(input: Bytes, options: CborDecodeOptions): CborValue ! CborError", "kind": "materialize", "effect": "pure"},
      {"id": "parse-view", "signature": "pub fn parseView(input: Bytes, options: CborDecodeOptions): CborValueView ! CborError", "kind": "view", "effect": "pure"},
      {"id": "decode", "signature": "pub fn decode[T: Decode[Cbor]](...): T ! CborError", "kind": "typed-decode", "effect": "pure"},
      {"id": "encode-value", "signature": "pub fn encode(value: CborValue, options: CborEncodeOptions): Bytes ! CborError", "kind": "materialize", "effect": "pure"},
      {"id": "encode-typed", "signature": "pub fn encode[T: Encode[Cbor]](...): Bytes ! CborError", "kind": "typed-encode", "effect": "pure"},
      {"id": "validate", "signature": "pub fn validate(input: Bytes, options: CborDecodeOptions): Unit ! CborError", "kind": "validation", "effect": "pure"},
      {"id": "encode-deterministic", "signature": "pub fn encodeDeterministic(value: CborValue, limits: CborLimits): Bytes ! CborError", "kind": "deterministic", "effect": "pure"},
      {"id": "raw", "signature": "pub fn raw(input: Bytes, options: CborDecodeOptions): CborRaw ! CborError", "kind": "raw", "effect": "pure"},
      {"id": "raw-unchecked", "signature": "pub unsafe fn rawUnchecked(input: Bytes): CborRaw", "kind": "raw", "effect": "unsafe"},
      {"id": "reader-from-bytes", "signature": "pub fn CborReader.fromBytes(...): CborReader ! CborError", "kind": "reader", "effect": "pure"},
      {"id": "reader-from-reader", "signature": "pub fn CborReader.fromReader(...): CborReader ! CborError suspends", "kind": "reader", "effect": "suspends"},
      {"id": "reader-next", "signature": "pub fn CborReader.next(var self): CborEvent? ! CborError suspends", "kind": "reader", "effect": "suspends"},
      {"id": "reader-own", "signature": "pub fn CborReader.own(var self, event: CborEvent): CborEvent ! CborError", "kind": "reader", "effect": "pure"},
      {"id": "reader-finish", "signature": "pub fn CborReader.finish(var self): Unit ! CborError suspends", "kind": "reader", "effect": "suspends"},
      {"id": "writer-to-writer", "signature": "pub fn CborWriter.toWriter(...): CborWriter ! CborError suspends", "kind": "writer", "effect": "suspends"},
      {"id": "writer-write", "signature": "pub fn CborWriter.write(var self, event: CborEvent): Unit ! CborError suspends", "kind": "writer", "effect": "suspends"},
      {"id": "writer-finish", "signature": "pub fn CborWriter.finish(var self): Unit ! CborError suspends", "kind": "writer", "effect": "suspends"}
    ],
    "direct_call_waits": false,
    "explicit_await_direct_call": "forbidden",
    "explicit_await_join": "unchanged-by-language",
    "inference_by_name": false,
    "bodyless_requires_effect": true,
    "bodyful_inference": "allowed",
    "selectable_operations": [],
    "no_async_duplicate_api": true
  },
  "streaming": {
    "event_model": "single-root-explicit-tags-and-indefinite-frames",
    "reader_inputs": ["Bytes", "Reader"],
    "writer_outputs": ["BytesBuilder", "Writer"],
    "payload_lifetime": "until-next-event",
    "materialization": "explicit-own",
    "reader_state": "bounded-explicit-stack",
    "writer_state": "bounded-explicit-stack",
    "typed_mode": "direct-events-no-dynamic-dom",
    "partial_failure": "terminal-error-no-partial-success",
    "chunk_boundary_invariant": true,
    "empty_chunk": "no-state-change",
    "indefinite_frames": ["bytes", "text", "array", "map"],
    "break_validation": "only-current-indefinite-frame",
    "finish_required": true,
    "error_state": "terminal",
    "post_finish": "CborError.Closed",
    "resource_limit_write": "atomic-no-state-change",
    "partial_tondo_result": "never-published",
    "stack": "explicit-bounded-frames-and-worklists"
  },
  "policies": {
    "dynamic_map_duplicates": {"default": "preserve", "allowed": ["preserve", "reject", "first", "last"], "last_replacement_position": "retain-first-position"},
    "typed_map_duplicates": {"default": "reject", "allowed": ["reject", "first", "last"]},
    "unknown_tags": {"default": "preserve", "allowed": ["preserve", "reject"]},
    "non_minimal_decode": {"default": "accept", "allowed": ["accept", "reject"]},
    "indefinite_decode": {"default": "accept", "allowed": ["accept", "reject"]},
    "deterministic_maps": {"rule": "bytewise-lexicographic-deterministic-key-encoding", "collision": "reject"},
    "deterministic_indefinite": "reject",
    "deterministic_nan": "one-quiet-nan-float16",
    "deterministic_float": "shortest-exact-width",
    "raw": "exact-bytes-only-after-validation"
  },
  "deterministic": {
    "operation": "encodeDeterministic",
    "universal_canonical": false,
    "preferred_integer_and_length": true,
    "preferred_tag_argument": true,
    "indefinite_items": "reject",
    "float_rule": "shortest-width-preserving-value-and-sign",
    "nan_rule": "one-quiet-nan-float16-0x7e00",
    "negative_zero": "preserve",
    "array_order": "preserve",
    "tag_order": "preserve-nesting",
    "map_order": "deterministic-key-encoding-bytes",
    "key_collision": "reject",
    "streaming_input": "already-sorted-keys-and-definite-frames"
  },
  "limits": [
    {"id": "max_document_bytes", "unit": "bytes", "scope": "input", "check": "before-read-growth"},
    {"id": "max_depth", "unit": "frames", "scope": "parser-stack", "check": "before-push"},
    {"id": "max_array_items", "unit": "items", "scope": "one-array", "check": "before-append"},
    {"id": "max_map_pairs", "unit": "pairs", "scope": "one-map", "check": "before-append"},
    {"id": "max_string_bytes", "unit": "decoded-utf8-bytes", "scope": "one-text-string", "check": "before-materialization"},
    {"id": "max_byte_string_bytes", "unit": "bytes", "scope": "one-byte-string", "check": "before-materialization"},
    {"id": "max_chunks", "unit": "chunks", "scope": "one-indefinite-string", "check": "before-chunk"},
    {"id": "max_tags", "unit": "tags", "scope": "one-document", "check": "before-tag"},
    {"id": "max_simple_values", "unit": "values", "scope": "one-document", "check": "before-simple"},
    {"id": "max_events", "unit": "events", "scope": "one-document", "check": "before-next-event"},
    {"id": "max_output_bytes", "unit": "bytes", "scope": "one-encode", "check": "before-write-growth"},
    {"id": "vm_heap", "unit": "runtime-defined", "scope": "host", "check": "before-publish"}
  ],
  "errors": {
    "type": "CborError",
    "location": "half-open-UTF-8-byte-span-plus-stable-path",
    "path": "ArrayIndex-MapEntry-MapKey-MapValue-Tag",
    "partial_success": false,
    "kinds": ["UnexpectedEof", "InvalidInitialByte", "InvalidAdditionalInfo", "InvalidBreak", "InvalidUtf8", "InvalidSimpleValue", "InvalidFloat", "InvalidLength", "NonMinimalEncoding", "IndefiniteNotAllowed", "InvalidChunk", "InvalidTag", "UnknownTag", "TypeMismatch", "DuplicateKey", "DeterministicKeyCollision", "OutOfOrderKey", "NumberRange", "LimitExceeded", "TooManyChunks", "TooManyTags", "TrailingData", "IoError", "Closed", "NoProgress"]
  },
  "performance": {
    "scalar_oracle": true,
    "simd_allowed_after_equivalence": true,
    "dispatch": "target-declared-and-input-size-based",
    "parser_stack": "explicit-worklist",
    "streaming_allocation": "bounded-by-chunk-and-limits",
    "claims_before_perf_gate": "forbidden"
  },
  "test_matrix": [
    {"id": "major-types", "required": true, "observables": ["all-major-types", "special-values", "wire-round-trip"]},
    {"id": "integer-and-float-widths", "required": true, "observables": ["uint64", "negative-magnitude", "float16-bits", "nan", "negative-zero"]},
    {"id": "tags-and-simple-values", "required": true, "observables": ["unknown-tag", "nested-tags", "undefined", "simple-preservation"]},
    {"id": "indefinite-framing", "required": true, "observables": ["chunks", "break", "nested-frames", "chunk-independence"]},
    {"id": "maps", "required": true, "observables": ["arbitrary-keys", "pair-order", "duplicate-policy", "key-path"]},
    {"id": "typed-direct", "required": true, "observables": ["typed-value", "no-dynamic-dom", "type-error", "ownership"]},
    {"id": "streaming", "required": true, "observables": ["event-order", "payload-lifetime", "terminal-error", "finish"]},
    {"id": "limits-and-malformed", "required": true, "observables": ["finite-resource", "truncation", "invalid-break", "stack-safety"]},
    {"id": "deterministic", "required": true, "observables": ["preferred-width", "defined-length", "map-order", "key-collision"]},
    {"id": "interoperability", "required": true, "observables": ["rfc-vectors", "external-parse", "external-encode", "rejection"]}
  ],
  "corpora": [
    {"id": "rfc-8949-wire-model", "source": "https://www.rfc-editor.org/rfc/rfc8949.html", "required": true, "focus": ["major-types", "additional-information", "tags", "simple-values"]},
    {"id": "integer-float-boundaries", "source": "owner-generated", "required": true, "focus": ["uint64", "negative-magnitude", "float16", "float32", "float64", "nan", "zero-sign"]},
    {"id": "tags-and-undefined", "source": "owner-generated", "required": true, "focus": ["unknown-tags", "nested-tags", "undefined", "simple-codes"]},
    {"id": "indefinite-and-fragments", "source": "owner-generated", "required": true, "focus": ["byte-chunks", "text-chunks", "indefinite-arrays", "indefinite-maps", "one-byte"]},
    {"id": "maps-and-duplicates", "source": "owner-generated", "required": true, "focus": ["arbitrary-keys", "duplicates", "order", "deterministic-collision"]},
    {"id": "malformed-and-limits", "source": "owner-generated", "required": true, "focus": ["truncation", "reserved-ai", "invalid-break", "depth", "length", "event"]},
    {"id": "deterministic-vectors", "source": "owner-generated", "required": true, "focus": ["preferred-serialization", "shortest-float", "defined-length", "map-order"]}
  ],
  "exclusions": [
    "application-protocol-schema-validation",
    "CDDL-compiler",
    "COSE-signing-and-encryption",
    "CBOR-LD",
    "implicit-timezone-or-locale-conversion",
    "automatic-bignum-materialization",
    "concatenated-item-framing"
  ],
  "promotion": {
    "gates": [
      {"id": "design", "requires": ["rfc-wire-model", "tag-policy", "indefinite-policy", "deterministic-rule", "limit-identities"]},
      {"id": "implementation", "requires": ["typed-no-dom", "explicit-parser-stack", "bounded-reader-writer", "atomic-errors"]},
      {"id": "conformance", "requires": ["rfc-corpus", "fragment-equivalence", "deterministic-vectors", "independent-implementation"]},
      {"id": "performance", "requires": ["scalar-oracle", "bounded-allocation", "adversarial-depth", "target-qualified-report"]},
      {"id": "promote", "requires": ["tag-preservation", "unknown-simple-preservation", "deterministic-map-proof", "STD-PERF-001-report"]}
    ],
    "next_blocks": ["STD-LOG-001", "DIAG-RUNTIME-001"]
  },
  "implementation": {
    "status": "pending-after-native-gate",
    "public_api_promoted": false,
    "host": "required-after-native-gate",
    "required_follow_ups": ["STD-CBOR-IMPL-001", "STD-CBOR-TEST-001", "STD-CBOR-PERF-001", "STD-CBOR-CONF-001", "STD-CBOR-DOC-001"]
  }
}
