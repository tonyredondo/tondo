// A task and its join (crates/tondo-runtime/src/tasks/join.rs: complete, finish,
// take, cancel_join, tondo_rt_join_detach, end_detached, free_join; Wait::parked
// in tasks/waits.rs), as Join.tla says it. A step is what the code does with
// the join's lock held, or an atomic operation.
import std.model

enum Task {
    Runs
    Waits
    Unlisting
    Releasing
    Freeing
    Ended
}

enum Owner {
    Has
    Waiting
    Releasing
    Freeing
    Gone
}

enum Ender {
    Idle
    Cancelling
    Finishing
    Freeing
}

type Join = {
    task: Task
    done: Bool
    detached: Bool
    rc: Int
    listed: Bool
    flag: Bool
    waiting: Bool
    owner: Owner
    ender: Ender
    taken: Bool
    freed: Bool
    released: Int
}

// `free_join`, once the task is done: it frees a result nobody took.
fn canFree(join: Join): Bool {
    join.done and not join.freed
}

fn free(join: Join): Join {
    join with { freed: true, released: if join.taken { join.released } else { join.released + 1 } }
}

// A reference let go of: the last one frees the join.
fn released(join: Join): Join {
    join with { rc: join.rc - 1 }
}

fn steps(join: Join, leak: Bool): Array[model.Step[Join]] {
    var next: Array[model.Step[Join]] = []
    match join.task {
        // The task waits, as for a channel; a cancellation ends the wait.
        Task.Runs => {
            if not join.flag {
                next.push(model.step("wait", join with { task: Task.Waits }))
            }
            // `complete`, with the lock: it says what was detached, and wakes who waits.
            next.push(
                model.step(
                    "complete",
                    join with {
                        done: true
                        waiting: false
                        task: if join.detached { Task.Unlisting } else { Task.Ended }
                    },
                ),
            )
        }
        Task.Waits => next.push(model.step("wake", join with { task: Task.Runs }))
        // A detached task leaves the list and lets go of its reference.
        Task.Unlisting => next.push(
            model.step("unlist", join with { listed: false, task: Task.Releasing }),
        )
        Task.Releasing => next.push(
            model.step(
                "task release",
                released(join) with { task: if join.rc == 1 { Task.Freeing } else { Task.Ended } },
            ),
        )
        Task.Freeing if canFree(join) => next.push(
            model.step("task free", free(join) with { task: Task.Ended }),
        )
        _ => {}
    }
    match join.owner {
        Owner.Has => {
            // `tondo_rt_join_detach`.
            if not join.detached {
                next.push(
                    model.step(
                        "detach",
                        match join.done {
                            true => join with { owner: Owner.Releasing }
                            false => join with {
                                detached: true
                                rc: join.rc + 1
                                listed: true
                                owner: Owner.Releasing
                            }
                        },
                    ),
                )
            }
            // `job.wait()`: it waits until the task is done, and takes the result.
            next.push(
                model.step("wait for", join with { owner: Owner.Waiting, waiting: not join.done }),
            )
            // `cancel_join`, with the lock.
            next.push(
                model.step(
                    "cancel",
                    join with {
                        flag: join.flag or not join.done
                        owner: Owner.Waiting
                        waiting: not join.done
                    },
                ),
            )
        }
        Owner.Waiting if join.done => next.push(
            model.step("taken", join with { taken: true, owner: Owner.Releasing }),
        )
        // The owner lets go of its reference.
        Owner.Releasing => next.push(
            model.step(
                "owner release",
                released(join) with { owner: if join.rc == 1 { Owner.Freeing } else { Owner.Gone } },
            ),
        )
        Owner.Freeing if canFree(join) => next.push(
            model.step("owner free", free(join) with { owner: Owner.Gone }),
        )
        _ => {}
    }
    match join.ender {
        // `end_detached`, when `main` returns: it holds what is listed for a moment.
        Ender.Idle if join.listed => next.push(
            model.step("end hold", join with { rc: join.rc + 1, ender: Ender.Cancelling }),
        )
        Ender.Cancelling => next.push(
            model.step(
                "end cancel",
                join with { flag: join.flag or not join.done, ender: Ender.Finishing },
            ),
        )
        // The bug the test reintroduces: `end_detached` lets go of the join
        // without asking whether it was the last one.
        Ender.Finishing if join.done => next.push(
            model.step(
                "end finish",
                released(join) with {
                    ender: if join.rc == 1 and not leak { Ender.Freeing } else { Ender.Idle }
                },
            ),
        )
        Ender.Freeing if canFree(join) => next.push(
            model.step("end free", free(join) with { ender: Ender.Idle }),
        )
        _ => {}
    }
    next
}

fn check(leak: Bool): model.Checked ! model.Violation {
    let start = Join {
        task: Task.Runs
        done: false
        detached: false
        rc: 1
        listed: false
        flag: false
        waiting: false
        owner: Owner.Has
        ender: Ender.Idle
        taken: false
        freed: false
        released: 0
    }
    // What is freed was done, the result is released once at most, and nothing
    // holds what was freed.
    let safe = model.always(
        (join: Join) {
            (not join.freed or join.done) and
                join.released <= 1 and
                not (join.taken and join.released > 0) and
                join.rc >= 0 and
                (not join.freed or join.rc == 0)
        },
        name: "Safe",
    )
    let over = (join: Join) {
        join.task == Task.Ended and join.owner == Owner.Gone and join.ender == Ender.Idle
    }
    // Once every reference is gone the join was freed.
    let noLeak = model.always(
        (join: Join) { not over(join) or (join.rc == 0 and join.freed) },
        name: "NoLeak",
    )
    model.check(start, (join) { steps(join, leak) }, holds: [safe, noLeak], ends: some(over))
}

test joinAsTlcDoes {
    assert(model.expect(check(false)).states == 72)
}

test joinFindsALeak {
    match check(true) {
        ok(_) => panic("a leak went unseen")
        err(broken) => assert(broken.property == some("NoLeak"), "{broken}")
    }
}
