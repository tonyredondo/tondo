// A task woken by one that computes (crates/tondo-runtime/src/tasks:
// `schedule`, `wake_idle` and `take_next` in workers.rs; a worker's last
// look before it sleeps in work.rs; the monitor of foreign.rs). The task
// runs next on its waker's worker, which computes and never waits; another
// worker takes it from there once it is older than NEXT_WAIT, but only a
// worker told to look, or that napped for it, looks at another's next.
// `schedule` tells one that sleeps unless a worker of the domain looks
// already, or one was told within the last 100 µs, which this model leaves
// to chance. With one worker there is no other until the watcher puts one
// beside the held one, which it does only while it watches: the monitor
// starts asleep, with every worker busy and nothing waiting, and only what
// wakes it makes it watch. Time passes in looks of the monitor, and only
// once every thread that can do something has done it: a thread that is
// not run cannot be on time. The watcher's interval before it puts a worker
// beside counts as one look. The woken task must run within two of them;
// that it runs in the end was true before, once its waker stopped
// computing, which here it never does.
//
// What it assumes of the code, read against it on 2026-11-21:
// - The waker computes and never waits: its worker runs nothing else.
// - One other worker at most, which when the task lands may be looking, told
//   or not, counted idle before its last look, asleep, or asleep for a
//   moment; or none, one worker being given.
// - `schedule` tells a worker that sleeps unless one looks (`SEEKING`) or one
//   was told within 100 µs, left here to chance, and wakes the monitor for
//   every task it puts in a next (`watch_next`, the parameter `always`).
// - Only a worker told to look, or that napped, takes from another's next,
//   and only a task older than NEXT_WAIT; one younger makes it nap first.
// - The monitor looks once a millisecond while it watches; with a worker
//   idle it tells one of a task in a next older than NEXT_WAIT
//   (`watch_nexts`); with none, it puts one beside the held worker after the
//   watcher's interval, which counts here as one look. Asleep, it looks at
//   nothing until something wakes it.
// - A thread that can act acts within a millisecond: a process the system
//   stops is no part of the bound.
import std.model

enum Phase {
    /// Before the task is woken: what the idle worker is doing then.
    Choosing
    /// It looks for tasks: at the others' next too when it was told to, or
    /// napped for one.
    Looking
    /// It found nothing and counted itself idle: its last look before it
    /// sleeps.
    Counted
    /// Asleep until it is told to look.
    Asleep
    /// Asleep for NEXT_WAIT, as the one that looks for a task too young to
    /// take.
    Napping
    /// It took the woken task.
    Runs
    /// There is no other worker: one was given, and the watcher puts one
    /// beside the held one only while the monitor watches.
    Absent
}

type State = {
    phase: Phase
    /// Whether it looks at the others' next when it looks.
    peeks: Bool
    /// The domain's worker that looks, as `SEEKING`.
    seeking: Bool
    /// The task is in its waker's next.
    landed: Bool
    /// It landed less than NEXT_WAIT ago.
    young: Bool
    /// Looks of the monitor since it landed, up to one past the bound.
    age: Int
    /// The monitor watches; it sleeps while a worker is idle, or every
    /// worker is busy and nothing waits, until something wakes it.
    watching: Bool
    /// The monitor looked in this millisecond.
    looked: Bool
}

type Fixes = {
    /// A worker's last look before it sleeps sees a task in another's
    /// next, and naps for it.
    sees: Bool
    /// A task landing in a next, with a worker idle, has the monitor watch,
    /// which tells a worker that sleeps to look for a task there longer than
    /// NEXT_WAIT.
    net: Bool
    /// And with no worker idle too: the monitor watches the held worker,
    /// and puts one beside it.
    always: Bool
}

const Bound = 2

fn idle(state: State): Bool {
    state.phase == Phase.Counted or state.phase == Phase.Asleep or state.phase == Phase.Napping
}

/// Told to look: the worker that sleeps, or is about to, looks again, at
/// the others' next too, as the one that looks.
fn told(state: State): State {
    state with { phase: Phase.Looking, peeks: true, seeking: true }
}

fn steps(state: State, fixes: Fixes): Array[model.Step[State]] {
    var next: Array[model.Step[State]] = []
    if state.phase == Phase.Choosing {
        let looking = state with { phase: Phase.Looking }
        next.push(model.step("ends a task and looks", looking))
        next.push(model.step("was told to look", told(state)))
        next.push(model.step("counted idle", state with { phase: Phase.Counted }))
        next.push(model.step("sleeps", state with { phase: Phase.Asleep }))
        next.push(model.step("one worker", state with { phase: Phase.Absent }))
        return next
    }
    // The waker wakes the task, once, at any moment: in its next.
    if not state.landed {
        let wakes = fixes.net and (fixes.always or idle(state))
        let landed = state with { landed: true, young: true, watching: state.watching or wakes }
        // Told, unless a worker looks, or one was told 100 µs ago.
        if idle(state) and not state.seeking {
            next.push(model.step("notify and tell", told(landed)))
        }
        next.push(model.step("notify", landed))
    }
    match state.phase {
        Phase.Looking => {
            if state.landed and state.peeks {
                if state.young {
                    next.push(model.step("nap for it", state with { phase: Phase.Napping }))
                } else {
                    next.push(model.step("take next", state with { phase: Phase.Runs }))
                }
            } else {
                let stops = state with { phase: Phase.Counted, peeks: false, seeking: false }
                next.push(model.step("find nothing", stops))
            }
        }
        Phase.Counted => {
            if fixes.sees and state.landed {
                let naps = state with { phase: Phase.Napping, seeking: true }
                next.push(model.step("nap for it", naps))
            } else {
                next.push(model.step("sleep", state with { phase: Phase.Asleep }))
            }
        }
        _ => {}
    }
    // The monitor's look: it tells the worker that sleeps of a task there
    // for longer than NEXT_WAIT, or, with no other worker, puts one beside
    // the held one, which starts as the one that looks.
    if state.watching and not state.looked and state.landed {
        let looked = state with { looked: true }
        let tells =
            (state.phase == Phase.Asleep or state.phase == Phase.Absent) and
                not state.young and
                not state.seeking
        next.push(model.step("monitor", if tells { told(looked) } else { looked }))
    }
    // A millisecond passes once nothing else can happen in it.
    let settled =
        state.phase == Phase.Asleep or
            state.phase == Phase.Napping or
            state.phase == Phase.Runs or
            state.phase == Phase.Absent
    let monitored = not state.watching or state.looked or not state.landed
    if state.landed and state.phase != Phase.Runs and settled and monitored {
        let woke = if state.phase == Phase.Napping {
            state with { phase: Phase.Looking, peeks: true }
        } else {
            state
        }
        let passed = woke with { young: false, looked: false, age: (state.age + 1).min(Bound + 1) }
        next.push(model.step("tick", passed))
    }
    next
}

fn check(fixes: Fixes): model.Checked ! model.Violation {
    let start = State {
        phase: Phase.Choosing
        peeks: false
        seeking: false
        landed: false
        young: false
        age: 0
        watching: false
        looked: false
    }
    let soon = model.always(
        (state: State) { not state.landed or state.phase == Phase.Runs or state.age <= Bound },
        name: "the woken task runs within two looks of the monitor",
    )
    model.check(start, (state) { steps(state, fixes) }, holds: [soon])
}

// What the code does: a task landing in a next wakes the monitor, idle
// workers or not.
test theWokenTaskRunsSoonWithWhatTheCodeDoes {
    assert(model.expect(check(Fixes { sees: false, net: true, always: true })).states == 24)
}

// The code before the fix: a worker that had looked already, or sleeps when
// the wake is rationed, leaves the task to its waker.
test todayTheWokenTaskWaitsForItsWaker {
    match check(Fixes { sees: false, net: false, always: false }) {
        ok(_) => panic("the woken task ran soon with neither fix")
        err(stopped) => assert(
            stopped.property == "the woken task runs within two looks of the monitor",
        )
    }
}

// Seeing the task before it sleeps is not enough: a worker asleep when it
// lands, with the wake rationed, is told by nobody.
test seeingItBeforeSleepingIsNotEnough {
    match check(Fixes { sees: true, net: false, always: false }) {
        ok(_) => panic("a worker asleep when the task landed took it with no monitor")
        err(stopped) => assert(
            stopped.property == "the woken task runs within two looks of the monitor",
        )
    }
}

// The monitor woken only with a worker idle, as the fix first was: with one
// worker the monitor sleeps on, nothing is put beside the held worker, and
// the task waits for its waker (workers_woken_asleep.to).
test aMonitorWokenOnlyForAnIdleWorkerMissesOneWorker {
    match check(Fixes { sees: false, net: true, always: false }) {
        ok(_) => panic("one worker's woken task ran with the monitor left asleep")
        err(stopped) => assert(
            stopped.property == "the woken task runs within two looks of the monitor",
        )
    }
}

// Seeing the task before sleeping adds nothing the bound needs: it would
// take the task within NEXT_WAIT instead of a look, but the idle worker then
// naps and looks at every handoff of two tasks that hand work to each other
// (docs/decisions.md).
test seeingItBeforeSleepingAddsNothingTheBoundNeeds {
    assert(model.expect(check(Fixes { sees: true, net: true, always: true })).states == 26)
}
