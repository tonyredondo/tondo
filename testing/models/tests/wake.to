// How workers find tasks and go to sleep (crates/tondo-runtime/src/tasks.rs:
// work_until, enqueue, wake_idle, wake_one, step_back), as Wake.tla says it,
// with three workers, the first of them `main`'s. A step here is what the code
// does with the queue's lock held, or one atomic operation.
import models
import std.model

enum Task {
    A
    B
    P
}

enum Phase {
    Spare
    Look
    Run
    WakeIdle
    Asleep
    Retiring
    C
}

type Worker = {
    phase: Phase
    own: model.Bag[Task]
    next: Task?
    current: Task?
    timed: Bool
    seeker: Bool
    replaced: Bool
}

type Pool = {
    workers: Array[Worker]
    queue: model.Bag[Task]
    parked: model.Bag[Task]
    todo: model.Bag[Task]
    seeking: Bool
    surplus: Int
}

// What the model leaves out or puts in, to see that the check finds it.
type Change = {
    // A call of C returns.
    cEnds: Bool
    // A worker that retires wakes one that sleeps.
    retiringWakes: Bool
}

// The tasks of both, once each.
fn union(bag: model.Bag[Task], more: Array[Task]): model.Bag[Task] {
    var all = bag
    for task in more {
        if not all.contains(task) {
            all = all.add(task)
        }
    }
    all
}

fn worker(pool: Pool, w: Int): Worker {
    pool.workers[w]
}

fn changed(pool: Pool, w: Int, after: Worker): Pool {
    pool with { workers: models.replaced(pool.workers, w, after) }
}

fn idle(pool: Pool): Array[Int] {
    pool.workers.enumerate().filter((pair) { pair.1.phase == Phase.Asleep }).map((pair) { pair.0 })
}

// Some worker has tasks of its own.
fn waiting(pool: Pool): Bool {
    pool.workers.any((each) { not each.own.isEmpty() })
}

fn nexts(pool: Pool): Array[Int] {
    pool.workers.enumerate().filter((pair) { pair.1.next.isSome() }).map((pair) { pair.0 })
}

fn work(pool: Pool): Bool {
    not pool.queue.isEmpty() or waiting(pool) or not nexts(pool).isEmpty()
}

// One that sleeps, told to look.
fn told(pool: Pool, v: Int, seeker: Bool): Pool {
    changed(pool, v, worker(pool, v) with { phase: Phase.Look, timed: false, seeker: seeker })
}

// Found in the queue, or taken from another worker's: if it was the one
// looking, it stops, and the next looks if more wait.
fn found(pool: Pool, w: Int, task: Task, more: Bool): Pool {
    let it = worker(pool, w)
    let after = it with {
        current: some(task)
        seeker: false
        phase: if more { Phase.WakeIdle } else { Phase.Run }
    }
    changed(pool, w, after) with { seeking: if it.seeker { false } else { pool.seeking } }
}

fn steps(pool: Pool, change: Change): Array[model.Step[Pool]] {
    var next: Array[model.Step[Pool]] = []
    for (w, it) in pool.workers.enumerate() {
        let free = pool.surplus == 0 or w == 0
        match it.phase {
            Phase.Look => {
                for task in it.own.items() {
                    // A task of its own, which it runs.
                    next.push(
                        model.step(
                            "take own",
                            changed(
                                pool,
                                w,
                                it with {
                                    own: it.own.remove(task)
                                    current: some(task)
                                    phase: Phase.Run
                                },
                            ),
                        ),
                    )
                    // One turn in 61 its own task goes to the queue, for fairness.
                    next.push(
                        model.step(
                            "turn",
                            changed(pool, w, it with { own: it.own.remove(task) }) with {
                                queue: union(pool.queue, [task])
                            },
                        ),
                    )
                }
                // A worker in excess retires, leaving what it had in the queue.
                if w != 0 and pool.surplus > 0 {
                    var left = it.own.items()
                    match it.next {
                        some(task) => left.push(task)
                        none => {}
                    }
                    let after = it with {
                        own: model.Bag([])
                        next: none
                        seeker: false
                        phase: if pool.queue.isEmpty() and left.isEmpty() {
                            Phase.Spare
                        } else {
                            Phase.Retiring
                        }
                    }
                    next.push(
                        model.step(
                            "retire",
                            changed(pool, w, after) with {
                                surplus: pool.surplus - 1
                                queue: union(pool.queue, left)
                                seeking: if it.seeker { false } else { pool.seeking }
                            },
                        ),
                    )
                }
                if free {
                    for task in pool.queue.items() {
                        let rest = pool.queue.remove(task)
                        next.push(
                            model.step(
                                "pop",
                                found(
                                    pool,
                                    w,
                                    task,
                                    not rest.isEmpty() or it.seeker and waiting(pool),
                                ) with { queue: rest },
                            ),
                        )
                    }
                    if pool.queue.isEmpty() {
                        for (v, other) in pool.workers.enumerate() {
                            for task in other.own.items() {
                                if v != w {
                                    let stolen = changed(
                                        pool,
                                        v,
                                        other with { own: other.own.remove(task) },
                                    )
                                    next.push(model.step("steal", found(stolen, w, task, false)))
                                }
                            }
                        }
                    }
                }
                // Nothing found, or tasks too young to take: it counts itself
                // idle, stops looking, and sleeps; for a moment only if tasks
                // wait and nobody looks.
                if pool.queue.isEmpty() and
                    it.own.isEmpty() and
                    it.next.isNone() and
                    not (it.seeker and not nexts(pool).isEmpty()) and
                    free {
                    let stopped = if it.seeker { false } else { pool.seeking }
                    let again = waiting(pool) and not stopped
                    next.push(
                        model.step(
                            "sleep",
                            changed(
                                pool,
                                w,
                                it with { seeker: again, timed: again, phase: Phase.Asleep },
                            ) with { seeking: stopped or again },
                        ),
                    )
                }
                match it.next {
                    some(task) => next.push(
                        model.step(
                            "take next",
                            changed(
                                pool,
                                w,
                                it with { current: some(task), next: none, phase: Phase.Run },
                            ),
                        ),
                    )
                    none => {}
                }
                // Only a worker told to look takes the next of another.
                if it.seeker {
                    for v in nexts(pool) {
                        if v != w {
                            let other = worker(pool, v)
                            match other.next {
                                some(task) => next.push(
                                    model.step(
                                        "take other",
                                        found(
                                            changed(pool, v, other with { next: none }),
                                            w,
                                            task,
                                            false,
                                        ),
                                    ),
                                )
                                none => {}
                            }
                        }
                    }
                }
            }
            // What it leaves is another's: it wakes one that sleeps.
            Phase.Retiring => {
                let sleeping = if change.retiringWakes { idle(pool) } else { [] }
                let spare = changed(pool, w, it with { phase: Phase.Spare })
                for v in sleeping {
                    next.push(model.step("retiring", told(spare, v, worker(pool, v).seeker)))
                }
                if sleeping.isEmpty() {
                    next.push(model.step("retiring", spare))
                }
            }
            // The end of a wait for a moment.
            Phase.Asleep if it.timed => next.push(
                model.step("timeout", changed(pool, w, it with { timed: false, phase: Phase.Look })),
            )
            // `wake_idle`, whose worker then goes on.
            Phase.WakeIdle => {
                let runs = changed(pool, w, it with { phase: Phase.Run })
                let sleeping = if not pool.seeking { idle(pool) } else { [] }
                for v in sleeping {
                    next.push(model.step("wake idle", told(runs, v, true) with { seeking: true }))
                }
                if sleeping.isEmpty() {
                    next.push(model.step("wake idle", runs))
                }
            }
            Phase.Run => {
                // A task starts another: in its worker's queue; the first that waits wakes.
                for task in pool.todo.items() {
                    let after = it with {
                        own: it.own.add(task)
                        phase: if it.own.isEmpty() { Phase.WakeIdle } else { Phase.Run }
                    }
                    next.push(
                        model.step(
                            "spawn",
                            changed(pool, w, after) with { todo: pool.todo.remove(task) },
                        ),
                    )
                }
                // A task that runs wakes another, which runs next on its worker,
                // and the one there goes to the worker's queue. Waking another
                // worker is rationed.
                for task in pool.parked.items() {
                    let own = match it.next {
                        some(before) => it.own.add(before)
                        none => it.own
                    }
                    let woke = it with { next: some(task), own: own }
                    next.push(
                        model.step(
                            "notify",
                            changed(pool, w, woke with { phase: Phase.WakeIdle }) with {
                                parked: pool.parked.remove(task)
                            },
                        ),
                    )
                    next.push(
                        model.step(
                            "notify",
                            changed(pool, w, woke) with { parked: pool.parked.remove(task) },
                        ),
                    )
                }
                next.push(
                    model.step(
                        "finish",
                        changed(pool, w, it with { current: none, phase: Phase.Look }),
                    ),
                )
                // A long call of C, or a task a tool holds: the worker runs nothing else.
                next.push(model.step("enter C", changed(pool, w, it with { phase: Phase.C })))
            }
            Phase.C => {
                // The monitor starts another when tasks wait and nobody is
                // idle, which is told to look.
                if not it.replaced and idle(pool).isEmpty() and work(pool) {
                    for (v, other) in pool.workers.enumerate() {
                        if other.phase == Phase.Spare {
                            let replaced = changed(pool, w, it with { replaced: true })
                            next.push(
                                model.step(
                                    "monitor",
                                    changed(
                                        replaced,
                                        v,
                                        other with { phase: Phase.Look, seeker: not pool.seeking },
                                    ) with { seeking: true },
                                ),
                            )
                        }
                    }
                }
                // And one that sleeps is told to look, even if it replaced this one already.
                if not pool.seeking and work(pool) {
                    for v in idle(pool) {
                        next.push(
                            model.step("monitor wakes", told(pool, v, true) with { seeking: true }),
                        )
                    }
                }
                // The call returns: a worker that was replaced makes one retire, and wakes one.
                if change.cEnds {
                    let back = changed(pool, w, it with { replaced: false, phase: Phase.Run }) with {
                        surplus: if it.replaced { pool.surplus + 1 } else { pool.surplus }
                    }
                    let sleeping = if it.replaced { idle(pool) } else { [] }
                    for v in sleeping {
                        next.push(model.step("leave C", told(back, v, worker(pool, v).seeker)))
                    }
                    if sleeping.isEmpty() {
                        next.push(model.step("leave C", back))
                    }
                }
            }
            _ => {}
        }
    }
    next
}

fn check(change: Change): model.Checked ! model.Violation {
    let spare = Worker {
        phase: Phase.Spare
        own: model.Bag([])
        next: none
        current: none
        timed: false
        seeker: false
        replaced: false
    }
    let start = Pool {
        workers: ([spare with { phase: Phase.Look }, spare, spare])
        queue: model.Bag([Task.A])
        parked: model.Bag([Task.P])
        todo: model.Bag([Task.B])
        seeking: false
        surplus: 0
    }
    // A task runs on one worker at a time.
    let oneWorker = model.always(
        (pool: Pool) {
            let workers = pool.workers
            [Task.A, Task.B, Task.P].all(
                (task) { workers.count((each) { each.current == some(task) }) <= 1 },
            )
        },
        name: "OneWorker",
    )
    let allDone = (pool: Pool) {
        pool.queue.isEmpty() and
            nexts(pool).isEmpty() and
            not waiting(pool) and
            pool.workers.all(
                (each) { each.current.isNone() or not change.cEnds and each.phase == Phase.C },
            )
    }
    model.check(start, (pool) { steps(pool, change) }, holds: [oneWorker], ends: some(allDone))
}

test wakeAsTlcDoes {
    assert(model.expect(check(Change { cEnds: true, retiringWakes: true })).states == 1806)
}

// As WakeInC.cfg: a call of C that never returns.
test wakeInCAsTlcDoes {
    assert(model.expect(check(Change { cEnds: false, retiringWakes: true })).states == 170)
}

// Without the wake of a worker that retires, a task stays in the queue with
// the last worker asleep.
test wakeFindsATaskNobodyRuns {
    match check(Change { cEnds: true, retiringWakes: false }) {
        ok(_) => panic("a task nobody runs went unseen")
        err(broken) => assert(broken.what.contains("nothing can follow"))
    }
}
