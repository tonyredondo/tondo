// How a task waits (crates/tondo-runtime/src/tasks.rs: park, run, notify_with),
// as Park.tla says it: it looks at what it waits for, parks, and a worker
// finishes parking it once it is off its stack, while another task may notify
// it at any of those steps.
import std.model

enum State {
    Running
    Parking
    Parked
    Notified
}

enum Pc {
    Check
    Park
    Out
    Parked
    Queued
    Done
}

type Task = {
    state: State
    pc: Pc
    event: Bool
    left: Int
    queued: Bool
}

fn steps(task: Task, notifyOnParking: Bool): Array[model.Step[Task]] {
    var next: Array[model.Step[Task]] = []
    let step = (name: String, after: Task) { model.Step { name, state: after } }
    match task.pc {
        // What it waits for came: it is done. Otherwise it goes to park.
        Pc.Check => next.push(
            step("check", task with { pc: if task.event { Pc.Done } else { Pc.Park } }),
        )
        // `park`: RUNNING to PARKING, or a notification came and it looks again.
        Pc.Park => next.push(
            match task.state {
                State.Running => step("park", task with { state: State.Parking, pc: Pc.Out })
                _ => step("park", task with { state: State.Running, pc: Pc.Check })
            },
        )
        // `run`, on its worker: PARKING to PARKED, or notified meanwhile, and it runs.
        Pc.Out => next.push(
            match task.state {
                State.Parking => step("out", task with { state: State.Parked, pc: Pc.Parked })
                _ => step("out", task with { state: State.Running, pc: Pc.Queued, queued: true })
            },
        )
        // A worker takes it from the queue. Done, it stays.
        Pc.Parked if task.queued => next.push(
            step("resume", task with { queued: false, pc: Pc.Check }),
        )
        Pc.Queued if task.queued => next.push(
            step("resume", task with { queued: false, pc: Pc.Check }),
        )
        _ => {}
    }
    // `notify_with`, after what it waits for came.
    if task.left > 0 {
        let notified = task with { left: task.left - 1, event: true }
        next.push(
            step(
                "notify",
                match task.state {
                    State.Parked => notified with { state: State.Running, queued: true }
                    State.Notified => notified
                    // The bug Park.tla holds the code to: a task notified while it
                    // parks is not woken.
                    State.Parking if notifyOnParking => notified
                    _ => notified with { state: State.Notified }
                },
            ),
        )
    }
    next
}

fn check(notifyOnParking: Bool): model.Checked ! model.Violation {
    let start = Task { state: State.Running, pc: Pc.Check, event: false, left: 3, queued: false }
    // A task is in the queue only once it can run.
    let queued = model.always(
        (task: Task) {
            not task.queued or task.state == State.Running or task.state == State.Notified
        },
        name: "Queued",
    )
    // Parked with what it waits for there, and nobody to wake it, is a lost wake.
    let lost = model.always(
        (task: Task) {
            not (task.pc == Pc.Parked and
                task.state == State.Parked and
                task.event and
                task.left == 0)
        },
        name: "NoLostWake",
    )
    model.check(
        start,
        (task) { steps(task, notifyOnParking) },
        holds: [queued, lost],
        ends: some((task: Task) { task.pc == Pc.Done }),
    )
}

// A task notified gets what it waits for, when its own steps are not put off
// for ever: no wake is lost.
test aNotifiedTaskIsDone {
    let start = Task { state: State.Running, pc: Pc.Check, event: false, left: 3, queued: false }
    let done = model.leadsTo(
        (task: Task) { task.event },
        (task: Task) { task.pc == Pc.Done },
        name: "a notified task is done",
    )
    let own = ["check", "park", "out", "resume"].map((name) { model.weak(name) })
    model.expect(
        model.check(
            start,
            (task) { steps(task, false) },
            holds: [done],
            fair: own,
            ends: some((task: Task) { task.pc == Pc.Done }),
        ),
    )
}

test parkAsTlcDoes {
    match check(false) {
        ok(checked) => assert(checked.states == 30)
        err(broken) => panic("{broken}")
    }
}

test parkFindsALostWake {
    assert(check(true).isErr())
}
