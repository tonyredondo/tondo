// The fuzz tests of the standard library's parsers, in tests/: no input
// panics, and what a format writes reads back the same (docs/refactor.md,
// 0.6). `tondo test` runs their seeds and the inputs in fuzz/ that failed
// before; the Nightly searches with `--fuzz`. This is what they write and
// read back: a value of every kind a format holds.

pub enum Kind {
    Plain
    Tagged(String)
    Pair(Int, Int)
}

pub type Sample = {
    name: String
    count: Int
    ratio: Float
    flag: Bool
    tags: Array[String]
    scores: Map[String, Int]
    note: String?
    kind: Kind
}

pub fn sample(): Sample {
    Sample {
        name: "ada"
        count: -3
        ratio: 0.25
        flag: true
        tags: ["a", "b c", ""]
        scores: ["x": 1, "y z": -2]
        note: "hi"
        kind: Kind.Pair(1, 2)
    }
}

fn main() {}

// What the GraphQL search asks of a schema: a query with fields, methods
// with arguments, an optional result and a list.

pub type Book = {
    id: Int
    title: String
    pages: Int
    tags: Array[String]
}

pub type Library = {
    books: Array[Book]
}

/// The books whose title has the text, at most `limit`.
pub fn Library.search(self, text: String, limit: Int = 10): Array[Book] {
    self.books.filter(book => book.title.contains(text)).slice(0, limit.max(0)) ?? []
}

/// The book of an id.
pub fn Library.book(self, id: Int): Book? {
    self.books.find(book => book.id == id)
}
