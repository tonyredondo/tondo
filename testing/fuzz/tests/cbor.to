import std.cbor
import std.testing

// Blind inside its reader: CBOR is read by native code (runtime/cbor.rs),
// which has no counters, so the search sees only the Tondo around it; the
// coverage it prints is the share of the build's Tondo code, the library's
// included, that its inputs reached, not of the reader.

test cborReadsAnyBytes {
    testing.fuzz(
        "parse",
        [cbor.encode(sample()), []],
        (bytes: Array[Byte]) {
            _ = cbor.parse(bytes)
        },
    )?
}

test cborReadsBackWhatItWrites {
    testing.fuzz(
        "roundTrip",
        [sample()],
        (value: Sample) {
            assert(cbor.decode[Sample](cbor.encode(value)) == ok(value))
            assert(cbor.decode[Sample](cbor.encode(value, deterministic: true)) == ok(value))
        },
    )?
}
