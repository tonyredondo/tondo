import std.template
import std.testing

test templateReadsAnySource {
    let seeds = ["Hello {{{{ name }}}}!", "{{% for tag in tags %}}{{{{ tag }}}}{{% end %}}", ""]
    testing.fuzz(
        "source",
        seeds,
        (source: String) {
            for each in [template.Set.text(), template.Set.html()] {
                var set = each
                // A range, a width or a precision asks for as much work as
                // its numbers say, which is no bug: what has one or a
                // number of seven digits is read but not rendered.
                if set.add("page", source).isOk() and
                    not source.contains("..") and
                    not large(source) {
                    _ = set.render("page", sample())
                }
            }
        },
    )?
}

/// Whether a text has a number of seven digits or more.
fn large(text: String): Bool {
    var digits = 0
    for c in text.chars() {
        digits = if c.isDigit() { digits + 1 } else { 0 }
        if digits >= 7 {
            return true
        }
    }
    false
}
