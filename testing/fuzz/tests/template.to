import std.template
import std.testing

test templateReadsAnySource {
    let seeds = ["Hello {{{{ name }}}}!", "{{% for tag in tags %}}{{{{ tag }}}}{{% end %}}", ""]
    testing.fuzz(
        "source",
        seeds,
        (source: String) {
            for each in [template.Set.text(), template.Set.html()] {
                var set = each
                // A range asks for as much work as its numbers say, which
                // is no bug: what has one is read but not rendered.
                if set.add("page", source).isOk() and not source.contains("..") {
                    _ = set.render("page", sample())
                }
            }
        },
    )?
}
