import std.testing
import std.yaml

// Blind inside its reader: YAML is read by native code (runtime/yaml.rs),
// which has no counters, so the search sees only the Tondo around it; the
// coverage it prints is the share of the build's Tondo code, the library's
// included, that its inputs reached, not of the reader.

test yamlReadsAnyText {
    let seeds = [
        "a: [1, 2.5, true, ~, 'x']\nb:\n  - c: |\n      text\n",
        "--- &a\n- *a\n",
        "{{x: y}}",
        "",
    ]
    testing.fuzz(
        "parse",
        seeds,
        (text: String) {
            _ = yaml.parseAll(text)
        },
    )?
}

test yamlReadsBackWhatItWrites {
    testing.fuzz(
        "roundTrip",
        [sample()],
        (value: Sample) { assert(yaml.decode[Sample](yaml.encode(value)) == ok(value)) },
    )?
}
