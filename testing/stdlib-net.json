{
  "format": "tondo-stdlib-owner-contract/1",
  "owner": "std.net",
  "parent_owner": "std",
  "edition": "0.1",
  "phase": "STD-0.1B",
  "task": "STD-NET-001",
  "status": "contract-locked",
  "contract": "docs/contracts/stdlib-net.md",
  "spec": "TONDO_STANDARD_LIBRARY_SPEC.md",
  "language_spec": "TONDO_LANGUAGE_SPEC.md",
  "layer": "B0",
  "kind": "runtime-facing",
  "target": "tondo-vm-hosted-and-native",
  "capabilities": {
    "required": ["network"],
    "optional": ["clock"],
    "threads": "forbidden-as-public-requirement",
    "ambient_lookup": false,
    "import_effect": "none",
    "missing_network": "static-capability-error",
    "deadline_without_clock": "static-capability-error"
  },
  "host": {
    "status": "required-after-native-gate",
    "reason": "std.net needs target-declared resolver, socket readiness, bounded host buffers and a declared TLS provider; it must not block cooperative workers or read ambient proxy, certificate or retry policy"
  },
  "surface": {
    "types": [
      "HostName",
      "IpAddress",
      "SocketAddress",
      "NetLimits",
      "NetOptions",
      "TcpListener",
      "TcpStream",
      "TcpReadHalf",
      "TcpWriteHalf",
      "UdpSocket",
      "Datagram",
      "TlsConfig",
      "TlsStream",
      "TlsReadHalf",
      "TlsWriteHalf",
      "NetError = { InvalidHostName, InvalidAddress, InvalidPort, InvalidLimit, InvalidDeadline, ResourceLimit, ResolveFailed, ConnectionRefused, ConnectionReset, NotConnected, AddressInUse, Unreachable, DatagramTooLarge, Timeout, Cancelled, Closed, CapabilityMissing, Host }",
      "TlsError = { InvalidServerName, InvalidCertificate, CertificateRejected, HandshakeFailed, Unsupported, ResourceLimit, Timeout, Cancelled, Closed, Transport(NetError) }",
      "TlsVerification = { PlatformRoots, PinnedCertificate(Bytes) }",
      "Shutdown = { Read, Write, Both }"
    ],
    "signatures": [
      {"id":"hostname","signature":"pub fn hostName(text: String): HostName ! NetError","kind":"hostname-validation","effect":"sync"},
      {"id":"ip-parse","signature":"pub fn IpAddress.parse(text: String): IpAddress ! NetError","kind":"address-parse","effect":"sync"},
      {"id":"socket-address","signature":"pub fn socketAddress(ip: IpAddress, port: Int): SocketAddress ! NetError","kind":"address-constructor","effect":"sync"},
      {"id":"limits-create","signature":"pub fn NetLimits.create(maxRead: Int, maxDatagram: Int, maxResults: Int): NetLimits ! NetError","kind":"limit-constructor","effect":"sync"},
      {"id":"limits-defaults","signature":"pub fn NetLimits.defaults(): NetLimits","kind":"fixed-default-limits","effect":"sync"},
      {"id":"options","signature":"pub fn options(deadline: Instant?, limits: NetLimits): NetOptions ! NetError","kind":"operation-options","effect":"sync"},
      {"id":"resolve","signature":"pub fn resolve(host: HostName, port: Int, options: NetOptions): Array[SocketAddress] ! NetError suspends","kind":"dns-resolution","effect":"suspends"},
      {"id":"connect","signature":"pub fn connect(address: SocketAddress, options: NetOptions): TcpStream ! NetError suspends","kind":"tcp-connect","effect":"suspends"},
      {"id":"listen","signature":"pub fn listen(address: SocketAddress, backlog: Int): TcpListener ! NetError","kind":"tcp-listener","effect":"sync"},
      {"id":"listener-accept","signature":"pub fn TcpListener.accept(ref self, options: NetOptions): TcpStream ! NetError selectable","kind":"tcp-accept","effect":"selectable"},
      {"id":"listener-close","signature":"pub fn TcpListener.close(self): Unit","kind":"tcp-listener-terminal","effect":"sync"},
      {"id":"tcp-split","signature":"pub fn TcpStream.split(self): (TcpReadHalf, TcpWriteHalf)","kind":"tcp-half-split","effect":"sync"},
      {"id":"tcp-local","signature":"pub fn TcpStream.localAddress(self): SocketAddress ! NetError","kind":"tcp-local-address","effect":"sync"},
      {"id":"tcp-peer","signature":"pub fn TcpStream.peerAddress(self): SocketAddress ! NetError","kind":"tcp-peer-address","effect":"sync"},
      {"id":"tcp-shutdown","signature":"pub fn TcpStream.shutdown(ref self, how: Shutdown, options: NetOptions): Unit ! NetError suspends","kind":"tcp-stream-shutdown","effect":"suspends"},
      {"id":"tcp-close","signature":"pub fn TcpStream.close(self): Unit","kind":"tcp-stream-terminal","effect":"sync"},
      {"id":"tcp-read","signature":"pub fn TcpReadHalf.read(ref self, max: Int, options: NetOptions): ReadResult ! NetError selectable","kind":"tcp-read","effect":"selectable"},
      {"id":"tcp-read-close","signature":"pub fn TcpReadHalf.close(self): Unit","kind":"tcp-read-half-terminal","effect":"sync"},
      {"id":"tcp-write","signature":"pub fn TcpWriteHalf.write(ref self, data: Bytes, options: NetOptions): Int ! NetError suspends","kind":"tcp-write","effect":"suspends"},
      {"id":"tcp-flush","signature":"pub fn TcpWriteHalf.flush(ref self, options: NetOptions): Unit ! NetError suspends","kind":"tcp-flush","effect":"suspends"},
      {"id":"tcp-half-shutdown","signature":"pub fn TcpWriteHalf.shutdown(ref self, options: NetOptions): Unit ! NetError suspends","kind":"tcp-half-shutdown","effect":"suspends"},
      {"id":"tcp-write-close","signature":"pub fn TcpWriteHalf.close(self): Unit","kind":"tcp-write-half-terminal","effect":"sync"},
      {"id":"udp-bind","signature":"pub fn bind(address: SocketAddress): UdpSocket ! NetError","kind":"udp-bind","effect":"sync"},
      {"id":"udp-send","signature":"pub fn UdpSocket.sendTo(ref self, data: Bytes, destination: SocketAddress, options: NetOptions): Unit ! NetError suspends","kind":"udp-send","effect":"suspends"},
      {"id":"udp-receive","signature":"pub fn UdpSocket.receiveFrom(ref self, options: NetOptions): Datagram ! NetError selectable","kind":"udp-receive","effect":"selectable"},
      {"id":"udp-local","signature":"pub fn UdpSocket.localAddress(self): SocketAddress ! NetError","kind":"udp-local-address","effect":"sync"},
      {"id":"udp-close","signature":"pub fn UdpSocket.close(self): Unit","kind":"udp-terminal","effect":"sync"},
      {"id":"datagram-bytes","signature":"pub fn Datagram.bytes(self): Bytes","kind":"datagram-bytes","effect":"sync"},
      {"id":"datagram-source","signature":"pub fn Datagram.source(self): SocketAddress","kind":"datagram-source","effect":"sync"},
      {"id":"tls-config","signature":"pub fn tlsConfig(verification: TlsVerification): TlsConfig ! TlsError","kind":"tls-config","effect":"sync"},
      {"id":"tls-connect","signature":"pub fn TlsStream.connect(stream: TcpStream, server: HostName, config: TlsConfig, options: NetOptions): TlsStream ! TlsError suspends","kind":"tls-handshake","effect":"suspends"},
      {"id":"tls-split","signature":"pub fn TlsStream.split(self): (TlsReadHalf, TlsWriteHalf)","kind":"tls-half-split","effect":"sync"},
      {"id":"tls-close","signature":"pub fn TlsStream.close(self): Unit","kind":"tls-stream-terminal","effect":"sync"},
      {"id":"tls-read","signature":"pub fn TlsReadHalf.read(ref self, max: Int, options: NetOptions): ReadResult ! TlsError suspends","kind":"tls-read","effect":"suspends"},
      {"id":"tls-read-close","signature":"pub fn TlsReadHalf.close(self): Unit","kind":"tls-read-half-terminal","effect":"sync"},
      {"id":"tls-write","signature":"pub fn TlsWriteHalf.write(ref self, data: Bytes, options: NetOptions): Int ! TlsError suspends","kind":"tls-write","effect":"suspends"},
      {"id":"tls-flush","signature":"pub fn TlsWriteHalf.flush(ref self, options: NetOptions): Unit ! TlsError suspends","kind":"tls-flush","effect":"suspends"},
      {"id":"tls-shutdown","signature":"pub fn TlsWriteHalf.shutdown(ref self, options: NetOptions): Unit ! TlsError suspends","kind":"tls-half-shutdown","effect":"suspends"},
      {"id":"tls-write-close","signature":"pub fn TlsWriteHalf.close(self): Unit","kind":"tls-write-half-terminal","effect":"sync"}
    ],
    "direct_call_waits": true,
    "explicit_await_direct_call": "forbidden",
    "explicit_await_join": "required",
    "inference_by_name": false,
    "bodyless_requires_effect": true,
    "bodyful_inference": "allowed",
    "selectable_operations": ["listener-accept", "tcp-read", "udp-receive"]
  },
  "ownership": {
    "address_values_copy": true,
    "options_copy": true,
    "tls_config_copy": true,
    "listener_affine": true,
    "stream_affine": true,
    "socket_affine": true,
    "handles_copy": false,
    "handles_clone": false,
    "handles_share": false,
    "handles_send": true,
    "split_consumes_stream": true,
    "half_affine": true,
    "last_half_closes_transport": true,
    "terminal_close": "explicit-close-or-static-scope-error",
    "implicit_drop": "compile-error",
    "post_close_use": "compile-error",
    "select_loser_resource": "resource-remains-owned-and-unconsumed",
    "cancelled_read_resource": "no-byte-or-datagram-removed-before-commit",
    "tls_transport_on_handshake_failure": "closed-and-reaped"
  },
  "limits": {
    "max_read": "positive-finite",
    "max_datagram": "positive-finite",
    "max_results": "positive-finite",
    "port": "0..65535; zero-bind-only",
    "backlog": "positive-finite",
    "hostname_bytes": 253,
    "hostname_label_bytes": 63,
    "no_unbounded_tondo_buffer": true,
    "invalid_limit": "NetError.InvalidLimit",
    "resource_exhaustion": "NetError.ResourceLimit"
  },
  "options": {
    "deadline": "explicit-monotonic-Instant-or-none",
    "deadline_requires": "clock-capability",
    "deadline_scope": "operation-queue-dns-connect-handshake-or-io",
    "cleanup_after_deadline": "required-before-publishing-timeout",
    "ambient_timeout": "forbidden",
    "ambient_proxy": "forbidden",
    "ambient_retry": "forbidden",
    "default_limits": "fixed-target-declared-values",
    "foreign_clock_domain": "NetError.InvalidDeadline"
  },
  "dns": {
    "operation": "explicit-resolve-only",
    "connect_resolves": false,
    "provider_order": "preserved-after-bytewise-deduplication",
    "max_results": "NetLimits.maxResults",
    "automatic_retry": false,
    "happy_eyeballs": "caller-composed-with-spawn-and-Group",
    "environment_lookup": false,
    "sealed_conformance_provider": true,
    "cancel_before_commit": "no-address-result-published"
  },
  "tcp": {
    "connect_single_address": true,
    "listener_accept_selectable": true,
    "read_partial": true,
    "read_eof": "ReadResult.Eof",
    "read_max": "NetLimits.maxRead",
    "write_partial_count": true,
    "write_unknown_partial_error": false,
    "write_unbounded_buffer": false,
    "split": "one-affine-read-half-and-one-affine-write-half",
    "half_close": "explicit-write-shutdown",
    "losing_select_accepts": "no-connection-removed",
    "reset": "NetError.ConnectionReset"
  },
  "udp": {
    "send_atomic_datagram": true,
    "receive_one_datagram": true,
    "receive_selectable": true,
    "max_datagram": "NetLimits.maxDatagram",
    "oversize": "DatagramTooLarge-and-no-truncation",
    "delivery": "no-order-no-uniqueness-no-delivery-guarantee",
    "multicast": "excluded"
  },
  "tls": {
    "provider": "target-declared-and-hash-pinned",
    "verification_default": "PlatformRoots",
    "insecure_mode": false,
    "plaintext_downgrade": false,
    "server_name_verification": true,
    "pinned_certificate_input": "explicit-DER-bytes",
    "handshake_publishes_stream_after_success": true,
    "handshake_failure_closes_transport": true,
    "renegotiation": "forbidden",
    "split": "same-affine-half-contract-as-tcp",
    "close_notify": "best-effort-before-writer-shutdown"
  },
  "cancellation": {
    "all_suspendible_operations": true,
    "waiting_accept": "unregister-before-commit",
    "waiting_read": "unregister-before-byte-consume",
    "waiting_receive": "unregister-before-datagram-consume",
    "connect_or_resolve": "close-provider-state-before-return",
    "tls_handshake": "close-transport-before-return",
    "priority": ["argument", "cancel", "timeout", "host", "normal"],
    "cleanup_before_scope_exit": true,
    "no_detached_host_resources": true
  },
  "diagnostics": {
    "event_namespace": "std.net",
    "events": [
      "resolve.start", "resolve.finish", "connect.start", "connect.finish",
      "listener.accept.prepare", "listener.accept.commit", "listener.accept.rollback",
      "stream.read", "stream.write", "stream.shutdown", "udp.receive", "udp.send",
      "tls.handshake", "resource.timeout", "resource.cancel", "resource.close"
    ],
    "required_fields": ["run_id", "task_id", "operation_id", "resource_id", "event_sequence", "state", "source_revision", "target"],
    "payloads": "omitted-by-default",
    "addresses_and_bytes": "omitted-by-default",
    "source_revision": "required",
    "runtime_hooks_public": false
  },
  "portability": {
    "common": ["ownership", "partial-io", "deadlines", "cancellation", "limits", "typed-errors", "no-import-effects"],
    "target_declared": ["ipv4", "ipv6", "resolver", "readiness", "tls-provider", "trust-bundle", "socket-limits"],
    "excluded": ["unix-domain", "quic", "http", "websocket", "rpc", "grpc", "raw-sockets", "multicast", "proxy-autodiscovery"]
  },
  "exclusions": [
    "connectAsync", "acceptAsync", "NetFuture", "SocketPoller", "stdlib-select",
    "public-polling", "readiness-callback", "implicit-retry", "implicit-happy-eyeballs",
    "unbounded-buffer", "insecure-tls", "plaintext-downgrade", "environment-resolver",
    "HttpClient", "RpcClient", "Quic", "WebSocket", "UnixSocket", "RawSocket"
  ],
  "negative_cases": [
    "network-import-without-capability", "deadline-without-clock", "empty-hostname",
    "hostname-with-nul", "hostname-over-limit", "invalid-ip", "invalid-port",
    "connect-port-zero", "negative-limit", "zero-limit", "unrepresentable-limit",
    "ambient-default-limits", "ambient-proxy", "implicit-dns-in-connect",
    "implicit-retry", "listener-zero-backlog", "listener-is-copyable", "stream-is-copyable",
    "implicit-stream-clone", "split-reuses-stream", "read-zero-max", "read-loser-consumes-bytes",
    "accept-loser-consumes-connection", "receive-loser-consumes-datagram", "write-hides-partial-count",
    "udp-truncates-datagram", "unbounded-network-buffer",
    "handle-drop-without-close", "use-after-close", "cancel-leaks-descriptor",
    "timeout-skips-cleanup", "tls-insecure-default", "tls-plaintext-downgrade",
    "tls-bypasses-server-name", "tls-publishes-before-handshake", "tls-exposes-certificate-detail",
    "tls-renegotiation", "raw-socket-public-api", "stdlib-select-api", "diagnostics-publish-payloads"
  ],
  "implementation": {
    "status": "pending-after-native-gate",
    "public_api_promoted": false,
    "host": "required-after-native-gate",
    "required_follow_ups": [
