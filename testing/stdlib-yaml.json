    "finish_required": true,
    "error_state": "terminal",
    "post_finish": "YamlError.Closed",
    "resource_limit_write": "atomic-no-state-change",
    "partial_tondo_result": "never-published",
    "stack": "explicit-bounded-frames"
  },
  "ownership": {
    "value_owner": "YamlValue",
    "options_copy": true,
    "reader_writer_affine": true,
    "reader_writer_copy": false,
    "reader_writer_share": false,
    "reader_writer_send": true,
    "view_borrow": "ends-at-reader-advance-or-operation-return",
    "alias_storage": "logical-copy-no-shared-mutable-memory",
    "input_alias": "never-retained"
  },
  "limits": [
    {"id":"max_input_bytes","unit":"bytes","scope":"whole-input","source":"YamlLimits.maxInputBytes"},
    {"id":"max_documents","unit":"documents","scope":"stream","source":"YamlLimits.maxDocuments"},
