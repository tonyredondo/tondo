  "spec": "TONDO_STANDARD_LIBRARY_SPEC.md",
  "language_spec": "TONDO_LANGUAGE_SPEC.md",
  "layer": "B7",
  "kind": "runtime-facing",
  "target": "tondo-vm-hosted-and-native",
  "dependencies": ["std.serialization", "std.io", "std.bytes", "std.encoding"],
  "capabilities": {
    "required": [],
    "optional": [],
    "import_effect": "none",
    "ambient_lookup": false,
    "forbidden": [
      "ambient-host",
      "environment",
      "filesystem",
      "network",
      "process",
      "clock",
      "civil-clock",
      "entropy",
      "threads",
      "dynamic-linking",
      "runtime-value-reflection",
      "external-includes",
      "code-execution"
    ]
  },
  "wire": {
    "yaml_version": "1.2",
    "schema": "core",
    "encoding": "UTF-8",
    "indentation": "spaces-only",
    "document_markers": ["---", "..."],
    "block_collections": true,
    "flow_collections": true,
    "quoted_scalars": ["single", "double"],
    "block_scalars": ["literal", "folded"],
    "directives": "YAML-1.2-only-no-TAG",
    "comments": "discarded",
    "mapping_keys": "text-only",
    "duplicate_keys": "reject",
    "merge_key": "reject",
    "implicit_timestamp": "text",
    "yaml_1_1_booleans": "text",
    "non_finite_numbers": "reject"
  },
  "tags": {
    "accepted_short": ["!!null", "!!bool", "!!int", "!!float", "!!str", "!!binary", "!!seq", "!!map"],
    "accepted_full_prefix": "tag:yaml.org,2002:",
    "custom": "reject",
    "local": "reject",
    "timestamp": "reject",
    "binary": "standard-base64-required-padding",
    "compatibility": "tag-must-match-node"
  },
  "aliases": {
    "accepted": true,
    "scope": "single-document",
    "forward_reference": "reject",
    "redefinition": "reject",
    "cycles": "reject",
    "dynamic_model": "logical-copy",
    "preserve_identity": false,
    "merge_key": "reject",
    "max_aliases_source": "YamlLimits.maxAliases",
    "max_expanded_nodes_source": "YamlLimits.maxExpandedNodes",
    "anchor_name": "ASCII-letter-or-underscore-then-ASCII-letter-digit-underscore-hyphen",
    "anchor_name_limit_source": "YamlLimits.maxAnchorNameBytes"
  },
  "surface": {
    "types": [
      "Yaml",
      "YamlValue",
      "YamlValueView",
      "YamlTag",
      "YamlScalar",
      "YamlEvent",
      "YamlLimits",
      "YamlOptions",
      "YamlPathSegment",
      "YamlErrorKind",
      "YamlError",
      "YamlReader",
      "YamlWriter"
    ],
    "signatures": [
      {"id":"limits-defaults","signature":"pub fn YamlLimits.defaults(): YamlLimits","kind":"limits","effect":"pure"},
      {"id":"limits-create","signature":"pub fn YamlLimits.create(maxInputBytes: Int, maxDocuments: Int, maxDepth: Int, maxNodes: Int, maxExpandedNodes: Int, maxAliases: Int, maxScalarBytes: Int, maxCollectionEntries: Int, maxAnchorNameBytes: Int): YamlLimits ! YamlError","kind":"limits","effect":"pure"},
      {"id":"options-defaults","signature":"pub fn YamlOptions.defaults(): YamlOptions","kind":"policy","effect":"pure"},
      {"id":"options-create","signature":"pub fn YamlOptions.create(limits: YamlLimits): YamlOptions","kind":"policy","effect":"pure"},
      {"id":"parse","signature":"pub fn parse(input: Bytes, options: YamlOptions): YamlValue ! YamlError","kind":"materialized-parse","effect":"pure"},
      {"id":"parse-all","signature":"pub fn parseAll(input: Bytes, options: YamlOptions): Array[YamlValue] ! YamlError","kind":"materialized-parse-stream","effect":"pure"},
      {"id":"parse-view","signature":"pub fn parseView(input: Bytes, options: YamlOptions): YamlValueView ! YamlError","kind":"borrowed-parse","effect":"pure"},
      {"id":"validate","signature":"pub fn validate(input: Bytes, options: YamlOptions): Unit ! YamlError","kind":"validation","effect":"pure"},
      {"id":"decode","signature":"pub fn decode[T: Decode[Yaml]](input: Bytes, options: YamlOptions): T ! YamlError","kind":"typed-decode","effect":"pure"},
      {"id":"decode-all","signature":"pub fn decodeAll[T: Decode[Yaml]](input: Bytes, options: YamlOptions): Array[T] ! YamlError","kind":"typed-decode-stream","effect":"pure"},
      {"id":"encode-value","signature":"pub fn encode(value: YamlValue, options: YamlOptions): Bytes ! YamlError","kind":"dynamic-encode","effect":"pure"},
      {"id":"encode-typed","signature":"pub fn encode[T: Encode[Yaml]](value: T, options: YamlOptions): Bytes ! YamlError","kind":"typed-encode","effect":"pure"},
      {"id":"encode-canonical","signature":"pub fn encodeCanonical(value: YamlValue, limits: YamlLimits): Bytes ! YamlError","kind":"canonical-encode","effect":"pure"},
      {"id":"reader-from-bytes","signature":"pub fn YamlReader.fromBytes(input: Bytes, options: YamlOptions): YamlReader ! YamlError","kind":"stream-reader-constructor","effect":"pure"},
      {"id":"reader-from-reader","signature":"pub fn YamlReader.fromReader(var input: std.io.Reader, options: YamlOptions): YamlReader ! YamlError suspends","kind":"stream-reader-constructor","effect":"suspends"},
      {"id":"reader-next","signature":"pub fn YamlReader.next(var self): YamlEvent? ! YamlError","kind":"stream-read","effect":"pure"},
      {"id":"reader-own","signature":"pub fn YamlReader.own(var self, event: YamlEvent): YamlEvent ! YamlError","kind":"stream-own","effect":"pure"},
      {"id":"reader-finish","signature":"pub fn YamlReader.finish(var self): Unit ! YamlError","kind":"stream-finish","effect":"pure"},
      {"id":"writer-to-writer","signature":"pub fn YamlWriter.toWriter(var output: std.io.Writer, options: YamlOptions): YamlWriter ! YamlError suspends","kind":"stream-writer-constructor","effect":"suspends"},
      {"id":"writer-write","signature":"pub fn YamlWriter.write(var self, event: YamlEvent): Unit ! YamlError suspends","kind":"stream-write","effect":"suspends"},
      {"id":"writer-finish","signature":"pub fn YamlWriter.finish(var self): Unit ! YamlError suspends","kind":"stream-finish","effect":"suspends"}
    ],
    "direct_call_waits": false,
    "explicit_await_direct_call": "forbidden",
    "explicit_await_join": "unchanged-by-language",
    "inference_by_name": false,
    "bodyless_requires_effect": true,
    "bodyful_inference": "allowed",
    "selectable_operations": [],
    "no_async_duplicate_api": true
  },
  "dynamic_model": {
    "object": "ordered-map-string-keyed",
    "array": "ordered-values",
    "binary": "YamlValue.Bytes-only-from-explicit-binary-tag",
    "alias": "expanded-logical-copy",
    "shared_identity": false,
    "non_string_keys": "reject",
    "view_lifetime": "until-reader-advance-or-operation-return"
  },
  "scalar_rules": {
    "null": ["null", "~", "empty-mapping-value"],
    "bool": ["true", "false", "ASCII-case-insensitive"],
    "integer": ["decimal", "0b", "0o", "0x"],
    "float": ["finite-decimal", "scientific"],
    "timestamp": "text-unless-explicit-rejected-tag",
    "yaml_1_1_boolean_spellings": "text",
    "non_finite": "reject",
    "integer_overflow": "reject",
    "implicit_locale": false
