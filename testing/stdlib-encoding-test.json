    "laws": [
      "RFC 4648 standard Base64 vectors round-trip byte-for-byte",
      "URL-safe Base64 changes only the declared alphabet",
      "required padding is emitted and validated only at the final quantum",
      "omitted padding accepts only two- or three-character remainders",
      "non-zero Base64 pad bits are NonCanonical",
      "mixed alphabets, whitespace and trailing data are rejected",
      "lower and upper hexadecimal output is policy-selected",
      "Any hexadecimal accepts both cases and emits lowercase",
      "hexadecimal prefixes, separators and odd nibbles are rejected",
      "materialized and incremental results are invariant under chunk boundaries",
      "empty chunks do not change codec state",
      "input and output limits fail before publishing partial bytes",
      "wire errors expose the observed input offset",
      "terminal success and errors reject all later operations",
      "bounded replays are deterministic and panic-free"
    ],
    "sequence_seeds": 4096,
    "oracle": "independent bounded Base64/hex wire model with exact error kinds and offsets",
    "command": "cargo test -p tondo-reliability --test encoding_models --locked"
  },
