// Serves a directory over HTTP, to look at a site before publishing it.
//
//     tondo run serve.to -- [<directory>] [<port>]

import std.console
import std.env
import std.fs
import std.http

let arguments = env.args()
let directory = arguments.get(0).unwrapOr(".")
let port = arguments.get(1).andThen((text) { Int.parse(text).ok() }).unwrapOr(8000)

var app = http.App()
app.files("", fs.disk(directory))
console.println("serving {directory} at http://localhost:{port}")
app.listen(port: port, host: "127.0.0.1")?
