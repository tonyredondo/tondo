#!/usr/bin/env tondo

// Serves a directory over HTTP, to look at a site before publishing it.
//
//     tondo serve.to [<directory>] [<port>]

import std.console
import std.env
import std.fs
import std.http

let arguments = env.args()
let directory = arguments.get(0) ?? "."
let port = arguments.get(1).andThen((text) { Int.parse(text).ok() }) ?? 8000

var app = http.App()
app.files("", fs.disk(directory))
console.println("serving {directory} at http://localhost:{port}")
app.listen(port: port, host: "127.0.0.1")?
