#!/usr/bin/env tondo

// Says who wrote the last commits of a Git repository, and how many each.
//
//     tondo authors.to [<how many commits>]
//
// It runs `git log` and reads what it prints: a command is a program and
// its arguments, each on its own, so nothing here is read by a shell.

import std.cli
import std.console
import std.env
import std.process

type Author = {
    commits: Int
    author: String
    latest: String
}

let wanted = env.args().get(0).unwrapOr("100")
let log = process.command("git", "log", "-n", wanted, "--format=%an%x09%ad%x09%s", "--date=short")
let output = match log.check() {
    ok(ran) => ran.text()?
    err(error) => {
        console.eprintln("git log did not run here: {error}")
        process.exit(1)
    }
}

var authors: Map[String, Author] = [:]
for line in output.lines() {
    match line.split("\t", limit: 3) {
        [name, date, subject] => {
            // The log is newest first: the first commit seen of an author is their latest.
            let known = authors
                .get(name)
                .unwrapOr(Author { commits: 0, author: name, latest: "{date} {subject}" })
            authors[name] = known with { commits: known.commits + 1 }
        }
        _ => {}
    }
}
console.println(cli.table(authors.values().collect().sortedBy((each) { -each.commits })))
