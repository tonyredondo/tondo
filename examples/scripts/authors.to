#!/usr/bin/env tondo

// Says who wrote the last commits of a Git repository, and how many each.
//
//     tondo authors.to [<how many commits>]
//
// It runs `git log` and reads what it prints. The command is written as in
// a shell, and no shell reads it: the compiler splits it into a program and
// its arguments, and `wanted` is one argument whatever it holds.

import std.cli
import std.console
import std.env
import std.process

type Author = {
    commits: Int
    author: String
    latest: String
}

let wanted = env.args().get(0) ?? "100"
let log = match $(git log -n {wanted} --format=%an%x09%ad%x09%s --date=short).lines() {
    ok(lines) => lines
    err(error) => {
        console.eprintln("git log did not run here: {error}")
        process.exit(1)
    }
}

var authors: Map[String, Author] = [:]
for line in log {
    match line.split("\t", limit: 3) {
        [name, date, subject] => {
            // The log is newest first: the first commit seen of an author is their latest.
            let first = Author { commits: 0, author: name, latest: "{date} {subject}" }
            authors[name, default: first].commits += 1
        }
        _ => {}
    }
}
console.println(cli.table(authors.values().collect().sortedBy((each) { -each.commits })))
