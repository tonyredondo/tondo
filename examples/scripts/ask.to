#!/usr/bin/env tondo

// Asks a question and takes one key as the answer, without waiting for
// Enter, as a shell's `read -n 1` does. Its status is 0 for yes:
//
//     tondo ask.to "Remove the build?" && rm -rf target

import std.cli
import std.console
import std.env
import std.process

/// One key of the terminal, which is taken for the length of the read: the
/// key comes as it is pressed and is not shown, and the terminal is given
/// back as it was.
fn key(): String ! cli.TerminalError {
    let terminal = cli.Terminal()?
    match terminal.keys().receive() {
        some(cli.Key.Char(letter)) => "{letter}"
        _ => ""
    }
}

let question = env.args().get(0) ?? "Go on?"
console.print("{question} [y/n] ")
// Without a terminal, as in a pipe, the answer is a line.
let answer = key() ?? (console.readLine() ?? "")
console.println(answer.trim())
process.exit(if answer.trim().toLower().startsWith("y") { 0 } else { 1 })
