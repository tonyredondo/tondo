import std.sql

/// A database that lives in the test.
fn fresh(): sql.Database ! sql.SqlError {
    open("sqlite::memory:")
}

test addsAndLists {
    let db = fresh()?
    let first = add(db, NewTask { title: "write the manual" })?
    let second = add(db, NewTask { title: "read it again" })?
    assert(first.id != second.id)
    assert(list(db)? == [first, second])
}

test filtersByDone {
    let db = fresh()?
    let task = add(db, NewTask { title: "ship" })?
    add(db, NewTask { title: "rest" })?
    change(db, task.id, TaskChange { done: true })?
    assert(list(db, done: true)?.map((item) { item.title }) == ["ship"])
    assert(list(db, done: false)?.map((item) { item.title }) == ["rest"])
}

test changesOnlyWhatIsNamed {
    let db = fresh()?
    let task = add(db, NewTask { title: "draft" })?
    let renamed = change(db, task.id, TaskChange { title: "final" })?
    assert(renamed == Task { id: task.id, title: "final", done: false })
    let finished = change(db, task.id, TaskChange { done: true })?
    assert(finished == Task { id: task.id, title: "final", done: true })
}

test aMissingTaskIsNone {
    let db = fresh()?
    assert(find(db, 99)? == none)
    assert(change(db, 99, TaskChange { done: true })? == none)
    assert(remove(db, 99)? == false)
}

test removes {
    let db = fresh()?
    let task = add(db, NewTask { title: "temporary" })?
    assert(remove(db, task.id)?)
    assert(list(db)?.isEmpty())
}
