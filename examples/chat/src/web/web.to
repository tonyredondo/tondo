import chat.rooms
import std.embed
import std.executor
import std.http
import std.sync
import std.time

/// The chat: the hub that owns the rooms, and what the rest of the program
/// may read of them. The hub runs for as long as this value is held.
pub type Chat = {
    hub: executor.Actor[rooms.Told, Never]
    counts: sync.Map[String, Int]
}

pub fn Chat(): Chat ! executor.ExecutorError {
    let counts = sync.Map[String, Int]()
    Chat { hub: rooms.start(counts)?, counts }
}

/// The server of the chat: the page, kept inside the executable; who is in
/// each room, as JSON; and a WebSocket for each person in a room.
pub fn Chat.routes(self): http.App {
    let hub = self.hub.reference()
    let counts = self.counts
    let ids = sync.Atomic(0)
    var app = http.App()
    app.get("/rooms", (_) { http.Reply.json(counts.snapshot()) })
    app.websocket(
        "/ws/:room",
        (request, socket) {
            talk(hub, ids.add(1), request, socket).mapErr(
                (error) { http.HttpError.Protocol("{error}") },
            )?
        },
    )
    app.files("", embed.files("public"))
    app
}

/// One connection, from the moment it opens until it closes.
fn talk(
    hub: rooms.Hub,
    id: Int,
    request: http.Request,
    socket: http.WebSocket,
): !(http.HttpError | executor.ExecutorError | executor.SendError) {
    // The connection's own actor: its mailbox holds the lines the room has
    // for it, and its task writes them to the socket one at a time. A
    // browser that is slow to take them holds up this actor and no other.
    let mailbox =
        executor.actor(
            socket,
            rooms.Waiting,
            (to: var http.WebSocket, line: String): !http.HttpError { to.sendText(line)? },
        )?
    hub.send(
        rooms.Told.Enter(
            id,
            request.param("room"),
            request.query("name").unwrapOr("guest"),
            mailbox.reference(),
        ),
    )?
    defer leave(hub, id)
    // This task reads what the browser sends, and tells the hub.
    for message in socket {
        match message? {
            http.Message.Text(text) => hub.send(rooms.Told.Say(id, text))?
            http.Message.Binary(_) => {}
        }
    }
}

/// Tells the hub that a connection went. This runs as the connection ends,
/// which may be in a task cancelled because the server is stopping, and a
/// cancelled task does not wait, not even to send: `within` gives it the
/// time to.
fn leave(hub: rooms.Hub, id: Int) {
    _ = within time.seconds(1) { hub.send(rooms.Told.Leave(id)) }
}
