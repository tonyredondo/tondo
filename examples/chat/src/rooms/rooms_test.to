import std.executor
import std.json
import std.sync

/// Someone in a test: the mailbox of a connection, and the lines it took.
type Guest = {
    mailbox: executor.Actor[String, Never]
    seen: sync.Mutex[Array[String]]
}

/// A guest whose mailbox holds `capacity` lines. While `gate` is closed,
/// they take one line and read no further, as a browser on a bad network.
fn guestBehind(gate: sync.Mutex[Bool], capacity: Int = 16): Guest ! executor.ExecutorError {
    let nothing: Array[String] = []
    let seen = sync.Mutex(nothing)
    let mailbox =
        executor.actor(
            0,
            capacity,
            (_: var Int, text: String) {
                seen.update((lines) { lines.push(text) })
                gate.updateWhen((open) { open }, (_) {})
            },
        )?
    Guest { mailbox, seen }
}

/// A guest who reads everything at once.
fn guest(capacity: Int = 16): Guest ! executor.ExecutorError {
    guestBehind(sync.Mutex(true), capacity)
}

/// Waits until a guest took so many lines.
fn waitFor(who: ref Guest, lines: Int) {
    who.seen.updateWhen((taken) { taken.length() >= lines }, (_) {})
}

/// What a guest was told, a few words for each line.
fn heard(who: ref Guest): Array[String] ! json.JsonError {
    var words: Array[String] = []
    for text in who.seen.get() {
        let event = json.decode[Event](text)?
        words.push(
            match event.kind {
                Welcome => "welcome to {event.room} with {event.people}"
                Joined => "{event.from} joined: {event.people}"
                Said => "{event.from}: {event.text}"
                Left => "{event.from} left: {event.people}"
                Missed => "missed {event.text}"
            },
        )
    }
    words
}

test aRoomHearsWhoComesSpeaksAndGoes {
    let counts = sync.Map[String, Int]()
    let hub = start(counts)?
    let ada = guest()?
    let leo = guest()?
    let to = hub.reference()
    to.send(Told.Enter(1, "tea", "ada", ada.mailbox.reference()))?
    to.send(Told.Enter(2, "tea", "leo", leo.mailbox.reference()))?
    to.send(Told.Say(1, "  hello  "))?
    to.send(Told.Say(2, "hi"))?
    to.send(Told.Leave(2))?
    hub.stop()?  // after everything it was told
    ada.mailbox.stop()?
    leo.mailbox.stop()?

    assert(
        heard(ref ada)? ==
            [
                "welcome to tea with [ada]",
                "leo joined: [ada, leo]",
                "ada: hello",
                "leo: hi",
                "leo left: [ada]",
            ],
    )
    assert(heard(ref leo)? == ["welcome to tea with [ada, leo]", "ada: hello", "leo: hi"])
    assert(counts.snapshot() == ["tea": 1])
}

test roomsDoNotHearEachOther {
    let counts = sync.Map[String, Int]()
    let hub = start(counts)?
    let ada = guest()?
    let zoe = guest()?
    let to = hub.reference()
    to.send(Told.Enter(1, "tea", "ada", ada.mailbox.reference()))?
    to.send(Told.Enter(2, "coffee", "zoe", zoe.mailbox.reference()))?
    to.send(Told.Say(1, "anyone for tea?"))?
    hub.stop()?
    ada.mailbox.stop()?
    zoe.mailbox.stop()?

    assert(heard(ref ada)? == ["welcome to tea with [ada]", "ada: anyone for tea?"])
    assert(heard(ref zoe)? == ["welcome to coffee with [zoe]"])
    assert(counts.snapshot() == ["tea": 1, "coffee": 1])
}

test aNewcomerHearsWhatWasSaid {
    let hub = start(sync.Map[String, Int]())?
    let ada = guest()?
    let leo = guest(capacity: 64)?
    let to = hub.reference()
    to.send(Told.Enter(1, "tea", "ada", ada.mailbox.reference()))?
    for n in 1..=25 {
        to.send(Told.Say(1, "message {n}"))?
    }
    to.send(Told.Enter(2, "tea", "leo", leo.mailbox.reference()))?
    hub.stop()?
    ada.mailbox.stop()?
    leo.mailbox.stop()?

    let lines = heard(ref leo)?
    assert(lines.length() == 1 + Kept)
    assert(lines[1] == "ada: message 6" and lines[-1] == "ada: message 25")
}

test anEmptyRoomForgets {
    let counts = sync.Map[String, Int]()
    let hub = start(counts)?
    let ada = guest()?
    let leo = guest()?
    let to = hub.reference()
    to.send(Told.Enter(1, "tea", "ada", ada.mailbox.reference()))?
    to.send(Told.Say(1, "a secret"))?
    to.send(Told.Leave(1))?
    to.send(Told.Enter(2, "tea", "leo", leo.mailbox.reference()))?
    hub.stop()?
    ada.mailbox.stop()?
    leo.mailbox.stop()?

    assert(heard(ref leo)? == ["welcome to tea with [leo]"])
    assert(counts.snapshot() == ["tea": 1])
}

test namesAndMessagesAreCut {
    let hub = start(sync.Map[String, Int]())?
    let ada = guest()?
    let to = hub.reference()
    to.send(Told.Enter(1, "tea", "  {"a".repeat(40)}  ", ada.mailbox.reference()))?
    to.send(Told.Say(1, "é".repeat(600)))?
    to.send(Told.Say(1, "   "))?
    hub.stop()?
    ada.mailbox.stop()?

    assert(
        heard(ref ada)? ==
            ["welcome to tea with [{"a".repeat(24)}]", "{"a".repeat(24)}: {"é".repeat(500)}"],
    )
}

test aSlowReaderMissesLinesAndIsToldHowMany {
    let hub = start(sync.Map[String, Int]())?
    let gate = sync.Mutex(false)
    let ada = guest()?
    let leo = guestBehind(gate, capacity: 2)?
    let zoe = guest()?
    let to = hub.reference()
    to.send(Told.Enter(1, "tea", "ada", ada.mailbox.reference()))?
    to.send(Told.Enter(2, "tea", "leo", leo.mailbox.reference()))?
    waitFor(ref leo, 1)  // leo took the welcome, and reads no further

    for text in ["one", "two", "three", "four"] {
        to.send(Told.Say(1, text))?
    }
    // The hub takes one message at a time, so once it has answered someone
    // who came later, in another room, it is done with all four lines: two
    // did not fit leo's mailbox.
    to.send(Told.Enter(3, "coffee", "zoe", zoe.mailbox.reference()))?
    waitFor(ref zoe, 1)

    gate.set(true)  // leo's network is back
    waitFor(ref leo, 3)
    to.send(Told.Say(1, "five"))?
    hub.stop()?
    ada.mailbox.stop()?
    leo.mailbox.stop()?
    zoe.mailbox.stop()?

    assert(
        heard(ref leo)? ==
            ["welcome to tea with [ada, leo]", "ada: one", "ada: two", "missed 2", "ada: five"],
    )
    assert(heard(ref ada)?.length() == 7)  // ada was never held up
}
