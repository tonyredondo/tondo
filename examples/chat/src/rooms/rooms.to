import std.executor
import std.json
import std.sync

/// What happened in a room.
pub enum Kind {
    /// What a newcomer is told: who is there.
    @name("welcome")
    Welcome
    @name("joined")
    Joined
    @name("said")
    Said
    @name("left")
    Left
    /// What someone who could not keep up is told: how many messages went
    /// by without them.
    @name("missed")
    Missed
}

/// What the people of a room are told, a line of JSON each time.
pub type Event = {
    kind: Kind
    room: String
    /// Who it is about: who came, spoke or left.
    from: String = ""
    text: String = ""
    /// Who is in the room now, in the order they came.
    people: Array[String] = []
}

/// Where to send what someone should see: the mailbox of their connection.
pub alias Outbox = executor.ActorRef[String]

/// What the hub is told.
pub enum Told {
    /// A connection came into a room under a name.
    Enter(Int, String, String, Outbox)
    /// A connection said something.
    Say(Int, String)
    /// A connection went.
    Leave(Int)
}

/// The address of the hub.
pub alias Hub = executor.ActorRef[Told]

/// Someone in a room.
type Member = {
    name: String
    room: String
    outbox: Outbox
    /// The lines that found their mailbox full.
    missed: Int = 0
}

/// Everything the hub knows. Only its own task reads or changes it.
type State = {
    members: Map[Int, Member] = [:]
    /// The last things said in each room, for who comes later.
    recent: Map[String, Array[String]] = [:]
    /// How many people each room has, for the rest of the program to read.
    counts: sync.Map[String, Int]
}

/// How much of what was said a room keeps.
pub const Kept: Int = 20

/// How many lines wait in a connection's mailbox before the next ones are
/// lost.
pub const Waiting: Int = 64

/// The longest name and the longest message.
const NameLimit: Int = 24

const TextLimit: Int = 500

/// Starts the hub: an actor that owns the rooms and is told what happens,
/// one message at a time. `counts` is kept up to date with the people of
/// each room, for whoever else wants to read it.
pub fn start(counts: sync.Map[String, Int]): executor.Actor[Told, Never] ! executor.ExecutorError {
    executor.actor(
        State { counts },
        256,
        (state: var State, told: Told) { handle(var state, told) },
    )
}

/// One message at a time: there is nothing here to lock.
fn handle(state: var State, told: Told) {
    match told {
        Told.Enter(id, room, name, outbox) => {
            let member = Member { name: tidy(name, NameLimit), room: tidy(room, NameLimit), outbox }
            state.members[id] = member
            count(var state, member.room)
            let now = people(state, member.room)
            // The newcomer hears who is there and what was said, then
            // everyone hears who came.
            deliver(
                var state,
                id,
                line(Event { kind: Kind.Welcome, room: member.room, people: now }),
            )
            for said in (state.recent.get(member.room) ?? []) {
                deliver(var state, id, said)
            }
            let joined = Event {
                kind: Kind.Joined
                room: member.room
                from: member.name
                people: now
            }
            broadcast(var state, member.room, line(joined), except: id)
        }
        Told.Say(id, text) => {
            let member = match state.members.get(id) {
                some(found) => found
                none => return
            }
            let words = tidy(text, TextLimit)
            if words.isEmpty() {
                return
            }
            let said = line(
                Event { kind: Kind.Said, room: member.room, from: member.name, text: words },
            )
            var kept = state.recent.get(member.room) ?? []
            kept.push(said)
            if kept.length() > Kept {
                _ = kept.removeAt(0)
            }
            state.recent[member.room] = kept
            broadcast(var state, member.room, said)
        }
        Told.Leave(id) => {
            let member = match state.members.remove(id) {
                some(found) => found
                none => return
            }
            count(var state, member.room)
            let now = people(state, member.room)
            if now.isEmpty() {
                _ = state.recent.remove(member.room)  // an empty room forgets
            }
            let left = Event { kind: Kind.Left, room: member.room, from: member.name, people: now }
            broadcast(var state, member.room, line(left))
        }
    }
}

/// A name, a room or a message as it is kept: without the space around it
/// and no longer than its limit.
fn tidy(text: String, limit: Int): String {
    text.trim().chars().take(limit).collect().join("")
}

fn line(event: Event): String {
    json.encode(event)
}

/// The names of who is in a room, in the order they came.
fn people(state: State, room: String): Array[String] {
    state.members
        .values()
        .filter((member) { member.room == room })
        .map((member) { member.name })
        .collect()
}

/// Writes how many people a room has where the rest of the program reads it.
fn count(state: var State, room: String) {
    let now = people(state, room).length()
    if now == 0 {
        _ = state.counts.remove(room)
    } else {
        _ = state.counts.insert(room, now)
    }
}

/// Sends a line to everyone in a room.
fn broadcast(state: var State, room: String, text: String, except: Int? = none) {
    for (id, member) in state.members {
        if member.room == room and some(id) != except {
            deliver(var state, id, text)
        }
    }
}

/// Sends a line to one connection without waiting for it. A mailbox that is
/// full loses the line, and its owner is told how many were lost once there
/// is room again: one slow reader never holds up a room.
fn deliver(state: var State, id: Int, text: String) {
    var member = match state.members.get(id) {
        some(found) => found
        none => return
    }
    if member.missed > 0 {
        let gap = Event { kind: Kind.Missed, room: member.room, text: "{member.missed}" }
        if member.outbox.trySend(line(gap)).isOk() {
            member.missed = 0
        }
    }
    if member.missed > 0 or member.outbox.trySend(text).isErr() {
        member.missed += 1
    }
    state.members[id] = member
}
