# Repository text has one checkout representation so source identities do not
# depend on the host's core.autocrlf setting.
* text=auto eol=lf

# Runtime stdout sidecars are exact byte snapshots on every host.
*.stdout -text

# Platform argument sidecars are canonical LF text consumed byte-for-byte.
*.args-unix text eol=lf
*.args-windows text eol=lf

# Bootstrap corpus, historical snapshots, and the active draft manifest are
# byte-exact. The bootstrap path is retained only as regression evidence; it
# is not a second language or release line.
/TONDO_*_SPEC.md -text
/conformance/0.1/** -text
/conformance/baseline/** -text
/conformance/draft/** -text
/testing/*.json -text
