import std.testing

fn recordIntegration() {
    testing.log("integration service")
    testing.tags(["kind": "integration"])
}

async fn serviceValue(): Int {
    42
}

async fn startService(): Int {
    scope {
        let service = spawn serviceValue()
        await service
    }
}

async fn stopService() {
    testing.log("service cleanup")
}

test integration_root {
    recordIntegration()
    assert(true)
}

suite shared_service {
    testing.log("shared setup")
    let port = 8080

    test starts {
        recordIntegration()
        assert(port == 8080)
    }

    suite nested_client {
        let response = port + 1

        test receives_response {
            recordIntegration()
            assert(response == 8081)
        }
    }
}

suite managed_service {
    let serviceResponse = await startService()
    defer await stopService()

    test responds {
        testing.log("managed service response")
        testing.tags(["kind": "integration"])
        assert(serviceResponse == 42)
    }
}
