import acceptance.main as counter
import std.testing
import std.time

fn recordIntegration() {
    testing.log("integration service")
    testing.tags(["kind": "integration"])
}

async fn serviceValue(): Int {
    42
}

async fn startService(): Int {
    scope {
        let service = spawn serviceValue()
        await service
    }
}

async fn stopService() {
    testing.log("service cleanup")
}

test integration_root {
    recordIntegration()
    match await testing.withVirtualTime(async (clock) {
        let before = time.now()?
        scope {
            let response = spawn counter.answerAfterBackoff(time.Duration.fromNanoseconds(25))
            await clock.settle()
            assert(await response? == 42)
        }
        let after = time.now()?
        assert(after.durationSince(before)?.toNanoseconds() == 25)
    }) {
        ok(_) => ()
        err(_) => testing.failNow("virtual backoff failed")
    }
}

suite shared_service {
    testing.log("shared setup")
    let port = 8080

    test starts {
        recordIntegration()
        assert(port == 8080)
    }

    suite nested_client {
        let response = port + 1

        test receives_response {
            recordIntegration()
            assert(response == 8081)
        }
    }
}

suite managed_service {
    let serviceResponse = await startService()
    defer await stopService()

    test responds {
        testing.log("managed service response")
        testing.tags(["kind": "integration"])
        assert(serviceResponse == 42)
    }
}
