import std.fs
import std.path
import std.bytes
import std.testing

suite retry_group {
    testing.log("suite participation")

    test deterministicFlaky {
        let marker = path.Path.fromString("dogfood-retry.marker")?
        match fs.readAll(marker) {
            ok(_) => {
                fs.remove(marker)?
                testing.log("isolated retry passed")
            }
            err(_) => {
                fs.writeAll(marker, bytes.Bytes("retry")?)?
                testing.failNow("controlled first attempt")
            }
        }
    }

    test stableSibling {
        testing.log("stable sibling")
    }
}
