import std.process
import std.testing

test deterministicFlaky {
    match await process
        .cmd(
            "sh",
            "-c",
            "if test -f dogfood-retry.marker; then rm dogfood-retry.marker; exit 0; else : > dogfood-retry.marker; exit 7; fi",
        )
        .check() {
        ok(_) => testing.log("isolated retry passed")
        err(process.ProcessExitError(_)) => testing.failNow("controlled first attempt")
        err(process.ProcessError(_)) => testing.failNow("retry fixture could not start")
    }
}
