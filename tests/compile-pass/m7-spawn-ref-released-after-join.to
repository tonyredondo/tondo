fn observe(value: ref Int): Int suspends {
    value
}

fn immediate(value: Int): Int suspends {
    value
}

fn noop() suspends {}

fn valid() suspends {
    scope {
        var value = 1
        let first = spawn observe(ref value)
        let pending = first
        let observed = await pending
        value = 2
        assert(observed == 1)
        assert(value == 2)
    }
}

fn outerJoinMayCrossAnInnerScope() suspends {
    scope {
        let outer = spawn immediate(1)
        let carried = scope {
            outer
        }
        assert(await carried == 1)
    }
}

fn wrappedJoinReleasesItsStructuredBorrow() suspends {
    scope {
        var value = 1
        let wrapped = some(spawn observe(ref value))
        match wrapped {
            some(pending) => {
                assert(await pending == 1)
            }
            none => {}
        }
        value = 2
        assert(value == 2)
    }
}

fn unitJoinMayBeAwaitedAsAStatement() suspends {
    scope {
        let pending = spawn noop()
        await pending
    }
}
