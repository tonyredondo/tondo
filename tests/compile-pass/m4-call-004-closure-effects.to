fn build() {
    let sync: fn(Int): Int = (value) { value }
    let raw: unsafe fn(Int): Int = unsafe (value) { value }
    let later: fn(Int): Int suspends = (value) { value }
    let both: unsafe fn(Int): Int suspends = unsafe (value) { value }
    _ = sync
    _ = raw
    _ = later
    _ = both
}
