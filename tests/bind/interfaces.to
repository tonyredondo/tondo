import std.console
import std.ffi
import app.counter

/// A counter of Tondo's, of what it cares for alone: the rest of the
/// interface answers that it does not implement it.
type Adds = {}

impl counter.ICounter for Adds {
    fn Add(self, amount: Int32): ffi.HResult {
        console.println("adds {amount}")
        ffi.HResult.Ok
    }
}

fn main() {
    let slot = ffi.allocate[Pointer[ffi.Void]?]()
    let made = unsafe { counter.counter_make(slot) }
    let object = unsafe { slot.read() } ?? panic("no counter")
    let counting = unsafe { counter.ICounterObject.of(object) }
    let added = counting.Add(40)
    let refused = counting.Add(-1)
    let total = ffi.allocate[ffi.CInt]()
    let read = counting.GetTotal(total)
    console.println("{made.isOk()} {added.isOk()} {refused} {read.isOk()} {unsafe { total.read() }}")
    // The same object, as the interface that extends it.
    let id = ffi.allocate[ffi.Guid]()
    let found = ffi.allocate[Pointer[ffi.Void]]()
    unsafe { id.write(counter.INamedCounterObject.Id) }
    let asked = counting.unknown().queryInterface(id, found)
    let named = unsafe { counter.INamedCounterObject.of(found.read()) }
    let buffer = ffi.allocate[UInt16](8)
    let needed = ffi.allocate[UInt32]()
    let small = named.GetName(2, needed, buffer)
    let whole = named.GetName(8, needed, buffer)
    let name = unsafe { ffi.fromWide(buffer) }
    console.println("{asked.isOk()} {small.isFailure()} {whole.isOk()} {unsafe { needed.read() }} {name}")
    console.println("{named.release()} {counting.release()}")
    let own = unsafe { counter.ICounterObject.of(ffi.object(Adds {})) }
    let owned = ffi.allocate[ffi.CInt]()
    console.println("{own.Add(2).isOk()} {own.GetTotal(owned)} {own.release()}")
}
