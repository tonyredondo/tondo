import std.channel
import std.console

fn emitCleanup(text: String) {
    _ = console.println(text)
}

fn cleanup_receiver(receiver: channel.Receiver[Int]) {
    let _ = receiver.close()
}

fn main(): !channel.ChannelError {
    let (sender, receiver) = channel.bounded[Int](1)?
    match sender.trySend(9) {
        ok(_) => ()
        err(_) => assert(false)
    }
    defer cleanup_receiver(receiver)
    defer emitCleanup("channel-panic-cleanup")
    sender.close()
    panic("channel conformance panic")
}
