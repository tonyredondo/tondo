import std.console
import std.process
import std.bytes
import std.collections
import std.text
import std.env

fn argument(value: env.Value): String {
    match value.asText() {
        some(argumentText) => argumentText
        none => panic("process fixture argument is not UTF-8")
    }
}

fn pipelineText(pipeline: Pipeline): String ! (process.ProcessError | bytes.Utf8Error) suspends {
    let output = pipeline.output()?
    String(output.stdout)?
}

fn main(): !(process.ProcessError | bytes.Utf8Error | env.EnvError) suspends {
    let hostArguments = env.snapshot()?.arguments()
    let streamCommand = argument(hostArguments[0])
    let sleepCommand = argument(hostArguments[1])

    let source = process.command(
        "git",
        "show",
        "HEAD:tests/runtime/m8-process-001.stdout",
    )
    let first = process.command("git", "hash-object", "--stdin")
    let second = process.command("git", "hash-object", "--stdin")
    let third = process.command("git", "hash-object", "--stdin")

    assert(
        pipelineText(source | first)? ==
        "a6cb097452c125b4e95c1964d6d3af7a1b819186\n"
    )
    assert(
        pipelineText(source | (first | second))? ==
        "c9a7fc312cf6d2cca8fc70ad6078da85147a433d\n"
    )
    assert(
        pipelineText((source | first) | second)? ==
        "c9a7fc312cf6d2cca8fc70ad6078da85147a433d\n"
    )
    assert(
        pipelineText((source | first) | (second | third))? ==
        "03337a02c790a62bb4cde612fd39894a8d1f797a\n"
    )

    let exact = process.command("git", "rev-parse", "--sq-quote", "two words", "*", "$HOME")
        .output()?
    assert(String(exact.stdout)? == " 'two words' '*' '$HOME'\n")

    let streams = process.shell(streamCommand)
        .output()?
    assert(String(streams.stdout)? == "stdout")
    assert(String(streams.stderr)? == "stderr")
    let streams_combined = streams.combined
    let streams_statuses = streams.statuses
    assert(String(streams_combined)? != "")
    assert(streams_statuses[0].success)

    let merged = process.shell(streamCommand)
        .mergeStderr()
        .output()?
    let merged_stderr = merged.stderr
    let merged_combined = merged.combined
    let merged_stdout = merged.stdout
    assert(String(merged_stderr)? == "")
    assert(String(merged_combined)? == String(merged_stdout)?)

    let _merged_pipeline = (
        process.shell(streamCommand) |
        process.shell(streamCommand)
    ).mergeStderr()

    let status = process.shell("exit 7").status()?
    assert(status[0].code == some(7))
    assert(not status[0].success)

    match process.shell("exit 7").check() {
        ok(_) => assert(false)
        err(process.ProcessError(_)) => assert(false)
        err(process.ProcessExitError(_)) => ()
    }

    let ran = process.command("git", "--version").run()?
    assert(ran[0].success)

    let handle = (
        process.command(
            "git",
            "show",
            "HEAD:tests/runtime/m8-process-001.stdout",
        ) |
        process.command("git", "hash-object", "--stdin")
    ).start()?
    let handled = handle.output()?
    assert(
        String(handled.stdout)? ==
        "a6cb097452c125b4e95c1964d6d3af7a1b819186\n"
    )

    let waited = process.command("git", "--version").start()?.wait()?
    assert(waited[0].success)

    let sleeping = process.shell(sleepCommand).start()?
    let cancelled = sleeping.cancel()?
    assert(not cancelled[0].success)

    console.print("process-ok\n")
}
