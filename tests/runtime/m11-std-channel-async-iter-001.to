import std.channel
import std.console
import std.async

fn collect_zero(receiver: channel.Receiver[Int]) {
    let retained = match receiver.fork() {
        ok(value) => value
        err(_) => panic("zero-limit receiver fork failed")
    }
    match receiver.collect(limit: 0) {
        ok(values) => assert(values.length() == 0)
        err(_) => assert(false)
    }
    let drained = retained.close()
    assert(drained.length() == 2)
    assert(drained[0] == 30)
    assert(drained[1] == 31)
}

fn main(): !channel.ChannelError {
    let (sender, receiver) = channel.bounded[Int](2)?

    match sender.trySend(1) {
        ok(_) => {}
        err(_) => assert(false)
    }
    match sender.trySend(2) {
        ok(_) => {}
        err(_) => assert(false)
    }
    sender.close()

    var total = 0
    for value in receiver {
        total += value
    }
    assert(total == 3)

    let (early_sender, early_receiver) = channel.bounded[Int](2)?
    match early_sender.trySend(10) {
        ok(_) => {}
        err(_) => assert(false)
    }
    match early_sender.trySend(11) {
        ok(_) => {}
        err(_) => assert(false)
    }
    early_sender.close()
    for value in early_receiver {
        assert(value == 10)
        break
    }

    let (collect_sender, collect_receiver) = channel.bounded[Int](2)?
    match collect_sender.trySend(20) {
        ok(_) => {}
        err(_) => assert(false)
    }
    match collect_sender.trySend(21) {
        ok(_) => {}
        err(_) => assert(false)
    }
    collect_sender.close()
    let retained = match collect_receiver.fork() {
        ok(value) => value
        err(_) => panic("limited receiver fork failed")
    }
    match collect_receiver.collect(limit: 2) {
        ok(values) => assert(values.length() == 2)
        err(_) => assert(false)
    }
    let collect_drained = retained.close()
    assert(collect_drained.length() == 0)

    let (zero_sender, zero_receiver) = channel.bounded[Int](2)?
    match zero_sender.trySend(30) {
        ok(_) => {}
        err(_) => assert(false)
    }
    match zero_sender.trySend(31) {
        ok(_) => {}
        err(_) => assert(false)
    }
    zero_sender.close()
    collect_zero(zero_receiver)

    _ = console.println("channel-async-iter-ok")
}
