import std.console
import std.bytes

fn main(): !(bytes.BytesError | bytes.Utf8Error) {
    let empty = bytes.empty()?
    assert(empty.length() == 0)
    let copied = bytes.fromArray([Byte(65u8), Byte(66u8)])?
    let copiedArray = copied.toArray()?
    assert(copiedArray[0] == Byte(65u8))
    let data = bytes.Bytes("abc")?
    assert(data.length() == 3)
    assert(data.get(1) == some(Byte(98u8)))
    let part = data.slice(1, 3)?
    assert(String(part)? == "bc")

    var builder = bytes.builder()?
    builder.appendByte(Byte(65u8))?
    builder.append(data)?
    let built = builder.finish()?
    assert(String(built)? == "Aabc")
    var arrayBuilder = bytes.builder()?
    arrayBuilder.appendArray([Byte(67u8), Byte(68u8)])?
    let arrayBuilt = arrayBuilder.finish()?
    assert(String(arrayBuilt)? == "CD")
    builder.appendByte(Byte(66u8))?
    assert(builder.length() == 5)
    assert(String(built)? == "Aabc")
    assert(built.equal(bytes.Bytes("Aabc")?))
    assert(built.hash() == bytes.Bytes("Aabc")?.hash())
    console.print("bytes-ok\n")
}
