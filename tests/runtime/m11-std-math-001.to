import std.console
import std.math

fn main(): !math.MathError {
    assert(math.floor(2.9) == 2.0)
    assert(math.ceil(2.1) == 3.0)
    assert(math.round(2.5) == 3.0)
    assert(math.truncate(-2.9) == -2.0)
    assert(math.abs(-4.0) == 4.0)
    assert(math.min(2.0, 3.0) == 2.0)
    assert(math.max(2.0, 3.0) == 3.0)
    assert(math.fma(2.0, 3.0, 4.0) == 10.0)
    assert(math.sqrt(9.0)? == 3.0)
    match math.sqrt(-1.0) {
        ok(_) => assert(false)
        err(_) => ()
    }
    console.print("math-ok\n")
}
