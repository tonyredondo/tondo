import std.console

fn increment(value: Int): Int {
    value + 1
}

fn native_eval_subtract(left: Int, right: Int): Int {
    left - right
}

fn native_eval_multiply(left: Int, right: Int): Int {
    left * right
}

fn native_eval_divide(left: Int, right: Int): Int {
    left / right
}

fn native_eval_remainder(left: Int, right: Int): Int {
    left % right
}

fn native_eval_shift_left(left: Int, right: Int): Int {
    left << right
}

fn native_eval_shift_right(left: Int, right: Int): Int {
    left >> right
}

fn native_eval_bitwise_and(left: Int, right: Int): Int {
    left & right
}

fn native_eval_bitwise_or(left: Int, right: Int): Int {
    left | right
}

fn native_eval_bitwise_xor(left: Int, right: Int): Int {
    left ^ right
}

fn native_eval_negate(value: Int): Int {
    -value
}

fn native_eval_branch(value: Int): Int {
    if value > 0 {
        value + 1
    } else {
        value - 1
    }
}

fn native_eval_loop(): Int {
    var index = 0
    var total = 0
    for index < 4 {
        total = total + index
        index += 1
    }
    total
}

fn native_eval_call(value: Int): Int {
    native_eval_subtract(value, 1)
}

fn native_eval_assert(value: Int): Int {
    assert(value != 0)
    value
}

fn native_eval_option_tag(): Int {
    let value: Int? = some(1)
    match value {
        some(_) => 1
        none => 0
    }
}

fn errorCode(message: String): Int {
    message.length()
}

fn load(condition: Bool): Int ! String {
    if condition {
        40
    } else {
        fail "missing"
    }
}

fn main() {
    let present: Int? = some(3)
    let mapped: Int? = present.map(increment)
    let explicitly_mapped: Int? = present.map[Int, Int](increment)
    assert(mapped == some(4))
    assert(explicitly_mapped == some(4))

    let absent: Int? = none
    assert(absent.map(increment) == none)
    assert(absent.unwrapOr(9) == 9)
    assert(mapped.unwrapOr(0) == 4)

    let loaded: Int ! String = load(true)
    let mapped_result: Int ! String = loaded.map(increment)
    match mapped_result {
        ok(value) => assert(value == 41)
        err(_) => assert(false)
    }
    match load(false).map(increment) {
        ok(_) => assert(false)
        err(_) => ()
    }

    let mapped_error: Int ! Int = load(false).mapErr(errorCode)
    match mapped_error {
        ok(_) => assert(false)
        err(code) => assert(code == 7)
    }
    match load(true).mapErr[Int, String, Int](errorCode) {
        ok(value) => assert(value == 40)
        err(_) => assert(false)
    }
    assert(load(true).unwrapOr(8) == 40)
    assert(load(false).unwrapOr(8) == 8)
    console.print("core-map-ok\n")
}
