import std.bytes
import std.console
import std.io

fn main(): !(console.ConsoleError | io.IoError | bytes.BytesError) suspends {
    var input = console.stdin()?
    let limits = io.defaultLimits()
    let data = io.readAll(var input, limits)?
    assert(data.length() == 0)

    var output = console.stdout()?
    io.writeAll(var output, bytes.Bytes("io-ok")?)?
    console.println(" io-done")
}
