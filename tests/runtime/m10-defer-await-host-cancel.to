import std.console
import std.process

fn cleanup(handle: process.ProcessHandle) suspends {
    match handle.cancel() {
        ok(_) => (),
        err(_) => panic("cancel")
    }
}

fn main(): !process.ProcessError {
    let commands = process.args()
    let handle = process.shell(commands[0]).start()?
    defer await cleanup(handle)
    console.print("body\n")
}
