import std.console
import std.executor
import std.fs
import std.path
import std.time

fn compute(): Int ! Never suspends {
    40 + 2
}

fn blocking_compute(): Int ! Never {
    42
}

fn blocked(): Int ! time.ClockError suspends {
    // Keep the admission probe alive beyond the host clock poll interval.
    time.sleep(time.Duration.fromNanoseconds(50000000))?
    42
}

fn submit_blocked(): Int ! Never suspends {
    match time.sleep(time.Duration.fromNanoseconds(1000000)) {
        ok(_) => 42
        err(_) => panic("executor submit backpressure clock failed")
    }
}

fn actor_step(state: mut Int, message: Int): Unit ! String suspends {
    state += message
    if message == 2 {
        assert(state == 3)
    }
}

fn actor_fail(state: mut Int, message: Int): Unit ! String suspends {
    if message == 9 {
        err("actor-failed")
    } else {
        state += message
    }
}

fn actor_slow(state: mut Int, message: Int): Unit ! String suspends {
    match time.sleep(time.Duration.fromNanoseconds(1000000)) {
        ok(_) => {
            state += message
        }
        err(_) => {
            err("actor-clock")
        }
    }
}

fn actor_select_file(state: mut Int, message: fs.File): Unit ! Never suspends {
    let _ = message
    state += 1
}

fn submit_pair(pool: ref executor.Pool): Unit ! Never suspends {
    scope {
        let first = match pool.submit(submit_blocked) {
            ok(join) => join
            err(_) => panic("executor submit rejected the first job")
        }
        let second = match pool.submit(compute) {
            ok(join) => join
            err(_) => panic("executor submit rejected the second job")
        }
        assert(await first == 42)
        assert(await second == 42)
    }
}

fn cancel_pool_with_job(): Unit ! (executor.ExecutorError | executor.SubmitError | time.ClockError) suspends {
    let pool = executor.pool(1, 1)?
    scope {
        let _job = pool.trySubmit(blocked)?
        pool.cancel()
        return
    }
}

fn main(): !(executor.ExecutorError | executor.SubmitError | executor.ActorSendError[Int] | time.ClockError | fs.FsError | path.PathError | String) {
    let blocking_pool = executor.blockingPool(1, 1)?
    assert(blocking_pool.run(blocking_compute)? == 42)
    scope {
        let first = spawn blocking_pool.run(blocking_compute)
        let second = spawn blocking_pool.run(blocking_compute)
        assert(await first == 42)
        assert(await second == 42)
    }
    blocking_pool.shutdown()
    match executor.pool(0, 1) {
        ok(_) => assert(false)
        err(error) => match error {
            executor.ExecutorError.InvalidWorkers => {}
            executor.ExecutorError.InvalidCapacity => assert(false)
            executor.ExecutorError.ResourceLimit => assert(false)
            executor.ExecutorError.CapabilityMissing => assert(false)
        }
    }
    match executor.pool(1, -1) {
        ok(_) => assert(false)
        err(error) => match error {
            executor.ExecutorError.InvalidWorkers => assert(false)
            executor.ExecutorError.InvalidCapacity => {}
            executor.ExecutorError.ResourceLimit => assert(false)
            executor.ExecutorError.CapabilityMissing => assert(false)
        }
    }
    match executor.pool(4097, 1) {
        ok(_) => assert(false)
        err(error) => match error {
            executor.ExecutorError.InvalidWorkers => assert(false)
            executor.ExecutorError.InvalidCapacity => assert(false)
            executor.ExecutorError.ResourceLimit => {}
            executor.ExecutorError.CapabilityMissing => assert(false)
        }
    }
    let pool = executor.pool(1, 1)?
    scope {
        let first = pool.trySubmit(blocked)?
        scope {
            match pool.trySubmit(compute) {
                ok(_) => {
                    panic("executor pool accepted a saturated job")
                }
                err(error) => match error {
                    executor.SubmitError.Saturated => {}
                    executor.SubmitError.Closed => assert(false)
                    executor.SubmitError.Cancelled => assert(false)
                    executor.SubmitError.ResourceLimit => assert(false)
                }
            }
        }
        assert(await first? == 42)
    }
    let _ = submit_pair(ref pool)?
    scope {
        match pool.actor(0, -1, actor_step) {
            ok(_) => panic("executor actor accepted a negative capacity")
            err(error) => match error {
                executor.ExecutorError.InvalidWorkers => assert(false)
                executor.ExecutorError.InvalidCapacity => {}
                executor.ExecutorError.ResourceLimit => assert(false)
                executor.ExecutorError.CapabilityMissing => assert(false)
            }
        }
        let actor = pool.actor(0, 1, actor_step)?
        let actor_ref = actor.ref()
        match actor_ref.trySend(1) {
            ok(_) => {}
            err(error) => match error {
                executor.ActorSendError.Saturated(_) => assert(false)
                executor.ActorSendError.Closed(_) => assert(false)
                executor.ActorSendError.Cancelled(_) => assert(false)
                executor.ActorSendError.Terminated(_) => assert(false)
                executor.ActorSendError.ResourceLimit(_) => assert(false)
            }
        }
        time.sleep(time.Duration.fromNanoseconds(1000000))?
        match actor_ref.trySend(2) {
            ok(_) => {}
            err(error) => match error {
                executor.ActorSendError.Saturated(_) => assert(false)
                executor.ActorSendError.Closed(_) => assert(false)
                executor.ActorSendError.Cancelled(_) => assert(false)
                executor.ActorSendError.Terminated(_) => assert(false)
                executor.ActorSendError.ResourceLimit(_) => assert(false)
            }
        }
        time.sleep(time.Duration.fromNanoseconds(1000000))?
        actor.stop()?
    }
    scope {
        let failed_actor = pool.actor(0, 1, actor_fail)?
        let failed_ref = failed_actor.ref()
        match failed_ref.trySend(9) {
            ok(_) => {}
            err(_) => panic("executor actor failed to accept its error message")
        }
        time.sleep(time.Duration.fromNanoseconds(1000000))?
        match failed_actor.stop() {
            ok(_) => assert(false)
            err(error) => assert(error == "actor-failed")
        }
        match failed_ref.trySend(9) {
            ok(_) => assert(false)
            err(error) => match error {
                executor.ActorSendError.Saturated(_) => assert(false)
                executor.ActorSendError.Closed(_) => assert(false)
                executor.ActorSendError.Cancelled(_) => assert(false)
                executor.ActorSendError.Terminated(message) => assert(message == 9)
                executor.ActorSendError.ResourceLimit(_) => assert(false)
            }
        }
    }
    scope {
        let busy = pool.submit(submit_blocked)?
        let blocked_actor = pool.actor(0, 1, actor_slow)?
        let blocked_ref = blocked_actor.ref()
        match blocked_ref.send(1) {
            ok(_) => {}
            err(_) => panic("executor actor send rejected its first message")
        }
        match blocked_ref.send(2) {
            ok(_) => {}
            err(_) => panic("executor actor send did not resume after backpressure")
        }
        blocked_actor.stop()?
        assert(await busy == 42)
    }
    scope {
        let selected_actor = pool.actor(0, 1, actor_step)?
        let selected_ref = selected_actor.ref()
        let selected = select {
            selected_ref.send(4) => true
            else => false
        }
        assert(selected)
        selected_actor.stop()?
    }
    scope {
        let empty_actor = pool.actor(0, 0, actor_step)?
        let empty_ref = empty_actor.ref()
        let selected = select {
            empty_ref.send(5) => false
            else => true
        }
        assert(selected)
        empty_actor.stop()?
    }
    scope {
        let waiting_actor = pool.actor(0, 1, actor_slow)?
        let waiting_ref = waiting_actor.ref()
        waiting_ref.send(1)?
        waiting_ref.send(2)?
        let selected = select {
            waiting_ref.send(3) => true
        }
        assert(selected)
        waiting_actor.stop()?
    }
    scope {
        let affine_actor = pool.actor(0, 0, actor_select_file)?
        let affine_ref = affine_actor.ref()
        let file_path = path.fromString("Cargo.toml")?
        let message = fs.open(file_path, fs.OpenMode.Read())?
        let selected = select {
            affine_ref.send(message) => false
            else => {
                let _ = message
                true
            }
        }
        assert(selected)
        affine_actor.stop()?
    }
    pool.shutdown()
    cancel_pool_with_job()?
    console.println("executor-ok")
}
