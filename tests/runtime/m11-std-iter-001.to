import std.collections
import std.iter

fn plus_one(value: Int): Int {
    value + 1
}

fn is_even(value: Int): Bool {
    value % 2 == 0
}

fn main() {
    let mapped = [1, 2, 3, 4].map(plus_one)
    let first = mapped.take(2).collect().unwrapOr(Array.new[Int]())
    assert(first == [2, 3])

    let filtered = [1, 2, 3, 4].filter(is_even).collect().unwrapOr(Array.new[Int]())
    assert(filtered == [2, 4])

    let double: fn(Int): Int = (value) { value * 2 }
    let closure_result = [2, 3].map(double).collect().unwrapOr(Array.new[Int]())
    assert(closure_result == [4, 6])

    let qualified = iter.map([5, 6], plus_one).collect().unwrapOr(Array.new[Int]())
    assert(qualified == [6, 7])

    let static_take = iter.take[Int, Array[Int]]([7, 8], 1).collect().unwrapOr(Array.new[Int]())
    assert(static_take == [7])
    let static_collect = iter.collect[Int, Array[Int]]([9, 10]).unwrapOr(Array.new[Int]())
    assert(static_collect == [9, 10])

    let empty = [1, 2].take(-1).collect().unwrapOr(Array.new[Int]())
    assert(empty == [])

    let chained = (1 ..= 5).map(plus_one).filter(is_even).take(2)
    assert(chained.collect().unwrapOr(Array.new[Int]()) == [2, 4])
}
