import std.console

fn tick() suspends {}

fn sibling() suspends {
    defer console.print("sibling-cleanup\n")

    for {
        tick()
    }
}

fn failChild() suspends {
    tick()
    panic("structured child panic")
}

fn main() suspends {
    scope {
        let waiting = spawn sibling()
        let failing = spawn failChild()
        let _ = await waiting
        let _ = await failing
    }
}
