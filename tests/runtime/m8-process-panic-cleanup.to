import std.process
import std.env

fn argument(value: env.Value): String {
    match value.asText() {
        some(argumentText) => argumentText
        none => panic("process fixture argument is not UTF-8")
    }
}

fn failChild() suspends {
    panic("process sibling panic")
}

fn main(): !(process.ProcessError | env.EnvError) {
    let hostArguments = env.snapshot()?.arguments()
    scope {
        let running = spawn process.shell(argument(hostArguments[0])).output()
        let failing = spawn failChild()
        let _ = await failing
        let _ = await running?
    }
}
