import std.console
import std.bytes
import std.json
import std.messagepack
import std.protobuf
import std.serialization

type JsonUser = { id: Int, name: String }
derive serialization.Encode[Json] + serialization.Decode[Json] for JsonUser

type JsonComposite = { small: Byte, tags: Array[String], nickname: String? }
derive serialization.Encode[Json] + serialization.Decode[Json] for JsonComposite

type JsonWirePolicy = {
    @name("wire_id") id: Int
    @json(base64) payload: bytes.Bytes
    @ignore legacy: Int?
    nickname: String?
}
derive serialization.Encode[Json] + serialization.Decode[Json] for JsonWirePolicy

enum JsonChoice {
    Empty
    Number(Int)
    Named { name: String }
}
derive serialization.Encode[Json] + serialization.Decode[Json] for JsonChoice

fn json_limits_with(maxDocumentBytes: Int, maxOutputBytes: Int): json.JsonLimits {
    json.JsonLimits {
        maxDocumentBytes
        maxDepth: 64
        maxArrayItems: 65536
        maxObjectMembers: 65536
        maxStringBytes: 1048576
        maxNumberBytes: 4096
        maxEvents: 100000
        maxOutputBytes
    }
}

fn json_limits(): json.JsonLimits {
    json_limits_with(1048576, 1048576)
}

fn json_decode_options(): json.JsonDecodeOptions {
    json_decode_options_with(json_limits(), json.JsonDuplicatePolicy.Reject)
}

fn json_decode_options_with(
    limits: json.JsonLimits,
    duplicateKeys: json.JsonDuplicatePolicy,
): json.JsonDecodeOptions {
    json.JsonDecodeOptions {
        limits
        duplicateKeys
        unknownFields: json.JsonUnknownFieldPolicy.Reject
        numbers: json.JsonNumberPolicy.Exact
    }
}

fn json_encode_options(): json.JsonEncodeOptions {
    json.JsonEncodeOptions {
        limits: json_limits()
        canonical: false
    }
}

fn main(): !(bytes.BytesError | bytes.Utf8Error | console.ConsoleError | json.JsonError) {
    let json_input = bytes.Bytes(r"""{"z":1,"a":2}""")?
    json.validate(json_input, json_decode_options())?
    let json_canonical = json.canonicalize(json_input, json_decode_options())?
    assert(String(json_canonical)? == r"""{"a":2,"z":1}""")

    let json_value = json.parse(json_input, json_decode_options())?
    let _json_view = json.parseView(json_input, json_decode_options())?
    let _json_raw = json.raw(json_input)?
    let unchecked_raw = unsafe { json.rawUnchecked(bytes.Bytes("not-json")?) }
    _ = unchecked_raw
    let json_value_canonical = json.encodeCanonical(json_value, json_limits())?
    assert(String(json_value_canonical)? == r"""{"a":2,"z":1}""")

    let typed_input = bytes.Bytes("[1,2,3]")?
    let typed_values = json.decode[Array[Int]](typed_input, json_decode_options())?
    assert(typed_values == [1, 2, 3])
    let typed_output = json.encode[Array[Int]](typed_values, json_encode_options())?
    assert(String(typed_output)? == "[1,2,3]")

    let user_output = json.encode[JsonUser](
        JsonUser { id: 7, name: "Tondo" },
        json_encode_options(),
    )?
    assert(String(user_output)? == r"""{"id":7,"name":"Tondo"}""")
    let user = json.decode[JsonUser](user_output, json_decode_options())?
    assert(user.id == 7)
    assert(user.name == "Tondo")

    let policy_output = json.encode[JsonWirePolicy](
        JsonWirePolicy {
            id: 7
            payload: bytes.Bytes("hello")?
            legacy: some(99)
            nickname: none
        },
        json_encode_options(),
    )?
    assert(String(policy_output)? == r"""{"wire_id":7,"payload":"aGVsbG8=","nickname":null}""")
    let policy = json.decode[JsonWirePolicy](policy_output, json_decode_options())?
    assert(policy.id == 7)
    assert(policy.payload.equal(bytes.Bytes("hello")?))
    assert(policy.legacy == none)
    assert(policy.nickname == none)
    let permuted_policy = json.decode[JsonWirePolicy](
        bytes.Bytes(r"""{"nickname":"Tony","payload":"aGVsbG8=","wire_id":7}""")?,
        json_decode_options(),
    )?
    assert(permuted_policy.id == 7)
    assert(permuted_policy.nickname == some("Tony"))
    match json.decode[JsonWirePolicy](
        bytes.Bytes(r"""{"wire_id":7,"payload":"aGVsbG8=","extra":true}""")?,
        json_decode_options(),
    ) {
        ok(_) => assert(false)
        err(error) => match error.kind {
            json.JsonErrorKind.UnknownField => ()
            _ => assert(false)
        }
    }
    match json.decode[JsonWirePolicy](
        bytes.Bytes(r"""{"payload":"aGVsbG8="}""")?,
        json_decode_options(),
    ) {
        ok(_) => assert(false)
        err(error) => match error.kind {
            json.JsonErrorKind.MissingField => ()
            _ => assert(false)
        }
    }
    match json.decode[JsonWirePolicy](
        bytes.Bytes(r"""{"wire_id":7,"wire_id":8,"payload":"aGVsbG8="}""")?,
        json_decode_options(),
    ) {
        ok(_) => assert(false)
        err(error) => match error.kind {
            json.JsonErrorKind.DuplicateKey => ()
            _ => assert(false)
        }
    }
    match json.decode[JsonWirePolicy](
        bytes.Bytes(r"""{"wire_id":7,"payload":"%%%"}""")?,
        json_decode_options(),
    ) {
        ok(_) => assert(false)
        err(error) => match error.kind {
            json.JsonErrorKind.TypeMismatch => ()
            _ => assert(false)
        }
    }

    let composite_output = json.encode[JsonComposite](
        JsonComposite { small: Byte(7u8), tags: ["a", "b"], nickname: none },
        json_encode_options(),
    )?
    assert(String(composite_output)? == r"""{"small":7,"tags":["a","b"],"nickname":null}""")
    let composite = json.decode[JsonComposite](composite_output, json_decode_options())?
    assert(composite.small == Byte(7u8))
    assert(composite.tags == ["a", "b"])
    assert(composite.nickname == none)

    let empty_output = json.encode[JsonChoice](JsonChoice.Empty, json_encode_options())?
    assert(String(empty_output)? == r"""{"Empty":null}""")
    match json.decode[JsonChoice](empty_output, json_decode_options())? {
        JsonChoice.Empty => ()
        _ => assert(false)
    }
    let number_output = json.encode[JsonChoice](JsonChoice.Number(9), json_encode_options())?
    assert(String(number_output)? == r"""{"Number":[9]}""")
    match json.decode[JsonChoice](number_output, json_decode_options())? {
        JsonChoice.Number(value) => assert(value == 9)
        _ => assert(false)
    }
    let named_output = json.encode[JsonChoice](
        JsonChoice.Named { name: "typed" },
        json_encode_options(),
    )?
    assert(String(named_output)? == r"""{"Named":{"name":"typed"}}""")
    match json.decode[JsonChoice](named_output, json_decode_options())? {
        JsonChoice.Named { name } => assert(name == "typed")
        _ => assert(false)
    }
    for invalid_choice in [
        r"""{"Other":null}""",
        r"""{"Number":9}""",
        r"""{"Empty":null,"Other":null}""",
        r"""{"Empty":null} true""",
    ] {
        match json.decode[JsonChoice](bytes.Bytes(invalid_choice)?, json_decode_options()) {
            ok(_) => assert(false)
            err(error) => match error.kind {
                json.JsonErrorKind.TypeMismatch => ()
                json.JsonErrorKind.TrailingData => ()
                json.JsonErrorKind.UnknownField => ()
                json.JsonErrorKind.DuplicateKey => ()
                _ => assert(false)
            }
        }
    }

    assert(json.decode[Bool](bytes.Bytes("true")?, json_decode_options())? == true)
    assert(json.decode[Array[String]](bytes.Bytes(r"""["text"]""")?, json_decode_options())? == ["text"])
    assert(json.decode[Unit](bytes.Bytes("null")?, json_decode_options())? == ())
    assert(json.decode[Byte](bytes.Bytes("255")?, json_decode_options())? == Byte(255u8))
    assert(json.decode[Int16](bytes.Bytes("-32768")?, json_decode_options())? == -32768i16)
    assert(json.decode[UInt32](bytes.Bytes("4294967295")?, json_decode_options())? == 4294967295u32)
    assert(json.decode[Float32](bytes.Bytes("1.5")?, json_decode_options())? == 1.5f32)
    assert(json.decode[Float64](bytes.Bytes("2.5")?, json_decode_options())? == 2.5)
    assert(json.decode[Int?](bytes.Bytes("null")?, json_decode_options())? == none)
    assert(json.decode[Int?](bytes.Bytes("7")?, json_decode_options())? == some(7))
    let typed_object = json.decode[Map[String, Int]](bytes.Bytes(r"""{"a":1}""")?, json_decode_options())?
    assert(typed_object == ["a": 1])
    let typed_object_output = json.encode[Map[String, Int]](typed_object, json_encode_options())?
    assert(String(typed_object_output)? == r"""{"a":1}""")
    assert(String(json.encode[Bool](true, json_encode_options())?)? == "true")
    assert(String(json.encode[Int?](none, json_encode_options())?)? == "null")
    assert(String(json.encode[Int?](some(7), json_encode_options())?)? == "7")
    match json.decode[Byte](bytes.Bytes("256")?, json_decode_options()) {
        ok(_) => assert(false)
        err(_) => ()
    }
    match json.decode[Int](bytes.Bytes("1.5")?, json_decode_options()) {
        ok(_) => assert(false)
        err(_) => ()
    }
    match json.decode[UInt64](bytes.Bytes("-1")?, json_decode_options()) {
        ok(_) => assert(false)
        err(_) => ()
    }
    match json.decode[UInt32](bytes.Bytes("4294967296")?, json_decode_options()) {
        ok(_) => assert(false)
        err(_) => ()
    }
    match json.decode[Float32](bytes.Bytes("1e1000")?, json_decode_options()) {
        ok(_) => assert(false)
        err(_) => ()
    }
    match json.decode[Float64](bytes.Bytes("1e10000")?, json_decode_options()) {
        ok(_) => assert(false)
        err(_) => ()
    }

    let number = json.JsonNumber.parse("42")?
    assert(number.text() == "42")
    assert(number.toInt()? == 42)
    assert(number.toUInt()? == 42u64)
    assert(number.toFloat32()? == 42.0f32)
    assert(number.toFloat64()? == 42.0)

    let scalar = bytes.Bytes("42")?
    var event_reader = json.JsonReader.fromBytes(scalar, json_decode_options())?
    let event = match event_reader.next()? {
        some(value) => event_reader.own(value)?
        none => panic("JSON scalar must publish one event")
    }
    match event_reader.next()? {
        some(_) => panic("JSON scalar must publish exactly one event")
        none => ()
    }
    event_reader.finish()?

    var stdout = console.stdout()?
    var event_writer = json.JsonWriter.toWriter(var stdout, json_encode_options())?
    event_writer.write(event)?
    event_writer.finish()?

    var stdin = console.stdin()?
    let _reader_from_io = json.JsonReader.fromReader(var stdin, json_decode_options())?

    let duplicate = bytes.Bytes(r"""{"a":1,"a":2}""")?
    match json.validate(duplicate, json_decode_options()) {
        ok(_) => assert(false)
        err(error) => match error.kind {
            json.JsonErrorKind.DuplicateKey => {
                assert(error.location.offset > 0)
                assert(error.location.line == 1)
            }
            _ => assert(false)
        }
    }
    let first = json.parse(
        duplicate,
        json_decode_options_with(json_limits(), json.JsonDuplicatePolicy.First),
    )?
    assert(String(json.encodeCanonical(first, json_limits())?)? == r"""{"a":1}""")
    let last = json.parse(
        duplicate,
        json_decode_options_with(json_limits(), json.JsonDuplicatePolicy.Last),
    )?
    assert(String(json.encodeCanonical(last, json_limits())?)? == r"""{"a":2}""")

    let tiny_document = json_decode_options_with(
        json_limits_with(1, 1048576),
        json.JsonDuplicatePolicy.Reject,
    )
    match json.validate(bytes.Bytes(r"""{}""")?, tiny_document) {
        ok(_) => assert(false)
        err(error) => match error.kind {
            json.JsonErrorKind.LimitExceeded => assert(error.location.line == 1)
            _ => assert(false)
        }
    }
    let tiny_output = json_limits_with(1048576, 1)
    match json.encodeCanonical(last, tiny_output) {
        ok(_) => assert(false)
        err(_) => ()
    }

    let messagepack_input = bytes.fromArray([
        Byte(0x82u8), Byte(0xa1u8), Byte(0x7au8), Byte(1u8),
        Byte(0xa1u8), Byte(0x61u8), Byte(2u8)
    ])?
    messagepack.validate(messagepack_input)?
    let messagepack_canonical = messagepack.canonicalize(messagepack_input)?
    assert(messagepack_canonical.equal(bytes.fromArray([
        Byte(0x82u8), Byte(0xa1u8), Byte(0x61u8), Byte(2u8),
        Byte(0xa1u8), Byte(0x7au8), Byte(1u8)
    ])?))

    let protobuf_input = bytes.fromArray([
        Byte(0x08u8), Byte(0x96u8), Byte(0x01u8),
        Byte(0x12u8), Byte(0x02u8), Byte(0x6fu8), Byte(0x6bu8)
    ])?
    protobuf.validate(protobuf_input)?
    console.print("\ncodecs-ok\n")
}
