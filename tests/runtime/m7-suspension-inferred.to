import std.async
import std.console

fn compute(): Int {
    let pair = async.oneshot[Int, String]()
    var (waiter, completer) = pair
    _ = completer.complete(42)
    let value = waiter.wait()
    match value {
        ok(result) => result
        err(_) => 0
    }
}

fn exercise_fail() {
    let pair = async.oneshot[Int, String]()
    var (waiter, completer) = pair
    _ = completer.fail("failed")
    _ = waiter.wait()
}

fn exercise_cancel() {
    let pair = async.oneshot[Int, String]()
    var (waiter, completer) = pair
    _ = completer.cancel()
    _ = waiter.wait()
}

fn main() {
    assert(compute() == 42)
    console.print("suspension-inferred-ok\n")
}
