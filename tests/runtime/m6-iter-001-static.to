import std.console

type Countdown = {
    remaining: Int
}

impl Iterator[Int] for Countdown {
    fn next(mut self): Int? {
        if self.remaining == 0 {
            return none
        }
        let current = self.remaining
        self.remaining -= 1
        some(current)
    }
}

fn main() {
    var code = 0
    for value in Countdown { remaining: 3 } {
        code = code * 10 + value
    }
    assert(code == 321)
    console.print("static-iterator\n")
}
