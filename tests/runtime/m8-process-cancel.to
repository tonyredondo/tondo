import std.console
import std.process

async fn cancelProcess(command: String): !process.ProcessError {
    scope {
        let pending = spawn process.shell(command).output()
        return
    }
}

async fn main(): !process.ProcessError {
    let hostCommands = process.args()
    await cancelProcess(hostCommands[0])?
    console.print("process-cancelled\n")
}
