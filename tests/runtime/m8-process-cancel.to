import std.console
import std.process
import std.env

fn argument(value: env.Value): String {
    match value.asText() {
        some(argumentText) => argumentText
        none => panic("process fixture argument is not UTF-8")
    }
}

fn cancelProcess(command: String): !process.ProcessError suspends {
    scope {
        let pending = spawn process.shell(command).output()
        return
    }
}

fn main(): !(process.ProcessError | env.EnvError) suspends {
    let hostArguments = env.snapshot()?.arguments()
    cancelProcess(argument(hostArguments[0]))?
    console.print("process-cancelled\n")
}
