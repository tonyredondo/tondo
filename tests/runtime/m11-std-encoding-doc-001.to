import std.bytes
import std.console
import std.encoding

fn policy_selection(): !(bytes.BytesError | bytes.Utf8Error | console.ConsoleError | encoding.EncodingError) {
    let limits = encoding.EncodingLimits.defaults()
    let source = bytes.Bytes("fo")?
    let standard = encoding.Base64Options.standard(limits)
    let url = encoding.Base64Options.urlSafeUnpadded(limits)
    let lower = encoding.HexOptions.lower(limits)
    let upper = encoding.HexOptions.upper(limits)
    assert(String(standard.encode(source)?)? == "Zm8=")
    assert(String(url.encode(source)?)? == "Zm8")
    assert(String(lower.encode(source)?)? == "666f")
    assert(String(upper.encode(source)?)? == "666F")
}

fn materialized_examples(): !(bytes.BytesError | bytes.Utf8Error | console.ConsoleError | encoding.EncodingError) {
    let limits = encoding.EncodingLimits.defaults()
    let source = bytes.Bytes("fo")?
    let standard = encoding.Base64Options.standard(limits)
    let encoded = standard.encode(source)?
    let decoded = standard.decode(encoded)?
    assert(String(decoded)? == "fo")

    let any_case = encoding.HexOptions.anyCase(limits)
    let mixed = any_case.decode(bytes.Bytes("66 6F")?)
    match mixed {
        ok(_) => assert(false)
        err(error) => match error.kind {
            encoding.EncodingErrorKind.InvalidCharacter => assert(error.offset == 2)
            _ => assert(false)
        }
    }
    let hex = encoding.HexOptions.upper(limits).encode(source)?
    assert(String(hex)? == "666F")
    assert(String(any_case.decode(hex)?)? == "fo")
}

fn streaming_examples(): !(bytes.BytesError | bytes.Utf8Error | console.ConsoleError | encoding.EncodingError) {
    let limits = encoding.EncodingLimits.defaults()
    var encoder = encoding.Base64Options.urlSafeUnpadded(limits).encoder()?
    let first = encoder.push(bytes.Bytes("f")?)?
    let second = encoder.push(bytes.Bytes("o")?)?
    assert(first.length() == 0)
    assert(second.length() == 0)
    let tail = encoder.finish()?
    assert(String(tail)? == "Zm8")

    var decoder = encoding.Base64Options.standard(limits).decoder()?
    let decoded_first = decoder.push(bytes.Bytes("Z")?)?
    let decoded_second = decoder.push(bytes.Bytes("g==")?)?
    assert(decoded_first.length() == 0)
    assert(String(decoded_second)? == "f")
    let decoded_tail = decoder.finish()?
    assert(decoded_tail.length() == 0)

    var hex_encoder = encoding.HexOptions.upper(limits).encoder()?
    let hex_output = hex_encoder.push(bytes.Bytes("fo")?)?
    assert(String(hex_output)? == "666F")
    let hex_tail = hex_encoder.finish()?
    assert(hex_tail.length() == 0)
}

fn errors_and_limits(): !(bytes.BytesError | bytes.Utf8Error | console.ConsoleError | encoding.EncodingError) {
    let limits = encoding.EncodingLimits.defaults()
    match encoding.Base64Options.standard(limits).decode(bytes.Bytes("Zh==")?) {
        ok(_) => assert(false)
        err(error) => match error.kind {
            encoding.EncodingErrorKind.NonCanonical => assert(error.offset == 0)
            _ => assert(false)
        }
    }

    let tiny = encoding.EncodingLimits.create(2, 3)?
    match encoding.Base64Options.standard(tiny).encode(bytes.Bytes("fo")?) {
        ok(_) => assert(false)
        err(error) => match error.kind {
            encoding.EncodingErrorKind.ResourceLimit => assert(error.offset == 0)
            _ => assert(false)
        }
    }

    var encoder = encoding.Base64Options.standard(limits).encoder()?
    let _ = encoder.finish()?
    match encoder.finish() {
        ok(_) => assert(false)
        err(error) => match error.kind {
            encoding.EncodingErrorKind.Closed => assert(error.offset == 0)
            _ => assert(false)
        }
    }
}

fn costs_and_ownership(): !(bytes.BytesError | bytes.Utf8Error | console.ConsoleError | encoding.EncodingError) {
    let limits = encoding.EncodingLimits.create(2, 4)?
    var encoder = encoding.Base64Options.standard(limits).encoder()?
    let carried = encoder.push(bytes.Bytes("f")?)?
    assert(carried.length() == 0)
    let tail = encoder.finish()?
    assert(String(tail)? == "Zg==")
}

fn writer_example(): !(bytes.BytesError | bytes.Utf8Error | console.ConsoleError | encoding.EncodingError) suspends {
    let limits = encoding.EncodingLimits.defaults()
    let source = bytes.Bytes("fo")?
    let standard = encoding.Base64Options.standard(limits)
    var output = console.stdout()?
    standard.encodeTo(source, var output)?
    console.println("encoding-doc-ok")
}

fn main(): !(bytes.BytesError | bytes.Utf8Error | console.ConsoleError | encoding.EncodingError) {
    policy_selection()?
    materialized_examples()?
    streaming_examples()?
    errors_and_limits()?
    costs_and_ownership()?
    writer_example()?
}
