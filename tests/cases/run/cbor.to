// CBOR: the examples of RFC 8949's appendix A, malformed items, any type
// written in the preferred serialization and read back, and keys in the
// deterministic order.
import std.cbor
import std.console
import std.encoding
import std.json
import std.serialization
import std.time

type Point = { x: Int, y: Int }
enum Shape {
    Empty
    Circle(Float)
    Polygon { name: String, points: Array[Point] }
}
type Packet = {
    id: Int
    name: String
    shapes: Array[Shape]
    data: serialization.Bytes
    at: time.DateTime
    note: String?
}

fn main(): !(cbor.CborError | time.TimeError) {
    let vectors = [
        "00", "17", "1818", "1903e8", "1b000000e8d4a51000", "1bffffffffffffffff", "20", "3863", "3903e7",
        "f90000", "f98000", "f93c00", "fb3ff199999999999a", "f93e00", "f97bff", "fa47c35000", "f90001",
        "f9c400", "f97c00", "f97e00", "f4", "f5", "f6", "f7",
        "c074323031332d30332d32315432303a30343a30305a", "c11a514b67b0", "c1fb41d452d9ec200000",
        "40", "4401020304", "60", "6449455446", "62c3bc", "63e6b0b4",
        "80", "8301820203820405", "a26161016162820203", "a201020304",
        "5f42010243030405ff", "7f657374726561646d696e67ff", "9fff", "9f018202039f0405ffff",
        "bf61610161629f0203ffff", "c249010000000000000000", "ff", "8201", "1c",
    ]
    for vector in vectors {
        match cbor.parse(encoding.hexDecode(vector).unwrapOr([])) {
            ok(value) => console.println("{vector} {value}")
            err(error) => console.println("{vector} {error}")
        }
    }
    let packet = Packet {
        id: 7
        name: "café"
        shapes: [Shape.Empty, Shape.Circle(1.5), Shape.Polygon { name: "tri", points: [Point { x: 1, y: -2 }] }]
        data: serialization.Bytes("hi".bytes())
        at: time.parseDateTime("2013-03-21T20:04:00Z")?
        note: none
    }
    let bytes = cbor.encode(packet)
    console.println(encoding.hexEncode(bytes))
    console.println(json.encode(cbor.decode[Packet](bytes)?))
    let keys = ["b": 1, "a": 2, "aa": 3]
    console.println("{encoding.hexEncode(cbor.encode(keys))} {encoding.hexEncode(cbor.encode(keys, deterministic: true))}")
}
