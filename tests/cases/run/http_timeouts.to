// A body that stops arriving for longer than `bodyTimeout` is a 408, and a
// client that takes none of its reply for `replyTimeout` loses the
// connection, so the stream that writes it stops.
import std.console
import std.http
import std.io
import std.net
import std.time

fn feed(writer: io.Writer, done: Sender[String]) {
    let chunk = "x".repeat(65536)
    for {
        match writer.write(chunk) {
            ok(_) => {}
            err(_) => break
        }
    }
    done.send("the client stopped taking it")
}

fn main(): !(http.HttpError | net.NetError) {
    let (done, stopped) = channel[String](1)
    var app = http.App()
    app.post("/upload", (request) { http.Reply.text("got {request.text()?}") })
    app.get(
        "/big",
        (_) {
            let (writer, reader) = io.pipe()
            spawn detached feed(writer, done.copy())
            http.Reply.stream(reader)
        },
    )
    let limits = http.Limits.standard() with {
        bodyTimeout: time.milliseconds(100)
        replyTimeout: time.milliseconds(100)
    }
    let server = app.start(limits: limits)?
    let port = Int.parse(server.address().split(":").last().unwrapOr("0")).unwrapOr(0)
    // Ten bytes promised, three sent.
    let uploader = net.connect("127.0.0.1", port)?
    uploader.write("POST /upload HTTP/1.1\r\nHost: a\r\nContent-Length: 10\r\n\r\nabc")?
    let answer = String.fromBytes(uploader.readAll()?).unwrapOr("")
    console.println(answer.lines().first().unwrapOr(""))
    console.println(answer.lines().last().unwrapOr(""))
    // A reply asked for and never read.
    let reader = net.connect("127.0.0.1", port)?
    reader.write("GET /big HTTP/1.1\r\nHost: a\r\n\r\n")?
    console.println(stopped.receive().unwrapOr("closed"))
    server.stop()
}

// expect-stdout: HTTP/1.1 408 Request Timeout
// expect-stdout: {"status":408,"detail":"the body stopped arriving for longer than this server waits, `Limits.bodyTimeout`"}
// expect-stdout: the client stopped taking it
