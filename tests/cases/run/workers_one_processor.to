// On one processor, as a container of one, the runtime counts one worker of
// its own. A task that computes and never asks holds it; when it has held
// it for two intervals while `main`, whose sleep ended, waits, another
// worker starts beside it (16.14), and the system shares the one processor
// between the two threads: `main` runs while the computation goes on. The
// computation ends only when `main` tells it to, so a slow or busy machine
// can make the program take longer but never print otherwise.

import std.console
import std.env
import std.sync
import std.time

/// Computes without waiting until `stop` is set, then says so.
fn busy(stop: sync.Atomic[Bool], done: sync.Atomic[Bool]): Int {
    var turns = 0
    for not stop.load() {
        turns += 1
    }
    done.store(true)
    turns
}

fn main() {
    console.println("{env.workers()} worker")
    let (stop, done) = (sync.Atomic(false), sync.Atomic(false))
    let job = spawn busy(stop, done)
    time.sleep(time.milliseconds(20))
    console.println("main ran while it computed: {not done.load()}")
    stop.store(true)
    _ = job.wait()
}

// expect-platform: linux
// expect-processors: 1
// expect-no-schedule: the explorer runs one worker and adds none, so a computation that does not ask holds it, by design
// expect-no-replay: a recorded run, too, runs its tasks on one worker that adds none
// expect-stdout: 1 worker
// expect-stdout: main ran while it computed: true
