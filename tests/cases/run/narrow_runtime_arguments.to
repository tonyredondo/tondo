import std.console

// Regression: a `Bool` passed to the runtime must be zero-extended, as the C
// ABI implemented by LLVM expects; garbage high bits printed "fals".
fn main() {
    let zero = 0.0
    let x = zero / zero
    console.println("{x == x}")
    console.println("{x < x}")
}

// expect-stdout: false
// expect-stdout: false
