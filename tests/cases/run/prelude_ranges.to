// Ranges as values, and the lazy views of strings and arrays.

import std.console

fn evens(range: Range[Int]): Array[Int] {
    range.filter((n) { n % 2 == 0 }).collect()
}

fn main() {
    let r = 0..10
    console.println("{r} {evens(r)} {(1..=5).map((n) { n * n }).collect()} {(5..1).count()}")
    console.println("{3 in r} {10 in r} {10 in 0..=10} {'b' in 'a'..'c'} {r.contains(-1)} {'ñ' in "año"} {'n' in "año"}")
    var letters = ""
    for c in 'a'..='e' {
        letters = "{letters}{c}"
    }
    console.println(letters)
    var countdown = 1..=3
    console.println("{countdown.next()} {countdown} {countdown.collect()}")
    let shout = "héllo wörld".chars().filter((c) { c != 'l' }).map((c) { c.toUpper() }).collect()
    console.println("{shout} {"añb".chars().count()}")
    console.println("{["x", "y"].iter().enumerate().collect()} {[1, 2, 3].iter().zip(10..20).collect()}")
    let top: Range[UInt8] = 250..=255
    console.println("{top.collect()} {('\u{D7FE}'..='\u{E001}').map((c) { c.code() }).collect()}")
}

// expect-stdout: 0..10 [0, 2, 4, 6, 8] [1, 4, 9, 16, 25] 0
// expect-stdout: true false true true false true false
// expect-stdout: abcde
// expect-stdout: some(1) 2..=3 [2, 3]
// expect-stdout: [H, É, O,  , W, Ö, R, D] 3
// expect-stdout: [(0, x), (1, y)] [(1, 10), (2, 11), (3, 12)]
// expect-stdout: [250, 251, 252, 253, 254, 255] [55294, 55295, 57344, 57345]
