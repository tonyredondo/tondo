// Readers that wait too long for a `RwLock` that a writer keeps taking are
// handed it when the writer lets it go (standard library 14.4.4.1): each
// reads between two of its updates, and every update lands.
import std.console
import std.sync
import std.time

fn hammer(lock: sync.RwLock[Int], holding: sync.Atomic[Bool], rounds: Int) {
    for _ in 0..rounds {
        lock.update(
            (value) {
                holding.store(true)
                time.sleep(time.milliseconds(2))
                value += 1
            },
        )
    }
}

fn read(lock: sync.RwLock[Int]): Int {
    lock.read((value) { value })
}

fn main() {
    let lock = sync.RwLock(0)
    let holding = sync.Atomic(false)
    let writer = spawn hammer(lock, holding, 10)
    for not holding.load() {
        time.sleep(time.milliseconds(1))
    }
    var readers = Group[Int]()
    for _ in 0..3 {
        readers.add(spawn read(lock))
    }
    let seen = readers.wait()
    writer.wait()
    console.println("readers read what the writer wrote: {seen.all((value) { value >= 0 and value <= 10 })}")
    console.println("updates: {lock.get()}")
}

// expect-stdout: readers read what the writer wrote: true
// expect-stdout: updates: 10
