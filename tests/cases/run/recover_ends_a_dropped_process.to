// A started process whose handle a panic's unwinding drops is ended, as
// the unwinding cancels what else the block owns (19.2 of the library):
// its stages end and are waited for, not its pipes, and the `recover` gives
// its `err` at once, where it waited for the process as a `Join`, half a
// minute here. Nothing is left: the process is gone and nothing leaks. A
// handle the block lets go of as it ends, with no panic, is still waited
// for.
import std.console
import std.process
import std.sync
import std.time

fn holding(id: sync.Atomic[Int]) {
    match process.command("sleep", "30").stdout(process.Output.Capture).start() {
        ok(running) => {
            id.store(running.id())
            panic("on purpose")
        }
        err(_) => {}
    }
}

fn gone(id: Int): Bool {
    match process.command("kill", "-0", "{id}").stderr(process.Output.Null).status() {
        ok(status) => not status.success
        err(_) => false
    }
}

fn main() {
    let id = sync.Atomic(0)
    let since = time.now()
    let caught = recover { holding(id) }
    let quick = since.elapsed().seconds() < 10
    console.println(
        "a recovered panic: err {caught.isErr()}, at once {quick}, the process gone {gone(id.load())}",
    )
    let waited = time.now()
    match process.command("sleep", "0.2").start() {
        ok(running) => { id.store(running.id()) }
        err(_) => {}
    }
    let long = waited.elapsed().milliseconds() >= 200
    console.println(
        "a handle let go with no panic: waited for {long}, the process gone {gone(id.load())}",
    )
}

// expect-stdout: a recovered panic: err true, at once true, the process gone true
// expect-stdout: a handle let go with no panic: waited for true, the process gone true
// expect-no-replay: a recorded run has one worker, and runs a process's wait on it, where nothing ends it
