// A value a call gives back whole while a task of the same `recover` has
// ended with a panic: the check after the call leaves the panic to the next
// one, with nothing in hand, and the caller lets the value go as it
// unwinds. Each call reads a pipe that another task opens once the call
// has, and closes only once the task that panics has ended, so the panic
// always comes with the value in hand; the leak check counts what is not
// let go.
import std.console
import std.fs
import std.process
import std.sync
import std.tasks
import std.time

// Panics once the call of main is inside its read.
fn crash(inside: sync.Atomic[Int], n: Int): Int {
    for inside.load() == 0 {
        time.sleep(time.milliseconds(1))
    }
    panic("task {n} panicked")
}

fn written(inside: sync.Atomic[Int], first: Join[Int], pipe: String) {
    _ = wrote(inside, first, pipe)
}

// The open waits for the call of main to open the pipe too; the close,
// which ends the call, comes once `first` has ended.
fn wrote(inside: sync.Atomic[Int], first: Join[Int], pipe: String): !fs.FsError {
    var file = fs.open(pipe, fs.OpenMode.Append)?
    file.write("written before the other task panicked\n")?
    file.flush()?
    inside.store(1)
    _ = recover { first.wait() }
    file.close()?
}

fn madePipe(name: String): String {
    _ = fs.remove(name)
    _ = process.command("mkfifo", name).output()
    name
}

fn main() {
    let text = madePipe("given-back-text")
    match recover {
        let inside = sync.Atomic(0)
        let first = spawn crash(inside, 1)
        let writer = spawn written(inside, first, text)
        let read = fs.readText(text)
        tasks.checkpoint()
        console.println("read {read.isOk()}")
        writer.wait()
    } {
        ok(_) => console.println("ended")
        err(stopped) => console.println("recovered {stopped.message}")
    }
    let bytes = madePipe("given-back-bytes")
    match recover {
        let inside = sync.Atomic(0)
        let first = spawn crash(inside, 2)
        let writer = spawn written(inside, first, bytes)
        let read = fs.readBytes(bytes)
        tasks.checkpoint()
        console.println("read {read.isOk()}")
        writer.wait()
    } {
        ok(_) => console.println("ended")
        err(stopped) => console.println("recovered {stopped.message}")
    }
    // A call that waits for its process stops waiting when the panic
    // comes, and gives back nothing: the panic is delivered right after it.
    let output = madePipe("given-back-output")
    match recover {
        let inside = sync.Atomic(0)
        let first = spawn crash(inside, 3)
        let writer = spawn written(inside, first, output)
        let read = process.command("cat", output).output()
        tasks.checkpoint()
        console.println("read {read.isOk()}")
        writer.wait()
    } {
        ok(_) => console.println("ended")
        err(stopped) => console.println("recovered {stopped.message}")
    }
    for name in [text, bytes, output] {
        _ = fs.remove(name)
    }
}

// expect-stdout: recovered task 1 panicked
// expect-stdout: recovered task 2 panicked
// expect-stdout: recovered task 3 panicked
// expect-no-replay: a recorded run has one worker, which the call blocked in C keeps from the task that writes the pipe
// expect-no-schedule: one worker runs the tasks, which the call blocked in C keeps from the task that writes the pipe
