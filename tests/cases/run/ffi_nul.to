// Text with a zero byte inside has no C string (P0016).
import std.ffi

extern fn strlen(text: ffi.CString): ffi.CSize

fn main() {
    let text = "a\u{0}b"
    unsafe { strlen(text) }
}

// expect-panic: P0016
// expect-stderr: panic[P0016]: nul-in-c-string: the text has a zero byte at 1, so C would see it end there
