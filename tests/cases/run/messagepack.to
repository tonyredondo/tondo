// MessagePack: any type written in the shortest forms and read back, bytes
// and timestamps native, values of unknown shape, forms that other encoders
// write, and errors with where they happened.
import std.console
import std.encoding
import std.json
import std.messagepack
import std.serialization
import std.time

type Point = { x: Int, y: Int }
enum Shape {
    Empty
    Circle(Float)
    Polygon { name: String, points: Array[Point] }
}
type Packet = {
    id: Int
    big: Int
    name: String
    tags: Array[String]
    shapes: Array[Shape]
    data: serialization.Bytes
    at: time.DateTime
    note: String?
}

fn main(): !(messagepack.MessagePackError | time.TimeError) {
    vectors()
    let packet = Packet {
        id: 7
        big: -9000000000
        name: "café"
        tags: ["a", "b"]
        shapes: [Shape.Empty, Shape.Circle(1.5), Shape.Polygon { name: "tri", points: [Point { x: 1, y: 2 }] }]
        data: serialization.Bytes("hi".bytes())
        at: time.parseDateTime("2026-10-23T08:00:00.5Z")?
        note: none
    }
    let bytes = messagepack.encode(packet)
    console.println("{bytes.length()} {encoding.hexEncode(bytes)}")
    let back = messagepack.decode[Packet](bytes)?
    console.println("{json.encode(back)}")
    console.println("{messagepack.parse(bytes)?}")
    console.println("{messagepack.encode(1)} {messagepack.encode(-1)} {messagepack.encode(300)} {messagepack.encode("")}")
    match messagepack.decode[Packet](encoding.hexDecode("81a26964a178").unwrapOr([])) {
        ok(_) => console.println("decoded")
        err(error) => console.println("{error}")
    }
    match messagepack.parse(encoding.hexDecode("9201").unwrapOr([])) {
        ok(_) => console.println("parsed")
        err(error) => console.println("{error}")
    }
    match messagepack.parse(encoding.hexDecode("c1").unwrapOr([])) {
        ok(_) => console.println("parsed")
        err(error) => console.println("{error}")
    }
}

/// Forms of the specification that are not the shortest, as other encoders
/// write them.
fn vectors() {
    let forms = [
        "cd012c", "d1fed4", "ca3fc00000", "d90161", "c40100", "dc000101", "de0001a161c0",
        "d6ff00000000", "c70cff000000000000000000000001", "cf8000000000000000",
    ]
    for form in forms {
        match messagepack.parse(encoding.hexDecode(form).unwrapOr([])) {
            ok(value) => console.println("{form} {value}")
            err(error) => console.println("{form} {error}")
        }
    }
}
