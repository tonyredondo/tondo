// A call whose wait the deadline of its `within` ends gives back nothing,
// as 11.15 says of any operation that waited: the unwinding to the block
// starts in the call, and the check after it delivers it at once, with
// nothing in hand to let go. The call runs `cat` on a pipe that nothing
// writes, so only the deadline ends its wait, which stops the process.
// Before, the call gave back what it had, `ok` with no output, and the
// statement after it ran; the leak check counts what is not let go.
import std.console
import std.fs
import std.process
import std.tasks
import std.time

fn main() {
    let name = "within-given-back"
    _ = fs.remove(name)
    _ = process.command("mkfifo", name).output()
    match within time.milliseconds(10) {
        let read = process.command("cat", name).output()
        tasks.checkpoint()
        console.println("read {read.isOk()}")
    } {
        ok(_) => console.println("in time")
        err(_) => console.println("past its deadline")
    }
    _ = fs.remove(name)
}

// expect-stdout: past its deadline
// expect-no-replay: a recorded run calls the process on its one thread, where no deadline ends the wait
// expect-no-schedule: the virtual clock of an order stands still while a task waits on the host, so the deadline never passes
