import std.console

// A check a loop keeps says which bound the compiler lacked: what nothing
// bounds, and from which side; a difference grows as what it takes away
// falls.

fn steps(start: Int): Int {
    var count = 0
    var x = start
    for x > 1 {
        x = if x % 2 == 0 { x / 2 } else { x * 3 + 1 }
        count += 1
    }
    count
}

fn letters(text: String): Int {
    var count = 0
    for c in text.chars() {
        if c.isLetter() {
            count += 1
        }
    }
    count
}

fn total(parts: Array[String]): Int {
    var sum = 0
    for part in parts {
        sum += Int.parse(part) ?? 0
    }
    sum
}

fn widest(words: Array[Int]): Int {
    var most = 0
    for word in words {
        most = most.max(64 - word.leadingZeros())
    }
    most
}

fn main() {
    console.println("{steps(6)} {letters("ab1")} {total(["1", "2"])} {widest([5, 300])}")
}

// expect-stdout: 8 2 3 9
// expect-optimization: 12:9 checked keeps its overflow check, in a loop: nothing bounds `count` from above
// expect-optimization: 21:13 unchecked cannot overflow: no check
// expect-optimization: 30:9 checked nothing bounds `sum` from above, nor what is added from above
// expect-optimization: 38:25 checked nothing bounds what is taken away from below
