import std.console

enum Level {
    Low
    High
}

type Point = {
    x: Int
    y: Int
}

fn greet(name: String, greeting: String = "hello", times: Int = 1): String {
    var text = ""
    for _ in 0..times {
        text = "{text}{greeting} {name} "
    }
    text
}

fn pick[T](values: Array[T], fallback: T? = none): T? {
    match values.length() {
        0 => fallback
        _ => some(values[0])
    }
}

fn describe(
    level: Level = Level.High,
    origin: Point = Point { x: 0, y: -1 },
    tags: Array[String] = [],
): String {
    let name = match level {
        Level.Low => "low"
        Level.High => "high"
    }
    "{name} {origin.x},{origin.y} {tags.length()}"
}

fn Point.moved(self, dx: Int = 1, dy: Int = 0): Point {
    Point { x: self.x + dx, y: self.y + dy }
}

fn main() {
    console.println(greet("ana"))
    console.println(greet("ana", "hi"))
    console.println(greet("ana", times: 2))
    console.println(greet(times: 3, name: "bo"))
    let empty: Array[Int] = []
    console.println("{pick([1, 2])} {pick(empty)} {pick(empty, some(7))}")
    console.println(describe())
    console.println(describe(Level.Low, tags: ["a"]))
    let p = Point { x: 1, y: 1 }.moved()
    let q = p.moved(dy: 5)
    console.println("{p.x},{p.y} {q.x},{q.y}")
}

// expect-stdout: hello ana 
// expect-stdout: hi ana 
// expect-stdout: hello ana hello ana 
// expect-stdout: hello bo hello bo hello bo 
// expect-stdout: some(1) none some(7)
// expect-stdout: high 0,-1 0
// expect-stdout: low 0,-1 1
// expect-stdout: 2,1 3,6
