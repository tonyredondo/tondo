import std.console

fn drain(inbox: Receiver[Int]) {
    for value in inbox {
        console.println("got {value}")
    }
}

// `main` keeps the sender, so the channel never closes.
fn main() {
    let (sender, receiver) = channel[Int]()
    sender.send(1)
    let job = spawn drain(receiver)
    job.wait()
}

// expect-stdout: got 1
// expect-panic: P0013
// expect-stderr: panic[P0013]: deadlock: every task waits and none of them can wake the others
// expect-stderr: the main task waits at:
// expect-stderr:   main  panic_deadlock.to:14:5
// expect-stderr: a task waits at:
// expect-stderr:   drain  panic_deadlock.to:4:18
// expect-stderr: in a task spawned at:
// expect-stderr:   main  panic_deadlock.to:13:15
