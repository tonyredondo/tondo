// Functions and closures without captures that C calls: on the calling
// task's thread, waiting meanwhile, and from a thread of C (FFI).
import std.console
import std.ffi

extern fn qsort(
    base: Pointer[ffi.Void],
    count: ffi.CSize,
    size: ffi.CSize,
    compare: extern fn(Pointer[ffi.Void], Pointer[ffi.Void]): ffi.CInt,
)

extern fn pthread_create(
    thread: Pointer[UInt64],
    attributes: Pointer[ffi.Void]?,
    start: extern fn(Pointer[ffi.Void]?): Pointer[ffi.Void]?,
    argument: Pointer[ffi.Void]?,
): ffi.CInt

extern fn pthread_join(thread: UInt64, result: Pointer[Pointer[ffi.Void]?]?): ffi.CInt

extern type Pair = {
    a: Int
    b: Float
}

extern type Big = {
    a: Int
    b: Int
    c: Int
}

unsafe fn descending(left: Pointer[ffi.Void], right: Pointer[ffi.Void]): ffi.CInt {
    let (a, b) = (left.cast[Int]().read(), right.cast[Int]().read())
    if a > b { -1 } else if a < b { 1 } else { 0 }
}

fn double(value: Int): Int {
    value * 2
}

// Waits for other tasks while C's frames are on this task's stack.
unsafe fn waiting(left: Pointer[ffi.Void], right: Pointer[ffi.Void]): ffi.CInt {
    let first = spawn double(left.cast[Int]().read())
    let second = spawn double(right.cast[Int]().read())
    if first.wait() < second.wait() { -1 } else { 1 }
}

fn swap(pair: Pair): Pair {
    Pair { a: 7, b: Float(pair.a) + pair.b }
}

fn grow(big: Big, by: Int): Big {
    Big { a: big.a + by, b: big.b + by, c: big.c + by }
}

fn send(sender: Sender[Int], value: Int) {
    sender.send(value * 2)
}

unsafe fn worker(argument: Pointer[ffi.Void]?): Pointer[ffi.Void]? {
    let counter = ffi.fromContext[Pointer[Int]](argument?)
    counter.write(counter.read() + 41)
    let (sender, receiver) = channel[Int]()
    let job = spawn send(sender, 21)
    let doubled = receiver.receive()
    job.wait()
    counter.write(counter.read() + doubled?)
    none
}

unsafe fn sorted(values: Pointer[Int], count: Int): Array[Int] {
    var out: Array[Int] = []
    for i in 0..count {
        out.push(values.offset(i).read())
    }
    out
}

fn main() {
    unsafe {
        let values = ffi.allocate[Int](6)
        let input = [5, 2, 8, 1, 9, 3]
        for i in 0..6 {
            values.offset(i).write(input[i])
        }
        qsort(values, 6u64, 8u64, descending)
        console.println("{sorted(values, 6)}")
        qsort(
            values,
            6u64,
            8u64,
            unsafe (left, right) {
                let (a, b) = (left.cast[Int]().read(), right.cast[Int]().read())
                if a < b { -1 } else if a > b { 1 } else { 0 }
            },
        )
        console.println("{sorted(values, 6)}")
        qsort(values, 6u64, 8u64, descending)
        qsort(values, 6u64, 8u64, waiting)
        console.println("{sorted(values, 6)}")
        ffi.free(values)

        // Through the C convention both ways: registers of both kinds, and
        // a struct in memory.
        let through: extern fn(Pair): Pair = swap
        let swapped = through(Pair { a: 3, b: 4.5 })
        let big: extern fn(Big, Int): Big = grow
        let grown = big(Big { a: 1, b: 2, c: 3 }, 10)
        console.println("{swapped.a} {swapped.b} {grown.a} {grown.b} {grown.c}")

        let counter = ffi.allocate[Int]()
        let context = ffi.context(counter)
        let thread = ffi.allocate[UInt64]()
        let created = pthread_create(thread, none, worker, context)
        let joined = pthread_join(thread.read(), none)
        console.println("{created} {joined} {counter.read()}")
        ffi.freeContext[Pointer[Int]](context)
        ffi.free(counter)
        ffi.free(thread)
    }
}

// expect-stdout: [9, 8, 5, 3, 2, 1]
// expect-stdout: [1, 2, 3, 5, 8, 9]
// expect-stdout: [1, 2, 3, 5, 8, 9]
// expect-stdout: 7 7.5 11 12 13
// expect-stdout: 0 0 83
