// The timers of waits that ended another way are dropped once they are most
// of them, as timers_stale_held.to holds, and those still pending stay: a
// task asleep while a hundred timeouts of `select` lose to their channel
// wakes as it should.
import std.console
import std.time

fn sleeper(): Int {
    time.sleep(time.milliseconds(500))
    1
}

fn feeder(out: Sender[Int], count: Int) {
    for i in 0..count {
        time.sleep(time.milliseconds(1))
        out.send(i)
    }
}

fn main() {
    let job = spawn sleeper()
    let (out, input) = channel[Int](1)
    let feeding = spawn feeder(out, 100)
    var answered = 0
    for _ in 0..100 {
        let got = select {
            let value = input.receive() => value.isSome()
            time.sleep(time.seconds(60)) => false
        }
        if got {
            answered += 1
        }
    }
    feeding.wait()
    console.println("{answered} {job.wait()}")
}

// expect-stdout: 100 1
