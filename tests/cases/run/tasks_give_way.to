// With one worker, a task that computes and asks with `tasks.checkpoint()`
// gives its worker away once it has held it for an interval while another
// task waits (11.15): `main`, which waits for the computation to begin,
// gets the worker, and its cancel reaches the computation at its next
// checkpoint. Under a seeded order the explorer gives way at every
// checkpoint itself.

import std.console
import std.tasks

fn spin(began: Sender[Unit]): Int {
    defer {
        console.println("the computation stopped, cancelled: {tasks.cancelled()}")
    }
    began.send(())
    // Only the cancel ends it, at a checkpoint: run to no end, it does no
    // more than its turns until then.
    for {
        tasks.checkpoint()
    }
}

fn main() {
    let (began, beginning) = channel[Unit]()
    let job = spawn spin(began)
    _ = beginning.receive()
    job.cancel()
    console.println("main ran beside it and cancelled it")
}

// expect-env: TONDO_WORKERS=1
// expect-stdout: the computation stopped, cancelled: true
// expect-stdout: main ran beside it and cancelled it
