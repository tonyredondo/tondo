// A task that computes and never asks holds its worker; when it has held it
// for two intervals while another task waits and no worker is idle, the
// runtime puts another worker beside it (16.14), with one worker given as
// with any number. `main` waits for the computation to begin, looking every
// millisecond, and then for a worker: the computation holds the one there
// was until `main` stops it, so `main` runs on the worker put beside it, and
// only there. Its sleep ends by a timer, whose task any worker takes. Once the
// computation ends, that worker retires and the program has its one again.
// Nothing here is measured by the clock, so a slow machine changes only how
// long it takes; that a worker whose tasks change is given nothing is held
// by the monitor's own tests (tasks/foreign.rs).

import std.console
import std.diagnostics
import std.sync
import std.time

/// Computes until `stop` is set, without waiting, once it has said it began.
fn compute(began: sync.Atomic[Bool], stop: sync.Atomic[Bool]): Int {
    began.store(true)
    var turns = 0
    for not stop.load() {
        turns += 1
    }
    turns
}

fn counted(name: String): Int {
    diagnostics.metrics().find((each) { each.name == name }).map((each) { each.value }) ?? -1
}

fn main() {
    let began = sync.Atomic(false)
    let stop = sync.Atomic(false)
    let job = spawn compute(began, stop)
    for not began.load() {
        time.sleep(time.milliseconds(1))
    }
    console.println("main ran beside the computation: workers added {counted("workers.added")}")
    stop.store(true)
    _ = job.wait()
    // The worker added retires once it looks for a task again.
    for counted("workers.total") > 1 {
        time.sleep(time.milliseconds(1))
    }
    console.println("workers once it ended: {counted("workers.total")}")
}

// expect-env: TONDO_WORKERS=1
// expect-no-schedule: the explorer runs one worker and adds none, so a computation that does not ask holds it, by design
// expect-no-replay: a recorded run, too, runs its tasks on one worker that adds none
// expect-stdout: main ran beside the computation: workers added 1
// expect-stdout: workers once it ended: 1
