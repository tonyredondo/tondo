// Trimming takes off Unicode's whitespace, every character of it, at the
// ends it is asked to and nowhere else: ASCII's a byte at a time and the
// others a character at a time, and no character that is not whitespace,
// ASCII or not, at either end.
import std.console

fn shown(text: String): String {
    var codes: Array[String] = []
    for c in text.chars() {
        codes.push("{c.code()}")
    }
    "[{codes.join(" ")}]"
}

fn main() {
    let spaces = [
        0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x20, 0x85, 0xA0, 0x1680, 0x2000, 0x2001, 0x2002, 0x2003, 0x2004,
        0x2005, 0x2006, 0x2007, 0x2008, 0x2009, 0x200A, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000,
    ]
    for code in spaces {
        let space = "{Char.from(code) ?? ' '}"
        let text = "{space}{space}x é{space}{space}"
        console.println("{code}: {shown(text.trim())} {shown(text.trimStart())} {shown(text.trimEnd())}")
    }
    // Not whitespace, at either end: kept.
    for kept in ["é", "€", "😀", "\u{200B}", "\u{FEFF}", "a"] {
        let text = "{kept} x {kept}"
        console.println("{shown(text.trim())} {shown(text.trimStart())} {shown(text.trimEnd())}")
    }
    console.println("{shown("".trim())} {shown(" \t\n ".trim())} {shown(" \u{3000} ".trimStart())} {shown("\u{2029}  ".trimEnd())}")
    let untouched = "nothing to cut"
    console.println("{untouched.trim() == untouched} {shown(untouched.trim())}")
}

