import std.console
import std.executor
import std.sync
import std.time

enum Problem {
    Negative(Int)
}

impl Display for Problem {
    fn display(self): String {
        match self {
            Problem.Negative(n) => "negative {n}"
        }
    }
}

// Counts the jobs running at once, and the most there ever were.
fn job(running: sync.Atomic[Int], peak: sync.Atomic[Int], n: Int): Int {
    let now = running.add(1)
    var best = peak.load()
    for now > best {
        match peak.compareExchange(best, now) {
            sync.CompareExchange.Exchanged(_) => best = now
            sync.CompareExchange.Mismatch(seen) => best = seen
        }
    }
    time.sleep(time.milliseconds(5))
    _ = running.add(-1)
    n * n
}

fn pools(): !(executor.ExecutorError | executor.SubmitError) {
    let running = sync.Atomic(0)
    let peak = sync.Atomic(0)
    let pool = executor.pool(3, 20)?
    var group = Group.new[Int]()
    for n in 1..=12 {
        group.add(pool.submit(() { job(running, peak, n) })?)
    }
    var total = 0
    for square in group.wait() {
        total += square
    }
    console.println("squares {total}, at most {peak.load()} at once")

    // A job that waits for a worker can be cancelled, and never starts.
    let busy = executor.pool(1, 1)?
    let started = sync.Atomic(0)
    let going = sync.Atomic(0)
    let first = busy.submit(() {
        _ = going.add(1)
        time.sleep(time.milliseconds(20))
    })?
    for going.load() == 0 {
        time.sleep(time.milliseconds(1))
    }
    let queued = busy.submit(() { _ = started.add(1) })?
    queued.cancel()
    match busy.trySubmit(() { 0 }) {
        ok(extra) => console.println("room again: {extra.wait()}")
        err(error) => console.println("{error}")
    }
    first.wait()
    busy.shutdown()
    console.println("queued job started: {started.load()}")
    match executor.pool(0, 1) {
        ok(_) => console.println("a pool without workers")
        err(error) => console.println("{error}")
    }
}

fn actors(): !(executor.ExecutorError | executor.SendError | Problem) {
    let log: sync.Mutex[Array[Int]] = sync.Mutex([])
    let recorder = executor.actor(0, 2, (count: var Int, n: Int) {
        count += 1
        let entry = n * 10 + count
        log.update((entries) { entries.push(entry) })
    })?
    let address = recorder.reference()
    let copy = address
    for n in 1..=3 {
        address.send(n)?
        copy.send(n + 3)?
    }
    recorder.stop()?
    console.println("in order: {log.get()}")
    match address.send(9) {
        ok(_) => console.println("sent after stop")
        err(error) => console.println("after stop: {error}")
    }

    // An error of the handler stops the actor; `stop` gives it.
    let strict = executor.actor(0, 4, (sum: var Int, n: Int): !Problem {
        if n < 0 {
            fail Problem.Negative(n)
        }
        sum += n
    })?
    let target = strict.reference()
    target.send(1)?
    target.send(-2)?
    match strict.stop() {
        ok(_) => console.println("no error")
        err(error) => console.println("stopped by {error}")
    }

    // The end of the owner's block stops an actor nobody stopped, after it
    // handled its mailbox.
    let seen: sync.Mutex[Int] = sync.Mutex(0)
    {
        let counter = executor.actor(0, 8, (total: var Int, n: Int) {
            total += n
            seen.set(total)
        })?
        let to = counter.reference()
        for n in 1..=4 {
            to.send(n)?
        }
    }
    console.println("handled before the block ended: {seen.get()}")
}

fn main(): !(executor.ExecutorError | executor.SubmitError | executor.SendError | Problem) {
    pools()?
    actors()?
}

// expect-stdout: squares 650, at most 3 at once
// expect-stdout: room again: 0
// expect-stdout: queued job started: 0
// expect-stdout: a pool needs at least one worker, not 0
// expect-stdout: in order: [11, 42, 23, 54, 35, 66]
// expect-stdout: after stop: the actor stopped
// expect-stdout: stopped by negative -2
// expect-stdout: handled before the block ended: 10
