import std.console

type Token[T] = { value: T }

fn spend[T: ~Copy](token: Token[T]) {
    _ = token
    console.println("spent")
}

fn invoke[F: ~Copy + CallOnce[fn(): Unit]](operation: F) {
    operation()
}

fn run[T: ~Copy](token: Token[T]) {
    let release = () {
        spend(token)
    }
    defer release()
    console.println("running")
}

fn give[T: ~Copy](token: Token[T]) {
    let release = () {
        spend(token)
    }
    invoke(release)
}

// A closure that calls such a capture gives it away, so it runs once too.
fn pass[T: ~Copy](token: Token[T]) {
    let release = () {
        spend(token)
    }
    let outer = () {
        release()
    }
    invoke(outer)
}

fn main() {
    run(Token { value: "a" })
    give(Token { value: "b" })
    pass(Token { value: "c" })
}

// expect-stdout: running
// expect-stdout: spent
// expect-stdout: spent
// expect-stdout: spent
