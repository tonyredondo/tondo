// `x = "{x}..."` appends to the string in its own block when nothing else
// holds it; a copy, a field lent by `mut self` and the string read again
// in the same text all keep their values. A value of a type that shows
// itself, made of an integer as a `Duration`, is shown as it shows. A
// short text known when compiling is written in place, of any length up
// to 16 bytes, and past that, into a shared string or a literal, copied.
import std.console
import std.format
import std.time

type Log = { text: String }

fn Log.note(mut self, n: Int) {
    self.text = "{self.text}{n};"
}

fn main() {
    var s = "a"
    let kept = s
    for i in 0..3 {
        s = "{s}{i}"
    }
    console.println("{s} {kept}")
    var log = Log { text: "" }
    log.note(1)
    let before = log
    log.note(-2)
    console.println("{log.text} {before.text}")
    var twice = "ab"
    twice = "{twice}{twice}"
    console.println(twice)
    var long = ""
    for i in 0..1000 {
        long = "{long}{i % 10}"
    }
    console.println("{long.length()} {long[0:12]}")
    var built = format.Builder.new()
    built.add("x")
    built.add(42)
    built.addLine(true)
    console.print(built.text())
    var waited = "waited "
    waited = "{waited}{time.hours(2)}"
    console.println("{waited} {time.seconds(1)}")
    var known = format.Builder.new()
    for _ in 0..3 {
        known.add("a")
        known.add("bc")
        known.add("def")
        known.add("ghij")
        known.add("klmno")
        known.add("pqrstuv")
        known.add("wxyz0123")
        known.add("456789abcdefghi")
        known.add("ñ0123456789abcde")
        known.add("ABCDEFGHIJKLMNOPQ")
        known.addLine("|")
    }
    console.print(known.text())
    var shared = "s"
    shared = "{shared}-"
    let other = shared
    shared = "{shared}+"
    var literal = "lit"
    literal = "{literal}!"
    console.println("{shared} {other} {literal}")
}

// expect-stdout: a012 a
// expect-stdout: 1;-2; 1;
// expect-stdout: abab
// expect-stdout: 1000 012345678901
// expect-stdout: x42true
// expect-stdout: waited 2h0m0s 1s
// expect-stdout: abcdefghijklmnopqrstuvwxyz0123456789abcdefghiñ0123456789abcdeABCDEFGHIJKLMNOPQ|
// expect-stdout: abcdefghijklmnopqrstuvwxyz0123456789abcdefghiñ0123456789abcdeABCDEFGHIJKLMNOPQ|
// expect-stdout: abcdefghijklmnopqrstuvwxyz0123456789abcdefghiñ0123456789abcdeABCDEFGHIJKLMNOPQ|
// expect-stdout: s-+ s- lit!
