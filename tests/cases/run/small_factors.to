import std.console

// A remainder by 3, 5, 7 or 9, and a product by them that cannot
// overflow, are made of shifts and additions rather than multiplied: the
// same values, the smallest and largest integers' included.

fn main() {
    let values = [-9223372036854775808, -100, -7, -1, 0, 1, 6, 7, 100, 9223372036854775807]
    for value in values {
        console.println("{value % 3} {value % 5} {value % 7} {value % 9}")
    }
    var products: Array[Int] = []
    for i in -3..4 {
        products.push(i * 3 + i * 5 + i * 7 + i * 9)
    }
    console.println("{products}")
}

// expect-stdout: -2 -3 -1 -8
// expect-stdout: -1 0 -2 -1
// expect-stdout: -1 -2 0 -7
// expect-stdout: -1 -1 -1 -1
// expect-stdout: 0 0 0 0
// expect-stdout: 1 1 1 1
// expect-stdout: 0 1 6 6
// expect-stdout: 1 2 0 7
// expect-stdout: 1 0 2 1
// expect-stdout: 1 2 0 7
// expect-stdout: [-72, -48, -24, 0, 24, 48, 72]
