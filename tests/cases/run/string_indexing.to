import std.console

fn describe(value: Char?): String {
    match value {
        some(c) => "{c}"
        none => "-"
    }
}

fn main() {
    let text = "añ🙂b"
    _ = console.println("{text.length()} {text.byteLength()} {text.isEmpty()} {"".isEmpty()} {"".length()}")
    _ = console.println("{text[0]} {text[1]} {text[2]} {text[-1]} {text[-4]}")
    _ = console.println("{describe(text.get(2))} {describe(text.get(4))} {describe(text.get(-5))} {describe(text.get(-2))}")
    _ = console.println("{text[:2]}|{text[1:3]}|{text[::-1]}|{text[::2]}|{text[-2:]}|{text[10:]}|{text[3:1]}")
    var count = 0
    for c in text {
        _ = console.println("{count}: {c}")
        count += 1
    }
    for c in "" {
        _ = console.println("never")
    }
    let joined = text[:1].concat(text[-1:])
    _ = console.println("{joined} {joined == "ab"} {"ab" < "añ"}")
}

// expect-stdout: 4 8 false true 0
// expect-stdout: a ñ 🙂 b a
// expect-stdout: 🙂 - - 🙂
// expect-stdout: añ|ñ🙂|b🙂ña|a🙂|🙂b||
// expect-stdout: 0: a
// expect-stdout: 1: ñ
// expect-stdout: 2: 🙂
// expect-stdout: 3: b
// expect-stdout: ab true true
