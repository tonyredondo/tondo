// What a recovered panic carries (language 15.7, 15.9): data of every kind,
// read back as the panic gave it, and its report as text, with the name of
// a code of the language and the program's data.
import std.console

fn main() {
    let data: Map[String, Int | Float | Bool | String] = [
        "entries": 12,
        "ratio": 0.5,
        "fresh": false,
        "file": "index.db",
    ]
    match recover { panic("broken", code: "cache.corrupt", data: data) } {
        err(stopped) => {
            console.println("{stopped.data == data}")
            let report = "{stopped}".lines()
            for line in report.take(5) {
                console.println(line)
            }
        }
    }
    let values = [1, 2]
    match recover { values[5] } {
        ok(_) => console.println("not stopped")
        err(stopped) => console.println("{stopped}".lines().first() ?? "")
    }
}

// expect-stdout: true
// expect-stdout: panic[cache.corrupt]: broken
// expect-stdout:   entries: 12
// expect-stdout:   ratio: 0.5
// expect-stdout:   fresh: false
// expect-stdout:   file: index.db
// expect-stdout: panic[P0001]: bounds: index 5 is out of bounds for an array of length 2: valid indices are 0 to 1, and -2 to -1 from the end
