// fs.watch sends the changes under a directory in batches, once they
// settle: each path once, created, modified or removed, without the
// temporary files through which fs writes a file whole. Each change here
// waits for the batch of the one before, so that none depends on how
// long the machine takes; what a batch of many changes says is the
// runtime's test of `settled`.

import std.console
import std.fs
import std.path
import std.time

/// The changes of the next batch with one, or that none came.
fn show(changes: Receiver[Array[fs.Change]], dir: String) {
    match changes.receive(timeout: time.seconds(10)) {
        some(batch) => {
            for change in batch {
                let what = match change.kind {
                    fs.ChangeKind.Created => "created"
                    fs.ChangeKind.Modified => "modified"
                    fs.ChangeKind.Removed => "removed"
                }
                console.println("{change.path.removePrefix(dir)} {what}")
            }
        }
        none => console.println("no changes")
    }
}

fn main() {
    let dir = fs.realPath(fs.createTemporaryDirectory()?)?
    fs.writeText(path.join(dir, "old.txt"), "old")?
    let changes = fs.watch([dir])?
    fs.writeText(path.join(dir, "new.txt"), "new")?
    show(changes, dir)
    fs.writeText(path.join(dir, "old.txt"), "changed")?
    show(changes, dir)
    fs.remove(path.join(dir, "new.txt"))?
    show(changes, dir)
    // The temporary file never shows, in this batch or one of its own.
    fs.writeText(path.join(dir, ".draft.txt.tondo-1-2"), "as fs names them")?
    fs.writeText(path.join(dir, "after.txt"), "after")?
    show(changes, dir)
    fs.createDirectory(path.join(dir, "sub"))?
    show(changes, dir)
    fs.writeText(path.join(dir, "sub/inner.txt"), "inner")?
    show(changes, dir)
    // A file watched alone.
    let notes = path.join(dir, "notes.txt")
    fs.writeText(notes, "first")?
    let edits = fs.watch([notes])?
    fs.appendText(notes, " and second")?
    show(edits, dir)
    fs.remove(dir, recursive: true)?
}

// expect-stdout: /new.txt created
// expect-stdout: /old.txt modified
// expect-stdout: /new.txt removed
// expect-stdout: /after.txt created
// expect-stdout: /sub created
// expect-stdout: /sub/inner.txt created
// expect-stdout: /notes.txt modified
