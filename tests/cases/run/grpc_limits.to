// A gRPC message from outside the program is bounded one by one by
// `GrpcLimits.maxMessageBytes`, 16 MiB by default: a server's by its
// service's `.limits(...)`, a client's by `connect`'s `limits:`. Past it
// the call ends as `ResourceExhausted`, with the sentence that names the
// code to write where the bound was given, which differs by side.
import std.console
import std.grpc
import std.http
import std.protobuf

pub type Text = {
    @protobuf.Field(1)
    value: String = ""
}

fn echo(request: Text): Text ! grpc.Status {
    Text { value: request.value.concat(request.value) }
}

fn main(): !grpc.Status {
    let method = grpc.Method { name: "Echo", handler: call => grpc.unary(call, echo)? }
    let small = grpc.GrpcLimits.Default with { maxMessageBytes: 1000 }
    var app = http.App()
    app.grpc(grpc.Service { name: "demo.Echo", methods: [method] }.limits(small))
    let server = match app.start() {
        ok(started) => started
        err(error) => fail grpc.Status { code: grpc.Code.Unavailable, message: "{error}" }
    }
    let open = grpc.connect(server.url())?
    for size in [900, 1100] {
        match open.unary[Text, Text]("/demo.Echo/Echo", Text { value: "a".repeat(size) }) {
            ok(reply) => console.println("server {size}: {reply.value.length()}")
            err(status) => console.println("server {size}: {status}")
        }
    }
    // The reply is twice the request: 600 bytes take more than its 1000.
    let bounded = grpc.connect(server.url(), limits: small)?
    for size in [400, 600] {
        match bounded.unary[Text, Text]("/demo.Echo/Echo", Text { value: "b".repeat(size) }) {
            ok(reply) => console.println("client {size}: {reply.value.length()}")
            err(status) => console.println("client {size}: {status}")
        }
    }
    console.println("by default: {grpc.GrpcLimits.Default.maxMessageBytes}")
    server.stop()
}

// expect-stdout: server 900: 1800
// expect-stdout: server 1100: ResourceExhausted: a message of the client of 1103 bytes is larger than 1000 bytes, the most `GrpcLimits.maxMessageBytes` allows: raise it with `.limits(grpc.GrpcLimits.Default with { maxMessageBytes: … })` on the service
// expect-stdout: client 400: 800
// expect-stdout: client 600: ResourceExhausted: a message of the server of 1203 bytes is larger than 1000 bytes, the most `GrpcLimits.maxMessageBytes` allows: raise it with `limits: grpc.GrpcLimits.Default with { maxMessageBytes: … }`
// expect-stdout: by default: 16777216
