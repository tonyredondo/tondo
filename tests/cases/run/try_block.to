// `?` in a `try` block ends the block, not the function: a chain of options
// or results needs no function of its own.

import std.console

type Address = {
    city: String?
}

type User = {
    address: Address?
}

fn parse(text: String): Int ! String {
    match Int.parse(text) {
        ok(number) => number
        err(_) => fail "not a number: {text}"
    }
}

fn main() {
    let ada = User { address: Address { city: "Lima" } }
    let nobody = User { address: none }
    let first: String? = try { (ada.address?).city? }
    let second: String? = try { (nobody.address?).city? }
    console.println("{first} {second}")
    let sum: Int ! String = try { parse("1")? + parse("2")? }
    let failed: Int ! String = try { parse("1")? + parse("x")? }
    console.println("{sum} {failed}")
    console.println("the function goes on")
}

// expect-stdout: some(Lima) none
// expect-stdout: ok(3) err(not a number: x)
// expect-stdout: the function goes on
