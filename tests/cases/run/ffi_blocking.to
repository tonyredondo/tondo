// A call of C that blocks its worker for long gets another worker in its
// place, so 256 calls of 2s take far less than rounds of one per core:
// 16s or more up to 32 cores, and 170s on the three of CI's Intel Mac. The
// limit leaves room for emulation and for a runner under load, which start
// the other workers slowly.
import std.console
import std.ffi
import std.time

extern fn sleep(seconds: ffi.CUInt): ffi.CUInt

fn nap() {
    unsafe { sleep(2) }
}

fn main() {
    let start = time.now()
    var group = Group[Unit]()
    for _ in 0..256 {
        group.add(spawn nap())
    }
    _ = group.wait()
    console.println("{start.elapsed().milliseconds() < 30000}")
}

// expect-stdout: true
// expect-no-replay: a recorded run has one worker, and its 256 calls take 512 s one after the other
// expect-no-schedule: one worker runs the tasks, and its 256 calls take too long one at a time
