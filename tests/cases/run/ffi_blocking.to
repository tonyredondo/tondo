// A call of C that blocks its worker for long gets another worker in its
// place, so 256 calls of 2s take far less than rounds of one per core:
// 16s or more up to 32 cores. The limit leaves room for emulation under
// load, which starts the other workers slowly.
import std.console
import std.ffi
import std.time

extern fn sleep(seconds: ffi.CUInt): ffi.CUInt

fn nap() {
    unsafe { sleep(2) }
}

fn main() {
    let start = time.now()
    var group = Group.new[Unit]()
    for _ in 0..256 {
        group.add(spawn nap())
    }
    _ = group.wait()
    console.println("{start.elapsed().milliseconds() < 10000}")
}

// expect-stdout: true
