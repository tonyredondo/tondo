// math.Tensor (standard library 14.5) against definitions written with
// plain loops, on random integers: reading, `at` and `set`, `slice`,
// `transposed`, the operators with broadcasting, `sumAlong`, `matmul` for
// each pair of ranks, `min`, `max` and `indexOfMax`; `sum` of floats as
// `sum` of their array gives it; and a tensor written and read back in
// JSON and in CBOR.

import std.cbor
import std.console
import std.json
import std.math
import std.random

fn filled(draws: var random.Random, shape: Array[Int]): math.Tensor[Int] {
    var count = 1
    for size in shape {
        count *= size
    }
    var values: Array[Int] = []
    for _ in 0..count {
        values.push(draws.int(-9..10))
    }
    math.Tensor(values, shape)
}

/// The offset of `index` in a row-major block of `shape`.
fn offset(shape: Array[Int], index: Array[Int]): Int {
    var at = 0
    for (axis, value) in index.enumerate() {
        at = at * shape[axis] + value
    }
    at
}

/// Every index of `shape`, in row-major order.
fn indexes(shape: Array[Int]): Array[Array[Int]] {
    var all: Array[Array[Int]] = [[]]
    for size in shape {
        var longer: Array[Array[Int]] = []
        for index in all {
            for value in 0..size {
                longer.push(index.concat([value]))
            }
        }
        all = longer
    }
    all
}

/// `left op right` by broadcasting's definition: shapes aligned at their
/// ends, a size of 1 read at index 0.
fn broadcast(left: math.Tensor[Int], right: math.Tensor[Int], op: Int): math.Tensor[Int] {
    let rank = if left.rank() > right.rank() { left.rank() } else { right.rank() }
    let a = [1].repeat(rank - left.rank()).concat(left.shape())
    let b = [1].repeat(rank - right.rank()).concat(right.shape())
    let shape = (0..rank).map((axis) { if a[axis] == 1 { b[axis] } else { a[axis] } }).collect()
    var values: Array[Int] = []
    for index in indexes(shape) {
        let at = (sizes: Array[Int]) {
            (0..rank).map((axis) { if sizes[axis] == 1 { 0 } else { index[axis] } }).collect()
        }
        let x = left.values()[offset(a, at(a))]
        let y = right.values()[offset(b, at(b))]
        values.push(
            match op {
                0 => x + y
                1 => x - y
                _ => x * y
            },
        )
    }
    math.Tensor(values, shape)
}

fn main() {
    var draws = random.Random.seeded(14)
    var checked = 0
    // Reading and writing by index.
    let cube = filled(var draws, [2, 3, 4])
    for index in indexes(cube.shape()) {
        assert(cube.at(index[0], index[1], index[2]) == cube.values()[offset(cube.shape(), index)])
        checked += 1
    }
    var changed = cube
    changed.set(100, 1, -1, -2)
    assert(changed.at(1, 2, 2) == 100 and cube.at(1, 2, 2) != 100)
    // `slice` and `transposed`.
    for axis in 0..3 {
        let rest = (0..3).filter((other) { other != axis }).collect()
        for at in 0..cube.shape()[axis] {
            let part = cube.slice(axis, at)
            for index in indexes(part.shape()) {
                var whole = index
                whole.insert(axis, at)
                assert(
                    part.values()[offset(part.shape(), index)] ==
                        cube.values()[offset(cube.shape(), whole)],
                )
                checked += 1
            }
            assert(part.shape() == rest.map((other) { cube.shape()[other] }))
        }
    }
    for order in [[2, 1, 0], [1, 0, 2], [0, 2, 1]] {
        let turned = cube.transposed(order)
        for index in indexes(turned.shape()) {
            var original = [0, 0, 0]
            for (axis, value) in index.enumerate() {
                original[order[axis]] = value
            }
            assert(
                turned.values()[offset(turned.shape(), index)] ==
                    cube.values()[offset(cube.shape(), original)],
            )
            checked += 1
        }
    }
    // The operators, with shapes that fit.
    for (left, right) in [
        ([2, 3], [2, 3]),
        ([2, 3], [3]),
        ([2, 1], [1, 3]),
        ([4], []),
        ([2, 3, 4], [3, 1]),
        ([1], [5]),
    ] {
        let a = filled(var draws, left)
        let b = filled(var draws, right)
        assert(a + b == broadcast(a, b, 0))
        assert(a - b == broadcast(a, b, 1))
        assert(b * a == broadcast(b, a, 2))
        checked += 3
    }
    let numbers = filled(var draws, [3, 2])
    assert(numbers + 5 == broadcast(numbers, math.Tensor([5], []), 0))
    assert(5 - numbers == broadcast(math.Tensor([5], []), numbers, 1))
    // `sumAlong`.
    for axis in 0..3 {
        let summed = cube.sumAlong(axis)
        for index in indexes(summed.shape()) {
            var total = 0
            for at in 0..cube.shape()[axis] {
                var whole = index
                whole.insert(axis, at)
                total += cube.values()[offset(cube.shape(), whole)]
            }
            assert(summed.values()[offset(summed.shape(), index)] == total)
            checked += 1
        }
    }
    // `matmul` for each pair of ranks.
    let left = filled(var draws, [3, 4])
    let right = filled(var draws, [4, 2])
    let row = filled(var draws, [4])
    let column = filled(var draws, [4])
    let product = left.matmul(right)
    assert(product.shape() == [3, 2])
    for i in 0..3 {
        for j in 0..2 {
            var total = 0
            for k in 0..4 {
                total += left.at(i, k) * right.at(k, j)
            }
            assert(product.at(i, j) == total)
            checked += 1
        }
    }
    assert(
        row.matmul(right).shape() == [2] and row.matmul(right).at(1) == row.dot(right.slice(1, 1)),
    )
    assert(
        left.matmul(column).shape() == [3] and
            left.matmul(column).at(2) == left.slice(0, 2).dot(column),
    )
    assert(row.matmul(column).shape() == [] and row.matmul(column).values() == [row.dot(column)])
    // Reducing.
    assert(cube.min() == cube.values().min() and cube.max() == cube.values().max())
    let best = cube.indexOfMax() ?? []
    assert(cube.values()[offset(cube.shape(), best)] == (cube.values().max() ?? 0))
    assert(
        math.Tensor[Int].zeros([0, 3]).max() == none and
            math.Tensor[Int].zeros([0]).indexOfMax() == none,
    )
    let floats = math.Tensor((0..100).map((n) { Float(n) / 7.0 }).collect(), [10, 10])
    assert(floats.sum() == floats.values().sum())
    // Written and read back.
    let fromJson: math.Tensor[Int] = json.decode(json.encode(cube))?
    let fromCbor: math.Tensor[Float] = cbor.decode(cbor.encode(floats))?
    assert(fromJson == cube and fromCbor == floats)
    console.println("{checked} values checked")
}

// expect-stdout: 218 values checked
