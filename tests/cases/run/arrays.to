import std.console

type Point = { x: Int, name: String }

fn sum(values: Array[Int]): Int {
    var total = 0
    for v in values {
        total += v
    }
    total
}

fn main() {
    var values = [10, 20, 30, 40, 50]
    let snapshot = values
    values[0] = 1
    values[-1] += 5
    _ = values.push(60)
    _ = console.println("{values} {snapshot} {values.length()} {snapshot.length()}")
    _ = console.println("{values[1:4]} {values[::-1]} {values[::2]} {values[-100:100]} {values[:-1:-1]}")
    _ = console.println("{values.get(2) == some(30)} {values.get(99) == none} {sum(values)} {30 in values} {31 in values}")
    let popped = values.pop()
    _ = console.println("{popped == some(60)} {values}")
    let words = ["a", "b"].concat(["c"]).repeat(2)
    _ = console.println("{words} {words == ["a", "b", "c", "a", "b", "c"]}")
    var grid = [[1, 2], [3]]
    grid[1][0] = 30
    _ = grid[0].push(9)
    _ = console.println("{grid}")
    var points = [Point { x: 1, name: "p1" }]
    _ = points.push(Point { x: 2, name: "p{2}" })
    points[0].name = "first"
    for p in points {
        _ = console.println("{p.x} {p.name}")
    }
    var empty: Array[String] = []
    for i in 0..1000 {
        _ = empty.push("item {i}")
    }
    var removed = 0
    for i in 0..500 {
        if empty.pop() != none {
            removed += 1
        }
    }
    _ = console.println("{empty.length()} {removed} {empty[0]} {empty[-1]}")
    match values.slice(1, 3) {
        ok(part) => {
            _ = console.println("{part}")
        }
        err(_) => {
            _ = console.println("bad")
        }
    }
    let built = Array.new[Int]()
    _ = console.println("{built} {built.length()}")
}

// expect-stdout: [1, 20, 30, 40, 55, 60] [10, 20, 30, 40, 50] 6 5
// expect-stdout: [20, 30, 40] [60, 55, 40, 30, 20, 1] [1, 30, 55] [1, 20, 30, 40, 55, 60] []
// expect-stdout: true true 206 true false
// expect-stdout: true [1, 20, 30, 40, 55]
// expect-stdout: [a, b, c, a, b, c] true
// expect-stdout: [[1, 2, 9], [30]]
// expect-stdout: 1 first
// expect-stdout: 2 p2
// expect-stdout: 500 500 item 0 item 499
// expect-stdout: [20, 30]
// expect-stdout: [] 0
