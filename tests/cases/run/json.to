import std.console
import std.json

fn main(): !json.JsonError {
    let doc = json.parse(r"""{"name": "ana", "age": 31, "tags": ["a", "b"], "address": {"city": "Madrid"}, "score": 9.5, "ok": true, "none": null}""")?
    console.println("{doc}")
    console.println("{doc.get("name")} {doc.field("age").asInt()} {doc.field("address").field("city").asText()}")
    console.println("{doc.field("tags").item(1).asText()} {doc.field("missing").isNull()} {doc.field("score").asFloat()}")
    let numbers: Array[Int] = json.decode("[1, 2, 3]")?
    console.println("{numbers} {json.encode(numbers)}")
    let map: Map[String, Float] = json.decode(r"""{"a": 1.5, "b": 2}""")?
    console.println(json.encode(map, pretty: true))
    console.println(json.encode(doc, canonical: true))
    let escaped = "say \"hi\"\\ \n\t\u{1}ñ"
    console.println(json.encode([escaped: escaped]))
    console.println(json.encode([escaped: escaped], canonical: true))
    match json.parse(r"""{"a": [1, 2,]}""") {
        ok(_) => console.println("unexpected"),
        err(error) => console.println("error: {error}"),
    }
    match json.decode[Array[Int]](r"""[1, "two"]""") {
        ok(_) => console.println("unexpected"),
        err(error) => console.println("error: {error}"),
    }
}

// expect-stdout: {"name":"ana","age":31,"tags":["a","b"],"address":{"city":"Madrid"},"score":9.5,"ok":true,"none":null}
// expect-stdout: some("ana") some(31) some(Madrid)
// expect-stdout: some(b) true some(9.5)
// expect-stdout: [1, 2, 3] [1,2,3]
// expect-stdout: {
// expect-stdout:   "a": 1.5,
// expect-stdout:   "b": 2
// expect-stdout: }
// expect-stdout: {"address":{"city":"Madrid"},"age":31,"name":"ana","none":null,"ok":true,"score":9.5,"tags":["a","b"]}
// expect-stdout: {"say \"hi\"\\ \n\t\u0001ñ":"say \"hi\"\\ \n\t\u0001ñ"}
// expect-stdout: {"say \"hi\"\\ \n\t\u0001ñ":"say \"hi\"\\ \n\t\u0001ñ"}
// expect-stdout: error: unexpected character at $.a[2] (line 1, column 13)
