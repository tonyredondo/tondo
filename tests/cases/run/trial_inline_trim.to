// Trial inlining opens a call past SMALL (31) only when simplifying the call
// site shrinks it under SMALL, drops an allocation or indirect call, unlocks a
// region for a mixed-return callee, or folds at least a quarter of its cost.
// `trim` written in Tondo uses this both to move trimmed copies into the loop
// turn's region and to fold `s.trim().byteLength()` to `end - start` with zero
// allocation.

import std.console

enum Mode {
    A
    B
    C
    D
    E
    F
    G
    H
}

fn modeWeight(mode: Mode, x: Int): Int {
    match mode {
        Mode.A => x + 1
        Mode.B => x * 2 + 3
        Mode.C => x * 3 + 5
        Mode.D => x * 4 + 7
        Mode.E => x * 5 + 11
        Mode.F => x * 6 + 13
        Mode.G => x * 7 + 17
        Mode.H => x * 8 + 19
    }
}

fn staysCall(values: Array[Int]): Int {
    var a = 0
    var b = 1
    var c = 2
    for v in values {
        if v % 2 == 0 {
            a += v * 3 + 1
        } else if v % 3 == 0 {
            b += v * 5 - 2
        } else if v % 5 == 0 {
            c += v * 7 + 3
        } else {
            a += v
            b += 1
        }
    }
    for k in 0..4 {
        if (a + k) % 2 == 0 {
            c += k + 1
        } else {
            b += k + 2
        }
    }
    a + b + c
}

fn sumTrimLengths(inputs: Array[String]): Int {
    var total = 0
    for s in inputs {
        total += s.trim().byteLength()
    }
    total
}

fn sumTrimStartLengths(inputs: Array[String]): Int {
    var total = 0
    for s in inputs {
        total += s.trimStart().byteLength()
    }
    total
}

fn sumTrimEndLengths(inputs: Array[String]): Int {
    var total = 0
    for s in inputs {
        total += s.trimEnd().byteLength()
    }
    total
}

fn collectTrimmed(inputs: Array[String]): Int {
    var total = 0
    for s in inputs {
        let t = s.trim()
        total += t.length()
    }
    total
}

fn main() {
    let inputs = [
        "   hello world \t\n",
        "plain",
        "",
        "  \t\r\n  ",
        "  \u{1F}x\u{1F}  ",
        "  \u{3000}ñ\u{00A0}  ",
        "  ñ  ",
        "ñ\u{2003}",
        "\u{0085}abc",
    ]
    console.println(
        "{sumTrimLengths(inputs)} {sumTrimStartLengths(inputs)} {sumTrimEndLengths(inputs)} {collectTrimmed(inputs)}",
    )
    console.println("{modeWeight(Mode.C, 10)} {staysCall([1, 2, 3, 4, 5, 6])}")
}

// expect-stdout: 28 42 42 25
// expect-stdout: 35 107
// expect-optimization: 63:18 inlined
// expect-no-optimization: 63:18 region betweenWithin
// expect-optimization: 71:18 inlined
// expect-no-optimization: 71:18 region betweenWithin
// expect-optimization: 79:18 inlined
// expect-no-optimization: 79:18 region betweenWithin
// expect-optimization: 87:17 inlined
// expect-optimization: 87:17 region in `prelude.trimWhitespace`, `textNative.betweenWithin(text, start, end)` goes in the region of a turn of the loop at line 86
// expect-optimization: 108:23 inlined is inlined: the body of `modeWeight` is copied here
// expect-optimization: 108:48 call stays a call of `staysCall`: its body costs 49, more than the 31 inlining takes
