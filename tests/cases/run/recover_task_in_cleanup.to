// A task's panic that reaches the task waiting for it while that task runs
// the cleanups of another panic is reported as suppressed, as a panic in a
// cleanup is: the cleanup goes on, and `recover` gives the first. The task
// panics when the cleanup lets it, which a time would not ensure.
import std.console

fn failing(go: Receiver[Bool]) {
    let _ = go.receive()
    panic("the task's own")
}

fn main() {
    let (go, waits) = channel[Bool](1)
    let caught = recover {
        let job = spawn failing(waits)
        {
            defer {
                go.send(true)
                job.wait()
                console.println("the cleanup went on")
            }
            panic("first")
        }
    }
    match caught {
        err(stopped) => console.println("recovered {stopped.message}")
    }
}

// expect-stdout: the cleanup went on
// expect-stdout: recovered first
// expect-stderr: suppressed while unwinding: panic[P0008]: explicit-panic: the task's own
// expect-stderr:  --> recover_task_in_cleanup.to:9:5
// expect-stderr:   failing  recover_task_in_cleanup.to:9:5
// expect-stderr: in a task spawned at:
// expect-stderr:   main  recover_task_in_cleanup.to:15:19
