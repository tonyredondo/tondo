import std.console

fn inner(values: Array[Int]): Int {
    defer console.println("inner cleanup")
    values[5]
}

fn main() {
    defer console.println("main cleanup")
    defer {
        console.println("block cleanup")
    }
    let total = inner([1, 2])
    console.println("unreachable {total}")
}

// expect-stdout: inner cleanup
// expect-stdout: block cleanup
// expect-stdout: main cleanup
// expect-panic: P0001
// expect-stderr: panic[P0001]: bounds: index 5 is out of bounds for an array of length 2: valid indices are 0 to 1, and -2 to -1 from the end
