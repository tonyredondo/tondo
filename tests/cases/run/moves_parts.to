// A value read out of a part of a local and kept elsewhere, where the next
// statement writes the local whole, `x = Wrap { inner: x.inner, .. }`, is
// moved out of the local rather than counted again: the old value let go
// of keeps nothing of it (MIR `moved`, through the copy the reassignment
// makes). Each way keeps what it held: a part of a part; the local read
// whole by the same statement before the part leaves it, which sees it
// whole; under a condition, in a loop; a call that fails or panics between
// the read and the write, which lets the local go with its part moved
// away. An element by index is not moved, nor a field of a record that a
// function borrows or a closure holds, which are not this frame's alone.

import std.console

type Inner = { name: String, tags: Array[String] }
type Outer = { inner: Inner, count: Int }

fn rebuilt(rounds: Int): String {
    var outer = Outer { inner: Inner { name: "a", tags: [] }, count: 0 }
    for round in 0..rounds {
        outer = Outer { inner: outer.inner, count: outer.count + 1 }
        outer.inner.tags.push("t{round}")
    }
    "{outer.inner.name} {outer.inner.tags} {outer.count}"
}

fn deeper(rounds: Int): String {
    var outer = Outer { inner: Inner { name: "b", tags: ["x"] }, count: 0 }
    for _ in 0..rounds {
        outer = Outer { inner: Inner { name: outer.inner.name, tags: outer.inner.tags }, count: outer.count + 1 }
    }
    "{outer.inner.name} {outer.inner.tags} {outer.count}"
}

fn shown(outer: Outer): String {
    "{outer.inner.name}/{outer.count}"
}

fn readTwice(): String {
    var outer = Outer { inner: Inner { name: "c", tags: ["y"] }, count: 1 }
    outer = Outer { inner: outer.inner, count: shown(outer).length() }
    "{outer.inner.name} {outer.count}"
}

fn indexed(): String {
    var all = ["p", "q"]
    for at in 0..all.length() {
        all[at] = "{all[at]}{at}"
    }
    "{all}"
}

fn borrowed(outer: var Outer) {
    outer = Outer { inner: outer.inner, count: outer.count + 10 }
}

fn captured(): String {
    var outer = Outer { inner: Inner { name: "d", tags: [] }, count: 0 }
    let bump = () { outer = Outer { inner: outer.inner, count: outer.count + 1 } }
    bump()
    bump()
    "{outer.inner.name} {outer.count}"
}

fn sometimes(rounds: Int): String {
    var outer = Outer { inner: Inner { name: "e", tags: [] }, count: 0 }
    for round in 0..rounds {
        if round % 2 == 0 {
            outer = Outer { inner: outer.inner, count: outer.count + 1 }
        } else {
            outer.inner.tags.push("{round}")
        }
    }
    "{outer.inner.tags} {outer.count}"
}

fn checked(inner: Inner, limit: Int): Inner ! String {
    if inner.tags.length() >= limit {
        fail "too many: {inner.tags.length()}"
    }
    if inner.name == "boom" {
        panic("boom at {inner.tags.length()}")
    }
    inner
}

fn failing(name: String): String ! String {
    var outer = Outer { inner: Inner { name, tags: [] }, count: 0 }
    for round in 0..5 {
        outer = Outer { inner: checked(outer.inner, 2)?, count: outer.count + 1 }
        outer.inner.tags.push("{round}")
    }
    "{outer.count}"
}

fn main() {
    console.println(rebuilt(3))
    console.println(deeper(2))
    console.println(readTwice())
    console.println(indexed())
    var given = Outer { inner: Inner { name: "f", tags: ["z"] }, count: 1 }
    borrowed(var given)
    console.println("{given.inner.name} {given.inner.tags} {given.count}")
    console.println(captured())
    console.println(sometimes(4))
    match failing("g") {
        ok(text) => console.println(text)
        err(why) => console.println(why)
    }
    match recover { failing("boom") } {
        ok(outcome) => console.println(outcome ?? "failed")
        err(p) => console.println("panicked: {p.message}")
    }
}

// expect-stdout: a [t0, t1, t2] 3
// expect-stdout: b [x] 2
// expect-stdout: c 3
// expect-stdout: [p0, q1]
// expect-stdout: f [z] 11
// expect-stdout: d 0
// expect-stdout: [1, 3] 2
// expect-stdout: too many: 2
// expect-stdout: panicked: boom at 0
