// Records, tuples and options a function only takes apart are kept in
// registers, a local for each field: a lazy chain hands each element
// through `some(item)` at every step, in the standard library's code, and
// moves it between registers, as the closure's `order` is. A value read
// whole or lent stays whole: each gives the same results either way.

import std.console

type Order = {
    id: Int
    cents: Int
    region: String
}

fn orders(): Array[Order] {
    var all: Array[Order] = []
    for id in 0..10 {
        all.push(
            Order { id, cents: id * 1000, region: if id % 2 == 0 { "north" } else { "south" } },
        )
    }
    all
}

fn lazy(all: Array[Order]): Int {
    all
        .iter()
        .filter(order => order.cents > 4000)
        .sumBy(order => order.cents + order.region.length())
}

fn kept(all: Array[Order]): Array[Order] {
    var out: Array[Order] = []
    for order in all {
        if order.region == "north" {
            out.push(order)
        }
    }
    out
}

type Point = {
    x: Int
    y: Int
}

// Its elements are read a field at a time, and the loop still runs four
// turns at a time.
fn sum(count: Int): Int {
    var all: Array[Point] = []
    for i in 0..count {
        all.push(Point { x: i, y: i * 2 })
    }
    var total = 0
    for point in all {
        total += point.x + point.y
    }
    total
}

fn swapped(): Int {
    var (low, high) = (3, 9)
    if low > high {
        (low, high) = (high, low)
    }
    high - low
}

fn moved(order: var Order) {
    order.cents += 1
}

fn lent(): Int {
    var order = Order { id: 1, cents: 2, region: "west" }
    moved(var order)
    order.cents
}

fn main() {
    let all = orders()
    console.println("{lazy(all)} {kept(all).length()} {swapped()} {lent()} {sum(10)}")
}

// expect-stdout: 35025 5 6 3 135
// expect-optimization: 55:18 unrolled runs four turns at a time
