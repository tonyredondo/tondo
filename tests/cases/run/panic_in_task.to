// A panic in a task runs its cleanups and cancels the other tasks, which
// run theirs at their next wait, `main` included (11.11).
import std.console

fn boom() {
    defer console.println("task cleanup")
    panic("in a task")
}

fn main() {
    defer console.println("main cleanup")
    let job = spawn boom()
    job.wait()
    console.println("not reached")
}

// expect-panic: P0008
// expect-stdout: task cleanup
// expect-stdout: main cleanup
