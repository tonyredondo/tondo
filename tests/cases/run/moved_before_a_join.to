// A parameter a function takes, copied into a local it changes on one way
// and only read on another, the ways joining before the function lets it
// go: on its way the copy takes the parameter's reference, which leaves
// zeros there, and the one release after the join lets go of the
// reference the other way holds and of nothing on this one. The same for
// an array, a text and a record, with two ways or three, with a loop after
// the join, and with a panic after the join, which lets it go as it
// unwinds to the caller that recovers it. After each call new arrays are
// made: were a move ever to leave the parameter as it was, the release
// after the join would let go of the array a second time, and with those
// arrays made the program stops on it in every mode, as a code generator
// made to stop zeroing a moved place showed, on the runtime as it ships.
import std.console

type Box = {
    items: Array[Int]
    name: String
}

fn arranged(values: Array[Int], plain: Bool): Array[Int] {
    let result = if plain {
        values.reversed()
    } else {
        var copy = values
        copy.push(0)
        copy
    }
    result
}

fn chosen(values: Array[Int], way: Int): Array[Int] {
    let result = match way {
        0 => values.reversed()
        1 => values.slice(1, values.length()) ?? []
        _ => {
            var copy = values
            copy.push(way)
            copy
        }
    }
    result
}

fn bothGiven(values: Array[Int], first: Bool): Array[Int] {
    let result = if first {
        var one = values
        one.push(1)
        one
    } else {
        var two = values
        two.push(2)
        two
    }
    result
}

fn looped(values: Array[Int], plain: Bool, rounds: Int): Array[Int] {
    var result = if plain {
        values.reversed()
    } else {
        var copy = values
        copy.push(0)
        copy
    }
    var round = 0
    for round < rounds {
        result.push(round)
        round += 1
    }
    result
}

fn worded(text: String, plain: Bool): String {
    let result = if plain {
        text.toUpper()
    } else {
        var copy = text
        copy = "{copy}!"
        copy
    }
    result
}

fn boxed(box: Box, plain: Bool): Box {
    let result = if plain {
        Box { items: box.items.reversed(), name: box.name }
    } else {
        var copy = box
        copy.items.push(0)
        copy
    }
    result
}

fn checked(values: Array[Int], limit: Int): Int {
    if values.length() > limit {
        panic("{values.length()} values, more than {limit}")
    }
    values.length()
}

// Its loop keeps it a call, so that a panic of `checked` unwinds through
// its own frame, which lets go of `values` on the way that moved it too.
fn stopped(values: Array[Int], plain: Bool, limit: Int): Array[Int] {
    let result = if plain {
        values.reversed()
    } else {
        var copy = values
        copy.push(0)
        copy
    }
    let count = checked(result, limit)
    var total = 0
    for value in result {
        if value > 0 {
            total += value
        }
    }
    let (first, last) = (result[0], result[count - 1])
    console.println("{count} values, from {first} to {last}, {total} in all")
    result
}

// An array of `count` numbers from `from`, grown as a program grows one:
// making such arrays after a release that let go of an array twice is what
// makes the program stop on it (see the top).
fn fresh(from: Int, count: Int): Array[Int] {
    var made: Array[Int] = []
    var next = from
    for made.length() < count {
        made.push(next)
        next += 1
    }
    made
}

fn twoFresh(count: Int): String {
    let (one, two) = (fresh(10, count), fresh(20, count))
    "{one} {two}"
}

fn main() {
    let values = [5, 3, 9, 1]
    console.println("{arranged(values, true)} {arranged(values, false)} {values}")
    console.println("{twoFresh(4)} {twoFresh(5)}")
    console.println("{chosen(values, 0)} {chosen(values, 1)} {chosen(values, 2)} {values}")
    console.println("{twoFresh(4)} {twoFresh(5)}")
    console.println("{bothGiven(values, true)} {bothGiven(values, false)} {values}")
    console.println("{twoFresh(4)} {twoFresh(5)}")
    console.println("{looped(values, true, 2)} {looped(values, false, 2)} {values}")
    console.println("{twoFresh(4)} {twoFresh(5)}")
    let text = "a text made of more than seven bytes"
    console.println("{worded(text, true)} {worded(text, false)} {text}")
    console.println("{twoFresh(4)} {twoFresh(5)}")
    let box = Box { items: values, name: "box" }
    console.println("{boxed(box, true).items} {boxed(box, false).items} {box.items}")
    console.println("{twoFresh(4)} {twoFresh(5)}")
    for plain in [true, false] {
        match recover { stopped(values.reversed(), plain, 3) } {
            ok(kept) => console.println("{kept}")
            err(stop) => console.println(stop.message)
        }
        console.println("{twoFresh(4)} {twoFresh(5)}")
    }
    console.println("{stopped(values.reversed(), false, 9)} {values}")
    console.println("{twoFresh(4)} {twoFresh(5)}")
}

// expect-stdout: [1, 9, 3, 5] [5, 3, 9, 1, 0] [5, 3, 9, 1]
// expect-stdout: [10, 11, 12, 13] [20, 21, 22, 23] [10, 11, 12, 13, 14] [20, 21, 22, 23, 24]
// expect-stdout: [1, 9, 3, 5] [3, 9, 1] [5, 3, 9, 1, 2] [5, 3, 9, 1]
// expect-stdout: [10, 11, 12, 13] [20, 21, 22, 23] [10, 11, 12, 13, 14] [20, 21, 22, 23, 24]
// expect-stdout: [5, 3, 9, 1, 1] [5, 3, 9, 1, 2] [5, 3, 9, 1]
// expect-stdout: [10, 11, 12, 13] [20, 21, 22, 23] [10, 11, 12, 13, 14] [20, 21, 22, 23, 24]
// expect-stdout: [1, 9, 3, 5, 0, 1] [5, 3, 9, 1, 0, 0, 1] [5, 3, 9, 1]
// expect-stdout: [10, 11, 12, 13] [20, 21, 22, 23] [10, 11, 12, 13, 14] [20, 21, 22, 23, 24]
// expect-stdout: A TEXT MADE OF MORE THAN SEVEN BYTES a text made of more than seven bytes! a text made of more than seven bytes
// expect-stdout: [10, 11, 12, 13] [20, 21, 22, 23] [10, 11, 12, 13, 14] [20, 21, 22, 23, 24]
// expect-stdout: [1, 9, 3, 5] [5, 3, 9, 1, 0] [5, 3, 9, 1]
// expect-stdout: [10, 11, 12, 13] [20, 21, 22, 23] [10, 11, 12, 13, 14] [20, 21, 22, 23, 24]
// expect-stdout: 4 values, more than 3
// expect-stdout: [10, 11, 12, 13] [20, 21, 22, 23] [10, 11, 12, 13, 14] [20, 21, 22, 23, 24]
// expect-stdout: 5 values, more than 3
// expect-stdout: [10, 11, 12, 13] [20, 21, 22, 23] [10, 11, 12, 13, 14] [20, 21, 22, 23, 24]
// expect-stdout: 5 values, from 1 to 0, 18 in all
// expect-stdout: [1, 9, 3, 5, 0] [5, 3, 9, 1]
// expect-stdout: [10, 11, 12, 13] [20, 21, 22, 23] [10, 11, 12, 13, 14] [20, 21, 22, 23, 24]
