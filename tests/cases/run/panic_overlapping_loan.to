fn swap(a: mut Int, b: mut Int) {
    let previous = a
    a = b
    b = previous
}

fn main() {
    var values = [1, 2, 3]
    let i = 2
    swap(mut values[i], mut values[-1])
}

// expect-panic: P0004
// expect-stderr: panic[P0004]: overlapping-borrow: one call cannot lend an element twice: two of its arguments reach index 2 of the same array
