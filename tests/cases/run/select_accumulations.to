import std.console

// `if cond { total += value }` in a release build adds `value` or zero
// with no jump: its check still fails only when the way that adds would
// have overflowed, as adding zero never does, for additions and
// subtractions, signed and unsigned.

fn evens(values: Array[Int]): Int {
    var total = 0
    for value in values {
        if value % 2 == 0 {
            total += value
        }
    }
    total
}

fn spend(budget: UInt, costs: Array[UInt]): UInt {
    var left = budget
    for cost in costs {
        if cost <= left {
            left -= cost
        }
    }
    left
}

fn main() {
    console.println("{evens([1, 2, 3, 4, 5, 6])} {evens([])} {evens([7, 9])}")
    let costs: Array[UInt] = [30, 50, 40, 15]
    console.println("{spend(100, costs)} {spend(10, costs)}")
    // Odd, and past what the total can hold: not added, nothing fails.
    let huge = 9223372036854775806
    console.println("{evens([huge, 7, -3])}")
    // Even and past it: the addition's check fails.
    console.println("{evens([huge, 2])}")
}
// expect-stdout: 12 0 0
// expect-stdout: 5 10
// expect-stdout: 9223372036854775806
// expect-panic: P0005
