// Temporary entries where a program wants them, named as it wants: the last
// `*` of the pattern is made random, or random characters end the name.

import std.console
import std.fs
import std.path

fn name(of: String): String {
    return path.fileName(of) ?? ""
}

fn main(): !fs.FsError {
    let dir = fs.createTemporaryDirectory(pattern: "work-*")?
    defer {
        _ = fs.remove(dir, recursive: true)
    }
    console.println("{name(dir).startsWith("work-")}")
    let report = fs.createTemporaryFile(directory: dir, pattern: "report-*.json")?
    let file = name(report)
    console.println("{path.parent(report) == dir} {file.startsWith("report-")} {file.endsWith(".json")} {file.length() > 12}")
    let other = fs.createTemporaryFile(directory: dir, pattern: "report-*.json")?
    console.println("{other != report} {fs.readText(report)?.isEmpty()}")
    let plain = fs.createTemporaryDirectory(directory: dir, pattern: "cache")?
    console.println("{name(plain).startsWith("cache")} {name(plain) != "cache"} {(fs.metadata(plain)?.permissions & 0o777) == 0o700}")
    console.println("{fs.createTemporaryFile(directory: dir, pattern: "a/b")}")
    console.println("{fs.createTemporaryFile(directory: "{dir}/missing")}")
}

// expect-stdout: true
// expect-stdout: true true true true
// expect-stdout: true true
// expect-stdout: true true true
// expect-stdout: err(invalid name)
// expect-stdout: err(not found)
