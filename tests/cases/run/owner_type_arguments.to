// A function without `self` of a generic type takes the type's arguments
// before its name when nothing else gives them (11.5): `Box[Float].count()`.

import std.console

type Box[T] = {
    value: T
}

fn Box[T].count(): Int {
    1
}

fn Box[T].wrap(value: T): Box[T] {
    Box { value }
}

fn Box[T].convert[U](value: T, change: fn(T): U): Box[U] {
    Box { value: change(value) }
}

type Pair[A, B] = {
    first: A
    second: B
}

fn Pair[A, B].names(): String {
    "first and second"
}

fn main() {
    console.println("{Box[Float].count()} {Box[Float].wrap(3.5).value} {Box.wrap(2).value}")
    console.println("{Box[Int].convert(4, (n) { "{n * 2}" }).value}")
    console.println(Pair[Int, String].names())
}

// expect-stdout: 1 3.5 2
// expect-stdout: 8
// expect-stdout: first and second
