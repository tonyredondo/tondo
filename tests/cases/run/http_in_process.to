// `App.client()` sends requests to an app in the same process, with no
// port; `http.proxy` passes requests on to another server, and back; a body
// that breaks the rules of its type is answered with `422` and each
// violation; `http.mediaType` names the type of a file.

import std.console
import std.http
import std.validate

pub type Signup = {
    @validate.Length(min: 3)
    name: String
    @validate.Min(18)
    age: Int
}

fn main(): !http.HttpError {
    var backend = http.App.new()
    backend.get(
        "/items/:id",
        (request) {
            let host = request.header("x-forwarded-host").unwrapOr("")
            http.Reply
                .text("item {request.param("id")} via {host} {request.rawQuery()}")
                .header("x-backend", "yes")
        },
    )
    backend.post("/echo", (request) { http.Reply.text("echo {request.text()?}", status: 201) })
    backend.get("/missing", (_) { http.Reply.text("nope", status: 404) })
    backend.post(
        "/signup",
        (request) {
            let signup = request.json[Signup]()?
            http.Reply.text("welcome {signup.name}", status: 201)
        },
    )
    let server = backend.start()?

    var front = http.App.new()
    front.route("GET", "/api/*rest", http.proxy(server.url(), strip: "/api"))
    front.route("POST", "/api/*rest", http.proxy(server.url(), strip: "/api"))
    let client = front.client()
    let item = client.get("/api/items/7", query: ["a": "1"])?
    console.println("{item.status()} {item.header("x-backend")} {item.text()?}")
    let echoed = client.post("/api/echo", body: http.Body.text("hi"))?
    console.println("{echoed.status()} {echoed.text()?}")
    match client.get("/api/missing") {
        err(http.HttpError.Status(answer)) => console.println("{answer.status()} {answer.text()?}")
        other => console.println("{other.isOk()}")
    }
    let welcome =
        client.post("/api/signup", body: http.Body.text(r"""{"name": "ada", "age": 36}"""))?
    console.println("{welcome.status()} {welcome.text()?}")
    match client.post("/api/signup", body: http.Body.text(r"""{"name": "al", "age": 12}""")) {
        err(http.HttpError.Status(answer)) => console.println("{answer.status()} {answer.text()?}")
        other => console.println("{other.isOk()}")
    }
    console.println(
        "{http.mediaType("site.css")} {http.mediaType("data.json")} {http.mediaType("README")}",
    )
    server.stop()
}

// expect-stdout: 200 some(yes) item 7 via app a=1
// expect-stdout: 201 echo hi
// expect-stdout: 404 nope
// expect-stdout: 201 welcome ada
// expect-stdout: 422 {"status":422,"detail":"the value breaks the rules of its type: name: must have at least 3 characters; age: must be at least 18","errors":[{"path":"name","message":"must have at least 3 characters"},{"path":"age","message":"must be at least 18"}]}
// expect-stdout: text/css application/json application/octet-stream
