// `tondo optimizations` says where what each place allocates goes: in a
// region of the function that makes it, when nothing keeps it past the call
// but arrays a loop only pushes to, or in that of a turn of a loop; in one
// its caller gives, when the function only returns it and no caller keeps
// it, through a copy for the calls that let it go when another keeps it; or
// on the heap, with why: stored in what the function was given or in a
// lock's state, captured by a closure, sent, taken by a task, kept past a
// turn as a variable the next turn writes over, or no region takes it yet.

import std.console
import std.sync

fn digits(n: Int): Array[Int] {
    var out: Array[Int] = if n < 10 { [] } else { digits(n / 10) }
    out.push(n % 10)
    out
}

fn fill(into: var Array[Array[Int]], n: Int) {
    into.push([n, n + 1])
}

fn counter(n: Int): fn(): Int {
    var seen: Array[Int] = []
    seen.push(n)
    () { seen.length() }
}

fn send(sender: Sender[Array[Int]], n: Int) {
    var batch: Array[Int] = []
    batch.push(n)
    sender.send(batch)
}

fn worker(values: Array[Int]): Int {
    values.length()
}

fn spawned(n: Int): Int {
    var values: Array[Int] = []
    values.push(n)
    let task = spawn worker(values)
    task.wait()
}

fn locked(state: sync.Mutex[Array[Array[Int]]], n: Int) {
    var kept: Array[Int] = []
    kept.push(n)
    state.update((all) { all.push(kept) })
}

fn main() {
    var into: Array[Array[Int]] = []
    fill(var into, 1)
    let count = counter(2)
    let (sender, receiver) = channel[Array[Int]](2)
    send(sender.copy(), 3)
    let state = sync.Mutex([[0]])
    locked(state, 4)
    var local: Array[Int] = []
    local.push(digits(1234).length())
    report(sender, 56)
    console.println(
        "{into.length()} {count()} {receiver.receive()?.length() ?? 0} {spawned(5)} {local} {receiver.receive()?.length() ?? 0}",
    )
    console.println("{turns(3)} {gathered(2)} {tally(4)} {latest(3)} {lent(1)}")
}

fn report(sender: Sender[Array[Int]], n: Int) {
    sender.send(digits(n))
}

fn turns(n: Int): Int {
    var total = 0
    for i in 0..n {
        var row: Array[Int] = []
        row.push(i)
        total += row.length()
    }
    total
}

fn gathered(n: Int): Int {
    var rows: Array[Array[Int]] = []
    for i in 0..n {
        rows.push([i, i])
    }
    rows.length()
}

fn tally(n: Int): Int {
    var counts = ["a": 1]
    counts["b"] = n
    counts.length()
}

fn latest(n: Int): Int {
    var last: Array[Int] = []
    for i in 0..n {
        last = [i, i + 1]
    }
    last.length()
}

type Row = { values: Array[Int] }

fn lent(n: Int): Int {
    var rows = [Row { values: [0] }, Row { values: [0] }]
    var turn = 0
    for mut row in rows {
        turn += n
        row.values = [turn, turn * 10]
    }
    rows[0].values[0] + rows[1].values[0]
}

// expect-stdout: 1 1 1 1 [4] 2
// expect-stdout: 3 2 2 2 3
// expect-optimization: 15:5 region goes in a region that the caller of `digits` gives, in a copy of it for the calls that let it go: `main`
// expect-optimization: 15:5 region keeps it: it is sent
// expect-optimization: 20:15 region stays on the heap: it is stored in what the function was given
// expect-optimization: 20:15 region goes in a region of `main`
// expect-optimization: 25:5 region stays on the heap: a closure captures it
// expect-optimization: 31:5 region stays on the heap: it is sent
// expect-optimization: 41:5 region stays on the heap: a task takes it
// expect-optimization: 48:5 region stays on the heap: it is stored in a lock's state
// expect-optimization: 58:28 region stays on the heap: it is stored in a lock's state
// expect-optimization: 61:5 region goes in a region of `main`
// expect-no-optimization: 61:5 region stays on the heap
// expect-optimization: 77:9 region goes in the region of a turn of the loop at line 75
// expect-optimization: 86:19 region goes in a region of `gathered`
// expect-optimization: 86:9 region goes in a region of `gathered`
// expect-optimization: 100:16 region stays on the heap: it outlives a turn of the loop at line 99
// expect-optimization: 92:18 region stays on the heap: regions do not take maps yet
// expect-optimization: 112:22 region stays on the heap: it outlives a turn of the loop at line 110
