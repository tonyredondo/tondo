// Deques in a region: grown at either end, emptied from the front and the
// back and written by index, as a queue that slides through its storage,
// one that keeps a window of a steady size in the room it has, however
// many turns it slides, and one of texts the region made; one its function
// returns stays on the heap. One emptied by `clear()` keeps its room in its
// function's region, and stays on the heap in `main`, whose region lasts as
// long as the program, which the remark names.

import std.console

/// A queue of numbers that slides through its storage.
fn slid(n: Int): Int {
    var queue = Deque[Int]()
    var total = 0
    for i in 0..n {
        queue.push(i)
        if i % 3 != 0 {
            total += queue.popFront() ?? 0
        }
    }
    total + queue.length()
}

/// A window of eight that slides `n` turns: its room stays the one it
/// took, whatever `n` is.
fn steady(n: Int): Int {
    var window = Deque[Int]()
    for i in 0..8 {
        window.push(i)
    }
    var total = 0
    for i in 0..n {
        window.push(i)
        total += window.popFront() ?? 0
    }
    total + window.length()
}

/// Both ends, and a write by index.
fn ends(n: Int): Int {
    var numbers = Deque[Int]()
    for i in 0..n {
        if i % 2 == 0 {
            numbers.pushFront(i)
        } else {
            numbers.push(i)
        }
    }
    numbers[0] = 100
    let last = numbers.pop() ?? 0
    numbers[0] + last + numbers.length()
}

/// Texts the region made, taken from the front.
fn words(n: Int): Int {
    var queue = Deque[String]()
    for i in 0..n {
        queue.push("w{i}")
    }
    var length = 0
    for {
        let word = queue.popFront() ?? break
        length += word.length()
    }
    length
}

/// A deque returned: on the heap.
fn made(n: Int): Deque[Int] {
    var numbers = Deque[Int]()
    for i in 0..n {
        numbers.push(i)
    }
    numbers
}

/// Emptied by `clear()`, which keeps its room: in its function's region,
/// and on the heap where it is inlined into `main`, whose region lasts as
/// long as the program.
fn cleared(n: Int): Int {
    var numbers = Deque[Int]()
    for i in 0..n {
        numbers.push(i)
    }
    numbers.clear()
    numbers.length()
}

fn main() {
    console.println("{slid(30)} {ends(10)} {words(12)} {made(4).length()} {cleared(5)} {steady(100)}")
}

// expect-stdout: 200 118 26 4 0 4222
// expect-optimization: 16:9 region grows a deque that goes in a region of `slid`
// expect-optimization: 18:22 region changes a deque that goes in a region of `slid`
// expect-optimization: 33:9 region grows a deque that goes in a region of `steady`
// expect-optimization: 34:18 region changes a deque that goes in a region of `steady`
// expect-optimization: 44:13 region grows a deque that goes in a region of `ends`
// expect-optimization: 46:13 region grows a deque that goes in a region of `ends`
// expect-optimization: 49:5 region changes a deque that goes in a region of `ends`
// expect-optimization: 50:16 region changes a deque that goes in a region of `ends`
// expect-optimization: 58:9 region grows a deque that goes in a region of `words`
// expect-optimization: 58:20 region goes in a region of `words`
// expect-optimization: 62:20 region changes a deque that goes in a region of `words`
// expect-optimization: 72:9 region grows a deque that stays on the heap: `made` returns it
// expect-optimization: 83:9 region grows a deque that goes in a region of `cleared`
// expect-optimization: 83:9 region it is emptied in `main`, whose region lasts as long as the program
