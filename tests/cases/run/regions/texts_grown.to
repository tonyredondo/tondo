// Texts that grow in place, `x = "{x}..."`, which regions take: the text
// goes on in its own room, in the region, while nothing else holds it,
// its room doubling as it grows, and is copied into the region when
// something does. In the region of a function, of a turn and of a caller,
// short and longer than the 64 bytes from which a text keeps the
// positions of its characters, and read by index once grown; and past a
// mebibyte, alone in a chunk of its own that grows as a block on the heap
// does, still its region's while an array of the region holds it, which
// the run checks for leaks as every case does. Grown across the turns of a
// loop, it goes in the function's region while only its own local and
// arrays the loop only pushes to hold it, and stays on the heap when a
// value of the turn holds it as it grows, or the loop writes it otherwise.

import std.console

/// In the region of the function: one line grown for each turn.
fn built(count: Int): Int {
    var line = ""
    for i in 0..count {
        line = "{line}[{i}]"
    }
    line.length()
}

/// In the region of a turn: a row grown in each, let go of at its end.
fn turns(): Int {
    var total = 0
    for i in 0..3 {
        var row = "row {i}:"
        for k in 0..30 {
            row = "{row} {k}"
        }
        total += row.length()
        total += "{row[row.length() - 1]}".length()
    }
    total
}

/// Returned, in the region its caller gives.
fn kept(count: Int): String {
    var text = ""
    for i in 0..count {
        text = "{text}{i % 10}"
    }
    text
}

/// Grown across the turns of its loop past a mebibyte: in the function's
/// region, its room doubling, then alone in a chunk of its own.
fn long(count: Int): Int {
    var text = ""
    for _ in 0..count {
        text = "{text}0123456789abcdef"
    }
    text.length() + "{text[count * 16 - 1]}".length()
}

/// Grown past the mebibyte while an array of the function's region holds
/// it: it stays the region's, in a chunk of its own, and nothing leaks.
fn held(count: Int): Int {
    var rows: Array[String] = []
    let half = "0123456789abcdef".repeat(count)
    var text = "{half}"
    text = "{text}{half}"
    rows.push(text)
    rows.push("{text}!")
    rows[0].length() + rows[1].length()
}

/// The same in the region of each turn.
fn heldInTurns(): Int {
    var total = 0
    for i in 0..2 {
        var rows: Array[String] = []
        var text = "{i}"
        for _ in 0..70_000 {
            text = "{text}0123456789abcdef"
        }
        rows.push(text)
        total += rows[0].length()
    }
    total
}

/// Held twice: the first is copied, the second stays as it was.
fn shared(): String {
    var first = "a"
    let second = first
    first = "{first}b"
    first = "{first}c"
    "{first}/{second}"
}

fn noise(): Int {
    var total = 0
    for i in 0..200 {
        let junk = "junk {i} {i} {i} {i}"
        total += junk.length()
    }
    total
}

/// Grown across the turns while an array the loop only pushes to holds it:
/// in the function's region, each copy it then makes the array's.
fn pushedEachTurn(): Int {
    var rows: Array[String] = []
    var text = ""
    for i in 0..20 {
        text = "{text}{i % 10}"
        rows.push(text)
    }
    rows.length() + rows[19].length() + text.length()
}

/// Held as it grows by what a turn lets go of: a copy at every turn, which
/// the heap frees and a region would keep, so it stays on the heap.
fn snapshots(): Int {
    var text = ""
    var total = 0
    for i in 0..20 {
        let before = text
        text = "{text}{i % 10}"
        total += before.length()
    }
    total + text.length()
}

/// Written whole otherwise in the loop, starting again: on the heap.
fn restarted(): Int {
    var text = ""
    var total = 0
    for i in 0..30 {
        if i % 10 == 0 {
            text = ""
        }
        text = "{text}{i}"
        total += text.length()
    }
    total
}

fn main() {
    let a = built(100)
    let b = turns()
    var lengths = 0
    for i in 0..3 {
        lengths += kept(50 + i).length()
    }
    let c = kept(70)
    let d = shared()
    let e = long(100_000)
    let f = held(40_000)
    let g = heldInTurns()
    let quiet = noise()
    console.println("{a} {b} {lengths} {c.length()} {c[69]} {d} {e} {f} {g} {quiet}")
    console.println("{pushedEachTurn()} {snapshots()} {restarted()}")
}

// expect-stdout: 390 261 153 70 9 abc/a 1600001 2560001 2240002 3560
// expect-stdout: 60 210 275
// expect-optimization: 20:9 region goes in a region of `main`
// expect-optimization: 31:13 region goes in the region of a turn of the loop at line 28
// expect-optimization: 53:9 region goes in a region of `long`
// expect-optimization: 64:5 region goes in a region of `held`
// expect-optimization: 65:5 region grows an array that goes in a region of `held`
// expect-optimization: 77:13 region goes in the region of a turn of the loop at line 73
// expect-optimization: 79:9 region grows an array that goes in the region of a turn of the loop at line 73
// expect-optimization: 89:5 region goes in a region of `shared`
// expect-optimization: 109:9 region goes in a region of `pushedEachTurn`
// expect-optimization: 110:9 region grows an array that goes in a region of `pushedEachTurn`
// expect-optimization: 122:9 region stays on the heap: it outlives a turn of the loop at line 120
// expect-optimization: 136:9 region stays on the heap: it outlives a turn of the loop at line 132
