// A function that stays a call and makes values in every turn of a loop,
// for the region its caller gives when it returns one of them, held to a
// fixed bound of memory after the loop: a region keeps nothing that a turn
// makes and the next no longer needs. One whose words leave only by a
// `fail`, and one whose last words replace the others', each over 200,000
// turns, hold their memory flat, where without the rule they held 45 MB;
// one that keeps every turn's words on purpose grows with the turns, in a
// region or on the heap. Nor does a function that calls another in every
// turn pass it the region its caller gives. The bytes are the runtime's own
// count, of its regions and of its heap.

import std.console
import std.diagnostics

pub enum Bad {
    Word(String)
}

/// Each turn splits a line; only the `fail` carries a word out.
fn exitOnly(n: Int): Int ! Bad {
    var spare = 0
    for k in 0..n % 97 {
        if k % 11 == 4 {
            spare += k * 5
        } else if k % 13 == 6 {
            spare -= k
        } else {
            spare += 2
        }
    }
    var total = spare % 2
    for i in 0..n {
        let words = "first second third {i}".split(" ")
        if words.length() > 9 {
            fail Word(words[1])
        }
        total += words.length()
    }
    total
}

/// Each turn's words replace the last turn's, which are returned.
fn lastOnly(n: Int): Array[String] {
    var spare = 0
    for k in 0..n % 97 {
        if k % 11 == 4 {
            spare += k * 5
        } else if k % 13 == 6 {
            spare -= k
        } else {
            spare += 2
        }
    }
    var last: Array[String] = ["{spare}"]
    for i in 0..n {
        let words = "first second third {i}".split(" ")
        if words.length() > 1 {
            last = words
        }
    }
    last
}

/// Every turn's words are kept in what is returned.
fn keptAll(n: Int): Array[Array[String]] {
    var spare = 0
    for k in 0..n % 97 {
        if k % 11 == 4 {
            spare += k * 5
        } else if k % 13 == 6 {
            spare -= k
        } else {
            spare += 2
        }
    }
    var all: Array[Array[String]] = [["{spare}"]]
    for i in 0..n {
        all.push("first second third {i}".split(" "))
    }
    all
}

/// The words of a line, as a function that stays a call makes them.
fn wordsOf(i: Int, n: Int): Array[String] {
    var spare = 0
    for k in 0..n % 97 {
        if k % 11 == 4 {
            spare += k * 5
        } else if k % 13 == 6 {
            spare -= k
        } else {
            spare += 2
        }
    }
    for k in 0..spare % 89 {
        if k % 17 == 5 {
            spare -= 1
        } else if k % 19 == 7 {
            spare += 3
        }
    }
    if spare == -999 {
        return []
    }
    "first second third {i}".split(" ")
}

/// Calls `wordsOf` in every turn and returns the last turn's.
fn lastCalled(n: Int): Array[String] {
    var spare = 0
    for k in 0..n % 97 {
        if k % 11 == 4 {
            spare += k * 5
        } else if k % 13 == 6 {
            spare -= k
        } else {
            spare += 2
        }
    }
    var last: Array[String] = ["{spare}"]
    for i in 0..n {
        last = wordsOf(i, n)
    }
    last
}

/// The bytes the program holds now: in regions, and on the heap.
fn held(): Int {
    var bytes = 0
    for metric in diagnostics.metrics() {
        if metric.name == "memory.regions" or metric.name == "memory.held" {
            bytes += metric.value
        }
    }
    bytes
}

/// What a call holds after it returns, said against a bound of a mebibyte.
fn said(name: String, grew: Int): String {
    match grew <= 1048576 {
        true => "{name}: flat"
        false => "{name}: grew by {grew} bytes"
    }
}

fn main() {
    let before = held()
    let total = match exitOnly(200000) {
        ok(total) => total
        err(_) => -1
    }
    console.println(said("exit only", held() - before))
    let middle = held()
    let last = lastOnly(200000)
    console.println(said("last only", held() - middle))
    let called = held()
    let lastWords = lastCalled(200000)
    console.println(said("last called", held() - called))
    let end = held()
    let all = keptAll(100000)
    let grew = held() - end > 1048576
    console.println("kept on purpose grows: {grew}")
    console.println("{total} {last} {lastWords} {all.length()}")
}

// expect-stdout: exit only: flat
// expect-stdout: last only: flat
// expect-stdout: last called: flat
// expect-stdout: kept on purpose grows: true
// expect-stdout: 800001 [first, second, third, 199999] [first, second, third, 199999] 100001
// expect-optimization: 56:21 region stays on the heap: it is made in every turn of the loop at line 55, and the region the caller of `lastOnly` gives would keep each turn's
// expect-optimization: 78:9 region grows an array that goes in a region that the caller of `keptAll` gives
// expect-optimization: 78:18 region goes in a region that the caller of `keptAll` gives
// expect-optimization: 105:5 region stays on the heap: `wordsOf` returns it, and `lastCalled` calls it in every turn of a loop, where the region its caller gives would keep each turn's
