// The runtime's codecs, hashes and ciphers, which read the bytes they are
// given or copy what they keep (`READING` in regions.rs): each loop gives
// them an array its turn makes in the turn's region, as the remarks below
// say, uses what they give within the turn, and uses again after the loop,
// once the regions ended, what keeps state: hashers, keys, an archive.

import std.archive
import std.console
import std.crypto
import std.encoding
import std.gzip
import std.hash
import std.io
import std.profile
import std.zstd

fn b(i: Int): Byte {
    Byte(i % 256) ?? Byte(0u8)
}

fn noise(): Int {
    var total = 0
    for i in 0..200 {
        var junk = [i, i, i, i, i, i, i, i]
        junk.push(i)
        total += junk.length()
    }
    total
}

fn encoded(): String {
    var lines: Array[String] = []
    for i in 0..3 {
        var data = [b(i), b(i + 1)]
        data.push(b(i + 2))
        lines.push("{encoding.base64Encode(data)} {encoding.hexEncode(data)}")
        lines.push("{(gzip.decompress(gzip.compress(data)) ?? []).length()}")
        lines.push("{(zstd.decompress(zstd.compress(data)) ?? []).length()}")
    }
    lines.join(" ")
}

fn hashed(hasher: hash.Hasher, keyed: var Array[hash.Hasher]): String {
    var lines: Array[String] = []
    for i in 0..3 {
        var data = [b(i), b(i + 3)]
        data.push(b(i + 4))
        lines.push("{hash.md5(data).hex()} {hash.hmacSha256(data, data).hex()}")
        hasher.update(data)
        keyed.push(hash.hmac(hash.Algorithm.Sha1, data))
    }
    lines.join(" ")
}

fn ciphered(key: crypto.SecretKey, signer: crypto.PrivateKey, public: crypto.PublicKey): String {
    var lines: Array[String] = []
    for i in 0..3 {
        var data = [b(i), b(i + 5)]
        data.push(b(i + 6))
        let opened = key.open(key.seal(data, data), data) ?? []
        let derived = "{crypto.hkdf(data, data, data, 4)} {crypto.pbkdf2(data, data, 2, 4)}"
        lines.push("{opened.length()} {derived} {public.verify(data, signer.sign(data))}")
    }
    lines.join(" ")
}

fn archived(zip: archive.Writer): Int {
    var added = 0
    for i in 0..3 {
        var data = [b(i), b(i + 7)]
        data.push(b(i + 8))
        _ = zip.add("file{i}", data)
        added += 1
    }
    added
}

fn labelled(): Int {
    var set = 0
    for i in 0..3 {
        _ = profile.setLabels(["turn": "{i}"])
        set += 1
    }
    set
}

fn main() {
    let hasher = hash.hasher(hash.Algorithm.Sha256)
    var keyed: Array[hash.Hasher] = []
    var keyBytes: Array[Byte] = []
    for k in 0..32 {
        keyBytes.push(b(k))
    }
    let key = crypto.SecretKey.fromBytes(keyBytes) ?? crypto.SecretKey.generate()
    let signer = crypto.PrivateKey.generate()
    let public = signer.publicKey()
    let buffer = io.Buffer()
    let zip = archive.writer(buffer.writer(), archive.Format.Zip)
    let a = encoded()
    let c = hashed(hasher, var keyed)
    let d = ciphered(key, signer, public)
    let e = archived(zip)
    let f = labelled()
    let quiet = noise()
    _ = zip.finish()
    var later: Array[String] = []
    for i in 0..3 {
        let data = [b(i), b(i + 9)]
        keyed[i].update(data)
        later.push(keyed[i].finish().hex())
        later.push("{public.verify(data, signer.sign(data))} {key.open(key.seal(data), []) ?? []}")
    }
    let zipped = archive.read(buffer.bytes()) ?? panic("no zip")
    for entry in zipped.entries() {
        later.push("{entry.name} {zipped.readBytes(entry.name) ?? []}")
    }
    console.println(a)
    console.println(c)
    console.println(d)
    console.println("{e} {f} {quiet} {hasher.finish().hex()}")
    console.println(later.join(" "))
}

