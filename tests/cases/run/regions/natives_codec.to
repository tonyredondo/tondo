// expect-stdout: 3 [142, 75, 206, 23] [38, 14, 80, 149] true 3 [198, 78, 61, 210] [22, 125, 241, 150] true 3 [97, 109, 37, 167] [28, 167, 214, 109] true
// expect-stdout: 3 3 1800 a18449a7f3f820de89e1a5e00bc79c8bb6d44ce9b7c6ce40c4a174c2b9c60290
