// Characters say their general category and script, and their class as
// punctuation, symbols or marks, which with NFD takes the accents away;
// a collator orders texts as a language does, at a strength, and with
// numbers by their value.

import std.console
import std.text

fn sorted(words: Array[String], order: text.Collator): String {
    words.sortedWith((a, b) { order.compare(a, b) }).join(" ")
}

fn main() {
    for c in [
        'a',
        'A',
        'ǅ',
        '\u{301}',
        '5',
        'Ⅻ',
        '.',
        '«',
        '+',
        '€',
        '©',
        ' ',
        '\n',
        '字',
        'ب',
        'я',
        'α',
        '\u{378}',
    ] {
        console.println(
            "{c.code()} {text.category(c)} {text.script(c)} {c.isPunctuation()} {c.isSymbol()} {c.isMark()}",
        )
    }
    let plain = text
        .normalize("Crème brûlée", text.Normalization.Nfd)
        .chars()
        .filter((c) { not c.isMark() })
        .collect()
        .map((c) { "{c}" })
        .join("")
    console.println(plain)

    let words = ["zorro", "ñu", "nube", "árbol", "Ábaco", "abeja", "Zeta", "öl", "ost"]
    console.println(sorted(words, text.collator("es")))
    console.println(sorted(words, text.collator("sv")))
    console.println(sorted(words, text.collator("und")))
    console.println(sorted(["file10", "file2", "file1"], text.collator("en", numeric: true)))
    console.println(sorted(["chico", "hola", "casa"], text.collator("cs")))
    let loose = text.collator("es", strength: text.Strength.Primary)
    let accents = text.collator("es", strength: text.Strength.Secondary)
    console.println(
        "{loose.compare("Árbol", "arbol")} {accents.compare("Árbol", "árbol")} {accents.compare("arbol", "árbol")} {text.collator("es").compare("Árbol", "arbol")}",
    )
}

