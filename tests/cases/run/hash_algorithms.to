// std.hash: MD5 and SHA-384, digests and HMACs in parts, and hashes that
// are not for security, with the values of their reference implementations.

import std.console
import std.hash

fn main() {
    let a = "a".bytes()
    let foobar = "foobar".bytes()
    console.println("{hash.md5(a)} {hash.sha384("abc".bytes()).hex().slice(0, 16).unwrapOr("")}")
    // In parts, the same as at once; and it takes more after.
    let digest = hash.hasher(hash.Algorithm.Sha256)
    digest.update("hello ".bytes())
    console.println("{digest.finish() == hash.sha256("hello ".bytes())}")
    digest.update("world".bytes())
    console.println("{digest.finish() == hash.sha256("hello world".bytes())}")
    let mac = hash.hmac(hash.Algorithm.Sha512, "key".bytes())
    mac.update("da".bytes())
    mac.update("ta".bytes())
    console.println("{mac.finish() == hash.hmacSha512("key".bytes(), "data".bytes())}")
    console.println(
        "{hash.fnv32(a).toString(radix: 16)} {hash.fnv32a(a).toString(radix: 16)} {hash.fnv64(foobar).toString(radix: 16)} {hash.fnv64a(foobar).toString(radix: 16)}",
    )
    for text in ["", "abc", "Nobody inspects the spammish repetition"] {
        console.println("{hash.xxhash64(text.bytes()).toString(radix: 16)}")
    }
    console.println("{hash.xxhash64(a, seed: 1).toString(radix: 16)}")
    for text in ["", "hello", "The quick brown fox jumps over the lazy dog"] {
        console.println("{hash.murmur3(text.bytes()).toString(radix: 16)}")
    }
}

