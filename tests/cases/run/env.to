import std.console
import std.env

fn main(): !env.EnvError {
    console.println("args {env.args()}")
    console.println("home set {env.get("PATH") != none} missing {env.get("TONDOT_SURELY_MISSING")}")
    env.set("TONDOT_A", "1")
    env.setAll(["TONDOT_B": "2", "TONDOT_C": "3"])
    env.remove("TONDOT_C")
    console.println("{env.get("TONDOT_A")} {env.get("TONDOT_B")} {env.get("TONDOT_C")}")
    for (name, value) in env.vars() {
        if name.startsWith("TONDOT_") {
            console.println("{name}={value}")
        }
    }
    let start = env.currentDirectory()
    env.setCurrentDirectory("/tmp")?
    // `/tmp` may be a link, as on macOS.
    console.println("now in tmp {env.currentDirectory().endsWith("/tmp")}")
    match env.setCurrentDirectory("/surely/missing") {
        ok(_) => console.println("unexpected")
        err(error) => console.println("cd failed: {error}")
    }
    env.setCurrentDirectory(start)?
    env.syncNative()
    // The machine and the process.
    console.println("{env.hostname().length() > 0} {env.processId() > 0} {env.executable().startsWith("/")}")
    env.set("BAD=NAME", "x")
}

// expect-stdout: args []
// expect-stdout: home set true missing none
// expect-stdout: some(1) some(2) none
// expect-stdout: TONDOT_A=1
// expect-stdout: TONDOT_B=2
// expect-stdout: now in tmp true
// expect-stdout: cd failed: not found
// expect-stdout: true true true
// expect-panic: P0015
// expect-stderr: panic[P0015]: invalid-environment-name: the environment variable name `BAD=NAME` has a `=`, which ends a name
