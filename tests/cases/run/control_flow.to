import std.console

fn classify(n: Int): String {
    if n < 0 {
        "negative"
    } else if n == 0 {
        "zero"
    } else {
        "positive"
    }
}

fn main() {
    var total = 0
    for i in 0..10 {
        if i == 7 {
            break
        }
        if i % 2 == 0 {
            continue
        }
        total += i
    }
    var countdown = 3
    for countdown > 0 {
        countdown -= 1
    }
    // An inclusive range up to the type's maximum must not overflow.
    var steps = 0
    for _ in 250u8..=255u8 {
        steps += 1
    }
    let label = { classify(-5) }
    console.println("{total} {countdown} {steps} {label} {classify(0)} {classify(9)}")
}

// expect-stdout: 9 0 6 negative zero positive
