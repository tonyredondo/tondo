// An element of an array a function was given, read in a loop and only
// measured or lent to a call, is neither retained nor released: nothing
// releases it while the array stays as it is. So is one of an array the
// function made, which the loop holds while it runs, when it is used in the
// loop alone, also when the array is replaced in the loop or after it. One
// that is kept, pushed into another array, returned, held past its turn,
// captured or given to a task, is counted as before, and each is what it
// was.

import std.console

type User = {
    name: String
    tags: Array[String]
}

fn lengths(names: Array[String]): Int {
    var count = 0
    for name in names {
        count += name.length()
    }
    count
}

fn kept(names: Array[String]): Array[String] {
    var out: Array[String] = []
    for name in names {
        if name.length() > 3 {
            out.push(name)
        }
    }
    out
}

fn longest(names: Array[String]): String {
    var best = ""
    for name in names {
        if name.length() > best.length() {
            best = name
        }
    }
    best
}

fn first(names: Array[String], wanted: Int): String {
    for name in names {
        if name.length() == wanted {
            return name
        }
    }
    "none"
}

fn later(names: Array[String]): Array[fn(): String] {
    var all: Array[fn(): String] = []
    for name in names {
        all.push(() { name })
    }
    all
}

fn measured(name: String): Int {
    name.length()
}

fn spawned(names: Array[String]): Int {
    var total = 0
    for name in names {
        let job = spawn measured(name)
        total += job.wait()
    }
    total
}

fn described(user: User): String {
    "{user.name}:{user.tags.length()}"
}

fn users(all: Array[User]): Int {
    var total = 0
    for user in all {
        total += described(user).length() + user.tags.length()
    }
    total
}

fn made(count: Int): Array[String] {
    var names: Array[String] = []
    for i in 0..count {
        names.push("local {i}")
    }
    names
}

fn localLengths(count: Int): Int {
    let names = made(count)
    var total = 0
    for name in names {
        total += name.length()
    }
    total
}

fn localLast(count: Int): String {
    var names = made(count)
    var last = ""
    for name in names {
        last = name
    }
    names = ["gone"]
    "{last} {names}"
}

fn replaced(count: Int): Int {
    var names = made(count)
    var total = 0
    for name in names {
        names = []
        total += name.length()
    }
    total + names.length()
}

fn grid(rows: Int): Int {
    var all: Array[Array[String]] = []
    for row in 0..rows {
        all.push(made(row))
    }
    var total = 0
    for row in all {
        for cell in row {
            total += cell.length()
        }
    }
    total
}

fn remember(name: String, into: var Array[String]) {
    if name.length() > 7 {
        into.push(name)
    }
}

fn remembered(count: Int): Array[String] {
    let names = made(count)
    var long: Array[String] = []
    for name in names {
        remember(name, var long)
    }
    long
}

fn main() {
    var names: Array[String] = []
    for i in 0..8 {
        names.push("n{"x".repeat(i)}")
    }
    console.println("{lengths(names)} {kept(names)} {longest(names)} {first(names, 3)} {first(names, 30)}")
    console.println("{later(names).map((f) { f() })} {spawned(names)}")
    var all: Array[User] = []
    for i in 0..4 {
        all.push(User { name: "user {i}", tags: names.take(i) })
    }
    console.println("{users(all)} {names.length()} {all[3].tags}")
    console.println("{localLengths(12)} {localLast(3)} {replaced(4)} {grid(5)} {remembered(12)}")
}

// expect-stdout: 36 [nxxx, nxxxx, nxxxxx, nxxxxxx, nxxxxxxx] nxxxxxxx nxx none
// expect-stdout: [n, nx, nxx, nxxx, nxxxx, nxxxxx, nxxxxxx, nxxxxxxx] 36
// expect-stdout: 38 8 [n, nx, nxx]
// expect-stdout: 86 local 2 [gone] 28 70 [local 10, local 11]
