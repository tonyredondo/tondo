import std.console

// The value of a block is read before its bindings are released.
fn at(n: Int): Int {
    let values = [1, 2]
    values[n]
}

fn main() {
    console.println("{at(1)}")
    console.println("unreachable {at(5)}")
}

// expect-stdout: 2
// expect-panic: P0001
// expect-stderr: panic[P0001]: bounds: index 5 is out of bounds for an array of length 2: valid indices are 0 to 1, and -2 to -1 from the end
