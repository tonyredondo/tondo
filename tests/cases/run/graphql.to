// std.graphql: a schema from the program's types, with their docs; queries
// with arguments, fragments, directives and variables; mutations with input
// objects; errors with their path, null propagated to the nearest field
// that may be null; and introspection.

import std.console
import std.graphql
import std.json
import std.sync

/// What a user may do.
pub enum Role {
    Admin
    Member
}

/// Someone who writes.
pub type User = {
    id: Int
    name: String
    email: String?
    role: Role
}

/// The posts of the user, the newest first.
pub fn User.posts(self, first: Int?): Array[Post] {
    let all = [
        Post { title: "Hello from {self.name}", stars: 3 },
        Post { title: "Again", stars: 1 },
    ]
    all.slice(0, first.unwrapOr(10).min(all.length())).unwrapOr([])
}

pub type Post = {
    title: String
    stars: Int
}

pub type NewUser = {
    name: String
    role: Role
}

/// The queries of the API.
pub type Query = {
    users: sync.Mutex[Array[User]]
}

/// A user by id.
pub fn Query.user(self, id: Int): User? {
    self.users.get().find((u) { u.id == id })
}

/// Every user.
pub fn Query.all(self): Array[User] {
    self.users.get()
}

pub fn Query.failing(self): String ! String {
    fail "not today"
}

pub type Mutation = {
    users: sync.Mutex[Array[User]]
}

/// Adds a user.
pub fn Mutation.addUser(self, user: NewUser): User {
    self.users.update(
        (all) {
            let made = User { id: all.length() + 1, name: user.name, email: none, role: user.role }
            all.push(made)
            made
        },
    )
}

fn main() {
    let users = sync.Mutex(
        [User { id: 1, name: "Ada", email: some("ada@example.com"), role: Role.Admin }],
    )
    let schema = graphql.schema(Query { users }).mutation(Mutation { users })
    console.print(schema.sdl())
    let run = (document: String) {
        console.println(json.encode[json.Value](schema.execute(document)))
    }
    run(r"""{ user(id: 1) { name email role posts(first: 1) { title } } }""")
    run(
        r"""query Named($id: Int!) { user(id: $id) { ...who } } fragment who on User { id name __typename }""",
    )
    run(r"""mutation { addUser(user: {name: "Bo", role: Member}) { id name role } }""")
    run(r"""{ all { name ...@include(if: false) { email } } nope: failing }""")
    run(r"""{ user(id: 1) { missing } }""")
    run(r"""{ user(id: 1) { name """)
    run(r"""{ __schema { queryType { name } types { name kind } } }""")
    run(r"""{ __type(name: "User") { fields { name type { kind name ofType { name } } } } }""")
    console.println(
        json.encode[json.Value](
            schema.execute(
                r"query Q($id: Int!) { user(id: $id) { name } }",
                variables: ["id": json.parse("1").unwrapOr(json.Value.Null)],
            ),
        ),
    )
}

