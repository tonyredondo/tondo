import std.console
import std.io
import std.process
import std.time

fn slow(): Int {
    match process.command("sleep", "5").run() {
        ok(status) => status.code
        err(_) => -1
    }
}

fn main(): !process.ProcessError {
    let started = time.now()
    let job = spawn slow()
    match job.wait(timeout: time.milliseconds(100)) {
        some(code) => console.println("finished {code}")
        none => console.println(
            "timed out, killed quickly {started.elapsed().isLessThan(time.seconds(2))}",
        )
    }
    let yes = (process.command("yes") | process.command("head", "-n", "1")).output()?
    console.println(
        "yes|head: {yes.text()?.length()} success {yes.statuses.length()} {yes.statuses[0].success} {yes.statuses[1].success}",
    )
    let status = (process.command("yes") | process.command("head", "-n", "1")).status()?
    console.println("pipefail with sigpipe: {status.success}")
    let failing = (process.command("false") | process.command("true")).status()?
    console.println("pipefail: {failing.success} {failing.code}")
    _ = process.command("echo", "line one").stdout(process.Output.File("proc_out.txt")).run()?
    _ = process.command("echo", "line two").stdout(process.Output.Append("proc_out.txt")).run()?
    let counted = process.command("wc", "-l").stdin(process.Input.File("proc_out.txt")).output()?
    // macOS pads the count.
    console.println("lines: {counted.text()?.trim()}")
    let buffer = io.Buffer()
    let previous = console.stdout()
    console.setOutput(buffer.writer())
    _ = process.command("echo", "child inherits the redirected console").run()?
    console.setOutput(previous)
    console.println("captured {buffer.length()} bytes")
    var dropped = process.command("sleep", "0.2").start()?
    console.println("pid known {dropped.id() > 0}")
    let quick = time.now()
    {
        let _scoped = process.command("sleep", "0.2").start()?
    }
    console.println("scope waited {not quick.elapsed().isLessThan(time.milliseconds(150))}")
    let cancelled = process.command("sleep", "5").start()?.cancel()?
    console.println("cancelled code {cancelled.code}")
    process.command("sh", "-c", "sleep 0.3; echo detached done > /dev/null").start()?.detach()
    console.println("detached")
    process.exit(7)
}

// expect-stdout: timed out, killed quickly true
// expect-stdout: yes|head: 2 success 2 false true
// expect-stdout: pipefail with sigpipe: true
// expect-stdout: pipefail: false 1
// expect-stdout: lines: 2
// expect-stdout: captured 38 bytes
// expect-stdout: pid known true
// expect-stdout: scope waited true
// expect-stdout: cancelled code 137
// expect-stdout: detached
// expect-exit: 7
