import std.console
import std.text

fn show(result: String ! text.TextError): String {
    match result {
        ok(part) => "[{part}]"
        err(text.TextError.InvalidIndex) => "invalid index"
        err(text.TextError.InvalidBoundary) => "invalid boundary"
        err(_) => "other"
    }
}

fn position(value: Int?): String {
    match value {
        some(n) => "{n}"
        none => "-"
    }
}

fn main() {
    let input = "  Añ🙂 world  "
    let trimmed = input.trim()
    _ = console.println("[{trimmed}] {trimmed.contains("🙂")} {trimmed.startsWith("Añ")} {trimmed.endsWith("x")}")
    _ = console.println("{position(trimmed.find("world"))} {position(trimmed.find("zzz"))} {trimmed.replace("o", "0")}")
    _ = console.println("{trimmed.toUpperAscii()} {trimmed.toLowerAscii()} {String.empty().isEmpty()}")
    _ = console.println("{show(trimmed.slice(1, 3))} {show(trimmed.slice(-1, 2))} {show(trimmed.slice(3, 1))} {show(trimmed.slice(0, 99))}")
    let built = match String.fromChars(['h', 'é', '!']) {
        ok(value) => value
        err(_) => "?"
    }
    var count = 0
    for c in built.chars() {
        count += 1
    }
    _ = console.println("{built} {count}")
}

// expect-stdout: [Añ🙂 world] true true false
// expect-stdout: 4 - Añ🙂 w0rld
// expect-stdout: Añ🙂 WORLD añ🙂 world true
// expect-stdout: [ñ🙂] invalid index invalid boundary invalid index
// expect-stdout: hé! 3
