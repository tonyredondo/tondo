// Two computations hold the two workers, so the monitor puts a worker beside
// each in one look (16.14). Each worker added looks first for the tasks of
// a domain no worker looks for, marked as sought for it. Handed over through
// one slot, the second took the first's domain, and the first domain stayed
// marked with no worker behind it: once the computations ended and every
// worker slept, a task made ready from outside, as by the end of a child
// process, woke nobody, since a worker of that domain seemed to look. With
// two domains of cores it hung thirty times of thirty; now each worker added
// is given its domain as it starts. `TONDO_CACHE_DOMAINS=2` gives the two
// domains on any machine. Nothing here is measured by the clock: a machine
// that stops the program between the two looks the workers are added in
// adds one, leaves nothing marked, and the case then passes without the
// path it is for, but never waits for a second.

import std.console
import std.diagnostics
import std.process
import std.sync
import std.time

/// Computes until `stop` is set, without waiting, once it has said it began.
fn compute(began: sync.Atomic[Int], stop: sync.Atomic[Bool]): Int {
    began.add(1)
    var turns = 0
    for not stop.load() {
        turns += 1
    }
    turns
}

fn counted(name: String): Int {
    diagnostics.metrics().find((each) { each.name == name }).map((each) { each.value }) ?? -1
}

fn ran(): Int ! String {
    let output = process.command("true").output().mapErr((e) { "{e}" })?
    output.text().mapErr((e) { "{e}" })?.length()
}

fn main(): !String {
    let began = sync.Atomic(0)
    let stop = sync.Atomic(false)
    let first = spawn compute(began, stop)
    let second = spawn compute(began, stop)
    // `main` runs again only on a worker put beside the computations.
    for began.load() < 2 {
        time.sleep(time.milliseconds(1))
    }
    console.println("main ran beside the computations: {counted("workers.added") >= 1}")
    stop.store(true)
    _ = (first.wait(), second.wait())
    // The workers added retire once they look for a task again.
    for counted("workers.total") > 2 {
        time.sleep(time.milliseconds(1))
    }
    var runs = Group[Int ! String]()
    for _ in 0..40 {
        runs.add(spawn ran())
    }
    console.println("children that ended: {runs.waitOrCancel()?.length()}")
}

// expect-env: TONDO_WORKERS=2
// expect-env: TONDO_CACHE_DOMAINS=2
// expect-no-schedule: the explorer runs one worker and adds none, so a computation that does not ask holds it, by design
// expect-no-replay: a recorded run, too, runs its tasks on one worker that adds none
// expect-stdout: main ran beside the computations: true
// expect-stdout: children that ended: 40
