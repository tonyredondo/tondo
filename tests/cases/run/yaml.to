// YAML: a safe subset of YAML 1.2 read into any type and written back,
// anchors and aliases, several documents, text that only looks like other
// values, and errors with where they happened.
import std.console
import std.yaml

type Server = {
    host: String
    port: Int
    tls: Bool?
}

type Config = {
    name: String
    version: Float
    tags: Array[String]
    servers: Array[Server]
    started: String
    note: String?
}

fn report[T](result: T ! yaml.YamlError) {
    match result {
        ok(_) => console.println("ok")
        err(error) => console.println("{error.kind}: {error}")
    }
}

fn main(): !yaml.YamlError {
    edges()?
    let text = """
        name: app
        version: 1.5
        tags: [a, "b"]
        started: 2026-10-23
        defaults: &defaults
          host: localhost
          port: 8080
        servers:
          - *defaults
          - host: example.com
            port: 443
            tls: true
        """
    let config = yaml.decode[Config](text)?
    console.println(
        "{config.name} {config.servers.length()} {config.servers[0].port} {config.servers[1].tls} {config.started}",
    )
    console.println(yaml.encode(config))
    let document = yaml.parse(text)?
    console.println("{document.find("defaults.port")} {document.get("missing")}")
    console.println(yaml.encodeAll([1, 2]))
    console.println("{yaml.decodeAll[Int]("1\n---\n2\n")?}")
    report(yaml.parse("a: [1, 2\n"))
    report(yaml.decode[Config]("name: 1\nversion: x\n"))
    report(yaml.parse("a: !custom 1\n"))
    report(yaml.parse("a: 1\na: 2\n"))
    report(yaml.parse("a: .inf\n"))
    report(yaml.parse("1\n---\n2\n"))
    report(yaml.parse("a: &x [*x]\n"))
    report(
        yaml
            .parse("a: yes\nb: True\nc: ~\nd: 0x1F\ne: 1e3\nf: '12'\n")
            .map((v) { console.println("{v}") }),
    )
}

type Note = {
    title: String
    body: String
    quote: String
    empty: String
    emoji: String
}

fn edges(): !yaml.YamlError {
    let note = Note {
        title: "key: value"
        body: "line one\nline two\n"
        quote: "say \"hi\""
        empty: ""
        emoji: "café ☕"
    }
    let text = yaml.encode(note)
    console.print(text)
    console.println("{yaml.decode[Note](text)? == note}")
}

