// An index of a tensor out of its axis panics with P0001, as one of an
// array does; a negative one counts from the end.

import std.console
import std.math

fn main() {
    let a = math.Tensor.fromRows([[1, 2, 3], [4, 5, 6]])
    console.println("{a.at(-1, -1)}")
    console.println("{a.at(1, 3)}")
}

// expect-stdout: 6
// expect-panic: P0001
// expect-stderr: panic[P0001]: bounds: index 3 is out of axis 1, of size 3
