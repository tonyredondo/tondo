// expect-stdout: {"jsonrpc":"2.0","id":8,"result":{"content":[{"type":"text","text":"`broken` panicked: out of order"}],"isError":true}}
// expect-stdout: {"jsonrpc":"2.0","id":9,"result":{"resources":[{"uri":"weather://guide","name":"guide","description":"How to use the service.","mimeType":"text/markdown"}]}}
// expect-stdout: {"jsonrpc":"2.0","id":10,"result":{"resourceTemplates":[{"uriTemplate":"weather://cities/{name}","name":"city","description":"A city's page.","mimeType":"text/plain"}]}}
// expect-stdout: {"jsonrpc":"2.0","id":11,"result":{"contents":[{"uri":"weather://cities/Lima","mimeType":"text/plain","text":"City Lima"}]}}
// expect-stdout: {"jsonrpc":"2.0","id":12,"result":{"description":"Asks for a forecast.","messages":[{"role":"user","content":{"type":"text","text":"What is the weather in Oslo? "}}]}}
// expect-stdout: {"jsonrpc":"2.0","id":13,"result":{"supportedVersions":["2026-07-28","2025-11-25","2025-06-18","2025-03-26","2024-11-05"],"capabilities":{"tools":{},"resources":{},"prompts":{}},"_meta":{"io.modelcontextprotocol/serverInfo":{"name":"weather","version":"0.1.0"}},"instructions":"Looks up the weather.","resultType":"complete","ttlMs":3600000,"cacheScope":"public"}}
// expect-stdout: {"jsonrpc":"2.0","id":14,"error":{"code":-32601,"message":"`nope` is not a method of this server"}}
// expect-stdout: {"jsonrpc":"2.0","id":15,"error":{"code":-32022,"message":"Unsupported protocol version 1999-01-01: this server speaks 2026-07-28 and 2025-11-25, 2025-06-18, 2025-03-26, 2024-11-05"}}
