// expect-stdout: {"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"forecast","description":"The forecast of a city for the next days.","inputSchema":{"type":"object","properties":{"city":{"description":"The city, as `Madrid`.","type":"string"},"days":{"description":"How many days, from 1 to 7.","type":"integer"},"units":{"type":"string","enum":["Metric","Imperial"]}},"required":["city"]},"outputSchema":{"type":"object","properties":{"city":{"type":"string"},"days":{"type":"array","items":{"type":"object","properties":{"day":{"type":"integer"},"high":{"type":"number"}},"required":["day","high"]}}},"required":["city","days"]}},{"name":"add","description":"Adds two numbers.","inputSchema":{"type":"object","properties":{"a":{"type":"integer"},"b":{"type":"integer"}},"required":["a","b"]},"outputSchema":{"type":"object","properties":{"result":{"type":"integer"}},"required":["result"]}},{"name":"greet","description":"Says hello.","inputSchema":{"type":"object","properties":{"name":{"type":"string"}},"required":["name"]}},{"name":"broken","description":"Breaks.","inputSchema":{"type":"object","properties":{},"required":[]},"outputSchema":{"type":"object","properties":{"result":{"type":"integer"}},"required":["result"]}}]}}
// expect-stdout: {"jsonrpc":"2.0","id":3,"result":{"content":[{"type":"text","text":"{\"city\":\"Madrid\",\"days\":[{\"day\":0,\"high\":20.0},{\"day\":1,\"high\":21.0}]}"}],"structuredContent":{"city":"Madrid","days":[{"day":0,"high":20.0},{"day":1,"high":21.0}]},"isError":false}}
// expect-stdout: {"jsonrpc":"2.0","id":4,"result":{"content":[{"type":"text","text":"no forecast for Atlantis"}],"isError":true}}
// expect-stdout: {"jsonrpc":"2.0","id":5,"result":{"content":[{"type":"text","text":"5"}],"structuredContent":{"result":5},"isError":false}}
// expect-stdout: {"jsonrpc":"2.0","id":6,"result":{"content":[{"type":"text","text":"Hello, Ada!"}],"isError":false}}
