// A regex's matches, with no groups, with a group that takes no part, and
// with more groups than eight: each match and its captures, and an empty
// match only where the one before did not end, also between the bytes of a
// character of several (standard library 14.19).
import std.console
import std.regex

fn shown(pattern: String, input: String): String ! regex.RegexError {
    let r = regex.Regex.compile(pattern)?
    var all: Array[String] = []
    for found in r.findAll(input)? {
        let m = found?
        var groups: Array[String] = []
        for index in 1..r.captureCount() + 1 {
            groups.push(m.capture(index).map(c => c.text) ?? "-")
        }
        all.push("{m.text}[{groups.join(",")}]")
    }
    all.join(" ")
}

fn main(): !regex.RegexError {
    console.println(shown("a*", "baaac")?)
    console.println(shown("é|", "aéb")?)
    console.println(shown("(a)(b)?", "ab a")?)
    console.println(shown("(1)(2)(3)(4)(5)(6)(7)(8)(9)?", "12345678 123456789")?)
}

// expect-stdout: [] aaa[] []
// expect-stdout: [] é[] []
// expect-stdout: ab[a,b] a[a,-]
// expect-stdout: 12345678[1,2,3,4,5,6,7,8,-] 123456789[1,2,3,4,5,6,7,8,9]
