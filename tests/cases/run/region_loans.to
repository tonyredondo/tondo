import std.console

fn scale(values: mut Array[Float], factor: Float) {
    values *= factor
}

fn bump(values: mut Array[Int]) {
    for i in 0..values.length() {
        values[i] += 100
    }
}

fn swapEnds(left: mut Array[Int], right: mut Array[Int]) {
    let first = left[0]
    left[0] = right[0]
    right[0] = first
}

fn total(values: ref Array[Int]): Int {
    var sum = 0
    for value in values {
        sum += value
    }
    sum
}

fn twice(values: mut Array[Int]) {
    bump(mut values[::2])
}

fn scaleBy(factor: Int, values: mut Array[Int]) {
    values *= factor
}

fn count[T: ~Copy + Discard](values: ref Array[T]): Int {
    values.length()
}

fn next(counter: var Int): Int {
    counter += 1
    counter
}

fn main() {
    var numbers = [1.0, 2.0, 3.0, 4.0]
    let before = numbers
    scale(mut numbers[1:3], 10.0)
    console.println("{numbers} {before}")
    var ints = [1, 2, 3, 4, 5, 6]
    bump(mut ints[::-2])
    console.println("{ints}")
    swapEnds(mut ints[:3], mut ints[3:])
    console.println("{ints} {total(ref ints[1:4])}")
    var grid = [[1, 2], [3, 4, 5]]
    bump(mut grid[1][1:])
    twice(mut grid[0])
    console.println("{grid}")
    var i = 0
    bump(mut ints[i:i + 2])
    console.println("{ints}")
    var calls = 0
    scaleBy(values: mut ints[next(var calls):next(var calls) + 1], factor: next(var calls) * 10)
    console.println("{ints} {calls} {count(ref ["a", "b", "c"][1:])}")
}

// expect-stdout: [1.0, 20.0, 30.0, 4.0] [1.0, 2.0, 3.0, 4.0]
// expect-stdout: [1, 102, 3, 104, 5, 106]
// expect-stdout: [104, 102, 3, 1, 5, 106] 106
// expect-stdout: [[101, 2], [3, 104, 105]]
// expect-stdout: [204, 202, 3, 1, 5, 106]
// expect-stdout: [204, 6060, 90, 1, 5, 106] 3 2
