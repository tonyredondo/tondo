fn pair(_left: mut Array[Int], _right: mut Array[Int]) {}

fn one(_values: mut Array[Int], _value: mut Int) {}

fn main() {
    var ints = [1, 2, 3, 4]
    pair(mut ints[:2], mut ints[2:])
    pair(mut ints[::2], mut ints[1::2])
    one(mut ints[:2], mut ints[-1])
    // Known only when the call runs: bounds of constants that overlap are
    // `E1403` (errors/overlapping_regions.to).
    let from = ints.length() - 3
    pair(mut ints[:2], mut ints[from:])
}

// expect-panic: P0004
// expect-stderr: panic[P0004]: overlapping-borrow: one call lends two slices of an array that share the element at index 1
