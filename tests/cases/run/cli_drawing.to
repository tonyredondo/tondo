// What std.cli draws is text: panels, rules, texts side by side, trees,
// bars, a breakdown, tables with a title and a border, a month and JSON,
// which nest, as a table in a panel. Widths count the columns a character takes, two for
// `漢`, and what is `@secret` shows as `<secret>`. Off a terminal, as here,
// the width is 80 and a breakdown's parts have shades, not colors.

import std.cli
import std.console
import std.time

@secret
type Key = String

type Limits = {
    memory: Int
    cpus: Int
}

type Service = {
    name: String
    hosts: Array[String]
    limits: Limits
    @secret
    pin: Int
    key: Key
}

type Account = {
    user: String
    @secret
    password: String
}

enum Mode {
    Fast
    Slow { delay: Int }
}

fn main() {
    console.println(cli.panel("3 tests passed\n1 failed", title: "Results"))
    console.println(cli.panel("a line longer than its box", title: "Clipped", width: 16))
    console.println(cli.panel("ready", border: cli.Border.Double, padding: 2))
    console.println(cli.rule("Details", width: 24))
    console.println(cli.rule(width: 12))
    let up = cli.panel("api\ndb", title: "Up")
    let down = cli.panel("cache", title: "Down")
    console.println(cli.beside([up, down]))
    console.println(cli.beside([up, down, up], width: 20))
    let service = Service {
        name: "web"
        hosts: ["a", "b"]
        limits: Limits { memory: 512, cpus: 2 }
        pin: 1234
        key: Key("k3y")
    }
    console.println(cli.tree(service))
    console.println(cli.tree(Mode.Slow { delay: 3 }))
    console.println(cli.tree(Key("top")))
    console.println(cli.bars([("tea", 12.0), ("coffee", 30.0), ("漢字", 7.5)], width: 30))
    console.println(cli.breakdown([("used", 61.0), ("free", 39.0)], width: 20))
    let rows = [["a", "1"], ["bb", "22\n333"]]
    console.print(
        cli.table(rows, columns: ["Name", "N"], title: "Orders", border: cli.Border.Rounded),
    )
    console.print(cli.table(rows, columns: ["Name", "N"], border: cli.Border.None))
    console.print(cli.table([["漢字", "1"]], border: cli.Border.Ascii))
    console.print(
        cli.table([Account { user: "ada", password: "hunter2" }], border: cli.Border.Heavy),
    )
    console.println(cli.panel(cli.table([["x", "1"]]), title: "Nested"))
    // A month, its marked days in brackets off a terminal, the week from
    // Sunday in Spanish too; and any value as JSON, its secrets hidden.
    let release = time.DateTime {
        year: 2026
        month: 11
        day: 14
        hour: 0
        minute: 0
        second: 0
        nanosecond: 0
    }
    console.println(cli.calendar(2026, 11, marked: [release]))
    console.println(cli.calendar(2026, 2, first: time.Weekday.Sunday, locale: "es"))
    console.println(cli.json(service))
    console.println(cli.json([Mode.Fast, Mode.Slow { delay: 1 }], indent: 0))
}

