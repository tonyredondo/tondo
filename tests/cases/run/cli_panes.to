// A screen of panes is text of exactly the size asked for: a fixed row
// above and below, and two panes side by side that share what is left by
// ratio. A log longer than its pane shows its last lines with `follow`,
// or from a line, with a mark on the border where it is; `rooms` gives a
// named pane's room. And FIGlet's big letters, as FIGlet writes them.

import std.cli
import std.console

fn main() {
    let log = (1..=30).map((n) { "line {n}" }).collect().join("\n")
    let screen = cli.Pane.rows(
        [
            cli.Pane("Orders today", size: 1),
            cli.Pane.columns(
                [
                    cli.Pane("#1 tea\n#2 coffee", title: "Orders", border: cli.Border.Rounded),
                    cli.Pane(
                        log,
                        title: "Log",
                        ratio: 2,
                        border: cli.Border.Square,
                        follow: true,
                        name: "log",
                    ),
                ],
            ),
            cli.Pane("q: quit", size: 1),
        ],
    )
    let size = cli.Size { columns: 40, rows: 10 }
    let drawn = screen.draw(size)
    // Each row up to a mark, as its last columns are spaces.
    for row in drawn.lines() {
        console.println("{row}|")
    }
    console.println(
        "{drawn.lines().length()} rows of {drawn.lines().map((line) { line.length() }).max() ?? 0}",
    )
    console.println("{screen.rooms(size)}")
    console.println(
        cli
            .Pane(log, from: 3, title: "From 3", border: cli.Border.Ascii)
            .draw(cli.Size { columns: 20, rows: 6 }),
    )
    console.println(cli.figlet("Tondo"))
    console.println(cli.figlet("Hi all", width: 12))
}

