// expect-stdout: lost: `done` is out of reach from here
// expect-stdout:   start: Waiter { at: 0, flag: false }
// expect-stdout:   check: Waiter { at: 1, flag: false }
// expect-stdout: held: 7 states
// expect-stdout: unfair: `gone` does not hold
// expect-stdout:   start: 0
// expect-stdout:   and then round for ever:
// expect-stdout:   spin: 0
// expect-stdout: fair: 2 states
// expect-stdout: two ways: `there` does not hold
// expect-stdout:   start: 0
// expect-stdout:   left: 1
// expect-stdout:   and then round for ever:
// expect-stdout:   wait: 2
// expect-stdout:   back: 1
// expect-stdout: strong: 4 states
// expect-stdout: stops: `ended` does not hold
// expect-stdout:   start: 0
// expect-stdout:   stop: 1
// expect-stdout:   and then round for ever:
// expect-stdout:   (stays): 1
import std.console
import std.model

type Waiter = {
    at: Int
    flag: Bool
}

fn wait(waiter: Waiter, lost: Bool): Array[model.Step[Waiter]] {
    var next: Array[model.Step[Waiter]] = []
    if waiter.at == 0 {
        next.push(model.Step { name: "check", state: waiter with { at: if waiter.flag { 3 } else { 1 } } })
    }
    if waiter.at == 1 {
        next.push(model.Step { name: "sleep", state: waiter with { at: 2 } })
    }
    if not waiter.flag {
        let woken = waiter.at == 2 and not lost
        next.push(model.Step { name: "wake", state: waiter with { flag: true, at: if woken { 3 } else { waiter.at } } })
    }
    if waiter.at == 2 and waiter.flag and not lost {
        next.push(model.Step { name: "wakes", state: waiter with { at: 3 } })
    }
    next
}

fn spins(count: Int): Array[model.Step[Int]] {
    match count {
        0 => [model.Step { name: "spin", state: 0 }, model.Step { name: "go", state: 1 }]
        _ => []
    }
}

fn turns(at: Int): Array[model.Step[Int]] {
    match at {
        0 => [model.Step { name: "left", state: 1 }, model.Step { name: "right", state: 3 }]
        1 => [model.Step { name: "wait", state: 2 }, model.Step { name: "go", state: 3 }]
        2 => [model.Step { name: "back", state: 1 }]
        _ => []
    }
}

fn stops(at: Int): Array[model.Step[Int]] {
    match at {
        0 => [model.Step { name: "stop", state: 1 }, model.Step { name: "done", state: 2 }]
        _ => []
    }
}

fn say(name: String, result: model.Checked ! model.Violation) {
    match result {
        ok(checked) => console.println("{name}: {checked.states} states")
        err(broken) => console.println("{name}: {broken}")
    }
}

fn main() {
    let start = Waiter { at: 0, flag: false }
    let done = model.reachable((waiter: Waiter) { waiter.at == 3 }, name: "done")
    say("lost", model.check(start, (waiter) { wait(waiter, true) }, holds: [done]))
    say("held", model.check(start, (waiter) { wait(waiter, false) }, holds: [done]))
    let gone = model.eventually((count: Int) { count == 1 }, name: "gone")
    say("unfair", model.check(0, spins, holds: [gone]))
    say("fair", model.check(0, spins, holds: [gone], fair: [model.weak("go")]))
    // `go` is not possible all the way round, so the loop is fair without it,
    // unless it is fair in the strong sense.
    let there = model.eventually((at: Int) { at == 3 }, name: "there")
    say("two ways", model.check(0, turns, holds: [there], fair: [model.weak("go")]))
    say("strong", model.check(0, turns, holds: [there], fair: [model.strong("go")]))
    let ended = model.eventually((at: Int) { at == 2 }, name: "ended")
    say("stops", model.check(0, stops, holds: [ended]))
}
