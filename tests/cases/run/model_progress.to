// What must happen, in `std.model`: a wake that comes before the sleep is lost,
// which `reaches` finds; and a task that can spin for ever need not go on, unless
// the step that goes on is fair.
//
// expect-stdout: lost: what it must reach is out of reach from here, after: check
// expect-stdout: held: 7 states
// expect-stdout: unfair: it need not come to what it must, and round for ever: spin
// expect-stdout: fair: 2 states
// expect-stdout: two ways: it need not come to what it must, after: left, and round for ever: wait, back
// expect-stdout: stops: it ends without what it must come to, after: stop
import std.console
import std.model

type Waiter = {
    at: Int
    flag: Bool
}

fn wait(waiter: Waiter, lost: Bool): Array[model.Step[Waiter]] {
    var next: Array[model.Step[Waiter]] = []
    if waiter.at == 0 {
        next.push(model.Step { name: "check", state: waiter with { at: if waiter.flag { 3 } else { 1 } } })
    }
    if waiter.at == 1 {
        next.push(model.Step { name: "sleep", state: waiter with { at: 2 } })
    }
    if not waiter.flag {
        let woken = waiter.at == 2 and not lost
        next.push(model.Step { name: "wake", state: waiter with { flag: true, at: if woken { 3 } else { waiter.at } } })
    }
    if waiter.at == 2 and waiter.flag and not lost {
        next.push(model.Step { name: "wakes", state: waiter with { at: 3 } })
    }
    next
}

fn spins(count: Int): Array[model.Step[Int]] {
    match count {
        0 => [model.Step { name: "spin", state: 0 }, model.Step { name: "go", state: 1 }]
        _ => []
    }
}

fn turns(at: Int): Array[model.Step[Int]] {
    match at {
        0 => [model.Step { name: "left", state: 1 }, model.Step { name: "right", state: 3 }]
        1 => [model.Step { name: "wait", state: 2 }, model.Step { name: "go", state: 3 }]
        2 => [model.Step { name: "back", state: 1 }]
        _ => []
    }
}

fn stops(at: Int): Array[model.Step[Int]] {
    match at {
        0 => [model.Step { name: "stop", state: 1 }, model.Step { name: "done", state: 2 }]
        _ => []
    }
}

fn say(name: String, result: model.Checked ! model.Violation) {
    match result {
        ok(checked) => console.println("{name}: {checked.states} states")
        err(broken) => console.println("{name}: {broken}")
    }
}

fn main() {
    let start = Waiter { at: 0, flag: false }
    let done = (waiter: Waiter) { waiter.at == 3 }
    let always = (_: Waiter) { true }
    say("lost", model.check(start, (waiter) { wait(waiter, true) }, always, reaches: some(done)))
    say("held", model.check(start, (waiter) { wait(waiter, false) }, always, reaches: some(done)))
    let gone = (count: Int) { count == 1 }
    let holds = (_: Int) { true }
    say("unfair", model.check(0, spins, holds, eventually: some(gone)))
    say("fair", model.check(0, spins, holds, eventually: some(gone), fair: ["go"]))
    // `go` is not possible all the way round, so the loop is fair without it.
    let there = (at: Int) { at == 3 }
    say("two ways", model.check(0, turns, holds, eventually: some(there), fair: ["go"]))
    let ended = (at: Int) { at == 2 }
    say("stops", model.check(0, stops, holds, eventually: some(ended)))
}
