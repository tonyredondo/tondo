import std.console

enum Color {
    Red
    Green
    Blue
}

enum Shape {
    Circle(Int)
    Rect(Int, Int)
    Labeled { name: String, sides: Int }
    Point
}

enum Tree {
    Leaf
    Node(Tree, Int, Tree)
}

fn area(s: Shape): Int {
    match s {
        Shape.Circle(r) => 3 * r * r
        Shape.Rect(w, h) => w * h
        Shape.Labeled { sides, .. } if sides > 10 => -1
        Shape.Labeled { name: _, sides } => sides
        Shape.Point => 0
    }
}

fn describe(c: Color): String {
    match c {
        Color.Red => "red"
        Color.Green => "green"
        Color.Blue => "blue"
    }
}

fn insert(t: Tree, value: Int): Tree {
    match t {
        Tree.Leaf => Tree.Node(Tree.Leaf, value, Tree.Leaf)
        Tree.Node(left, v, right) => {
            if value < v {
                Tree.Node(insert(left, value), v, right)
            } else {
                Tree.Node(left, v, insert(right, value))
            }
        }
    }
}

fn sum(t: Tree): Int {
    match t {
        Tree.Leaf => 0
        Tree.Node(left, v, right) => sum(left) + v + sum(right)
    }
}

fn depth(t: Tree): Int {
    match t {
        Tree.Leaf => 0
        Tree.Node(l, _, r) => {
            let a = depth(l)
            let b = depth(r)
            1 + (if a > b { a } else { b })
        }
    }
}

fn main() {
    let shapes = (Shape.Circle(2), Shape.Rect(3, 4), Shape.Labeled { name: "tri", sides: 3 }, Shape.Point)
    console.println("{area(shapes.0)} {area(shapes.1)} {area(shapes.2)} {area(shapes.3)}")
    console.println("{area(Shape.Labeled { name: "many", sides: 20 })}")
    console.println("{describe(Color.Red)} {describe(Color.Blue)} {Color.Red == Color.Red} {Color.Red == Color.Green}")
    var t = Tree.Leaf
    for x in 0..200 {
        t = insert(t, (x * 37) % 101)
    }
    let copy = t
    t = insert(t, 1000)
    console.println("{sum(t)} {sum(copy)} {depth(copy)} {t == copy} {copy == copy}")
    let (a, b) = (1, "dos")
    console.println("{a} {b}")
}

// expect-stdout: 12 12 3 0
// expect-stdout: -1
// expect-stdout: red blue true false
// expect-stdout: 11009 10009 12 false true
// expect-stdout: 1 dos
