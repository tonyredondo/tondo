fn one(values: mut Array[Int], value: mut Int) {}

fn main() {
    var ints = [1, 2, 3, 4]
    one(mut ints[:2], mut ints[2])
    one(mut ints[::-1], mut ints[-3])
}

// expect-panic: P0004
// expect-stderr: panic[P0004]: overlapping-borrow: one call lends the element at index 1 of an array twice: alone and inside a slice
