// C structs: by value in registers, with floats and in place arrays;
// by pointer; packed and aligned; opaque (FFI).
import std.console
import std.ffi

extern type Division = {
    quotient: ffi.CInt
    remainder: ffi.CInt
}

extern type LongDivision = {
    quotient: ffi.CLong
    remainder: ffi.CLong
}

extern type Complex = {
    real: Float
    imaginary: Float
}

extern type Time = {
    second: ffi.CInt
    minute: ffi.CInt
    hour: ffi.CInt
    day: ffi.CInt
    month: ffi.CInt
    year: ffi.CInt
    weekday: ffi.CInt
    yearday: ffi.CInt
    daylight: ffi.CInt
    offset: ffi.CLong
    zone: ffi.CString?
}

extern type Label = {
    @count(13)
    text: ffi.CChar
    size: ffi.CInt
    @count(3)
    weights: Float32
}

@packed
extern type Packed = {
    tag: ffi.CChar
    value: ffi.CInt
}

@align(16)
extern type Aligned = {
    value: ffi.CInt
}

extern type File

extern fn div(numerator: ffi.CInt, denominator: ffi.CInt): Division

extern fn ldiv(numerator: ffi.CLong, denominator: ffi.CLong): LongDivision

extern fn csqrt(value: Complex): Complex

extern fn gmtime_r(time: Pointer[ffi.CLong], into: Pointer[Time]): Pointer[Time]?

extern fn snprintf(buffer: Pointer[ffi.CChar], size: ffi.CSize, format: ffi.CString, ...): ffi.CInt

extern fn fopen(path: ffi.CString, mode: ffi.CString): Pointer[File]?

fn main() {
    console.println(
        "{ffi.sizeOf[Time]()} {ffi.sizeOf[Label]()} {ffi.sizeOf[Packed]()} {ffi.sizeOf[Aligned]()} {ffi.alignOf[Aligned]()}",
    )
    unsafe {
        let d = div(17, 5)
        let l = ldiv(-100000000000, 7)
        let root = csqrt(Complex { real: -4.0, imaginary: 0.0 })
        console.println(
            "{d.quotient} {d.remainder} {l.quotient} {l.remainder} {root.real} {root.imaginary}",
        )
        let seconds = ffi.allocate[ffi.CLong]()
        seconds.write(86400 * 365 + 3600 * 5)
        let time = ffi.allocate[Time]()
        match gmtime_r(seconds, time) {
            some(t) => {
                let value = t.read()
                console.println(
                    "{value.year + 1900}-{value.month + 1}-{value.day} {value.hour}h {value.weekday}",
                )
            }
            none => console.println("no time")
        }
        // C writes the struct's first array.
        let label = ffi.allocate[Label]()
        let written = snprintf(label.cast[ffi.CChar](), 13u64, "%s", "Linux")
        var copy = label.read()
        console.println("{written} {ffi.fromCChars(copy.text)} {copy.text[0]}")
        copy.text[0] = Byte(108u8)
        copy.weights[2] = 2.5
        let chars: Array[ffi.CChar] = copy.text
        console.println("{ffi.fromCChars(chars)} {chars.length()} {copy.weights[2]}")
        copy.text = ffi.toCChars("tondo", 13)
        console.println("{ffi.fromCChars(copy.text)}")
        let packed = ffi.allocate[Packed]()
        packed.write(Packed { tag: Byte(1u8), value: 258 })
        console.println("{ffi.bytes(packed.cast[Byte](), 5)}")
        match fopen("/surely/missing/file", "r") {
            some(_) => console.println("opened")
            none => console.println("no file")
        }
        ffi.free(seconds)
        ffi.free(time)
        ffi.free(label)
        ffi.free(packed)
    }
}

// expect-stdout: 56 32 5 16 16
// expect-stdout: 3 2 -14285714285 -5 0.0 2.0
// expect-stdout: 1971-1-1 5h 5
// expect-stdout: 5 Linux 76
// expect-stdout: linux 13 2.5
// expect-stdout: tondo
// expect-stdout: [1, 2, 1, 0, 0]
// expect-stdout: no file
