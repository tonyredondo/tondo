// What a loop's counter proves of the locals it only adds to: a sum that
// stays within an `Int` loses its check, and one that could leave it keeps
// it and panics where it overflows, as it did, also when a loop inside
// adds to it, when a way skips or leaves the loop, or when the counter
// goes back on some way. A counted loop whose bounds are within 2³¹ of zero
// runs a copy that `prove` checks before it; others run the one with every
// check, with the same results.

import std.console

fn squares(count: Int): Int {
    var total = 0
    for i in 0..1000 {
        total += i * i % 7
        if i == count {
            break
        }
    }
    total
}

fn alternating(): Int {
    var total = 0
    for i in 0..1000 {
        if i % 3 == 0 {
            continue
        }
        total -= i % 5
        total += 2
    }
    total
}

// Two forward and one back on every other turn: one step at least.
fn wandering(): Int {
    var (i, total) = (0, 0)
    for i < 300 {
        total += i % 4
        i += 2
        if i % 4 == 0 {
            i -= 1
        }
    }
    total
}

fn huge(turns: Int): Int {
    var total = 0
    for _ in 0..100 {
        total += 100_000_000_000_000_000
        if total < 0 or turns == 0 {
            break
        }
    }
    total
}

fn nested(): Int {
    var total = 0
    for _ in 0..10 {
        for _ in 0..10 {
            total += 100_000_000_000_000_000
        }
    }
    total
}

// Two loops one after the other inside it: the sum's two additions a turn
// are counted on the way through both.
fn siblings(): Int {
    var (total, inner) = (0, 0)
    for _ in 0..50 {
        total += 100_000_000_000_000_000
        for j in 0..3 {
            inner += j
        }
        for j in 0..2 {
            inner -= j
        }
        total += 100_000_000_000_000_000
    }
    total + inner
}

fn squared(from: Int, to: Int, stop: Int): Int {
    var total = 0
    for i in from..to {
        total += i * i
        if i == stop {
            break
        }
    }
    total
}

fn cubes(count: Int): Int {
    var total = 0
    for i in 0..count {
        total += i * i * i
    }
    total
}

fn main() {
    console.println("{squares(2000)} {squares(10)}")
    console.println("{alternating()}")
    console.println("{wandering()}")
    console.println("{huge(0)}")
    match recover { huge(1) } {
        ok(total) => console.println("{total}")
        err(caught) => console.println("caught {caught.message}")
    }
    match recover { nested() } {
        ok(total) => console.println("{total}")
        err(caught) => console.println("caught {caught.message}")
    }
    console.println(
        "{squared(-5, 100, 10)} {squared(-5, 5_000_000_000, 10)} {squared(-3_000_000_000, 0, -3_000_000_000)}",
    )
    console.println("{cubes(1000)}")
    match recover { cubes(3_000_000) } {
        ok(total) => console.println("{total}")
        err(caught) => console.println("caught {caught.message}")
    }
    match recover { siblings() } {
        ok(total) => console.println("{total}")
        err(caught) => console.println("caught {caught.message}")
    }
}

// expect-stdout: 2001 21
// expect-stdout: 0
// expect-stdout: 301
// expect-stdout: 100000000000000000
// expect-stdout: caught 9200000000000000000 + 100000000000000000 does not fit in Int (-9223372036854775808 to 9223372036854775807)
// expect-stdout: caught 9200000000000000000 + 100000000000000000 does not fit in Int (-9223372036854775808 to 9223372036854775807)
// expect-stdout: 440 440 9000000000000000000
// expect-stdout: 249500250000
// expect-stdout: caught 9223193340756366400 + 473384830201856 does not fit in Int (-9223372036854775808 to 9223372036854775807)
// expect-stdout: caught 9200000000000000000 + 100000000000000000 does not fit in Int (-9223372036854775808 to 9223372036854775807)
