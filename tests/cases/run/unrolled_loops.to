import std.console
import std.math

// Short counted loops run four turns at a time while four remain, over a
// range or over an array's elements: every count of turns, `continue`,
// `break`, a `return` from inside, bounds at the ends of `Int`, a closure
// made in each turn and a square root, which calls no function, all mean
// what they mean in a loop that runs one turn at a time.

fn sum(from: Int, to: Int): Int {
    var total = 0
    for i in from..to {
        total += i
    }
    total
}

fn turns(from: Int, to: Int): (Int, Int) {
    var count = 0
    var last = 0
    for i in from..to {
        count += 1
        last = i
    }
    (count, last)
}

fn firstOver(xs: Array[Int], limit: Int): Int {
    for i in 0..xs.length() {
        if xs[i] > limit {
            return i
        }
    }
    return -1
}

fn evens(xs: Array[Int]): (Int, Int) {
    var count = 0
    var total = 0
    for x in xs {
        if x % 2 != 0 {
            continue
        }
        count += 1
        total += x
    }
    (count, total)
}

fn counted(xs: Array[Int]): (Int, Int) {
    var count = 0
    var last = -1
    for x in xs {
        count += 1
        last = x
    }
    (count, last)
}

fn roots(n: Int): Float {
    var total = 0.0
    for i in 0..n {
        total += math.sqrt(Float(i - 2)).unwrapOr(-1.0)
    }
    total
}

fn main() {
    var counts: Array[Int] = []
    for n in 0..9 {
        counts.push(sum(0, n))
    }
    console.println("{counts}")
    var odd = 0
    for i in 0..10 {
        if i % 2 == 0 {
            continue
        }
        if i > 7 {
            break
        }
        odd += i
    }
    console.println("{odd} {firstOver([1, 5, 9, 2, 8], 7)} {firstOver([1], 7)}")
    let max = 9223372036854775807
    let min = -9223372036854775807 - 1
    console.println("{turns(max - 5, max)} {turns(min, min + 3)} {turns(min, min + 7)}")
    var made: Array[fn(): Int] = []
    for i in 0..6 {
        made.push(() { i * 10 })
    }
    console.println("{made.map((f) { f() })}")
    var seen: Array[(Int, Int)] = []
    for n in 0..10 {
        var xs: Array[Int] = []
        for i in 0..n {
            xs.push(i * 3)
        }
        seen.push(evens(xs))
        seen.push(counted(xs))
    }
    console.println("{seen}")
    console.println("{roots(0)} {roots(2)} {roots(6)} {roots(11)}")
}

// expect-stdout: [0, 0, 1, 3, 6, 10, 15, 21, 28]
// expect-stdout: 16 2 -1
// expect-stdout: (5, 9223372036854775806) (3, -9223372036854775806) (7, -9223372036854775802)
// expect-stdout: [0, 10, 20, 30, 40, 50]
// expect-stdout: [(0, 0), (0, -1), (1, 0), (1, 0), (1, 0), (2, 3), (2, 6), (3, 6), (2, 6), (4, 9), (3, 18), (5, 12), (3, 18), (6, 15), (4, 36), (7, 18), (4, 36), (8, 21), (5, 60), (9, 24)]
// expect-stdout: 0.0 -2.0 2.1462643699419726 14.306000526035719
// expect-optimization: 30:12 unchecked stays within its array
// expect-optimization: 82:9 unchecked in one copy of the code
// expect-optimization: 92:32 frame
// expect-optimization: 12:14 unrolled runs four turns at a time
// expect-optimization: 40:14 unrolled
// expect-optimization: 62:14 unrolled
// expect-optimization: 70:14 looped its body has
