// Memory C touches that it should not ends the program with the trace of
// the calls that reached C.
import std.ffi

extern fn strlen(text: Pointer[UInt8]?): ffi.CSize

fn measure(text: Pointer[UInt8]?): ffi.CSize {
    unsafe { strlen(text) }
}

fn main() {
    let job = spawn measure(none)
    job.wait()
}

// expect-crash
// expect-stderr: fatal: SIGSEGV: invalid memory access at 0x0, inside a function of C
// expect-stderr: stack:
// expect-stderr:   measure  fault_in_c.to:8:14
// expect-stderr: in a task spawned at:
// expect-stderr:   main  fault_in_c.to:12:15
