// `sync.RateLimiter` lets work happen at a steady rate, with bursts, and
// `sync.retry` tries work again, with a backoff, on the errors it is told.

import std.console
import std.sync
import std.time

enum Flaky {
    Busy
    Broken
}

fn main() {
    let limiter = sync.RateLimiter(5, per: time.seconds(1), burst: 2)
    console.println("{(0..5).filter((_) { limiter.allow() }).count()}")
    let started = time.now()
    limiter.wait()
    console.println("{started.elapsed().milliseconds() >= 150}")

    let calls = sync.Atomic(0)
    let busyTwice = (): String ! Flaky {
        if calls.add(1) < 3 {
            fail Flaky.Busy
        }
        "done"
    }
    console.println(
        "{sync.retry(busyTwice, attempts: 5, delay: time.milliseconds(1)).unwrapOr("gave up")} {calls.load()}",
    )
    calls.store(0)
    let broken = (): Int ! Flaky {
        _ = calls.add(1)
        fail Flaky.Broken
    }
    let busy = (error: ref Flaky): Bool { error == Flaky.Busy }
    console.println(
        "{sync.retry(broken, attempts: 4, delay: time.milliseconds(1), when: busy).isErr()} {calls.load()}",
    )
    calls.store(0)
    console.println(
        "{sync.retry(broken, attempts: 3, delay: time.milliseconds(1)).isErr()} {calls.load()}",
    )
    console.println(
        "{sync.retry(broken, attempts: 3, when: (error) { error == Flaky.Busy }).isErr()}",
    )
}

// expect-stdout: 2
// expect-stdout: true
// expect-stdout: done 3
// expect-stdout: true 1
// expect-stdout: true 3
// expect-stdout: true
