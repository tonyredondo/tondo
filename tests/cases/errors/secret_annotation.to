// `@secret` takes nothing, and what it hides is not written to logs.

@secret("all")
type Token = String

@secret
type Hidden = String

impl Display for Hidden {
    fn display(self): String {
        "hidden"
    }
}

type Account = {
    @secret("x") pin: Int
}

context Auth = {
    @log @secret session: String = ""
    @log token: Hidden = Hidden("")
}

fn main() {}

// expect-error: E1102 `@secret` takes nothing: write `@secret`
// expect-error: E1102 `@secret` takes nothing: write `@secret`
// expect-error: E1616 `@log` writes
// expect-error: E1616 `@log` writes
