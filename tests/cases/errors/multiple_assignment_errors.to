fn main() {
    var value = 0
    (value, value) = (1, 2)
    var point = (1, 2)
    (point, point.0) = ((3, 4), 5)
    var values = [1, 2]
    (values[0], values[0]) = (3, 4)
    (value, values[1]) += (1, 2)
    var other = 0
    (value, other) = 3
}

