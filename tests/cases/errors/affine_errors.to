type Pair[A, B] = { first: A, second: B }

fn keep[T: ~Copy](value: T): T {
    value
}

fn twice[T: ~Copy](value: T): (T, T) {
    let first = keep(value)
    (first, value)
}

fn dropped[T: ~Copy](value: T): Int {
    1
}

fn sometimes[T: ~Copy](value: T, flag: Bool, out: var Array[T]) {
    if flag {
        out.push(value)
    }
}

fn again[T: ~Copy](value: T, out: var Array[T]) {
    for _ in 0..2 {
        out.push(value)
    }
}

fn firstOf[A: ~Copy, B](pair: Pair[A, B]): A {
    pair.first
}

fn element[T: ~Copy](values: Array[T]): T {
    values[0]
}

fn replace[T: ~Copy](value: T, other: T): T {
    var current = value
    current = other
    current
}

fn ignore[T: ~Copy](value: T) {
    _ = value
}

fn wildcard[A, B: ~Copy](pair: (A, B)): A {
    let (first, _) = pair
    first
}

fn Pair[A: ~Copy, B].take(self): A {
    self.first
}

fn reset[T: ~Copy](values: var Array[T]) {
    values.clear()
}

fn each[T: ~Copy](values: Array[T]) {
    for value in values {}
}

fn borrowed[T: ~Copy](value: ref T): T {
    value
}

fn copies[T](value: T): T {
    value
}

fn forward[T: ~Copy](value: T): T {
    copies(value)
}

type Holder[T: ~Copy] = { value: T }

fn main() {}

// expect-error: E1401 `value` was moved before this use, since its type `T` is not `Copy`; use it before passing it on, or remove `~Copy` from its type parameter
// expect-error: E1409 `value` still holds its value when the function ends, and its type `T` may need to be consumed; pass it on or return it on every path, or add `Discard` to its type parameter
// expect-error: E1409 `value` still holds its value on some paths when the function ends
// expect-error: E1401 `value` was moved on some paths before this use
// expect-error: E1406 moving a part of type `A` out of `pair` would leave it incomplete; destructure the whole value with `let`, or remove `~Copy` from its type parameter
// expect-error: E1406 this copies a value of type `T` out of `values`, but it is not `Copy`; remove `~Copy` from its type parameter, or take values out with `pop()`, `removeAt()` or a `for` loop
// expect-error: E1408 assigning `current` here would drop the value it holds
// expect-error: E1409 `_ =` drops a value of type `T`
// expect-error: E1409 this pattern drops a part of type `B`
// expect-error: E1406 moving a part of type `A` out of `self`
// expect-error: E1409 `clear()` would drop the elements of `values`, and its type `Array[T]` may need to be consumed
// expect-error: E1409 `value` still holds its value when the iteration ends
// expect-error: E1406 `value` is a loan, so its value of type `T` cannot be moved out of it
