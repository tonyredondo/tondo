// The language's annotations go only where they belong; the program's
// have the capital of their type.

@name("shape")
enum Shape {
    @ignore
    Circle
    @name
    Square
}

fn show(@ignore value: Int) {}

fn main() {}

// expect-error: E1619 the language's annotation `@name` does not go on an enum
// expect-error: E1619 the language's annotation `@ignore` does not go on a variant
// expect-error: E1102 `@name` takes the name the variant has outside: `@name("in_progress")`
// expect-error: E1619 the language's annotation `@ignore` does not go on a parameter
