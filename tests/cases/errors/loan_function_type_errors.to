fn scale(values: mut Array[Float], factor: Float) {
    values *= factor
}

fn main() {
    var numbers = [1.0]
    let op: fn(mut Array[Float], Float) = scale
    op(numbers, 2.0)
    let plain: fn(Array[Float], Float) = scale
    let grow = (values: mut Array[Int]) { values.push(1) }
    let keep = (values: mut Array[Int]) {
        let inner = () { values.length() }
    }
    op(mut numbers, mut numbers[0])
}

