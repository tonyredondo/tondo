// Go as a porter writes it, each with what Tondo writes.
package main

type Account struct {
    total: Int
}

func (a Account) total() Int {
    return 1
}

fn f(): Int {
    return 1, none
}

fn work() {
}

fn main() {
    x := 5
    var y int = 3
    let items = [1]
    for _, a := range items {
    }
    go work()
    let m = ["a": 1]
    v, ok := m["a"]
    let n = map[string]int{}
