import std.console

pub type Job = { name: String }


fn main() {
    let jobs = [Job { name: "a" }]
    console.println("{jobs.sorted()}")
    console.println("{jobs.sum()}")
    console.println("{jobs.join(", ")}")
    console.println("{[1, 2].unique().first().expect()}")
    let span = 1.5..2.5
    let names: Range[String] = 0..1
    let count: Int = 0..3
}

