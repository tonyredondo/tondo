import std.json

type Handler = {
    name: String
    run: fn(): Int
}

type Settings = {
    @ignore
    secret: String
    @rename("x")
    other: Int
    @omitNone
    count: Int
}

fn main() {
    let text = json.encode(Handler { name: "a", run: (): Int { 1 } })
    let items: Array[Int] = json.decode("[1]")
}

// expect-error: E1105 `Handler` does not implement `serialization.Encode`, which `json.encode` requires of `T`
// expect-error: E1102 decoding leaves out an ignored field, so it has a default value or is optional: write `secret: String?`
// expect-error: E1001 unknown annotation `@rename`; a field takes `@name("text")`, `@ignore` or `@omitNone`
// expect-error: E1102 `@omitNone` leaves out a field that is `none`, and `count` is not optional: write `count: Int?`, or leave out `@omitNone`
// expect-error: E1102 expected `Array[Int]`, found `Array[Int] ! serialization.Error`: add `?` to pass the failure on, give a fallback with `.unwrapOr(value)`, or handle it with `match`
