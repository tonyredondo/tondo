trait Shape {
    fn area(self, scale: Int = 1): Int
}

fn two(): Int {
    2
}

fn a(x: Int = two()): Int {
    x
}

fn b(values: var Array[Int] = []) {
    values.push(1)
}

fn c(items: ...Int = [1]): Int {
    items.length()
}

fn d(x: Int = "one"): Int {
    x
}

fn e(first: Int, second: Int = 0): Int {
    first + second
}

fn main() {
    _ = e(second: 1)
}

