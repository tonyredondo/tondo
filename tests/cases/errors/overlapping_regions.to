// Two exclusive loans of regions of one array whose constant bounds share
// an element overlap whatever the array's length (16.4): a region that
// ends at a constant needs the array to reach it. Regions that end where
// the other starts are disjoint, and two that run to the end are told
// apart only when the call runs.

fn both(left: mut Array[Int], right: mut Array[Int]) {
    left[0] = right[0]
}

fn main() {
    var a = [1, 2, 3, 4, 5]
    both(mut a[:3], mut a[2:])
    both(mut a[1:3], mut a[2:4])
    both(mut a[:2], mut a[2:])
    both(mut a[1:], mut a[2:])
}

// expect-error: E1403 two exclusive loans of one call overlap
// expect-error: E1403 two exclusive loans of one call overlap
