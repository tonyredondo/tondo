import std.time

fn main() {
    let start = time.now()
    let a = start.elapsed() + 5
    let e = start.elapsed().add(time.seconds(1))
    let b = time.timestamp()
    let c = start.since(time.seconds(1))
    let d = time.ms(5)
}

