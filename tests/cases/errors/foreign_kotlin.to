// Kotlin as a porter writes it, each with what Tondo writes.
data class Line(val name: String)

suspend fn load() {
}

fn main() {
    val limit = 5
    let x: Int? = none
    let y = x ?: 0
    let shown = when (y) {
        1 -> "a"
        else -> "b"
    }
    let m = mapOf("a" to 1)
    let xs = [1]
    let doubled = xs.map { it * 2 }
}

