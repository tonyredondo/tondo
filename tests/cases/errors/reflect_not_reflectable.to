// A handle of the standard library without `Reflect` is not a
// `reflect.Value` by itself; in a field of a record of the program, which
// has `Reflect`, reflection carries it as it is.

import std.fs
import std.reflect

pub type Notes = {
    files: fs.FileSystem
}

fn main() {
    let files = fs.memory()
    let value = reflect.valueOf(files)
    let name: String ! reflect.ReflectError = reflect.call(files, "name", files)
    let notes = reflect.valueOf(Notes { files })
}

// expect-error: E1105 `fs.FileSystem` does not implement `reflect.Reflect`, which `reflect.valueOf` requires of `T`; the compiler implements it for every record, enum and newtype of the program: a field of one holds this value, which reflection carries as it is
// expect-error: E1105 `fs.FileSystem` does not implement `reflect.Reflect`, which `reflect.call` requires of `S`; the compiler implements it for every record, enum and newtype of the program: a field of one holds this value, which reflection carries as it is
// expect-error: E1105 `fs.FileSystem` does not implement `reflect.Reflect`, so it cannot become a `reflect.Value`; the compiler implements it for every record, enum and newtype of the program: a field of one holds this value, which reflection carries as it is
