// C++ as a porter writes it, each with what Tondo writes.
enum class Kind { Food, Drink }

type Line = {
    name: String
}

int total(Line line) {
    return 1
}

fn count(line: const Line&): Int {
    1
}

fn main() {
    auto x = 5
    std::vector<int> xs
    std::cout << x
    let p = Line { name: "a" }
    let n = p->name
    delete p
}

// A line that ends in `>` goes on in the next, so this one is last.
#include <vector>

// expect-error: E0002 a module is imported at the top, as `import std.console`
// expect-error: E0004 an enum is `enum Kind { ... }`, a variant on each line
