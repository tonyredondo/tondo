enum Problem {
    Bad
}

fn value(): Int { 1 }

fn risky(): Int ! Problem { 1 }

fn maybe(): Int? { none }

// An option that nobody reads is no failure: it warns as any value that a
// call with no effect gives.
fn main() {
    value()
    _ = risky()
    risky()
    maybe()
}

// expect-error: E1303 a value of type `Int ! Problem` is not used; pass a failure on with `?`, handle it with `match`, or discard it with `_ = ...`
// expect-warning: W1018 nothing uses what this call gives
