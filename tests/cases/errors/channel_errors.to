fn produce(numbers: Sender[Int]) {
    numbers.send(1)
}

fn main() {
    let (sender, receiver) = channel[Int](4)
    produce(sender)
    sender.send(2)
    let untyped = channel(4)
    receiver.send(1)
    let (texts, lines) = channel[String]()
    texts.send(5)
    let labeled = channel[Int](label: 3)
}

fn shadow() {
    let channel = 3
}

