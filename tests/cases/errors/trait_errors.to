trait Summary {
    fn summarize(self): String
}

trait Named {
    fn summarize(self): String
}

type User = { name: String }
type Item = { id: Int }

impl Summary for User {
    fn summarize(self): Int {
        1
    }

    fn extra(self) {}
}

impl Summary for User {
    fn summarize(self): String {
        "again"
    }
}

impl Summary for Item {}

impl Display for Int {
    fn display(self): String {
        "int"
    }
}

fn consume(value: Summary) {}

fn render[T: Summary + Summary](value: T): String {
    value.summarize()
}

fn both[T: Summary + Named](value: T): String {
    value.summarize()
}

fn main() {
    let user = User { name: "a" }
    let text = user.summarize()
    let other = render(42)
    let shown = "{Item { id: 1 }}"
}

// expect-error: E1114 `summarize` does not match `Summary`: the result must be `String`
// expect-error: E1114 `Summary` has no method `extra`
// expect-error: E1111 `impl Summary for User` overlaps an earlier implementation
// expect-error: E1114 `impl Summary for Item` is missing `summarize`
// expect-error: E1114 implements a prelude trait for a type this module does not own
// expect-error: E1110 a trait is not a type
// expect-error: E1115 this bound is repeated
// expect-error: E1004 `summarize` comes from more than one bound
// expect-error: E1001 `summarize` comes from the trait `Summary`; call `Summary.summarize(value, ...)`
// expect-error: E1105 `Int` does not implement `Summary`, which `render` requires of `T`
// expect-error: E1105 `Item` does not implement `Display`: add `impl Display for Item
