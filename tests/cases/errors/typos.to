// A name, field, method, variant or module that looks like a typo of one
// in sight gets a suggestion.
import std.jsn

type User = { name: String, email: String }

enum Color {
    Red
    Green
}

fn total(values: Array[Int]): Int {
    var sum = 0
    for value in values {
        sum += vaule
    }
    sum
}

fn main() {
    let user = User { name: "Ada", emial: "a@b" }
    let shown = user.nmae
    var xs = [1]
    xs.psuh(2)
    let color = Color.Gren
    let n = totl([1])
}

