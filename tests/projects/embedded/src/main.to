// Files of the package, read when the program compiles (standard library
// 14.27): a text, bytes, and a directory but its hidden files.

import std.console
import std.embed
import embedded.web

const Greeting: String = embed.text("greeting.txt")

fn main() {
    console.print(Greeting)
    console.println("{web.raw()}")
    console.println("{web.Site.paths()}")
    console.println("{web.Site.list("")} {web.Site.list("css")}")
    console.println("{web.Site.text("index.html")} {web.Site.text("raw.bin")} {web.Site.read("missing")}")
    console.println("{web.Site.read("/css/site.css").map((bytes) { bytes.length() })}")
}

// expect-stdout: Hello from a file.
// expect-stdout: [255, 0, 16]
// expect-stdout: [css/site.css, index.html, raw.bin]
// expect-stdout: [css/, index.html, raw.bin] [site.css]
// expect-stdout: some(<h1>home</h1>
// expect-stdout: ) none none
// expect-stdout: some(19)
