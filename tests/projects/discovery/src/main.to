// A server's health and reflection, read by clients made from their own
// `.proto` files: a status, a service it does not know, a change a watch
// sees, the services it lists and the files that declare them, as protoc
// writes them.

import discovery.api.greeter
import discovery.grpc.health.v1.health as checks
import discovery.grpc.reflection.v1.reflection
import std.console
import std.grpc
import std.http

type Greetings = {}

impl greeter.Greeter for Greetings {
    fn sayHello(self, request: greeter.HelloRequest): greeter.HelloReply ! grpc.Status {
        greeter.HelloReply { message: "hello {request.name}" }
    }

    fn repeat(self, _: greeter.HelloRequest, _: Sender[greeter.HelloReply]): !grpc.Status {}

    fn collect(self, _: grpc.Stream[greeter.HelloRequest]): greeter.HelloReply ! grpc.Status {
        greeter.HelloReply {}
    }

    fn chat(self, _: grpc.Stream[greeter.HelloRequest], _: Sender[greeter.HelloReply]): !grpc.Status {}
}

fn hex(bytes: Array[Byte]): String {
    bytes.map((b) { Int(b).toString(16).padStart(2, "0") }).join("")
}

fn main(): !(http.HttpError | grpc.Status) {
    let health = grpc.Health.new()
    let service = greeter.greeter(Greetings {})
    var app = http.App.new()
    app.grpc(service)
    app.grpc(health.service())
    app.grpc(grpc.reflection([service, health.service()]))
    let server = app.start()?
    let connection = grpc.connect("http://{server.address()}")?

    let client = checks.HealthClient.on(connection)
    console.println("{client.check(checks.HealthCheckRequest {})?.status}")
    match client.check(checks.HealthCheckRequest { service: "demo.v1.Greeter" }) {
        ok(reply) => console.println("{reply.status}")
        err(status) => console.println("{status}")
    }
    health.set("demo.v1.Greeter", grpc.ServingStatus.NotServing)
    var watching = client.watch(checks.HealthCheckRequest { service: "demo.v1.Greeter" })
    console.println("{watching.next().map((each) { each.map((reply) { "{reply.status}" }) })}")
    health.set("demo.v1.Greeter", grpc.ServingStatus.Serving)
    console.println("{watching.next().map((each) { each.map((reply) { "{reply.status}" }) })}")

    let asking = reflection.ServerReflectionClient.on(connection).serverReflectionInfo()
    let ask = (request: reflection.ServerReflectionRequestMessageRequest) {
        reflection.ServerReflectionRequest { messageRequest: some(request) }
    }
    asking.send(ask(reflection.ServerReflectionRequestMessageRequest.ListServices("*")))?
    asking.send(
        ask(
            reflection.ServerReflectionRequestMessageRequest.FileContainingSymbol("demo.v1.Greeter"),
        ),
    )?
    asking.send(
        ask(
            reflection.ServerReflectionRequestMessageRequest.FileContainingSymbol(
                "grpc.health.v1.Health",
            ),
        ),
    )?
    asking.send(ask(reflection.ServerReflectionRequestMessageRequest.FileByFilename("nope.proto")))?
    asking.closeSend()
    for each in asking.replies() {
        match each?.messageResponse {
            some(reflection.ServerReflectionResponseMessageResponse.ListServicesResponse(list)) => {
                console.println(list.service.map((s) { s.name }).join(", "))
            }
            some(reflection.ServerReflectionResponseMessageResponse.FileDescriptorResponse(files)) => {
                console.println(
                    "{files.fileDescriptorProto.length()} file: {hex(files.fileDescriptorProto[0])}",
                )
            }
            some(reflection.ServerReflectionResponseMessageResponse.ErrorResponse(failure)) => {
                console.println("{failure.errorCode}: {failure.errorMessage}")
            }
            _ => console.println("?")
        }
    }
    server.stop()
}

// expect-stdout: SERVING
// expect-stdout: NotFound: the server has no service `demo.v1.Greeter`
// expect-stdout: some(ok(NOT_SERVING))
// expect-stdout: some(ok(SERVING))
// expect-stdout: demo.v1.Greeter, grpc.health.v1.Health
// expect-stdout: 1 file: 
// expect-stdout: 1 file: 
// expect-stdout: 5: no file `nope.proto`
