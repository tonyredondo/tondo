// gRPC-Web, as browsers send it, to the routes of a gRPC service: a unary
// call and a stream, in bytes and in Base64 text sent in two padded
// pieces, each with its status and trailers in a last frame of the body,
// a failure's too, and a body of text that is not Base64.

import grpcweb.api.greeter
import std.console
import std.encoding
import std.grpc
import std.http
import std.protobuf

type Greetings = {}

impl greeter.Greeter for Greetings {
    fn sayHello(self, request: greeter.HelloRequest): greeter.HelloReply ! grpc.Status {
        if request.name.isEmpty() {
            fail grpc.Status { code: grpc.Code.InvalidArgument, message: "a name is needed" }
        }
        grpc.setTrailer("x-served", "web")
        greeter.HelloReply { message: "hello {request.name}" }
    }

    fn repeat(self, request: greeter.HelloRequest, out: Sender[greeter.HelloReply]): !grpc.Status {
        for at in 0..Int(request.times) {
            out.send(greeter.HelloReply { message: "{request.name} {at}" })
        }
    }

    fn collect(self, _: grpc.Stream[greeter.HelloRequest]): greeter.HelloReply ! grpc.Status {
        greeter.HelloReply {}
    }

    fn chat(self, _: grpc.Stream[greeter.HelloRequest], _: Sender[greeter.HelloReply]): !grpc.Status {}
}

/// A request framed as gRPC-Web frames it.
fn framed(request: greeter.HelloRequest): Array[Byte] {
    let bytes = protobuf.encode(request)
    let flag: Array[Byte] = [0]
    flag.concat(UInt32.wrapping(bytes.length()).toBytes()).concat(bytes)
}

/// The bytes of Base64 text written in pieces, each padded.
fn unpadded(text: String): Array[Byte] {
    var bytes: Array[Byte] = []
    var start = 0
    var at = 4
    for at <= text.length() {
        if text.slice(at - 1, at).unwrapOr("") == "=" or at == text.length() {
            bytes = bytes.concat(
                encoding.base64Decode(text.slice(start, at).unwrapOr("")).unwrapOr([]),
            )
            start = at
        }
        at += 4
    }
    bytes
}

/// A reply's frames: each message's text, then the trailers' lines.
fn shown(body: Array[Byte]): String {
    var parts: Array[String] = []
    var at = 0
    for at + 5 <= body.length() {
        let length = Int(UInt32.fromBytes(body, at: at + 1))
        let bytes = body.drop(at + 5).take(length)
        if body[at] == 0x80 {
            let block = String.fromBytes(bytes).unwrapOr("?")
            parts.push(block.trimEnd("\r\n").split("\r\n").join(", "))
        } else {
            match protobuf.decode[greeter.HelloReply](bytes) {
                ok(reply) => parts.push(reply.message)
                err(error) => parts.push("{error}")
            }
        }
        at += 5 + length
    }
    parts.join(" | ")
}

fn main(): !(http.HttpError | grpc.Status) {
    var app = http.App.new()
    app.grpc(greeter.greeter(Greetings {}))
    let server = app.start()?
    let web = http.Client.new()
    let base = "http://{server.address()}/demo.v1.Greeter"
    let binary = "application/grpc-web+proto"
    let hello =
        web.post(
            "{base}/SayHello",
            body: some(http.Body.bytes(
                framed(greeter.HelloRequest { name: "web" }),
                contentType: binary,
            )),
            headers: ["x-grpc-web": "1"],
        )?
    console.println("{hello.header("content-type").unwrapOr("-")} {shown(hello.bytes()?)}")
    let repeated =
        web.post(
            "{base}/Repeat",
            body: some(http.Body.bytes(
                framed(greeter.HelloRequest { name: "tick", times: 3 }),
                contentType: binary,
            )),
        )?
    console.println(shown(repeated.bytes()?))
    let failed =
        web.post(
            "{base}/SayHello",
            body: some(http.Body.bytes(framed(greeter.HelloRequest {}), contentType: binary)),
        )?
    console.println("{failed.status()} {shown(failed.bytes()?)}")
    // As text, the request in two pieces, each padded as a client may send
    // them.
    let frame = framed(greeter.HelloRequest { name: "text", times: 2 })
    let pieces = "{encoding.base64Encode(frame.take(4))}{encoding.base64Encode(frame.drop(4))}"
    let text = "application/grpc-web-text+proto"
    let typed = web.post("{base}/Repeat", body: some(http.Body.text(pieces, contentType: text)))?
    let answer = String.fromBytes(typed.bytes()?).unwrapOr("")
    console.println("{typed.header("content-type").unwrapOr("-")} {shown(unpadded(answer))}")
    let wrong = web.post("{base}/SayHello", body: some(http.Body.text("AAA*", contentType: text)))?
    console.println(shown(unpadded(String.fromBytes(wrong.bytes()?).unwrapOr(""))))
    // The same routes still answer gRPC.
    let client = greeter.GreeterClient.on(grpc.connect("http://{server.address()}")?)
    console.println(client.sayHello(greeter.HelloRequest { name: "grpc" })?.message)
    server.stop()
}

// expect-stdout: application/grpc-web+proto hello web | x-served: web, grpc-status: 0
// expect-stdout: tick 0 | tick 1 | tick 2 | grpc-status: 0
// expect-stdout: 200 grpc-status: 3, grpc-message: a name is needed
// expect-stdout: application/grpc-web-text+proto text 0 | text 1 | grpc-status: 0
// expect-stdout: grpc-status: 3, grpc-message: the request's Base64 text is wrong near character 3 of its piece
// expect-stdout: hello grpc
