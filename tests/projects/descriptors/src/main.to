// The descriptor of a `.proto` file with options, reserved numbers and
// names, extension ranges, extensions and a public import, as protoc
// writes it, and the names it declares.

import descriptors.options
import std.console

fn main() {
    let file = options.fileDescriptor()
    console.println("{file.name} {file.imports.map((imported) { imported.name })}")
    console.println(file.bytes.map((b) { Int(b).toString(16).padStart(2, "0") }).join(""))
    console.println(file.symbols.join(", "))
}

// expect-stdout: options.proto [api/common.proto]
// expect-stdout: 
// expect-stdout: edge.opts.Base, edge.opts.Base.inner_note, edge.opts.Color, edge.opts.Things, edge.opts.Things.Get, edge.opts.Things.Put, edge.opts.note
