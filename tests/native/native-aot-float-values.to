            }
        Bool(_) => -1
    }
}

fn integerMatrix32(): Int {
    let value = identity(42.0f32)
    let integer0 = match Int8(value) {
        ok(number) => number == 42i8
        err(_) => false
    }
    let integer1 = match Int16(value) {
        ok(number) => number == 42i16
        err(_) => false
    }
    let integer2 = match Int32(value) {
        ok(number) => number == 42i32
        err(_) => false
    }
    let integer3 = match Int(value) {
