type Box[T] = {
    value: T
}

fn identity[T: Copy](value: T): T {
    value
}

fn same[T: Copy + Equatable](left: T, right: T): Bool {
    left == right
}

fn add32(a: Float32, b: Float32): Float32 {
    a + b
}

fn subtract32(a: Float32, b: Float32): Float32 {
    a - b
}

fn multiply32(a: Float32, b: Float32): Float32 {
    a * b
}

fn divide32(a: Float32, b: Float32): Float32 {
    a / b
}

fn negate32(value: Float32): Float32 {
    -value
}

fn multiplyAdd32(a: Float32, b: Float32, c: Float32): Float32 {
    let product = a * b
    product + c
}

fn integer32(value: Float32): Int ! NumericConversionError {
    Int(value)?
}

fn unsigned32(value: Float32): UInt64 ! NumericConversionError {
    UInt64(value)?
}

enum Choice32 {
    Empty
    Value(Float32)
}

fn arithmetic32(): Int {
    if add32(40.0f32, 2.0f32) == 42.0f32 and
        subtract32(45.0f32, 3.0f32) == 42.0f32 and
        multiply32(6.0f32, 7.0f32) == 42.0f32 and
        divide32(84.0f32, 2.0f32) == 42.0f32 {
        42
    } else {
        -1
    }
}

fn roundToEven32(): Int {
    if add32(16777216.0f32, 1.0f32) == 16777216.0f32 {
        42
    } else {
        -1
    }
}

fn separateRounding32(): Int {
    if multiplyAdd32(1.00000011920928955078125f32, 0.99999988079071044921875f32, -1.0f32) == 0.0f32 {
        42
    } else {
        -1
    }
}

fn signedZero32(): Int {
    let zero = negate32(0.0f32)
    if zero == 0.0f32 and
        divide32(1.0f32, zero) < 0.0f32 and
        divide32(1.0f32, negate32(zero)) > 0.0f32 {
        42
    } else {
        -1
    }
}

fn nanRelations32(): Int {
    let value = divide32(0.0f32, 0.0f32)
    if value != value and
        not (value == value) and
        not (value < 1.0f32) and
        not (value <= 1.0f32) and
        not (value > 1.0f32) and
        not (value >= 1.0f32) {
        42
    } else {
        -1
    }
}

fn infinities32(): Int {
    let value = multiply32(3.4028234663852886e38f32, 2.0f32)
    let nan = subtract32(value, value)
    if value > 3.4028234663852886e38f32 and
        negate32(value) < -3.4028234663852886e38f32 and
        nan != nan {
        42
    } else {
        -1
    }
}

fn subnormal32(): Int {
    if add32(1.401298464324817e-45f32, 1.401298464324817e-45f32) > 1.401298464324817e-45f32 and
        1.401298464324817e-45f32 > 0.0f32 and
        multiply32(-1.401298464324817e-45f32, 0.5f32) == 0.0f32 and
        divide32(1.0f32, multiply32(-1.401298464324817e-45f32, 0.5f32)) < 0.0f32 {
        42
    } else {
        -1
    }
}

fn finiteOrder32(): Int {
    let value = identity(42.0f32)
    if value < 43.0f32 and
        value <= 42.0f32 and
        value >= 42.0f32 and
        value > 41.0f32 and
        value != 0.0f32 {
        42
    } else {
        -1
    }
}

fn aggregateCopy32(): Int {
    var value = Box[Float32] { value: 42.0f32 }
    let copy = identity(value)
    value.value = 1.0f32
    if copy.value == 42.0f32 and
        value.value == 1.0f32 and
        same(copy, Box[Float32] { value: 42.0f32 }) {
        42
    } else {
        -1
    }
}

fn aggregateNaN32(): Int {
    let nan = divide32(0.0f32, 0.0f32)
    let value = Box[Float32] { value: nan }
    if not same(value, value) and
        same(Box[Float32] { value: 0.0f32 }, Box[Float32] { value: -0.0f32 }) {
        42
    } else {
        -1
    }
}

fn inactivePayload32(): Int {
    var value = Choice32.Value(divide32(0.0f32, 0.0f32))
    value = Choice32.Empty
    if value == Choice32.Empty {
        42
    } else {
        -1
    }
}

