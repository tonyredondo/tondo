        err(_) => false
    }
    let integer8 = match Byte(value) {
        ok(number) => number == Byte(42u8)
        err(_) => false
    }
    let group0 = integer0 and
        Float32(42i8) == 42.0f32 and
        integer1 and
        Float32(42i16) == 42.0f32 and
        integer2 and
        Float32(42i32) == 42.0f32
    let group1 = integer3 and
        Float32(42) == 42.0f32 and
        integer4 and
        Float32(42u8) == 42.0f32 and
        integer5 and
        Float32(42u16) == 42.0f32
    let group2 = integer6 and
        Float32(42u32) == 42.0f32 and
        integer7 and
        Float32(42u64) == 42.0f32 and
        integer8 and
        Float32(Byte(42u8)) == 42.0f32
    if group0 and group1 and group2 {
        42
    } else {
        -1
    }
}

