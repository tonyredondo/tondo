type Mixed = {
    single: Float32
    double: Float
}

fn pair(single: Float32, double: Float): (Float32, Float) {
    (single, double)
}

fn mixedAggregate(): Int {
    var value = Mixed { double: -0.0, single: 42.0 }
    let copy = identity(value)
    value.single = 1.0
    let tuple = pair(copy.single, copy.double)
    if tuple.0 == 42.0f32 and divide64(1.0, tuple.1) < 0.0 and value.single == 1.0f32 {
        42
    } else {
        -1
    }
}

