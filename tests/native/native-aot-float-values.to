}

fn narrowSubnormal(): Int {
    match narrow(-1e-50) {
        ok(value) =>
            if value == 0.0f32 and divide32(1.0f32, value) < 0.0f32 {
                42
            } else {
                -1
            }
        _ => -1
    }
}

fn narrowNaN(): Int {
    match narrow(divide64(0.0, 0.0)) {
        ok(value) =>
            if value != value {
                42
            } else {
                -1
            }
        _ => -1
    }
}

fn promotedValues(): Int {
    let zero = Float(negate32(0.0f32))
    let tiny = Float(identity(1.401298464324817e-45f32))
    let nan = Float(divide32(0.0f32, 0.0f32))
    if divide64(1.0, zero) < 0.0 and tiny == 1.401298464324817e-45 and nan != nan {
        42
    } else {
        -1
    }
}

fn replaceResult(): Int {
    var result: Float32 ! NumericConversionError = ok(divide32(0.0f32, 0.0f32))
    result = narrow(1e100)
    if result == err(NumericConversionError.OutOfRange) {
        42
    } else {
        -1
    }
}

fn propagatedNarrow(value: Float): Float32 ! NumericConversionError {
    let converted = narrow(value)?
    ok(converted)
}

fn propagation(): Int {
    match propagatedNarrow(1e100) {
        err(NumericConversionError.OutOfRange) => 42
        _ => -1
    }
}

fn main() {}
