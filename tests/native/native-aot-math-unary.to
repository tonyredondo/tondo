import std.math

fn floorFinite(): Int {
    assert(math.floor(2.9) == 2.0)
    assert(math.floor(-2.1) == -3.0)
    42
}

fn ceilFinite(): Int {
    assert(math.ceil(2.1) == 3.0)
    assert(math.ceil(-2.9) == -2.0)
    42
}

fn roundEven(): Int {
    assert(math.round(0.5) == 0.0)
    assert(math.round(1.5) == 2.0)
    assert(math.round(2.5) == 2.0)
    assert(math.round(3.5) == 4.0)
    assert(math.round(-2.5) == -2.0)
    42
}

fn roundAway(): Int {
    assert(math.roundTiesAway(0.5) == 1.0)
    assert(math.roundTiesAway(2.5) == 3.0)
    assert(math.roundTiesAway(-0.5) == -1.0)
    assert(math.roundTiesAway(-2.5) == -3.0)
    42
}

fn truncateFinite(): Int {
    assert(math.truncate(2.9) == 2.0)
    assert(math.truncate(-2.9) == -2.0)
    42
}

fn absoluteFinite(): Int {
    assert(math.abs(-4.0) == 4.0)
    assert(math.abs(4.0) == 4.0)
    42
}

fn signedZero(): Int {
    let positiveInfinity = 1.0 / 0.0
    let negativeInfinity = 1.0 / -0.0
    assert(1.0 / math.round(-0.5) == negativeInfinity)
    assert(1.0 / math.ceil(-0.5) == negativeInfinity)
    assert(1.0 / math.truncate(-0.5) == negativeInfinity)
    assert(1.0 / math.abs(-0.0) == positiveInfinity)
    42
}

fn subnormal(): Int {
    let tiny = 1e-320
    assert(1.0 / math.floor(tiny) == 1.0 / 0.0)
    assert(1.0 / math.ceil(tiny) == 1.0)
    assert(1.0 / math.round(-tiny) == 1.0 / -0.0)
    assert(1.0 / math.roundTiesAway(tiny) == 1.0 / 0.0)
    42
}

fn infinities(): Int {
    let positive = 1.0 / 0.0
    let negative = 1.0 / -0.0
    assert(math.floor(positive) == positive)
    assert(math.ceil(negative) == negative)
    assert(math.round(positive) == positive)
    assert(math.roundTiesAway(negative) == negative)
    assert(math.truncate(negative) == negative)
    assert(math.abs(negative) == positive)
    42
}

fn nanValues(): Int {
    let nan = 0.0 / 0.0
    assert(math.floor(nan) != math.floor(nan))
    assert(math.ceil(nan) != math.ceil(nan))
    assert(math.round(nan) != math.round(nan))
    assert(math.roundTiesAway(nan) != math.roundTiesAway(nan))
    assert(math.truncate(nan) != math.truncate(nan))
    assert(math.abs(nan) != math.abs(nan))
    42
}

fn largeIntegral(): Int {
    let value = 4503599627370497.0
    assert(math.floor(value) == value)
    assert(math.ceil(value) == value)
    assert(math.round(value) == value)
    assert(math.roundTiesAway(value) == value)
    assert(math.truncate(value) == value)
    42
}

fn wrap(value: Float): Float {
    math.abs(value)
}

fn ordinaryCall(): Int {
    assert(wrap(-42.0) == 42.0)
    42
}

fn main() {}
