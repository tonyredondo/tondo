import std.hash
import std.testing

/// Words of ASCII alone.
const Ascii: String = "the quick brown fox jumps over the lazy dog "

/// Words in other scripts: Spanish with its accents, Greek and Japanese,
/// which take two and three bytes a character.
const Other: String = "el ñandú comió más piñones αβγ δέλτα 日本語の文章 "

/// About 1 MiB of text, as a file or a response is read whole: the Ascii
/// words, and the Other words with a character of four bytes, `𝄞`.
fn megabyte(other: Bool): String {
    if other { "{Other}𝄞 ".repeat(14_169) } else { Ascii.repeat(23_831) }
}

fn parsed(texts: Array[String]): Int {
    var total = 0
    for text in texts {
        total += Int.parse(text) ?? 0
    }
    total
}

fn counted(text: String): Int {
    var count = 0
    for _ in text.chars() {
        count += 1
    }
    count
}

// Each answer asserted here is also what bench/go gives.
test texts {
    let (ascii, other) = (Ascii.repeat(25), Other.repeat(25))
    let replaced = testing.bench("replace ascii", () => ascii.replace("the", "a"))
    assert(hash.fnv64a(replaced.bytes()) == 5736149670972329104)
    assert(replaced.byteLength() == 1000 and not replaced.contains("the"))
    assert(replaced.startsWith("a quick brown fox jumps over a lazy dog"))
    let replacedOther = testing.bench("replace other", () => other.replace("más", "menos"))
    assert(hash.fnv64a(replacedOther.bytes()) == 4493831165883743631)
    assert(replacedOther.byteLength() == 1750 and not replacedOther.contains("más"))
    assert(replacedOther.startsWith("el ñandú comió menos piñones"))
    let padded = "   {Ascii}\t\n"
    assert(
        testing.bench("trim", () => padded.trim()) == "the quick brown fox jumps over the lazy dog",
    )
    assert(testing.bench("trim read", () => padded.trim().byteLength()) == 43)
    let upper = testing.bench("toUpper ascii", () => ascii.toUpper())
    assert(hash.fnv64a(upper.bytes()) == 4380632396578631616)
    assert(upper.byteLength() == 1100 and upper.startsWith("THE QUICK BROWN FOX"))
    assert(upper.endsWith("OVER THE LAZY DOG "))
    let upperOther = testing.bench("toUpper other", () => other.toUpper())
    assert(hash.fnv64a(upperOther.bytes()) == 7735282680022484963)
    assert(
        upperOther.byteLength() == 1725 and
            upperOther.startsWith("EL ÑANDÚ COMIÓ MÁS PIÑONES ΑΒΓ ΔΈΛΤΑ"),
    )
    let words = Ascii.split(" ").repeat(10)
    let commaJoined = testing.bench("join 100", () => words.join(", "))
    assert(hash.fnv64a(commaJoined.bytes()) == 1243310430644686103)
    assert(commaJoined.byteLength() == 548 and commaJoined.startsWith("the, quick, brown"))
    assert(commaJoined.endsWith("over, the, lazy, dog, "))
    assert(testing.bench("split other", () => other.split(" ").length()) == 201)
    assert(not testing.bench("contains other", () => other.contains("文章 x")))
    let written = (0..1000).map(n => "{n * 7919}").collect()
    assert(testing.bench("parse ints 1000", () => parsed(written)) == 3_955_540_500)
    assert(testing.bench("chars ascii", () => counted(ascii)) == 1100)
    assert(testing.bench("chars other", () => counted(other)) == 1100)
    // Bytes made text: Tondo checks that they are UTF-8, which Go does not.
    let (longAscii, longOther) = (megabyte(false), megabyte(true))
    let asciiBytes = longAscii.bytes()
    let fromAscii = testing.bench("fromBytes ascii", () => String.fromBytes(asciiBytes))?
    assert(fromAscii.byteLength() == 1_048_564 and fromAscii == longAscii)
    let otherBytes = longOther.bytes()
    let fromOther = testing.bench("fromBytes other", () => String.fromBytes(otherBytes))?
    assert(fromOther.byteLength() == 1_048_506 and counted(fromOther) == 651_774)
    assert(fromOther == longOther)
    // A mebibyte split into its lines, searched, replaced in and changed
    // of case: the small rows' work at a size past the caches.
    let lines = "{Ascii.trimEnd()}\n".repeat(23_831)
    let pieces = testing.bench("split lines 1MiB", () => lines.split("\n"))
    assert(pieces.length() == 23_832 and pieces.map(piece => piece.byteLength()).sum() == 1_024_733)
    assert(pieces[0] == Ascii.trimEnd() and pieces[23_831] == "")
    let replacedLong = testing.bench("replace other 1MiB", () => longOther.replace("más", "menos"))
    assert(replacedLong.byteLength() == 1_062_675 and not replacedLong.contains("más"))
    assert(hash.fnv64a(replacedLong.bytes()) == 2235696670756215482)
    assert(not testing.bench("contains 1MiB", () => longOther.contains("文章 x")))
    let upperLong = testing.bench("toUpper other 1MiB", () => longOther.toUpper())
    assert(upperLong.byteLength() == 1_048_506 and upperLong.startsWith("EL ÑANDÚ COMIÓ MÁS"))
    assert(hash.fnv64a(upperLong.bytes()) == 18009355550675320886)
}
