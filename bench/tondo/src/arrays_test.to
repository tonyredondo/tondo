import std.testing

/// `count` numbers in a fixed shuffled order, from a linear congruential
/// generator, as the Go side makes them.
fn shuffled(count: Int): Array[Int] {
    var values: Array[Int] = []
    var seed = 42
    for _ in 0..count {
        seed = (seed * 1_103_515_245 + 12345) % 2_147_483_648
        values.push(seed % 100_000)
    }
    values
}

fn pushed(count: Int): Int {
    var values: Array[Int] = []
    for i in 0..count {
        values.push(i)
    }
    values.length()
}

fn indexed(values: Array[Int]): Int {
    var total = 0
    for i in 0..values.length() {
        total += values[i]
    }
    total
}

test arrays {
    // bench/go gives the same.
    assert(testing.bench("push 1000", () => pushed(1000)) == 1000)
    let values = shuffled(10_000)
    let sorted = testing.bench("sort 10000", () => values.sorted())
    assert(sorted.length() == 10_000)
    assert(sorted[0] == 9 and sorted[5_000] == 49_845 and sorted[9_999] == 99_988)
    assert(sorted.sum() == 497_478_728)
    // bench/go gives the same.
    assert(
        testing.bench(
            "map filter sum 10000",
            () => values.map(x => x * 2).filter(x => x % 3 == 0).sum(),
        ) ==
            313_036_794,
    )
    // bench/go gives the same.
    assert(testing.bench("index sum 10000", () => indexed(values)) == 497_478_728)
    // A million, past the caches: the sort's copy is one large allocation
    // a run, and the array `map` makes one written at memory's speed.
    let million = shuffled(1_000_000)
    let sortedMillion = testing.bench("sort 1000000", () => million.sorted())
    assert(sortedMillion.length() == 1_000_000 and sortedMillion.sum() == 49_959_089_856)
    assert(sortedMillion[0] == 0 and sortedMillion[500_000] == 49_958)
    assert(sortedMillion[999_999] == 99_999)
    let mapped = testing.bench("map 1000000", () => million.map(x => x * 3 + 1))
    assert(mapped.length() == 1_000_000 and mapped.sum() == 149_878_269_568)
    assert(mapped[0] == 288_082 and mapped[999_999] == 253_567)
}
