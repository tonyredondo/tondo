import std.format
import std.testing

fn joined(count: Int): String {
    var builder = format.Builder()
    for i in 0..count {
        builder.add("part")
        builder.add(i)
    }
    builder.text()
}

fn ints(count: Int): Int {
    var total = 0
    for i in 0..count {
        total += "{i}".length()
    }
    total
}

// Each answer asserted here is also what bench/go gives.
test strings {
    let (name, place) = ("ada", "london")
    assert(
        testing.bench("interpolate", () => "{name} lives in {place}, age {36}") ==
            "ada lives in london, age 36",
    )
    let text = testing.bench("builder 100", () => joined(100))
    assert(text.byteLength() == 590 and text.startsWith("part0part1part2"))
    assert(text.endsWith("part97part98part99"))
    let csv = ["alpha", "beta", "gamma", "delta"].repeat(25).join(",")
    assert(testing.bench("split 100", () => csv.split(",").length()) == 100)
    assert(testing.bench("int to text 1000", () => ints(1000)) == 2890)
    let haystack = "{"abcdefghij".repeat(100)}needle"
    assert(testing.bench("contains 1000", () => haystack.contains("needle")))
}
