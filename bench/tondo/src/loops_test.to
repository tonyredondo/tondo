import std.testing

fn sum(count: Int): Int {
    var total = 0
    for i in 0..count {
        total += i * i % 7
    }
    total
}

fn collatz(limit: Int): Int {
    var steps = 0
    for start in 1..limit {
        var n = start
        for n != 1 {
            n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 }
            steps += 1
        }
    }
    steps
}

test loops {
    testing.bench("sum 1000000", () { sum(1_000_000) })
    testing.bench("collatz 10000", () { collatz(10_000) })
}
