import std.hash
import std.json
import std.testing

type Item = {
    id: Int
    name: String
    price: Float
    tags: Array[String]
    available: Bool
}

type Sale = {
    id: Int
    customer: Int
    cents: Int
    region: String
    items: Array[String]
}

/// `count` sales from the generator, each with three items, as the Go side
/// makes them.
fn sales(count: Int): Array[Sale] {
    let regions = ["north", "south", "east", "west"]
    var all: Array[Sale] = []
    var seed = 42
    for id in 0..count {
        seed = (seed * 1_103_515_245 + 12345) % 2_147_483_648
        all.push(
            Sale {
                id
                customer: seed % 1000
                cents: seed % 100_000
                region: regions[seed % 4]
                items: ["a{seed % 10}", "b{seed % 20}", "c{seed % 30}"]
            },
        )
    }
    all
}

const Document: String = "{{\"id\": 7, \"name\": \"lamp\", \"price\": 19.5, \"tags\": [\"home\", \"light\"], \"available\": true, \"stock\": 120, \"color\": \"white\", \"weight\": 1.25, \"brand\": \"lumen\", \"code\": \"LMP-7\"}}"

fn numbers(count: Int): String {
    var parts: Array[String] = []
    for i in 0..count {
        parts.push("{i}")
    }
    "[{parts.join(",")}]"
}

test json {
    let object = testing.bench("parse object", () => json.parse(Document))?
    assert(
        "{object}" ==
            "{{\"id\":7,\"name\":\"lamp\",\"price\":19.5,\"tags\":[\"home\",\"light\"],\"available\":true,\"stock\":120,\"color\":\"white\",\"weight\":1.25,\"brand\":\"lumen\",\"code\":\"LMP-7\"}}",
    )
    let array = numbers(1000)
    let parsedNumbers = testing.bench("parse 1000 numbers", () => json.parse(array))?
    assert(hash.fnv64a("{parsedNumbers}".bytes()) == 13024206030383795523)
    let shown = "{parsedNumbers}"
    assert(
        shown.byteLength() == 3891 and shown.startsWith("[0,1,2,") and shown.endsWith(",998,999]"),
    )
    // bench/go gives the same.
    let item = testing.bench("decode struct", () => json.decode[Item](Document))?
    assert(item.id == 7 and item.name == "lamp" and item.price == 19.5)
    assert(item.tags == ["home", "light"] and item.available)
    var items: Array[Item] = []
    for i in 0..100 {
        items.push(
            Item {
                id: i
                name: "item {i}"
                price: Float(i) * 1.5
                tags: ["a", "b"]
                available: i % 2 == 0
            },
        )
    }
    // bench/go gives the same.
    let text = testing.bench("encode 100 structs", () => json.encode(items))
    assert(hash.fnv64a(text.bytes()) == 4178917000893075233)
    assert(text.byteLength() == 7357)
    assert(text.startsWith("[{{\"id\":0,\"name\":\"item 0\","))
    assert(text.endsWith("\"tags\":[\"a\",\"b\"],\"available\":false}}]"))
    // A mebibyte of 12,548 sales, decoded into records and written again,
    // the same bytes as Go's.
    let written = json.encode(sales(12_548))
    assert(written.byteLength() == 1_048_559)
    assert(hash.fnv64a(written.bytes()) == 17440677758073632460)
    let decoded = testing.bench("decode 1MiB", () => json.decode[Array[Sale]](written))?
    assert(decoded.length() == 12_548 and decoded.map(sale => sale.cents).sum() == 623_750_426)
    assert(decoded[12_547].region == "east" and decoded[12_547].items == ["a2", "b2", "c2"])
    assert(testing.bench("encode 1MiB", () => json.encode(decoded)) == written)
}
