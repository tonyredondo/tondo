import std.math
import std.testing

fn mandelbrot(size: Int): Int {
    var inside = 0
    for row in 0..size {
        for column in 0..size {
            let cr = Float(column) * 3.0 / Float(size) - 2.0
            let ci = Float(row) * 2.0 / Float(size) - 1.0
            var (zr, zi) = (0.0, 0.0)
            var iteration = 0
            for iteration < 50 and zr * zr + zi * zi <= 4.0 {
                let next = zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = next
                iteration += 1
            }
            if iteration == 50 {
                inside += 1
            }
        }
    }
    inside
}

fn roots(count: Int): Float {
    var total = 0.0
    for i in 0..count {
        total += math.checkedSqrt(Float(i)) ?? 0.0
    }
    total
}

fn floatsOf(count: Int): Array[Float] {
    var values: Array[Float] = []
    for i in 0..count {
        values.push(Float(i % 97) * 0.5)
    }
    values
}

test floats {
    // bench/go gives the same.
    assert(testing.bench("mandelbrot 64", () => mandelbrot(64)) == 1107)
    // bench/go gives the same.
    assert(testing.bench("sqrt 100000", () => roots(100_000)) == 21081692.74615191)
    let values = floatsOf(100_000)
    let others = floatsOf(100_000).reversed()
    // bench/go gives the same.
    assert(testing.bench("sum 100000", () => values.sum()) == 2399842.5)
    // bench/go gives the same.
    assert(testing.bench("dot 100000", () => math.dot(values, others)) == 45863082.5)
    let added = testing.bench("add 100000", () => values + others)
    assert(added.length() == 100_000)
    assert(added[0] == 44.5 and added[99_999] == 44.5)
    assert(added.sum() == 4_799_685.0)
}

test tensors {
    let left = math.Tensor(floatsOf(64 * 64), [64, 64])
    let other = math.Tensor(floatsOf(64 * 64).reversed(), [64, 64])
    let product = testing.bench("matmul 64", () => left.matmul(other))
    assert(product.shape() == [64, 64])
    assert(product.at(0, 0) == 25608.25 and product.at(63, 63) == 40317.75)
    let wide = math.Tensor(floatsOf(256 * 256), [256, 256])
    let row = math.Tensor(floatsOf(256), [256])
    let grid = testing.bench("broadcast 256", () => wide + row)
    assert(grid.shape() == [256, 256])
    assert(grid.at(0, 0) == 0.0 and grid.at(255, 255) == 60.5)
}
