import std.process
import std.testing

/// A program started and waited for, by its name, looked up on `PATH`,
/// and by its path: what a start costs, which a copy of the program's
/// memory, as a fork makes, would multiply.
test processes {
    testing.bench("true by name", () => process.command("true").status())?
    // Its path as this system has it: `/usr/bin/true`, or `/bin/true` on Alpine.
    let program = process.which("true") ?? testing.failNow("no `true` on PATH")
    testing.bench("true by path", () => process.command(program).status())?
}
