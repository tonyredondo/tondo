// Compares Tondo with Go: runs the benchmarks of bench/tondo with
// `tondo test --bench` and those of bench/go with `go test -bench`, and
// writes a Markdown table: for each benchmark, the time a run takes on each
// side, Tondo's time over Go's, and the allocations and bytes of a run, the
// slowest against Go first; and, where `perf` counts them, the instructions
// and cycles of a run on each side, which where the code lies does not move
// as it moves the time. A second table gives the latency of the servers of
// the `http` rows at a fixed rate of requests, the median and the 99th
// percentile, as bench/latency and bench/go/latency measure it; and where
// `dotnet` runs, a third holds the rows that bench/csharp has too, against
// C#.
//
//   tondo run bench/compare.to [--time <seconds>] [--output <file>] [--cpu <level>]
//
// `--cpu` builds both sides for a level of processor, as `tondo --cpu` and
// Go's `GOAMD64` name it: `x86-64-v3` is Go's `v3`; without it each side
// builds for its own default, Tondo's `baseline` and Go's `v1`.
//
// With `--old <tondo>` it compares that `tondo` with this one instead, as a
// change of the runtime is held to a baseline (docs/refactor.md, 0.7): the
// two measure in turns, `--rounds` of them, so that a machine that speeds up
// or slows down weighs on both, and it fails when a benchmark is slower than
// `--max` percent, 5 by default, or allocates more.
//
//   tondo run bench/compare.to -- --old <tondo> [--rounds 4] [--max 5]
//
// It runs from the repository's root; `TONDO` names the `tondo` to measure
// with, `tondo` on PATH by default.

import std.console
import std.env
import std.fs
import std.json
import std.process

type Measure = {
    nanoseconds: Float
    allocations: Float
    bytes: Float
    instructions: Float?
    cycles: Float?
}

type Row = {
    name: String
    tondo: Measure
    go: Measure
}

/// What `tondo test --bench` measured, by `test/benchmark`.
fn tondoSide(tondo: String, seconds: String, cpu: String): Map[String, Measure] ! String {
    let level = if cpu.isEmpty() { [] } else { ["--cpu", cpu] }
    let ran =
        process
            .command(
                tondo,
                "test",
                "bench/tondo",
                "--bench",
                "--bench-time",
                seconds,
                "--test-format",
                "json",
                ...level,
            )
            .output()
            .mapErr((e) { "cannot run {tondo}: {e}" })?
    let text = ran.text().mapErr((e) { "tondo's report is not text: {e}" })?
    let report = json.parse(text).mapErr((e) { "tondo gave no report: {e}" })?
    var measured: Map[String, Measure] = [:]
    for entry in (report.field("tests").asArray() ?? []) {
        let name = entry.field("name").asText() ?? ""
        for attempt in (entry.field("attempts").asArray() ?? []) {
            for benchmark in (attempt.field("benchmarks").asArray() ?? []) {
                let key = "{name}/{benchmark.field("name").asText() ?? ""}"
                let nanoseconds = benchmark.field("ns_per_op").field("median").asFloat() ?? 0.0
                let allocations = benchmark.field("allocations_per_op").asFloat() ?? 0.0
                let bytes = benchmark.field("bytes_per_op").asFloat() ?? 0.0
                let instructions = benchmark.field("instructions_per_op").asFloat()
                let cycles = benchmark.field("cycles_per_op").asFloat()
                measured[key] = Measure { nanoseconds, allocations, bytes, instructions, cycles }
            }
        }
    }
    measured
}

/// Go's `GOAMD64` for a level of Tondo's, or nothing for Go's default.
fn goLevel(cpu: String): String {
    match cpu {
        "baseline" | "x86-64-v2" => "v2"
        "x86-64-v3" => "v3"
        "x86-64-v4" => "v4"
        _ => ""
    }
}

/// A command of Go's, for the level `GOAMD64` names, if any.
fn goCommand(level: String, arguments: Array[String]): Command {
    let command = process.command("go", ...arguments).directory("bench/go")
    if level.isEmpty() { command } else { command.env("GOAMD64", level) }
}

/// What `go test -bench` measured, by the same names: `BenchmarkCalls/fib_25`
/// is `calls/fib 25`.
fn goSide(seconds: String, level: String): Map[String, Measure] ! String {
    let ran =
        goCommand(
                level,
                ["test", "-run", "^$", "-bench", ".", "-benchmem", "-benchtime", "{seconds}s"],
            )
            .output()
            .mapErr((e) { "cannot run go: {e}" })?
    if ran.statuses.isEmpty() or not ran.statuses[0].success {
        fail "go test failed: {String.fromBytes(ran.stderr) ?? ""}{String.fromBytes(ran.stdout) ?? ""}"
    }
    benchmarked(ran.text().mapErr((e) { "go's output is not text: {e}" })?)
}

/// The lines `go test -bench` writes, as bench/csharp writes them too:
/// `BenchmarkCalls/fib_25-32  N  t ns/op  b B/op  a allocs/op`, the
/// processors after the last `-` and the allocations where counted.
fn benchmarked(text: String): Map[String, Measure] {
    var measured: Map[String, Measure] = [:]
    for line in text.lines() {
        let words = line.words()
        if words.length() < 6 or not words[0].startsWith("Benchmark") or words[3] != "ns/op" {
            continue
        }
        let full = words[0].removePrefix("Benchmark")
        let parts = full.split("/")
        if parts.length() != 2 {
            continue
        }
        let suffix = parts[1].split("-")
        let named = if suffix.length() > 1 {
            (suffix.slice(0, suffix.length() - 1) ?? []).join("-")
        } else {
            parts[1]
        }
        let key = "{parts[0].toLower()}/{named.replace("_", " ")}"
        let nanoseconds = Float.parse(words[2]) ?? 0.0
        let bytes = Float.parse(words[4]) ?? 0.0
        let allocations = if words.length() >= 8 { Float.parse(words[6]) ?? 0.0 } else { 0.0 }
        measured[key] = Measure {
            nanoseconds
            allocations
            bytes
            instructions: none
            cycles: none
        }
    }
    measured
}

/// The latencies a program of bench/latency writes, a line of JSON for each
/// server: the median and the 99th percentile, in microseconds, by name.
fn latencies(command: Command): Map[String, (Int, Int)] ! String {
    let ran = command.output().mapErr((e) { "cannot measure latency: {e}" })?
    if ran.statuses.isEmpty() or not ran.statuses[0].success {
        fail "measuring latency failed: {String.fromBytes(ran.stderr) ?? ""}"
    }
    var measured: Map[String, (Int, Int)] = [:]
    for line in (ran.text() ?? "").lines() {
        let read = json.parse(line)
        match read {
            ok(value) => {
                let name = value.field("name").asText() ?? ""
                let (middle, tail) = (
                    value.field("p50_us").asInt() ?? 0,
                    value.field("p99_us").asInt() ?? 0,
                )
                measured[name] = (middle, tail)
            }
            err(_) => {}
        }
    }
    measured
}

/// What bench/csharp measured, where `dotnet` runs, by the same names.
fn csharpSide(seconds: String): Map[String, Measure] {
    let ran = process
        .command("dotnet", "run", "-c", "Release", "--project", "bench/csharp", "--", seconds)
        .output()
    match ran {
        ok(out) if not out.statuses.isEmpty() and out.statuses[0].success => benchmarked(
            out.text() ?? "",
        )
        _ => [:]
    }
}

/// What `perf stat` counted of a program's instructions and cycles outside
/// the kernel, from what it writes with `-x ,`.
fn perfCounts(text: String): (Float, Float) {
    var (instructions, cycles) = (0.0, 0.0)
    for line in text.lines() {
        let fields = line.split(",")
        if fields.length() < 3 {
            continue
        }
        let value = Float.parse(fields[0]) ?? 0.0
        if fields[2].startsWith("instructions") {
            instructions = value
        } else if fields[2].startsWith("cycles") {
            cycles = value
        }
    }
    (instructions, cycles)
}

/// The instructions and cycles of a run of each of Go's benchmarks, where
/// `perf` counts them: its test program runs each benchmark so many times,
/// about a fifth of a second, and twice as many, under `perf stat`, and the
/// difference leaves out what does not repeat, the start of the program and
/// Go's first run.
fn goCounts(measured: Map[String, Measure], level: String): Map[String, Measure] ! String {
    let probe = process.command("perf", "stat", "-x", ",", "-e", "instructions:u", "true").output()
    let works = match probe {
        ok(out) => out.statuses.length() > 0 and out.statuses[0].success
        err(_) => false
    }
    if not works {
        console.eprintln("perf does not count here, so Go's instructions are left out")
        return measured
    }
    let dir =
        fs
            .createTemporaryDirectory(pattern: "go-bench-*")
            .mapErr((e) { "cannot make a directory: {e}" })?
    let binary = "{dir}/bench.test"
    _ =
        goCommand(level, ["test", "-c", "-o", binary])
            .check()
            .mapErr((e) { "cannot build Go's benchmarks: {e}" })?
    var counted: Map[String, Measure] = [:]
    for (key, measure) in measured {
        let parts = key.split("/")
        if parts.length() != 2 or measure.nanoseconds <= 0.0 {
            counted[key] = measure
            continue
        }
        let pattern = "^(?i)benchmark{parts[0]}$/^{parts[1].replace(" ", "_")}$"
        let runs = Int.saturating(2.0e8 / measure.nanoseconds).max(1)
        let count = (times: Int) {
            let ran = process
                .command(
                    "perf",
                    "stat",
                    "-x",
                    ",",
                    "-e",
                    "instructions:u,cycles:u",
                    "--",
                    binary,
                    "-test.run",
                    "^$",
                    "-test.bench",
                    pattern,
                    "-test.benchtime",
                    "{times}x",
                )
                .directory("bench/go")
                .output()
            match ran {
                ok(out) => perfCounts(String.fromBytes(out.stderr) ?? "")
                err(_) => (0.0, 0.0)
            }
        }
        let (once, twice) = (count(runs), count(runs * 2))
        let per = (Float(runs))
        let (instructions, cycles) = ((twice.0 - once.0) / per, (twice.1 - once.1) / per)
        counted[key] = Measure {
            nanoseconds: measure.nanoseconds
            allocations: measure.allocations
            bytes: measure.bytes
            instructions: if instructions > 0.0 { instructions } else { none }
            cycles: if cycles > 0.0 { cycles } else { none }
        }
    }
    counted
}

/// A count of a run, in thousands, millions or billions, or a dash.
fn many(value: Float?): String {
    match value {
        some(v) if v >= 1.0e9 => "{(v / 1.0e9).toFixed(2)}G"
        some(v) if v >= 1.0e6 => "{(v / 1.0e6).toFixed(2)}M"
        some(v) if v >= 1.0e3 => "{(v / 1.0e3).toFixed(1)}k"
        some(v) => v.toFixed(0)
        none => "—"
    }
}

/// Bytes, in the unit that reads best.
fn sized(count: Float): String {
    if count < 1024.0 {
        return count.toFixed(0)
    }
    if count < 1024.0 * 1024.0 {
        return "{(count / 1024.0).toFixed(1)}k"
    }
    "{(count / 1024.0 / 1024.0).toFixed(2)}M"
}

/// A time, in the unit that reads best.
fn time(nanoseconds: Float): String {
    if nanoseconds < 1000.0 {
        return "{nanoseconds.toFixed(1)} ns"
    }
    if nanoseconds < 1_000_000.0 {
        return "{(nanoseconds / 1000.0).toFixed(2)} µs"
    }
    "{(nanoseconds / 1_000_000.0).toFixed(2)} ms"
}

/// The median of some numbers.
fn median(values: Array[Float]): Float {
    var sorted = values
    sorted.sortBy((value) { value })
    if sorted.isEmpty() { 0.0 } else { sorted[sorted.length() / 2] }
}

/// The old `tondo` against this one, in turns: a table of what changed, the
/// worst first, and an error when something regressed.
fn againstOld(
    old: String,
    tondo: String,
    seconds: String,
    cpu: String,
    rounds: Int,
    max: Float,
    output: String,
): !String {
    var (olds, news): (Array[Map[String, Measure]], Array[Map[String, Measure]]) = ([], [])
    for round in 0..rounds {
        // Each goes first in turn.
        if round % 2 == 1 {
            news.push(tondoSide(tondo, seconds, cpu)?)
        }
        olds.push(tondoSide(old, seconds, cpu)?)
        if round % 2 == 0 {
            news.push(tondoSide(tondo, seconds, cpu)?)
        }
    }
    let combined = (runs: Array[Map[String, Measure]], name: String) {
        var (times, allocations): (Array[Float], Array[Float]) = ([], [])
        for run in runs {
            match run.get(name) {
                some(measure) => {
                    times.push(measure.nanoseconds)
                    allocations.push(measure.allocations)
                }
                none => {}
            }
        }
        Measure {
            nanoseconds: median(times)
            allocations: median(allocations)
            bytes: 0.0
            instructions: none
            cycles: none
        }
    }
    var rows: Array[(String, Measure, Measure)] = []
    for (name, _) in (news.first() ?? [:]) {
        rows.push((name, combined(olds, name), combined(news, name)))
    }
    rows.sortBy((row) { -row.2.nanoseconds / row.1.nanoseconds })
    var lines: Array[String] = [
        "| Benchmark | Before | Now | Change | Allocs/op before | Allocs/op now |",
        "|---|---:|---:|---:|---:|---:|",
    ]
    var regressed: Array[String] = []
    for (name, before, now) in rows {
        let change = (now.nanoseconds / before.nanoseconds - 1.0) * 100.0
        // Allocations under contention vary a little from run to run.
        let allocates = now.allocations > before.allocations * 1.01 + 0.5
        let mark = if change > max or allocates { " ⚠" } else { "" }
        if mark != "" {
            regressed.push(name)
        }
        lines.push(
            "| {name} | {time(before.nanoseconds)} | {time(now.nanoseconds)} | {change.toFixed(1)}%{mark} | {before.allocations.toFixed(0)} | {now.allocations.toFixed(0)} |",
        )
    }
    lines.push("")
    lines.push(
        "{regressed.length()} of {rows.length()} benchmarks regressed: slower than {max}% or more allocations.",
    )
    let table = lines.join("\n")
    console.println(table)
    if output != "" {
        fs.writeText(output, "{table}\n").mapErr((e) { "cannot write {output}: {e}" })?
    }
    if not regressed.isEmpty() {
        fail "regressed: {regressed.join(", ")}"
    }
}

fn main(): !String {
    var seconds = "1"
    var output = ""
    var old = ""
    var cpu = ""
    var rounds = 4
    var max = 5.0
    let arguments = env.args()
    for i in 0..arguments.length() {
        let value = if i + 1 < arguments.length() { arguments[i + 1] } else { "" }
        match arguments[i] {
            "--time" => seconds = value
            "--output" => output = value
            "--old" => old = value
            "--cpu" => cpu = value
            "--rounds" => rounds = Int.parse(value) ?? 4
            "--max" => max = Float.parse(value) ?? 5.0
            _ => {}
        }
    }
    let tondo = env.get("TONDO") ?? "tondo"
    if old != "" {
        againstOld(old, tondo, seconds, cpu, rounds, max, output)?
        return
    }
    let ours = tondoSide(tondo, seconds, cpu)?
    let level = goLevel(cpu)
    let theirs = match goCounts(goSide(seconds, level)?, level) {
        ok(counted) => counted
        err(error) => fail error
    }
    var rows: Array[Row] = []
    for (name, measure) in ours {
        match theirs.get(name) {
            some(go) => rows.push(Row { name: name, tondo: measure, go: go })
            none => console.eprintln("no Go benchmark for {name}")
        }
    }
    // The slowest against Go first.
    rows.sortBy((row) { -row.tondo.nanoseconds / row.go.nanoseconds })
    var lines: Array[String] = [
        "| Benchmark | Tondo | Go | Tondo/Go | Allocs/op Tondo | Allocs/op Go | B/op Tondo | B/op Go | Ins/op Tondo | Ins/op Go | Cycles/op Tondo | Cycles/op Go |",
        "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
    ]
    var (slower, more, heavier) = (0, 0, 0)
    for row in rows {
        let ratio = row.tondo.nanoseconds / row.go.nanoseconds
        if ratio > 1.0 {
            slower += 1
        }
        match (row.tondo.instructions, row.go.instructions) {
            (some(own), some(go)) if own > go => more += 1
            _ => {}
        }
        // Memory is judged as time is: what a run allocates, in number
        // and in bytes, against Go's.
        let memory =
            row.tondo.allocations > row.go.allocations + 0.5 or row.tondo.bytes > row.go.bytes + 0.5
        if memory {
            heavier += 1
        }
        let mark = if ratio > 1.0 { " ⚠" } else { "" }
        let marked = if memory { " ⚠" } else { "" }
        let counts =
            "{many(row.tondo.instructions)} | {many(row.go.instructions)} | {many(row.tondo.cycles)} | {many(row.go.cycles)}"
        lines.push(
            "| {row.name} | {time(row.tondo.nanoseconds)} | {time(row.go.nanoseconds)} | {ratio.toFixed(2)}×{mark} | {row.tondo.allocations.toFixed(0)}{marked} | {row.go.allocations.toFixed(0)} | {sized(row.tondo.bytes)} | {sized(row.go.bytes)} | {counts} |",
        )
    }
    lines.push("")
    lines.push(
        "{slower} of {rows.length()} benchmarks are slower than Go; {heavier} allocate more; {more} run more instructions than Go.",
    )
    // The servers at a fixed rate, each side with its own program.
    let tondoLatency = latencies(process.command(tondo, "run", "bench/latency/latency.to"))?
    let goLatency = latencies(goCommand(level, ["run", "./latency"]))?
    lines.push("")
    lines.push("| Server | p50 Tondo | p50 Go | p99 Tondo | p99 Go |")
    lines.push("|---|---:|---:|---:|---:|")
    for (name, (middle, tail)) in tondoLatency {
        match goLatency.get(name) {
            some((goMedian, goTail)) => {
                let (slow, slowTail) = (
                    if middle > goMedian { " ⚠" } else { "" },
                    if tail > goTail { " ⚠" } else { "" },
                )
                lines.push(
                    "| {name} | {middle} µs{slow} | {goMedian} µs | {tail} µs{slowTail} | {goTail} µs |",
                )
            }
            none => console.eprintln("no Go latency for {name}")
        }
    }
    // The rows C# has too, where `dotnet` runs: its allocations are not
    // counted, only their bytes.
    let csharp = csharpSide(seconds)
    var against: Array[(String, Measure, Measure)] = []
    for row in rows {
        match csharp.get(row.name) {
            some(other) => against.push((row.name, row.tondo, other))
            none => {}
        }
    }
    if not against.isEmpty() {
        lines.push("")
        lines.push("| Benchmark | Tondo | C# | Tondo/C# | B/op Tondo | B/op C# |")
        lines.push("|---|---:|---:|---:|---:|---:|")
        for (name, own, other) in against {
            let ratio = own.nanoseconds / other.nanoseconds
            let mark = if ratio > 1.0 { " ⚠" } else { "" }
            lines.push(
                "| {name} | {time(own.nanoseconds)} | {time(other.nanoseconds)} | {ratio.toFixed(2)}×{mark} | {sized(own.bytes)} | {sized(other.bytes)} |",
            )
        }
    }
    let table = lines.join("\n")
    console.println(table)
    if output != "" {
        fs.writeText(output, "{table}\n").mapErr((e) { "cannot write {output}: {e}" })?
    }
}
