// Compares Tondo with Go: runs the benchmarks of bench/tondo with
// `tondo test --bench` and those of bench/go with `go test -bench`, and
// writes a Markdown table: for each benchmark, the time a run takes on each
// side, Tondo's time over Go's, and the allocations of a run, the slowest
// against Go first.
//
//   tondo run bench/compare.to [--time <seconds>] [--output <file>]
//
// With `--old <tondo>` it compares that `tondo` with this one instead, as a
// change of the runtime is held to a baseline (docs/refactor.md, 0.7): the
// two measure in turns, `--rounds` of them, so that a machine that speeds up
// or slows down weighs on both, and it fails when a benchmark is slower than
// `--max` percent, 5 by default, or allocates more.
//
//   tondo run bench/compare.to -- --old <tondo> [--rounds 4] [--max 5]
//
// It runs from the repository's root; `TONDO` names the `tondo` to measure
// with, `tondo` on PATH by default.

import std.console
import std.env
import std.fs
import std.json
import std.process

type Measure = {
    nanoseconds: Float
    allocations: Float
}

type Row = {
    name: String
    tondo: Measure
    go: Measure
}

/// What `tondo test --bench` measured, by `test/benchmark`.
fn tondoSide(tondo: String, seconds: String): Map[String, Measure] ! String {
    let ran =
        process
            .command(
                tondo,
                "test",
                "bench/tondo",
                "--bench",
                "--bench-time",
                seconds,
                "--test-format",
                "json",
            )
            .output()
            .mapErr((e) { "cannot run {tondo}: {e}" })?
    let text = ran.text().mapErr((e) { "tondo's report is not text: {e}" })?
    let report = json.parse(text).mapErr((e) { "tondo gave no report: {e}" })?
    var measured: Map[String, Measure] = [:]
    for entry in report.field("tests").asArray().unwrapOr([]) {
        let name = entry.field("name").asText().unwrapOr("")
        for attempt in entry.field("attempts").asArray().unwrapOr([]) {
            for benchmark in attempt.field("benchmarks").asArray().unwrapOr([]) {
                let key = "{name}/{benchmark.field("name").asText().unwrapOr("")}"
                let nanoseconds = benchmark
                    .field("ns_per_op")
                    .field("median")
                    .asFloat()
                    .unwrapOr(0.0)
                let allocations = benchmark.field("allocations_per_op").asFloat().unwrapOr(0.0)
                measured[key] = Measure { nanoseconds: nanoseconds, allocations: allocations }
            }
        }
    }
    measured
}

/// What `go test -bench` measured, by the same names: `BenchmarkCalls/fib_25`
/// is `calls/fib 25`.
fn goSide(seconds: String): Map[String, Measure] ! String {
    let ran =
        process
            .command(
                "go",
                "test",
                "-run",
                "^$",
                "-bench",
                ".",
                "-benchmem",
                "-benchtime",
                "{seconds}s",
            )
            .directory("bench/go")
            .output()
            .mapErr((e) { "cannot run go: {e}" })?
    let text = ran.text().mapErr((e) { "go's output is not text: {e}" })?
    var measured: Map[String, Measure] = [:]
    for line in text.lines() {
        let words = line.words()
        if words.length() < 8 or not words[0].startsWith("Benchmark") or words[3] != "ns/op" {
            continue
        }
        // `BenchmarkCalls/fib_25-32`: the test, the benchmark, and the
        // processors after the last `-`.
        let full = words[0].removePrefix("Benchmark")
        let parts = full.split("/")
        if parts.length() != 2 {
            continue
        }
        let suffix = parts[1].split("-")
        let benchmark = suffix
            .slice(0, suffix.length() - 1)
            .unwrapOr([])
            .join("-")
            .replace("_", " ")
        let key = "{parts[0].toLower()}/{benchmark}"
        let nanoseconds = Float.parse(words[2]).unwrapOr(0.0)
        let allocations = Float.parse(words[6]).unwrapOr(0.0)
        measured[key] = Measure { nanoseconds: nanoseconds, allocations: allocations }
    }
    measured
}

/// A time, in the unit that reads best.
fn time(nanoseconds: Float): String {
    if nanoseconds < 1000.0 {
        return "{nanoseconds.toFixed(1)} ns"
    }
    if nanoseconds < 1_000_000.0 {
        return "{(nanoseconds / 1000.0).toFixed(2)} µs"
    }
    "{(nanoseconds / 1_000_000.0).toFixed(2)} ms"
}

/// The median of some numbers.
fn median(values: Array[Float]): Float {
    var sorted = values
    sorted.sortBy((value) { value })
    if sorted.isEmpty() { 0.0 } else { sorted[sorted.length() / 2] }
}

/// The old `tondo` against this one, in turns: a table of what changed, the
/// worst first, and an error when something regressed.
fn againstOld(
    old: String,
    tondo: String,
    seconds: String,
    rounds: Int,
    max: Float,
    output: String,
): !String {
    var (olds, news): (Array[Map[String, Measure]], Array[Map[String, Measure]]) = ([], [])
    for round in 0..rounds {
        // Each goes first in turn.
        if round % 2 == 1 {
            news.push(tondoSide(tondo, seconds)?)
        }
        olds.push(tondoSide(old, seconds)?)
        if round % 2 == 0 {
            news.push(tondoSide(tondo, seconds)?)
        }
    }
    let combined = (runs: Array[Map[String, Measure]], name: String) {
        var (times, allocations): (Array[Float], Array[Float]) = ([], [])
        for run in runs {
            match run.get(name) {
                some(measure) => {
                    times.push(measure.nanoseconds)
                    allocations.push(measure.allocations)
                }
                none => {}
            }
        }
        Measure { nanoseconds: median(times), allocations: median(allocations) }
    }
    var rows: Array[(String, Measure, Measure)] = []
    for (name, _) in news.first().unwrapOr([:]) {
        rows.push((name, combined(olds, name), combined(news, name)))
    }
    rows.sortBy((row) { -row.2.nanoseconds / row.1.nanoseconds })
    var lines: Array[String] = [
        "| Benchmark | Before | Now | Change | Allocs/op before | Allocs/op now |",
        "|---|---:|---:|---:|---:|---:|",
    ]
    var regressed: Array[String] = []
    for (name, before, now) in rows {
        let change = (now.nanoseconds / before.nanoseconds - 1.0) * 100.0
        // Allocations under contention vary a little from run to run.
        let allocates = now.allocations > before.allocations * 1.01 + 0.5
        let mark = if change > max or allocates { " ⚠" } else { "" }
        if mark != "" {
            regressed.push(name)
        }
        lines.push(
            "| {name} | {time(before.nanoseconds)} | {time(now.nanoseconds)} | {change.toFixed(1)}%{mark} | {before.allocations.toFixed(0)} | {now.allocations.toFixed(0)} |",
        )
    }
    lines.push("")
    lines.push(
        "{regressed.length()} of {rows.length()} benchmarks regressed: slower than {max}% or more allocations.",
    )
    let table = lines.join("\n")
    console.println(table)
    if output != "" {
        fs.writeText(output, "{table}\n").mapErr((e) { "cannot write {output}: {e}" })?
    }
    if not regressed.isEmpty() {
        fail "regressed: {regressed.join(", ")}"
    }
}

fn main(): !String {
    var seconds = "1"
    var output = ""
    var old = ""
    var rounds = 4
    var max = 5.0
    let arguments = env.args()
    for i in 0..arguments.length() {
        let value = if i + 1 < arguments.length() { arguments[i + 1] } else { "" }
        match arguments[i] {
            "--time" => seconds = value
            "--output" => output = value
            "--old" => old = value
            "--rounds" => rounds = Int.parse(value).unwrapOr(4)
            "--max" => max = Float.parse(value).unwrapOr(5.0)
            _ => {}
        }
    }
    let tondo = env.get("TONDO").unwrapOr("tondo")
    if old != "" {
        againstOld(old, tondo, seconds, rounds, max, output)?
        return
    }
    let ours = tondoSide(tondo, seconds)?
    let theirs = goSide(seconds)?
    var rows: Array[Row] = []
    for (name, measure) in ours {
        match theirs.get(name) {
            some(go) => rows.push(Row { name: name, tondo: measure, go: go })
            none => console.eprintln("no Go benchmark for {name}")
        }
    }
    // The slowest against Go first.
    rows.sortBy((row) { -row.tondo.nanoseconds / row.go.nanoseconds })
    var lines: Array[String] = [
        "| Benchmark | Tondo | Go | Tondo/Go | Allocs/op Tondo | Allocs/op Go |",
        "|---|---:|---:|---:|---:|---:|",
    ]
    var slower = 0
    for row in rows {
        let ratio = row.tondo.nanoseconds / row.go.nanoseconds
        if ratio > 1.0 {
            slower += 1
        }
        let mark = if ratio > 1.0 { " ⚠" } else { "" }
        lines.push(
            "| {row.name} | {time(row.tondo.nanoseconds)} | {time(row.go.nanoseconds)} | {ratio.toFixed(2)}×{mark} | {row.tondo.allocations.toFixed(0)} | {row.go.allocations.toFixed(0)} |",
        )
    }
    lines.push("")
    lines.push("{slower} of {rows.length()} benchmarks are slower than Go.")
    let table = lines.join("\n")
    console.println(table)
    if output != "" {
        fs.writeText(output, "{table}\n").mapErr((e) { "cannot write {output}: {e}" })?
    }
}
